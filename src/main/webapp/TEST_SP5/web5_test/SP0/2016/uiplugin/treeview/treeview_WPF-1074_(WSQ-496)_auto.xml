		scwin.setVal1 = function() {
			fontInit = WebSquare.wUnit.getJq('#treeview1_label_5').css('font-weight');
		};
		scwin.setVal2 = function() {
			fontAfterbeClicked = WebSquare.wUnit.getJq('#treeview1_label_5').css('font-weight');
		};		
		scwin.checkVal1 = function() {
			return fontInit < fontAfterbeClicked;
		};		
		scwin.unitTest = function() {
			//init
			WebSquare.wUnit.start();
			WebSquare.wUnit.addCommand("pause", "100");
			WebSquare.wUnit.addCommand("set", "scwin.setVal1()");
			WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('treeview1_label_5').click()");
			WebSquare.wUnit.addCommand("pause", "100");
			WebSquare.wUnit.addCommand("set", "scwin.setVal2()");
			WebSquare.wUnit.addCommand("pause", "100");

			WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
			//Run  and stop
			WebSquare.wUnit.run();
			WebSquare.wUnit.stop();
		}
		scwin.unitTest();

