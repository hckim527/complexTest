		<script type="text/javascript" lazy="false"><![CDATA[
scwin.hasManyClass = function() {
    var td = WebSquare.wUnit.getJq(".w2grid_input_table");
    let count = 0;
    td.each(function(index, el) {
        var classes = WebSquare.wUnit.getJq(this).attr("class");
        (classes.match(/w2grid_input_table/g) || []).length != 1 ? count++ : "";
    });
    return count ? true : false;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.hasManyClass()", "false");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    dltAppRcpt.insertRow();
    dltAppRcpt.insertRow();
    dltAppRcpt.insertRow();
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 27-Apr-2018
    //end
}
]]></script>
