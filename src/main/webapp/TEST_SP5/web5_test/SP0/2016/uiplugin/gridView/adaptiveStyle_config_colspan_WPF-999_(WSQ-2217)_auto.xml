scwin.closeWd = function() {
    return window.open("", "_self").close();
}
scwin.openWindow = function(url, width, height) {
    Popup = window.open(url, 'Popup', "toolbar=0,scrollbars=0,location=0,statusbar=0,menubar=0,resizable=0,width=200,height=200,left = 90,top = 90");
    Popup.focus();
}
scwin.unitTest1 = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("set", "localStorage.setItem('isAllowShow', 'true')");
    WebSquare.wUnit.addCommand("set", "scwin.openWindow(window.location.href, 200, 200)");
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("set", "scwin.closeWd()");
    WebSquare.wUnit.addCommand("pause", "100");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest2 = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("set", "localStorage.setItem('isAllowShow', 'false')");
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_0_0').height() == 100", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === 'function') {
        scwin.onpageload();
    }
    //Function unitTest()
    //Created by: Thuyet.Pham
    //Created date: 19-Apr-2018
    if (localStorage.getItem('isAllowShow') == 'true') {
        scwin.unitTest2();
    } else {
        scwin.unitTest1();
    }
    if (typeof scwin.unitTest === 'function') {
        scwin.unitTest();
    }
}
]]></script>
