        <script type="text/javascript" lazy="false"><![CDATA[
scwin.t_get1_onclick = function() {
    var result = treeview1.getCheckedIndexes({
        "hierarchy": true
    });
    input_get1.setValue(result);
};
scwin.t_get2_onclick = function() {
    var result = treeview1.getCheckedIndexes();
    input_get2.setValue(result);
};
scwin.t_new_onclick = function(e) {
    var row = treeview1.getSelectedIndex();
    if (!row) {
        // 선택된 노드가 없으면 가장 마지막 row에 추가
        row = dataList1.getRowCount();
    }
    dataList1.insertRow(row);
    treeview1.setEditMode(row + 1);
};
scwin.t_copy_onclick = function(e) {
    var ret = [];
    var cnt = dataList1.getRowCount();
    for (var i = cnt - 1; i >= 0; i--) {
        if (dataList1.getCellData(i, "gover_type") === "T") {
            // 체크된 노드들 각각을 자신의 노드 바로 아래에 복사
            var data = dataList1.getRowJSON(i);
            // data["gover_type"] = "F"; // 복사된 노드가 check상태가 되는것을 원하지 않을 경우 주석 해제
            dataList1.setRowJSON(i + 1, data);
        }
    }
};
scwin.t_del_onclick = function(e) {
    var cnt = dataList1.getRowCount();
    for (var i = cnt - 1; i >= 0; i--) {
        if (dataList1.getCellData(i, "gover_type") === "T") {
            dataList1.removeRow(i);
            // 현재는 부모 노드를 지우면 자식 노드까지 자동으로 지워지도록 구현함.
            // 자식 노드가 지워지지 않게 하려면 자식 노드들의 depth를 전부 1씩 감소하도록 수정해야 함.
        }
    }
};
scwin.treeview1_getCheckedRow = function() {
    // 방법1
    var ret = [];
    var cnt = dataList1.getRowCount();
    for (var i = cnt - 1; i >= 0; i--) {
        if (dataList1.getCellData(i, "gover_type") === "T") {
            ret.push(i);
            // 현재는 부모 노드를 지우면 자식 노드까지 자동으로 지워지도록 구현함.
            // 자식 노드가 지워지지 않게 하려면 자식 노드들의 depth를 전부 1씩 감소하도록 수정해야 함.
        }
    }
    // 방법2
    // var checkedIndexes = treeview1.getCheckedIndexes();
    // checkedIndexes.sort(function(lhs, rhs){return rhs - lhs;});
    // for(var i = 0; i < checkedIndexes.length; i++){
    // 	 ret.push(checkedIndexes[i] - 1);
    //}
    return ret;
}
scwin.t_mod_onclick = function(e) {
    treeview1.setEditMode(treeview1.getSelectedIndex());
};
scwin.treeview1_oneditend = function(info) {
    WebSquare.logger.printLog("index = " + info.index + ", oldValue = " + info.oldValue + ", newValue = " + info.newValue);
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 브라우저에서 treeview_hierarchy.xml 을 실행 후 왼쪽의 tree를 체크한다.(투명, 반투명 체크포함)- Run treeview_hierarchy.xml in your browser and check the tree on the left (including transparent and translucent checks).
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('treeview1_checkbox_6').click()");
    WebSquare.wUnit.addCommand("pause", "300");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('treeview1_checkbox_14').click()");
    WebSquare.wUnit.addCommand("pause", "300");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('treeview1_checkbox_17').click()");
    WebSquare.wUnit.addCommand("pause", "300");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('treeview1_checkbox_22').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1. 선택한 tree 가 체크된다.-The selected tree is checked.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('treeview1_checkbox_6').checked", "false");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('treeview1_checkbox_14').checked", "false");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('treeview1_checkbox_17').checked", "false");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('treeview1_checkbox_22').checked", "false");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('t_get1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 2. 반투명이 포함된 체크되어진 index값을 가져온다.- Get the checked index value with semitransparent.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('input_get1').realValue == '1,2,5'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 3. getCheckedNodeIndex() 버튼을 클릭한다.-Click the getCheckedNodeIndex () button.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('t_get2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 3. 반투명은 제외하고 체크되어진 index값을 가져온다.- Retrieve the checked index value except for semitransparent.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('input_get2').realValue == '5'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

