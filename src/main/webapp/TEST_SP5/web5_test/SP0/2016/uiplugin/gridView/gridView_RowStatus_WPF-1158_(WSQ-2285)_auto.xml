<?xml version='1.0' encoding='UTF-8'?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=''/>
            </xf:instance>
            <w2:dataCollection baseNode='map'>
            	<w2:dataList id='dataList1' baseNode='list' saveRemovedData='true' repeatNode='map'>
            		<w2:columnInfo>
            			<w2:column id='col1' name='name1' dataType='number'></w2:column>
            			<w2:column id='col2' name='name2' dataType='text'></w2:column>
            			<w2:column id='col3' name='name3' dataType='text'></w2:column>
            			<w2:column id='col4' name='name4' dataType='text'></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type='text/javascript'><![CDATA[
scwin.onpageload = function() {
        dataList1.setData([0,1,2,3,0,1,2,3]);
}        

        
        scwin._triggerKeyboardEvent = function(el, keyCode){
			var eventObj = document.createEventObject ?
				document.createEventObject() : document.createEvent('Events');
			  
			if(eventObj.initEvent){
				eventObj.initEvent('keydown', true, true);
			}
			  
			eventObj.keyCode = keyCode;
			eventObj.which = keyCode;
			    
			el.dispatchEvent ? el.dispatchEvent(eventObj) : el.fireEvent('onkeydown', eventObj); 
		}  
        
		scwin.unitTest = function() {        	
        	WebSquare.wUnit.start();
			WebSquare.wUnit.addCommand("pause", "400");
        	WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_0_0').click();");
        	WebSquare.wUnit.addCommand("set", "scwin._triggerKeyboardEvent(WebSquare.wUnit.getDomById('gridView1_cell_0_0'), 46)");
        	WebSquare.wUnit.addCommand("pause", "400");
        	WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView1').getRowStatus(0) == 'U'", "true");
        
        	WebSquare.wUnit.run();	
        	WebSquare.wUnit.stop();
        
        }
        scwin.unitTest();
        
        ]]></script>
    </head>
    <body ev:onpageload='scwin.onpageload'>
    	<w2:gridView dataList='dataList1' scrollByColumn='false' summaryAuto='false' scrollByColumnAdaptive='false' id='gridView1'
    		style='position: relative ;left:28px;top:29px;width:402px;height:150px;' ignoreCellClick='false' ignoreToggleOnDisabled='false'
    		fixedColumnWithHidden='true' useShiftKey='true' rowStatusVisible='true'>
    		<w2:header id='header1' style=''>
    			<w2:row id='row1' style=''>
    				<w2:column blockSelect='false' id='column7' style='height:20px' inputType='text' width='70' displayMode='label'
    					value='name1'>
    				</w2:column>
    				<w2:column blockSelect='false' id='column5' style='height:20px' inputType='text' width='70' displayMode='label'
    					value='name2'>
    				</w2:column>
    				<w2:column blockSelect='false' id='column3' style='height:20px' inputType='text' width='70' displayMode='label'
    					value='name3'>
    				</w2:column>
    				<w2:column blockSelect='false' id='column1' style='height:20px' width='70' inputType='text' displayMode='label'
    					value='name4'>
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id='gBody1' style=''>
    			<w2:row id='row2' style=''>
    				<w2:column blockSelect='false' id='col1' style='height:20px' inputType='text' width='70' displayMode='label'></w2:column>
    				<w2:column blockSelect='false' id='col2' style='height:20px' inputType='text' width='70' displayMode='label'></w2:column>
    				<w2:column blockSelect='false' id='col3' style='height:20px' inputType='text' width='70' displayMode='label'></w2:column>
    				<w2:column blockSelect='false' id='col4' style='height:20px' width='70' inputType='text' displayMode='label'></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
