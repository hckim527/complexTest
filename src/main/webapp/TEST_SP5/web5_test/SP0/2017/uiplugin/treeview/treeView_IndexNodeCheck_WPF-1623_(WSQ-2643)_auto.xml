<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dl_tree" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="value" name="value" dataType="text"></w2:column>
            			<w2:column id="label" name="label" dataType="text"></w2:column>
            			<w2:column id="depth" name="depth" dataType="text"></w2:column>
            			<w2:column id="chk" name="name4" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>

            				<value><![CDATA[1]]></value>
            				<label><![CDATA[1]]></label>
            				<depth><![CDATA[1]]></depth>
            				<chk><![CDATA[1]]></chk>
            			</w2:row>
            			<w2:row>

            				<value><![CDATA[2]]></value>
            				<label><![CDATA[1-1]]></label>
            				<depth><![CDATA[2]]></depth>
            				<chk><![CDATA[0]]></chk>
            			</w2:row>
            			<w2:row>

            				<value><![CDATA[3]]></value>
            				<label><![CDATA[2]]></label>
            				<depth><![CDATA[1]]></depth>
            				<chk><![CDATA[0]]></chk>
            			</w2:row>
            			<w2:row>

            				<value><![CDATA[4]]></value>
            				<label><![CDATA[2-1]]></label>
            				<depth><![CDATA[2]]></depth>
            				<chk><![CDATA[0]]></chk>
            			</w2:row>
            			<w2:row>

            				<value><![CDATA[5]]></value>
            				<label><![CDATA[2-1-1]]></label>
            				<depth><![CDATA[3]]></depth>
            				<chk><![CDATA[1]]></chk>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    treeview.checkByIndex(3, true);
};
scwin.trigger2_onclick = function(e) {
    treeview.checkByIndex(3, true, true);
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('treeview_checkbox_3').checked", "true");
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('treeview_checkbox_4').checked", "true");
    WebSquare.wUnit.addCommand("pause", "100");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function 
    //Created by: Quan.Nguyen
    //Created date: 16-Jun-2018
    //end
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:treeview useDrag="" id="treeview" style="position: absolute;width:200px;height:315px;border: solid 1px #000;" lineShow=""
    		tooltipGroupClass="false" dataType="listed" falseValue="0" trueValue="1" showCheckbox="true" alwaysDraw="true">
    		<w2:itemset nodeset="data:dl_tree">
    			<w2:label ref="label"></w2:label>
    			<w2:value ref="value"></w2:value>
    			<w2:depth ref="depth"></w2:depth>
    			<w2:folder ref=""></w2:folder>
    			<w2:checkbox ref="chk"></w2:checkbox>
    			<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
    			<w2:image ref=""></w2:image>
    			<w2:iconImage ref=""></w2:iconImage>
    			<w2:selectedImage ref=""></w2:selectedImage>
    			<w2:expandedImage ref=""></w2:expandedImage>
    			<w2:leafImage ref=""></w2:leafImage>
    		</w2:itemset>
    	</w2:treeview>
    	<xf:trigger type="button" id="trigger1" style="position: absolute;width:224px;height:49px;left:308px;top:50px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[treeview.checkByIndex(3, true);]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2"
    		style="position: absolute;width:224px;height:49px;left:307px;top:111px;" type="button">
    		<xf:label><![CDATA[treeview.checkByIndex(3, true, true);]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 