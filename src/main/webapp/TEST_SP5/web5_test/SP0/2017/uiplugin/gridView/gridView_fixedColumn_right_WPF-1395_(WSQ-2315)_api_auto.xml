        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    gridView1.setFixedRightColumn(3);
};
scwin.trigger2_onclick = function(e) {
    gridView1.setFixedRightColumn(2);
};
scwin.trigger3_onclick = function(e) {
    gridView1.setFixedRightColumn(1);
};
scwin.trigger4_onclick = function(e) {
    gridView1.setFixedRightColumn(0);
};
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.checkVal = function() {
    return WebSquare.wUnit.getObjById('gridView1').getFixedRightColumnLastIndex() == 21;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();

    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "valBeforeScoll = WebSquare.wUnit.getDomById('gridView1_column16').getBoundingClientRect().x");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_scrollX_right').scrollLeft = 600");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "valAfterScoll = WebSquare.wUnit.getDomById('gridView1_column16').getBoundingClientRect().x");

    WebSquare.wUnit.addCommand("assert", "valBeforeScoll == valAfterScoll", "true");

    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('trigger3').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_scrollX_right').scrollLeft = 100");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_scrollX_right').scrollLeft = 400");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    window.data = [];
    for (var i = 0; i < 20 * 50; i++) {
        data.push(i);
    }
    dataList1.setData(data);
    //Function 
    //Created by: Quan.Nguyen
    //Created date: 09-Mar-2018
    var valBeforeScoll, valAfterScoll;
    //end
}

]]></script>
    </head>
