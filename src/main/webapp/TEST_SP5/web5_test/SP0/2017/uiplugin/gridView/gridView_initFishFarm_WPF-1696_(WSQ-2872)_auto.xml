		<script type="text/javascript" lazy="false"><![CDATA[
scwin.setVal = function() {
    localStorage.setItem("log", WebSquare.wUnit.getJq('#grd_fishfarm_cell_0_1').height());
}
scwin.checkVal = function() {
    return localStorage.getItem('log') == WebSquare.wUnit.getJq('#grd_fishfarm_cell_0_1').height();
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setVal()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('grd_fishfarm_cell_0_1').click()");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    dl_sidoList.setXML(WebSquare.ModelUtil.findInstanceNode("list"))
    dl_fishfarm.insertRow();
    localStorage.removeItem("log");
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
