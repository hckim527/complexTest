    <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    group1.setCaptionAuto(captionTitle = "API로 변경");
};
scwin.trigger2_onclick = function(e) {
    group1.setSummaryOnlyAuto();
};
scwin.getAttr1 = function(id, attr) {

	let pathStr = WebSquare.baseURI;
	let trimmed = pathStr.substring(1);

	let firstChar = trimmed.charAt(0);
	let firstDigit = parseInt(firstChar, 10);
	if (!isNaN(firstDigit) && firstDigit > 5) {
		return WebSquare.wUnit.getDomById(id).getAttribute('data-'+attr);
	} else {
		return WebSquare.wUnit.getDomById(id).getAttribute(attr);
	}	
}
scwin.getAttr2 = function(id, attr) {
	return WebSquare.wUnit.getDomById(id).getAttribute(attr);
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.getAttr1('wq_uuid_4', 'captiontitle')", "테이블명");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "1000");

    WebSquare.wUnit.addCommand("assert", "scwin.getAttr1('wq_uuid_4', 'captiontitle')", "API로 변경");
    WebSquare.wUnit.addCommand("pause", "1000");

    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "1000");

    WebSquare.wUnit.addCommand("assert", "scwin.getAttr2('group1', 'summary')", "test,test2,test3");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
scwin.onpageload = function() {
}
]]>
    </script>
