<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col2><![CDATA[1]]></col2>
            				<col3><![CDATA[1]]></col3>
            			</w2:row>
            			<w2:row>
            				<col2><![CDATA[2]]></col2>
            				<col3><![CDATA[2]]></col3>
            			</w2:row>
            			<w2:row>
            				<col2><![CDATA[3]]></col2>
            				<col3><![CDATA[3]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" id="dataList2" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            			<w2:column dataType="text" id="col3" name="name3"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col2><![CDATA[1]]></col2>
            				<col3><![CDATA[1]]></col3>
            			</w2:row>
            			<w2:row>
            				<col2><![CDATA[2]]></col2>
            				<col3><![CDATA[2]]></col3>
            			</w2:row>
            			<w2:row>
            				<col2><![CDATA[3]]></col2>
            				<col3><![CDATA[3]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("assert", "bodyCheck1", "true");
    WebSquare.wUnit.addCommand("pause", "50");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("assert", "bodyCheck2", "false");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
};
scwin.trigger1_onclick = function(e) {
    //GridView1 header check값 선택
    var headerCheck1 = WebSquare.wUnit.getDomById($p.id + 'GridView1_column1').childNodes[0];
    headerCheck1.click();
    // 전역변수 GridView1 body의 check값 확인 true
    bodyCheck1 = WebSquare.wUnit.getDomById($p.id + 'GridView1_cell_0_0').childNodes[0].checked || WebSquare.wUnit.getDomById($p.id + 'GridView1_cell_0_1').childNodes[0].checked || WebSquare.wUnit.getDomById($p.id + 'GridView1_cell_0_2').childNodes[0].checked;
};
scwin.trigger2_onclick = function(e) {
    //GridView2 header check값 선택	
    var headerCheck2 = WebSquare.wUnit.getDomById($p.id + 'GridView2_column2').childNodes[0];
    headerCheck2.click();
    // 전역변수 GridView1 body의 check값 확인 false
    bodyCheck2 = WebSquare.wUnit.getDomById($p.id + 'GridView2_cell_0_0').childNodes[0].checked || WebSquare.wUnit.getDomById($p.id + 'GridView2_cell_1_0').childNodes[0].checked || WebSquare.wUnit.getDomById($p.id + 'GridView2_cell_2_0').childNodes[0].checked;
};
scwin.onpageload = function() {
    if (typeof scwin.onpageload === "function") {
        //scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" summaryAuto="false" scrollByColumnAdaptive="false" id="GridView1"
    		style="position: absolute;width:217px;height:150px;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		fixedColumnWithHidden="true" useShiftKey="true" checkHeaderOnly="false">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" style="height:20px" width="70" inputType="checkbox" displayMode="label"
    					value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column2" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name3">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" width="70" inputType="checkbox" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:gridView ignoreCellClick="false" id="GridView2" dataList="dataList2" summaryAuto="false" ignoreToggleOnDisabled="false"
    		style="position: absolute;width:219px;height:150px;left:0px;top:185px;" checkHeaderOnly="true" useShiftKey="true"
    		scrollByColumn="false" fixedColumnWithHidden="true" scrollByColumnAdaptive="false">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column id="column2" blockSelect="false" style="height:20px" inputType="checkbox" width="70" value="name1"
    					displayMode="label">
    				</w2:column>
    				<w2:column id="column3" blockSelect="false" style="height:20px" width="70" inputType="text" value="name2"
    					displayMode="label">
    				</w2:column>
    				<w2:column id="column2" blockSelect="false" style="height:20px" width="70" inputType="text" value="name3"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column id="col1" blockSelect="false" style="height:20px" inputType="checkbox" width="70" displayMode="label"></w2:column>
    				<w2:column id="col2" blockSelect="false" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column id="col3" blockSelect="false" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<table id="" summary="" style="position: relative ;width: ;"></table>
    	<xf:trigger type="button" id="trigger1" style="position: relative;width:190px;height:23px;left:220px;top:3px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[checkHeaderOnly="false"]]></xf:label>
    	</xf:trigger>
    	<xf:trigger id="trigger2" style="position: relative;width:190px;height:23px;left:30px;top:184px;margin-top:0px;" type="button" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[checkHeaderOnly="true"]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 