scwin.__isCheck = function() {
    return WebSquare.wUnit.getDomById('mf_gridView1_body_tbody').children[1].children[0].innerText == "30";
}
scwin.checkVal = function() {
    return WebSquare.wUnit.getDomById('gridView1_body_tbody').getElementsByTagName('tr').length == 3;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView1').getAttribute('senseReader')", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView1').getAttribute('visibleRowNum') == ''", "true");

    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_scrollY_div').scrollTop = 600");
	
	WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("assert", "scwin.__isCheck()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
scwin.onpageload = function() {

}
]]></script>
