scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 0. SP2는 추후반영예정
    //0. SP2 will be reflected later
    //Test step 1. main샘플 실행 후 gridView의 name1항목의 '1'값을 클릭하여 값이 입력되는지 확인한다.
    //1. After executing main sample, click '1' value of name1 item of gridView to check if value is input.
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_0_0').click()");
    WebSquare.wUnit.addCommand("pause", "1000");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#udc_test11_input1').val() == '1'", "true");
    //Test step 2. ctrl+마우스우클릭으로 로그보기 후 에러로그 없이 정상로그가 보여지는지 확인한다.
    //2. Use ctrl + mouse right click to check whether normal log is displayed without error log.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.logger.getErrorLog() == ''", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}		
scwin.onpageload2 = function() {
