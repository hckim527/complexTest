        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    scwin.initData();
};
scwin.onpageunload = function() {};
scwin.initData = function() {
    dl_itemDetlsPtcls.setColumnDefaultValue("MCCD", "test");
};
scwin.getErrorLog = function() {
    var temp = WebSquare.logger.getErrorLog();
    return temp;
}
scwin.unitTest = function() {
    //Unit tets
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.getErrorLog() == ''", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //화면초기화 함수
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
