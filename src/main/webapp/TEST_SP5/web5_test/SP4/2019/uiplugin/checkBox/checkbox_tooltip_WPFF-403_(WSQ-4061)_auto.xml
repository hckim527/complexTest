    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <style>
        	.test{
				text-overflow:ellipsis;
			}

        	table {
				table-layout:fixed;
			}

			table td {
				width:30px;
				overflow: hidden;
				text-overflow: ellipsis;
			}
		</style>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.tooltip = function(label, index) {
    return "item " + index;
};
scwin.fireOver = function(node) {
    if (document.createEventObject) {
        node.fireEvent('onmouseover');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('mouseover', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.onmouseover == 'function') {
        node.onmouseover();
    }
}
scwin.mouseOverBehaviour = function(id) {
    scwin.fireOver(document.getElementsByClassName('w2checkbox_label ')[0]);
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group style="" id="" class="">
    		<w2:textbox label='tooltipFormatter tooltipDisplay="true"' style="line-height:20px;width:484px;height:23px;" id=""></w2:textbox>
    		<xf:select selectedindex="-1" id="" appearance="full" style="width:150px;height:140px;text-overflow:ellipsis;" cols="2" rows=""
