    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#G_gridView1__col1_input').val() == '20191022'", "true");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
