scwin.onpageload = function() {
	
};

	scwin.checkVal = function() {
		mf_wq_uuid_1_main_div
		const parentElement = WebSquare.wUnit.getDomById('wq_uuid_1_main_div');
		const childTrElements = parentElement.querySelectorAll('div').length;
		return childTrElements == 11;
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_1_node_1').children[1].click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_1_node_9').children[1].click()");
		WebSquare.wUnit.addCommand("pause", "400");

		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
	
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest() 
	
	
]]></script>
