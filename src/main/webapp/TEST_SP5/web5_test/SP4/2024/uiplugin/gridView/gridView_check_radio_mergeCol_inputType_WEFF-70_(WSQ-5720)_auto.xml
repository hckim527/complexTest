	document.onselectstart =  function (e) {
		return false;
	}; 

	scwin.fireOver = function(node) {
		if (document.createEventObject) {
			node.fireEvent('onmouseover');
		} else if (document.createEvent) {
			window.evt = document.createEvent('MouseEvents');
			evt.initEvent('mouseover', true, false);
			node.dispatchEvent(evt);
		} else if (typeof node.onmouseover == 'function') {
			node.onmouseover();
		}
	}
	scwin.mouseOverBehaviour = function(id) {
		window.el = WebSquare.wUnit.getDomById(id);
		scwin.fireOver(el);
	}	
	scwin.checkVal1 = function() {
		return document.getElementById('mf_wq_uuid_2_balloonTip').style.display == 'block';
	}

	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btnSch').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour('gridView1_column25')");
		WebSquare.wUnit.addCommand("pause", "500");			
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();	


	]]></script>
