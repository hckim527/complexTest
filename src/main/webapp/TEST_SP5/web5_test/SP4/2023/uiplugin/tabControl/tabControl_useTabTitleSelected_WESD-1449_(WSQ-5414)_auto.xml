<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('tabControl1_tab_tabs1_tabHTML').getAttribute('title') == 'tabs1 선택됨';
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:tabControl useTabKeyOnly="true" id="tabControl1" useMoveNextTabFocus="false" useConfirmMessage="false" confirmTrueAction="exist" tabPosition="" useTabTitleSelected="true"
    		confirmFalseAction="new" alwaysDraw="false" style="position:absolute;top:50px;width: 700px;height: 500px;" useAccessibilityMenu="true" tabScroll="true" tableRender="ul">
    		<w2:tabs disabled="false" style="width:70px;height:30px;" id="tabs1" label="tabs1"></w2:tabs>
            <w2:tabs disabled="false" style="width:70px;height:30px;" id="tabs2" label="tabs2"></w2:tabs>
    		<w2:content alwaysDraw="false" style="height:600px" id="content1" frameMode="wframe" title="tab1" src=""></w2:content>
            <w2:content alwaysDraw="false" style="height:600px" id="content2" frameMode="wframe" title="tab2" src=""></w2:content>
    	</w2:tabControl>
    </body>
</html>
