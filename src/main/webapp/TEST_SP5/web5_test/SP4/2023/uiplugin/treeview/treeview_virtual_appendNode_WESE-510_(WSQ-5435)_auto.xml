		<script type="javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	
};
 
// render Type이 table인 경우 ondrop 이벤트에서 appendNode 가 정상 수행된다.		
scwin.ui_treeview2_ondrop = function(dragNode,dropNode,dragControl,dropControl,e) {
	
	//이벤트에서 넘어오는 dropNode와 dragNode를 이용하여 현재 컴포넌트에 노드 추가
	//dropNode : drop 이벤트가 일어난 노드, dragNode : drag 되어 넘어온 노드
	this.appendNode(dropNode,dragNode);
	
};
	


scwin.trigger1_onclick = function(e) {
	scwin.tmpObj1 = treeview1.findNodeByValue("menu1-2-1");
	treeview1.removeNode(scwin.tmpObj1);
};

scwin.trigger2_onclick = function(e) {

	var tmpObj2 = treeview1.findNodeByValue("menu1-2");
	treeview1.appendNode(tmpObj2, scwin.tmpObj1);
};

// render Type이 virtual인 경우 ondrop 이벤트에서 appendNode 가 수행되지 않는다.
scwin.treeview2_ondrop = function(dragNode,dropNode,dragControl,dropControl,e) {
	
	//이벤트에서 넘어오는 dropNode와 dragNode를 이용하여 현재 컴포넌트에 노드 추가
	//dropNode : drop 이벤트가 일어난 노드, dragNode : drag 되어 넘어온 노드
	this.appendNode(dropNode,dragNode);
	
};


	
	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate1 = function() {
		scwin.simulateWrapper('#ui_treeview1_label_1', 'drag-n-drop', {
			dx: 300,
			dy: 0
		});
	}
	scwin.setSimulate2 = function() {
		scwin.simulateWrapper('#treeview1_label_1', 'drag-n-drop', {
			dx: 300,
			dy: 0
		});
	}		
	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById("treeview2_main_div").querySelectorAll('div').length == 5;
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('ui_treeview1_label_1').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
		WebSquare.wUnit.addCommand("pause", "500");
		
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('treeview1_label_1').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate2()");
		WebSquare.wUnit.addCommand("pause", "500");		
		//WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "300");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
	
]]></script>

