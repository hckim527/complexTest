        <script type="javascript" lazy="false"><![CDATA[

    scwin.onpageload = function() {
        var jsonData = [{col1:"afwafewfkjewlfae",col3:"a"},{col1:"c",col3:"c"},{col1:"d",col3:"d"},{col1:"b",col3:"b"}];
        dataList1.setJSON(jsonData);
