    scwin.gridView1_ongroupby = function(options) {
        scwin.test(options);
    };
    scwin.test = function(options){
        //debugger;
        var flag = true;
        if(flag) {
            options.closeGroup = true; 
            
            options.groupbyHeader = [{colSpan: "3", inputType: "expression", expression: " toggle() + depthStr() + ' [ ' + count() + ' 건 ] ' ", align: "left" }];
            options.groupbyFooter = [
                {colSpan:"3",inputType: "expression", expression: " SUM('col2')", displayFormatter: "countFormatFunction", align: "center"}
            ];
            
            gridView1.groupby( options ); //실제 groupby 실행
            
        } else {
            return false; 
        }
    }
    var countFormatFunction = function( value ) {
        return "총판매수량 : " + value + " 개 ";
    };

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('gridView1_scrollX_right').scrollLeft != 0;
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_column3').click()");
		WebSquare.wUnit.addCommand("pause", "500");						
				
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
]]></script>
