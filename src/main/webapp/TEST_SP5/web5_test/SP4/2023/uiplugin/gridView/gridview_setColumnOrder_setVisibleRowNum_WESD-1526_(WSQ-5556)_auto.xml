			const rows = document.querySelectorAll('tr');

			const firstColumnValues = [];
			let allEqual = false;

			rows.forEach(row => {
			const firstCell = row.querySelector('td:first-child');
			if (firstCell) {
				firstColumnValues.push(firstCell.innerText.trim());
			}
			});

			firstColumnValues.forEach((value, index) => {
				if (index < firstColumnValues.length - 1) {
					if (value === "col11") {
						allEqual = true;
					} else {
						allEqual = false;
					}
				}
			});

			return allEqual;
		}
	
