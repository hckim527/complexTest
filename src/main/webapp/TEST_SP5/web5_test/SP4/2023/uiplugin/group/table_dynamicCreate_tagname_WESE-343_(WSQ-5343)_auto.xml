        <script lazy="false" type="text/javascript"><![CDATA[///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 아래의 라인부터는 페이지 로딩 위주로 작성합니다.
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

/**
 * 페이지 로딩시 처리
 */
scwin.onpageload = function() {
  scwin.fn.init();
};


///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 아래의 라인부터는 사용자 정의 상수 위주로 작성합니다.
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
scwin.enumcode = {};//enum 코드

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 아래의 라인부터는 사용자 정의 Function 위주로 작성합니다.
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

scwin.fn = {};

/**
 * 페이지 초기화
 */
scwin.fn.init = function(){
  scwin.fn.make_row_test();
};

scwin.fn.make_row_test = () => {
  debugger;
  $p.dynamicCreate('tr1', 'group', {tagname: 'tr'}, tbl_body); 
  $p.dynamicCreate('tr1_th1', 'group', {tagname: 'th', className: 'w2tb_th', text: 'tr1_th1'}, tr1);  
  $p.dynamicCreate('tr1_td1', 'group', {tagname: 'td', className: 'w2tb_td', text: 'tr1_td1'}, tr1);
  $p.dynamicCreate('tr1_th2', 'group', {tagname: 'th', className: 'w2tb_th', text: 'tr1_th2'}, tr1);  
  $p.dynamicCreate('tr1_td2', 'group', {tagname: 'td', className: 'w2tb_td', text: 'tr1_td2'}, tr1);
  
  $p.dynamicCreate('tr2', 'group', {tagname: 'tr'}, tbl_body); 
  $p.dynamicCreate('tr2_th1', 'group', {tagname: 'th', className: 'w2tb_th', text: 'tr2_th1'}, tr2);  
  $p.dynamicCreate('tr2_td1', 'group', {tagname: 'th', className: 'w2tb_td', text: 'tr2_td1'}, tr2);
  $p.dynamicCreate('tr2_th2', 'group', {tagname: 'th', className: 'w2tb_th', text: 'tr2_th2'}, tr2);  
  $p.dynamicCreate('tr2_td2', 'group', {tagname: 'th', className: 'w2tb_td', text: 'tr2_td2'}, tr2);
};

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 아래의 라인부터는 컴포넌트의 사용자 정의  Function 위주로 작성합니다.
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


/**
 * customFormatter function Objec 생성 
 */
scwin.customFormatter = {};


/**
 * displayFormatter function Objec 생성 
 */
scwin.displayFormatter = {};




///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 아래의 라인부터는 컴포넌트의 이벤트 위주로 작성합니다.
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	scwin.checkLog = function() {
		return WebSquare.logger.getErrorLog();
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkLog() == ''", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()


]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
      <xf:group tagname="table" style="position:static; top:251px; left:352px;width:100%; height:30;" id="" class="w2tb">
