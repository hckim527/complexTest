    그리드뷰 해더에 필터용 input 생성 및 필터 처리

	※ 전제조건
		- 그리드뷰 해더에 필터용 row 를 추가해야 한다. (기본 해더 컬럼 에 추가로 필터용 inputbox 생성을 위한 row )
		


	※ 기본 필터 기능 사용 방법 
		- 그리드뷰에 체크콤보박스 형태의 기본 필터 기능이 존재함. (데이터 목록에서 보여줄 데이터 선택하는 형태) 
		- 적용방법
			1. 그리드뷰 속성 추가
			    - useFilterList : true
			2. 필터링 처리할 해더컬럼 속성 추가
			    - useFilter : true
			    - hideCustomFilter : true 
			( 적용예시 : 해당 샘플소스의 name4 컬럼 )


**************************************************************************************/


scwin.onpageload = function() {
	var data = [
		{"col1":"1234", "col2":"4567", "col3":"ccc", "col4":"바바바바"},
		{"col1":"A1234", "col2":"aA1245", "col3":"Aa5434", "col4":"가가가가"},
		{"col1":"a4567", "col2":"Aa4534", "col3":"aA4512", "col4":"나나나나"},
		{"col1":"B1234", "col2":"bB1247", "col3":"Bb7834", "col4":"다다다다"},
		{"col1":"b4567", "col2":"Bb4523", "col3":"bB1267", "col4":"라라라라"},
		{"col1":"c1342", "col2":"Cc1282", "col3":"cCc1234", "col4":"마마마마"}
	];
	dataList1.setJSON(data); 
};

scwin.customFormatter_col4 = function(data, formattedData, rowIndex, colIndex){


	return "ABC_"+formattedData;
};




//해더 필터 셋팅 버튼 클릭 시
scwin.btn_filterSet_onclick = function(e) {
	//그리드뷰 필터용 해더 inputbox 생성 및 필터용 처리 ( 그리드뷰Obj, 필터해더컬럼ID array, 매칭되는 바디컬럼ID array )
	var headerColumnIdArr	= ["column11", "column22", "column33"];
	var bodyColumnIdArr		= ["col1", "col2", "col3"];
	vgt.fn_setHeaderFileter( gridView1, headerColumnIdArr, bodyColumnIdArr ); 
};


//필터 초기화 버튼 클릭 시
scwin.btn_filterInit_onclick = function(e) {
	//그리드뷰에 필터 inputbox 을 모두 초기화  & 해당 그리뷰의 dataList 필터 해제
	vgt.fn_clearHeaderFileter( gridView1 ); 
};


	scwin.checkVal = function() {
		return document.getElementsByTagName('span')[2].innerText == 'ABC_가가가가';
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView2_column44_filter').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();	



]]></script>
