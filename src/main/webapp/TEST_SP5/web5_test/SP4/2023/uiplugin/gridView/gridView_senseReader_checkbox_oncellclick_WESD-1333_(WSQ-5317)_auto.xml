<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
    				<w2:columnInfo>
    					<w2:column id="col1" name="name1" dataType="text"></w2:column>
    					<w2:column id="col2" name="name2" dataType="text"></w2:column>
    					<w2:column id="col3" name="name3" dataType="text"></w2:column>
    					<w2:column id="col4" name="name4" dataType="text"></w2:column>
    					<w2:column id="col5" name="name5" dataType="text"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
        
    scwin.onpageload = function() {

		var jsonData = [{col1:"a",col2:"a1",col3:"1000", col4:"a"}
						,{col1:"a",col2:"a2",col3:"1000", col4:"a"}];
		dataList1.setJSON(jsonData);
    };
    
    scwin.onpageunload = function() {
        
    };

    scwin.gridView1_oncellclick = function(rowIdx, colIdx, colID){
        //alert("colID : " + colID)
		localStorage.setItem("log", colID);
    }

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('grd1_cell_0_1').innerHTML.indexOf('width:130px') != -1;
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_0_0').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log') != 'col5'", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	localStorage.removeItem("log");		
	
	]]></script>
    	<style type="text/css"><![CDATA[
    		
    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <w2:textbox id="" label="senseReader true" style="width: 250px;height: 23px;"></w2:textbox>
    	<w2:gridView id="gridView1" style="width: 500px;height: 400px;" checkAllType="false" scrollByColumn="false" defaultCellHeight="20" autoFit="allColumn" 
        senseReader="true" 
        ev:oncellclick="scwin.gridView1_oncellclick"
    		scrollByColumnAdaptive="false" dataList="data:dataList1">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="height:20px" id="column7" value="check" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column6" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name3" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name4" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name5" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="checkbox" checkboxLabel="aaa" style="height:20px" id="col5" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col4" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
        <w2:textbox id="" label="senseReader false" style="width: 250px;height: 23px;"></w2:textbox>
        <w2:gridView id="gridView2" style="width: 500px;height: 400px;" checkAllType="false" scrollByColumn="false" defaultCellHeight="20" autoFit="allColumn" 
        ev:oncellclick="scwin.gridView1_oncellclick"
            scrollByColumnAdaptive="false" dataList="data:dataList1">
