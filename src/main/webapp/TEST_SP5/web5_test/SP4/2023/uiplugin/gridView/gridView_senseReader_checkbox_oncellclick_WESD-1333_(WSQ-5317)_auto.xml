                    <w2:column width="70" inputType="checkbox" checkboxLabel="aaa" style="height:20px" id="col5" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="col1" value="" displayMode="label"></w2:column>
