<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>	
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[테스트1]]></label>
            				<value><![CDATA[a]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[프리미엄) 프리미어 ]]></label>
            				<value><![CDATA[b]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[프리미어 123]]></label>
            				<value><![CDATA[c]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[123 프리미어]]></label>
            				<value><![CDATA[d]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[프리미엄 프리미어]]></label>
            				<value><![CDATA[e]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};


	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate = function() {
		scwin.simulateWrapper('#wq_uuid_3_input', 'key-sequence', {
			sequence: '프리미어'
		});
	}
	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('wq_uuid_3_gridViewItemTable_gridView_body_tbody').children[2].style.display != 'none';
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_3_label').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
	
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:autoComplete editType="select" id="" useKeywordHighlight="false" style="width: 148px;height: 21px;" submenuSize="auto"
    		search="contain" useLocale="false" noResult="noEnd" displayMode="label">
    		<w2:choices>
    			<w2:gridViewItemset hideHeader="" rowMouseOver="" nodeset="data:dataList1" width="500" selectedRowColor="" label="label"
    				visibleRowNum="" autoFit="" value="value" rowMouseOverColor="" height="">
    				<w2:item ref="label" hidden="" header="라벨" style="" headerStyle=""></w2:item>
    				<w2:item ref="value" hidden="" header="벨류" style="" headerStyle=""></w2:item>
    			</w2:gridViewItemset>
    		</w2:choices>
    	</w2:autoComplete>
    </body>
</html>
