         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var returnInfo = {};
		returnInfo.options = {selectedData : false
							,     viewType : "icon"
							, chooseOption : true };
		returnInfo.inputType = "autoComplete";
		returnInfo.options.displayMode = "label";
		returnInfo.itemSet = {
			nodeset:"data:dataList2",
			label : "col1",
			value : "col2"
		}
		for (var i = 0; i < 5; i++) {
			gridView1.setCellInputType(i, "col3", returnInfo);    
		}
		var returnInfo = {};
		returnInfo.options = {selectedData : false
							,     viewType : "icon"
							, chooseOption : true };
		returnInfo.inputType = "select";
		returnInfo.options.displayMode = "label";
		returnInfo.itemSet = {
			nodeset:"data:dataList3",
			label : "col1",
			value : "col2"
		}
		for (var i = 0; i < 5; i++) {
			gridView1.setCellInputType(i, "col4", returnInfo);    
		}
	};
	
	scwin.onpageunload = function() {
		
	};
	
	

	scwin.gridView1_oncellclick = function(row,col,colId) {
	   if (colId == "col5") {	//삭제
				
			dataList1.removeRow(row);
		}
	};
	
	scwin.checkFirstColumnValues1 = function() {	
		var tbody = WebSquare.wUnit.getDomById("gridView1_body_tbody");
		var rows = Array.from(tbody.getElementsByTagName("tr"));
		var firstColumnValues = [];
		let reVal = false;
		rows.forEach(row => {
			var firstCell = row.getElementsByTagName("td")[4];
			if (firstCell) {
				var input = firstCell.querySelector("input, select");
				if (input) {
					firstColumnValues.push(input.value); 
				}
			}
		});

		var expectedValues = ["2", "농구", "야구", "야구", "3"];
		var isMatch = JSON.stringify(firstColumnValues) === JSON.stringify(expectedValues);

		if (isMatch) {
			console.log("첫 번째 컬럼의 값이 올바릅니다.");
			reVal = true;
		} else {
			console.log("첫 번째 컬럼의 값이 일치하지 않습니다.");
		}
		return reVal;
	}	

	scwin.checkFourthColumnValues = function() {	
		var tbody = WebSquare.wUnit.getDomById("mf_gridView1_body_tbody");

		var rows = Array.from(tbody.getElementsByTagName("tr"));
		var fourthColumnValues = [];
		let reVal = false;
		
		rows.forEach(row => {
			var fourthCell = row.getElementsByTagName("td")[4]; 
			if (fourthCell) {
				var select = fourthCell.querySelector("select");
				if (select) {
					fourthColumnValues.push(select.value || select.options[select.selectedIndex].text);
				}
			}
		});

		var expectedValues = ["Park (3)", "Buildings (2)", "Temple (1)", "River (5)"];

		var isMatch = JSON.stringify(fourthColumnValues) === JSON.stringify(expectedValues);

		if (isMatch) {
			console.log("네 번째 컬럼의 값이 올바릅니다.");
			reVal = true;			
		} else {
			console.log("네 번째 컬럼의 값이 일치하지 않습니다.");
		}
		return reVal;		
	}
		

	scwin.checkVal = function() {
		return scwin.checkFourthColumnValues();
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_button_0_4').click()");
		WebSquare.wUnit.addCommand("pause", "500");				
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();	
	
]]></script>
