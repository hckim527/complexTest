<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <script type="javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>	
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
               <w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
                        <w2:columnInfo>
                                <w2:column id="col1" name="name1" dataType="text"></w2:column>
                                <w2:column id="col2" name="name2" dataType="text"></w2:column>
                                <w2:column id="col3" name="name3" dataType="text"></w2:column>
                                <w2:column id="col4" name="name4" dataType="text"></w2:column>
                        </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		  var jsonData2 = [{"col1":"q","col2":"w","col3":"e","col4":"r"},{"col1":"1q","col2":"2w","col3":"3e","col4":"4r"},{"col1":"2222q","col2":"w","col3":"e","col4":"r"},{"col1":"3333333333q","col2":"2w","col3":"3e","col4":"4r"},{"col1":"44444444q","col2":"w","col3":"e","col4":"r"},{"col1":"1dcdddcdq","col2":"2w","col3":"3e","col4":"4r"}];
                dataList2.setJSON( jsonData2 );
		
	};
	
	scwin.onpageunload = function() {
		
	};


	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate = function() {
		scwin.simulateWrapper('#gridView2_cell_0_0', 'drag-n-drop', {
			dx: 0,
			dy: 20
		});
	}
	scwin.checkVal = function() {
		return !WebSquare.wUnit.getDomById('gridView2_cell_0_0').classList.contains('focusedTd');
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView2_cell_0_0').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "300");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	   <w2:gridView scrollByColumnAdaptive="false" dataList="data:dataList2" dataDragDrop="true" scrollByColumn="false" style="width:400px;
height:200px;
" id="gridView2" defaultCellHeight="20">
                        <w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
                        <w2:header style="" id="header1">
                                <w2:row style="" id="row1">
                                        <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column7" value="name1" blockSelect="false" displayMode="label">
                                        </w2:column>
                                        <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column5" value="name2" blockSelect="false" displayMode="label">
                                        </w2:column>
                                        <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column3" value="name3" blockSelect="false" displayMode="label">
                                        </w2:column>
                                        <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column1" value="name4" blockSelect="false" displayMode="label">
                                        </w2:column>
                                </w2:row>
                        </w2:header>
                        <w2:gBody style="" id="gBody1">
                                <w2:row style="" id="row2">
                                        <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="col1" value="" blockSelect="false" displayMode="label">
                                        </w2:column>
