<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
        var jsonData = [{col1:"한글테스트가나다러", col2:"test1"}
                        ,{col1:"가나더라", col2:"aaa"}
                        ,{col1:"웹스퀘어1", col2:"abc"}
                        ,{col1:"웹스퀘어2", col2:"TEST2"}
                        ,{col1:"ABD", col2:"ABD"}];
        dataList1.setJSON(jsonData);
	};
	
	scwin.onpageunload = function() {
		
	};

    scwin.autoComplete1_oneditkeyup = function(info, e){
        var logStr = "oldValue=" + info.oldValue + ", newValue=" + info.newValue + ", keyCode=" + info.keyCode;
        WebSquare.logger.printLog(logStr);
        console.log("scwin.autoComplete1_oneditkeyup  : " + logStr);
    };

    scwin.autoComplete1_oneditenter = function(e) {
     var keyCode = (e.charCode) ? e.charCode : e.keyCode;   
     var logStr = "keyCode=" + keyCode;
	 window.val_enter = keyCode;
     WebSquare.logger.printLog(logStr);
     console.log("scwin.autoComplete1_oneditenter  : " + logStr);
 }
	
	scwin.checkVal = function() {
		return window.val_enter == 13;
	}	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">

        <w2:autoComplete editType="select" id="autoComplete3" interactionMode="" useKeywordHighlight="true" style="width : 200px;height:25px" 
            visibleColumnFalseValue="#" 
            submenuSize="auto" search="contain" allOption="false" chooseOption="false"  searchTarget="label" displayMode=""

            accessibility="true" 
            ev:oneditkeyup="scwin.autoComplete1_oneditkeyup"
            ev:oneditenter="scwin.autoComplete1_oneditenter"

            chooseOptionLabel="---select---" class="" caseSensitive="false">
            <w2:choices>
                <w2:itemset nodeset="data:dataList1">
                    <w2:label ref="col1"></w2:label>
                    <w2:value ref="col2"></w2:value>
                </w2:itemset>
            </w2:choices>
        </w2:autoComplete>

        <w2:autoComplete editType="select" id="autoComplete4" interactionMode="" useKeywordHighlight="true" style="width : 200px;height:25px" 
            visibleColumnFalseValue="#" 
            submenuSize="auto" search="contain" allOption="false" chooseOption="false"  searchTarget="label" displayMode=""

            accessibility="false" 
            ev:oneditkeyup="scwin.autoComplete1_oneditkeyup"
            ev:oneditenter="scwin.autoComplete1_oneditenter"

            chooseOptionLabel="---select---" class="" caseSensitive="false">
            <w2:choices>
                <w2:itemset nodeset="data:dataList1">
                    <w2:label ref="col1"></w2:label>
                    <w2:value ref="col2"></w2:value>
                </w2:itemset>
            </w2:choices>
        </w2:autoComplete>
    </body>
</html>
