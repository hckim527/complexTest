    		</w2:choices>
    	</w2:autoComplete>
    	<w2:textbox id="" label="emptyItem" style="position: relative;width: 150px;height: 23px;"></w2:textbox>
    	<w2:autoComplete editType="select" id="autoComplete3" style="position: relative;width: 148px;height: 21px;" submenuSize="auto" search="start"
    		allOption="" chooseOption="" ref="data:dataMap1.key1" emptyItem="true" accessibility="true">
    		<w2:choices>
