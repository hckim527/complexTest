    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
            			<w2:key id="key2" name="name2" dataType="text"></w2:key>
            		</w2:keyInfo>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	dataMap1.set("key1","");
	autoComplete4.setDummyData("", "선택하세요");
	
	console.log(autoComplete1.dom.label.style.display);
	console.log(autoComplete2.dom.label.style.display);
	console.log(autoComplete3.dom.label.style.display);
	console.log(autoComplete4.dom.label.style.display);
};

	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('autoComplete1_input').style.textAlign == 'center';
	}	
	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('autoComplete4_label').style.display == 'none';
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:textbox id="" label='textAlign="center"' style="position: relative;width: 150px;height: 23px;"></w2:textbox>
    	<w2:autoComplete editType="select" id="autoComplete1" style="position: relative;width: 148px;height: 21px;" submenuSize="auto" search="start"
    		allOption="" chooseOption="" ref="" accessibility="true" textAlign="center">
    		<w2:choices>
    			<w2:item>
    				<w2:label><![CDATA[test1]]></w2:label>
    				<w2:value><![CDATA[t1]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[test2]]></w2:label>
