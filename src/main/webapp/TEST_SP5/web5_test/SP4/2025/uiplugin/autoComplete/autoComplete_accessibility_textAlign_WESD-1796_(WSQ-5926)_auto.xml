    	<w2:autoComplete accessibility="true" allOption="" chooseOption="" editType="select" id="autoComplete2" ref="" search="start"
    		style="position: relative;width: 148px;height: 21px;" submenuSize="auto" textAlign="left">
    		<w2:choices>
    			<w2:item>
    				<w2:label><![CDATA[test1]]></w2:label>
