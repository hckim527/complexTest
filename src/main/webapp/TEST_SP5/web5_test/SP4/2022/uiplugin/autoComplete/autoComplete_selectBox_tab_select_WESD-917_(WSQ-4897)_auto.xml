<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>		
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_codeList" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="value" name="value" dataType="text"></w2:column>
						<w2:column id="label" name="label" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dma_data" ev:onmodelchange="scwin.dma_data_onmodelchange">
					<w2:keyInfo>
						<w2:key id="selectBox" name="selectBox" dataType="text"></w2:key>
						<w2:key id="autoComplete" name="autoComplete" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="true">
						<selectBox><![CDATA[1]]></selectBox>
						<autoComplete><![CDATA[2]]></autoComplete>
					</w2:data></w2:dataMap>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() { 
		var codeList = [
			{ value : "1", label : "item1" },
			{ value : "2", label : "item2" }
		];
		dlt_codeList.setJSON(codeList);
	};

	scwin.dma_data_onmodelchange = function(info) {
		textarea1.setValue(JSON.stringify(dma_data.getJSON(), null, "\t"));
	};
	
	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setVal = function() {
		scwin.simulateWrapper('#wq_uuid_17_itemTable', 'key-combo', {
			combo: 'TAB'
		});
	}
	scwin.checkVal = function() {
		return WebSquare.wUnit.getJq("#wq_uuid_17").hasClass("w2selectbox_body_focus");
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_17').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "scwin.setVal()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()	
	]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="padding:10px">
			<xf:group style="width: 100%;height: 45px;" id="">
				<w2:textbox style="width:70.51%;height:23px;padding:10px;font-size:18px;font-weight:bold;float:left;" id="" label="AutoComplete, SelectBox,Item Selection by Tab Key">
				</w2:textbox>
			</xf:group>
			<xf:group style="width:100%;height:200px;" id="grp_group1">
				<xf:group tagname="table" style="width:100%;" id="" class="w2tb">
					<w2:attributes>
						<w2:summary></w2:summary>
					</w2:attributes>
					<xf:group tagname="caption"></xf:group>
					<xf:group tagname="colgroup">
						<xf:group tagname="col" style="width:50.00%;"></xf:group>
						<xf:group tagname="col" style="width:50.00%"></xf:group>
					</xf:group>
					<xf:group tagname="tr" style="">
						<xf:group tagname="th" style="" class="w2tb_th">SelectBox<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes></xf:group>
						<xf:group tagname="td" style="" class="w2tb_td">
							<xf:select1 id="" selectByTabKey="true" chooseOption="" style="width: 148px;height: 21px;" submenuSize="auto" allOption=""
								disabled="false" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="data:dma_data.selectBox">
								<xf:choices>
									<xf:itemset nodeset="data:dlt_codeList">
										<xf:label ref="label"></xf:label>
										<xf:value ref="value"></xf:value>
									</xf:itemset>
								</xf:choices>
							</xf:select1>
						</xf:group>
					</xf:group>
					<xf:group tagname="tr" style="">
						<xf:group tagname="th" style="" class="w2tb_th">AutoComplete<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes></xf:group>
						<xf:group tagname="td" style="" class="w2tb_td">
							<w2:autoComplete editType="select" id="" useKeywordHighlight="false" style="width: 148px;height: 21px;"
								submenuSize="auto" search="start" useLocale="false" allOption="" chooseOption="" ref="data:dma_data.autoComplete">
								<w2:choices>
									<w2:itemset nodeset="data:dlt_codeList">
										<w2:label ref="label"></w2:label>
										<w2:value ref="value"></w2:value>
									</w2:itemset>
								</w2:choices>
							</w2:autoComplete>
						</xf:group>
					</xf:group>
					<xf:group tagname="tr">
						<xf:group tagname="td" class="w2tb_td">
							<w2:attributes>
								<w2:scope>row</w2:scope>
								<w2:colspan>2</w2:colspan>
								<w2:rowspan>1</w2:rowspan>
							</w2:attributes>
							<xf:textarea id="textarea1" style="width: 100%;height: 100px;"></xf:textarea>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
