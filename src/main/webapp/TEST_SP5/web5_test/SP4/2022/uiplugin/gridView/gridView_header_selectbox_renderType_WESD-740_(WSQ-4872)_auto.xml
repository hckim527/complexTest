        <script type="text/javascript" lazy="false"><![CDATA[
        scwin.onpageload = function () {

            var arrSex = [ "남", "m", "여", "f" ];
            dlt_SexList.setData(arrSex);

            var arrData = [ "0", "20100101", "f", "0", "20100101", "m", "0", "20100101", "f", "0", "20100101", "m", "0", "20100101", "f" ];
            dlt_DataList.setData(arrData);
        };

        scwin.changeSex = function (value, colIdx) {
            dlt_DataList.removeColumnFilterAll();

            if (value != "") {
                dlt_DataList.setColumnFilter("sex", value, "and");
            }
        };

        // 행추가
        scwin.btn_AddRow_onclick = function() {
            dlt_DataList.insertRow();
        };

        // 행삭제
        scwin.btn_DelRow_onclick = function() {
            var option = {
                  gridId: "gridView1"
                , chkColId: "itemSelt"
                //, userCallBack: "scwin.deleteAfterCallback"
            };
            webUtil.deleteGridView(option);
        };
		
		scwin.isWithinPercentage = function(a, b, percentage) {
		
			// 두 값의 절대 차이를 계산합니다.
			var difference = Math.abs(a - b);
			
			// a와 b 중 하나의 값의 주어진 비율을 기준으로 차이가 이내인지 확인합니다.
			var percentageDifferenceA = a * (percentage / 100);
			var percentageDifferenceB = b * (percentage / 100);
			
			// 두 값의 차이가 각각의 비율 이내인지 확인합니다.
			return difference <= percentageDifferenceA || difference <= percentageDifferenceB;
		}

		scwin.checkVal = function() {
			let a = WebSquare.wUnit.getJq('#mf_mf_gridView1_head_selectbox_column11_itemTable').width();
			let b = WebSquare.wUnit.getJq('#gridView1_column11').width();

			return scwin.isWithinPercentage(a, b, 2);
		}		
		scwin.unitTest = function(){
			//Unit test
			WebSquare.wUnit.start();

			WebSquare.wUnit.addCommand("pause", "500");
			WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('mf_mf_gridView1_head_selectbox_column11').click()");
			WebSquare.wUnit.addCommand("pause", "500");
			WebSquare.wUnit.addCommand("assert", "scwin.checkVal()","true");
			WebSquare.wUnit.addCommand("pause", "500");
		
			//Run and Stop test
			WebSquare.wUnit.run();
			WebSquare.wUnit.stop();
		}
		scwin.unitTest();			
	]]></script>
