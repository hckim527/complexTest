	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate1 = function() {
		scwin.simulateWrapper('#G_grd_sample___autoComplete_0_itemset02_itemset02_gridViewItemTable_gridView_body_tbody', 'key-sequence', {
			sequence: 'e'
		});
	}
	scwin.setSimulate2 = function() {
		scwin.simulateWrapper('#tac_main_contents_content1_body_popupundefined_header', 'drag-n-drop', {
			dx: -50,
			dy: 0
		});
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_sample_cell_0_1').getElementsByTagName('div')[0].click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('G_'+$p.id+'grd_sample___autoComplete_0_itemset02_itemset02_gridViewItemTable_gridView_cell_3_1').style.backgroundColor != ''", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
