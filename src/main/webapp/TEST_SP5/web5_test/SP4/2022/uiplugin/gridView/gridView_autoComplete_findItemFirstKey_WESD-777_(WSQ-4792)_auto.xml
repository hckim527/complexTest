        grd_sample.setColumnNodeSet("temp4",'data:dlt_cmnCdM001','dtlCdNm','dtlCd');
		
		// 3.조회조건 autoComlete gridViewItemset
        var obj3 = {
            "nodeset" : "data:dlt_cmnCdM001",
            "label" : "dtlCdNm",
