scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#grid1_column2', 'drag-n-drop', {
        dx: 0,
        dy: -50
    });
}
scwin.checkVal = function() {
    return WebSquare.wUnit.getDomById($p.id + 'grid1_headerRowNumber_bodyRow_6').innerText == '가1 [ 1 건 ]' || WebSquare.wUnit.getDomById($p.id + 'grid1_headerRowNumber_bodyRow_0').innerText == '가1 [ 1 건 ]';
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grid1_cell_0_1').click()");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('G_grid1___selectbox_col2_itemTable_1').click()");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "400");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
