<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                	<vector>
                		<data>
                			<chk>1</chk>
                			<col1>1111</col1>
                            <col2>a1</col2>
                		</data>
                		<data>
                			<chk>0</chk>
                			<col1>2222</col1>
                            <col2>a1</col2>
                		</data>
                		<data>
                			<chk>1</chk>
                			<col1>3333</col1>
                            <col2>a1</col2>
                		</data>
                		<data>
                			<chk>1</chk>
                			<col1>4444</col1>
                            <col2>a1</col2>
                		</data>
                		<data>
                			<chk>0</chk>
                			<col1>5555</col1>
                            <col2>a1</col2>
                		</data>
                		<data>
                			<chk>1</chk>
                			<col1>6666</col1>
                            <col2>a1</col2>
                		</data>
                	</vector>
                </data>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    grid1.checkAll(0, "1");
};
scwin.getErrorLog = function() {
    var temp = WebSquare.logger.getErrorLog();
    return temp;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("assert", "scwin.getErrorLog() == ''", "true");
    WebSquare.wUnit.addCommand("pause", "400");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload = function() {
    if (typeof scwin.onpageload === "function") {
        //scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:grid ref="vector" baseNode="vector" repeatNode="data" id="grid1" style="width: 500px;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column3" style="" inputType="checkbox" width="70" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="chk" style="" inputType="checkbox" width="70" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col1" style="" width="70" inputType="text" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:grid>
    	<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[checkAll]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 