<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_codeList" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="value" name="value" dataType="text"></w2:column>
						<w2:column id="label" name="label" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dma_data">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
						<w2:key id="key2" name="name2" dataType="text"></w2:key>
						<w2:key id="key3" name="name3" dataType="text"></w2:key>
						<w2:key id="key4" name="name4" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="true">
						<key1><![CDATA[3]]></key1>
						<key2><![CDATA[2]]></key2>
						<key3><![CDATA[1]]></key3>
						<key4><![CDATA[3]]></key4>
					</w2:data></w2:dataMap>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() { 
		window.temp = 0;
		var codeList = [
			{ value : "1", label : "item1" },
			{ value : "2", label : "item2" },
			{ value : "3", label : "item3" },
			{ value : "4", label : "item4" }
		];
		dlt_codeList.setJSON(codeList);
	};

	scwin.addRadioItemClass = function(radioObj, idx, className) {
		try {
			idx = parseInt(idx);
			if (idx < 0 || idx >= radioObj.getItemCount()) {
				return;
			}

			var labelArr = radioObj.getLabelList();
			radioObj.addClass(labelArr[idx], className);
		} catch (e) {
			console.error(e);
		}
	};

	scwin.removeRadioItemClass = function(radioObj, idx, className) {
		try {
			idx = parseInt(idx);
			if (idx < 0 || idx >= radioObj.getItemCount()) {
				return;
			}

			var labelArr = radioObj.getLabelList();
			radioObj.removeClass(labelArr[idx], className);
		} catch (e) {
			console.error(e);
		}
	};

	scwin.trigger1_onclick = function(e) {
		scwin.addRadioItemClass(radio1, 0, "red");
		scwin.addRadioItemClass(radio1, 2, "red");
	};

	scwin.btn_test_onclick = function(e) {
		scwin.removeRadioItemClass(radio1, 2, "red");
	};

	scwin.trigger4_onclick = function(e) {
		scwin.addRadioItemClass(selectBox1, 0, "red");
		scwin.addRadioItemClass(selectBox1, 2, "red");
	};

	scwin.trigger5_onclick = function(e) {
		scwin.removeRadioItemClass(selectBox1, 2, "red");
	};
	
	scwin.customFormatterSelectBox = function(itemArr) {
		temp++;
		console.log("Calll - customFormatterSelectBox");
		var customArr = itemArr;
		// SelectBox의 customFormatter가 2번 호출되는 현상이 있어서 _isDraw 속성을 추가해서 이미 customFormatter가 호출되었는지를 확인함
		for (var i=0; i < itemArr.length; i++) {
			if (((customArr[i].value === "1") || (customArr[i].value === "3")) && (!customArr[i]._isDraw)) {
				customArr[i].label = "<div style='color: red'>" + itemArr[i].label + "</div>";
				customArr[i]._isDraw = true;
			}
		}
		return customArr;
	};
	
	scwin.checkVal = function() {
		return temp == 1;;
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()	
]]></script>
		<style type="text/css"><![CDATA[
		.red {color:red}
		]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="padding:10px">
			<xf:group style="width: 100%;height: 45px;" id="">
				<w2:textbox style="width:68.81%;height:23px;padding:10px;font-size:18px;font-weight:bold;float:left;" id=""
					label="SelectBox, AutoComplete, CheckCombBox의 Item을 Tab Key로 선택하기">
				</w2:textbox>
			</xf:group>
			<xf:group style="width:100%;height:50px;" id="">
				<xf:trigger ev:onclick="scwin.btn_test_onclick" id="btn_test"
					style="width:151px;height:23px;float:right;margin-top:10px;margin-right:10px;" type="button">
					<xf:label><![CDATA[remove Class Radio]]></xf:label>
				</xf:trigger>
				<xf:trigger ev:onclick="scwin.trigger1_onclick" id="trigger1"
					style="width:122px;height:23px;float:right;margin-top:10px;margin-right:10px;" type="button">
					<xf:label><![CDATA[add Class Radio]]></xf:label>
				</xf:trigger>

				
				<xf:trigger id="trigger5"
					style="width:188px;height:23px;float:right;margin-top:10px;margin-right:10px;" type="button" ev:onclick="scwin.trigger5_onclick">
					<xf:label><![CDATA[remove Class SelectBox]]></xf:label>
				</xf:trigger><xf:trigger id="trigger4" style="width:144px;height:23px;float:right;margin-top:10px;margin-right:10px;" type="button" ev:onclick="scwin.trigger4_onclick">
					<xf:label><![CDATA[add Class SelectBox]]></xf:label>
				</xf:trigger>
			</xf:group>
			<xf:group style="width:100%;height:200px;" id="grp_group1">
				<xf:group tagname="table" style="width:100%;" id="" class="w2tb">
					<w2:attributes>
						<w2:summary></w2:summary>
					</w2:attributes>
					<xf:group tagname="caption"></xf:group>
					<xf:group tagname="colgroup">
						<xf:group tagname="col" style="width:22.09%;"></xf:group>
						<xf:group tagname="col" style="width:50.00%"></xf:group>
					</xf:group>
					<xf:group tagname="tr" style="">
						<xf:group tagname="th" style="" class="w2tb_th">SelectBox<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes></xf:group>
						<xf:group tagname="td" style="" class="w2tb_td">
							<xf:select1 id="selectBox1" chooseOption="" style="width:221px;height:21px;" submenuSize="auto" allOption=""
								disabled="false" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="data:dma_data.key1"
								customFormatter="scwin.customFormatterSelectBox" escape="false">
								<xf:choices>
									<xf:itemset nodeset="data:dlt_codeList">
										<xf:label ref="label"></xf:label>
										<xf:value ref="value"></xf:value>
									</xf:itemset>
								</xf:choices>
							</xf:select1>
						</xf:group>
					</xf:group>
					<xf:group tagname="tr">
						<xf:group tagname="th" style="" class="w2tb_th">
							<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes>
						</xf:group>
						<xf:group tagname="td" style="" class="w2tb_td"></xf:group>
					</xf:group>
					<xf:group tagname="tr">
						<xf:group tagname="th" style="" class="w2tb_th">
							<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes>
						</xf:group>
						<xf:group tagname="td" style="" class="w2tb_td"></xf:group>
					</xf:group>
					<xf:group tagname="tr">
						<xf:group tagname="th" style="" class="w2tb_th">
							<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes>
						</xf:group>
						<xf:group tagname="td" style="" class="w2tb_td"></xf:group>
					</xf:group>
					<xf:group tagname="tr" style="">
						<xf:group tagname="th" style="" class="w2tb_th">Radio<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes></xf:group>
						<xf:group tagname="td" style="" class="w2tb_td">
							<xf:select1 id="radio1" selectedIndex="-1" appearance="full" style="width:612px;height:21px;" cols="3" rows=""
								ref="">
								<xf:choices>
									<xf:item>
										<xf:label><![CDATA[item1]]></xf:label>
										<xf:value><![CDATA[1]]></xf:value>
									</xf:item>
									<xf:item>
										<xf:label><![CDATA[item2]]></xf:label>
										<xf:value><![CDATA[2]]></xf:value>
									</xf:item>
									<xf:item>
										<xf:label><![CDATA[item3]]></xf:label>
										<xf:value><![CDATA[3]]></xf:value>
									</xf:item>
								</xf:choices>
							</xf:select1>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
