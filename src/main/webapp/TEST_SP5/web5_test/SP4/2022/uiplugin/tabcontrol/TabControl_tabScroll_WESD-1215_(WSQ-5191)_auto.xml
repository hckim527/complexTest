    	<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};


	scwin.fireOver = function(node) {
		if (document.createEventObject) {
			node.fireEvent('onmouseover');
		} else if (document.createEvent) {
			var evt = document.createEvent('MouseEvents');
			evt.initEvent('mouseover', true, false);
			node.dispatchEvent(evt);
		} else if (typeof node.onmouseover == 'function') {
			node.onmouseover();
		}
	}
	scwin.fireOut = function(node) {
		if (document.createEventObject) {
			node.fireEvent('onmouseout');
		} else if (document.createEvent) {
			var evt = document.createEvent('MouseEvents');
			evt.initEvent('mouseout', true, false);
			node.dispatchEvent(evt);
		} else if (typeof node.onmouseout == 'function') {
			node.onmouseout();
		}
	}	
	scwin.mouseOverBehaviour = function(id) {
		var el = WebSquare.wUnit.getDomById($p.id + id);
		scwin.fireOver(el);
	}
	scwin.mouseOutBehaviour = function(id) {
		var el = WebSquare.wUnit.getDomById($p.id + id);
		scwin.fireOut(el);
	}	
	scwin.checkVal = function() {
		const tooltipElement = WebSquare.wUnit.getDomById('grd_list_tooltip');
		let reVal = false;
		
		if (tooltipElement) {
			let displayValue = tooltipElement.style.display;
			console.log('tooltip 요소의 display 값:', displayValue);
			reVal = WebSquare.wUnit.getDomById('grd_list_tooltip').style.display != 'block';
		} else {
			console.log('요소가 존재하지 않음: grd_list_tooltip');
			reVal = true;
		}
		return reVal;
	}		
	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('tabControl1_tooltip').style.display == 'block';
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour('tabControl1_btn_scrollRight')");
		WebSquare.wUnit.addCommand("pause", "1200");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand('pause', '500');
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
]]></script>
