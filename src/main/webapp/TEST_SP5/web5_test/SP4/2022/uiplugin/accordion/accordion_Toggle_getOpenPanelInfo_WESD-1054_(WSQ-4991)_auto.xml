<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map"></w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};

	scwin.trigger1_onclick = function(e) {
		var returnArr1 = WebSquare.wUnit.getObjById('accordion1').getOpenPanelListInfo();
		console.log(returnArr1);
	};
	
	scwin.trigger2_onclick = function(e) {
		var returnArr2 = WebSquare.wUnit.getObjById('accordion1').getOpenPanelInfo(1);
		localStorage.setItem("log", returnArr2.id);
		console.log(returnArr2.id);
	};

	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log') == 'mf_accordion1_panel_panels3'", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "localStorage.removeItem('log')");
		
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()
	
	]]></script>
    	<style type="text/css"><![CDATA[

    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:accordion style="width: 60%;height: 80%;margin: 50px;" id="accordion1" class="" collapsible="true" unCollapseAll= "true" selectedPanel="panels3">
    		<w2:panels style="" id="panels1" class="bbbbbbbbbbb" tabIndex="1" >
    			<w2:panelTitle style="" id="panelTitle1" label="1" class=""></w2:panelTitle>
    			<w2:panelContent style="" id="panelContent1" class="">
    				<w2:textbox label="Panel 1"
    					style="width: 150px;height: 23px;margin: 50px;background-color:#C0C0C0;font-size:15px;padding: 10px;font-family:monospace;font-style:normal;font-weight:bolder;"
    					id="">
    				</w2:textbox>
    			</w2:panelContent>
    		</w2:panels>
    		<w2:panels style="" id="panels2" class="" tabIndex="2" disabledPanels="true">
    			<w2:panelTitle style="" id="panelTitle2" class="" label="2"></w2:panelTitle>
    			<w2:panelContent style="" id="panelContent2" class="">
    				<w2:textbox label="Panel 2"
    					style="width: 150px;height: 23px;margin: 50px;background-color:#C0C0C0;font-size:15px;padding: 10px;font-family:monospace;font-style:normal;font-weight:bolder;"
    					id="">
    				</w2:textbox>
    			</w2:panelContent>
    		</w2:panels>
    		<w2:panels style="" id="panels3" class="" tabIndex="3" >
    			<w2:panelTitle style="" id="panelTitle3" label="3"></w2:panelTitle>
    			<w2:panelContent style="" id="panelContent3">
    				<w2:textbox id="" label="Panel 3" style="width: 150px;height: 23px;margin: 50px;background-color:#C0C0C0;font-size:15px;padding: 10px;font-family:monospace;font-style:normal;font-weight:bolder;"></w2:textbox>
    			</w2:panelContent>
    		</w2:panels>
    	</w2:accordion>
    	<xf:trigger type="button" style="width: 200px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[getOpenPanelListInfo test]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" style="width: 200px;height: 23px;" id="trigger2" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[getOpenPanelInfo test]]></xf:label>
    	</xf:trigger>
    	
    </body>
</html>
