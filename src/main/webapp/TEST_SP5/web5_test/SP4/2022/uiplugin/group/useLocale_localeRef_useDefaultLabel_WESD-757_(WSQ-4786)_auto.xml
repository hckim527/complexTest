<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.checkVal = function() {
    return WebSquare.wUnit.getDomById($p.id + 'wq_uuid_13').innerText == 'original output label';
}
scwin.checkVal2 = function() {
    return WebSquare.wUnit.getDomById($p.id + 'wq_uuid_17').innerText == 'original span label';
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "400");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group tagname="table" style="width:90%;margin: 20px;margin-top: 100px;" id="" class="w2tb">
    		<w2:attributes>
    			<w2:summary></w2:summary>
    		</w2:attributes>
    		<xf:group tagname="caption"></xf:group>
    		<xf:group tagname="colgroup">
    			<xf:group tagname="col" style="width:50.00%;"></xf:group>
    			<xf:group tagname="col" style="width:50.00%"></xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="" class="w2tb_th">Anchor<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes></xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<w2:anchor outerDiv="false" style="width:100px;height:23px;color:red;" id="" useLocale="true" localeRef="adbdfe" useDefaultLabel="true">
    					<xf:label><![CDATA[original anchor label]]></xf:label>
    				</w2:anchor>
    			</xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="" class="w2tb_th">Output<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes></xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<xf:output label="" style="width: 150px;height: 23px;border: black solid 1px;color: red;" id="" useLocale="true" localeRef="A0001" useDefaultLabel="true">
    					<xf:label><![CDATA[original output label]]></xf:label>
    				</xf:output>
    			</xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="" class="w2tb_th">Span<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes></xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<w2:span label="original span label" style="color: red;" id="" useLocale="true" localeRef="span" useDefaultLabel="true"></w2:span>
    			</xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="" class="w2tb_th">TextBox<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes></xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<w2:textbox id="" label="original textbox label" style="width: 150px;height: 23px;border: black solid 1px;color: red;" useLocale="true" localeRef="textbox" useDefaultLabel="true"></w2:textbox>
    			</xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="" class="w2tb_th">Trigger<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes></xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<xf:trigger type="button" style="width: 150px;height: 23px;color: red;" id="" localeRef="trigger" useLocale="true" useDefaultLabel="true">
    					<xf:label><![CDATA[original button label]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>
 