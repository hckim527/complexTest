<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
                <w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                        <w2:column id="col5" name="name5" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
        var data = [];
        for (var i = 0; i < 25; i++) {
            data.push(i);
        }
        dataList1.setData(data);
        dataList2.setData(data);
	};
	
	scwin.onpageunload = function() {
		
	};
    scwin.trigger1_onclick = function(e) {
        if (gridView1.options.hideHeader) {
            gridView1.setHeaderHide(false);
        } else {
            gridView1.setHeaderHide(true);
        }
    };
    scwin.trigger2_onclick = function(e) {
        if (gridView2.options.hideHeader) {
            gridView2.setHeaderHide(false);
        } else {
            gridView2.setHeaderHide(true);
        }
    };


	scwin.checkVal = function() {
		return WebSquare.wUnit.getJq('#gridView1_scrollY_div').width() > 0;
	}
	scwin.checkVal2 = function() {
		return WebSquare.wUnit.getJq('#gridView2_scrollY_div').width() > 0;
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
		WebSquare.wUnit.addCommand("pause", "800");

		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <xf:group>
            <xf:trigger type="button" id="trigger1" style="position: absolute ;left:31px;top:4px;width: 180px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
                <xf:label><![CDATA[setHeaderHide toggle]]></xf:label>
            </xf:trigger>
            <w2:textbox id="" label="showLastRow false" style="position: absolute ;left:31px;top:30px;"></w2:textbox>
        	<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="box-sizing:border-box;border:1px solid red;left: 0px;top: 46px;height: 120px;" hideHeader="true" showLastRow="">
        		<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
        		<w2:header id="header1">
        			<w2:row id="row1">
        				<w2:column id="column9" inputType="text" width="170" value="name1">
        				</w2:column>
        				<w2:column id="column7" inputType="text" width="70" value="name2">
        				</w2:column>
        				<w2:column id="column5" inputType="text" width="70" value="name3">
        				</w2:column>
        				<w2:column id="column3" inputType="text" width="70" value="name4">
        				</w2:column>
        				<w2:column id="column1" width="70" inputType="text" value="name5">
        				</w2:column>
        			</w2:row>
        		</w2:header>
        		<w2:gBody id="gBody1">
        			<w2:row id="row2">
        				<w2:column id="col1" inputType="text" width="70" value="">
        				</w2:column>
        				<w2:column id="col2" inputType="text" width="70" value="">
        				</w2:column>
        				<w2:column id="col3" inputType="text" width="70" value="">
        				</w2:column>
        				<w2:column id="col4" inputType="text" width="70" value="">
        				</w2:column>
        				<w2:column id="col5" inputType="text" width="70" value="">
        				</w2:column>
        			</w2:row>
        		</w2:gBody>
        	</w2:gridView>
        </xf:group>
        <xf:group>
            <xf:trigger type="button" id="trigger2" style="position: absolute ;left:31px;top:209px;width: 180px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
                <xf:label><![CDATA[setHeaderHide toggle]]></xf:label>
            </xf:trigger>
            <w2:textbox id="" label="showLastRow true" style="position: absolute ;left:31px;top:250px;"></w2:textbox>
            <w2:gridView dataList="data:dataList2" defaultCellHeight="20" id="gridView2" style="box-sizing:border-box;border:1px solid red;left: 0px;top: 146px;height: 120px;" hideHeader="true" showLastRow="true">
                <w2:caption id="caption1" value="this is a grid caption."></w2:caption>
                <w2:header id="header1">
                    <w2:row id="row1">
                        <w2:column id="column9" inputType="text" width="170" value="name1">
                        </w2:column>
                        <w2:column id="column7" inputType="text" width="70" value="name2">
                        </w2:column>
                        <w2:column id="column5" inputType="text" width="70" value="name3">
                        </w2:column>
                        <w2:column id="column3" inputType="text" width="70" value="name4">
                        </w2:column>
                        <w2:column id="column1" width="70" inputType="text" value="name5">
                        </w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody id="gBody1">
                    <w2:row id="row2">
                        <w2:column id="col1" inputType="text" width="70" value="">
                        </w2:column>
                        <w2:column id="col2" inputType="text" width="70" value="">
                        </w2:column>
                        <w2:column id="col3" inputType="text" width="70" value="">
                        </w2:column>
                        <w2:column id="col4" inputType="text" width="70" value="">
                        </w2:column>
                        <w2:column id="col5" inputType="text" width="70" value="">
                        </w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
    </body>
</html>
