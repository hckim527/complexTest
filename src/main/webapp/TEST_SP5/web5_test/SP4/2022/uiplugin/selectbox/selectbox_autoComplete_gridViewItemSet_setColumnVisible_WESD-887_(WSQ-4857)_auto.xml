        <script type="text/javascript" lazy="false"><![CDATA[
    /****************************************************
     * 화면명 : comboItemSet.xml
     * 화면 설명 : gridViewItemset 기능 테스트
     * 작 성 자  : 김형준
     * 최초 작성 : 2021-10-29
     ****************************************************/
    //화면 초기 로딩 시 호출
    scwin.onpageload = function() {
      
        //SOO(CASE1) : sbx_test
        //SOG(CASE2) : sbx_test2
        //SIO(CASE3) : grd_sample:combo01
        //SIG(CASE4) : grd_sample:itemset01
        //AOO(CASE5) : acb_test
        //AOG(CASE6) : acb_test2
        //AIO(CASE7) : grd_sample:combo02
        //AIG(CASE8) : grd_sample:itemset02
        
        // 1.SOO(CASE1)
        sbx_test.setNodeSet('data:dlt_cmnCdM001','dtlCdNm','dtlCd');
        //comp.setNodeSet("data:" + dltId, gcm.CMNCD_INFO.LABEL, gcm.CMNCD_INFO.VALUE);
        
        // 2.SOG(CASE2)
        var obj1 = {
            "nodeset" : "data:dlt_cmnCdM002",
            "label" : "dtlCdNm",
            "value" : "dtlCd",
            "height" : 300, 
            "hideHeader" : "true",
            "item" : [{"ref" : "dtlCd", "style" : "width:30%"},{"ref" : "dtlCdNm"}]
        };
        sbx_test2.setGridItemset(obj1);
        
        // 3.SIO(CASE3)
        grd_sample.setColumnNodeSet("combo01", "data:dlt_cmnCdM001", "dtlCdNm", "dtlCd");
        
        // 4.SIG(CASE4)
        var obj2 = {
            "nodeset" : "data:dlt_cmnCdM001",
            "label" : "dtlCdNm",
            "value" : "dtlCd",
            "hideHeader" : "true",
            "item" : [{"ref" : "dtlCd", "style" : "text-align:left;width:30%"},{"ref" : "dtlCdNm", "style" : "text-align:left;"}]
        };
        grd_sample.setColumnGridItemset("itemset01", obj2);
        
        // 5.AOO(CASE5)
        acb_test.setNodeSet('data:dlt_cmnCdM001','dtlCdNm','dtlCd');
        
        // 6.AOG(CASE6)
        var obj3 = {
            "nodeset" : "data:dlt_cmnCdM001",
            "label" : "dtlCdNm",
            "value" : "dtlCd",
            "height" : 300, 
            "hideHeader" : "true",
            "item" : [{"ref" : "dtlCd", "style" : "width:30%"},{"ref" : "dtlCdNm"}]
        };
        acb_test2.setGridItemset(obj3);

        // 7.AIO(CASE7)
        grd_sample.setColumnNodeSet("combo02", "data:dlt_cmnCdM001", "dtlCdNm", "dtlCd");

        // 8.AIG(CASE8)
        var obj4 = {
            "nodeset" : "data:dlt_cmnCdM001",
            "label" : "dtlCdNm",
            "value" : "dtlCd",
            //"height" : 300,
            "hideHeader" : "true",
            "item" : [{"ref" : "dtlCd", "style" : "text-align:left;width:30%"},{"ref" : "dtlCdNm", "style" : "text-align:left;"}]
        };
        grd_sample.setColumnGridItemset("itemset02", obj4);
        
        
    };
    
    scwin.btn_search_onclick = function(){
    
        console.log("btn_search_onclick!!!");
        
        //selectbox setColumnVisible
        sbx_test.setVisibleColumn("useYn", "N");
        sbx_test2.setVisibleColumn("useYn", "N");

        //autoComplete setColumnVisible
        acb_test.setVisibleColumn("useYn", "N");
        acb_test2.setVisibleColumn("useYn", "N");
        
        //gridView setColumnVisibleColumn
        grd_sample.setColumnVisibleColumn("combo01" , "useYn" , "N");
        grd_sample.setColumnVisibleColumn("combo02" , "useYn" , "N");
        grd_sample.setColumnVisibleColumn("itemset01" , "useYn" , "N");
        grd_sample.setColumnVisibleColumn("itemset02" , "useYn" , "N");
        
    };
        
    scwin.onpageunload = function() {

    };

	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "document.getElementsByClassName('gridBodyDefault_autoComplete_div_img')[1].click()");
		WebSquare.wUnit.addCommand("pause", "300");
		WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('G_grd_sample___autoComplete_0_itemset02_itemset02_gridViewItemTable').style.display == 'block'", "true");
		WebSquare.wUnit.addCommand("pause", "300");
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
    scwin.unitTest();
	
    ]]></script>
