    			<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
    				<w2:columnInfo>
    					<w2:column id="col1" name="name1" dataType="text" encYN="false"></w2:column>
    					<w2:column id="col2" name="name2" dataType="text" encYN="false"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[





        //ckhbox.checkAll(true);

        scwin.test = function(selectData,b){
        //debugger;
                        if((ckhbox.getItemCount()-1) == selectData.length){
                                return "전체(" + selectData.length + ")";
                        }else{
                                var a = [];
                                for(var i=0;i<selectData.length;i++){
                                        //label값 : undefined, value값 사용
                                        a.push(selectData[i].label);
                                        //a.push(selectData[i].value);
                                }
                                return a.join(",");
                        }
                }


        scwin.ckhbox_oncheckboxclick = function(index,isChecked,value) {
                //debugger;
                console.table(ckhbox.getInfoArray());
        };
		
		scwin.checkVal = function() {
			return WebSquare.wUnit.getDomById('ckhbox_label').innerText == '공백,설정예정';
		}
		scwin.unitTest = function() {
			//Unit
			WebSquare.wUnit.start();
			WebSquare.wUnit.addCommand("pause", "500");
			WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('ckhbox_button').click()");
			WebSquare.wUnit.addCommand("pause", "400");
			WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('ckhbox_itemTable_1_checkbox').click()");
			WebSquare.wUnit.addCommand("pause", "400");
			WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('ckhbox_itemTable_3_checkbox').click()");
			WebSquare.wUnit.addCommand("pause", "400");			
			WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
			WebSquare.wUnit.addCommand("pause", "500");
			//Run test and stop
			WebSquare.wUnit.run();
			WebSquare.wUnit.stop();
		}	
		scwin.unitTest()		
		
		]]></script>
    	<style type="text/css"><![CDATA[ 
    	.select {
		    padding: 15px 10px;
		}
		.select input[type=radio]{
		    display: none;
		}
		.select input[type=radio]+label{
		    display: inline-block;
		    cursor: pointer;
		    height: 24px;
		    width: 90px;
		    border: 1px solid #333;
		    line-height: 24px;
		    text-align: center;
		    font-weight:bold;
		    font-size:13px;
		}
		.select input[type=radio]+label{
		    background-color: #fff;
		    color: #333;
		}
		.select input[type=radio]:checked+label{
		    background-color: #333;
		    color: #fff;
		}
    	]]></style>
    </head>
    <body>
    	<xf:group id="" style="position: relative;padding-top:40px;height:140px;width:700px;" class="">
    		<xf:group id="" style="position: relative;height:50%;" class="">

    			<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" direction="auto" chooseOption="" id=""
    				style="position: relative;width: 148px;height: 21px;" displayMode="label" optionOrder="false" allOption="" disabled="false"
    				submenuSize="auto">
    				<xf:choices>
    					<xf:itemset nodeset="data:dataList1">
