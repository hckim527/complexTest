    						<xf:value><![CDATA[운용]]></xf:value>
    					</xf:item>
    				</xf:choices>
    			</xf:checkcombobox>
    			<xf:select1 appearance="full" id="" style="position: relative;width: 150px;height: 21px;" selectedIndex="-1" cols="" rows=""
    				ref="" class="select" renderType="radiogroup">
    				<xf:choices>
    					<xf:item>
    						<xf:label><![CDATA[전체]]></xf:label>
