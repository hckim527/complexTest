         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger1_onclick = function(e) {
		var options = {
		    type : "selectedColumn",
		    colIndex : Number(sbx_select.getValue())
		}       
		gridView1.setAutoFit( options );
	};
	
	scwin.trigger2_onclick = function(e) {
		gridView1.clearAutoFit()
	};
	
	
	scwin.fireClick = function(node){            
		if( document.createEventObject ) {
			node.fireEvent('oncontextmenu') ;  
		} else if( document.createEvent ) {
			var evt = document.createEvent('MouseEvents');
			evt.initEvent('contextmenu', true, false);
			node.dispatchEvent(evt);    
		} else if (typeof node.contextmenu == 'function' ) {
			node.oncontextmenu();  
		}
	}
	scwin.rightClick = function(id){
		var el = WebSquare.wUnit.getDomById(id);
		scwin.fireClick(el);
	}         
	scwin.checkVal = function(){
		return WebSquare.wUnit.getJq('#grd_index_cell_0_3').width() > 500;
	}   
	scwin.unitTest = function(){
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");

		WebSquare.wUnit.addCommand("set", "scwin.rightClick('grd_index_cell_0_2')");
		WebSquare.wUnit.addCommand("pause", "1000");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_index_contextMenu_list').children[3].click()");
		WebSquare.wUnit.addCommand("pause", "500");

		WebSquare.wUnit.addCommand("set", "scwin.rightClick('grd_index_cell_0_2')");
		WebSquare.wUnit.addCommand("pause", "1000");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_index_contextMenu_list').children[5].click()");
		WebSquare.wUnit.addCommand("pause", "500");

		WebSquare.wUnit.addCommand("set", "scwin.rightClick('grd_index_cell_0_3')");
		WebSquare.wUnit.addCommand("pause", "1000");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_index_contextMenu_list').children[3].click()");
		WebSquare.wUnit.addCommand("pause", "500");
		
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();	
	]]></script>
