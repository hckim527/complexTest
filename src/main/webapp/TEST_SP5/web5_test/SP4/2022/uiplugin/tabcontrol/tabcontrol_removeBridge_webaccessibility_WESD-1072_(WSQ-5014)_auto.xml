<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};


	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('ui_tabControl_tab_tabs1_tabHTML').getAttribute('href') == 'javascript:void(null);';
	}
	
	scwin.unitTest = function() {
		//Unit test
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "1000");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run and Stop test
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();

	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
					<w2:tabControl id="ui_tabControl" closable="true" style="height:230px;margin:12px;position: relative;" removeBridge="true" useAccessibilityMenu="true"  tableRender="ul"
						confirmTrueAction="exist" useConfirmMessage="false" useTabKeyOnly="true" confirmFalseAction="new" tabScroll="true"
						alwaysDraw="false">
						<w2:tabs id="tabs1" style="width:100px;height:30px;" label="tabControl" disabled="false"></w2:tabs>
						<w2:content id="content1" frameMode="" style="height:200px;" src="" alwaysDraw="false">
							<xf:group id="" style="" class="dp">
								<w2:textbox id="" style="border-left: 10px solid #B0C4DE;background-color: #eee;" class="dp dmb"
									label="안내">
								</w2:textbox>
								<w2:textbox id="" style="" label="Content 영역안에 컴포넌트를 배치"></w2:textbox>
							</xf:group>
						</w2:content>
					</w2:tabControl>
    </body>
</html>
