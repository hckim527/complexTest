<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>			
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                    <root>
                        <ui>
                            <grd_info>
                                
                            </grd_info>
                            <codeList>
                                <brCat>
                                    <item>
                                        <itemList_row>
                                            <label>test1</label>
                                            <value>test1</value>
                                        </itemList_row>

                                        <itemList_row>
                                            <label>test2</label>
                                            <value>test2</value>
                                        </itemList_row>
                                    </item>
                                </brCat>
                            </codeList>
                        </ui>
                    </root>
                </data>
            </xf:instance>
            <w2:dataCollection baseNode="map">

            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript"><![CDATA[
        

        scwin.init = function(){
            grid1.insertRow();
            grid1.insertRow();
        }
    
    scwin.trigger1_onclick = function(e) {
        scwin.init();
    };

	scwin.setSimulate1 = function() {
		scwin.simulateWrapper('#grid1_customID_0__default', 'key-sequence', {
			sequence: '111'
		});
	}
	scwin.setSimulate2 = function() {
		scwin.simulateWrapper('#grid1_customID_0__default', 'key-combo', {
			combo: 'ENTER'
		});
	}
	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}

	scwin.checkVal = function() {
		return WebSquare.wUnit.getJq('#grid1_customID_1__default').hasClass('w2input_focus');
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		//WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grid1_customID_0__default').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grid1_customID_0__default').focus()");
		WebSquare.wUnit.addCommand("pause", "500");	
	
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
		WebSquare.wUnit.addCommand('pause', '500');	
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate2()");
		WebSquare.wUnit.addCommand('pause', '500');		
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()	 
		
    ]]></script>
    </head>
    <body>
        <xf:trigger type="button" style="width: 80px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[insertRow]]></xf:label>
        </xf:trigger>

        <w2:grid baseNode="grd_info" id="grid1" repeatNode="smp_row" useShiftKey="true" style="width: 600px;height: 240px;"
            ref="root/ui/grd_info" nodeset="root/ui/grd_info" mergeRefreshAlways="true"
            fixedColumnWithHidden="true" setCellInputTypeCustom="true" autoFit="lastColumn" editorModeEvent="onclick"
            readOnlyTabIgnore="true" keyMoveEditMode="true"
            senseReader="true" focusMode="cell"
            defaultCellHeight="30"
            >
            <w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
            <w2:header style="" id="header1">
                <w2:row style="" id="row1">
                    <w2:column width="170" inputType="text" style="" id="h_col1" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="h_col2" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="h_col3" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="h_col4" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="h_col5" value="" displayMode="label"></w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody style="" id="gBody1">
                <w2:row style="" id="row2">
                    <w2:column width="170" inputType="custom" style="" id="customID" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="custom" style="" id="name" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="custom" style="" id="tel" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="custom" style="" id="tel1" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="custom" style="" id="dep" value="" displayMode="label"></w2:column>
                </w2:row>
            </w2:gBody>
        </w2:grid>
        
    </body>
</html>

