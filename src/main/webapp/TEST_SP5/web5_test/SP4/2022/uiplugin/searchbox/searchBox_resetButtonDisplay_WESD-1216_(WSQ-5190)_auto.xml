<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataMap baseNode="map" id="dataMap1">
    				<w2:keyInfo>
    					<w2:key id="key1" name="name1" dataType="text"></w2:key>
    					<w2:key id="key2" name="name2" dataType="text"></w2:key>
    					<w2:key id="key3" name="name3" dataType="text"></w2:key>
    					<w2:key id="key4" name="name4" dataType="text"></w2:key>
    				</w2:keyInfo>
    			</w2:dataMap>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		dataMap1.set( "key1", "first key1" );
		dataMap1.set( "key2", "first key2" );
		dataMap1.set( "key3", "first key3" );
		dataMap1.set( "key4", "first key4" );
		
		searchbox4.setRef("data:dataMap1.key4");
		searchbox3.setValue("init searchbox3");
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
scwin.searchbox1_onchange = function() {
	console.log("onchange 테스트");
};

scwin.searchbox4_onchange = function() {
//console.log('searchbox4 onchange');
};

scwin.textbox3_onclick = function(e) {
	searchbox3.setRef("data:dataMap1.key3");
};

	
scwin.checkVal = function() {
	return WebSquare.wUnit.getDomById('searchbox1___reset').style.display == 'none';
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
	WebSquare.wUnit.addCommand("pause", "400");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest()

]]></script>
    	<style type="text/css"><![CDATA[
    	.readOnlyYellow{
    		background-color:yellow;
    	}
    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style=";background-color:lightgray;">
    		<w2:textbox ref="" style="width: 150px;height: 23px;" id="textbox2" label="기본동작"></w2:textbox>
    		<w2:searchbox ref="data:dataMap1.key2" ev:onchange="scwin.searchbox4_onchange" style="width: 150px;height: 21px;"
    			id="searchbox2">
    		</w2:searchbox>
    		<w2:searchbox ev:onchange="scwin.searchbox4_onchange" id="key210" ref="data:dataMap1.key2" style="width: 150px;height: 21px;" resetButtonDisplay="show"></w2:searchbox>
    	</xf:group>

    	<xf:group id="">
    		<w2:textbox ref="" style="width:280px;height:23px;" id="" label='resetButtonDisplay="toggle" 시 동작'></w2:textbox>
    		<w2:textbox ref="" style="width:278px;height:26px;" id="textbox1" label='ref="data:dataMap1.key2"'></w2:textbox>
    		<w2:searchbox ref="data:dataMap1.key1" ev:onchange="scwin.searchbox4_onchange" style="width: 150px;height: 21px;"
    			id="searchbox1" resetButtonDisplay="toggle">
    		</w2:searchbox>
    		<w2:textbox ev:onclick="scwin.textbox3_onclick" style="width:267px;height:36px;" id="textbox3"
    			label='click!!! searchbox3.setRef("data:dataMap1.key3");'>
    		</w2:textbox>
    		<w2:searchbox ref="" ev:onchange="scwin.searchbox4_onchange" style="width: 150px;height: 21px;" id="searchbox3"
    			resetButtonDisplay="toggle">
    		</w2:searchbox>
    		<w2:textbox style="width:267px;height:36px;" id="textbox4" label='pageload 시 searchbox4.setRef("data:dataMap1.key4");'>
    		</w2:textbox>
    		<w2:searchbox ref="" ev:onchange="scwin.searchbox4_onchange" style="width: 150px;height: 21px;" id="searchbox4"
    			resetButtonDisplay="toggle">
    		</w2:searchbox>
    	</xf:group>
    	<xf:group id="" style=";background-color:lightgray;">
    		<w2:textbox id="textbox5" label='resetButtonDisplay="hide" 시 동작' ref="" style="width:227px;height:23px;"></w2:textbox>
    		<w2:searchbox ev:onchange="scwin.searchbox4_onchange" id="key2" ref="data:dataMap1.key2" style="width: 150px;height: 21px;" resetButtonDisplay="hide"></w2:searchbox>
    	</xf:group>
    </body>
</html>
