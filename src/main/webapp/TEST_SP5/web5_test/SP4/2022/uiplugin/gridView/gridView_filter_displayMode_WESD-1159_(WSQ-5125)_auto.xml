<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="number"></w2:column>
            			<w2:column id="col2" name="name2" dataType="number"></w2:column>
            			<w2:column id="col3" name="name3" dataType="number"></w2:column>
            			<w2:column id="col4" name="name4" dataType="number"></w2:column>
            			<w2:column id="col5" name="name5" dataType="number"></w2:column>
            			<w2:column id="col6" name="name6" dataType="number"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false"></w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		dataList2.setJSON([{"label":"영","value":0}
						   ,{"label":"일","value":1}
						   ,{"label":"이","value":2}
						   ,{"label":"삼","value":3}
						   ,{"label":"사","value":4}]);

		var jsonData = [
			{"col1":0,"col2":0,"col3":0,"col4":0,"col5":"0","col6":0}
			,{"col1":1,"col2":1,"col3":1,"col4":1,"col5":"1","col6":1}
			,{"col1":2,"col2":2,"col3":2,"col4":2,"col5":"2","col6":2}
			,{"col1":3,"col2":3,"col3":3,"col4":3,"col5":"3","col6":3}
			,{"col1":4,"col2":4,"col3":4,"col4":4,"col5":"4","col6":4}
		];
		dataList1.setJSON(jsonData);
		
		
		
	};
	
	scwin.onpageunload = function() {
		
	};

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('gridView1_customFilter_list').getElementsByTagName('span')[4].innerText == '영';
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_column4_filter').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
	
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView id="gridView1" style="height:150px;" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false"
    		dataList="data:dataList1" useFilterList="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column removeBorderStyle="false" width="100" inputType="text" style="height:20px" id="column4" value="select"
    					blockSelect="false" displayMode="label" useFilter="true" filterDisplayMode="value delim label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="100" inputType="text" style="height:20px" id="column3" value="text"
    					blockSelect="false" displayMode="label" useFilter="true">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="250" inputType="text" style="height:20px" id="column2"
    					value="select, value delim label" blockSelect="false" displayMode="label" useFilter="true">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="150" inputType="text" style="height:20px" id="column1" value="autocomplete"
    					blockSelect="false" displayMode="label" useFilter="true">
    				</w2:column>
    				<w2:column width="170" inputType="text" style="height:20px" id="column7" displayMode="label" useFilter="true"
    					value="checkcombobox">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column removeBorderStyle="false" width="100" inputType="select" style="height:20px" id="col1" blockSelect="false"
    					displayMode="label" filterDisplayMode="label delim value">
    					<w2:choices>
    						<w2:item>
    							<w2:label><![CDATA[영]]></w2:label>
    							<w2:value><![CDATA[0]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[일]]></w2:label>
    							<w2:value><![CDATA[1]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[이]]></w2:label>
    							<w2:value><![CDATA[2]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[삼]]></w2:label>
    							<w2:value><![CDATA[3]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[사]]></w2:label>
    							<w2:value><![CDATA[4]]></w2:value>
    						</w2:item>
    					</w2:choices>
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="100" inputType="text" style="height:20px" id="col2" blockSelect="false"
    					displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="250" inputType="select" style="height:20px" id="col3" blockSelect="false"
    					displayMode="value delim label" filterDisplayMode="label delim value">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="150" inputType="autoComplete" style="height:20px" id="col4"
    					blockSelect="false" displayMode="label">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column width="170" inputType="checkcombobox" style="height:20px" id="col5" displayMode="label">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
