    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[a]]></col1>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[v]]></col1>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[c]]></col1>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
		input1.setValue("input1");
		input2.setValue("input2")
		input1.setNextTabID("input2");
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:textbox id="" label="popup" style="position: relative;width: 150px;height: 23px;"></w2:textbox>
    	<xf:input adjustMaxLength="false" id="input1" style="position: relative;width: 144px;height: 21px;"></xf:input>
    	<xf:trigger type="button" style="width: 80px;height: 23px;" id="trigger1">
    		<xf:label><![CDATA[trigger1]]></xf:label>
    	</xf:trigger>
    	<xf:input adjustMaxLength="false" id="input2" style="width: 144px;height: 21px;" class=""></xf:input>
    	<w2:gridView id="grid1" style="width: 500px;height: 150px;" checkAllType="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" dataList="data:dataList1" useStartEndDiv="true">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="height:20px" id="column9" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column8" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column7" value="name3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="height:20px" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
