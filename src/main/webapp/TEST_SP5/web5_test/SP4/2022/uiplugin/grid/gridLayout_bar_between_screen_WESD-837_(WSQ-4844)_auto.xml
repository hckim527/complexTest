<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <style type="text/css">     
            .gridLayoutCSS {
                background-color:#cece00;
                text-align:center;
                font-size:20pt;
                font-weight:bold;
                overflow:auto;
            }
            .gridLayoutA {
                background-color: #b491e4;
                overflow:auto;
            }
            .gridLayoutB {
                background-color: #62e491;
                overflow:auto;
            }
            .gridLayoutC {
                background-color: #e49162;
                overflow:auto;
            }
            
        </style>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {}
scwin.onpageunload = function() {}
scwin.trigger1_onclick = function() {
    layout1.addResizeBar(1, "row");
}
scwin.trigger2_onclick = function() {
    layout1.addResizeBar(1, "col", {
        "start": "2"
    });
}
scwin.checkVal = function() {
    return ((j) => j.length ? j : $('#mf_wf_header'))($('#wf_header')).height() > 150;
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <w2:gridLayout id="layout1" gridTemplateColumns="1fr 1fr"
            gridTemplateRows="1fr 3fr 3fr" gridColumnGap="6px; 6px; 6px"
            gridRowGap="6px; 10px; 10px" gridRow="1:2/4:2/4" gridColumn="1/3:1/2:2/3" class="gridLayoutCSS" style="position:relative;width:800px;height:500px;"
            defaultClassPostfix="">
            <w2:wframe id="wf_header" style="" src="wf_header.xml" class="gridLayoutA"></w2:wframe>
            <w2:wframe id="wf_main" style="" src="wf_main.xml" class="gridLayoutB"></w2:wframe>
            <w2:wframe id="wf_pop" style="" src="wf_pop.xml" class="gridLayoutC"></w2:wframe>
        </w2:gridLayout>
        <xf:trigger id="trigger1" style="position:relative;height:25px;width:150px;" type="button" ev:onclick="scwin.trigger1_onclick">
            <xf:label>addResizeBar(1,"row")</xf:label>
        </xf:trigger>
        <xf:trigger id="trigger2" style="position:relative;height:25px;width:150px;" type="button" ev:onclick="scwin.trigger2_onclick">
            <xf:label>addResizeBar(1,"col")</xf:label>
        </xf:trigger>
    </body>
</html> 