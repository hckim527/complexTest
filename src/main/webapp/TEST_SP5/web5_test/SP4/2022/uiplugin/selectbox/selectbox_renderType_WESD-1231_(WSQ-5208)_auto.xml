<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" ev:ondataload="" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="code" name="name1"></w2:column>
            			<w2:column dataType="text" id="value" name="name2"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<code><![CDATA[1]]></code>
            				<value><![CDATA[select]]></value>
            			</w2:row>
            			<w2:row>
            				<code><![CDATA[2]]></code>
            				<value><![CDATA[나]]></value>
            			</w2:row>
            			<w2:row>
            				<code><![CDATA[3]]></code>
            				<value><![CDATA[다]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="code" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<code><![CDATA[0]]></code>
            				<value><![CDATA[component]]></value>
            			</w2:row>
            			<w2:row>
            				<code><![CDATA[1]]></code>
            				<value><![CDATA[가]]></value>
            			</w2:row>
            			<w2:row>
            				<code><![CDATA[2]]></code>
            				<value><![CDATA[나]]></value>
            			</w2:row>
            			<w2:row>
            				<code><![CDATA[3]]></code>
            				<value><![CDATA[다]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList3" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="code" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<code><![CDATA[0]]></code>
            				<value><![CDATA[native]]></value>
            			</w2:row>
            			<w2:row>
            				<code><![CDATA[1]]></code>
            				<value><![CDATA[가]]></value>
            			</w2:row>
            			<w2:row>
            				<code><![CDATA[2]]></code>
            				<value><![CDATA[나]]></value>
            			</w2:row>
            			<w2:row>
            				<code><![CDATA[3]]></code>
            				<value><![CDATA[다]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {

	};
	
	scwin.onpageunload = function() {
	};
	
	scwin.trigger1_onclick = function() {
		selectN.setDisabled(true);
		select1.setDisabled(true);
	};

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('select1_label').getAttribute('style') != 'undefined';
	}		
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">

    
        



        <xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" 
        renderType="native"
        disabledClass="w2selectbox_disabled" id="selectN" ref="" 
        style="width:163px;height:21px;" submenuSize="auto">
            <xf:choices>
                <xf:itemset nodeset="data:dataList3">
                    <xf:label ref="value"></xf:label>
                    <xf:value ref="code"></xf:value>
                </xf:itemset>
            </xf:choices>
        </xf:select1>
        
        <xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" 
        renderType=""
        disabledClass="w2selectbox_disabled" id="select1" ref="" 
        style="width:163px;height:21px;" submenuSize="auto">
            <xf:choices>
                <xf:itemset nodeset="data:dataList2">
                    <xf:label ref="value"></xf:label>
                    <xf:value ref="code"></xf:value>
                </xf:itemset>
            </xf:choices>
        </xf:select1>
        
    	
    

		<xf:trigger type="button" 
		style="width: 200px;height: 23px;" 
		id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[API test]]></xf:label> 
    	</xf:trigger>
    </body>
</html>
