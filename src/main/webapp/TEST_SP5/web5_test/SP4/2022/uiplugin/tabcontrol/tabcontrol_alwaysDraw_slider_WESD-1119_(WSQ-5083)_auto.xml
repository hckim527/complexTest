<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="93">
        <script type="javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>		
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
           
           
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
       
      
	scwin.onpageload = function() {
		 
		
	};
	
	scwin.onpageunload = function() {
		 
	};
	

	
	scwin.input1_onkeyup = function(e) {
		debugger;
		slider1.setValue(input1.getValue());
		
	};
	
	scwin.input2_onkeyup = function(e) {
		debugger;
		 slider2.setValue( input2.getValue() );
	};

	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate1 = function() {
		scwin.simulateWrapper('#input2', 'key-sequence', {
			sequence: '50'
		});
	}
	
	scwin.checkVal = function() {
		return WebSquare.wUnit.getJq('#slider2_thumb1').offset().left > 200;
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('tab1_tab_tabs4').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
	
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	
    	<w2:tabControl useTabKeyOnly="true" id="tab1" useMoveNextTabFocus="false" useConfirmMessage="false" confirmTrueAction="exist"
    		confirmFalseAction="new" alwaysDraw="false" style="width: 500px;height: 200px;">
    		<w2:tabs disabled="false" style="width:70px;height:30px;" id="tabs2"></w2:tabs>
    		<w2:tabs disabled="false" style="width:70px;height:30px" id="tabs3"></w2:tabs>
    		<w2:tabs disabled="false" style="width:70px;height:30px" id="tabs4"></w2:tabs>
    		<w2:content alwaysDraw="false" style="height:170px" id="content2">
    		</w2:content>
    		<w2:content alwaysDraw="false" style="height:170px" id="content3">
    			<w2:slider style="position:relative;width:492px;height:30px;" id="slider1" maxValue="100" minValue="0"
    				setBackground="true" showScale="true">
    			</w2:slider>
    			<xf:input adjustMaxLength="false" id="input1" style="width: 144px;height: 21px;float: left;" ev:onkeyup="scwin.input1_onkeyup"></xf:input>
    			<w2:textbox id="" label="점" style="width: 150px;height: 23px;float: left;"></w2:textbox>
    		</w2:content>
    		<w2:content alwaysDraw="true" style="height:170px" id="content4">
    			<xf:group style="width:448px;height:200px;" id="">
    				<w2:slider style="position:relative;width:442px;height:30px;" id="slider2" setBackground="true" showScale="true"
    					maxValue="100" minValue="0">
    				</w2:slider>
    				<xf:input adjustMaxLength="false" id="input2" style="width: 144px;height: 21px;float: left;" ev:onkeyup="scwin.input2_onkeyup"></xf:input>
    				<w2:textbox id="" label="점" style="width: 150px;height: 23px;float: left;"></w2:textbox>
    			</xf:group>
    		</w2:content>
    	</w2:tabControl>
    	
    </body>
</html>
