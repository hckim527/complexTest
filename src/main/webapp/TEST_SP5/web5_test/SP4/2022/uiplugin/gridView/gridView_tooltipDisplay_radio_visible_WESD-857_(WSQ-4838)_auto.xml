scwin.mouseOverBehaviour = function(id) {
    var myElement = WebSquare.wUnit.getDomById($p.id + id);
    myElement.addEventListener("mouseover", function() {
        console.log('hover');
    });
    var mouseEvent = document.createEvent("MouseEvent");
    mouseEvent.initEvent('mouseover', true, true);
    myElement.dispatchEvent(mouseEvent);
}
scwin.checkVal = function() {
    return WebSquare.wUnit.getDomById($p.id + 'G_wq_uuid_3___radio_col2_0').checked;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('G_wq_uuid_3___radio_col2_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour('G_'+$p.id+'wq_uuid_3___radio_col2_0')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
