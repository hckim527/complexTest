         <script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
    var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
    var r = d(id); if (r) return r;
    var s = dd(P + id); r = d(s); if (r) return r;
    var g = s.indexOf('G_');
    if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
    return d(s.replace(P, ''));
};
scwin.onpageload = function() {
    dataList1.insertRow()
    dataList1.insertRow()
    dataList1.insertRow()
    dataList1.insertRow()
    dataList1.insertRow()
};
scwin.onpageunload = function() {};
scwin.mouseOverBehaviour = function(id) {
    var myElement = scwin.__getDom($p.id + id);
    myElement.addEventListener("mouseover", function() {
        console.log('hover');
    });
    var mouseEvent = document.createEvent("MouseEvent");
    mouseEvent.initEvent('mouseover', true, true);
    myElement.dispatchEvent(mouseEvent);
}
scwin.checkVal = function() {
    return scwin.__getDom($p.id + 'G_wq_uuid_3___radio_col2_0').checked;
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
}
]]></script>
