			scwin.checkVal = function() {
				// 행 높이(CSS) 무관 판정: 확장된 데이터 영역을 렌더 행이 채우는지(빈 공간 < 1행)
				var bodyH = WebSquare.wUnit.getJq('#gridView1_body_table').height();
				var layerH = WebSquare.wUnit.getJq('#gridView1_dataLayer').height();
				var rowH = WebSquare.wUnit.getJq('#gridView1_body_table td.gridBodyDefault').first().outerHeight();
				return layerH > 130 && bodyH > layerH - rowH;
			}
			scwin.unitTest = function() {
				//Unit
				WebSquare.wUnit.start();
				WebSquare.wUnit.addCommand("pause", "500");
				WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_scrollY_div').scrollTop = 300");
				WebSquare.wUnit.addCommand("pause", "500");
				WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_scrollY_div').scrollTop = 0");
				WebSquare.wUnit.addCommand("pause", "500");
				WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_6').click()");
				WebSquare.wUnit.addCommand("pause", "500");
				WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_6').click()");
				WebSquare.wUnit.addCommand("pause", "500");
				
				WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
				WebSquare.wUnit.addCommand("pause", "500");
				//Run test and stop
				WebSquare.wUnit.run();
				WebSquare.wUnit.stop();
			}	
