	scwin.setButtonDisplay = function(data, formattedData, rowIndex, colIndex) {

		var rtnVal = "";
		var col1Val = dataList1.getCellData(rowIndex,"col1");
		if(col1Val == "1"){
			rtnVal = '<input type="button" role="button" class="btnTest1" value="등록">' 
					 +'<input type="button" role="button" class="btnTest2" value="취소">';	
		}else{
			rtnVal = '<input type="button" role="button" class="btnTest1" value="등록">';			
		}
		
		return rtnVal;
	};
	

	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setVal = function() {
		scwin.simulateWrapper('#gridView1_cell_0_8', 'key-combo', {
			combo: 'TAB'
		});
	}
	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('gridView1_cell_0_9').style.backgroundColor != '';
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_0_8').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "scwin.setVal()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()	
]]></script>
