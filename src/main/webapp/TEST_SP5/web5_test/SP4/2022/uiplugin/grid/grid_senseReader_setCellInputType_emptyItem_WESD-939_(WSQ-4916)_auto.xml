<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                    <root>
                        <ui>
                            <grid_large>
                                <itemList_row>
                                    <a>a1</a>
                                    <b>b1</b>
                                    <c>c1</c>
                                </itemList_row>
                                <itemList_row>
                                    <a>a2</a>
                                    <b>b2</b>
                                    <c>c2</c>
                                </itemList_row>
                            </grid_large>
                        </ui>
                        <codeList>
                            <brCat>
                                <item>
                                    <itemList_row>
                                        <label>la_a1</label>
                                        <value>va_a1</value>
                                    </itemList_row>
                                    <itemList_row>
                                        <label>la_a2</label>
                                        <value>va_a2</value>
                                    </itemList_row>
                                    <itemList_row>
                                        <label>la_a3</label>
                                        <value>va_a3</value>
                                    </itemList_row>
                                    <itemList_row>
                                        <label>la_a4</label>
                                        <value>va_a4</value>
                                    </itemList_row>
                                    <itemList_row>
                                        <label>la_a5</label>
                                        <value>va_a5</value>
                                    </itemList_row>
                                </item>
                            </brCat>
                        </codeList>
                    </root>
                </data>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript"><![CDATA[
        
            scwin.trigger2_onclick = function(e) {
                grid1.removeAll();
                grid1.insertRow();
                var selectInfo = {
                    inputType : "select",
                    options : {viewType:"icon", emptyItem:"true"}, 
                    itemSet : {nodeset : "root/codeList/brCat/item/itemList_row", label:"label", value:"value"}
                };
                grid1.setCellInputType(0,1,selectInfo);
                
            };
           scwin.init = function(){
               
            };
            
            scwin.init();


			scwin.checkVal = function() {
				return WebSquare.wUnit.getJq('#grid1_dynamic_select_0_1_input_0').val() === null;
			}	
			scwin.unitTest = function() {
				//Unit
				WebSquare.wUnit.start();
				WebSquare.wUnit.addCommand("pause", "500");
				WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");		
				WebSquare.wUnit.addCommand("pause", "500");
				WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
				WebSquare.wUnit.addCommand("pause", "500");
				//Run test and stop
				WebSquare.wUnit.run();
				WebSquare.wUnit.stop();
			}
			scwin.unitTest();	
	
        ]]></script>
    </head>
    <body>
        <xf:trigger type="button" id="trigger2" style="width: 150px;height: 25px;" ev:onclick="scwin.trigger2_onclick">
            <xf:label><![CDATA[setCellInputType]]></xf:label>
        </xf:trigger>
        <w2:grid baseNode="grid_large" id="grid1" repeatNode="itemList_row" senseReader="true" setCellInputTypeCustom="true"
            ref="root/ui/grid_large" nodeset="root/ui/grid_large/itemList_row"
            useShiftKey="true" style="width: 500px;height: 150px;" fixedColumnWithHidden="true">
            <w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
            <w2:header style="" id="header1">
                <w2:row style="" id="row1">
                    <w2:column removeBorderStyle="false" width="170" inputType="text" style="height:20px" id="column2" value=""
                        blockSelect="false" displayMode="label">
                    </w2:column>
                    <w2:column removeBorderStyle="false" width="170" inputType="text" style="height:20px" id="column1" value=""
                        blockSelect="false" displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody style="" id="gBody1">
                <w2:row style="" id="row2">
                    <w2:column removeBorderStyle="false" width="170" inputType="custom" style="height:20px" id="a" value=""
                        blockSelect="false" displayMode="label">
                    </w2:column>
                    <w2:column removeBorderStyle="false" width="170" inputType="custom" style="height:20px" id="b" value=""
                        blockSelect="false" displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:gBody>
        </w2:grid>
    </body>
</html>
