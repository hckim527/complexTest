<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
            			<w2:key id="key2" name="name2" dataType="text"></w2:key>
            		</w2:keyInfo>
            		<w2:data use="true">
            			<key1sfsfsfs><![CDATA[ ]]></key1sfsfsfs>
            			<key1sfsfs><![CDATA[ ]]></key1sfsfs>
            			<key1><![CDATA[dddd]]></key1>
            			<key2><![CDATA[222]]></key2>
            		</w2:data>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
	
	};
	
	scwin.onpageunload = function() {
		
	};
	
	scwin.trigger2_onclick = function(e) {
		searchbox1.setDisabled(false);
	};
	
	scwin.trigger3_onclick = function(e) {
		input1.setDisabled(false);
	};
	
	scwin.checkVal = function() {
		return WebSquare.wUnit.getJq('#searchbox1___input').hasClass('w2input_disabled') == false;
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()		
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:textbox id="" label="dataMap1.key1 " style="width: 150px;height: 23px;"></w2:textbox>
    	<w2:searchbox id="searchbox1" style="width: 150px;height: 21px;" ref="data:dataMap1.key1" ev:onchange="scwin.searchbox1_onchange"
    		readOnly="" disabled="true">
    	</w2:searchbox>
    	<xf:trigger type="button" style="width: 170px;height: 23px;" id="trigger2" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[searchbox.setDisabled]]></xf:label>
    	</xf:trigger>
    	<w2:textbox id="" label="" style="width: 150px;height: 23px;" ref="data:dataMap1.key1"></w2:textbox>
    	<xf:input adjustMaxLength="false" id="input1" style="width: 144px;height: 21px;" ref="data:dataMap1.key1" disabled="true"></xf:input>
    	<xf:trigger type="button" style="width: 150px;height: 23px;" id="trigger3" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[input.setDisabled]]></xf:label>
    	</xf:trigger>


    	<w2:textbox id="" label="dataMap1.key2" style="width: 150px;height: 23px;margin-top: 40px;"></w2:textbox>

    	<w2:searchbox ev:onchange="scwin.searchbox1_onchange" id="key2" ref="data:dataMap1.key2" style="width: 150px;height: 21px;">
    	</w2:searchbox>
    	<w2:textbox id="" label="" ref="data:dataMap1.key2" style="width: 150px;height: 23px;"></w2:textbox>
    	<xf:input adjustMaxLength="false" id="" ref="data:dataMap1.key2" style="width: 144px;height: 21px;"></xf:input>
    </body>
</html>
