<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[useaa]]></col2>
							<col3><![CDATA[a]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[usea]]></col2>
							<col3><![CDATA[a1]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[uses]]></col2>
							<col3><![CDATA[a2]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[usea]]></col2>
							<col3><![CDATA[b]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[usezzz]]></col2>
							<col3><![CDATA[b1]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var json = [{
            "col1": "1",
            "col2": "aa",
            "col3": "a"
        },
        {
            "col1": "2",
            "col2": "a",
            "col3": "a1"
        }, {
            "col1": "3",
            "col2": "s",
            "col3": "a2"
        }, {
            "col1": "1",
            "col2": "a",
            "col3": "b"
        }, {
            "col1": "2",
            "col2": "zzz",
            "col3": "b1"
        }
    ];
    dataList2.setJSON(json);
};
scwin.onpageunload = function() {};
scwin.checkVal = function() {
    return WebSquare.wUnit.getDomById('_headerRowNumber_bodyRow_5').innerText == '10';
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('tabc_side_tab_tabs2').click()");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('trv_menu_label_1').innerText == 'aa'", "true");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('trv_menu_label_2').innerText == 'a'", "true");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('trv_menu_label_3').innerText == 's'", "true");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('trv_menu_label_4').innerText == 'a'", "true");
    WebSquare.wUnit.addCommand("pause", "400");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
		<w2:tabControl useTabKeyOnly="true" id="tabc_side" useMoveNextTabFocus="false" useConfirmMessage="false"
