			<w2:tabs disabled="false" style="width:70px;height:30px;" id="tabs1" label="메뉴"></w2:tabs>
			<w2:tabs disabled="false" style="width:95px;height:30px;" id="tabs2" label="즐겨찾기"></w2:tabs>
			<w2:content alwaysDraw="false" style="height:300px;" id="content1">
			</w2:content>
			<w2:content alwaysDraw="false" style="height:300px;" id="content2">
				<xf:group id="side" class="">
					<xf:group id="" tabIndex="" tagname="ul">
						<xf:group id="" tagname="li">
							<w2:treeview tooltipGroupClass="false" dataType="listed" style="width: 200px;height: 150px;" id="trv_menu">
								<w2:itemset nodeset="data:dataList2">
									<w2:label ref="col2"></w2:label>
									<w2:value ref="col3"></w2:value>
									<w2:depth ref="col1"></w2:depth>
									<w2:folder ref=""></w2:folder>
									<w2:checkbox ref=""></w2:checkbox>
									<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
									<w2:image ref=""></w2:image>
									<w2:iconImage ref=""></w2:iconImage>
									<w2:selectedImage ref=""></w2:selectedImage>
									<w2:expandedImage ref=""></w2:expandedImage>
									<w2:leafImage ref=""></w2:leafImage>
								</w2:itemset>
							</w2:treeview>
							<w2:gridView id="gridView1" style="width: 400px;height: 150px;" scrollByColumn="false" defaultCellHeight="20"
								scrollByColumnAdaptive="false" dataList="data:dataList2" disabledScrollHidden="" ev:oncellclick="scwin.gridView1_oncellclick">
								<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header style="" id="header1">
									<w2:row style="" id="row1">
										<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column1" value="col1"
											blockSelect="false" displayMode="label">
										</w2:column>
										<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column11" value="col2"
											blockSelect="false" displayMode="label">
										</w2:column>
										<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column12" value="col3"
											blockSelect="false" displayMode="label">
										</w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody style="" id="gBody1">
									<w2:row style="" id="row2">
										<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="col1" value=""
											blockSelect="false" displayMode="label">
										</w2:column>
										<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="col2" value=""
											blockSelect="false" displayMode="label">
										</w2:column>
										<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="col3" value=""
											blockSelect="false" displayMode="label">
										</w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</w2:content>
		</w2:tabControl>
	</body>
</html>
 