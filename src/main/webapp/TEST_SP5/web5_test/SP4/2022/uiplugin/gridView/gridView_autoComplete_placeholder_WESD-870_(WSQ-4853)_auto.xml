                    <w2:column width="150" inputType="text" style="height:20px" id="column7" value="textImage" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody3">
    			<w2:row style="" id="row6">
    				<w2:column width="70" inputType="autoComplete" style="height:20px" id="col1" value="" displayMode="label" allOption=""
    					chooseOption="" ref="" placeholder="placeholder test" chooseOptionLabel="">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
