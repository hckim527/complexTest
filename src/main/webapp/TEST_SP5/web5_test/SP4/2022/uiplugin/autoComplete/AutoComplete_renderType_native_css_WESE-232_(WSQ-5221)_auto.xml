<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getJq('#wq_uuid_2').hasClass('w2autoComplete_acc');
	}		

	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();	
	
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:autoComplete editType="select" id="" useKeywordHighlight="false" style="width: 148px;height: 21px;" submenuSize="auto"
    		search="start" useLocale="false">
    	</w2:autoComplete>
    	<w2:autoComplete editType="select" id="" search="start" style="width: 148px;height: 21px;" submenuSize="auto"
    		useKeywordHighlight="false" useLocale="false" renderType="native">
    	</w2:autoComplete>
    	<xf:group tagname="table" style="width:500px;" id="" class="w2tb">
    		<w2:attributes>
    			<w2:summary></w2:summary>
    		</w2:attributes>
    		<xf:group tagname="caption"></xf:group>
    		<xf:group tagname="colgroup">
    			<xf:group tagname="col" style="width:30.00%;"></xf:group>
    			<xf:group tagname="col" style=""></xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="" class="w2tb_th">AutoComplete<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes></xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<w2:autoComplete editType="select" id="" search="start" style="width: 148px;height: 21px;" submenuSize="auto"
    					useKeywordHighlight="false" useLocale="false">
    				</w2:autoComplete>
    				<w2:autoComplete editType="select" id="" renderType="native" search="start" style="width: 148px;height: 21px;"
    					submenuSize="auto" useKeywordHighlight="false" useLocale="false">
    				</w2:autoComplete>
    			</xf:group>
    		</xf:group></xf:group>
    </body>
</html>
