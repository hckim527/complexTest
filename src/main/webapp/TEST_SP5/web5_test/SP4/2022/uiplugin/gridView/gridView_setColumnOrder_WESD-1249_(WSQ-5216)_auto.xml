<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		dataList1.insertRow( );
		dataList1.insertRow( );
		dataList1.insertRow( );
		dataList1.insertRow( );
		dataList1.insertRow( );
	};
	
	scwin.onpageunload = function() {
		
	};
    scwin.trigger1_onclick = function(e) {
        var columnOrderArray = gridView1.getColumnOrder(true);
        console.log("before setColumnOrder", columnOrderArray);
        gridView1.setColumnOrder(columnOrderArray);
		debugger;
		localStorage.setItem('log', columnOrderArray[0]);
        console.log("after setColumnOrder", columnOrderArray);
    };
	
	scwin.checkVal1 = function() {
		return localStorage.getItem('log') == 'col1';
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand('pause', '500');
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()
	localStorage.removeItem("log");
	
	]]></script>
        <style type="text/css"><![CDATA[
         ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <xf:trigger type="button" id="trigger1" style="position: absolute ;left:31px;top:9px;width: 180px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[setColumnOrder]]></xf:label>
        </xf:trigger>
    	<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1" autoFit="allColumn" style="left: 0px;top: 46px;height: 229px;" syncScroll="false">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column id="column9" style="" inputType="text" width="70" value="name1"></w2:column>
    				<w2:column id="column7" style="" inputType="text" width="70" value="name2"></w2:column>
    				<w2:column id="column5" style="" inputType="text" width="70" value="name3"></w2:column>
    				<w2:column id="column3" style="" inputType="text" width="70" value="name4"></w2:column>
    				<w2:column id="column1" style="" inputType="text" width="70" value="name5"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column id="col1" style="" inputType="text" width="70"></w2:column>
    				<w2:column id="col2" style="" inputType="text" width="70"></w2:column>
    				<w2:column id="col3" style="" inputType="text" width="70"></w2:column>
    				<w2:column id="col4" style="" inputType="text" width="70"></w2:column>
    				<w2:column id="col5" style="" inputType="text" width="70"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
