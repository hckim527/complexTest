<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
                        <w2:column id="col6" name="name6" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
        var data = [];
        for (var i = 0; i < 30; i++) {
            data.push(i);
        }
        dataList1.setData(data);
	};
	
	scwin.onpageunload = function() {
		
	};


	scwin.checkVal = function() {
		return WebSquare.wUnit.getJq('#G_gridView1___spinner_col1___input').hasClass('w2input_focus');
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_0_0').click()");
		WebSquare.wUnit.addCommand("pause", "400");

		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
    
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <xf:group>
            <w2:textbox id="" label="editType select" style="position: relative"></w2:textbox>
            <w2:spinner skin="" buttonSize="30" inputReadOnly="false" id="spinner1" style="position: relative;width: 180px;height: 23px;" editType="select" validateOnInput="" autoFocus="true" initValue="11" dateIncrementType="month" nextTabID="input1" title="spinner1"></w2:spinner>
            <w2:textbox id="" label="editType focus" style="position: relative"></w2:textbox>
            <w2:spinner skin="" buttonSize="30" inputReadOnly="false" id="spinner2" style="position: relative;width: 180px;height: 23px;" editType="focus" validateOnInput="" autoFocus="true" initValue="12" dateIncrementType="month" nextTabID="input1" title="spinner2"></w2:spinner>
            <w2:textbox id="" label="editType ''" style="position: relative"></w2:textbox>
            <w2:spinner skin="" buttonSize="30" inputReadOnly="false" id="spinner3" style="position: relative;width: 180px;height: 23px;" editType="focus" validateOnInput="" autoFocus="true" initValue="12" dateIncrementType="month" nextTabID="input1" title="spinner3"></w2:spinner>
        	<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" editModeEvent="onclick" style="position:relative;box-sizing:border-box;border:1px solid red;height: 120px;" hideHeader="" showLastRow="">
        		<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
        		<w2:header id="header1">
        			<w2:row id="row1">
        				<w2:column id="column9" inputType="text" width="120" value="editType select">
        				</w2:column>
        				<w2:column id="column7" inputType="text" width="120" value="editType focus">
        				</w2:column>
        				<w2:column id="column5" inputType="text" width="120" value="editType ''">
        				</w2:column>
        				<w2:column id="column3" inputType="text" width="120" value="text editType select">
        				</w2:column>
                        <w2:column id="column2" inputType="text" width="120" value="text editType focus">
                        </w2:column>
                        <w2:column id="column1" inputType="text" width="220" value="text editType '' default focus">
                        </w2:column>
        			</w2:row>
        		</w2:header>
        		<w2:gBody id="gBody1">
        			<w2:row id="row2">
        				<w2:column id="col1" viewType="icon" inputType="spinner" editType="select" width="70" value="">
        				</w2:column>
        				<w2:column id="col2" viewType="icon" inputType="spinner" editType="focus" width="70" value="">
        				</w2:column>
                        <w2:column id="col3" viewType="icon" inputType="spinner" editType="" width="70" value="">
                        </w2:column>
        				<w2:column id="col4" inputType="text" editType="select" width="70" value="">
        				</w2:column>
        				<w2:column id="col5" inputType="text" editType="focus" width="70" value="">
        				</w2:column>
        				<w2:column id="col6" inputType="text" width="70" value="">
        				</w2:column>
        			</w2:row>
        		</w2:gBody>
        	</w2:gridView>
        </xf:group>
    </body>
</html>
