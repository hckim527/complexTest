};

	scwin.checkColumnValues = function() {
		const tbody = WebSquare.wUnit.getDomById("mf_gridView1_body_tbody");
		const rows = Array.from(tbody.getElementsByTagName("tr"));		
		const expectedValues = [true, true, true, true, true];
		let fourthColumnValues = [];
		let first_reValue = false;
		let second_reValue = false;
		debugger;
		rows.forEach((row, rowIndex) => {
			var fourthColumn = row.getElementsByTagName("td")[2]; 
			if (fourthColumn && rowIndex < 5) {
				var hasFixedColumnClass = fourthColumn.classList.contains("w2grid_fixedColumn");
				fourthColumnValues.push(hasFixedColumnClass); 
			}			
		});
		var isMatch = JSON.stringify(fourthColumnValues) === JSON.stringify(expectedValues);
		
		return isMatch;
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkColumnValues()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()	
	
]]></script>
