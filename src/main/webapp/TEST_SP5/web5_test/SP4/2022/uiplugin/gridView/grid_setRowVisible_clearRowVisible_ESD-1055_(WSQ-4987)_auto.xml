         <script type="text/javascript"><![CDATA[
        
    scwin.sel1_onviewchange = function(info){
        grid1.clearRowVisible();

        if(info.value == "all") return;

        var rowCnt = grid1.getRowCount();
        var temp = WebSquare.ModelUtil.findInstanceNodes("root/smp/smp_row");
        for(i=0;i<rowCnt;i++){
            var telData = WebSquare.xml.getValue(temp[i], "tel");
            if(telData != info.value){
                grid1.setRowVisible(i, false);
            }
        }
    }
    scwin.trigger1_onclick = function(e) {
        grid1.setTopRowIndex(0);
    };

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('grid1_cell_5_1').innerText == 'a20';
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('select1_input_0').click()");
		WebSquare.wUnit.addCommand("pause", "400");		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('select1_input_1').click()");
		WebSquare.wUnit.addCommand("pause", "400");		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('select1_input_2').click()");
		WebSquare.wUnit.addCommand("pause", "400");	
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grid1_scrollY_div').scrollTop=500");
		WebSquare.wUnit.addCommand("pause", "400");			
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()	
	
    ]]></script>
