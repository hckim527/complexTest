<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                    <root>
                        <ui>
                            <mksg0011VoList2>
                                <mksg0011VoList2_row>
                                    <crpcWrtDt>test1</crpcWrtDt>
                                    <crpcTit1>test1</crpcTit1>
                                </mksg0011VoList2_row>
                                <mksg0011VoList2_row>
                                    <crpcWrtDt>test2</crpcWrtDt>
                                    <crpcTit1>test2</crpcTit1>
                                </mksg0011VoList2_row>
                                <mksg0011VoList2_row>
                                    <crpcWrtDt>test3</crpcWrtDt>
                                    <crpcTit1>test3</crpcTit1>
                                </mksg0011VoList2_row>
                            </mksg0011VoList2>
                            <mksg0011VoList>
                                <mksg0011VoList_row>
                                    <crpcWrtDt>test1-1</crpcWrtDt>
                                    <crpcTit1>test1-1</crpcTit1>
                                </mksg0011VoList_row>
                                <mksg0011VoList_row>
                                    <crpcWrtDt>test2-2</crpcWrtDt>
                                    <crpcTit1>test2-2</crpcTit1>
                                </mksg0011VoList_row>
                                <mksg0011VoList_row>
                                    <crpcWrtDt>test3-3</crpcWrtDt>
                                    <crpcTit1>test3-3</crpcTit1>
                                </mksg0011VoList_row>
                            </mksg0011VoList>
                        </ui>
                    </root>
                </data>
            </xf:instance>
            <w2:dataCollection baseNode="map">

            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript"><![CDATA[


        scwin.init = function(){
        }
    
        scwin.trigger1_onclick = function(e) {
            var nodeStr = "<tmp><mksg0011VoList2></mksg0011VoList2></tmp>";
            var nodeObj = WebSquare.xml.parse(nodeStr);

            WebSquare.xml.appendChild(WebSquare.ModelUtil.findInstanceNode({xpath:"root"}), nodeObj.documentElement);
            WebSquare.ModelUtil.copyChildrenNodes({ srcXPath:"root/tmp/mksg0011VoList2", destXPath:"root/ui/mksg0011VoList2", mode:"replaceAll",scopeId:this.getScope().id});
        };
        scwin.init();


		scwin.checkVal = function() {
			return WebSquare.wUnit.getJq('#grid1').height() < 40;
		}
		scwin.unitTest = function() {
			//init
			WebSquare.wUnit.start();
			WebSquare.wUnit.addCommand("pause", "500");
			WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
			WebSquare.wUnit.addCommand("pause", "400");
			WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
			WebSquare.wUnit.addCommand("pause", "500");
			//Run  and stop
			WebSquare.wUnit.run();
			WebSquare.wUnit.stop();
		}
		scwin.unitTest()		
		
		
    ]]></script>
    </head>
    <body>
        <xf:trigger type="button" style="width: 180px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[copyChildrenNodes]]></xf:label>
        </xf:trigger>
        <w2:grid baseNode="mksg0011VoList2" id="grid1" repeatNode="mksg0011VoList2_row" useShiftKey="true" style="width: 600px;height: 31px;z-index:2;"
            ref="root/ui/mksg0011VoList2" nodeset="root/ui/mksg0011VoList2/mksg0011VoList2_row" 
            defaultCellHeight="30" visibleRowNum="all" noResultMessageVisible="false"
            >
            <w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
            <w2:header style="" id="header1">
                <w2:row style="" id="row1">
                    <w2:column width="70" inputType="text" style="" id="h_col1" value="status" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="h_col2" value="등록일" displayMode="label"></w2:column>
                    <w2:column width="170" inputType="text" style="" id="h_col3" value="제목" displayMode="label"></w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody style="" id="gBody1">
                <w2:row style="" id="row2">
                    <w2:column width="70" inputType="text" style="" id="status" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="crpcWrtDt" value="" displayMode="label"></w2:column>
                    <w2:column width="170" inputType="text" style="" id="crpcTit1" value="" displayMode="label"></w2:column>
                    
                </w2:row>
            </w2:gBody>
        </w2:grid>
        <w2:grid baseNode="mksg0011VoList" id="grid2" repeatNode="mksg0011VoList_row" useShiftKey="true" style="width: 600px;height: 372px;z-index:1;" hideHeader="true"
            ref="root/ui/mksg0011VoList" nodeset="root/ui/mksg0011VoList/mksg0011VoList_row" 
            defaultCellHeight="30" visibleRowNum="all" noResultMessageVisible="false"
            >
            <w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
            <w2:header style="" id="header1">
                <w2:row style="" id="row1">
                    <w2:column width="70" inputType="text" style="" id="h_col1" value="status" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="h_col2" value="등록일" displayMode="label"></w2:column>
                    <w2:column width="170" inputType="text" style="" id="h_col3" value="제목" displayMode="label"></w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody style="" id="gBody1">
                <w2:row style="" id="row2">
                    <w2:column width="70" inputType="text" style="" id="status" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="crpcWrtDt" value="" displayMode="label"></w2:column>
                    <w2:column width="170" inputType="text" style="" id="crpcTit1" value="" displayMode="label"></w2:column>
                    
                </w2:row>
            </w2:gBody>
        </w2:grid>
        
    </body>
</html>

