<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="false">
						<key1></key1>
					</w2:data></w2:dataMap>
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[12345.67]]></col1>
							<col2><![CDATA[12345.67]]></col2>
							<col3><![CDATA[12345.67]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
		scwin.onpageload = function() {
			input1.setValue("12345678.24");
		};
		
		scwin.onpageunload = function() {
			
		};

		scwin.trigger1_onclick = function() {
			var maxLen = input1.getMaxLength() 
			console.log(maxLen);
			localStorage.setItem('log', maxLen);
			//alert(maxLen);	
		};


		scwin.checkVal = function(){
			return localStorage.getItem('log') == 8.2;
		}   
		scwin.unitTest  = function(){
			//init
			WebSquare.wUnit.start();
			WebSquare.wUnit.addCommand("pause", "500");
			WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
			WebSquare.wUnit.addCommand("pause", "400");	
			WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
			WebSquare.wUnit.addCommand("pause", "500");

			//Run  and stop
			WebSquare.wUnit.run();
			WebSquare.wUnit.stop();
		}
		scwin.unitTest();	
		localStorage.removeItem("log");
		
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
		
		<xf:group id="" style="margin-top:100px;">
			<xf:input id="input1" style="width: 144px;height: 21px;float:left;margin-right:20px;" adjustMaxLength="false" validateOnInput="true" floatNumber="true"
				ref="data:dataMap1.key1" initValue="" maxLength="8.2" maxByteLength="" dataType="number" byteCheckIgnoreChar="" euroMask="" numberMask="#,###.##" displayFormat="#,###.##" customModelFormatter="customModelFormatter"
				customModelUnformatter="customModelUnformatter" applyFormat="all">
			</xf:input>
			<xf:trigger type="button" id="trigger1" style="height: 23px;margin-right:5px;" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[input.getMaxLength]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
