		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate = function() {
    scwin.simulateWrapper('#wq_uuid_7_cell_1_0', 'drag-n-drop', {
        dx: 0,
        dy: 20
    });
}
scwin.checkVal = function() {
    return WebSquare.wUnit.getJq('#grid1_customFilter_scrollView').is(':visible');
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_7_cell_1_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
    WebSquare.wUnit.addCommand("pause", "500");
    //WebSquare.wUnit.addCommand("assert", "checkVal3()", "true");
    WebSquare.wUnit.addCommand("pause", "300");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
