<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
		<w2:config>
			<WebSquare>
				<selectbox>
					<chooseOption value="true"/>
				</selectbox>
			</WebSquare>
		</w2:config>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="label" name="label" dataType="text"></w2:column>
            			<w2:column id="value" name="value" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[라벨]]></label>
            				<value><![CDATA[값]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[테스트]]></label>
            				<value><![CDATA[테스트]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('calendar2_img').click()");
    WebSquare.wUnit.addCommand("pause", "300");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('calendar2_calendar_selectbox_month_button').click()");
    WebSquare.wUnit.addCommand("pause", "300");
    WebSquare.wUnit.addCommand("assert", "document.getElementsByClassName('w2table_sb_row')[0].innerText == '1월'", "true");
    WebSquare.wUnit.addCommand("pause", "300");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group style="" id="">
    		<w2:inputCalendar footerDiv="false" id="calendar2" style="width: 150px;height: 23px;" renderDiv="true" focusOnDateSelect="false"
    			calendarValueType="yearMonthDate" rightAlign="false" renderType="component" name="calendar1">
    		</w2:inputCalendar>
    		<xf:select1 id="" chooseOption="" style="width: 148px;height: 21px;" submenuSize="auto" allOption="" disabled="false"
    			direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOptionLabel="선택" ref="">
    			<xf:choices>
    				<xf:itemset nodeset="data:dataList1">
    					<xf:label ref="label"></xf:label>
    					<xf:value ref="value"></xf:value>
    				</xf:itemset>
    			</xf:choices>
    		</xf:select1>
    	</xf:group>
    </body>
</html>
 