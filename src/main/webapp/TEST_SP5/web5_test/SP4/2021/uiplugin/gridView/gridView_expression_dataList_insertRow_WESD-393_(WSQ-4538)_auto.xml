		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    optRowAdd1.setValue(scwin.getCode(scwin.btnRowAdd1_onclick));
};
scwin.onpageunload = function() {};
scwin.btnRowAdd1_onclick = function(e) {
    dlsample01.insertRow(0);
};
scwin.getCode = function(objFunc) {
    if (objFunc == null)
        return;
    var result = objFunc.toString();
    var arrs = result.split(/\n/);
    for (var i = 0; i < arrs.length; i++) {
        if (i == 0 || i == arrs.length - 1) {
            arrs[i] = "";
        }
    }
    return arrs.join("\n").trim().replace(/\t{3}/g, "");
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btnRowAdd1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btnRowAdd1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btnRowAdd1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('gridMain_cell_1_9').innerText == ':'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();


