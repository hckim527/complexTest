<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text" importFormatter=""></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var json = [{
        "col1": "   A",
        "col2": "1"
    }, {
        "col1": "     ABc",
        "col2": "2"
    }, {
        "col1": "       B",
        "col2": "3"
    }, {
        "col1": "4",
        "col2": "4"
    }];
    dataList1.setJSON(json);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    s1.show();
};
scwin.checkVal = function() {
    return WebSquare.wUnit.getJq('#s1').width() == WebSquare.wUnit.getJq('#s2').width();
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "300");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "300");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:trigger type="button" style="width: 200px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[display:none 된 selectbox 보이기 ]]></xf:label>
        </xf:trigger>
    	<xf:select1 id="s1" chooseOption="" style="width: 148px;height: 21px;display: none;" submenuSize="auto" allOption="" disabled="false"
    		direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="" labelWidthAuto="true">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[new row]]></xf:label>
    				<xf:value><![CDATA[]]></xf:value>
    			</xf:item>
    			<xf:item>
