scwin.chkMultiCellVisible = function(grdObj, chkColumn, columnArrStr, modifiedIndex) {
    modifiedIndex = parseInt(modifiedIndex);
    var grdComp;
    if (typeof grdObj !== "undefined") {
        if (typeof grdObj === "string") {
            grdComp = $p.getComponentById(grdObj);
        } else {
            grdComp = grdObj;
        }
    }
    var dcObjId = grdComp.getDataList();
    var dcObj = $p.getComponentById(dcObjId);
    var gridId = grdComp.getID();
    var rowCnt = dcObj.getTotalRow();
    var multiColumnArr = columnArrStr.split(",");
    var multiColumnArrLength = multiColumnArr.length;
    for (var i = 0; i < rowCnt; i++) {
        for (var j = 0; j < multiColumnArrLength; j++) {
            var cellName = multiColumnArr[j];
            var txt = dcObj.getCellData(i, chkColumn);
            console.log("i = " + txt);
            if (txt.trim() != "") {
                grdComp.setCellVisible(i, cellName, true);
            } else {
                grdComp.setCellVisible(i, cellName, false);
            }
        }
    }
    if (modifiedIndex > -1) {
        for (var j = 0; j < multiColumnArrLength; j++) {
            //추가한 rowIndex show visible 처리 
            grdComp.setCellVisible(modifiedIndex, cellName, true);
        }
    }
};
scwin.unitTest = function() {
