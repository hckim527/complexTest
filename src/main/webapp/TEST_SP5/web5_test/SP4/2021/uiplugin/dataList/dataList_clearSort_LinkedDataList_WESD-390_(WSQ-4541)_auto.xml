		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    outCode5.setValue(scwin.getCode(scwin.btnSort5_onclick));
    outCode6.setValue(scwin.getCode(scwin.btnSort6_onclick));
    outCode7.setValue(scwin.getCode(scwin.btnSort7_onclick));
};
scwin.onpageunload = function() {};
scwin.btnSort5_onclick = function(e) {
    ldlsample01.sort("col4", 0);
    // 0:오름차순, 1:내림차순, 2:정렬취소			 
};
scwin.btnSort6_onclick = function(e) {
    ldlsample01.multisort({
        sortIndex: "col4 col5",
        sortOrder: "1 -1"
    });
    // 1:오름차순, -1:내림차순
};
scwin.btnSort7_onclick = function(e) {
    ldlsample01.clearSort();
};
scwin.getCode = function(objFunc) {
    if (objFunc == null)
        return;
    var result = objFunc.toString();
    var arrs = result.split(/\n/);
    for (var i = 0; i < arrs.length; i++) {
        if (i == 0 || i == arrs.length - 1) {
            arrs[i] = "";
        }
    }
    return arrs.join("\n").trim().replace(/\t{3}/g, "");
};
scwin.getErrorLog = function() {
    var temp = WebSquare.logger.getErrorLog();
    return temp;
    // return temp.indexOf("error문구");
    // return temp.indexOf("error");
}
scwin.unitTest = function() {
    //Unit tets
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btnSort6').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btnSort7').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btnSort7').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.getErrorLog() == ''", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

]]></script>
