<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name3" dataType="text"></w2:column>
                        <w2:column id="col5" name="name3" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
};
scwin.onpageunload = function() {};
scwin.gridView1_onviewchange = function(info) {};
scwin.trigger1_onclick = function() {
    gridView1.setFocusedMultiCell(1, 1, 3, 3, {
        ignoreFocusMode: true
    });
};
scwin.trigger2_onclick = function() {
    gridView1.setFocusedMultiCell(1, 1, 3, 3);
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "300");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+$p.id+'gridView1_cell_1_3').style.backgroundColor == 'rgb(252, 167, 60)'", "true");
    WebSquare.wUnit.addCommand("pause", "300");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+$p.id+'gridView1_cell_1_4').style.backgroundColor == ''", "true");
    WebSquare.wUnit.addCommand("pause", "300");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1" focusMode="row"
            style="width: 500px;height: 150px;" ev:onviewchange="scwin.gridView1_onviewchange" ev:onrowindexchange="scwin.gridView1_onrowindexchange">
            <w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
            <w2:header id="header2" style="">
                <w2:row id="row3" style="">
                    <w2:column blockSelect="false" id="column9" removeBorderStyle="false" style="" width="70" inputType="text" value="name1"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column7" removeBorderStyle="false" style="" inputType="text" width="70" value="name2"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70" value="name3"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" width="70" inputType="text" value="name4"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column1" removeBorderStyle="false" style="" width="70" inputType="text" value="name5"
                        displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody id="gBody2" style="">
                <w2:row id="row4" style="">
                    <w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" width="70" inputType="text" value=""
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="col4" removeBorderStyle="false" style="" width="70" inputType="text" value=""
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="col5" removeBorderStyle="false" style="" width="70" inputType="text" value=""
                        displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
        <xf:trigger type="button" id="trigger1" style="position: relative ;left:0px;top:9px;width: 280px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[setFocusedMultiCell ignore focusMode]]></xf:label>
        </xf:trigger>
        <xf:trigger type="button" id="trigger2" style="position: relative ;left:0px;top:9px;width: 280px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
            <xf:label><![CDATA[setFocusedMultiCell]]></xf:label>
        </xf:trigger>
    </body>
</html>
 