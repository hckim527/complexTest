<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.checkVal1 = function() {
    return WebSquare.wUnit.getJq('#accordion1_panel_panels2_title_image').hasClass('w2panels_title_image_open') == true;
}
scwin.checkVal2 = function() {
    return WebSquare.wUnit.getJq('#accordion1_panel_panels3_title_image').hasClass('w2panels_title_image_open') == true;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload = function() {
    if (typeof scwin.onpageload === "function") {
        //scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:accordion id="accordion1" unCollapseAll="true" collapseAll="" style="position: absolute ;width: 1000px;height: 800px;" collapsible=""
    		selectedPanel="" class="" titleDivTag=""  panelMoveSpeed="">
    		<w2:panels id="panels1" style="" class="">
    			<w2:panelTitle id="panelTitle1" style="" class="" label="1"></w2:panelTitle>
    			<w2:panelContent id="panelContent1" style="height:300px;" class="">
    				<xf:input adjustMaxLength="false" enterBlur="true" id="input1"
    					style="position: absolute ;left:58px;top:15px;width: 180px;height: 174px;">
    				</xf:input>
    				<xf:input adjustMaxLength="false" enterBlur="true" id="input2"
    					style="position: absolute ;left:301px;top:20px;width: 180px;height: 174px;">
    				</xf:input>
    			</w2:panelContent>
    		</w2:panels>
    		<w2:panels id="panels2" style="" class="">
    			<w2:panelTitle id="panelTitle2" style="" class="" label="2"></w2:panelTitle>
    			<w2:panelContent id="panelContent2" style="height:200px;" class="">
    				<xf:select id="" appearance="full" style="position: absolute ;left:108px;top:338px;width: 90px;height: 50px;"
    					selectedindex="-1">
    				</xf:select>
    				<xf:textarea id="textarea1" style="position: absolute ;left:244px;top:25px;width: 224px;height: 97px;"></xf:textarea>
    			</w2:panelContent>
    		</w2:panels>
    		<w2:panels id="panels3" style="" class="">
    			<w2:panelTitle id="panelTitle3" style="" class="" label="3"></w2:panelTitle>
    			<w2:panelContent id="panelContent3" style="height:350px;" class="">
    				<xf:input adjustMaxLength="false" id="" style="position: absolute ;left:202px;top:67px;width: 267px;height: 61px;">
    				</xf:input>
    				<xf:select1 appearance="full" id="select1" style="position: absolute ;left:589px;top:91px;width: 54px;height: 25px;"
    					selectedIndex="-1">
    				</xf:select1>
    			</w2:panelContent>
    		</w2:panels>
    	</w2:accordion>
    </body>
</html>
 