};
scwin.fireDbClick = function(id) {
    var node = WebSquare.wUnit.getDomById($p.id + id);
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.___isCheckLog = function() {
    return WebSquare.logger.getErrorLog() == "";
}
scwin.__isCheckVal = function() {
    return WebSquare.wUnit.getDomById($p.id + 'G_gridView2___autoComplete_0_col1_col1_itemTable') != null;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.fireDbClick($p.id+'gridView2_cell_0_0')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('G_gridView2___autoComplete_0_col1_col1_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.__isCheckVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //End unitTest	
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
