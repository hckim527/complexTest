<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>		
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                        <w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		dataList1.insertRow();
		dataList1.insertRow();
		dataList1.insertRow();
	};
	
	scwin.onpageunload = function() {
		
	};

	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate1 = function() {
		scwin.simulateWrapper('#wq_uuid_3_cell_0_0', 'key-combo', {
			combo: 'down-arrow'
		});
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_3_cell_0_0').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
		WebSquare.wUnit.addCommand("pause", "400");
		//WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'G_'+$p.id+'wq_uuid_3__col1').style.display == 'block'", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		//WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#G_wq_uuid_3__col1').val() == 'a'", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView id="" noSelect="true" style="width: 700px;height: 150px;" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" directEdit="true"
    		dataList="data:dataList1">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column removeBorderStyle="false" width="100" inputType="text" style="height:20px" id="column5" value="text"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="100" inputType="text" style="height:20px" id="column4" value="textarea"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="100" inputType="text" style="height:20px" id="column3" value="textImage"
    					blockSelect="false" displayMode="label">
    				</w2:column>
                    <w2:column removeBorderStyle="false" width="100" inputType="text" style="height:20px" id="column2" value="calendar"
                        blockSelect="false" displayMode="label">
                    </w2:column>
                    <w2:column removeBorderStyle="false" width="100" inputType="text" style="height:20px" id="column1" value="spinner"
                        blockSelect="false" displayMode="label">
                    </w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column removeBorderStyle="false" width="100" inputType="text" style="height:20px" id="col1" value=""
    					blockSelect="false" displayMode="label" embeddedInput="">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="100" inputType="textarea" style="height:20px" id="col2" value=""
    					blockSelect="false" displayMode="label" embeddedInput="">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="100" inputType="textImage" style="height:20px" id="col3" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
                    <w2:column removeBorderStyle="false" width="100" inputType="calendar" style="height:20px" id="col4" value=""
                        blockSelect="false" displayMode="label" embeddedInput="" viewType="icon" viewTypeIconImage="true">
                    </w2:column>
                    <w2:column removeBorderStyle="false" width="100" inputType="spinner" style="height:20px" id="col5" value=""
                        blockSelect="false" displayMode="label">
                    </w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
