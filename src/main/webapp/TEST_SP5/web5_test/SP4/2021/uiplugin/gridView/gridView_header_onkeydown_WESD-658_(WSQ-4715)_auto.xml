<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>	  
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[]]></col1>
            				<col2><![CDATA[2]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[]]></col1>
            				<col2><![CDATA[3]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	//그리드에서 해더체크박스를 클릭후 키보드 동작시 onkeydown 이벤트가 동작을 안하네요.
	//확인 부탁드립니다.
	//버전 websquare_5.0_4.4504B.20211001.114327_1.5.jar
	scwin.grd1_onkeydown = function(e) {
	    localStorage.setItem("log", "event");	
		//alert(e.keyCode);
	};

	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate = function() {
		scwin.simulateWrapper('#wq_uuid_3_header__column3_checkboxLabel__id', 'key-combo', {
			combo: 'TAB'
		});
	}	
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_3_header__column3_checkboxLabel__id').click()");
		WebSquare.wUnit.addCommand("pause", "500");

		WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
		WebSquare.wUnit.addCommand("pause", "500");
			
		WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log') == 'event'", "true");

		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "localStorage.removeItem('log')");		
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView id="grd1" style="width: 500px;height: 150px;" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" dataList="data:dataList1" checkAllType="exclude" ev:onkeydown="scwin.grd1_onkeydown">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="checkbox" style="height:20px" id="column3" value="" displayMode="label"
    					checkboxLabel="테스트">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column1" value="컬럼1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column4" value="컬럼2" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="checkbox" style="height:20px" id="col1" value="" displayMode="label" disabled=""></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column5" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
