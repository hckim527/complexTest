         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.btn_columnOrder_onclick = function(e) {
    scwin.orgOrder = grd_ColumnOrder.columnOrder;
    //var a = [0,5,1,2,3,4];
    //var a = [0,5];
    var a = ["col5", "col4", "col3"];
    for (var i = 0; i < a.length; i++)
        grd_ColumnOrder.setColumnVisible(a[i], true);
    grd_ColumnOrder.setColumnOrder(a);
};
scwin.btn_columnOrder_Reset_onclick = function(e) {
    grd_ColumnOrder.setColumnOrder(scwin.orgOrder);
};
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#grd_ColumnOrder_cell_0_4', 'key-combo', {
        combo: 'down-arrow'
    });
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_columnOrder').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_ColumnOrder_cell_0_4').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('grd_ColumnOrder_cell_1_4').style.backgroundColor != ''", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_columnOrder_Reset').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_ColumnOrder_cell_0_4').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('grd_ColumnOrder_cell_1_4').style.backgroundColor != ''", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

]]></script>
