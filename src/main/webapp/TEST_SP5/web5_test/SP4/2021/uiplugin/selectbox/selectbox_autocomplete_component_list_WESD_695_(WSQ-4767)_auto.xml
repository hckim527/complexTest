}
scwin.selectbox1_onkeydown = function(e) {
    var keyCode = e.keyCode;
    console.log(this.id, keyCode);
}
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#selectbox1_button', 'key-combo', {
        combo: 'down-arrow'
    });
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('selectbox1_button').click()");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('selectbox1_button').click()");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "400");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('selectbox1_label').innerText == 'AA1'", "true");
    WebSquare.wUnit.addCommand("pause", "400");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
