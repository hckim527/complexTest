<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map" rowNumData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text" importFormatter="scwin.setRowData"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.setJSON([{
        col1: "",
        col2: "11",
        col3: ""
    }, {
        col1: "",
        col2: "22",
        col3: ""
    }, {
        col1: "",
        col2: "33",
        col3: ""
    }]);
};
scwin.onpageunload = function() {};
scwin.setRowData = function(rowJson, rowIndex, colIndex) {
    //		rowJson.col3 = rowIndex + 1;
    return rowIndex + 1;
};
scwin.trigger1_onclick = function(e) {
    alert(JSON.stringify(dataList1.getAllJSON()));
};
scwin.testFnc = function() { //debugger;
    //alert("ok");
    localStorage.setItem("log", 'ok');
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView4_cell_0_0').children[0].click()");
    WebSquare.wUnit.addCommand("pause", "300");
    WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log') == 'ok'", "true");
    WebSquare.wUnit.addCommand("pause", "300");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    localStorage.removeItem("log");
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="data:dataList1" summaryAuto="false" 
    	applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20" 
    	scrollByColumnAdaptive="false" id="gridView4" style="width: 500px;height: 150px;" 
    	ignoreCellClick="false" syncScroll="false" ignoreToggleOnDisabled="false" 
    	summaryOnlyAuto="false" useShiftKey="true" ev:oncellclick="scwin.testFnc" >
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column9" removeBorderStyle="false" footerDiv="false" style="" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column7" removeBorderStyle="false" footerDiv="false" style="" inputType="text" width="185" value='rowNumData="true"' displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column5" removeBorderStyle="false" footerDiv="false" style="" inputType="text" width="188" value="setRowData" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" removeBorderStyle="false" footerDiv="false" style="" inputType="radio" width="70" value="" displayMode="label" adaptiveStyle="" radioLabel="label"></w2:column>
    				<w2:column blockSelect="false" id="seq" removeBorderStyle="false" footerDiv="false" style="" inputType="expression" expression="rowIndex() +1" width="185" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col3" removeBorderStyle="false" footerDiv="false" style="" inputType="text" width="188" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" style="width:127px;height:23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[dataList value]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 