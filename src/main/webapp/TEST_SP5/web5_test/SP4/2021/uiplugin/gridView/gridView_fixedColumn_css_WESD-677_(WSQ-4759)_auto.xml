<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name1" dataType="text"></w2:column>
                        <w2:column id="col5" name="name1" dataType="text"></w2:column>
                        <w2:column id="col6" name="name2" dataType="text"></w2:column>
                        <w2:column id="col7" name="name3" dataType="text"></w2:column>                        
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
        scwin.onpageload = function() {
            var data = [];
            for(var i = 0; i < 70; i++){
                data.push( Math.floor(i / 2) - Math.floor(i / 3));
                data.push(i);
                data.push(i*i);  
            }
            dataList1.setData(data);
        };
        
        scwin.onpageunload = function() {
            
        };
		
	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getJq('#gridView1_cell_0_1').hasClass('w2grid_fixedColumn');
	}
	scwin.checkVal2 = function() {
		return WebSquare.wUnit.getJq('#gridView1_cell_0_6').hasClass('w2grid_fixedRightColumn');
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
		WebSquare.wUnit.addCommand("pause", "400");		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()			
        ]]></script>
        <style>
            .w2grid_fixedRow {
                border-bottom : 2px solid #ff0000;
            }

            .w2grid_lastFixedRow {
                border-bottom : 2px solid #00ff00;
            }

            .w2grid_fixedColumn {
                border-left : 2px solid #0000ff;
            }

            .w2grid_fixedRightColumn {
                border-left : 2px solid #ff00ff;
            }
        </style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20" id="gridView1"
    		style="position: relative;width:479px;height:309px;" useShiftKey="true" evenRowBackgroundColor="" oddEvenColorDisplay="true" oddRowBackgroundColor="" rowNumVisible="true" fixedColumn="1" fixedRightColumn="1" oddEvenColorMerged="false" rowStatusVisible="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" style="" inputType="text" width="70" value="name1"></w2:column>
    				<w2:column blockSelect="false" id="column2" style="" inputType="text" width="70" value="name2"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="name3"></w2:column>
                    <w2:column blockSelect="false" id="column4" style="" inputType="text" width="70" value="name4"></w2:column>
                    <w2:column blockSelect="false" id="column5" style="" inputType="text" width="70" value="name5"></w2:column>
                    <w2:column blockSelect="false" id="column6" style="" inputType="text" width="70" value="name6"></w2:column>
                    <w2:column blockSelect="false" id="column7" style="" inputType="text" width="70" value="name7"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" inputType="text" width="70"></w2:column>
                    <w2:column blockSelect="false" id="col4" style="" inputType="text" width="70"></w2:column>
                    <w2:column blockSelect="false" id="col5" style="" inputType="text" width="70"></w2:column>
                    <w2:column blockSelect="false" id="col6" style="" inputType="text" width="70"></w2:column>
                    <w2:column blockSelect="false" id="col7" style="" inputType="text" width="70"></w2:column>                    
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
