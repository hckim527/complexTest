            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
        "col1": "100",
        "col2": "100",
        "col3": "33",
        "col4": "44"
    }, {
        "col1": "200",
        "col2": "300",
        "col3": "33",
        "col4": "44"
    }, {
        "col1": "100",
        "col2": "500",
        "col3": "33",
        "col4": "55"
    }, {
        "col1": "500",
        "col2": "700",
        "col3": "33",
        "col4": "55"
    }];
    dataList1.setJSON(jsonData);
};
scwin.onpageunload = function() {};
scwin.checkVal = function() {
	const ele1 = WebSquare.wUnit.getDomById('grid1__headerRowNumber');
	const ele2 = WebSquare.wUnit.getDomById('grid1__headerRowNumber_footer');
	return ele1 !== null && ele2 !== null;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
