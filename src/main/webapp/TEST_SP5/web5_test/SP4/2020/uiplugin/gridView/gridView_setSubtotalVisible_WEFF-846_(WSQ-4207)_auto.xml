<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
                        <w2:columnInfo>
                                <w2:column id="col1" name="name1" dataType="text"></w2:column>
                                <w2:column id="col2" name="name2" dataType="text"></w2:column>
                                <w2:column id="col3" name="name3" dataType="text"></w2:column>
                                <w2:column id="col4" name="name4" dataType="text"></w2:column>
                        </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.trigger4_onclick = function(e) {
    var jsonData1 = [{
            "col1": "aa",
            "col2": "1"
        }, {
            "col1": "aa",
            "col2": "2"
        }, {
            "col1": "bb",
            "col2": "3"
        },
        {
            "col1": "bb",
            "col2": "4"
        }, {
            "col1": "bb",
            "col2": "5"
        }, {
            "col1": "cc",
            "col2": "6"
        }, {
            "col1": "cc",
            "col2": "7"
        }
    ];
    dataList1.setJSON(jsonData1);
};
scwin.select1_onviewchange = function(info) {
    if (select1.getValue() == "X") {
        gridView1.setSubtotalVisible(false);
    } else {
        gridView1.setSubtotalVisible(true);
    }
};
scwin.__hasClass = function() {
    var classList = WebSquare.wUnit.getDomById($p.id + 'gridView1_body_tbody').children[13].className;
    return classList.indexOf('w2grid_hidedRow') == -1;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger4').click()");
    WebSquare.wUnit.addCommand('pause', '500');
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('select1_input_0').click()");
    WebSquare.wUnit.addCommand('pause', '500');
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('select1_input_0').click()");
    WebSquare.wUnit.addCommand('pause', '500');
    WebSquare.wUnit.addCommand("assert", "scwin.__hasClass()", "true");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <w2:gridView id="gridView1" style="width: 500px;height:300px;" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" initFixedHeightByRowNum="20"
                dataList="data:dataList1" visibleRowNum="">
                <w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
                <w2:header style="" id="header1">
                        <w2:row style="" id="row1">
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column7" value="name1" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column5" value="name2" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column3" value="name3" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column1" value="name4" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                        </w2:row>
                </w2:header>
                <w2:gBody style="" id="gBody1">
                        <w2:row style="" id="row2">
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="col1" value="" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="col2" value="" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="col3" value="" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="col4" value="" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                        </w2:row>
                </w2:gBody>
                <w2:subTotal targetColumnID="col1" style="" id="subTotal1">
                        <w2:row style="" id="row3">
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column12" value="" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                                <w2:column removeBorderStyle="false" width="70" inputType="expression" style="" id="column11" value="" blockSelect="false"
                                        displayMode="label" expression="SUM('col2')">
                                </w2:column>
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column10" value="" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column9" value="" blockSelect="false"
                                        displayMode="label">
                                </w2:column>
                        </w2:row>
                </w2:subTotal>
        </w2:gridView>
        <xf:trigger ev:onclick="scwin.trigger4_onclick" id="trigger4" style="width: 80px;height: 23px;left:0px;top:0px;" type="button">
                <xf:label><![CDATA[조회]]></xf:label>
        </xf:trigger>
        <xf:select appearance="full" cols="" ev:onviewchange="scwin.select1_onviewchange" id="select1" ref="" rows="" selectedindex="-1"
                style="width: 148px;height: 21px;">
                <xf:choices>
                        <xf:item>
                                <xf:label><![CDATA[hide]]></xf:label>
                                <xf:value><![CDATA[X]]></xf:value>
                        </xf:item>
                </xf:choices>
        </xf:select>
    </body>
</html> 