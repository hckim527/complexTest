scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function() {
    treeView1.findNodeByIndex(25, true);
}
scwin.trigger2_onclick = function() {
    treeView1.findNodeByValue(13, true);
}
scwin.customFormatter = function(label) {
    return label + "test";
}
scwin.getErrorLog = function() {
    var temp = WebSquare.logger.getErrorLog();
    return temp;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.getErrorLog() == ''", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
