         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    //var compArr = WebSquare.util.getChildren (grp1, { recursive : "true"});
    var compArr = WebSquare.util.getChildren(grp1, {
        recursive: "true",
        excludeInnerComp: "true"
    });
    console.log(compArr);
};
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.Dbclick = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireDbClick(el);
}
scwin.setVal = function() {
    localStorage.setItem('componentCnt', WebSquare.util.getChildren(grp1, {
        recursive: "true",
        excludeInnerComp: "true"
    }).length);
}
scwin.checkVal = function() {
    return localStorage.getItem('componentCnt') == WebSquare.util.getChildren(grp1, {
        recursive: "true",
        excludeInnerComp: "true"
    }).length;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setVal()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.Dbclick($p.id+'grid1_cell_0_0')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    localStorage.removeItem('componentCnt');
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
