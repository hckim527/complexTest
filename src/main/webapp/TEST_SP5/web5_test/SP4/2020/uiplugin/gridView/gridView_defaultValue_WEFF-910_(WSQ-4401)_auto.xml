    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate />
        <xf:model>
            <xf:instance>
                <data xmlns="" />
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataMap baseNode="map" id="dataMap1">
                    <w2:keyInfo>
                        <w2:key id="key1" name="name1" dataType="text"></w2:key>
                        <w2:key id="key2" name="name2" dataType="text"></w2:key>
                        <w2:key id="key3" name="name3" dataType="text"></w2:key>
                    </w2:keyInfo>
                </w2:dataMap>
                <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="number" defaultValue="0"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text" defaultValue="col2"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text" defaultValue="col3"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text" defaultValue="col4"></w2:column>
                        <w2:column id="depth" name="depth" dataType="text" defaultValue="col5"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text" defaultValue="defaultValue col1"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text" defaultValue="defaultValue col2"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text" defaultValue="defaultValue col3"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text" defaultValue="defaultValue col4"></w2:column>
                        <w2:column id="depth" name="depth" dataType="text" defaultValue="col5"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    //dataList1.insertRow();
    dataList2.insertRow();
    dataList2.insertRow();
    var row = dataList1.getRowJSON(0);
    var json = [];
    for (var i = 0; i < 50; i++) {
        var tmp = {};
        for (var item in row) {
            if (item == "rowStatus") continue;
            if (item == "col1") tmp[item] = 0;
            else tmp[item] = item + "_" + i;
            //tmp[item] =i%11==0?"\u001a":item+"_"+i;
            //if(item == "col2") tmp[item] = "N"
            //if(item == "depth") tmp[item] = i%5==0 ? 1 : i%5;
        }
        json.push(tmp);
    }
    dataList1.setJSON(json);
    dataList2.setJSON([{
        "col1": "col1",
        "col2": "col2",
        "col3": "col3",
        "col4": "col4"
    }]);
};
scwin.onpageunload = function() {};
scwin.gridView1_onviewchange = function(info) {
    console.log('gridView onviewchange', info)
    localStorage.setItem("log", 'gridView onviewchange');
};
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.Dbclick = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireDbClick(el);
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.Dbclick($p.id+'gridView1_cell_0_0')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getJq('#G_gridView1__col1').val('')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_cell_1_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log') == 'gridView onviewchange'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //캐시테스트
    localStorage.removeItem("log");
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
