<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="32">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[test]]></col1>
            				<col2><![CDATA[1]]></col2>
            				<col3><![CDATA[1]]></col3>
            			</w2:row>
            			<w2:row>
            				<col3><![CDATA[2]]></col3>
            				<col2><![CDATA[2]]></col2>
            				<col1><![CDATA[test1]]></col1>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[test2]]></col1>
            				<col2><![CDATA[3]]></col2>
            				<col3><![CDATA[3]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:linkedDataList bind="dataList1" id="linkedDataList1" rowStatusNodeName="">
            		<w2:condition type="filter"><![CDATA[]]></w2:condition>
            		<w2:condition type="sort"><![CDATA[]]></w2:condition>
            	</w2:linkedDataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.trigger2_onclick = function(e) {
    linkedDataList1.setCondition("filter", "col3 == 1");
};
scwin.trigger3_onclick = function(e) {
    WebSquare.logger.showLog()
};
scwin.getErrorLog = function() {
    var temp = WebSquare.logger.getErrorLog();
    return temp;
    // return temp.indexOf("error문구");
    // return temp.indexOf("error");
}
scwin.unitTest = function() {
    //Unit tets
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.getErrorLog() == ''", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:trigger type="button" style="width:199px;height:42px;" id="trigger3" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[error log 확인]]></xf:label>
    	</xf:trigger>
    	<w2:treeview id="treeview1" dataType="listed" tooltipGroupClass="false" style="width: 200px;height: 200px;" renderType="virtual"
    		alwaysDraw="true">
    		<w2:itemset nodeset="data:linkedDataList1">
    			<w2:label ref="col1"></w2:label>
    			<w2:value ref="col2"></w2:value>
    			<w2:depth ref="col3"></w2:depth>
    			<w2:folder ref=""></w2:folder>
    			<w2:checkbox ref=""></w2:checkbox>
    			<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
    			<w2:image ref=""></w2:image>
    			<w2:iconImage ref=""></w2:iconImage>
    			<w2:selectedImage ref=""></w2:selectedImage>
    			<w2:expandedImage ref=""></w2:expandedImage>
    			<w2:leafImage ref=""></w2:leafImage>
    		</w2:itemset>
    	</w2:treeview>
    	<xf:trigger type="button" style="width:200px;height:48px;" id="trigger2" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[linkedDataList1.setCondition]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 