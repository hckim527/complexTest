};
scwin.trigger2_onclick = function(e) {
    gridView1.setColumnOrder([3, 4, 5, 6, 7, 2, 1, 0]);
};
scwin.setVal = function() {
    localStorage.setItem('checkWidth', WebSquare.wUnit.getJq('#gridView1_column5').width());
}
scwin.checkVal = function() {
    return localStorage.getItem('checkWidth') == WebSquare.wUnit.getJq('#gridView1_cell_0_5').width();
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setVal()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    localStorage.removeItem('checkWidth');
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
