		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.ibx_openPopup_onclick = function(e) {
    if(WebSquare._xv !== "SP5"){requires("uiplugin.popup");}
    var opts = {
        "id": "Popup1",
        "type": "wframePopup",
        "width": "1024px",
        "height": "600px",
        "top": 250,
        "left": 250,
        "popupName": "Popup Test",
        "modal": false,
        "useIFrame": true,
        "title": "타이틀",
        "frameMode": "iframe",
        "disableCloseButton": false, // Close 버튼은 보이고 동작만 안하게 하는 설정
        "useControl": true, // controls 옵션이 동작하려면 true로 설정
        "controls": {
            "minimize": true,
            "maximize": true,
            "close": true
        }
    };
    $p.openPopup("popup_wframe_slider_width_WESD-282_(WSQ-4448)_sub.xml", opts);
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('ibx_openPopup').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#Popup1_wframe_slider3_centerLayer').width() > 200", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
