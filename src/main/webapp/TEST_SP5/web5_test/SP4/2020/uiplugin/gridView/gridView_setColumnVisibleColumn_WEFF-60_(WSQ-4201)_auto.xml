        "col4": "false",
        "col5": "true"
    }, {
        "col1": "c",
        "col2": "c",
        "col3": "false",
        "col4": "false",
        "col5": "true"
    }, {
        "col1": "d",
        "col2": "d",
        "col3": "true",
        "col4": "true",
        "col5": "false"
    }];
    dl_select.setJSON(jsonData1);
    //dataList1.insertRow();
    gridView1.setColumnVisibleColumn("col10", "col3");
    gridView1.setColumnVisibleColumn("col1", "col4");
    gridView1.setColumnVisibleColumn("col2", "col5");
    //dataList1.removeAll();
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
