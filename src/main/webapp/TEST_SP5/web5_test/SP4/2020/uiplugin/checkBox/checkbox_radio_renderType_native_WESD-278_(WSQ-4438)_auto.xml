<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[aa]]></col1>
            				<col2><![CDATA[aa]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[bb]]></col1>
            				<col2><![CDATA[bb]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <style>
        	.class_test {
        		background-color:red;
        	}
        </style>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#radio2').hasClass('class_test')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="">
    		<xf:select ref="" appearance="full" style="width:148px;height:62px;" id="checkbox13" selectedindex="-1" rows="" cols="" class="class_test">
    			<xf:choices>
    				<xf:itemset nodeset="data:dataList1">
    					<xf:label ref="col1"></xf:label>
    					<xf:value ref="col2"></xf:value>
    				</xf:itemset>
    			</xf:choices>
    		</xf:select>
    		<xf:select appearance="full" style="width:190px;height:58px;" id="checkbox14" selectedindex="-1" renderType="native" cols="2"
    			rows="1" ref="" class="class_test" value="aaa">
    			<xf:choices>
    				<xf:item>
    					<xf:label><![CDATA[1]]></xf:label>
    					<xf:value><![CDATA[1]]></xf:value>
    				</xf:item>
    				<xf:item>
    					<xf:label><![CDATA[2]]></xf:label>
    					<xf:value><![CDATA[2]]></xf:value>
    				</xf:item>
    			</xf:choices>
    		</xf:select>
    		<xf:select appearance="full" style="width: 148px;height: 21px;" id="checkbox15" renderType="checkboxgroup" selectedindex="-1"
    			cols="" rows="" ref="" class="class_test">
    			<xf:choices>
    				<xf:itemset nodeset="data:dataList1">
    					<xf:label ref="col1"></xf:label>
    					<xf:value ref="col2"></xf:value>
    				</xf:itemset>
    			</xf:choices>
    		</xf:select>
    	</xf:group>
    <xf:group id=""><xf:select1 ref="" appearance="full" style="width:171px;height:60px;" id="radio1" rows="" cols="" selectedIndex="-1" class="class_test">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="col1"></xf:label>
    				<xf:value ref="col2"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1>
    	<xf:select1 ref="" appearance="full" style="width:241px;height:118px;" id="radio2" rows="2" renderType="native" cols="1"
    		selectedIndex="0" class="class_test" value="bbb">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[1]]></xf:label>
    				<xf:value><![CDATA[2]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[1]]></xf:label>
    				<xf:value><![CDATA[2]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    	<xf:select1 ref="" appearance="full" style="width:171px;height:60px;" id="radio3" rows="" renderType="radiogroup" cols="" selectedIndex="-1" class="class_test">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="col1"></xf:label>
    				<xf:value ref="col2"></xf:value>
