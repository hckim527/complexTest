    		<w2:tabs disabled="false" id="tabs5" label="tabs5" style="height:30px;width:50px;padding:0 50px;"></w2:tabs>
    		<w2:tabs disabled="false" id="tabs6" label="tabs6" style="height:30px;width:50px;padding:0 50px;"></w2:tabs>
    		<w2:tabs disabled="false" id="tabs7" label="tabs7" style="height:30px;width:50px;padding:0 50px;"></w2:tabs>
    		<w2:tabs disabled="false" id="tabs8" label="tabs8" style="height:30px;width:50px;padding:0 50px;"></w2:tabs>
    		<w2:content alwaysDraw="false" id="content1" style="height:170px;"></w2:content>
