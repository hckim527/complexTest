        </xf:trigger>
        <xf:input adjustMaxLength="false" id="input1" style="position: relative;width: 144px;height: 21px;" readOnly="false"></xf:input>
        <w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1"
            style="position: relative;height: 288px;margin-left: 15px;margin-right: 15px;" autoFit="allColumn" fixedColumn="1" visibleRowNum="all"
            readOnly="false" dataDragSelect="true" useShiftKey="true" rowStatusVisible="true">
            <w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
            <w2:header id="header2" style="">
                <w2:row id="row3" style="">
                    <w2:column blockSelect="false" id="column9" removeBorderStyle="false" style="" inputType="text" width="70" value="name1"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column7" removeBorderStyle="false" style="" inputType="text" width="70" value="name2"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70" value="name3"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" width="70" inputType="text" value="name4"
                        displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody id="gBody2" style="">
                <w2:row id="row4" style="">
                    <!-- <w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="300" value=""
                        displayMode="label">
                    </w2:column> -->
                    <w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="drilldown" width="300" value=""
                        displayMode="label" showDepth="10" depthType="div" depthColumn="depth">
                    </w2:column>
                    <w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="checkbox" width="200" value=""
                        displayMode="label" trueValue="Y" falseValue="N" valueType="other">
                    </w2:column>
                    <w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" inputType="text" width="200" value=""
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="col4" removeBorderStyle="false" style="" inputType="text" width="200" value=""
                        displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
        <w2:gridView dataList="data:dataList2" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView2"
            style="position: relative;height: 288px;margin-left: 15px;margin-right: 15px;" autoFit="allColumn" fixedColumn="1" visibleRowNum="all"
            readOnly="false">
            <w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
            <w2:header id="header2" style="">
                <w2:row id="row3" style="">
                    <w2:column blockSelect="false" id="column9" removeBorderStyle="false" style="" inputType="text" width="70" value="name1"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column7" removeBorderStyle="false" style="" inputType="text" width="70" value="name2"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70" value="name3"
                        displayMode="label">
                    </w2:column>
