<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate />
        <xf:model>
            <xf:instance>
                <data xmlns="" />
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text" defaultValue="col1"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text" defaultValue="col2"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text" defaultValue="col3"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text" defaultValue="col4"></w2:column>
                        <w2:column id="depth" name="depth" dataType="text" defaultValue="col5"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text" defaultValue="col1"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text" defaultValue="col2"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text" defaultValue="col3"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text" defaultValue="col4"></w2:column>
                        <w2:column id="depth" name="depth" dataType="text" defaultValue="col5"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.insertRow();
    dataList2.insertRow();
    dataList2.insertRow();
    var row = dataList1.getRowJSON(0);
    var json = [];
    for (var i = 0; i < 30; i++) {
        var tmp = {};
        for (var item in row) {
            if (item == "rowStatus") continue;
            tmp[item] = item + "_" + i;
            tmp[item] = i % 11 == 0 ? "\u001a" : item + "_" + i;
            if (item == "col2") tmp[item] = "N"
            if (item == "depth") tmp[item] = i % 5 == 0 ? 1 : i % 5;
        }
        json.push(tmp);
    }
    dataList1.setJSON(json);
};
scwin.onpageunload = function() {};
scwin.setVal1 = function() {
    dataList1.getModifiedIndex();
    dataList1.modifyAllStatus("R");
    dataList1.resetOriginalDataArr();
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_1_1').getElementsByTagName('input')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_2_1').getElementsByTagName('input')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_3_1').getElementsByTagName('input')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_4_1').getElementsByTagName('input')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setVal1()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_1_1').getElementsByTagName('input')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_2_1').getElementsByTagName('input')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_3_1').getElementsByTagName('input')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_4_1').getElementsByTagName('input')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('dataList1').getModifiedIndex().length == 4", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //캐시테스트
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
        <style type="text/css"><![CDATA[ 
            .w2grid {
                touch-action: auto;
                -webkit-user-drag: none;
                user-select: none;
            }
        ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;margin-left:0px;"
            ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[파일 선택]]></xf:label>
        </xf:trigger>
        <xf:trigger type="button" id="trigger2" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
