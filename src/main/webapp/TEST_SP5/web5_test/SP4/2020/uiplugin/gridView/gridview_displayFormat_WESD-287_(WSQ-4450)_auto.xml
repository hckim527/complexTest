<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.setData(['#,##0', '10000', '100000', '######-#######', '9999991234567', '8712121324567', '#,###', '10000', '100000']);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    grid1.setCellDisplayFormat(0, 1, "#,##0");
    grid1.setCellDisplayFormat(0, 2, "#,##0");
    grid1.setCellDisplayFormat(1, 1, "######-#######");
    grid1.setCellDisplayFormat(1, 2, "######-#######");
    grid1.setCellDisplayFormat(2, 1, "#,###");
    grid1.setCellDisplayFormat(2, 2, "#,###");
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('grid1_col3_0__default').realValue == '1000,000'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('grid1_col3_1__default').realValue == '871212-1324567'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="grid1" style="width:869px;height:203px;" scrollByColumn="false" defaultCellHeight="20"
			scrollByColumnAdaptive="false" dataList="data:dataList1" setCellInputTypeCustom="true" scrollFocus="true" senseReader="true"
			embeddedInput="true" focusMove="false" keyMoveEditMode="true" autoResizeEmbeddedInput="true" titleAuto="true">
			<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header style="" id="header1">
				<w2:row style="" id="row1">
					<w2:column removeBorderStyle="false" width="216" inputType="text" style="height:20px;" id="column2"
						value="setCellDisplayFormat" blockSelect="false" displayMode="label">
					</w2:column>
					<w2:column removeBorderStyle="false" width="236" inputType="text" style="height:20px;" id="column1"
						value="inputType=custom(readonly=true)" blockSelect="false" displayMode="label">
					</w2:column>
					<w2:column removeBorderStyle="false" width="235" inputType="text" style="height:20px;" id="column3" value="inputType=custom(readonly=flase)"
						blockSelect="false" displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody style="" id="gBody1">
				<w2:row style="" id="row2">
					<w2:column removeBorderStyle="false" width="216" inputType="text" style="height:20px" id="col1" value=""
						blockSelect="false" displayMode="label" dataType="text">
					</w2:column>
					<w2:column removeBorderStyle="false" width="236" inputType="custom" style="height:20px" id="col2" value=""
						blockSelect="false" displayMode="label" customFormatter="" imageWidth="20" readOnly="true">
					</w2:column>
					<w2:column removeBorderStyle="false" width="235" inputType="custom" style="height:20px" id="col3" value=""
						blockSelect="false" displayMode="label" dataType="text" readOnly="false">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" style="width:160px;height:23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setCellDisplayFormat]]></xf:label>
		</xf:trigger>
	</body>
</html>
 