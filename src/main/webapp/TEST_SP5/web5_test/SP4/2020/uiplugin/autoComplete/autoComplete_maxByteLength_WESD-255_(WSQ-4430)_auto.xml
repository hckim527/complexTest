         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataMap1.setArray(["20201130", "202010", "2020", "2020113011", "202011301130"]);
    dataList1.setData(["가나다", "가나다", "가나라마다아", "가나라마다아", "사가나자다", "사가나자다", "사자마", "사자마", "자가", "자가", "abcde", "abcde", "ab1123f", "ab1123f", "자ac12가", "자ac12가", "fz사zf", "fz사zf"]);
};
scwin.onpageunload = function() {};
scwin.Dbclick = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireDbClick(el);
}
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate = function() {
    WebSquare.wUnit.getJq('#autoComplete1_input').simulate('key-sequence', {
        sequence: '자가'
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('autoComplete1_input').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#autoComplete3').hasClass('w2autoComplete_body_selected')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
]]></script>
