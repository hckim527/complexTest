<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>	
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>

                <w2:dataList id="dl_selectData" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="label" name="name1" dataType="text"></w2:column>
                        <w2:column id="value" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
        "label": "la_a1",
        "value": "a1"
    }, {
        "label": "la_a2",
        "value": "a2"
    }];
    dl_selectData.setJSON(jsonData);
    var jsonData2 = [{
        "col2": "a"
    }, {
        "col2": "b"
    }, {
        "col2": "a"
    }, {
        "col2": "a"
    }, {
        "col2": "c"
    }];
    dataList1.setJSON(jsonData2);
    gridView1.setRowVisible(1, false);
    gridView1.setRowVisible(3, false);
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    dataList1.insertRow();
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq(WebSquare.wUnit.getDomById($p.id+'gridView1_body_tbody').getElementsByTagName('tr')[1]).hasClass('w2grid_hidedRow')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:trigger type="button" id="trigger1" style="position: absolute ;left:0px;top:9px;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[insertRow]]></xf:label>
        </xf:trigger>
    	<w2:gridView dataList="data:dataList1" summaryAuto="false" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20" rowNumVisible="true"
    		checkOnCellClick="true" scrollByColumnAdaptive="false" id="gridView1"
    		style="position: absolute ;left:38px;top:128px;width:537px;height:133px;" ignoreCellClick="false" syncScroll="false" visibleRowNum="15" senseReader="true"
    		ignoreToggleOnDisabled="false" summaryOnlyAuto="false" useShiftKey="true">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" style="" inputType="checkbox" width="70" value="name1" displayMode="label"
    					excelLabel="선택">
    				</w2:column>
    				<w2:column blockSelect="false" id="column2" style="" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="name3" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column4" style="" inputType="text" width="70" value="name4" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column5" style="" width="70" inputType="text" value="name5" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="checkbox" width="70" value="" displayMode="label"
    					checkAlways="false"
    					checkboxLabel="" valueType="other" trueValue="Y" falseValue="N">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="radio" width="70" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" inputType="select" width="70" value="" displayMode="label"
                        viewType="icon" allOption="" chooseOption="" ref="" selectedIndex="0" readOnlyClass="grd_select_readOnly">
                        <w2:choices>
                            <w2:itemset nodeset="data:dl_selectData">
                                <w2:label ref="label"></w2:label>
                                <w2:value ref="value"></w2:value>
                            </w2:itemset>
                        </w2:choices>
                    </w2:column>
    				<w2:column blockSelect="false" id="col4" style="" inputType="text" width="70" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col5" style="" width="70" inputType="text" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 