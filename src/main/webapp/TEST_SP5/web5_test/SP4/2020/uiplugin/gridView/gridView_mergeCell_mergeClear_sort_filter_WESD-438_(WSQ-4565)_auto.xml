         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.btn_mergeCell_onclick = function(e) {
    //gridView1.mergeCell({"rowIndex" : 3, "colIndex" : 2, "colSpan" : 2, "rowSpan" : 2});
    // 실행결과 : (3,2) 좌표에 위치한 셀이 2*2 크기로 병합된다. 
    // 즉, (3,2), (3,3), (4,2), (4,3)셀이 병합되며, 병합된 셀은 모두 (3,2)의 데이터를 갖는다.
    var mergeInfo = {
        "rowIndex": 3,
        "colIndex": 2,
        "colSpan": 2,
        "rowSpan": 2
    };
    grd.mergeCell(mergeInfo);
};
scwin.btn_mergeClear_onclick = function(e) {
    grd.mergeClear();
};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_mergeCell').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_column13_filter').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'grd_customFilter_list').children[1].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'grd_customFilter_list').children[2].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+$p.id+'grd_cell_0_2').getAttribute('colspan') == 2", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

]]></script>
