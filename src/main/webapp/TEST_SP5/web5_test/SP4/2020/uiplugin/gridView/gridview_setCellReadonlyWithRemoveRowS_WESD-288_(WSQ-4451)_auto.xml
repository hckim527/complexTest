         <script type="text/javascript" lazy="false"><![CDATA[
    scwin.nowRow = 0;
    scwin.tmpData = "A";
    scwin.tmpCounter = 0;
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.btn_AddRow_onclick = function(e) {
		var beidx = dataList1.insertRow(scwin.nowRow);
        dataList1.setCellData(beidx, "col5",scwin.tmpData+scwin.tmpCounter);///임시로 데이터 넣음
        gridView1.setCellReadOnly(beidx, "col5", false);         // 현재 개발에서 사용되고있음
        gridView1.setCellBackgroundColor(beidx, "col5", "#FF0000");
        scwin.tmpCounter++;
	};
	
	scwin.btn_removeRows_onclick = function(e) {
		var chkArr = gridView1.getCheckedIndex('col1');
        dataList1.removeRows(chkArr);
	};
	
	scwin.gridView1_oncellclick = function(row,col,colId) {
		scwin.nowRow = row;
	};
	
	
	scwin.btn_removeRow_onclick = function(e) {
		var chkArr = gridView1.getCheckedIndex('col1');
        for(var t=chkArr.length-1;t>=0;t--){        
            dataList1.removeRow(chkArr[t]);
        }
	};
	
	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('gridView1_cell_3_4').style.backgroundColor == 'rgb(255, 0, 0)';
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_AddRow').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_AddRow').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_AddRow').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_AddRow').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_AddRow').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_0_0').children[0].click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_removeRows').click()");
		WebSquare.wUnit.addCommand("pause", "400");		
		
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
	
	]]></script>
