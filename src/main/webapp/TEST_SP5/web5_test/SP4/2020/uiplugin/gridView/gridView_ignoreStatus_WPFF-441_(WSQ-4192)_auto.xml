         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.setData(["", ""]);
    dataList2.setData(["", ""]);
    dataList3.setData(["", ""]);
};
scwin.onpageunload = function() {};
scwin.__hasClass = function() {
    return WebSquare.wUnit.getDomById('gridView3_headerRowStatus_bodyRow_0').classList.contains('w2grid_rowStatus_U');
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView3_cell_0_0').children[0].click()");
    WebSquare.wUnit.addCommand('pause', '500');
    WebSquare.wUnit.addCommand("assert", "scwin.__hasClass()", "true");
    WebSquare.wUnit.addCommand('pause', '500');
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
