    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<xf:input adjustMaxLength="false" id="input1" style="width: 144px;height: 21px;" ev:onchange="scwin.input1_onchange"></xf:input>
    			</xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="" class="w2tb_th">
    				selectbox
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<xf:select1 id="selectbox1" chooseOption="" style="width: 148px;height: 21px;" submenuSize="auto" allOption="" disabled="false" emptyItem="true" renderType=""
    					direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="" ev:onchange="scwin.selectbox1_onchange">
    					<xf:choices>
