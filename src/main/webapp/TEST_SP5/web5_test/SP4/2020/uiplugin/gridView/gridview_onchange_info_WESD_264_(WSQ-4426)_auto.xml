            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
            			<w2:key id="key2" name="name2" dataType="text"></w2:key>
            			<w2:key id="key3" name="name3" dataType="text"></w2:key>
            		</w2:keyInfo>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.radio1_onchange = function(info) {
    if (info) {
        console.log("radio onchange ", info);
    } else {
        console.log("radio onchange");
    }
};
scwin.checkbox1_onchange = function(info) {
    if (info) {
        console.log("checkbox onchange ", info);
    } else {
        console.log("checkbox onchange");
    }
};
scwin.textarea1_onchange = function(info) {
    if (info) {
        console.log("textarea onchange ", info);
    } else {
        console.log("textarea onchange");
    }
};
scwin.input1_onchange = function(info) {
    if (info) {
        console.log("input onchange ", info);
    } else {
        console.log("input onchange");
    }
};
scwin.selectbox1_onchange = function(info) {
    if (info) {
        localStorage.setItem("log1", info.newValue);
        console.log("selectbox onchange ", info);
    } else {
        console.log("selectbox onchange");
    }
};
scwin.autoComplete1_onchange = function(info) {
    if (info) {
        localStorage.setItem("log2", info.newValue);
        console.log("autocomplete onchange ", info);
    } else {
        console.log("autocomplete onchange");
    }
};
scwin.checkcombobox1_onchange = function(info) {
    if (info) {
        localStorage.setItem("log3", info.newValue);
        console.log("checkcombobox onchange ", info);
    } else {
        console.log("checkcombobox onchange");
    }
};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('selectbox1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('selectbox1_itemTable_1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log1') == '2'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('autoComplete1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('autoComplete1_itemTable_1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log2') == '2'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('checkcombobox1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('checkcombobox1_itemTable_1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('checkcombobox1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log3') == '2'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    localStorage.removeItem("log1");
    localStorage.removeItem("log2");
    localStorage.removeItem("log3");
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group tagname="table" style="position:absolute; top:34px; left:45px;width:90%; height:333px; ;" id="" class="w2tb">
