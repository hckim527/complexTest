    							<xf:label><![CDATA[new row]]></xf:label>
    							<xf:value><![CDATA[3]]></xf:value>
    						</xf:item>
    					</xf:choices>
    				</xf:select>
    			</xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="" class="w2tb_th">
    				textArea
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<xf:textarea id="textarea1" style="width: 90%;height: 100px;" ev:onchange="scwin.textarea1_onchange"></xf:textarea>
    			</xf:group>
    			<xf:group tagname="th" style="" class="w2tb_th">
    				input
