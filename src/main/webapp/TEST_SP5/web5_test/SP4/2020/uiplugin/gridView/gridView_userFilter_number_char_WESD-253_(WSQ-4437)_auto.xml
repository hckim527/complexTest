        <script type="text/javascript" lazy="false"><![CDATA[
scwin.Dbclick = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireDbClick(el);
}
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate = function() {
    WebSquare.wUnit.getJq('#wq_uuid_6_item_0_autocomplete_column29_input').simulate('key-sequence', {
        sequence: 'abc'
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_6_column29_filter').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'wq_uuid_6_customFilter_list').children[0].getElementsByTagName('span')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_6_item_0_autocomplete_column29_input').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_6_item_0_selectbox_column29_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "document.getElementsByClassName('w2table_sb_row')[3].getAttribute('data-wqhidden') === 'true' || document.getElementsByClassName('w2table_sb_row')[3].innerText != '>'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
