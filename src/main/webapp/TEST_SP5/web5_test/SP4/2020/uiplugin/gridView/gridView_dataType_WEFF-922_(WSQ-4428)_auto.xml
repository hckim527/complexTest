        <script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
    var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
    var r = d(id); if (r) return r;
    var s = dd(P + id); r = d(s); if (r) return r;
    var g = s.indexOf('G_');
    if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
    return d(s.replace(P, ''));
};
scwin.onpageload = function() {
    dataList1.insertRow();
    dataList2.insertRow();
    var row = dataList1.getRowJSON(0);
    var json = [];
    for (var i = 0; i < 2; i++) {
        var tmp = {};
        for (var item in row) {
            if (item == "rowStatus") continue;
            else if (item == "col1" ||
                item == "col2" ||
                item == "col3"
            ) tmp[item] = "0"
            else tmp[item] = item + "_" + i;
        }
        json.push(tmp);
    }
    dataList1.setJSON(json);
    row = dataList2.getRowJSON(0);
    json = [];
    for (var i = 0; i < 2; i++) {
        var tmp = {};
        for (var item in row) {
            if (item == "rowStatus") continue;
            else if (item == "col1" ||
                item == "col2" ||
                item == "col3"
            ) tmp[item] = 0
            else tmp[item] = item + "_" + i;
        }
        json.push(tmp);
    }
    // dataList2.setJSON([
    //     {"col1":"col1","col2":"col2","col3":"col3","col4":"col4"}
    // ]);
    dataList2.setJSON(json);
};
scwin.onpageunload = function() {};
scwin.gridView1_onviewchange = function(info) {
    debugger;
    console.log(info);
};
scwin.checkVal = function() {
    return scwin.__getDom($p.id + 'wq_uuid_3_itemTable_main').getElementsByTagName('tr')[1].innerText == "하하가가나가나다라하";
}
scwin.Dbclick = function(id) {
    var el = scwin.__getDom($p.id + id);
    scwin.fireDbClick(el);
}
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.setVal1 = function() {
    scwin.__getDom('G_'+$p.id+'gridView1__col2').value = '-';
}
scwin.setVal2 = function() {
    scwin.__getDom('G_'+$p.id+'gridView1__col3').value = '+';
}
scwin.setVal3 = function() {
    scwin.__getDom('G_'+$p.id+'gridView2__col2').value = '-';
}
scwin.setVal4 = function() {
    scwin.__getDom('G_'+$p.id+'gridView2__col3').value = '+';
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
}
]]></script>
