scwin.checkVal = function() {
    //[] 인데 []게 '' 의미? 그래서 에러나는 엔진과 반대로
    return WebSquare.DataCollection.comp.dataMap1.getArray()[0] != [];
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('wq_uuid_24_inputFile').offsetLeft < 20", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

]]></script>
