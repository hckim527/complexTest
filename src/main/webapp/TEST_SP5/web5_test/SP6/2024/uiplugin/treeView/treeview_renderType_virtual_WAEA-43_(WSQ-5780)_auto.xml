        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

	scwin.checkVal = function() {
		const check1 = WebSquare.wUnit.getDomById('wq_uuid_1_node_36').getBoundingClientRect().top > 181;
		const check2 = WebSquare.wUnit.getDomById('wq_uuid_1_node_36').getBoundingClientRect().top < 185;
		return check1 && check2;
	}	
	
	scwin.unitTest = function(){
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_1_node_32').querySelector('span').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_1_node_33').querySelectorAll('span')[1].click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_1_node_18').querySelector('span').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_1_node_19').querySelectorAll('span')[1].click()");
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_1_scrollY_div').scrollTop = 320");		
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		
		
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
]]></script>
