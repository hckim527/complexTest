<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		pageList1.setCount(20);
		pageList2.setCount(20);
		pageList3.setCount(20);
	};
	
	scwin.onpageunload = function() {
		
	};

	scwin.checkVal1 = function() {
		const ck_class1 = WebSquare.wUnit.getDomById('pageList1').classList.contains('w2pagination');
		const ck_class2 = WebSquare.wUnit.getDomById('pageList2').classList.contains('w2pagination');
		const ck_class3 = WebSquare.wUnit.getDomById('pageList3').classList.contains('w2pagination');
		return ck_class1 && ck_class2 && ck_class3;
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();		

	]]></script>
	<style type="text/css">
      <![CDATA[
		.w2pagination .w2page_navi.leftButtonCustom { 
			order:1;
			margin-right:5px;
			padding:0 5px 0 15px;
			border:0;
			background-color:transparent;
			background-position:left center;
			background-repeat:no-repeat;
			border:10px solid red;
			order:1; 
		}
		.w2pagination .w2page_navi.rightButtonCustom{
			order:3;
			margin-left:5px;
			padding:0 15px 0 5px;
			border:0;
			background-color:transparent;
			border:10px solid red;
			order:3;
			background-position:right center;
			background-repeat:no-repeat;
		}
		.w2pagination.w2pagination_adaptive .w2page_navi.rightButtonCustom {
			order:2;
		}
		.w2pagination.w2pagination_adaptive .w2page_navi.leftButtonCustom {
			order:1;
		}
      ]]>
    </style>

    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
		<p style="display:flex;justify-content:center;align-items:center;font-size:20px;color:red;">default</p>
    	<w2:pageList pageSize="10" displayButtonType="display" id="pageList1" displayFormat="#" accessibility="" renderType="pagination" adaptive="true" adaptiveThreshold="767" oneMoveButtonWidth=""  rightPageImageClass="" leftPageImageClass="" naviType="" pagingType=""
    		style="">
    	</w2:pageList>
		<p style="display:flex;justify-content:center;align-items:center;font-size:20px;color:red;">displaySearchbox</p>
		<w2:pageList pageSize="10" displayButtonType="display" id="pageList2" displayFormat="#" accessibility="" renderType="pagination" adaptive="true" adaptiveThreshold="1024" displaySearchbox="true" rightPageImageClass="" leftPageImageClass=""  displaySelectedIndex="true"
    		style="">
    	</w2:pageList>
		<p style="display:flex;justify-content:center;align-items:center;font-size:20px;color:red;">useDelim</p>
		<w2:pageList pageSize="10" displayButtonType="display" id="pageList3" displayFormat="#" accessibility="" renderType="pagination" adaptive="true" adaptiveThreshold="1024" displaySearchbox="" useDelim="true" delimiter="|" deliWidth="10" deliImageStyle="color:red;"
    		style="">
    	</w2:pageList>

    </body>
</html>
