	scwin.trigger2_onclick = function(e) {
		var option1 = [
			{ row: 5, col: 3 },
			{ startRow: 0, startCol: 1, endRow: 4, endCol: 2 },
			{ row: 5, col: 0 },
			{ startRow: 2, startCol: 4, endRow: 4, endCol: 4 },
			{ row: 0, col: 0 },
			{ row: 2, col: 3 },
		];
		var option2 = [
			{ startRow: 0, startCol: 1, endRow: 2, endCol: 2 },
			{ startRow: 4, startCol: 0, endRow: 6, endCol: 3 }
		];
		var option3 = [
			{ startRow: 0, startCol: 1, endRow: 0, endCol: 4 }
		];
		var option4 = [
			{ row: 0, col: 1 },
			{ row: 0, col: 2 },
			{ row: 1, col: 0 }
		];
		var option5 = [
			{ row: 0, col: 0 },
			{ row: 3, col: 0 },
			{ row: 4, col: 3 }
		];
		grd1.setMultiFocus(option1); //기본
		grd2.setMultiFocus(option2); // colSpan 2이상
		grd3.setMultiFocus(option3); // rowSpan 2이상
		grd4.setMultiFocus(option4); // colSpan 2이상, rowSpan 2이상
		grd5.setMultiFocus(option5); //기본
	};
	//새로 추가 된 removeMultiFocus 동작
	scwin.trigger3_onclick = function(e) {
		var option1 = [
			{ startRow: 0, startCol: 0, endRow: 0, endCol: 1 },
			{ row: 5, col: 0 },
			{ startRow: 2, startCol: 1, endRow: 3, endCol: 2 }
		];
		var option2 = [
			{ startRow: 1, startCol: 1, endRow: 2, endCol: 1 },
			{ startRow: 4, startCol: 1, endRow: 5, endCol: 2 }
		];
		var option3 = [
			{ startRow: 0, startCol: 2, endRow: 0, endCol: 3 }
		];
		var option4 = [
			{ row: 0, col: 2 },
			{ row: 1, col: 0 }
		];
		var option5 = [
			{ row: 0, col: 0 },
			{ row: 4, col: 3 }
		];
		grd1.removeMultiFocus(option1);
		grd2.removeMultiFocus(option2);
		grd3.removeMultiFocus(option3);
		grd4.removeMultiFocus(option4);
		grd5.removeMultiFocus(option5);
	};

	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('grd1_cell_0_0').style.backgroundColor != '';
	}
	scwin.checkVal2 = function() {
		return WebSquare.wUnit.getDomById('grd1_cell_0_1').style.backgroundColor != '';
	}
	scwin.checkVal3 = function() {
		return WebSquare.wUnit.getDomById('grd1_cell_0_2').style.backgroundColor != '';
	}	
	scwin.checkVal4 = function() {
		return WebSquare.wUnit.getDomById('grd1_cell_0_0').style.backgroundColor == '';
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal3()", "true");		
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal4()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();	
	
