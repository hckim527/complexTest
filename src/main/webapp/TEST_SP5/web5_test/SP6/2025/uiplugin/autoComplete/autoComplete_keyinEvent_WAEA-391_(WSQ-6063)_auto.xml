<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
		<script type="text/javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
		<script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
		<script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
		<script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
		<script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
		<script type="text/javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>			
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
            		<w2:columnInfo></w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
            		<w2:columnInfo>
            			<w2:column id="name" name="name1" dataType="text"></w2:column>
            			<w2:column id="code" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<name><![CDATA[가]]></name>
            				<code><![CDATA[1]]></code>
            			</w2:row>
            			<w2:row>
            				<name><![CDATA[가나]]></name>
            				<code><![CDATA[2]]></code>
            			</w2:row>
            			<w2:row>
            				<name><![CDATA[가나다]]></name>
            				<code><![CDATA[3]]></code>
            			</w2:row>
            			<w2:row>
            				<name><![CDATA[abc]]></name>
            				<code><![CDATA[4]]></code>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
};

	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate1 = function() {
		window.checkLog = false;
		scwin.simulateWrapper('#autoComp2_input', 'key-sequence', {
			sequence: '나다'
		});
	}
	scwin.setSimulate2 = function() {
		scwin.simulateWrapper('#autoComp2_input', 'key-combo', {
			combo: 'ENTER'
		});
	}	
	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('autoComp2_label').innerText == '가나다';
	}

	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('autoComp2_label').click()");
		WebSquare.wUnit.addCommand("pause", "500");			
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate2()");
		WebSquare.wUnit.addCommand("pause", "500");
	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()","true");
		WebSquare.wUnit.addCommand("pause", "500");	
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:autoComplete editType="select" id="autoComp1" style="width: 148px;height: 21px;" submenuSize="auto" search="contain" allOption=""
    		chooseOption="" ref="" preserveInputCursorOnHomeEnd="true">
    		<w2:choices>
    			<w2:itemset nodeset="data:dataList2">
    				<w2:label ref="name"></w2:label>
    				<w2:value ref="code"></w2:value>
    			</w2:itemset>
    		</w2:choices>
    	</w2:autoComplete>
        <w2:autoComplete editType="select" id="autoComp2" style="width: 148px;height: 21px;" submenuSize="auto" search="contain" allOption=""
            chooseOption="" ref="" preserveInputCursorOnHomeEnd="true" selectSingleOnEnter="true">
            <w2:choices>
                <w2:itemset nodeset="data:dataList2">
                    <w2:label ref="name"></w2:label>
                    <w2:value ref="code"></w2:value>
                </w2:itemset>
            </w2:choices>
        </w2:autoComplete>        
    	<!--<xf:input id="input1" style="width: 144px;height: 21px;"></xf:input>-->
    </body>
</html>
