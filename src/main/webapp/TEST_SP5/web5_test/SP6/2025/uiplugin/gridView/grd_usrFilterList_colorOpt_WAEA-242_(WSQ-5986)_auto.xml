        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

	scwin.checkClassInCSS = function(url, className) {	
		let reVal = -1;
		const xhr = new XMLHttpRequest();
		xhr.open('GET', url, false);
		debugger;
		xhr.onload = function () {
			if (xhr.status === 200) {
				const cssText = xhr.responseText;
				window.reVal = cssText.indexOf(className);

				//if (exists) {
				//	reVal = true;
				//} else {
				//	reVal = false;
				//}
			} else {
				console.error(`CSS 파일을 로드하는 데 실패했습니다: ${xhr.status}`);
				reVal = false;
			}
		};
		xhr.onerror = function () {
			console.error('네트워크 오류가 발생했습니다.');
		};
		xhr.send();
	}

	scwin.checkVal = function() {
		//   /6.0_0.1195B.20250103.161243_1.5_without_testcase_ko/websquare/
		const engine = WebSquare.baseThemeURI;
		//const baseUrl = 'http://localhost:8080'; //로컬
		const baseUrl = 'http://192.168.100.70:9999'; //70
		const fullUrl = baseUrl + engine + '_websquare_/skin/stylesheet_ext.css';
debugger;
		scwin.checkClassInCSS(fullUrl, 'w2list_listRow_selected');

		return window.reVal != -1;
	}		
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()","true");
		WebSquare.wUnit.addCommand("pause", "500");	
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()

]]></script>
