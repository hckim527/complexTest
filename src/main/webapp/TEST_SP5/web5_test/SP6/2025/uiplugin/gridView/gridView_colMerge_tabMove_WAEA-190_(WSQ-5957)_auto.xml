<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <script type="javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>		
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[1]]></col2>
            				<col3><![CDATA[2222]]></col3>
            				<col4><![CDATA[3333]]></col4>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[1]]></col2>
            				<col3><![CDATA[2222]]></col3>
            				<col4><![CDATA[3333]]></col4>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.trigger1_onclick = function(e) {
    dataList1.insertRow();
};

scwin.trigger2_onclick = function(e) {
    dataList2.insertRow();
};


	scwin.setSimulate = function() {
		scwin.simulateWrapper('#gridView1_cell_0_0', 'key-combo', {
			combo: 'TAB'
		});
	}
	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById("gridView1_cell_0_1").classList.contains("focusedTd");
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_0_0').click()");

		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
		WebSquare.wUnit.addCommand('pause', '500');	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()	
	
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[행추가]]></xf:label>
    	</xf:trigger>
    	<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width:633px;height:150px;"
    		dataList="data:dataList1">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="107" inputType="text" style="" id="column15" value="name1" displayMode="label"></w2:column>
    				<w2:column width="100" inputType="text" style="" id="column14" value="name2" displayMode="label"></w2:column>
    				<w2:column width="108" inputType="text" style="" id="column13" value="name3" displayMode="label"></w2:column>
    				<w2:column width="106" inputType="text" style="" id="column12" value="name4" displayMode="label"></w2:column>
    				<w2:column width="120" inputType="text" style="" id="column11" value="name5" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="107" inputType="select" style="" id="col1" value="" displayMode="label" allOption="" chooseOption=""
    					ref="" colMerge="true">
    					<w2:choices>
    						<w2:item>
    							<w2:label><![CDATA[업무1]]></w2:label>
    							<w2:value><![CDATA[1]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[업무2]]></w2:label>
    							<w2:value><![CDATA[2]]></w2:value>
    						</w2:item>
    					</w2:choices>
    				</w2:column>
    				<w2:column width="100" inputType="select" style="" id="col2" value="" displayMode="label" allOption="" chooseOption=""
    					ref="" colMerge="true">
    					<w2:choices>
    						<w2:item>
    							<w2:label><![CDATA[유형1]]></w2:label>
    							<w2:value><![CDATA[1]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[유형2]]></w2:label>
    							<w2:value><![CDATA[2]]></w2:value>
    						</w2:item>
    					</w2:choices>
    				</w2:column>
    				<w2:column width="108" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="106" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				<w2:column width="120" inputType="text" style="" id="col5" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
		<xf:trigger type="button" id="trigger2" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[행추가]]></xf:label>
    	</xf:trigger>
    	<w2:gridView checkAllType="false" dataList="data:dataList2" defaultCellHeight="20" id="gridView2"
    		style="width:633px;height:150px;">
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header2" style="">
    			<w2:row id="row3" style="">
    				<w2:column displayMode="label" id="column15" inputType="text" style="" value="name1" width="107"></w2:column>
    				<w2:column displayMode="label" id="column14" inputType="text" style="" value="name2" width="100"></w2:column>
    				<w2:column displayMode="label" id="column13" inputType="text" style="" value="name3" width="108"></w2:column>
    				<w2:column displayMode="label" id="column12" inputType="text" style="" value="name4" width="106"></w2:column>
    				<w2:column displayMode="label" id="column11" inputType="text" style="" value="name5" width="120"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody2" style="">
    			<w2:row id="row4" style="">
    				<w2:column allOption="" chooseOption="" colMerge="true" displayMode="label" id="col1" inputType="text" ref="" style=""
    					value="" width="107">    					
    				</w2:column>
    				<w2:column allOption="" chooseOption="" colMerge="true" displayMode="label" id="col2" inputType="text" ref="" style=""
    					value="" width="100">    					
    				</w2:column>
    				<w2:column displayMode="label" id="col3" inputType="text" style="" value="" width="108"></w2:column>
    				<w2:column displayMode="label" id="col4" inputType="text" style="" value="" width="106"></w2:column>
    				<w2:column displayMode="label" id="col5" inputType="text" style="" value="" width="120"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
