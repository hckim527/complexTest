<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
            		<w2:columnInfo>
            			<w2:column id="codeName" name="" dataType="text"></w2:column>
            			<w2:column id="codeNo" name="" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<codeName><![CDATA[name1]]></codeName>
            				<codeNo><![CDATA[1]]></codeNo>
            			</w2:row>
            			<w2:row>
            				<codeNo><![CDATA[2]]></codeNo>
            				<codeName><![CDATA[name2]]></codeName>
            			</w2:row>
            			<w2:row>
            				<codeName><![CDATA[name3]]></codeName>
            				<codeNo><![CDATA[3]]></codeNo>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {

};

scwin.trigger1_onclick = function (e) {
    gridView1.setFocusedCell(1, "col1", true, {skipOpen:true});
};


	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('G_'+$p.id+'gridView1___selectbox_col1_itemTable').style.display == 'none';
	}		
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand("pause", "500");				
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();	

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width: 500px;height: 150px;"
    		dataList="data:dataList1">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column4" value="name1" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column ref="" chooseOption="" width="70" inputType="select" style="" id="col1" allOption="" value=""
    					displayMode="label" editMode="true">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="codeName"></w2:label>
    							<w2:value ref="codeNo"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="width:460px;height:23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[gridView1.setFocusedCell(row, "col1", true);]]></xf:label>
    	</xf:trigger>
    </body>
</html>
