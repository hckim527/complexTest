    	<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

	scwin.checkVal = function() {
		const combox_width = WebSquare.wUnit.getJq('#wq_uuid_27').width();
		const itemTable_width = WebSquare.wUnit.getJq('#wq_uuid_28_itemTable').width() +10;
		debugger;
		return combox_width > itemTable_width;
	}
	scwin.checkVal2 = function() {
		const combox_width = WebSquare.wUnit.getJq('#wq_uuid_41').width();
		const itemTable_width = WebSquare.wUnit.getJq('#wq_uuid_42_itemTable').width() +10;
		debugger;
		return combox_width > itemTable_width;
	}	
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "1000");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_28_button').click()");
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_42_button').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()		
	
]]></script>
    	<style type="text/css"><![CDATA[
    	
:root{
  
    --ws-gray-0:#FFFFFF;
    --ws-gray-50:#F9FAFB;
    --ws-gray-100:#F4F6F8;
    --ws-gray-200:#EAEEF1;
    --ws-gray-300:#DCE0E4;
    --ws-gray-400:#C4CDD5;
    --ws-gray-500:#A7B1BB;
    --ws-gray-600:#637381;
    --ws-gray-700:#454F5B;
    --ws-gray-800:#212B36;
    --ws-gray-900:#161C24;

    --ws-primary-50:#F4F9FE;
    --ws-primary-100:#EBF4FD;
    --ws-primary-200:#DCEFFF;
    --ws-primary-300:#B5DAFF;
    --ws-primary-400:#56A6F8;
    --ws-primary-500:#006FDF;
    --ws-primary-600:#005AB5;
    --ws-primary-700:#014A81;
    --ws-primary-800:#07416D;
    --ws-primary-900:#1C3548;

	--ws-form-height:30px;
	--ws-form-bg:var(--ws-gray-0);
	--ws-form-bd:var(--ws-gray-200);
	--ws-form-color:var(--ws-gray-800);
	--ws-form-font-size:14px;
	--ws-form-radius:4px;
	--ws-form-hover-bg:var(--ws-gray-0);
	--ws-form-hover-bd:var(--ws-gray-800);
	--ws-form-focus-bg:var(--ws-gray-0);
	--ws-form-focus-bd:var(--ws-gray-800);
	--ws-form-disabled-bg:var(--ws-gray-200);
	--ws-form-disabled-bd:var(--ws-gray-300);
	--ws-form-disabled-color:var(--ws-gray-500);

	--ws-listitem-over-bg:var(--ws-gray-100);


}
    	
/* selectbox */
.w2selectbox {height:var(--ws-form-height);border:1px solid var(--ws-form-bd);border-radius:var(--ws-form-radius);background:var(--ws-form-bg);color:var(--ws-form-color);box-sizing:border-box;appearance:none}
.w2selectbox_label {padding:0 0 0 8px;font-size:var(--ws-form-font-size);text-align:left;box-sizing:border-box}
.w2selectbox .w2selectbox_col_button {position:relative;width:24px;}

.w2table_sb {padding:12px;border:1px solid #aaa;border-radius:var(--ws-form-radius);background:var(--ws-form-bg);box-shadow:0 5px 5px rgb(33,43,54,0.1)}
.w2table_sb_main {position:relative;top:0;border:1px solid #ccc;border-radius:var(--ws-form-radius);background: #eee}
.w2table_sb_col {height:28px;padding:0 4px;border-top:0;border-radius:var(--ws-form-radius);font-size:var(--ws-form-font-size);line-height:28px;text-align:left}
.w2table_sb_col_over {background-color:var(--ws-listitem-over-bg)}


/* autoComplete */
.w2autoComplete {width:100%;height:var(--ws-form-height);padding-left:1px;border:1px solid var(--ws-form-bd);border-radius:var(--ws-form-radius);background:var(--ws-form-bg);color:var(--ws-form-color);box-sizing:border-box}
span.w2autoComplete_label {padding:0 0 0 8px;text-align:left;font-size:var(--ws-form-font-size)}
.w2autoComplete_input {outline:none;padding:0 8px !important;font-size:var(--ws-form-font-size);font-family:var(--ws-font-family);box-sizing:border-box}
.w2autoComplete .w2autoComplete_col_button {width:24px;}

.w2input_table_sb {padding:12px;border:1px solid #aaa;border-radius:var(--ws-form-radius);background:var(--ws-form-bg);box-shadow:0 5px 5px rgb(33,43,54,0.1)}
.w2input_table_sb_main {position:relative;top:0;border:1px solid #ccc;border-radius:var(--ws-form-radius);background: #eee}
.w2input_table_sb_col {height:28px;padding:0 4px;border-top:0;border-radius:var(--ws-form-radius);font-size:var(--ws-form-font-size);line-height:28px;text-align:left}
.w2input_table_sb_col_over {background-color:var(--ws-listitem-over-bg)}

/* checkCombobox */
.w2checkcombobox {width:100%;height:var(--ws-form-height);border:1px solid var(--ws-form-bd);border-radius:var(--ws-form-radius);background:var(--ws-form-bg);color:var(--ws-form-color);box-sizing:border-box}
.w2checkcombobox_label {padding:0 0 0 8px;font-size:var(--ws-form-font-size);text-align:left;box-sizing:border-box}
.w2checkcombobox_focus .w2checkcombobox_col_label,
.w2checkcombobox .w2checkcombobox_col_button {position:relative;width:24px;}

.w2table_ccb {padding:12px;border:1px solid #aaa;border-radius:var(--ws-form-radius);background:var(--ws-form-bg);box-shadow:0 5px 5px rgb(33,43,54,0.1)}
.w2table_ccb_main {position:relative;top:0;border:1px solid #ccc;border-radius:var(--ws-form-radius);background: #eee}
.w2table_ccb_col {height:28px;padding:0 4px;border-top:0;border-radius:var(--ws-form-radius);font-size:var(--ws-form-font-size);text-align:left}
.w2table_ccb_col_over {background-color:var(--ws-listitem-over-bg)}
.w2table_ccb_col_checkbox {display:inline-block;float:none;width:20px;height:20px;margin:0 3px;background:url(/cm/images/base/ico_check.svg) no-repeat;vertical-align:middle;appearance:none}
.w2table_ccb_col_checkbox:checked {background:url(/cm/images/base/ico_check_on.svg) no-repeat}
.w2table_ccb_col_checkbox:disabled {background:url(/cm/images/base/ico_check_dis.svg) no-repeat}
.w2table_ccb_col_checkbox:checked:disabled {background:url(/cm/images/base/ico_check_on_dis.svg) no-repeat}
.w2table_ccb_col_label {display:inline-block;float:none;vertical-align:middle}

    	 ]]></style>
