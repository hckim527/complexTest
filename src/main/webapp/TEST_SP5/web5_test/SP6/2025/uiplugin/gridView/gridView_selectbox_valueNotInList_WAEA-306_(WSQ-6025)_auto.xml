        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	select1.setValue("test1212");
    // gridView1.setCellInputType(0, "col4", "test1212");
    gridView1.setCellData(0, "col4", "test13131313");
};

	scwin.checkLastColumnValues = function() {	
	
		const rows = document.querySelectorAll("#mf_gridView1_body_tbody tr");
		//const rows = document.querySelector("tbody");
		let reVal = true;

		rows.forEach(row => {
			const cells = row.querySelectorAll("td");
			const lastCell = cells[cells.length - 1];
			const cellValue = lastCell ? lastCell.textContent.trim() : '';
			if (cellValue !== '44' && row.rowIndex < 6) {
				reVal = false;
			}
		});
		return reVal;
	}

	scwin.checkVal = function() {
		return scwin.checkLastColumnValues();
	}
        
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");

		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()","true");
		WebSquare.wUnit.addCommand("pause", "500");

		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
        }
	scwin.unitTest()	

]]></script>
