		let compareStr = '[{"col1":"B_0","col2":"0"},{"col1":"B_1","col2":"1"},{"col1":"B_2","col2":"2"},{"col1":"B_3","col2":"3"},{"col1":"B_4","col2":"4"},{"col1":"B_5","col2":"5"},{"col1":"B_6","col2":"6"},{"col1":"B_7","col2":"7"},{"col1":"B_8","col2":"8"},{"col1":"B_9","col2":"9"},{"col1":"B_10","col2":"10"},{"col1":"B_11","col2":"11"},{"col1":"B_12","col2":"12"},{"col1":"B_13","col2":"13"},{"col1":"B_14","col2":"14"},{"col1":"B_15","col2":"15"},{"col1":"B_16","col2":"16"},{"col1":"B_17","col2":"17"},{"col1":"B_18","col2":"18"},{"col1":"B_19","col2":"19"},{"col1":"B_20","col2":"20"},{"col1":"B_21","col2":"21"},{"col1":"B_22","col2":"22"},{"col1":"B_23","col2":"23"},{"col1":"B_24","col2":"24"},{"col1":"B_25","col2":"25"},{"col1":"B_26","col2":"26"},{"col1":"B_27","col2":"27"},{"col1":"B_28","col2":"28"},{"col1":"B_29","col2":"29"},{"col1":"B_30","col2":"30"},{"col1":"B_31","col2":"31"},{"col1":"B_32","col2":"32"},{"col1":"B_33","col2":"33"},{"col1":"B_34","col2":"34"},{"col1":"B_35","col2":"35"},{"col1":"B_36","col2":"36"},{"col1":"B_37","col2":"37"},{"col1":"B_38","col2":"38"},{"col1":"B_39","col2":"39"}]'
		return WebSquare.wUnit.getDomById('mf_gridView1_cell_2_0').innerText == compareStr;
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()		
    
