<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <script type="javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>		
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.trigger1_onclick = function (e) {
    multisel1.setSelectedIndex("0")
};

	scwin.setSimulate1 = function() {
		scwin.simulateWrapper('#multisel1_li_item_0', 'key-combo', {
			combo: 'down-arrow'
		});
	}
	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('multisel1_li_item_1').classList.contains('w2multiselect_pointer_over');;
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('multisel1_li_item_0').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()","true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()	

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:textbox id="" label="multiselect 예시" style="width: 150px;height: 23px;"></w2:textbox>
    	<xf:select id="multisel1" appearance="minimal" accessibility="true" style="width:170px;height:30px;" ref="">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[1]]></xf:label>
    				<xf:value><![CDATA[1]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[2]]></xf:label>
    				<xf:value><![CDATA[2]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[3]]></xf:label>
    				<xf:value><![CDATA[3]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select>
    	<w2:textbox id="" label="checkcombobox 예시" style="width: 150px;height: 23px;"></w2:textbox>
    	<xf:checkcombobox id="" chooseOption="" displayMode="label" style="width:148px;height:-99px;" submenuSize="auto" allOption=""
    		disabled="false" direction="auto" ref="">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[1]]></xf:label>
    				<xf:value><![CDATA[1]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[2]]></xf:label>
    				<xf:value><![CDATA[2]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[3]]></xf:label>
    				<xf:value><![CDATA[3]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:checkcombobox>
    	<xf:trigger type="button" id="trigger1" style="width:202px;height:23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[setSelectedIndex("0")]]></xf:label>
    	</xf:trigger>
    </body>
</html>
