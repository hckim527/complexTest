    scwin.onpageload = function() {
        var row = 40;
        var col = 20;

        var data2 = [];
        for (var i = 0; i < row; i++) {
            data2.push(i + "");
            data2.push(i + "");
        }
        dataList2.setData(data2);
        dataList3.setData(data2);
        dataList4.setData(data2);
        dataList5.setData(data2);

        var data = [];
        for (var i = 0; i < row; i++) {
            for (var j = 0; j < col; j++) {
                var rowData = "null";
                if (j === 0) {
                    rowData = "R_" + (i + 1);
                } else if (i === 0) {
                    rowData = null;
                } else if (i === 1) {
                    rowData = "";
                } else if (j === 2) {
                    rowData = (i % 4 === 0) ? "1" : "";
                } else if (j === 5) {
                    rowData = (i === 7) ? "1" : "";
                } else if (j === 10) {
                    rowData = Math.ceil(((i%8)+3)/3);
                } else if (j === 4) {
                    rowData = "btn_search.png";
                } else {
                    rowData = i + "";
                }
                data.push(rowData); 
            }
        }
        data[0] = "";
        data[col] = null;
        dataList1.setData(data);
        dataMap1.set("key1", null);
        dataMap1.set("key2", "");
        dataMap1.set("key3", "1");
        dataMap2.set("key1", "5");
        dataMap2.set("key2", "10");
        dataMap2.set("key3", "6");
        dataMap3.set("key1", null);
        dataMap3.set("key2", null);
        dataMap3.set("key3", null);

        trigger1.setLabel("dataList2 remove");
        trigger2.setLabel("dataList3 remove");
        trigger3.setLabel("dataMap2 remove");
    };
    
    scwin.onpageunload = function() {
        
    };

