	scwin.checkVal1 = function() {
		const checkVal1 = WebSquare.wUnit.getDomById('selectbox1_label').innerText == 6;
		const checkVal2 = WebSquare.wUnit.getDomById('wframe1_selectbox1_label').innerText == 6;
		const checkVal3 = WebSquare.wUnit.getDomById('wframe1_wframe1_selectbox1_label').innerText == 6;
