<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="depth" name="depth" dataType="text"></w2:column>
                        <w2:column id="label" name="label" dataType="text"></w2:column>
                        <w2:column id="value" name="value" dataType="text"></w2:column>
                        <w2:column id="path" name="path" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="depth" name="depth" dataType="text"></w2:column>
                        <w2:column id="label" name="label" dataType="text"></w2:column>
                        <w2:column id="value" name="value" dataType="text"></w2:column>
                        <w2:column id="path" name="path" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    
};

scwin.btn_setJSON_onclick = function(e) {
    var data = [
        { "depth" : "1", "label":"메뉴 1번", "value":"menu1" },
        { "depth" : "2", "label":"하위메뉴 1번", "value":"menu1-2" },
        { "depth" : "2", "label":"하위메뉴 2번", "value":"menu1-3" },
        { "depth" : "3", "label":"최하위 메뉴 1번", "value":"menu1-5" },
        { "depth" : "3", "label":"최하위 메뉴 2번", "value":"menu1-6" },
    ];
    dataList1.setJSON(data);
    var data = [
        { "depth" : "0", "label":"메뉴 1번", "value":"menu1" },
        { "depth" : "1", "label":"하위메뉴 1번", "value":"menu1-2" },
        { "depth" : "1", "label":"하위메뉴 2번", "value":"menu1-3" },
        { "depth" : "2", "label":"최하위 메뉴 1번", "value":"menu1-5" },
        { "depth" : "2", "label":"최하위 메뉴 2번", "value":"menu1-6" },
    ];
    dataList2.setJSON(data);
};

	scwin.checkVal1 = function() {
		const depth1 = WebSquare.wUnit.getDomById('gridView2_cell_0_1').querySelectorAll('span')[0].getBoundingClientRect().left
		const depth2 = WebSquare.wUnit.getDomById('gridView2_cell_1_1').querySelectorAll('span')[0].getBoundingClientRect().left
		return depth1 < depth2;
	}
	scwin.checkVal2 = function() {
		const depth2 = WebSquare.wUnit.getDomById('gridView2_cell_1_1').querySelectorAll('span')[0].getBoundingClientRect().left
		const depth3 = WebSquare.wUnit.getDomById('gridView2_cell_2_1').querySelectorAll('span')[0].getBoundingClientRect().left
		return depth2 == depth3;
	}
	scwin.checkVal3 = function() {
		const depth3 = WebSquare.wUnit.getDomById('gridView2_cell_2_1').querySelectorAll('span')[0].getBoundingClientRect().left
		const depth4 = WebSquare.wUnit.getDomById('gridView2_cell_3_1').querySelectorAll('span')[0].getBoundingClientRect().left
		return depth3 < depth4;
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_setJSON').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()","true");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()","true");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal3()","true");
		WebSquare.wUnit.addCommand("pause", "500");			
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()		

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:trigger type="button" id="btn_setJSON" style="width: 80px;height: 23px;" ev:onclick="scwin.btn_setJSON_onclick">
            <xf:label><![CDATA[setJSON]]></xf:label>
        </xf:trigger>
        <xf:group>
            <w2:textbox id="" label="depthStartIndex = 1"
                style="width:1010px;height:23px;" tagname="h3">
            </w2:textbox>
            <w2:gridView id="gridView1" style="width: 500px;height: 150px;"
                dataList="data:dataList1">
                <w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
                <w2:header style="" id="header1">
                    <w2:row style="" id="row1">
                        <w2:column width="70" inputType="text" style="" id="column4" value="" displayMode="label"></w2:column>
                        <w2:column width="70" inputType="text" style="" id="column3" value="drilldown" displayMode="label"></w2:column>
                        <w2:column width="108" inputType="text" style="" id="column2" value="label" displayMode="label"></w2:column>
                        <w2:column width="125" inputType="text" style="" id="column1" value="value" displayMode="label"></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody style="" id="gBody1">
                    <w2:row style="" id="row2">
                        <w2:column width="70" inputType="text" style="" id="column8" value="" displayMode="label"></w2:column>
                        <w2:column width="70" inputType="drilldown" style="" id="depth" value="" displayMode="label" depthColumn="depth"
                            depthType="div" showDepth="" depthStartIndex="1">
                        </w2:column>
                        <w2:column width="108" inputType="text" style="" id="label" value="" displayMode="label"></w2:column>
                        <w2:column width="125" inputType="text" style="" id="value" value="" displayMode="label"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
        <xf:group>
            <w2:textbox id="" label="depthStartIndex = 0"
                style="width:1010px;height:23px;" tagname="h3">
            </w2:textbox>
            <w2:gridView id="gridView2" style="width: 500px;height: 150px;" dataList="data:dataList2">
                <w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
                <w2:header style="" id="header1">
                    <w2:row style="" id="row1">
                        <w2:column width="70" inputType="text" style="" id="column4" value="" displayMode="label"></w2:column>
                        <w2:column width="70" inputType="text" style="" id="column3" value="drilldown" displayMode="label"></w2:column>
                        <w2:column width="108" inputType="text" style="" id="column2" value="label" displayMode="label"></w2:column>
                        <w2:column width="125" inputType="text" style="" id="column1" value="value" displayMode="label"></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody style="" id="gBody1">
                    <w2:row style="" id="row2">
                        <w2:column width="70" inputType="text" style="" id="column8" value="" displayMode="label"></w2:column>
                        <w2:column width="70" inputType="drilldown" style="" id="depth" value="" displayMode="label" depthColumn="depth"
                            depthType="div" showDepth="5" depthStartIndex="0">
                        </w2:column>
                        <w2:column width="108" inputType="text" style="" id="label" value="" displayMode="label"></w2:column>
                        <w2:column width="125" inputType="text" style="" id="value" value="" displayMode="label"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
    </body>
</html>
