        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {

};



// 버그
scwin.radio_onchange = function (info) {
    console.log('radio')
    inputbox1.focus();
};


// 정상 작동
scwin.select11_onchange = function (info) {
    console.log('select')
    inputbox1.focus();
};

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('inputbox1').classList.contains('w2input_focus');
	}

	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('radio_input_0').click()");
		WebSquare.wUnit.addCommand("pause", "500");			
	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()","true");
		WebSquare.wUnit.addCommand("pause", "500");	
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:input ss_juminBunho="0" ss_keyCodeType="0 - NONE" id="inputbox1" ss_imeNative="1 - English" style="width:144px; height:21px; "
