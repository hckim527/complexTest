<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name2" dataType="text"></w2:column>
                        <w2:column id="col4" name="name2" dataType="text"></w2:column>
                        <w2:column id="col5" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name2" dataType="text"></w2:column>
                        <w2:column id="col4" name="name2" dataType="text"></w2:column>
                        <w2:column id="col5" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
    scwin.getNewData = function(cnt, idx, prefix) {
        var data = [];
        for (var i = 0; i < cnt; i++) {
            var obj = {};
            for (var j = 1; j <= 5; j++) {
                obj["col" + j] = prefix + (idx + i) + "," + j
            }
            data.push(obj);
        }
        return data;
    }
    scwin.onpageload = function() {
        trigger1.setLabel("조회");
        trigger2.setLabel("dataList1.insertJSON(0,scwin.newData);");
        trigger3.setLabel("dataList2.insertJSON(0,scwin.newData,{fixScroll:true});");
        trigger4.setLabel("dataList2.insertRow(0,{fixScroll:true})");
    }

    scwin.trigger1_onclick = function(e) {
        var row = 100;
        var data = [];
        var col = 5;
        for (var i = 1; i <= row; i++) {
            for (var j = 1; j <= col; j++) {
                data.push(i + "," + j);
            }
        }
        dataList1.setData(data.slice(0));
        dataList2.setData(data.slice(0));
    }
    
    scwin.trigger2_onclick = function(e) {
        var newData = scwin.getNewData(3, dataList1.getRowCount(), "A_");
        dataList1.insertJSON(0, newData);
    };

    scwin.trigger3_onclick = function(e) {
        var opt = {
            "fixScroll": true
        }
        var newData = scwin.getNewData(3, dataList2.getRowCount(), "B_");
        dataList2.insertJSON(0, newData, opt);
    };

    scwin.trigger4_onclick = function(e) {
        var opt = {
            "fixScroll": true
        }
        dataList2.insertRow(0, opt);
    };
	
	
	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('gridView2_scrollY_div').scrollTop == 500;
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView2_scrollY_div').scrollTop = 500");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()","true");
		WebSquare.wUnit.addCommand("pause", "500");	

		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()	
	
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:trigger id="trigger1" style="position:relative;width:150px;height:30px;" ev:onclick="scwin.trigger1_onclick"/>
        <w2:gridView dataList="data:dataList1" id="gridView1" 
            style="position: relative;width:500px;height:300px;" useShiftKey="true" rowNumVisible="true" dataTag="span">
            <w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
            <w2:header id="header2" style="">
                <w2:row id="row3" style="">
                    <w2:column blockSelect="false" id="h1" style="height:20px" inputType="text" width="70" displayMode="label"
                        value="col1">
                    </w2:column>
                    <w2:column blockSelect="false" id="h2" style="height:20px" width="70" inputType="text" displayMode="label"
                        value="col2">
                    </w2:column>
                    <w2:column blockSelect="false" id="h3" style="height:20px" width="70" inputType="text" displayMode="label"
                        value="col3">
                    </w2:column>
                    <w2:column blockSelect="false" id="h4" style="height:20px" width="70" inputType="text" displayMode="label"
                        value="col4">
                    </w2:column>
                    <w2:column blockSelect="false" id="h5" style="height:20px" width="70" inputType="text" displayMode="label"
                        value="col5">
                    </w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody id="gBody2" style="">
                <w2:row id="row4" style="">
                    <w2:column id="col1" inputType="text" displayMode="label" textContent="true"></w2:column>
                    <w2:column id="col2" inputType="text" displayMode="label" textContent="true"></w2:column>
                    <w2:column id="col3" inputType="text" displayMode="label" textContent="true"></w2:column>
                    <w2:column id="col4" inputType="text" displayMode="label" textContent="true"></w2:column>
                    <w2:column id="col5" inputType="text" displayMode="label" textContent="true"></w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
        <xf:trigger id="trigger2" style="position:relative;width:400px;height:30px;" ev:onclick="scwin.trigger2_onclick"/>
        <w2:gridView dataList="data:dataList2" id="gridView2" 
            style="position: relative;width:500px;height:300px;" useShiftKey="true" rowNumVisible="true">
            <w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
            <w2:header id="header2" style="">
                <w2:row id="row3" style="">
                    <w2:column blockSelect="false" id="h1" style="height:20px" inputType="text" width="70" displayMode="label"
                        value="col1">
                    </w2:column>
                    <w2:column blockSelect="false" id="h2" style="height:20px" width="70" inputType="text" displayMode="label"
                        value="col2">
                    </w2:column>
                    <w2:column blockSelect="false" id="h3" style="height:20px" width="70" inputType="text" displayMode="label"
                        value="col3">
                    </w2:column>
                    <w2:column blockSelect="false" id="h4" style="height:20px" width="70" inputType="text" displayMode="label"
                        value="col4">
                    </w2:column>
                    <w2:column blockSelect="false" id="h5" style="height:20px" width="70" inputType="text" displayMode="label"
                        value="col5">
                    </w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody id="gBody2" style="">
                <w2:row id="row4" style="">
                    <w2:column id="col1" inputType="text" displayMode="label" textContent="true"></w2:column>
                    <w2:column id="col2" inputType="text" displayMode="label" textContent="true"></w2:column>
                    <w2:column id="col3" inputType="text" displayMode="label" textContent="true"></w2:column>
                    <w2:column id="col4" inputType="text" displayMode="label" textContent="true"></w2:column>
                    <w2:column id="col5" inputType="text" displayMode="label" textContent="true"></w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
        <xf:group style="position:relative;width:410px;height:50px;">
            <xf:trigger id="trigger3" style="position:relative;width:400px;height:30px;" ev:onclick="scwin.trigger3_onclick"/>
        </xf:group>
        <xf:group style="position:relative;width:410px;height:50px;">
            <xf:trigger id="trigger4" style="position:relative;width:400px;height:30px;" ev:onclick="scwin.trigger4_onclick"/>
        </xf:group>
    </body>
</html>
