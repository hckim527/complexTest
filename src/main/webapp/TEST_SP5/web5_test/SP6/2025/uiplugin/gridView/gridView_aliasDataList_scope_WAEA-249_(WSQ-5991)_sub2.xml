            <xf:input id="input2" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap1.key2"/>
            <xf:input id="input3" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap1.key3"/>
        </xf:group>
        <xf:group style="position:relative;width:700;height:40px;">
            <xf:input id="input4" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap2.key1"/>
            <xf:input id="input5" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap2.key2"/>
            <xf:input id="input6" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap2.key3"/>
        </xf:group>
        <xf:group style="width:700px;height:51px;" id="">
            <xf:select1 id="selectbox1" chooseOption="true" style="width:200px;height:38px;" submenuSize="auto" allOption="true" disabled="false"
                direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="data:aliasDataMap2.key1" chooseOptionLabel="">
                <xf:choices>
                    <xf:itemset nodeset="data:aliasDataList2">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
            <xf:select1 id="selectbox2" chooseOption="true" style="width:200px;height:38px;" submenuSize="auto" allOption="true" disabled="false"
                direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="data:aliasDataMap2.key2" chooseOptionLabel="">
                <xf:choices>
                    <xf:itemset nodeset="data:aliasDataList3">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
            <xf:select1 id="selectbox3" chooseOption="true" style="width:200px;height:38px;" submenuSize="auto" allOption="true" disabled="false"
                direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="data:aliasDataMap2.key3" chooseOptionLabel="">
                <xf:choices>
                    <xf:itemset nodeset="data:aliasDataList4">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
