                    <w2:column width="70" inputType="text" style="" id="column11" value="expression" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column10" value="textarea" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column9" value="drilldown" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column8" value="textImage" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column7" value="checkcombobox" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column6" value="autoComplete" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column5" value="secret" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column4" value="custom" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column3" value="spinner" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column2" value="text" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column1" value="text" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="hcol20" value="YNFalse" displayMode="label"></w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody style="" id="gBody1">
                <w2:row style="" id="row2">
                    <w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="link" style="" id="col2" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="checkbox" style="" id="col3" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="button" style="" id="col4" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="image" style="" id="col5" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="radio" style="" id="col6" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="select" style="" id="col7" value="" displayMode="label" allOption=""
                        chooseOption="true" chooseOptionLabel="" ref="">
                        <w2:choices>
                            <w2:itemset nodeset="data:aliasDataList2">
