                        <w2:choices>
                            <w2:itemset nodeset="data:aliasDataList4">
                                <w2:label ref="col1"></w2:label>
                                <w2:value ref="col2"></w2:value>
                            </w2:itemset>
                        </w2:choices>
                    </w2:column>
                    <w2:column width="70" inputType="secret" style="" id="col15" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="col16" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="spinner" style="" id="col17" value="" displayMode="label"></w2:column>
