    <head meta_screenName="gridG">
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:aliasDataList scope="../aliasDataList1" id="aliasDataList1"></w2:aliasDataList>
                <w2:aliasDataList scope="../aliasDataList2" id="aliasDataList2"></w2:aliasDataList>
                <w2:aliasDataList scope="../../dataList3" id="aliasDataList3"></w2:aliasDataList>
                <w2:aliasDataList scope="../aliasDataList4" id="aliasDataList4"></w2:aliasDataList>
                <w2:aliasDataList scope="../aliasDataList5" id="aliasDataList5"></w2:aliasDataList>
                <w2:aliasDataMap scope="../../dataMap1" id="aliasDataMap1"></w2:aliasDataMap>
                <w2:aliasDataMap scope="../aliasDataMap2" id="aliasDataMap2"></w2:aliasDataMap>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
        
    scwin.onpageload = function() {
        trigger1.setLabel("aliasDataList2 setScope");
        trigger2.setLabel("aliasDataList3 setScope");
        trigger3.setLabel("aliasDataList2 remove");
        trigger4.setLabel("aliasDataMap2 remove");
    };
    
    scwin.onpageunload = function() {
        
    };

    scwin.trigger1_onclick = function() {
        aliasDataList2.setScope("../../dataList3");
    }
    scwin.trigger2_onclick = function() {
        aliasDataList3.setScope("../aliasDataList4")
    }    
    scwin.trigger3_onclick = function() {
        $p.data.remove("aliasDataList2");
    }
    scwin.trigger4_onclick = function() {
        $p.data.remove("aliasDataMap2");
    }
    
    ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <w2:gridView id="gridView1" style="width:700px;height:250px;" scrollByColumn="false" rowNumVisible="true"
