       <xf:group style="position:relative;width:700;height:40px;">
            <xf:trigger id="trigger1" style="position:relative;width:170px;height:32px;" ev:onclick="scwin.trigger1_onclick"/>
            <xf:trigger id="trigger2" style="position:relative;width:170px;height:32px;" ev:onclick="scwin.trigger2_onclick"/>
            <xf:trigger id="trigger3" style="position:relative;width:170px;height:32px;" ev:onclick="scwin.trigger3_onclick"/>
            <xf:trigger id="trigger4" style="position:relative;width:170px;height:32px;" ev:onclick="scwin.trigger4_onclick"/>
        </xf:group>
        <xf:group style="position:relative;width:700;height:40px;">
