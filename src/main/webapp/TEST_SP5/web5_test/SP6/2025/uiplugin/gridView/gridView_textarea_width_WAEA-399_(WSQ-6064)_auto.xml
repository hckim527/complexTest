	scwin.checkVal1 = function() {
		const bodyTable = WebSquare.wUnit.getDomById('sample02_body_table').offsetWidth;
		const textarea = WebSquare.wUnit.getDomById('sample02_cell_0_0').querySelector('div').offsetWidth;		
		console.log("bodyTable : ", bodyTable, "textarea : ", textarea)
		return bodyTable >= textarea;
	}		
	scwin.checkVal2 = function() {
		const bodyTable = WebSquare.wUnit.getDomById('sample00_body_table').offsetWidth;
		const textarea = WebSquare.wUnit.getDomById('sample00_cell_0_0').querySelector('div').offsetWidth;		
		console.log("bodyTable : ", bodyTable, "textarea : ", textarea)
		return bodyTable >= textarea;
	}	
	scwin.unitTest = function() {
		//Init test
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		
		//Run and Stop unit Test
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();

