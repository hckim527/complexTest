            </w2:gBody>
        </w2:gridView>
        <xf:trigger ev:onclick="scwin.trigger1_onclick" style="width:143px;height:36px;" id="trigger1" type="button">
            <xf:label><![CDATA[button]]></xf:label>
        </xf:trigger>
        <xf:group style="position:relative;width:700;height:40px;">
            <xf:input id="input1" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap1.key1"/>
            <xf:input id="input2" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap1.key2"/>
            <xf:input id="input3" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap1.key3"/>
