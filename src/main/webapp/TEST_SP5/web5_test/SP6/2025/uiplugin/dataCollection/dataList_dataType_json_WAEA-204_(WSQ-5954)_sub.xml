                    <w2:column width="70" inputType="text" style="" id="col16" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="spinner" style="" id="col17" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="col18" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="col19" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="col20" value="" displayMode="label"></w2:column>
