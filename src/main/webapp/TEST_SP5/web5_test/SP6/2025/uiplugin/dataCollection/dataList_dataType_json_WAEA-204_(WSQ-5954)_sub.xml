            <w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
            <w2:header style="" id="header1">
                <w2:row style="" id="row1">
                    <w2:column width="120" inputType="text" style="" id="column19" value="text" displayMode="label" useFilter="true"></w2:column>
                    <w2:column width="120" inputType="text" style="" id="column18" value="link" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column17" value="checkbox" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column16" value="button" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column15" value="image" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column14" value="radio" displayMode="label"></w2:column>
