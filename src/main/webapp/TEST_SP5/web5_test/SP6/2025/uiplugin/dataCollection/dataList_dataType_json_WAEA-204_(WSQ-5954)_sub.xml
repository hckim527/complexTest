                                <w2:value ref="col2"></w2:value>
                            </w2:itemset>
                        </w2:choices>
                    </w2:column>
                    <w2:column width="70" inputType="calendar" style="" id="col8" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="expression" style="" id="col9" value="" displayMode="label" expression="SUM('col1') + SUM('col7')"></w2:column>
                    <w2:column width="70" inputType="textarea" style="" id="col10" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="col11" value="" displayMode="label" depthColumn="col11" showDepth="4"></w2:column>
                    <w2:column width="70" inputType="textImage" style="" id="col12" value="" displayMode="label" imageSrc="btn_search.png" viewType="icon"></w2:column>
                    <w2:column width="70" inputType="checkcombobox" style="" id="col13" value="" displayMode="label" allOption=""
