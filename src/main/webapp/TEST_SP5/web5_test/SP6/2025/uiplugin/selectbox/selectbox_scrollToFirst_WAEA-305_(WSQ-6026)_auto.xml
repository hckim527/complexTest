<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" ev:ondataload="" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
                    <w2:columnInfo>
                        <w2:column dataType="text" id="code" name="name1"></w2:column>
                        <w2:column dataType="text" id="value" name="name2"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <code><![CDATA[1]]></code>
                            <value><![CDATA[11]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[2]]></code>
                            <value><![CDATA[22]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[3]]></code>
                            <value><![CDATA[33]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[4]]></code>
                            <value><![CDATA[44]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[5]]></code>
                            <value><![CDATA[55]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[6]]></code>
                            <value><![CDATA[66]]></value>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
                <w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="code" name="name1" dataType="text"></w2:column>
                        <w2:column id="value" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <code><![CDATA[1]]></code>
                            <value><![CDATA[11]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[2]]></code>
                            <value><![CDATA[22]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[3]]></code>
                            <value><![CDATA[33]]></value>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
    scwin.onpageload = function() {
        select1.setSelectedIndex(5);
        select2.setSelectedIndex(5);
        select3.setSelectedIndex(2);
    };
    
    scwin.onpageunload = function() {
    };
	
	scwin.checkVal = function() {
		const offSetTop = 48
		return WebSquare.wUnit.getJq("#select1_itemTable_0").offset().top > offSetTop;
	}
        
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('select1_button').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()","true");
		WebSquare.wUnit.addCommand("pause", "500");

		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
        }
	scwin.unitTest()	
	
    ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <xf:group tagname="fieldset" style="font-size:18px;height30px;border:1px solid red;">
            <legend>scrollToFirst = true</legend>
            <xf:select1 id="select1" chooseOption="" style="width:163px;height:21px;position:relative;" submenuSize="auto" allOption="" emptyItem="true" disabled="false" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="" scrollToFirst="true">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList1">
                        <xf:label ref="value"></xf:label>
                        <xf:value ref="code"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
        </xf:group>
        <xf:group tagname="fieldset" style="font-size:18px;height30px;border:1px solid red;">
            <legend>scrollToFirst = false</legend>
            <xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false" disabledClass="w2selectbox_disabled" id="select2" emptyItem="true" ref="" style="width:163px;height:21px;position:relative;" submenuSize="auto">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList1">
                        <xf:label ref="value"></xf:label>
                        <xf:value ref="code"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
        </xf:group>
        <xf:group tagname="fieldset" style="font-size:18px;height30px;border:1px solid red;">
            <legend>scrollToFirst = true, scroll not exist</legend>
            <xf:select1 id="select3" chooseOption="true" style="width:163px;height:21px;position:relative;" submenuSize="auto" appearance="minimal" disabledClass="" ref="" visibleRowNum="4" scrollToFirst="true">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList2">
                        <xf:label ref="value"></xf:label>
                        <xf:value ref="code"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
        </xf:group>
    </body>
</html>
