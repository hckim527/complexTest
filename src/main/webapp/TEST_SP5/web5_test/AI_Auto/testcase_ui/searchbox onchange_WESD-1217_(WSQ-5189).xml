<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataMap baseNode="map" id="dataMap1">
    				<w2:keyInfo>
    					<w2:key id="key1" name="name1" dataType="text"></w2:key>
    					<w2:key id="key2" name="name2" dataType="text"></w2:key>
    					<w2:key id="key3" name="name3" dataType="text"></w2:key>
    				</w2:keyInfo>
    			</w2:dataMap>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		dataMap1.set( "key1", "first key1" );
		dataMap1.set( "key2", "first key2" );
		dataMap1.set( "key3", "first key3" );
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
scwin.searchbox1_onchange = function() {
	console.log("onchange 테스트");
};

scwin.input1_onchange = function(info) {
	console.log("input1 onchange 테스트");
};

scwin.trigger1_onclick = function(e) {
	searchbox1.setRef("data:dataMap1.key1");
};

scwin.trigger2_onclick = function(e) {
	dataMap1.set( "key1", "change key1 value11" );
};

scwin.trigger3_onclick = function(e) {
	searchbox2.setReadOnly(false);
};

scwin.trigger4_onclick = function(e) {
	searchbox3.setDisabled(false);
};

scwin.searchbox4_onchange = function() {
console.log('searchbox4 onchange');
};
]]></script>
    	<style type="text/css"><![CDATA[
    	.readOnlyYellow{
    		background-color:yellow;
    	}
    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:searchbox id="searchbox1" style="width: 150px;height: 21px;" ev:onchange="scwin.searchbox1_onchange"
    		resetButtonDisplay="toggle">
    	</w2:searchbox>

    	<xf:trigger type="button" style="width: 80px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[setRef]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" style="width: 80px;height: 23px;" id="trigger2" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[set]]></xf:label>
    	</xf:trigger>
    	<w2:searchbox id="searchbox2" style="width: 150px;height: 21px;" readOnlyClass="readOnlyYellow" readOnly="true"
    		ref="data:dataMap1.key2">
    	</w2:searchbox>
    	<xf:trigger type="button" style="width:121px;height:23px;" id="trigger3" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[setReadOnly(false)]]></xf:label>
    	</xf:trigger>
    	<w2:textbox id="" label="" style="width: 150px;height: 23px;" ref="data:dataMap1.key2"></w2:textbox>
    	<w2:searchbox id="searchbox3" style="width: 150px;height: 21px;" disabled="true" ref="data:dataMap1.key3"></w2:searchbox>
    	<xf:trigger type="button" style="width:155px;height:23px;" id="trigger4" ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[setDisabled(false)]]></xf:label>
    	</xf:trigger>
    	<w2:textbox id="" label="" ref="data:dataMap1.key3" style="width: 150px;height: 23px;"></w2:textbox>
    	<w2:searchbox id="searchbox4" style="width: 150px;height: 21px;" resetButtonDisplay="toggle" ref="data:dataMap1.key2"
    		ev:onchange="scwin.searchbox4_onchange">
    	</w2:searchbox>
    	<w2:searchbox ev:onchange="scwin.searchbox4_onchange" id="key2" ref="data:dataMap1.key2" style="width: 150px;height: 21px;">
    	</w2:searchbox>
    	<w2:searchbox id="searchbox5" style="width: 150px;height: 21px;" resetButtonDisplay="toggle"></w2:searchbox>
    </body>
</html>
