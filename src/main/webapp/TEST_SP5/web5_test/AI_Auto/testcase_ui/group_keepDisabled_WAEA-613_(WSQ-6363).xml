    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="group_keepDisabled">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.trigger1_onclick = function (e) {
    group1.setDisabled(false);
};

scwin.trigger2_onclick = function (e) {
    group1.setDisabled(true);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:trigger style="width:124px;height:23px;" testText="" id="trigger1" type="button" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[setDisabled(false)]]></xf:label>
    	</xf:trigger>
    	<xf:trigger id="trigger2" style="width:124px;height:23px;" testText="" type="button" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[setDisabled(true)]]></xf:label>
    	</xf:trigger>
    	<xf:group id="group1" style="width: 200px;height: 200px;" keepDisabled="true">
    		<xf:input id="input1" style="width: 144px;height: 21px;" testText=""></xf:input>
    		<xf:group id="" style="width: 200px;height: 200px;" keepDisabled="true">
    			<xf:input id="input2" style="width: 144px;height: 21px;" testText=""></xf:input>
    			<xf:group id="" style="width: 200px;height: 200px;" keepDisabled="true">
    				<xf:input id="input3" style="width: 144px;height: 21px;" testText="" disabled="true"></xf:input>
    				<xf:input id="input4" style="width: 144px;height: 21px;" testText=""></xf:input>
    				<xf:select1 id="" chooseOption="" style="width: 148px;height: 21px;" submenuSize="auto" allOption="" disabled="false"
    					direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="">
    					<xf:choices>
    						<xf:item>
    							<xf:label><![CDATA[a]]></xf:label>
    							<xf:value><![CDATA[a]]></xf:value>
    						</xf:item>
    						<xf:item>
    							<xf:label><![CDATA[b]]></xf:label>
    							<xf:value><![CDATA[b]]></xf:value>
    						</xf:item>
    						<xf:item>
    							<xf:label><![CDATA[c]]></xf:label>
    							<xf:value><![CDATA[c]]></xf:value>
    						</xf:item>
    					</xf:choices>
    				</xf:select1>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>
