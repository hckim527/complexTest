		<w2:editor id="editor1" 
			style="width: 100%;height: 700px; padding:20px;box-sizing: border-box;"

			ev:onload="scwin.editor1_onload" 
			ev:onchange="scwin.editor1_onchange"

			menubar="all"
			imageUploadURL=""
			imageLoadURL="" 
			subDir=""
			language="ko" 
			transParentDisabled=""
			version=""
			resizable="true" 
			useCKFinder="" 
			placeholder="placeholder"
			useLocale=""
			placeholderLocaleRef="editorPlaceholder"
			maxCharCount="" 
			pasteBase64=""
			msaName=""
			useMarkdown=""
			accessibility="true"
			
			wAIEditor="true"
			autoMinHeight="500px"
			autoMaxHeight="80%"
		/>

		<xf:textarea id="" style="width: 300px;height: 100px;"></xf:textarea>

    	<xf:group style="margin-top: 20px;">
    		<xf:trigger type="button" id="trigger1" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger1_onclick">
    			<xf:label><![CDATA[setText("setText");]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger2" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger2_onclick">
    			<xf:label><![CDATA[getText();]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger3" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger3_onclick">
    			<xf:label><![CDATA[setHTML('<em><span style="font-size:14px;">editor setHTML(html) API.</span></em>');]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger4" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger4_onclick">
    			<xf:label><![CDATA[getHTML();]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger5" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger5_onclick">
    			<xf:label><![CDATA[focus();]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger6" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger6_onclick">
    			<xf:label><![CDATA[setDisabled(true);]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger7" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger7_onclick">
    			<xf:label><![CDATA[setReadOnly(true);]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger8" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger8_onclick">
    			<xf:label><![CDATA[setDomain();]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger9" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger9_onclick">
    			<xf:label><![CDATA[getDomain();]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger10" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger10_onclick">
    			<xf:label><![CDATA[getImageLoadURL();]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger11" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger11_onclick">
    			<xf:label><![CDATA[resize(450, 300);]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger12" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger12_onclick">
    			<xf:label><![CDATA[setPlaceholder("setPlaceholder");]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger13" style="position: relative;height:30px;width:500px;"
    			ev:onclick="scwin.trigger13_onclick">
    			<xf:label><![CDATA[getInnerText();]]></xf:label>
    		</xf:trigger>
    	</xf:group>
    </body>
</html>