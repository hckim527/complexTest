<?xml version="1.0"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>editor</title>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                    <DATA>
                        
                    </DATA>
                </data>
            </xf:instance>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
		scwin.editor1_onload = function() {
		};
		
        scwin.trigger1_onclick = function(e) {
		    editor1.setText('editor\n setText\t API \\ \" \'');
        };
        scwin.trigger2_onclick = function(e) {
		    console.log(editor1.getText());
        };
        scwin.trigger3_onclick = function(e) {
            editor1.setHTML('<em><span style="font-size:14px;">editor setHTML(html) API.</span></em>');
        };
        scwin.trigger4_onclick = function(e) {
            console.log(editor1.getHTML());
        };
        scwin.trigger5_onclick = function(e) {
            editor1.focus();
        };
        scwin.trigger6_onclick = function(e) {
            editor1.setDisabled(true);
        };
        scwin.trigger7_onclick = function(e) {
            editor1.setReadOnly(true);
        };
        scwin.trigger8_onclick = function(e) {
            editor1.setDomain("inswave.com"); // 5버전에서는 필요없음. 4버전에서 다이얼로그 내부 iframe과 브라우저간의 크로스도메인 처리 때문에 만든거.
        };
        scwin.trigger9_onclick = function(e) {
            console.log(editor1.getDomain());
        };
        scwin.trigger10_onclick = function(e) {
            console.log("editor1.options.imageUploadURL : " + editor1.options.imageUploadURL);
            console.log("editor1.options.imageLoadURL : " + editor1.options.imageLoadURL);
            console.log("editor1.getImageLoadURL() : " + editor1.getImageLoadURL());
        };
        scwin.trigger11_onclick = function(e) {
            editor1.resize(450, 300);
        };
        scwin.trigger12_onclick = function(e) {
            editor1.setPlaceholder("setPlaceholder API");
        };
        scwin.trigger13_onclick = function(e) {
            console.log(editor1.getInnerText());
        };
		
		scwin.editor1_onchange = function() {
			console.log("onchange occured");
		};

		scwin.trigger0_onclick = function(e) {
		    editor1.print();
        };
		]]></script>
    </head>
    <body>
	
    	<!-- <w2:tabControl id="" alwaysDraw="false" style="width: 500px;height: 500px;">
