<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="editFormat_sample">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:mfeSubmission/>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
};

scwin.show_multi = function() {
    alert("getValue(): " + input_multi.getValue());
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">

        <!-- 재현 현상: 영숫자 혼용 입력 시 6자 이후 입력 불가 (Format2 전환 안 됨) -->
        <xf:output id="lbl_format" style="position:absolute; top:10px; left:10px; width:500px; height:20px;"
            value="editFormat=&quot;XXX-XXX||XXXXX-XXXXXXXX-XXXXXXX||##-#####-####-##&quot;"/>

        <xf:input id="input_multi" style="position:absolute; top:40px; left:10px; width:220px; height:21px;"
            editFormat="XXX-XXX||XXXXX-XXXXXXXX-XXXXXXX||##-#####-####-##"/>

        <w2:button style="position:absolute; top:40px; left:240px; width:65px; height:21px;"
            text="값 확인" ev:onclick="scwin.show_multi()"/>

        <xf:output style="position:absolute; top:70px; left:10px; width:400px; height:18px;"
            value="※ 영숫자 혼용 입력(예: AB12345) 시 7자 이상 입력 불가 현상 확인"/>

    </body>
</html>
