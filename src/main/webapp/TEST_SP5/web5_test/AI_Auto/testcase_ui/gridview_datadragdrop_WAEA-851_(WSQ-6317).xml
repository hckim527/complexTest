	// $p.executeSubmission("submission1");
};

scwin.btn1_onclick = function (e) {
    const rows = ib1.getValue();
    const cols = 10;

    const data = Array.from({ length: rows }, (_, r) => {
        const rowNum = r + 1;
        let rowObj = {};

        rowObj['col1'] = String(Math.min((r % 10) + 1, 3));
        rowObj['col2'] = Math.trunc(r / 10).toString();
        rowObj['col3'] = 1;

        for (let c = 4; c <= cols; c++) {
            rowObj[`col${c}`] = `row${rowNum}_col${c}`;
        }

        return rowObj;
    }); 
    const rows2 = ib1.getValue() / 2;
    const data2 = Array.from({ length: rows2 }, (_, r) => {
        const rowNum = r + 1;
        let rowObj = {};

        rowObj['col10'] = String(Math.min((r % 10) + 1, 3));
        rowObj['col20'] = Math.trunc(r / 10).toString();
        rowObj['col30'] = 1;

        // for (let c = 40; c <= cols*10; c=c+10) {
        //     rowObj[`col${c}`] = `row${rowNum}_col${c}`;
        // }

        return rowObj;
    }); 
    // debugger;
    dl1.setJSON(data, false);
    dl2.setJSON(data2, false);
};

 scwin.dragEndFunction = function(targetRowIndex, rowXml, info) {
    return false;
 };]]></script>
