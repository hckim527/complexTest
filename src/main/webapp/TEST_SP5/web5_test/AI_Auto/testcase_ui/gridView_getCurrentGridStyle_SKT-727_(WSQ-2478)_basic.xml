        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    $p.local.setItem("getCurrentGridStyle", gridView1.getCurrentGridStyle());
    alert("getCurrentGridStyle and save it to localStorage");
};
scwin.trigger2_onclick = function(e) {
    gridView1.setGridStyle($p.local.getItem("getCurrentGridStyle"));
    alert("setGridStyle from localStorage");
};
scwin.trigger3_onclick = function(e) {
    var data = [];
    for (var i = 0; i < 20 * 50; i++) {
        data.push(i);
    }
    dataList1.setData(data);
}
scwin.trigger4_onclick = function(e) {
    gridView1.setFixedColumn("10");
};
scwin.onpageload = function() {
}
]]></script>
