<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    alert(multi1.getFileCount());
};
scwin.trigger2_onclick = function(e) {
    alert(multi2.getFileCount());
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:multiupload maxcount="1" wmode="false"
    		mode="html5_transparent" id="multi1" maxsize="" clearOnError="false"
    		style="position: relative;width:314px;height:111px;left:46px;top:54px;"
    		action="" uploadButton="" filter="">
    	</w2:multiupload>
    	<xf:trigger type="button" id="trigger1"
    		style="position: relative;width:91px;height:31px;left:46px;top:72px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[multi1 Count]]></xf:label>
    	</xf:trigger>
    	<w2:multiupload action="" filter="" id="multi2" maxcount="1"
    		maxsize="" mode="flash"
    		style="position: relative;width:314px;height:111px;left:407px;top:-80px;margin-top:-10px;"
    		uploadButton="" wmode="false">
    	</w2:multiupload>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2"
    		style="position: relative;width:92px;height:31px;left:410px;top:-67px;"
    		type="button">
    		<xf:label><![CDATA[multi2 Count]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 