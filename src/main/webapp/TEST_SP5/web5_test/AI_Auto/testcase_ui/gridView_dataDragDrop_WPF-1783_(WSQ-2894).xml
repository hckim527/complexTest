    grid2.setJSON(dst);
};
scwin.gridView1_ondatadragstart = function(rowIndex) {
    debugger;
    result.setValue(result.getValue() + '\n' + 'onDataDragStart : [' + this.id + '] row[' + rowIndex + '] drag started.');
};
scwin.gridView_ondatadragover = function(fromId, fromRowIndex) {
    result.setValue(result.getValue() + '\n' + 'onDataDragOver : from [' + fromId + '] to [' + this.id + '] drag over.');
};
scwin.gridView_ondatadrop = function(info) {
    debugger;
    var msg = 'onDataDrop : from [' + info.fromId + '] to [' + this.id + '] data dropped. ( from row[' + info.fromRowIndex + '] to row[' + info.toRowIndex + '] )';
    result.setValue(result.getValue() + '\n' + msg);
};
scwin.trigger2_onclick = function(e) {
    result.setValue("");
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //		scwin.init();
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
