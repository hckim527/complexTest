    	<script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		//$("div[id*='_gridstart_div']").remove();
		//$("div[id*='_gridend_div']").remove();
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    	<style type="text/css"><![CDATA[ 
    		div[id*="_gridstart_div"]:focus{position:absolute;top:0;width:100%;height:1px !important;border:1px solid red;z-index:1000;}
