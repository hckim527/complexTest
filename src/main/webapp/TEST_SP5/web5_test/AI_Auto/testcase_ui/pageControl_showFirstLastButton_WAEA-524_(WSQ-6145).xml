<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="pageControl">
    	<w2:type>COMPONENT</w2:type>
    	<w2:buildDate />
    	<w2:MSA />
    	<xf:model>
    		<w2:dataCollection baseNode="map" />
    		<w2:workflowCollection />
    	</xf:model>
    	<w2:layoutInfo />
    	<w2:publicInfo method="" />
    	<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	pglTest.setCount(100);
};
]]></script>
    	<style type="text/css"><![CDATA[.w2pageControl_pageleft_button {display:inline-block;width:30px;height:30px;margin-right:2px;border:1px solid #b3b4bb;border-radius:3px;background:url(/cm/images/pageControl_pageleft.png) no-repeat center,linear-gradient(to bottom,#fff 0,#fafafa 1%,#eee 100%)}
.w2pageControl_pageleft_button:hover {background:#EDEDED url(/cm/images/pageControl_pageleft.png) no-repeat center}
.w2pageControl_pageleft_icon {overflow:hidden;display:inline-block;position:relative;width:1px;height:1px;margin:-1px;color:transparent;clip:rect(0 0 0 0)}
.w2pageControl_pageright_button {display:inline-block;width:30px;height:30px;margin-left:2px;border:1px solid #b3b4bb;border-radius:3px;background:url(/cm/images/pageControl_pageright.png) no-repeat center,linear-gradient(to bottom,#fff 0,#fafafa 1%,#eee 100%)}
.w2pageControl_pageright_button:hover {background:#EDEDED url(/cm/images/pageControl_pageright.png) no-repeat center}
.w2pageControl_pageright_icon {overflow:hidden;display:inline-block;position:relative;width:1px;height:1px;margin:-1px;color:transparent;clip:rect(0 0 0 0)}




]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group id="" style="display:flex;align-items:center;">
    		<w2:button style="" id="" class="w2pageControl_pageleft_button">
    			<w2:span label="처음" style="" id="" class="w2pageControl_pageleft_icon"></w2:span>
    		</w2:button>
    		<w2:pageControl style="width:150px; height:30px; " id="" showFirstLastButton="true"></w2:pageControl>
    		<w2:button style="" id="" class="w2pageControl_pageright_button">
    			<w2:span id="" label="마지막" style="" class="w2pageControl_pageright_icon"></w2:span>
    		</w2:button>
    	</xf:group>
    </body>
</html>
