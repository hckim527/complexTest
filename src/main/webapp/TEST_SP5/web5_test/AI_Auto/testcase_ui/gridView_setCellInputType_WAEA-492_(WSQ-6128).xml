        <script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function() {
	scwin.grd_gridView1Custom();
};

scwin.grd_gridView1Custom = function() {
	let tcnt = ds_gridView.getRowCount();
	for (let rowIdx = 0; rowIdx < tcnt; rowIdx++) {
		let data = ds_gridView.getCellData(rowIdx, "col11");
		if (data == "") {
			scwin.gridViewSetCellInputType(grd_gridView1, rowIdx, "cust", "text");
		} else {
			scwin.gridViewSetCellInputType(grd_gridView1, rowIdx, "cust", data);
		}
	}
}

scwin.gridViewSetCellInputType = function(gridComp, rowIdx, colId, inputType, options, itemSet) {
	if (gridComp.options.setCellInputTypeCustom !== true) {
		alert("setCellInputType적용하려면 그리드 setCellInputTypeCustom 속성이 true여야 합니다.");
		return;
	}
	let colIdx = gridComp.getColumnIndex(colId);
	let colInputType = gridComp.getColumnType(colIdx);
	if (colInputType != "custom") {
		alert("setCellInputType적용하려면 그리드 컬럼 InputType이 custom 이어야 합니다.");
		return;
	}
	let _inputType = ["text", "link", "checkbox", "button", "image", "radio", "select", 
		"calendar", "expression", "textarea", "textImage", "checkcombobox", "autoComplete", "secret", "spinner"];
	if (_inputType.indexOf(inputType) < 0) {
		alert("setCellInputType 적용불가 inputType입니다. => " + inputType);
		return;
	}
	let info = {
		inputType : inputType,
		options : {
			displayFormat : "",
			dataType : "",
			calendarValueType : "",
			editType : "",
			validateOnInput : false,
			dateValidCheck : true,
			viewType : ""
		}
	}
	//기본설정
	if (inputType == "calendar") {
		info.options.viewType = "icon";
		info.options.editType = "select";
		info.options.validateOnInput = true;
		info.options.dateValidCheck = false;
		/*
		info.options.validCheck = false;
		info.options.displaymessage = false;
		info.options.dateValidSet = false;
		info.options.dateValidSetCustom = false;
		*/
		info.options.dataType = "date";
		info.options.calendarValueType = "yearMonthDate";
		info.options.displayFormat = "yyyy-MM-dd";
	} else if (inputType == "checkbox") {
		info.options.checkboxLabel = "checkbox";
		info.options.defalutValue = "1";
		info.options.trueValue = "1";
		info.options.falseValue = "";
	} else if (inputType == "radio") {
		info.options.radioLabel = "radio";
	} else if (inputType == "select") {
		info.options.viewType = "icon";
		info.options.textAlign = "center";
		info.options.displayMode = "label";
	} else if (inputType == "textImage") {
		info.options.viewType = "icon";
	} else if (inputType == "checkcombobox") {
		info.options.viewType = "icon";
	} else if (inputType == "autoComplete") {
		info.options.viewType = "icon";
	}
	if (inputType == "select" || inputType == "checkcombobox" || inputType == "autoComplete") {
		if (itemSet != null) {
			info.itemSet = {
				nodeset : itemSet.nodeset,
				label   : itemSet.label,
				value   : itemSet.value
			}
		}
	}
	//사용자 설정값 추가
	if (options != null) {
		for (let key in options) {
			info.options[key] = options[key];
		}
	}
	gridComp.setCellInputType(rowIdx, colIdx, info);
}
]]></script>
