<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataMap baseNode="map" id="dataMap1">
        			<w2:keyInfo>
        				<w2:key id="searchWord" name="searchWord" dataType="text"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="data:json,dataMap1" target="" action="/test" method="post" mediatype="application/json"
        		encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="" ev:submit=""
        		ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.subfunc = function(searchStr, keyCode) {
    dataMap1.set("searchWord", searchStr);
    $w.executeSubmission("submission1");
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:autoComplete submissionFunc="scwin.subfunc" submenuSize="auto" interactionMode="true" chooseOption=""
				useKeywordHighlight="true" allowEmptySubmission="true" allOption="" displayMode="label" search="contain" ref="" editType="select"
				noResult="" keyInputRef="" style="left:21px;top:22px;width: 148px;height: 21px;" submission="" visibleRowNum="10" id="autoComplete1">
				<w2:choices>
					<w2:itemset nodeset="">
						<w2:label ref=""></w2:label>
						<w2:value ref=""></w2:value>
					</w2:itemset>
				</w2:choices>
			</w2:autoComplete>
    </body>
</html>
 