<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:spinner buttonSize="30" skin="type1" id="Spinner1"
    		style="position: absolute;width:234px;height:86px;left:52px;top:50px;"
    		inputReadOnly="false" dataType="number" dateIncrementType=""
    		increment="1" min="0" max="10">
    	</w2:spinner>
    	<w2:spinner buttonSize="30" dataType="date"
    		dateIncrementType="minute" id="Spinner8" increment="3"
    		inputReadOnly="false" skin="type1"
    		style="position: absolute;width:234px;height:86px;left:562px;top:382px;">
    	</w2:spinner>
    	<w2:spinner buttonSize="30" dataType="time"
    		dateIncrementType="hour" id="Spinner2" increment="1"
    		inputReadOnly="false" skin="type1"
    		style="position: absolute;width:234px;height:86px;left:307px;top:52px;">
    	</w2:spinner>
    	<w2:spinner buttonSize="30" dataType="time"
    		dateIncrementType="minute" id="Spinner3" increment="3"
    		inputReadOnly="false" skin="type1"
    		style="position: absolute;width:234px;height:86px;left:308px;top:167px;">
    	</w2:spinner>
    	<w2:spinner buttonSize="30" dataType="date"
    		dateIncrementType="month" id="Spinner5" increment="3"
    		inputReadOnly="false" skin="type1"
    		style="position: absolute;width:234px;height:86px;left:560px;top:54px;">
    	</w2:spinner>
    	<w2:spinner buttonSize="30" dataType="date"
    		dateIncrementType="day" id="Spinner6" increment="3"
    		inputReadOnly="false" skin="type1"
    		style="position: absolute;width:234px;height:86px;left:561px;top:168px;">
    	</w2:spinner>
    	<w2:spinner buttonSize="30" dataType="time"
    		dateIncrementType="second" id="Spinner4" increment="3"
    		inputReadOnly="false" skin="type1"
    		style="position: absolute;width:234px;height:86px;left:308px;top:282px;">
    	</w2:spinner>
    	<w2:spinner buttonSize="30" dataType="date"
    		dateIncrementType="hour" id="Spinner7" increment="3"
    		inputReadOnly="false" skin="type1"
    		style="position: absolute;width:234px;height:86px;left:561px;top:283px;">
    	</w2:spinner>
    	<w2:textbox label="No Alert" id="Text1"
    		style="position: absolute;width: 150px;height: 23px;left:138px;top:15px;">
    	</w2:textbox>
    	<w2:textbox id="Text2" label="HH:mm:ss Alert"
    		style="position: absolute;width: 150px;height: 23px;left:368px;top:15px;">
    	</w2:textbox>
    	<w2:textbox id="Text3" label="yyyy-MM-dd HH:mm Alert"
    		style="position: absolute;width: 150px;height: 23px;left:588px;top:15px;">
    	</w2:textbox>
    </body>
</html>
 