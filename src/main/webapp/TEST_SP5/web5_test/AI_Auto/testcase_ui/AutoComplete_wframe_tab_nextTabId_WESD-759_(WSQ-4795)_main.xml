    com.win.setTabIndex(ibx_region, 10);
};
scwin.onpageunload = function() {};
scwin.dlt_memberList_oncelldatachange = function(info) {
    var id = dlt_memberList.getCellData(info.rowIndex, "id");
    var name = dlt_memberList.getCellData(info.rowIndex, "name");
    if (wfm_content.getSrc() === "wframe_sub1.xml") {
        wfm_content.getObj("ibx_idName").setValue("[" + id + "] - " + name);
    }
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.status = "R";
    window.com = {
        win: {}
    };
    /**
     * 특정 컴포넌트의 tabindex를 변경한다.
     * @example 
     * com.win.setTabIndex(ibx_region, 10);
     */
    com.win.setTabIndex = function(compObj, tabIndex) {
        compObj.options.tabIndex = tabIndex;
        WebSquare.wUnit.getDomById($p.id + compObj.getID()).tabIndex = tabIndex;
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
