        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {}		
scwin.getType = function(info) {
    var rowIndex = info.rowIndex;
    var colIndex = info.colIndex;
    if (colIndex == 0) {
        debugger;
        var inputType = "select";
        var returnInfo;
        switch (inputType) {
            case "select":
                returnInfo = {
                    id: "dynamic_select_" + rowIndex + "_" + colIndex,
                    inputType: "select",
                    options: {
                        viewType: "icon"
                    },
                    itemSet: {
                        nodeset: "root/ui/gridData/gridData_row[" + (rowIndex + 1) + "]/combo/item",
                        label: "label",
                        value: "value"
                    }
                }
                break;
        }
        return returnInfo;
    }
};

]]></script>
        
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    WebSquare.ModelUtil.removeInstanceNode("root/ui/gridData");
    var xmlDoc = WebSquare.ModelUtil.findInstanceNode("root/response/gridData");
    WebSquare.ModelUtil.setInstanceNode({
        doc: xmlDoc,
        xpath: "root/ui",
        mode: "replaceAll"
    });
    grid1.setRef({
        ref: "root/ui/gridData"
    })
};
scwin.trigger2_onclick = function(e) {
    WebSquare.ModelUtil.removeInstanceNode("root/ui/gridData");
    var xmlDoc = WebSquare.ModelUtil.findInstanceNode("root/response2/gridData");
    WebSquare.ModelUtil.setInstanceNode({
        doc: xmlDoc,
        xpath: "root/ui",
        mode: "replaceAll"
    });
    grid1.setRef({
        ref: "root/ui/gridData"
    })
};

]]></script>
