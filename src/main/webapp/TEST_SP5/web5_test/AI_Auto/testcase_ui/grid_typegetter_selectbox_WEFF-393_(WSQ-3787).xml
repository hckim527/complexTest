    <body ev:onpageload="scwin.onpageload">
    	<w2:grid baseNode="gridData" repeatNode="gridData_row" id="grid1" style="width: 500px;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true" ref="root/ui/gridData" setCellInputType="false">
