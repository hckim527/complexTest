<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <w2:tabControl id="tabControlAria" style="width:600px;height:180px;" selectedIndex="0" alwaysDraw="true"
            accessibility="true" tabRole="true" useTabTitleSelected="true" useTabContentAriaExpanded="true">
            <w2:tabs id="tabsAria1" label="Aria 1" style="height:30px;"></w2:tabs>
            <w2:tabs id="tabsAria2" label="Aria 2" style="height:30px;"></w2:tabs>
            <w2:tabs id="tabsAria3" label="Aria 3" style="height:30px;"></w2:tabs>
            <w2:content id="contentAria1" style="height:140px;">
                <xf:output id="outputAria1" style="width:150px;height:23px;">
                    <xf:label><![CDATA[Aria content 1]]></xf:label>
                </xf:output>
            </w2:content>
            <w2:content id="contentAria2" style="height:140px;">
                <xf:output id="outputAria2" style="width:150px;height:23px;">
                    <xf:label><![CDATA[Aria content 2]]></xf:label>
                </xf:output>
            </w2:content>
            <w2:content id="contentAria3" style="height:140px;">
                <xf:output id="outputAria3" style="width:150px;height:23px;">
                    <xf:label><![CDATA[Aria content 3]]></xf:label>
                </xf:output>
            </w2:content>
        </w2:tabControl>

        <w2:tabControl id="tabControlDefault" style="width:600px;height:160px;margin-top:20px;" selectedIndex="0" alwaysDraw="true">
            <w2:tabs id="tabsDefault1" label="Default 1" style="height:30px;"></w2:tabs>
            <w2:tabs id="tabsDefault2" label="Default 2" style="height:30px;"></w2:tabs>
            <w2:content id="contentDefault1" style="height:120px;">
                <xf:output id="outputDefault1" style="width:150px;height:23px;">
                    <xf:label><![CDATA[Default content 1]]></xf:label>
                </xf:output>
            </w2:content>
            <w2:content id="contentDefault2" style="height:120px;">
                <xf:output id="outputDefault2" style="width:150px;height:23px;">
                    <xf:label><![CDATA[Default content 2]]></xf:label>
                </xf:output>
            </w2:content>
        </w2:tabControl>
    </body>
</html>
