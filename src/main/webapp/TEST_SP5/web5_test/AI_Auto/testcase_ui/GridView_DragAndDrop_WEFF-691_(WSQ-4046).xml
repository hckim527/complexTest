		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.dragStartAll = function(rowIndex, dom, colInfo) {
    scwin.dragAllFlag = true;
    scwin.dragPersonFlag = false;
    scwin.dragRow = rowIndex;
    var name = dtl_colInfoAll3.getCellData(rowIndex, "name");
    var flag = true;
    for (var i = 0; i < dtl_colInfoPerson3.getTotalRow(); i++) {
        if (name == dtl_colInfoPerson3.getCellData(i, "name")) {
            flag = false;
        }
    }
    if (flag) {
        var index = dtl_colInfoPerson3.getTotalRow();
        dtl_colInfoPerson3.setRowJSON(index, dtl_colInfoAll3.getRowJSON(rowIndex), false);
        gridViewAll.setRowDisabled(rowIndex, true);
    }
    return flag;
};
scwin.dragStartPerson = function(rowIndex, dom, colInfo) {
    scwin.dragAllFlag = false;
    scwin.dragPersonFlag = true;
    scwin.dragRow = rowIndex;
    return true;
};
scwin.dragEndAll = function(a, b, c) {
    if (scwin.dragPersonFlag) {
        var data = dtl_colInfoPerson3.getRowJSON(scwin.dragRow);
        dtl_colInfoPerson3.removeRow(scwin.dragRow);
        dtl_colInfoPerson3.setRowJSON(a, data);
    }
    return false;
};
scwin.dragEndPerson = function(a, b, c) {
    dtl_colInfoPerson3.removeRow(scwin.dragRow);
    return false;
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
