<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/websquare/skin/a2.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="label" name="name1" dataType="text"></w2:column>
                        <w2:column id="value" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                    <w2:data>
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
        "label": "라벨1",
        "value": "밸류1"
    }, {
        "label": "라벨2",
        "value": "밸류2"
    }, {
        "label": "라벨3",
        "value": "밸류3"
    }, {
        "label": "라벨4",
        "value": "밸류4"
    }];
    dataList1.setJSON(jsonData);
};
scwin.onpageunload = function() {};
scwin.selectbox_component_customFormatter = function(itemArr) {
    if (itemArr && itemArr.length > 0) {
        itemArr[0].label = "selectbox_component_customFormatter" + itemArr[0].label;
    }
    return itemArr;
}
scwin.selectbox_native_customFormatter = function(itemArr) {
    if (itemArr && itemArr.length > 0) {
        itemArr[0].label = "selectbox_native_customFormatter" + itemArr[0].label;
    }
    return itemArr;
}
scwin.trigger1_onclick = function(e) {
    scwin.$w.watermark("자식화면");
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:trigger type="button" id="trigger1" style="position: relative;width:145px;height:55px;" ev:onclick="scwin.trigger1_onclick">
                <xf:label><![CDATA[scwin.$w.watermark]]></xf:label>
        </xf:trigger>
    <xf:group id="" style="height:50px;position:relative;">
                <xf:select1 id="selectbox_component" disabledClass="w2selectbox_disabled" appearance="minimal" style="position: relative;width: 148px;height: 21px;"
            direction="auto" chooseOption="" allOption="" displayMode="label delim value" disabled="false" submenuSize="auto" ref="" delimiter=" : " customFormatter="scwin.selectbox_component_customFormatter">
            <xf:choices>
                <xf:itemset nodeset="data:dataList1">
                    <xf:label ref="label"></xf:label>
                    <xf:value ref="value"></xf:value>
                </xf:itemset>
            </xf:choices>
        </xf:select1>
        <xf:select1 id="selectbox_native" disabledClass="w2selectbox_disabled" appearance="minimal" style="position: relative;width: 148px;height: 21px;"
            direction="auto" chooseOption="" allOption="" displayMode="label delim value" disabled="false" submenuSize="auto" ref="" renderType="select" delimiter=" : " customFormatter="scwin.selectbox_native_customFormatter">
            <xf:choices>
                <xf:itemset nodeset="data:dataList1">
                    <xf:label ref="label"></xf:label>
                    <xf:value ref="value"></xf:value>
                </xf:itemset>
            </xf:choices>
        </xf:select1>
    </xf:group></body>
</html>
 