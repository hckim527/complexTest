<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:buildDate/>
        <xf:model>
            <w2:dataCollection>
                <w2:dataList id="dataList1" baseNode="list" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="COL1" name="Name" dataType="text"></w2:column>
                        <w2:column id="COL2" name="Value" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var data = [
        { COL1: "item1", COL2: "val1" },
        { COL1: "item2", COL2: "val2" }
    ];
    dataList1.setJSON(data);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group id="grp_sub" style="width:100%;padding:5px;">
            <xf:input id="ipt_sub" style="width:150px;height:25px;"></xf:input>
            <xf:select1 id="sel_sub" appearance="minimal" style="width:150px;height:25px;">
                <w2:option>
                    <w2:value>A</w2:value>
                    <w2:label>Option A</w2:label>
                </w2:option>
                <w2:option>
                    <w2:value>B</w2:value>
                    <w2:label>Option B</w2:label>
                </w2:option>
            </xf:select1>
            <w2:gridView id="grd_sub" dataList="data:dataList1" style="width:300px;height:120px;">
                <w2:header>
                    <w2:row>
                        <w2:column id="hd_COL1" value="Name" width="150"></w2:column>
                        <w2:column id="hd_COL2" value="Value" width="150"></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody>
                    <w2:row>
                        <w2:column id="COL1" width="150"></w2:column>
                        <w2:column id="COL2" width="150"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
    </body>
</html>
