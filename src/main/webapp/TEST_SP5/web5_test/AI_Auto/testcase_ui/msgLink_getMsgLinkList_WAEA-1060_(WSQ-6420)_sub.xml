    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2006/xforms">
    <head>
        <xf:model/>
        <w2:msgLink>
            <w2:linkage id="LK_INC_1" type="in" sour="ml_parent" dest="ml_inc">
                <w2:send>
                    <w2:field sfn="MA_p_cusno" dfn="MA_c_cusno" lock="0"/>
                </w2:send>
                <w2:recv>
                    <w2:field sfn="MA_c_result" dfn="MA_p_result" lock="1"/>
                </w2:recv>
            </w2:linkage>
        </w2:msgLink>
        <script type="text/javascript" lazy="false"><![CDATA[
        scwin.onpageload = function () {
            $p.top().scwin.log("[includeFrame 자식] ml_inc.xml onpageload");
        };
        ]]>
        </script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group style="padding:6px;">
            <w2:textbox label="includeFrame 자식 화면 (자체 msgLink 보유)"></w2:textbox>
        </xf:group>
    </body>
</html>
