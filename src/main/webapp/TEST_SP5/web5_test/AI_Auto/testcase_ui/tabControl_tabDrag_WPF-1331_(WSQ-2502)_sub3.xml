										 } 
										 else{
										 	WebSquare.wUnit.getJq( ".gridSubtotalDefault" ).css( "display", "" );
										 }  
										 break;
								case "1" : if( checked ){
											WebSquare.wUnit.getJq("#"+gValue.gridID+"_gridFooterTDDefault_tbody").css( "display", "none" );
											WebSquare.wUnit.getJq("#"+gValue.gridID+"_dataLayer").css("bottom", "0px");
										 } 
										 else{
										 	WebSquare.wUnit.getJq("#"+gValue.gridID+"_gridFooterTDDefault_tbody").css( "display", "" );
											WebSquare.wUnit.getJq("#"+gValue.gridID+"_dataLayer").css("bottom", "22px");
