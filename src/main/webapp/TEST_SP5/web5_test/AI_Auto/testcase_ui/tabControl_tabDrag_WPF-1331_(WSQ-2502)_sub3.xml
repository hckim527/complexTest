				<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.element = WebSquare.ModelUtil.findInstanceNode("res/vector");
    grid1.setXML(element);
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
			</xf:submission>
		</xf:model>
		<script src="/poc_main/js/jquery-1.9.1.min.js"></script>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    WebSquare.ModelUtil.executeSubmission("getMeal");
