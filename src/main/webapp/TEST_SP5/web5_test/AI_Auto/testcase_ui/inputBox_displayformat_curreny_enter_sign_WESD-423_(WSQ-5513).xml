    				</w2:attributes></xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">


    				<xf:input adjustMaxLength="false" id="input8" style="width: 144px;height: 21px;" dataType="number" displayFormat="####.0#" applyFormat="all"></xf:input>


