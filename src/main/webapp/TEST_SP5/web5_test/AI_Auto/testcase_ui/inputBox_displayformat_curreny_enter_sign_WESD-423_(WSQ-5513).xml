    					<w2:scope>row</w2:scope>
    				</w2:attributes></xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">


    				<xf:input adjustMaxLength="false" id="input1" style="width:132px;height:21px;" dataType="euro" euroMask="####,0#" applyFormat="all"></xf:input>


    			</xf:group>
    		</xf:group>
    		
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="" class="w2tb_th">dataType&amp;nbsp;:&amp;nbsp;rupee<w2:attributes>
