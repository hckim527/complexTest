<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dl1">
        			<w2:columnInfo>
        				<w2:column id="col1" name="name1" dataType="text"></w2:column>
        				<w2:column id="col2" name="name2" dataType="text"></w2:column>
        				<w2:column id="col3" name="name3" dataType="text"></w2:column>
        				<w2:column id="col4" name="name4" dataType="text"></w2:column>
        				<w2:column id="col5" name="name5" dataType="text"></w2:column>
        				<w2:column id="col6" name="name6" dataType="text"></w2:column>
        				<w2:column id="col7" name="name7" dataType="text"></w2:column>
        				<w2:column id="col8" name="name8" dataType="text"></w2:column>
        				<w2:column id="col9" name="name9" dataType="text"></w2:column>
        				<w2:column id="col10" name="name10" dataType="text"></w2:column>
        				<w2:column id="depthcol" name="name11" dataType="text"></w2:column>
        			</w2:columnInfo>
        			<w2:data use="false"></w2:data>
        		</w2:dataList>
        		<w2:dataList baseNode="list" id="dl2" repeatNode="map" style="">
        			<w2:columnInfo>
        				<w2:column dataType="text" id="col1" name="name1"></w2:column>
        				<w2:column dataType="text" id="col2" name="name2"></w2:column>
        				<w2:column dataType="text" id="col3" name="name3"></w2:column>
        				<w2:column dataType="text" id="col4" name="name4"></w2:column>
        				<w2:column dataType="text" id="col5" name="name5"></w2:column>
        				<w2:column dataType="text" id="col6" name="name6"></w2:column>
        				<w2:column dataType="text" id="col7" name="name7"></w2:column>
        				<w2:column dataType="text" id="col8" name="name8"></w2:column>
        				<w2:column dataType="text" id="col9" name="name9"></w2:column>
        				<w2:column dataType="text" id="col10" name="name10"></w2:column>
        			</w2:columnInfo>
        			<w2:data use="false"></w2:data>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection />
        	<xf:submission id="submission1" action="../json_data.json" method="post" mediatype="application/json" ref=""
        		target="data:json,dl1" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="...Loading" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <w2:mfeSubmission/>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	// $p.executeSubmission("submission1");
    btn1.click();
};

scwin.btn1_onclick = function (e) {
    const rows = ib1.getValue();
    const cols = 10;

    const data = Array.from({ length: rows }, (_, r) => {
        const rowNum = r + 1;
        let rowObj = {};

        rowObj['col1'] = String(Math.min((r % 5) + 1, 3));
        rowObj['depthcol'] = String(Math.min((r % 5) + 1, 3));
        rowObj['col2'] = Math.trunc(r / 5).toString();
        rowObj['col3'] = 1;
        rowObj['col4'] = r*100;
        rowObj['col5'] = "/cm/images/base/ico_upload.svg";

        for (let c = 6; c <= cols; c++) {
            rowObj[`col${c}`] = `row${rowNum}_col${c}`;
        }

        return rowObj;
    }); 

    dl1.setJSON(data, false);
    dl2.setJSON(data, false);
};

scwin.button1_onclick = function (e) {
    alert(gv2.getMerged(0, 0));
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group id="" style="width:600px;height:5px;"></xf:group>
    	<xf:input id="ib1" style="width: 100px;height: 30px;" initValue="10"></xf:input>
    	<w2:button style="width: 80px;height: 30px;" id="btn1" ev:onclick="scwin.btn1_onclick" label="load data"></w2:button>
    	<w2:button ev:onclick="scwin.button1_onclick" id="button1" label="getmerged(0,0)" style="width:141px;height:30px;"></w2:button>
    	<xf:group id="" style="width:600px;height:5px;"></xf:group>
    	<w2:gridView checkAllType="false" dataList="data:dl2" id="gv2" style="width:778px;height:304px;" mergeCells="bycolupper">
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column id="column10" inputType="text" style="" value="name1" width="70"></w2:column>
    				<w2:column id="column9" inputType="text" style="" value="name2" width="70"></w2:column>
    				<w2:column id="column8" inputType="text" style="" value="name3" width="70"></w2:column>
    				<w2:column id="column7" inputType="text" style="" value="name4" width="70"></w2:column>
    				<w2:column id="column6" inputType="text" style="" value="name5" width="70"></w2:column>
    				<w2:column id="column5" inputType="text" style="" value="name6" width="70"></w2:column>
    				<w2:column id="column4" inputType="text" style="" value="name7" width="70"></w2:column>
    				<w2:column id="column3" inputType="text" style="" value="name8" width="70"></w2:column>
    				<w2:column id="column2" inputType="text" style="" value="name9" width="70"></w2:column>
    				<w2:column id="column1" inputType="text" style="" value="name10" width="70"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column id="col1" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column id="col2" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column id="col3" inputType="text" style="" value="" width="70" upperColumn="col1"></w2:column>
    				<w2:column id="col4" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column id="col5" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column id="col6" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column id="col7" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column id="col8" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column id="col9" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column id="col10" inputType="text" style="" value="" width="70"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
