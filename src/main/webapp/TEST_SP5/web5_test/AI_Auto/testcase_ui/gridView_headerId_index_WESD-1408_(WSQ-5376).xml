<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[a]]></col1>
            				<col2><![CDATA[aa]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[b]]></col1>
            				<col2><![CDATA[bb]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[c]]></col1>
            				<col2><![CDATA[cc]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[d]]></col1>
            				<col2><![CDATA[dd]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <style>
            .test_class {
                background : none !important;
                background-color : #00ccff !important;
            }
        </style>
        <script type="text/javascript" lazy="false"><![CDATA[
        
        	scwin.onpageload = function() {
        		
        	};
        	
        	scwin.onpageunload = function() {
        		
        	};
        	
        	// setHeaderStyle 
        	scwin.trigger1_onclick = function(e) {
        		mf_gridView1.setHeaderStyle(1, 'color', 'red')
        	};			
			// setHeaderClass
        	scwin.trigger2_onclick = function(e) {
        		mf_gridView1.setHeaderClass(1, 'test_class')
        	};
			// removeHeaderClass 
        	scwin.trigger3_onclick = function(e) {
        		mf_gridView1.removeHeaderClass(1, 'test_class')
        	};
        	// setHeaderBackgroundColor
        	scwin.trigger4_onclick = function(e) {
        		mf_gridView1.setHeaderBackgroundColor(1, 'red')
        	};
        	// setHeaderColor
        	scwin.trigger5_onclick = function(e) {
        		mf_gridView1.setHeaderColor(1, 'blue')
        	};
        	// setHeaderDisabled 
        	scwin.trigger6_onclick = function(e) {
        		mf_gridView1.setHeaderDisabled(1, true)
        	};

// setHeaderDisabled 적용됐는지 확인
scwin.headerClick = function(headerId) {
	alert(headerId + " clicked");
};
]]>
        </script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="data:dataList2" summaryAuto="false" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" id="gridView1" style="position: absolute;width:207px;height:150px;" ignoreCellClick="false"
    		syncScroll="false" ignoreToggleOnDisabled="false" summaryOnlyAuto="false" useShiftKey="true" rowNumVisible="true"
    		ev:onheaderclick="scwin.headerClick">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="name2" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="select" width="70" value="" displayMode="label"
    					allOption="" chooseOption="" ref="">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList1">
    							<w2:label ref="col1"></w2:label>
    							<w2:value ref="col2"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" style="" width="70" inputType="autoComplete" value="" displayMode="label"
    					allOption="" chooseOption="" ref="">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList1">
    							<w2:label ref="col2"></w2:label>
    							<w2:value ref="col1"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="position: absolute;width:292px;height:23px;left:211px;top:0px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[setHeaderStyle(1, 'color', 'red')]]></xf:label>
    	</xf:trigger>
    	<xf:trigger id="trigger2" style="position: absolute;width:292px;height:23px;left:211px;top:30px;" type="button"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[setHeaderClass(1, 'test_class')]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3" style="position:absolute;width:292px;height:23px;left:211px;top:60px;"
    		type="button">
    		<xf:label><![CDATA[removeHeaderClass(1, 'test_class')]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger4_onclick" id="trigger4" style="position:absolute;width:292px;height:23px;left:211px;top:91px;"
    		type="button">
    		<xf:label><![CDATA[setHeaderBackgroundColor(1, 'red')]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger5_onclick" id="trigger5"
    		style="position:absolute;width:292px;height:23px;left:211px;top:123px;" type="button">
    		<xf:label><![CDATA[setHeaderColor(1, 'blue')]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger6_onclick" id="trigger6"
    		style="position:absolute;width:292px;height:23px;left:211px;top:155px;" type="button">
    		<xf:label><![CDATA[setHeaderDisabled(1, true)]]></xf:label>
    	</xf:trigger>
    </body>
</html>
