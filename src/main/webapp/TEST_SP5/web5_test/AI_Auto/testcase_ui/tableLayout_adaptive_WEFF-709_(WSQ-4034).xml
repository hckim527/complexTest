            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    var idx = gen1.insert();
    gen1.getChild(idx, "textbox1").setValue("adaptive_test");
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group tagname="table" id="tableLayout1" style="width:100%;" class="w2tb" adaptive="layout" adaptiveThreshold="1000">
    		<w2:attributes>
    			<w2:summary></w2:summary>
    		</w2:attributes>
    		<xf:group tagname="caption"></xf:group>
    		<xf:group tagname="colgroup">
