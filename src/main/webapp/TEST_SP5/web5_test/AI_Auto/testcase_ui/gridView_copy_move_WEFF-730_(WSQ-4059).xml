<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                        <w2:column id="col5" name="name5" dataType="text"></w2:column>
                        <w2:column id="col6" name="name6" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.insertRow();
    var rJSON = dataList1.getRowJSON(0);
    var jsonData = [];
    for (var i = 0; i < 3; i++) {
        var tmp = {};
        for (var item in rJSON) {
            if (item == "rowStatus") continue;
            tmp[item] = item + "_" + i;
        }
        jsonData.push(tmp);
    }
    dataList1.setJSON(jsonData);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    var visible = gridView1.getColumnVisible("col1");
    visible = visible ? false : true;
    gridView1.setColumnVisible("col1", visible);
};
scwin.trigger2_onclick = function(e) {
    var visible = gridView1.getColumnVisible("col2");
    visible = visible ? false : true;
    gridView1.setColumnVisible("col2", visible);
};
scwin.trigger3_onclick = function(e) {
    var visible = gridView1.getColumnVisible("col3");
    visible = visible ? false : true;
    gridView1.setColumnVisible("col3", visible);
};
scwin.trigger4_onclick = function(e) {
    var visible = gridView1.getColumnVisible("col4");
    visible = visible ? false : true;
    gridView1.setColumnVisible("col4", visible);
};
scwin.trigger5_onclick = function(e) {
    var visible = gridView1.getColumnVisible("col5");
    visible = visible ? false : true;
    gridView1.setColumnVisible("col5", visible);
};
scwin.trigger6_onclick = function(e) {
    var visible = gridView1.getColumnVisible("col6");
    visible = visible ? false : true;
    gridView1.setColumnVisible("col6", visible);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:group id="" style="width:792px;height:40px;">
            <xf:trigger type="button" id="trigger1" style="width: 120px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
                <xf:label><![CDATA[col1 toggle visible]]></xf:label>
            </xf:trigger>
            <xf:trigger type="button" id="trigger2" style="width: 120px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
                <xf:label><![CDATA[col2 toggle visible]]></xf:label>
            </xf:trigger>
            <xf:trigger type="button" id="trigger3" style="width: 120px;height: 23px;" ev:onclick="scwin.trigger3_onclick">
                <xf:label><![CDATA[col3 toggle visible]]></xf:label>
            </xf:trigger>
            <xf:trigger type="button" id="trigger4" style="width: 120px;height: 23px;" ev:onclick="scwin.trigger4_onclick">
                <xf:label><![CDATA[col4 toggle visible]]></xf:label>
            </xf:trigger>
            <xf:trigger type="button" id="trigger5" style="width: 120px;height: 23px;" ev:onclick="scwin.trigger5_onclick">
                <xf:label><![CDATA[col5 toggle visible]]></xf:label>
            </xf:trigger>
            <xf:trigger type="button" id="trigger6" style="width: 120px;height: 23px;" ev:onclick="scwin.trigger6_onclick">
                <xf:label><![CDATA[col6 toggle visible]]></xf:label>
            </xf:trigger>
        </xf:group>
        <w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1"
            style="width: 500px;height: 150px;" columnMove="true">
            <w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
            <w2:header id="header2" style="">
                <w2:row id="row3" style="">
                    <w2:column blockSelect="false" id="column13" removeBorderStyle="false" style="" inputType="text" width="70"
                        value="name1" displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column11" removeBorderStyle="false" style="" inputType="text" width="70"
                        value="name2" displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column9" removeBorderStyle="false" style="" inputType="text" width="70" value="name3"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column7" removeBorderStyle="false" style="" inputType="text" width="70" value="name4"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70" value="name5"
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" width="70" inputType="text" value="name6"
                        displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody id="gBody2" style="">
                <w2:row id="row4" style="">
                    <w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="col4" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="col5" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                        displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="col6" removeBorderStyle="false" style="" width="70" inputType="text" value=""
                        displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
    </body>
</html>
 