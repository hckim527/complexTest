<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" matchIgnoreCase="false" repeatNode="map" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[ab]]></col1>
            				<col2><![CDATA[1]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[AB]]></col1>
            				<col2><![CDATA[2]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[aB]]></col1>
            				<col2><![CDATA[3]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[Ab]]></col1>
            				<col2><![CDATA[4]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.btn_getMatchedData_onclick = function (e) {
	let rtn = dataList1.getMatchedData("col1", "ab", true);
    alert(rtn);
};

scwin.btn_setMatchedIgnoreCase_true_onclick = function (e) {
	dataList1.setMatchIgnoreCase(true);
};

scwin.btn_setMatchedIgnoreCase_false_onclick = function (e) {
	dataList1.setMatchIgnoreCase(false);
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView checkAllType="false" dataList="data:dataList1" id="" style="width:500px;height:219px;">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column id="column1" inputType="text" style="" value="name1" width="70"></w2:column>
    				<w2:column displayMode="label" id="column4" inputType="text" style="" value="name2" width="70"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column id="col1" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col2" inputType="text" style="" value="" width="70"></w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:button id="" style="width: 100px;height: 100px;"></w2:button>
    	</w2:gridView>
    	<w2:button ev:onclick="scwin.btn_getMatchedData_onclick" id="btn_getMatchedData" label="getMatchedData" style="width:123px;height:44px;"></w2:button>
        <w2:button ev:onclick="scwin.btn_setMatchedIgnoreCase_false_onclick" id="btn_setMatchedIgnoreCase_false"
    		label="setMatchedIgnoreCase(false)" style="width:203px;height:44px;">
    	</w2:button>
    	<w2:button ev:onclick="scwin.btn_setMatchedIgnoreCase_true_onclick" id="btn_setMatchedIgnoreCase_true"
    		label="setMatchedIgnoreCase(true)" style="width:203px;height:44px;">
    	</w2:button>
    </body>
</html>
