			<w2:dataCollection baseNode="map">

				<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true" style="">
					<w2:columnInfo>
						<w2:column dataType="text" id="label" name="label"></w2:column>
						<w2:column dataType="text" id="series" name="series"></w2:column>
						<w2:column dataType="text" id="value" name="value"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>

			<xf:submission id="submission1" ref='data:json,{"id":"dataList1","action":"updated"}' target="data:json,dataList1" action="wFrame_Scope_fwRealtimeChartCsv_WEFF-313_(WSQ-3773).jsp" method="post" mediatype="application/json"
				encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="" ev:submit="" ev:submitdone="scwin.submission1_submitdone"
				ev:submiterror="" abortTrigger="">
			</xf:submission>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    WebSquare.util.setTimeout(function() {
        //debugger;
        selectbox2.setSelectedIndex(2);
    }, {
        delay: 200
    });
};
scwin.submission1_submitdone = function(e) {
    dataList1.setData([]);
    dataList1.setData([]);
    dataList1.setData(e.responseText.split(","));
};
scwin.cmdOperate0_onclick = function(e) {
    fch_realtime.restartUpdate();
};
scwin.trigger2_onclick = function(e) {
    fch_realtime.clearChart();
};
scwin.cmdOperate1_onclick = function(e) {
    fch_realtime.stopUpdate();
};
scwin.btnLegend_onclick = function(e) {
    if (scwin.flag == "1") {
        scwin.flag = "0";
        btnLegend.setValue("Legend 보이기");
    } else {
        scwin.flag = "1";
        btnLegend.setValue("Legend 숨기기");
    }
    var options = {
        "showLegend": scwin.flag
    };
    fch_realtime.setChartAttribute(options);
    fch_realtime.draw();
};
scwin.selectbox2_onviewchange = function(info) {
    fch_realtime.changeType(selectbox2.getValue());
};
scwin.btnStart_onclick = function(e) {
    scwin.$w.executeSubmission("submission1");
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.flag = "1";
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>

