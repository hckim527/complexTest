<?xml version="1.0" encoding="EUC-KR"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="pageList_focus">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:mfeSubmission/>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	pageList1.setCount(14);
    pageList2.setCount(2);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">

    	<xf:group id="" style="height:100px;">
            <w2:pageList adaptive="true" adaptiveThreshold="680" buttonShowType="3" 
                pageSize="10" displayButtonType="autoHidden" pagingType="2" 
                displayFormat="#" style="width: 350px;height: 21px;" id="pageList1" renderType="list">
    	    </w2:pageList>
        </xf:group>
        
        <w2:pageList displayButtonType="auto" 
            displayFormat="#" id="pageList2" pageSize="10" 
            adaptive="true" renderType="pagination"  adaptiveThreshold="680"
            style="width: 350px;height: 21px;">
    	</w2:pageList>
    </body>
</html>
