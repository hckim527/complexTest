<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            			<w2:column id="depth" name="name3" dataType="text"></w2:column>
            			<w2:column id="disabled" name="name4" dataType="text"></w2:column>
            			<w2:column id="checkbox" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[1]]></label>
            				<value><![CDATA[1]]></value>
            				<depth><![CDATA[1]]></depth>
                            <checkbox><![CDATA[false]]></checkbox>
            				<disabled><![CDATA[false]]></disabled>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[1-1]]></label>
            				<value><![CDATA[2]]></value>
            				<depth><![CDATA[2]]></depth>
                            <checkbox><![CDATA[true]]></checkbox>
            				<disabled><![CDATA[true]]></disabled>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[2]]></label>
            				<value><![CDATA[3]]></value>
            				<depth><![CDATA[1]]></depth>
                            <checkbox><![CDATA[false]]></checkbox>
            				<disabled><![CDATA[false]]></disabled>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
                <w2:dataList baseNode="list" repeatNode="map" id="dataList2">
                    <w2:columnInfo>
                        <w2:column id="label" name="name1" dataType="text"></w2:column>
                        <w2:column id="value" name="name2" dataType="text"></w2:column>
                        <w2:column id="depth" name="name3" dataType="text"></w2:column>
                        <w2:column id="disabled" name="name4" dataType="text"></w2:column>
                        <w2:column id="checkbox" name="name5" dataType="text"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <label><![CDATA[1]]></label>
                            <value><![CDATA[1]]></value>
                            <depth><![CDATA[1]]></depth>
                            <checkbox><![CDATA[false]]></checkbox>
                            <disabled><![CDATA[false]]></disabled>
                        </w2:row>
                        <w2:row>
                            <label><![CDATA[1-1]]></label>
                            <value><![CDATA[2]]></value>
                            <depth><![CDATA[2]]></depth>
                            <checkbox><![CDATA[true]]></checkbox>
                            <disabled><![CDATA[true]]></disabled>
                        </w2:row>
                        <w2:row>
                            <label><![CDATA[2]]></label>
                            <value><![CDATA[3]]></value>
                            <depth><![CDATA[1]]></depth>
                            <checkbox><![CDATA[false]]></checkbox>
                            <disabled><![CDATA[false]]></disabled>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	target2.spanAll(true);
};



scwin.bnt_getColData_onclick = function (e) {
	console.log("dataList1 ", dataList1.getColData("disabled"));
};

scwin.btn_disableCheckboxByValue_onclick = function (e) {
	target1.disableCheckboxByValue(2, false);
};

scwin.bnt_getColData2_onclick = function (e) {
    console.log("dataList2 ", dataList2.getColData("disabled"));
};

scwin.btn_disableCheckboxByValue2_onclick = function (e) {
    target2.disableCheckboxByValue(2, false);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group>
        	<w2:treeview id="target1" dataType="listed" tooltipGroupClass="false" style="width: 200px;height: 200px;" showCheckbox="true" refreshCheckboxDisableModel="true">
        		<w2:itemset nodeset="data:dataList1">
        			<w2:label ref="label"></w2:label>
        			<w2:value ref="value"></w2:value>
        			<w2:depth ref="depth"></w2:depth>
        			<w2:folder ref=""></w2:folder>
        			<w2:checkbox ref="checkbox"></w2:checkbox>
        			<w2:checkboxDisabled ref="disabled"></w2:checkboxDisabled>
        			<w2:image ref=""></w2:image>
        			<w2:iconImage ref=""></w2:iconImage>
        			<w2:selectedImage ref=""></w2:selectedImage>
        			<w2:expandedImage ref=""></w2:expandedImage>
        			<w2:leafImage ref=""></w2:leafImage>
        		</w2:itemset>
        	</w2:treeview>

        	<w2:button ev:onclick="scwin.btn_disableCheckboxByValue_onclick" id="btn_disableCheckboxByValue" label="disableCheckboxByValue" style="width:176px;height:34px;"></w2:button>
        	<w2:button style="width:100px;height:34px;" id="bnt_getColData" label="getColData" ev:onclick="scwin.bnt_getColData_onclick"></w2:button>
        </xf:group>
        <xf:group>
            <w2:treeview id="target2" dataType="listed" tooltipGroupClass="false" style="width: 200px;height: 200px;" showCheckbox="true" refreshCheckboxDisableModel="true" renderType="virtual">
                <w2:itemset nodeset="data:dataList2">
                    <w2:label ref="label"></w2:label>
                    <w2:value ref="value"></w2:value>
                    <w2:depth ref="depth"></w2:depth>
                    <w2:folder ref=""></w2:folder>
                    <w2:checkbox ref="disabled"></w2:checkbox>
                    <w2:checkboxDisabled ref="disabled"></w2:checkboxDisabled>
                    <w2:image ref=""></w2:image>
                    <w2:iconImage ref=""></w2:iconImage>
                    <w2:selectedImage ref=""></w2:selectedImage>
                    <w2:expandedImage ref=""></w2:expandedImage>
                    <w2:leafImage ref=""></w2:leafImage>
                </w2:itemset>
            </w2:treeview>

            <w2:button ev:onclick="scwin.btn_disableCheckboxByValue2_onclick" id="btn_disableCheckboxByValue2" label="disableCheckboxByValue" style="width:176px;height:34px;"></w2:button>
            <w2:button style="width:100px;height:34px;" id="bnt_getColData2" label="getColData" ev:onclick="scwin.bnt_getColData2_onclick"></w2:button>
        </xf:group>
    </body>
</html>
