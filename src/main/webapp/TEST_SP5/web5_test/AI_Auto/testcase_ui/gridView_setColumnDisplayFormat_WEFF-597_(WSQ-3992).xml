<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="bigDecimal"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
        "col1": 111111111,
        "col2": 23
    }, {
        "col1": 222,
        "col2": 3
    }, {
        "col1": 33333,
        "col2": 6
    }, {
        "col1": 4,
        "col2": 8883333
    }];
    dataList1.setJSON(jsonData);
};
scwin.trigger3_onclick = function(e) {
    gridView2.setColumnDisplayFormat(0, "#,##0.0");
};
scwin.trigger2_onclick = function(e) {
    gridView2.advancedExcelDownload({
        "fileName": "test.xls",
        "type": "0"
    });
};
scwin.trigger4_onclick = function(e) {
    gridView2.advancedExcelDownload({
        "fileName": "test.xls",
        "type": "1"
    });
};
scwin.trigger5_onclick = function(e) {
    gridView2.advancedExcelDownload({
        "fileName": "test.xls",
        "type": "2"
    });
};
scwin.trigger6_onclick = function(e) {
    gridView2.advancedExcelDownload({
        "fileName": "test.xls",
        "type": "0",
        "useDataFormat": "true"
    });
};
scwin.trigger7_onclick = function(e) {
    gridView2.advancedExcelDownload({
        "fileName": "test.xls",
        "type": "1",
        "useDataFormat": "true"
    });
};
scwin.trigger8_onclick = function(e) {
    gridView2.advancedExcelDownload({
        "fileName": "test.xls",
        "type": "2",
        "useDataFormat": "true"
    });
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView2" scrollByColumn="false" scrollByColumnAdaptive="false"
    		style="position: absolute ;left:85px;top:60px;width:129px;height:203px;">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" displayMode="label" id="column1" inputType="text" removeBorderStyle="false" style=""
    					value="name1" width="70">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" dataType="number" displayFormat="" displayMode="label" id="col1" inputType="text"
    					removeBorderStyle="false" style="" value="" width="70">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:group id="" style="position:absolute;top:148px;left:252px;width:321px;height:298px;border: 2px solid black;">
    		<w2:textbox label='useDataFormat=""' id="" style="position: absolute ;width: 228px;height: 63px;font-size: 20px;border: 2px solid black;"></w2:textbox><xf:trigger id="trigger2" style="position: absolute ;left:0px;top:75px;width:319px;height: 66px;"
    			ev:onclick="scwin.trigger2_onclick" type="button">
    			<xf:label><![CDATA[[type=0] gridView2.setColumnDisplayFormat]]></xf:label>
    		</xf:trigger>
    		<xf:trigger id="trigger4" style="position: absolute ;left:2px;top:151px;width:319px;height:66px;"
    			ev:onclick="scwin.trigger4_onclick" type="button">
    			<xf:label><![CDATA[[type=1] gridView2.setColumnDisplayFormat]]></xf:label>
    		</xf:trigger>
    		<xf:trigger id="trigger5" style="position: absolute ;left:2px;top:227px;width:319px;height:66px;"
    			ev:onclick="scwin.trigger5_onclick" type="button">
    			<xf:label><![CDATA[[type=2] gridView2.setColumnDisplayFormat]]></xf:label>
    		</xf:trigger>
    	</xf:group>
    	<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3"
    		style="position: absolute ;left:252px;top:67px;width:319px;height:66px;" type="button">
    		<xf:label><![CDATA[gridView2.setColumnDisplayFormat]]></xf:label>
    	</xf:trigger>
    	<xf:group id="" style="position:absolute;top:148px;left:622px;width:321px;height:298px;border: 2px solid black;">
    		<w2:textbox id="" label='useDataFormat="true"' style="position: absolute ;width: 228px;height: 63px;font-size: 20px;border: 2px solid black;"></w2:textbox><xf:trigger id="trigger6" style="position: absolute ;left:0px;top:75px;width:319px;height: 66px;"
    			ev:onclick="scwin.trigger6_onclick" type="button">
    			<xf:label><![CDATA[[type=0] gridView2.setColumnDisplayFormat]]></xf:label>
    		</xf:trigger>
    		<xf:trigger id="trigger7" style="position: absolute ;left:2px;top:151px;width:319px;height:66px;"
    			ev:onclick="scwin.trigger7_onclick" type="button">
    			<xf:label><![CDATA[[type=1] gridView2.setColumnDisplayFormat]]></xf:label>
    		</xf:trigger>
    		<xf:trigger id="trigger8" style="position: absolute ;left:2px;top:227px;width:319px;height:66px;"
    			ev:onclick="scwin.trigger8_onclick" type="button">
    			<xf:label><![CDATA[[type=2] gridView2.setColumnDisplayFormat]]></xf:label>
    		</xf:trigger>
    	</xf:group>
    	
    	
    </body>
</html>
 