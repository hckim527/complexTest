            };

            scwin.gridView1_subtotalStyleFormatter = function(value, formattedValue) {
                if (value === 0 || !value) {
                    return;
                }
                if (value > 0) {
                    return "w2subtotalplus";
                } else {
                    return "w2subtotalminus"
                }
            }
		]]></script>
