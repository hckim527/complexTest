<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dlt_dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{"col1":"aaa", "col3":"tttt", "col2":"20260101", "col4":"1"}
                    ,{"col1":"bbb", "col3":"dddd", "col2":"20260201", "col4":"2"}
                    ,{"col1":"ddd", "col3":"hhhh", "col2":"20260301", "col4":"3"}
                    ,{"col1":"ddd2", "col3":"dddd", "col2":"20260401", "col4":"4"}]
    dlt_dataList1.setJSON(jsonData);
};

scwin.btn_trigger1_onclick = function(e) {
    var nCnt = dlt_dataList1.getRowCount();
    for (var i=0; i<nCnt; i++) {
        var isReadOnly = true;
        if (dlt_dataList1.getCellData(i, "col3") == "dddd") {
            isReadOnly = false;
        }
        grd_sample.setReadOnly("cell", i, "col1", isReadOnly);
        grd_sample2.setReadOnly("cell", i, "col1", isReadOnly);
    }
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:trigger type="button" id="btn_trigger1" style="width:104px;height:23px;" ev:onclick="scwin.btn_trigger1_onclick">
            <xf:label><![CDATA[setReadOnly]]></xf:label>
        </xf:trigger>
    	<w2:gridView checkAllType="false" defaultCellHeight="20" id="grd_sample" style="width: 500px;height: 150px;"
    		dataList="data:dlt_dataList1" editModeEvent="onclick" 
    		moveKeyEditModeAll="true" moveKeyEditMode="true" keyMoveEditMode="true" focusFlow="linear">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="110" inputType="text" style="" id="column5" value="name1" displayMode="label"></w2:column>
    				<w2:column width="105" inputType="text" style="" id="column4" value="name2" displayMode="label"></w2:column>
    				<w2:column width="122" inputType="text" style="" id="column3" value="name3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="110" inputType="text" style="" id="col1" value="" displayMode="label" readOnly="true"></w2:column>
    				<w2:column width="105" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="122" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:gridView checkAllType="false" dataList="data:dlt_dataList1" defaultCellHeight="20" editModeEvent="onclick" 
    		id="grd_sample2" style="width: 500px;height: 150px;" 
            moveKeyEditModeAll="true" moveKeyEditMode="true" keyMoveEditMode="true" focusFlow="linear">
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header2" style="">
    			<w2:row id="row3" style="">
    				<w2:column width="70" inputType="text" style="" id="column6" value="" displayMode="label"></w2:column>
    				<w2:column displayMode="label" id="column5" inputType="text" style="" value="name1" width="110"></w2:column>
    				<w2:column displayMode="label" id="column4" inputType="text" style="" value="name2" width="105"></w2:column>
    				<w2:column displayMode="label" id="column3" inputType="text" style="" value="name3" width="122"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody2" style="">
    			<w2:row id="row4" style="">
    				<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				<w2:column displayMode="label" id="col1" inputType="text" readOnly="true" style="" value="" width="110"></w2:column>
    				<w2:column displayMode="label" id="col2" inputType="text" style="" value="" width="105"></w2:column>
    				<w2:column displayMode="label" id="col3" inputType="text" style="" value="" width="122"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
