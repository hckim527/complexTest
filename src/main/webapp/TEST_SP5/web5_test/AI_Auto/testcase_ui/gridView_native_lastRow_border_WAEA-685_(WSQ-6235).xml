<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_native" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="COL1" name="항목1" dataType="text"></w2:column>
						<w2:column id="COL2" name="항목2" dataType="text"></w2:column>
						<w2:column id="COL3" name="항목3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_virtual" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="COL1" name="항목1" dataType="text"></w2:column>
						<w2:column id="COL2" name="항목2" dataType="text"></w2:column>
						<w2:column id="COL3" name="항목3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var data = [];
	for (var i = 1; i <= 3; i++) {
		data.push({COL1: "data" + i, COL2: "value" + i, COL3: "item" + i});
	}
	dlt_native.setJSON(data);
	dlt_virtual.setJSON(data);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_main" style="width:100%;padding:10px;">
			<w2:textbox id="tbx_title1" label="drawType=native" style="font-weight:bold;margin-bottom:5px;" tagname="h3"></w2:textbox>
			<w2:gridView id="grd_native" dataList="data:dlt_native" style="height:200px;width:600px;" drawType="native" autoFit="allColumn" readOnly="true">
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column id="hCol1" width="200" value="항목1"></w2:column>
						<w2:column id="hCol2" width="200" value="항목2"></w2:column>
						<w2:column id="hCol3" width="200" value="항목3"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="COL1" width="200" inputType="text"></w2:column>
						<w2:column id="COL2" width="200" inputType="text"></w2:column>
						<w2:column id="COL3" width="200" inputType="text"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<w2:textbox id="tbx_title2" label="drawType=virtual (비교용)" style="font-weight:bold;margin-top:20px;margin-bottom:5px;" tagname="h3"></w2:textbox>
			<w2:gridView id="grd_virtual" dataList="data:dlt_virtual" style="height:200px;width:600px;" autoFit="allColumn" readOnly="true">
				<w2:header id="header2">
					<w2:row id="row3">
						<w2:column id="hCol4" width="200" value="항목1"></w2:column>
						<w2:column id="hCol5" width="200" value="항목2"></w2:column>
						<w2:column id="hCol6" width="200" value="항목3"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody2">
					<w2:row id="row4">
						<w2:column id="COL1" width="200" inputType="text"></w2:column>
						<w2:column id="COL2" width="200" inputType="text"></w2:column>
						<w2:column id="COL3" width="200" inputType="text"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
