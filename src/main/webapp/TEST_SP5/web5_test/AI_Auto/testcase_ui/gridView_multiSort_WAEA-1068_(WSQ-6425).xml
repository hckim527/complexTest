<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="dept"  name="부서"   dataType="text"/>
                        <w2:column id="rank"  name="직급"   dataType="text"/>
                        <w2:column id="name"  name="이름"   dataType="text"/>
                        <w2:column id="score" name="평가점수" dataType="number"/>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:mfeSubmission/>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    dataList1.setJSON([
        {"dept":"개발팀",   "rank":"과장", "name":"홍길동", "score":88},
        {"dept":"개발팀",   "rank":"대리", "name":"김철수", "score":92},
        {"dept":"개발팀",   "rank":"과장", "name":"이영희", "score":75},
        {"dept":"영업팀",   "rank":"차장", "name":"박민수", "score":81},
        {"dept":"영업팀",   "rank":"대리", "name":"최지우", "score":95},
        {"dept":"영업팀",   "rank":"차장", "name":"정우성", "score":81},
        {"dept":"기술지원팀","rank":"과장", "name":"강호동", "score":70},
        {"dept":"기술지원팀","rank":"대리", "name":"유재석", "score":88}
    ]);
};
]]></script>
        <style type="text/css"><![CDATA[
.guide { display:block; margin:10px 10px 4px; color:#0a7; font-size:13px; line-height:1.5; }
.btns  { margin:10px; }
]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">

        <w2:textbox id="guide1" class="guide" style=""
            label='multiSort(다중 컬럼 정렬) 샘플. 헤더를 클릭하면 해당 컬럼으로 정렬되고, Ctrl+클릭으로 2차·3차 정렬 컬럼을 추가하면 헤더에 정렬 순번(1,2,3...)이 표시됩니다.'/>

        <w2:textbox id="testMethod" class="guide" style=""
            label='[테스트 방법] 1) 부서 헤더 클릭 → 부서 오름차순 정렬  2) 평가점수 헤더를 Ctrl+클릭 → 부서 정렬을 유지한 채 점수로 2차 정렬(헤더에 1,2 순번 표시)  3) 이름 헤더를 Ctrl+클릭 → 3차 정렬 추가(1,2,3)  4) Ctrl 없이 헤더 클릭 → 단일 정렬로 초기화'/>

        <w2:gridView id="gridView1" dataList="dataList1"
            sortable="true" preventMultisort="false" useCtrlOnMultisort="true"
            style="width:600px;height:260px;margin:10px;"
            applyAllColumnStyle="false" scrollByColumn="false" multiSortReverse="true">
            <w2:header id="header1">
                <w2:row id="hrow1">
                    <w2:column id="hDept"  inputType="text" width="150" value="부서"/>
                    <w2:column id="hRank"  inputType="text" width="120" value="직급"/>
                    <w2:column id="hName"  inputType="text" width="150" value="이름"/>
                    <w2:column id="hScore" inputType="text" width="150" value="평가점수"/>
                </w2:row>
            </w2:header>
            <w2:gBody id="gBody1">
                <w2:row id="brow1">
                    <w2:column id="dept"  inputType="text" width="150" displayMode="label"/>
                    <w2:column id="rank"  inputType="text" width="120" displayMode="label"/>
                    <w2:column id="name"  inputType="text" width="150" displayMode="label"/>
                    <w2:column id="score" inputType="text" width="150" displayMode="label" displayFormat="#,##0" dataType="number" textAlign="right"/>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
    </body>
</html>
