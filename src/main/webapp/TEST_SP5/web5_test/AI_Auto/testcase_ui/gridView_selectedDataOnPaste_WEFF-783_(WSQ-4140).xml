        "label": "label5label5label5label5label5label5label5label5label5label5label5label5",
        "value": "value5value5value5value5value5"
    }];
    dl_combo.setJSON(comboJSON);
    comboJSON = [{
        "label2": "22label1",
        "value2": "22value1"
    }, {
        "label2": "22label2",
        "value2": "22value2"
    }, {
        "label2": "22label3",
        "value2": "22value3"
    }, {
        "label2": "22label4",
        "value2": "22value4"
    }];
    dl_combo2.setJSON(comboJSON);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    var obj = {
        "nodeset": "data:dl_combo2",
        "label": "label2",
        "value": "value2",
        "width": 400,
        "height": 120,
        "visibleRowNum": "5",
        "rowNumVisible": true,
        "autoFit": "lastColumn",
        "item": [{
            "ref": "label2",
            "header": "LABEL22"
        }, {
            "ref": "value2",
            "header": "VALUE22"
        }]
    };
    gridView1.setColumnGridItemset("col1", obj);
};
scwin.cusFormatter = function(v, fv, row, col) {
    //debugger;
    fv = "<s>" + fv + "</s>";
    return fv;
};
scwin.gridView1_onviewchange = function(info) {
    console.log("gv1 info: ", info);
};
scwin.gridView2_onviewchange = function(info) {
    console.log("gv2 info: ", info);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
