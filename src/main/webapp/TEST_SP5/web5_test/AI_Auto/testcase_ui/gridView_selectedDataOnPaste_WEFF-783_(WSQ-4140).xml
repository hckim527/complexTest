    //dataList1.insertRow();
    var comboJSON = [{
        "label": "<s>label1</s>",
        "value": "value1"
    }, {
        "label": "<font color='red'>label2</font>",
        "value": "value2"
    }, {
        "label": "<strong>label3</strong>",
        "value": "value3"
    }, {
        "label": "label4",
        "value": "value4"
    }];
    comboJSON = [{
        "label": "label1",
        "value": "value1"
    }, {
        "label": "label2",
        "value": "value2"
    }, {
        "label": "label3",
        "value": "value3"
    }, {
        "label": "label4",
