        </w2:workflowCollection>
    </xf:model>
    <w2:layoutInfo />
    <w2:publicInfo method="" />
    <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    acb_matched.setValue("apple");
    acb_hidden.setValue("apple");
    acb_all.setValue("apple");
    acb_gridView.setValue("apple");
};

scwin.acb_matched_onviewchange = function () {
    txt_matched_result.setValue("label: " + acb_matched.getText() + " / value: " + acb_matched.getValue());
};

scwin.acb_hidden_onviewchange = function () {
    txt_hidden_result.setValue("label: " + acb_hidden.getText() + " / value: " + acb_hidden.getValue());
};

scwin.acb_all_onviewchange = function () {
    txt_all_result.setValue("label: " + acb_all.getText() + " / value: " + acb_all.getValue());
};

scwin.acb_gridView_onviewchange = function () {
    txt_gridView_result.setValue("label: " + acb_gridView.getText() + " / value: " + acb_gridView.getValue());
};
    ]]></script>
</head>
<body ev:onpageload="scwin.onpageload">
    <xf:group class="sub_contents" id="" style="padding:20px;">
        <xf:group style="margin-bottom:24px;">
            <w2:textbox style="font-weight:bold;font-size:14px;" label='listModeOnFocus="showMatched" (기본값, 미지정과 동일)' />
            <w2:textbox style="font-size:12px;color:#888;display:block;margin:4px 0 8px 0;" label="편집 모드 진입 시 현재 선택값으로 필터링된 목록만 노출" />
            <w2:autoComplete id="acb_matched"
                             style="width:240px;height:35px;"
                             submenuSize="auto"
                             noResult="previous"
                             listModeOnFocus=""
                             ev:onviewchange="scwin.acb_matched_onviewchange">
                <w2:choices>
                    <w2:itemset nodeset="data:dlt_fruits">
                        <w2:label ref="label"></w2:label>
                        <w2:value ref="value"></w2:value>
                    </w2:itemset>
                </w2:choices>
            </w2:autoComplete>
            <w2:textbox id="txt_matched_result" style="color:#0a6;display:block;margin-top:6px;" />
        </xf:group>
        <xf:group style="margin-bottom:24px;">
            <w2:textbox style="font-weight:bold;font-size:14px;" label='listModeOnFocus="hide" (기존 hideListOnFocus="true" 와 동일)' />
            <w2:textbox style="font-size:12px;color:#888;display:block;margin:4px 0 8px 0;" label="편집 모드 진입 시 목록 펼치지 않음 (드롭다운 버튼 클릭 시에만 펼쳐짐)" />
            <w2:autoComplete id="acb_hidden"
                             style="width:240px;height:35px;"
                             submenuSize="auto"
                             noResult="previous"
                             listModeOnFocus="hide"
                             ev:onviewchange="scwin.acb_hidden_onviewchange">
                <w2:choices>
                    <w2:itemset nodeset="data:dlt_fruits">
                        <w2:label ref="label"></w2:label>
                        <w2:value ref="value"></w2:value>
                    </w2:itemset>
                </w2:choices>
            </w2:autoComplete>
            <w2:textbox id="txt_hidden_result" style="color:#0a6;display:block;margin-top:6px;" />
        </xf:group>
        <xf:group style="margin-bottom:24px;">
            <w2:textbox style="font-weight:bold;font-size:14px;" label='listModeOnFocus="showAll" (신규)' />
            <w2:textbox style="font-size:12px;color:#888;display:block;margin:4px 0 8px 0;" label="편집 모드 진입 시 전체 목록 노출 → 입력 시작하면 필터링된 목록으로 전환" />
            <w2:autoComplete id="acb_all"
                             style="width:240px;height:35px;"
                             submenuSize="auto"
                             noResult="previous"
                             listModeOnFocus="showAll"
                             ev:onviewchange="scwin.acb_all_onviewchange">
                <w2:choices>
                    <w2:itemset nodeset="data:dlt_fruits">
                        <w2:label ref="label"></w2:label>
                        <w2:value ref="value"></w2:value>
                    </w2:itemset>
                </w2:choices>
            </w2:autoComplete>
            <w2:textbox id="txt_all_result" style="color:#0a6;display:block;margin-top:6px;" />
        </xf:group>
        <xf:group style="margin-bottom:24px;">
            <w2:textbox style="font-weight:bold;font-size:14px;" label='itemTableMode="gridView" + listModeOnFocus="showAll"' />
            <w2:textbox style="font-size:12px;color:#888;display:block;margin:4px 0 8px 0;" label='gridViewItemset 사용 시 itemTableMode="gridView"가 됨. setGridViewData가 viewArr를 사용하므로 showAll이 grid 모드에서도 정상 동작.' />
            <w2:autoComplete id="acb_gridView"
                             style="width:240px;height:35px;"
                             submenuSize="auto"
                             noResult="previous"
                             listModeOnFocus="showAll"
                             ev:onviewchange="scwin.acb_gridView_onviewchange">
                <w2:choices>
                    <w2:gridViewItemset nodeset="data:dlt_fruits"
                                        label="label" value="value"
                                        width="240" height="200"
                                        autoFit="" hideHeader="false"
                                        rowMouseOver="" selectedRowColor=""
                                        rowMouseOverColor="" visibleRowNum="6">
                        <w2:item ref="label" header="이름" style="text-align:left;width:120px;" headerStyle="text-align:center;"></w2:item>
                        <w2:item ref="value" header="값" style="text-align:left;width:120px;" headerStyle="text-align:center;"></w2:item>
                    </w2:gridViewItemset>
                </w2:choices>
            </w2:autoComplete>
            <w2:textbox id="txt_gridView_result" style="color:#0a6;display:block;margin-top:6px;" />
        </xf:group>
    </xf:group>
</body>
</html>
