<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[ 
scwin.button1_onclick = function (e) {
    searchbox1.trigger("onclick");
};

scwin.searchbox1_onclick = function (e) {
    console.log("searchbox1_onclick");
};

scwin.button2_onclick = function (e) {
    input1.trigger("onclick");
};

scwin.input1_onclick = function (e) {
    console.log("input1_onclick");
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:searchbox id="searchbox1" style="width: 150px;height: 21px;" ev:onclick="scwin.searchbox1_onclick"></w2:searchbox>
    	<w2:button style="" id="button1" label="trigger" ev:onclick="scwin.button1_onclick"></w2:button>
    	<xf:input id="input1" style="width: 144px;height: 21px;" ev:onclick="scwin.input1_onclick"></xf:input>
    	<w2:button ev:onclick="scwin.button2_onclick" id="button2" label="trigger" style=""></w2:button>
    </body>
</html>
