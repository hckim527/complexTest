    dataList1.insertRow();
};
scwin.onpageunload = function() {};
scwin.gridView1_onviewchange = function(info) {
    console.log("gridView1_onviewchange");
};
scwin.gridView1_onrowindexchange = function(row, oldRow) {
    console.log("gridView1_onrowindexchange");
};
