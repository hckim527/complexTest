};


scwin.dataTypeFormatter = function (obj, chartType, id) { //와 같이 설정 하면 됩니다. 파라미터 정보로 차트ID, 차트 객체, 차트 Type등을 넘겨줍니다
	
	if (chartType === "MSLine") {	
		if(obj['categories'][0]['category'][0].label.indexOf("/") < 0) { //이미 / 로 세팅한건지 확인
			for (var i = 0; i < obj['categories'][0]['category'].length; i++) {
				obj['categories'][0]['category'][i].label = obj['categories'][0]['category'][i].label.substr(4, 2) + '/' + obj['categories'][0]['category'][i].label.substr(6, 2)
			}

		}
		
		return obj;
	}
};

