<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/contents.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:data>
            			<w2:row></w2:row>
            		</w2:data>
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    var jsonData = [{
            "col1": "1"
        },
        {
            "col1": "2"
        },
        {
            "col1": "3"
        },
        {
            "col1": "4"
        },
        {
            "col1": "5"
        },
        {
            "col1": "6"
        },
        {
            "col1": "7"
        },
        {
            "col1": "8"
        },
        {
            "col1": "9"
        },
        {
            "col1": "10"
        },
        {
            "col1": "11"
        }
    ];
    dataList1.setJSON(jsonData);
}
scwin.onpageload = function() {
    scwin.init();
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList1" summaryAuto="false" groupbyZone="true" groupbyFilterBox="true"
    		applyAllColumnStyle="false" scrollByColumn="false"
    		defaultCellHeight="20" scrollByColumnAdaptive="false" id=""
    		style="position: relative;width:239px;height:252px;"
    		ignoreCellClick="false" syncScroll="false"
    		ignoreToggleOnDisabled="false" summaryOnlyAuto="false"
    		useShiftKey="true">
    		<w2:caption id="caption1" style=""
    			value="this is a grid caption.">
    		</w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5" style=""
    					inputType="text" width="70" value="name1"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style=""
    					inputType="text" width="70" value="name2"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1" style=""
    					width="70" inputType="text" value="name3"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style=""
    					inputType="text" width="70" value="" displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" style=""
    					inputType="text" width="70" value="" displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" style=""
    					width="70" inputType="text" value="" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 