				* //property handling
				*
				* //event trigger
				*/

				udc_obj.getSomething= function(){
					return "THIS IS WHAT YOU GET";
				};
				this.getSomething2 = function() {
					return "THIS IS WHAT YOU GET2";
				};
				this.newInsertChild = function() {
					var index1 = generator1.insert();
					var index2 = generator1.insert();
					var input1 = generator1.getChild(index1, "input1");
					var input2 = generator1.getChild(index2, "input1");
					input1.setValue(input1.id);
					input2.setValue(input2.id);
				}
                this.functionA = function() {
                    alert("THIS IS CALLED FROM UDC2_gen!!");
                    udc2AlertShowed = true;
                }

			]]></script>
