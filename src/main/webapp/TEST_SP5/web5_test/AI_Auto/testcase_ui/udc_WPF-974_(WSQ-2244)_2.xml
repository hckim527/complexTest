    	<xf:group id="group1" style="position: relative;width:350px;height:200px;" class="" pluginName="UDC2_gen">
    		<w2:generator id="generator1" style="position: relative;width: 350px;height: 100px;">
        		<xf:group id="group2" style="height:46px;">
                    <w2:textbox id="textbox1" style="position: relative;width: 150px;height: 23px;" label="test">
        				<script ev:event="onclick(e)" type="javascript"><![CDATA[
        					alert(udc_obj.getSomething());
        					console.log(this.id);
        				 ]]></script>
        			</w2:textbox>
                    <xf:input id="input1" style="position: relative;width:350px;height:21px;">
