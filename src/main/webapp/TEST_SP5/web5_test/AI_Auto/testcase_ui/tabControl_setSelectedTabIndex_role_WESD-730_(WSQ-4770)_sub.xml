						<w2:column id="athrnV" name="!~temp,확인~!" dataType="text"></w2:column>
						<w2:column id="athrnM" name="!~temp,관리~!" dataType="text"></w2:column>
						<w2:column id="menuLvl" name="!~temp,메뉴레벨~!" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<!-- 목록 DataList 정의 End -->
				<!-- 검색 DataMap 정의 Start -->
				<w2:dataMap baseNode="map" id="dma_01">
					<w2:keyInfo>
						<w2:key id="roleNm" name="!~temp,역할~!" dataType="text"></w2:key>
