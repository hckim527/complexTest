        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
};

scwin.selectbox_customFormatter = function(itemList){
    var retitemList = itemList;
    for(var i=0;i<retitemList.length;i++){
        retitemList[i].label = retitemList[i].label + "_format";
    }
    return retitemList;
}

scwin.checkcombobox_customFormatter = function(itemList){
    var retitemList = itemList;
    for(var i=0;i<retitemList.length;i++){
        retitemList[i].label = retitemList[i].label + "_format";
    }
    return retitemList;
}


]]></script>
