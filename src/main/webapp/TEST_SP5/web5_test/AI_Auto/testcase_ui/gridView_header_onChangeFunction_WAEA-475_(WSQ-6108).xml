<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="452">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var jsonData = [{col1:"a1"},{col1:"a2"},{col1:"a3"},{col1:"a4"}]
		dataList1.setJSON(jsonData);
	};
	
	scwin.onpageunload = function() {
		
	};
	
	scwin.selectOnChangeFunction = function(value, colId, headerId){
        console.log("value = " + value + ", colId = " + colId );
    };]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView id="" style="width: 500px;height: 150px;" checkAllType="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" dataList="data:dataList1">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="select" style="height:20px" id="column5" value="name1" displayMode="label" allOption=""
    					chooseOption="" ref="" onChangeFunction="scwin.selectOnChangeFunction">
    					<w2:choices>
    						<w2:item>
    							<w2:label><![CDATA[a]]></w2:label>
    							<w2:value><![CDATA[va]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[b]]></w2:label>
    							<w2:value><![CDATA[vb]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[c]]></w2:label>
    							<w2:value><![CDATA[vc]]></w2:value>
    						</w2:item>
    					</w2:choices>
    				</w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
