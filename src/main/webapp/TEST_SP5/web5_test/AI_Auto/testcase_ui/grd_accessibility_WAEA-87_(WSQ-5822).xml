<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate />
        <xf:model>
            <xf:instance>
                <data xmlns="">

                </data>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                        <w2:column id="col5" name="name5" dataType="text"></w2:column>
                        <w2:column id="col6" name="name6" dataType="text"></w2:column>
                        <w2:column id="col7" name="name7" dataType="text"></w2:column>
                        <w2:column id="col8" name="name8" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="label" name="name1" dataType="text"></w2:column>
                        <w2:column id="value" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
        
    scwin.onpageload = function() {

        dataList2.setJSON([{label:"a", value:"a"},{label:"b", value:"b"}])

        var jsonData = [{col1:"a",col2:"a1",col3:"false", col4:"true"}
                        ,{col1:"a",col2:"a2",col3:"false", col4:"true"}
                        ,{col1:"a",col2:"a3",col3:"false", col4:"true"}
                        ,{col1:"a",col2:"a4",col3:"false", col4:"true"}
                        ,{col1:"a",col2:"a5",col3:"false", col4:"true"}
                        ,{col1:"b",col2:"b1",col3:"false", col4:"true"}
                        ,{col1:"b",col2:"b3",col3:"false", col4:"true"}
                        ,{col1:"c",col2:"c1",col3:"false", col4:"true"}
                        ,{col1:"c",col2:"c2",col3:"false", col4:"true"}
                        ,{col1:"c",col2:"c3",col3:"false", col4:"true"}
                        ,{col1:"d",col2:"d1",col3:"false", col4:"true"}
                        ,{col1:"d",col2:"d2",col3:"false", col4:"true"}
                        ,{col1:"d",col2:"d3",col3:"false", col4:"true"}];
        dataList1.setJSON(jsonData);

    };
    
    ]]></script>
        <style type="text/css"><![CDATA[
            
         ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">


        <w2:gridView id="gridView1" style="width: 500px;height: 400px;" checkAllType="false" scrollByColumn="false" defaultCellHeight="20" autoFit="allColumn" 
            readOnly="true" 

            accessibility="true"
            senseReader="true"
            focusMove="false"
            keyMoveEditMode="true"
            captionAuto="true"
            autoResizeEmbeddedInput="true"
            sortHeaderDiv="true"
            scrollFocus="true"
            titleAuto="true"
            applyScopeHeaders="true"

            scrollByColumnAdaptive="false" dataList="data:dataList1">
            <w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
            <w2:header style="" id="header2">
                <w2:row style="" id="row3">
                    <w2:column width="70" inputType="text" style="height:20px" id="column1" value="radio" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column2" value="1" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column3" value="2" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column4" value="select" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column5" value="disabled" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column6" value="hidden1" hidden="true" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column7" value="hidden2" hidden="true" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column8" value="hidden3" hidden="true" displayMode="label"></w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody style="" id="gBody2">
                <w2:row style="" id="row4">
                    <w2:column width="70" inputType="radio" radioLabel="aaa" style="height:20px" id="col1" value="" displayMode="label" ></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="select" style="height:20px" id="col4" value="false" displayMode="label">
                        <w2:choices>
                            <w2:itemset nodeset="data:dataList2">
                                <w2:label ref="label"></w2:label>
                                <w2:value ref="value"></w2:value>
                            </w2:itemset>
                        </w2:choices>
                    </w2:column>
                    <w2:column width="70" inputType="button" disabled="true" style="height:20px" id="col5" value="button" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="col6" value="hidden1" hidden="true" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="col7" value="hidden2" hidden="true" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="col8" value="hidden3" hidden="true" displayMode="label"></w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>


        <w2:gridView id="gridView2" style="width: 500px;height: 400px;" checkAllType="false" scrollByColumn="false" defaultCellHeight="20" autoFit="allColumn" 
            readOnly="true" 

            accessibility="true"
            senseReader="true"
            focusMove="false"
            keyMoveEditMode="true"
            captionAuto="true"
            autoResizeEmbeddedInput="true"
            sortHeaderDiv="true"
            scrollFocus="true"
            titleAuto="true"
            applyScopeHeaders="true"

            scrollByColumnAdaptive="false" dataList="data:dataList1">
            <w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
            <w2:header style="" id="header2">
                <w2:row style="" id="row3">
                    <w2:column width="70" inputType="text" style="height:20px" id="column1" value="radio" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column2" value="readOnly" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column3" value="2" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column4" value="select" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column5" value="readOnly" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column6" value="hidden1" hidden="true" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column7" value="hidden2" hidden="true" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="column8" value="hidden3" hidden="true" displayMode="label"></w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody style="" id="gBody2">
                <w2:row style="" id="row4">
                    <w2:column width="70" inputType="radio" radioLabel="aaa" style="height:20px" id="col1" value="" displayMode="label" ></w2:column>
                    <w2:column width="70" inputType="button" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="select" style="height:20px" id="col4" value="false" displayMode="label">
                        <w2:choices>
                            <w2:itemset nodeset="data:dataList2">
                                <w2:label ref="label"></w2:label>
                                <w2:value ref="value"></w2:value>
                            </w2:itemset>
                        </w2:choices>
                    </w2:column>
                    <w2:column width="70" inputType="button" readOnly="true" style="height:20px" id="col5" value="button" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="col6" value="hidden1" hidden="true" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="col7" value="hidden2" hidden="true" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="height:20px" id="col8" value="hidden3" hidden="true" displayMode="label"></w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>

    </body>
</html>
