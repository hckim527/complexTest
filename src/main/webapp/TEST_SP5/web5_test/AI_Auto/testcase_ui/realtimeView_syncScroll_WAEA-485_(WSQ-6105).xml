        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	//fpsSelect.setValue(10);
	//scwin.generateSampleData();
};
scwin.fpsSelect_onchange = function(info) {
	// FPS 설정
	var fps = parseInt(info.newValue);
	realtimeView1.setTargetFps(fps);

	// UI 업데이트
	//targetFpsText.setLabel(fps === 0 ? '제한없음' : fps);
}
scwin.generateSampleData = function() {
	var basePrice = 56000; // 기준 체결가
	var data = [];
	var exchangeTypes = ["KRX", "NXT"];

	for (var i = 0; i < 3; i++) {
		var price = basePrice + (Math.random() - 0.5) * 1000;        // 체결가
		var prevPrice = price + (Math.random() - 0.5) * 500;         // 전일가
		var change = price - prevPrice;                              // 등락폭
		var changeRate = (change / prevPrice) * 100;                 // 등락률 %

		// Raw 데이터로 변경 - 포매팅은 realtimeView에서 자동으로 처리
		var date = new Date();
		data.push({
			time: date.getHours().toString().padStart(2, '0') + 
				  date.getMinutes().toString().padStart(2, '0') + 
				  date.getSeconds().toString().padStart(2, '0'),               // HHmmss 형태의 raw 시간
			price: Math.round(price),                                           // 숫자 그대로
			changeAmountIcon: "",                                               // 아이콘용 빈 데이터
			changeAmount: Math.round(change),                                   // 숫자 그대로
			changeRate: parseFloat(changeRate.toFixed(2)),                      // 숫자 그대로
			volume: Math.floor(Math.random() * 1000),                          // 숫자 그대로
			tradeVolume: Math.floor(Math.random() * 30000000),                 // 숫자 그대로
			exchange: exchangeTypes[Math.floor(Math.random() * 2)]             // 텍스트 그대로
		});
	}

	// 데이터 삽입
	dataList1.insertJSON(0, data);
	dataList2.insertJSON(0, data);
	//dataList1.setJSON(data);
	//dataList1.setCellData(1, "exchange", "TEST");
	//dataList1.setRowJSON(1, {"time": 111111, "price":22222});
	

	// 현재 행 개수 확인
	var cnt = dataList1.getRowCount();

	// 최대 50개까지만 유지
	var maxRows = 50;
	if (cnt > maxRows) {
		var excess = cnt - maxRows;
		var rowsToRemove = [];
		for (var i = 0; i < excess; i++) {
			rowsToRemove.push(cnt - 1 - i); // 끝에서부터 제거
		}
		dataList1.removeRows(rowsToRemove);
		dataList2.removeRows(rowsToRemove);
	}
	//dataList1.removeRows([0,1]);
	//dataList1.removeRow(1);
	//dataList1.removeAll();
	
	// 스타일 적용 함수
	scwin.setStyle1();	
	scwin.setStyle2();

	realtimeView1.redraw();
	realtimeView2.redraw();
};
scwin.setStyle1 = function() {
	for (var i = 0; i < 3; i++) {

		// 3: 등락폭 (오른쪽 정렬로 변경)
		var changeVal = parseInt(dataList1.getCellData(i, "changeAmount"));
		if (changeVal > 0) {
			// 상승
			realtimeView1.setCellStyle(i, "changeAmount", "color", "red");
			//realtimeView1.setCellStyle(i, "changeAmountIcon", "background-image", "url('/ai_dev/cline/bg/bg-up.svg') no-repeat left center");
		} else if (changeVal < 0) {
			// 하락
			realtimeView1.setCellStyle(i, "changeAmount", "color", "blue");
			//realtimeView1.setCellStyle(i, "changeAmountIcon", "background-image", "url('/ai_dev/cline/bg/bg-down.svg') no-repeat left center");
		}

		// 4: 등락률
		realtimeView1.setCellStyle(i, "changeRate", "color", changeVal > 0 ? "red" : (changeVal < 0 ? "blue" : "black"));

	}
}
scwin.setStyle2 = function() {
	for (var i = 0; i < 3; i++) {

		// 3: 등락폭 (오른쪽 정렬로 변경)
		var changeVal = parseInt(dataList2.getCellData(i, "changeAmount"));
		if (changeVal > 0) {
			// 상승
			realtimeView2.setCellStyle(i, "changeAmount", "color", "red");
			//realtimeView2.setCellStyle(i, "changeAmountIcon", "background-image", "url('/ai_dev/cline/bg/bg-up.svg') no-repeat left center");
		} else if (changeVal < 0) {
			// 하락
			realtimeView2.setCellStyle(i, "changeAmount", "color", "blue");
			//realtimeView2.setCellStyle(i, "changeAmountIcon", "background-image", "url('/ai_dev/cline/bg/bg-down.svg') no-repeat left center");
		}

		// 4: 등락률
		realtimeView2.setCellStyle(i, "changeRate", "color", changeVal > 0 ? "red" : (changeVal < 0 ? "blue" : "black"));

	}
}

scwin.formatChangeRate = function(rate) {
    var numRate = parseFloat(rate);
    if (isNaN(numRate)) return "0.00%";

    // -0.00% 방지
    if (Math.abs(numRate) < 0.005) numRate = 0;

    return (numRate > 0 ? "+" : (numRate < 0 ? "" : "")) + numRate.toFixed(2) + "%";
};
scwin.start = function() {
	statusText.setLabel('실행 중');

	//scwin.generateSampleData();
	
	// updateInterval 설정 → setJSON() 호출 주기적으로 실행
	scwin.updateInterval = setInterval(() => {
		scwin.generateSampleData();
		
		// UI 업데이트
		var fps = realtimeView1.fps;
		//fpsText.setLabel(fps === 0 ? '제한없음' : fps);
	}, 1000);
}
scwin.stop = function() {
	statusText.setLabel('중지');
	
	if (scwin.updateInterval) {
		clearInterval(scwin.updateInterval);
		scwin.updateInterval = null;
	}
}
scwin.clear = function() {
	realtimeView1.clear(); // 모든 데이터를 초기화하고 최초 상태로 되돌림
}

scwin.importantTest = function() {
	// 첫번째 컬럼 purple 색이 입혀져야 함
	realtimeView1.setCellStyle(0, "time", "color", "orange");
	realtimeView1.setCellStyle(0, "time", "color", "purple !important");
	
	// 화면에 반영
	realtimeView1.redraw();
}

// requestAnimationFrame을 사용한 실시간 업데이트 함수들
scwin.start2 = function() {
	statusText.setLabel('실행 중');
	
	// 이전 애니메이션이 실행 중이면 중지
	if (scwin.animationId) {
		cancelAnimationFrame(scwin.animationId);
	}
	
	// requestAnimationFrame 루프 시작
	scwin.animationLoop();

	//scwin.generateSampleData();
}

scwin.stop2 = function() {
	statusText.setLabel('중지');
	
	if (scwin.animationId) {
		cancelAnimationFrame(scwin.animationId);
		scwin.animationId = null;
	}
}

scwin.animationLoop = function() {
	scwin.generateSampleData();
	
	// UI 업데이트
	var fps = realtimeView1.fps;
	//fpsText.setLabel(fps === 0 ? '제한없음' : fps);
	
	// 다음 프레임 요청
	scwin.animationId = requestAnimationFrame(scwin.animationLoop);
}

scwin.excelTest = function() {
	var options = {};
	options.fileName = "canvas0804_useDataFormatUseStyle.xlsx";
	options.useDataFormat = true;
	options.useStyle = true;
	options.removeColumns = ['2'];
	realtimeView1.advancedExcelDownload(options);
}
]]></script>

