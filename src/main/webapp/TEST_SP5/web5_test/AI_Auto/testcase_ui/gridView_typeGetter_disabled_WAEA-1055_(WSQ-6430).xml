		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {
    /*
    내용 :
     gridview에서 drilldown 컬럼이 있을 때 inputType:custom, typeGetter를 사용하는 경우
    button에 대한 disable 이 이상동작

    재현방법 :
    1.1 typeGetter에서 특정컬럼(col5)의 값에 따라 버튼의 disable을 바꾸는 경우
    1.2 drilldown 항목을 최소화 했을 때(a, b, c값 최소화) e항목 disabled 확인

    기대동작 :
     col5의 값이 1이기 때문에 버튼01이 disabled false 인 상태로 노출

    현재동작 :
     col5의 값이 1이지만 버튼01이 disabled true 인 상태로 노출
    (전체가 펼쳐져 있을 때는 정상동작)

    엔진버전 :
    Websquare AI Engine v6.0.0
    6.0_0.1485B.20260226.161523_1.8
    hotfix WAEA_746 적용 상태    
    */
    gridView1.refresh();
};

scwin.col4_typeGetter = function (info) {

    var rowData = dataList1.getRowJSON(info.realRowIndex);
    
    var returnInfo;
    if(rowData.col5 == "1"){
        returnInfo = {
            id: "button_" + info.realRowIndex + "_" + info.colIndex + "_1",
            inputType: "button",
            value:"버튼01",
            options: {disabled:false }
        }
    }else{
        returnInfo = {
            id: "button_" + info.realRowIndex + "_" + info.colIndex + "_2",
            inputType: "button",
            value:"버튼02",
            options: {disabled:true }
        }
    }
    return returnInfo; 
};
]]></script>
