<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[2]]></col1>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.btn_getChildren_onclick = function (e) {

    let options = { recursive : true };
    options.excludeInnerComp = false;

    let ret = WebSquare.util.getChildren(grp_test, options);

    let result = [];
    result.push("자식 수: " + ret.length);

    for (let i = 0; i < ret.length; i++) {
        result.push("[" + i + "] id: " + ret[i].getID());
    }
    console.log(result)
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group id="grp_test" style="width:572px;height:221px;background-color:silver;">
    		<w2:gridView checkAllType="false" dataList="data:dataList1" style="width: 500px;height: 150px;" id="gridView1">
    			<w2:caption style="" id="caption1" label="this is a grid caption." value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header1">
    				<w2:row style="" id="row1">
    					<w2:column width="70" style="" inputType="text" id="column1" label="header" value="name1"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column3" value="name2" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody1">
    				<w2:row style="" id="row2">
    					<w2:column ref="" chooseOption="" width="70" viewType="" style="" inputType="" id="col1" allOption=""
    						value="">
    						<w2:choices>
    							<w2:itemset nodeset="data:gdl_boolean">
    								<w2:label ref="label"></w2:label>
    								<w2:value ref="value"></w2:value>
    							</w2:itemset>
    						</w2:choices>
    					</w2:column>
    					<w2:column width="70" inputType="select" style="" id="col2" value="" displayMode="label" viewType="icon"
    						allOption="" chooseOption="" ref="">
    						<w2:choices>
    							<w2:item>
    								<w2:label><![CDATA[1]]></w2:label>
    								<w2:value><![CDATA[1]]></w2:value>
    							</w2:item>
    							<w2:item>
    								<w2:label><![CDATA[2]]></w2:label>
    								<w2:value><![CDATA[2]]></w2:value>
    							</w2:item>
    						</w2:choices>
    					</w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    	</xf:group>
    	<w2:button style="width: 80px;height: 23px;" id="btn_getChildren" label="getChildren" ev:onclick="scwin.btn_getChildren_onclick"></w2:button>
    </body>
</html>
