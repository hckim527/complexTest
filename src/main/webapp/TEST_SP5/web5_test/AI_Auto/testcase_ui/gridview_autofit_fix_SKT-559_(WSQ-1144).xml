<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            			<w2:column id="col6" name="name6" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    if (typeof scwin.onpageload === "function") {
        //scwin.onpageload();
    }
    window.data = [];
    for (var i = 0; i < 20; i++) {
        for (j = 0; j < 6; j++) {
            data.push(6 * i + j);
        }
    }
    dataList1.setData(data);
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20" id="gridView1"
    		style="position: relative;width:641px;height:316px;" fixedColumnWithHidden="true" useShiftKey="true" autoFit="allColumn"
    		rowNumVisible="true" rowStatusVisible="true" rowStatusWidth="40" rowNumWidth="40" keepDefaultColumnWidth="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column11" inputType="checkbox" width="40" value="col1" fixColumnWidth="true"></w2:column>
    				<w2:column blockSelect="false" id="column9" inputType="text" width="60" value="col2_fix" fixColumnWidth="true"></w2:column>
    				<w2:column blockSelect="false" id="column7" inputType="text" width="60" value="col3"></w2:column>
    				<w2:column blockSelect="false" id="column5" inputType="text" width="80" value="col4" hidden="true"></w2:column>
    				<w2:column blockSelect="false" id="column3" inputType="text" width="50" value="col5"></w2:column>
    				<w2:column blockSelect="false" id="column1" width="100" inputType="text" value="col6"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" inputType="checkbox" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col2" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col4" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col5" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col6" width="70" inputType="text"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 