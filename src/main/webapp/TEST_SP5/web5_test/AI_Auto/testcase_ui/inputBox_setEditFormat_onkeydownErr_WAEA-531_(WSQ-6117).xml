    /*
증상 : inputBox setEditFormat 함수 호출 시 onkeydown 미발생

재현방법
    1. inputbox에 editFormat을 설정(###-###)
    2. 화면실행 및 inputbox 선택 후 1234 입력
    3. 정상 로그 확인
    4. setEditFormat 버튼 클릭(inputbox00.setEditFormat("##_##"); 실행)
    5. inputbox 선택 후 1234 재입력
    5. 로그 확인

기대결과 : 이벤트 발생 및 로그 확인

실제결과 : 이벤트 미발생 및 로그 확인 불가

엔진버전 : 6.0_0.1349B.20250905.104222_1.8
    */

};

scwin.onpageunload = function () {
};

scwin.inputbox00_onkeydown = function (e) {
    console.log("*********inputbox00_onkeydown********** key:" + e.key)
};

scwin.trigger00_onclick = function (e) {
    inputbox00.setEditFormat("##_##");
};
]]></script>
