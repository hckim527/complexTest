<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dlt_org" repeatNode="map" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="cat1" name="category1"></w2:column>
            			<w2:column dataType="text" id="cat2" name="category2"></w2:column>
            			<w2:column dataType="text" id="label" name="display"></w2:column>
            			<w2:column dataType="text" id="value" name="code"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<cat1><![CDATA[A]]></cat1>
            				<cat2><![CDATA[A1]]></cat2>
            				<label><![CDATA[A-A1-1]]></label>
            				<value><![CDATA[AA11]]></value>
            			</w2:row>
            			<w2:row>
            				<cat1><![CDATA[A]]></cat1>
            				<cat2><![CDATA[A1]]></cat2>
            				<label><![CDATA[A-A1-2]]></label>
            				<value><![CDATA[AA12]]></value>
            			</w2:row>
            			<w2:row>
            				<cat1><![CDATA[A]]></cat1>
            				<cat2><![CDATA[A2]]></cat2>
            				<label><![CDATA[A-A2-1]]></label>
            				<value><![CDATA[AA21]]></value>
            			</w2:row>
            			<w2:row>
            				<cat1><![CDATA[A]]></cat1>
            				<cat2><![CDATA[A2]]></cat2>
            				<label><![CDATA[A-A2-2]]></label>
            				<value><![CDATA[AA22]]></value>
            			</w2:row>
            			<w2:row>
            				<cat1><![CDATA[B]]></cat1>
            				<cat2><![CDATA[B1]]></cat2>
            				<label><![CDATA[B-B1-1]]></label>
            				<value><![CDATA[BB11]]></value>
            			</w2:row>
            			<w2:row>
            				<cat1><![CDATA[B]]></cat1>
            				<cat2><![CDATA[B1]]></cat2>
            				<label><![CDATA[B-B1-2]]></label>
            				<value><![CDATA[BB12]]></value>
            			</w2:row>
            			<w2:row>
            				<cat1><![CDATA[B]]></cat1>
            				<cat2><![CDATA[B2]]></cat2>
            				<label><![CDATA[B-B2-1]]></label>
            				<value><![CDATA[BB21]]></value>
            			</w2:row>
            			<w2:row>
            				<cat1><![CDATA[B]]></cat1>
            				<cat2><![CDATA[B2]]></cat2>
            				<label><![CDATA[B-B2-2]]></label>
            				<value><![CDATA[BB22]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:linkedDataList bind="dlt_org" id="target1" style="">
            		<w2:condition type="filter"><![CDATA[cat1==ref('data:dlt_org.cat1')]]></w2:condition>
            		<w2:condition type="sort"><![CDATA[]]></w2:condition>
            	</w2:linkedDataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function() {
    // 상태 변경
    scwin.btn_insertRow_onclick();
    scwin.btn_deleteRow_onclick();
    scwin.btn_setCellData_onclick();
    scwin.btn_removeRow_onclick();

    // 원본 데이터 첫번째 행 선택
    dlt_org.setRowPosition(0);
};



scwin.btn_insertRow_onclick = function (e) {
    let insertIndex = dlt_org.insertRow();
    dlt_org.setRowData(insertIndex,["A","insert2","insert3","insert4"],true);

    insertIndex = dlt_org.insertRow();
    dlt_org.setRowData(insertIndex,["A","insert6","insert7","insert8"],true);

    insertIndex = dlt_org.insertRow();
    dlt_org.setRowData(insertIndex,["A","insert10","insert11","insert12"],true);

    dlt_org.deleteRow(insertIndex);
};



scwin.btn_deleteRow_onclick = function (e) {
    dlt_org.deleteRow(0);
};



scwin.btn_setCellData_onclick = function (e) {
    dlt_org.setCellData(2, "cat2", "change");
};



scwin.btn_removeRow_onclick = function (e) {
    dlt_org.removeRow(3);
}



scwin.btn_getInsertedData_onclick = function (e) {
    let rtn = target1.getInsertedData();

    alert(rtn);
};



scwin.btn_getInsertedJSON_onclick = function (e) {
    let rtn = target1.getInsertedJSON();
    let jsonString = JSON.stringify(rtn);

	alert(jsonString);
};



scwin.btn_getInsertedIndex_onclick = function (e) {
    let rtn = target1.getInsertedIndex();	

    alert(rtn);
};



scwin.btn_getInsertedXML_onclick = function (e) {
    let rtn = target1.getInsertedXML();
    const serializer = new XMLSerializer();
    let xmlString = serializer.serializeToString(rtn);

    alert(xmlString);	
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:textbox style="width: 150px;height: 23px;" id="" label="원본 데이터"></w2:textbox>
    	<w2:gridView syncRowPositionOption="style" rowStatusVisible="true" focusMode="row" checkAllType="false" dataList="data:dlt_org"
    		style="width:500px; height:350px;" autoFit="allColumn" id="gridView1" sortable="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" style="" inputType="text" id="column4" value="cat1"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column3" value="cat2" useFilter=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column2" value="label"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column1" value="value"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" style="" inputType="text" id="cat1" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="cat2" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="label" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="value" value=""></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox style="width: 150px;height: 23px;" id="" label="링크 데이터"></w2:textbox>
    	<w2:gridView syncRowPositionOption="style" rowStatusVisible="true" focusMode="row" checkAllType="false" dataList="data:target1"
    		style="width:500px; height:300px;" autoFit="allColumn" id="gridView2" sortable="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" style="" inputType="text" id="column4" value="cat1"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column3" value="cat2"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column2" value="label"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column1" value="value"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" style="" inputType="text" id="cat1" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="cat2" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="label" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="value" value=""></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:button ev:onclick="scwin.btn_getInsertedData_onclick" style="width:118px;height:39px;" id="btn_getInsertedData"
    		label="getInsertedData">
    	</w2:button>
    	<w2:button ev:onclick="scwin.btn_getInsertedJSON_onclick" id="btn_getInsertedJSON" label="getInsertedJSON"
    		style="width:118px;height:39px;">
    	</w2:button>
    	<w2:button ev:onclick="scwin.btn_getInsertedIndex_onclick" id="btn_getInsertedIndex" label="getInsertedIndex"
    		style="width:118px;height:39px;">
    	</w2:button>
    	<w2:button ev:onclick="scwin.btn_getInsertedXML_onclick" id="btn_getInsertedXML" label="getInsertedXML" style="width:118px;height:39px;"></w2:button>
    </body>
</html>
