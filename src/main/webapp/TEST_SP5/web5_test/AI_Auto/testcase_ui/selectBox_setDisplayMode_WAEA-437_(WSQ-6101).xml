<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

};

scwin.onpageunload = function () {

};

scwin.trigger1_onclick = function (e) {
	select1.setDisplayMode("value");
};

scwin.trigger2_onclick = function (e) {
	select1.setDisplayMode("label");
};

scwin.trigger3_onclick = function (e) {
	select1.setDisplayMode("value delim label");
};

scwin.trigger4_onclick = function (e) {
	select1.setDisplayMode("label delim value");
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:select1 id="select1" chooseOption="" style="position:absolute; top:52px; left:51px; width:148px; height:21px; "
    		submenuSize="auto" allOption="" disabled="false" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref=""
    		displayMode="value">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[1Label]]></xf:label>
    				<xf:value><![CDATA[1Value]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[2Label]]></xf:label>
    				<xf:value><![CDATA[2Value]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[3Label]]></xf:label>
    				<xf:value><![CDATA[3Value]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    	<xf:trigger type="button" id="trigger1" style="position:absolute;top:49px;left:252px;width:146px;height:23px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[value]]></xf:label>
    	</xf:trigger>
    	<xf:trigger id="trigger2"
    		style="position:absolute;top:104px;left:252px;width:147px;height:23px;" type="button" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[label]]></xf:label>
    	</xf:trigger>
    	<xf:trigger id="trigger3"
    		style="position:absolute;top:154px;left:252px;width:147px;height:23px;" type="button" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[value delim label]]></xf:label>
    	</xf:trigger>
    	<xf:trigger id="trigger4"
    		style="position:absolute;top:204px;left:252px;width:147px;height:23px;" type="button" ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[label delim value]]></xf:label>
    	</xf:trigger>
    </body>
</html>
