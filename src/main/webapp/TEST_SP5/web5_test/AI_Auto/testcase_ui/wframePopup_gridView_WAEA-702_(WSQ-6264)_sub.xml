<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            			<w2:column id="col6" name="name6" dataType="text"></w2:column>
            			<w2:column id="col7" name="name7" dataType="text"></w2:column>
            			<w2:column id="col8" name="name8" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var jsonData = [{col1:"0_col1",col2:"0_col2",col3:"0_col3",col4:"0_col4",col5:"0_col5",col6:"0_col6",col7:"0_col7",col8:"0_col8"}
        ,{col1:"1_col1",col2:"1_col2",col3:"1_col3",col4:"1_col4",col5:"1_col5",col6:"1_col6",col7:"1_col7",col8:"1_col8"}
        ,{col1:"2_col1",col2:"2_col2",col3:"2_col3",col4:"2_col4",col5:"2_col5",col6:"2_col6",col7:"2_col7",col8:"2_col8"}
        ];
		dataList1.setJSON(jsonData);
	};
	
	scwin.onpageunload = function() {
		
	};

    scwin.trigger1_onclick = function() {
        gridView1.setStyle("height", "180px");
    };

    scwin.trigger2_onclick = function() {
        gridView1.setStyle("height", "85px");
    };
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <xf:group>
            <xf:trigger type="button" style="width: 180px;height: 23px;" id="trigger1" localeRef="test" ev:onclick="scwin.trigger1_onclick">
                <xf:label><![CDATA[setStyle("height", "300px")]]></xf:label>
            </xf:trigger>
            <xf:trigger type="button" style="width: 180px;height: 23px;" id="trigger2" localeRef="test" ev:onclick="scwin.trigger2_onclick">
                <xf:label><![CDATA[setStyle("height", "85px")]]></xf:label>
            </xf:trigger>
        	<w2:gridView id="gridView1" style="width: 350px;height: 85px;" checkAllType="false" rowNumVisible="true"
        		visibleRowNum="" showLastRow="true" disabled="true"
        		keyMoveEditMode="true" moveKeyEditMode="true" moveKeyEditModeAll="true"
        		ignoreNonEditableCell="true" focusFlow="linear" columnMove="true"
        		
        		scrollByColumn="false" defaultCellHeight="20"
        		scrollByColumnAdaptive="false" dataList="data:dataList1" focusMode="row" focusMove="true" editModeEvent="onclick">
        		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
        		<w2:header style="" id="header2">
        			<w2:row style="" id="row3">
        				<w2:column width="70" inputType="text" style="height:20px" id="column1" value="name1" displayMode="label"></w2:column>
        				<w2:column width="70" inputType="text" style="height:20px" id="column2" value="name2" displayMode="label"></w2:column>
        				<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name3" displayMode="label"></w2:column>
        				<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name4" displayMode="label"></w2:column>
        			</w2:row>
                    <w2:row style="" id="row4">
                        <w2:column width="70" inputType="text" style="height:20px" id="column11" value="name11" displayMode="label"></w2:column>
                        <w2:column width="70" inputType="text" style="height:20px" id="column22" value="name22" displayMode="label"></w2:column>
                        <w2:column width="70" inputType="text" style="height:20px" id="column33" value="name33" displayMode="label"></w2:column>
                        <w2:column width="70" inputType="text" style="height:20px" id="column44" value="name44" displayMode="label"></w2:column>
                    </w2:row>
        		</w2:header>
        		<w2:gBody style="" id="gBody2">
        			<w2:row style="" id="row4">
        				<w2:column width="70" inputType="text" style="height:20px" id="col1" value="" displayMode="label"></w2:column>
        				<w2:column width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
        				<w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label" readOnly="true"></w2:column>
        				<w2:column width="70" inputType="select" style="height:20px" id="col4" value="" displayMode="label" allOption=""
        					chooseOption="" ref="">
        					<w2:choices>
        						<w2:item>
        							<w2:label><![CDATA[a1]]></w2:label>
        							<w2:value><![CDATA[a1]]></w2:value>
        						</w2:item>
        						<w2:item>
        							<w2:label><![CDATA[a2]]></w2:label>
        							<w2:value><![CDATA[a2]]></w2:value>
        						</w2:item>
        					</w2:choices>
        				</w2:column>
        			</w2:row>
        			<w2:row style="" id="row5">
        				<w2:column width="70" inputType="text" style="height:20px" id="col5" value="" displayMode="label"></w2:column>
        				<w2:column width="70" inputType="text" style="height:20px" id="col6" value="" displayMode="label"></w2:column>
        				<w2:column width="70" inputType="text" style="height:20px" id="col7" value="" displayMode="label"></w2:column>
        				<w2:column width="70" inputType="button" style="height:20px" id="col8" value="" displayMode="label"></w2:column>
        			</w2:row>
        		</w2:gBody>
        	</w2:gridView>
        </xf:group>
    </body>
</html>
