<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
        xmlns:xf="http://www.w3.org/2002/xforms">
        <head>
                <w2:type>DEFAULT</w2:type>
                <w2:buildDate />
                <xf:model>
                        <xf:instance>
                                <data xmlns="" />
                        </xf:instance>
                        <w2:dataCollection baseNode="map">
                                <w2:dataList baseNode="list" repeatNode="map" id="dlList" saveRemovedData="true">
                                        <w2:columnInfo>
                                                <w2:column id="col1" name="name1" dataType="text"></w2:column>
                                                <w2:column id="col2" name="name2" dataType="text"></w2:column>
                                                <w2:column id="col3" name="name3" dataType="text"></w2:column>
                                                <w2:column id="col4" name="name4" dataType="text"></w2:column>
                                        </w2:columnInfo>
                                </w2:dataList>
                        </w2:dataCollection>
                        <w2:workflowCollection>
                        </w2:workflowCollection>
                </xf:model>
                <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dlList.setJSON([{
        "col1": "1",
        "col2": "2"
    }, {
        "col1": "1",
        "col2": "2"
    }]);
};
scwin.onpageunload = function() {};
scwin.rowAdd_onclick = function() {
    var rowCnt = dlList.getRowCount();
    dlList.insertRow(rowCnt);
};
scwin.grdList_onviewchange = function(info) {
    console.log(info);
};

]]></script>
        </head>
        <body ev:onpageload="scwin.onpageload">
                <xf:group class="wrap" id="" style="">
                        <w2:anchor outerDiv="false" style="width: 100px;height: 23px;" id="rowAdd" ev:onclick="scwin.rowAdd_onclick">
                                <xf:label><![CDATA[row Add]]></xf:label>
                        </w2:anchor>
                        <w2:gridView id="grdList" style="width: 100%;height: 200px;" dataList="data:dlList" autoFit="none" rowStatusVisible="true"
                                class="cm_grid edit" ev:oncellclick="" ev:onrowstatusclick="scwin.gvGridList1_onrowstatusclick" ev:oneditkeyup="" ev:oneditkeydown=""
                                ev:onviewchange="scwin.grdList_onviewchange">
                                <w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
                                <w2:header style="" id="header1">
                                        <w2:row style="" id="row3">
                                                <w2:column removeBorderStyle="false" width="100" inputType="text" style="" id="column2" value="col1"
                                                        blockSelect="false" displayMode="label">
                                                </w2:column>
                                                <w2:column removeBorderStyle="false" width="100" inputType="text" style="" id="column4" value="col2"
                                                        blockSelect="false" displayMode="label">
                                                </w2:column>
                                        </w2:row>
                                </w2:header>
                                <w2:gBody style="height:20px" id="gBody1">
                                        <w2:row style="" id="row2">
                                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="col1" value="" blockSelect="false"
                                                        displayMode="label" colMerge="true">
                                                </w2:column>
                                                <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="col2" value="" blockSelect="false"
                                                        displayMode="label" colMerge="true">
                                                </w2:column>
                                        </w2:row>
                                </w2:gBody>
                        </w2:gridView>

                </xf:group>
        </body>
</html> 