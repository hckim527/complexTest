<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[가]]></col1>
            				<col2><![CDATA[T]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[1000]]></col1>
            				<col2><![CDATA[N]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[다]]></col1>
            				<col2><![CDATA[T]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
		
			
};


    
scwin.trigger1_onclick = function (e) {
    dataList2.setJSON([ { col1: "가",    col2: "T" }, { col1: "1000",  col2: "N" },  { col1: "다",    col2: "T" }]);

    for (let i = 0; i < dataList2.getRowCount(); i++) {
    if (dataList2.getCellData(i, "col2") == "T") {
        debugger;
        grd1.setCellDataType(i, "col1", "text");
        // _mf_grd_sample__col1_0_default.options.dataType 을 float 으로 바꾸지?

        grd1.setCellAllowChar(i, "col1", "가-힣a-zA-Z");
        grd1.setCellDisplayFormat(i, "col1", "");
        grd1.setCellMaxLength(i, "col1", 200);   // <-- 에러발생!
    }
}
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView checkAllType="false" defaultCellHeight="20" id="grd1" style="width: 500px;height: 150px;" dataList="data:dataList2"
    		rowNumVisible="true" rowStatusVisible="true" setCellInputTypeCustom="true">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column5" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="name3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="custom" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[]]></xf:label>
    	</xf:trigger>
    </body>
</html>
