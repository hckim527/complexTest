    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    //inputType="text", "select", "radio", "checkbox"인 경우
    //embeddedInput="true"를 적용하여 cell내부에 직접 input(또는 select,radio,checkbox)가 포함되어 그려지게 됩니다.
    //disabled, readOnly 시에는 자동으로 input을 보이지 않습니다.
    gridView1.setRowDisabled(1, true);
    gridView1.setRowReadOnly(3, true);
    //gridView1.setReadOnly(true);
}
]]></script>
    	<style type="text/css"><![CDATA[
    		/** 그리드 조회 후 입력(수정)가능한 형태 표시
			 * gridView1안에 column의 property style = heigth:25px일 경우
			 * border : 1px이면 위아래 포함 2px
			 * 25px(gridView height) - 2px(border) = 23px(heigth)
			 */
			    .w2grid .colTest1[inputtype="text"]  nobr {
			        display: block;
			        margin: 0;
			        border: 1px solid red;
			        padding: 0;
			        height: 23px; /* 25px - 2px = 23px로 설정*/
			    }
    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">
