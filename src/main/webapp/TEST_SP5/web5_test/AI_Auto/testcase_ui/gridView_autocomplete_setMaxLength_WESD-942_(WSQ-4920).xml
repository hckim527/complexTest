<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
	
    scwin.onpageload = function() {
        var jsonData2 = [{"col1":"a1","col2":"1"},{"col1":"a2","col2":"1"},{"col1":"a3","col2":"1"}];
        dataList1.setJSON( jsonData2 );
    };

    scwin.trigger1_onclick = function(e) {
        autocomplete1.setMaxLength(5);
    };

    scwin.trigger2_onclick = function(e) {
        gridView1.setMaxLength(1, 5);
    };
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <w2:autoComplete autocomplete="off" chooseOption="true" displayMode="label" editType="select" id="autoComplete1" interactionMode="" search="start" searchTarget="label"
            style="width: 162px;height: 38px;" submenuSize="auto" useKeywordHighlight="false"
            visibleRowNum="5" direction="auto">
            <w2:choices>
                <w2:item>
                    <w2:label><![CDATA[a]]></w2:label>
                    <w2:value><![CDATA[1]]></w2:value>
                </w2:item>
                <w2:item>
                    <w2:label><![CDATA[b]]></w2:label>
                    <w2:value><![CDATA[2]]></w2:value>
                </w2:item>
                <w2:item>
                    <w2:label><![CDATA[c]]></w2:label>
                    <w2:value><![CDATA[3]]></w2:value>
                </w2:item>
            </w2:choices>
        </w2:autoComplete>
    	<w2:gridView dataList="dataList1" scrollByColumn="false" summaryAuto="false" scrollByColumnAdaptive="false" id="gridView1"
            style="position: absolute ;left:21px;top:71px;width: 532px;height: 310px;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
            fixedColumnWithHidden="true" useShiftKey="true" disabledFontColor="" keyMoveEditMode="true" moveKeyEditMode="true" editModeEvent="onclick">
            <w2:header id="header1" style="">
                <w2:row id="row2" style="">
                    <w2:column blockSelect="false" id="column9" style="height:20px" inputType="text" width="70" displayMode="label"
                        value="name1">
                    </w2:column>
                    <w2:column blockSelect="false" id="column7" style="height:20px" inputType="text" width="70" displayMode="label"
                        value="name2">
                    </w2:column>
                    <w2:column blockSelect="false" id="column3" style="height:20px" width="70" inputType="text" displayMode="label"
                        value="name3">
                    </w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody id="gBody4" style="">
                <w2:row id="row5" style="">
                    <w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
                    <w2:column blockSelect="false" id="col2" style="height:20px" inputType="autoComplete" width="70" displayMode="label" maxlength="10"
                        textAlign="" chooseOption="true">
                        <w2:choices>
                            <w2:item>
                                <w2:label><![CDATA[a]]></w2:label>
                                <w2:value><![CDATA[1]]></w2:value>
                            </w2:item>
                            <w2:item>
                                <w2:label><![CDATA[b]]></w2:label>
                                <w2:value><![CDATA[2]]></w2:value>
                            </w2:item>
                            <w2:item>
                                <w2:label><![CDATA[c]]></w2:label>
                                <w2:value><![CDATA[3]]></w2:value>
                            </w2:item>
                        </w2:choices>
                    </w2:column>
                    <w2:column blockSelect="false" id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
        <xf:trigger type="button" id="trigger1" style="position: relative;width: 180px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[autoComplete setMaxLength 5]]></xf:label>
        </xf:trigger>
        <xf:trigger type="button" id="trigger2" style="position: relative;width: 180px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
            <xf:label><![CDATA[gridView col2 setMaxLength 5]]></xf:label>
        </xf:trigger>
    </body>
</html>
