         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    return false;
    var promise = common.execute("sbmSaveMenu", "/ui/template/data/com_gridView_dynamic.json", null, null, null, null);
    promise = promise.then(function(res) {
        dlTmpList1.setJSON(res.dlTmpList1);
        gvGridList1.setFocusedCell(0, 0, false);
    });
};
scwin.onpageunload = function() {};
scwin.btnCancel_onclick = function() {
    common.closePopup();
};
scwin.gvGridList2_ondatadrop2 = function(info) {
    debugger;
    // 1건씩만 핸들링(데이터 가공)
    dlTmpList3.setRowJSON(info.toRowIndex, {
        "menuCdNm": "테스트 메뉴"
    }, true);
};
scwin.dragEndFn2 = function(targetRowIndex, rowXml, info) {
    debugger;
    var xmlStr = WebSquare.xml.serialize(rowXml);
    var jsonStr = WebSquare.json.XML2JSONString(xmlStr);
    var jsonObj = JSON.parse(jsonStr);
    if (dlTmpList4.getRowCount() <= targetRowIndex) {
        dlTmpList4.setRowJSON(targetRowIndex, jsonObj, false);
    } else {
        dlTmpList4.setRowJSON(targetRowIndex, jsonObj, true);
    }
    return false;
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    /* 팝업닫기 */
    /* 이벤트 사용 */
    /* 프로퍼티 */
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
