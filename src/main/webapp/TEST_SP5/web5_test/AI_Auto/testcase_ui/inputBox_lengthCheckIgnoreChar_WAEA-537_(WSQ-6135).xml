<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
                <w2:dataMap baseNode="map" id="dataMap1">
                    <w2:keyInfo>
                        <w2:key id="key1" name="name1" dataType="text"></w2:key>
                        <w2:key id="key2" name="name2" dataType="text"></w2:key>
                        <w2:key id="key3" name="name3" dataType="text"></w2:key>
                    </w2:keyInfo>
                    <w2:data use="true">
                        <key1><![CDATA[+12345]]></key1>
                        <key2><![CDATA[+12345]]></key2>
                    </w2:data>
                </w2:dataMap>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

	scwin.onpageload = function() {


	};
	
	scwin.onpageunload = function() {
		
	};
	

	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <w2:textbox class="" label="maxLength=5.2 &lt;br&gt;autoDecimalPoint=true &lt;br&gt;lengthCheckIgnoreChar='+-'" style="position: relative;width: 518px;height: 30px;" tagname="h3" escape="false"></w2:textbox>
    	<xf:input adjustMaxLength="false" id="input1" style="position: relative;width: 218px;height: 45px; margin-top: 10px;" ref="data:dataMap1.key1" dataType="float" 
            autoFocus="true" nextTabID="trigger1" 
            displayFormat="#,###.##" applyFormat="all" validateOnInput="true" 
            maxLength="5.2" autoDecimalPoint="true" lengthCheckIgnoreChar="+-">
        </xf:input>

        <w2:textbox class="" label="maxByteLength=5.2 maxByteLengthFloat=true &lt;br&gt;autoDecimalPoint=true &lt;br&gt;lengthCheckIgnoreChar='+-'" style="position: relative;width: 518px;height: 30px;" tagname="h3" escape="false"></w2:textbox>
    	<xf:input adjustMaxLength="false" id="input2" style="position: relative;width: 218px;height: 45px; margin-top: 10px;" ref="data:dataMap1.key2" dataType="float" 
            autoFocus="true" nextTabID="trigger1" 
            displayFormat="#,###.#0" applyFormat="all" validateOnInput="true" 
            maxByteLength="5.2" maxByteLengthFloat="true" autoDecimalPoint="true" lengthCheckIgnoreChar="+-">
        </xf:input>

        <xf:trigger type="button" id="trigger1" style="width:80px; height:23px; display:block; margin-top: 10px;">
    		<xf:label></xf:label>
    	</xf:trigger>
    </body>
</html>
