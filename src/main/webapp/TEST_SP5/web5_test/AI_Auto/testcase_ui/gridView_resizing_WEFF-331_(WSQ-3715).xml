<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    dataList1.setData(["hello", "hello", "hello", "hello"])
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="group3" style="margin: 10px;">
    		<w2:textbox id="textbox3" label='1. 그리드뷰 autoFit="allColumn" 설정 &amp; &amp;nbsp;지정한 width로 초기넓이 설정. * 포함 &lt;br/&gt;' style="width:574px;height:23px;">
    		</w2:textbox>
    		<w2:gridView applyAllColumnStyle="false" autoFit="allColumn" dataList="data:dataList1" defaultCellHeight="20" id="gridView3"
    			ignoreCellClick="false" ignoreToggleOnDisabled="false" scrollByColumn="false" scrollByColumnAdaptive="false"
    			style="width:800px;height:93px;" summaryAuto="false" summaryOnlyAuto="false" syncScroll="false" useShiftKey="true">
    			<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    			<w2:header id="header1" style="">
    				<w2:row id="row1" style="">
    					<w2:column blockSelect="false" displayMode="label" footerDiv="false" id="column7" inputType="text"
    						removeBorderStyle="false" value="name1" width="100">
    					</w2:column>
    					<w2:column blockSelect="false" displayMode="label" footerDiv="false" id="column5" inputType="text"
    						removeBorderStyle="false" value="name2" width="200">
    					</w2:column>
    					<w2:column blockSelect="false" displayMode="label" footerDiv="false" id="column3" inputType="text"
    						removeBorderStyle="false" value="name3" width="*">
    					</w2:column>
    					<w2:column blockSelect="false" displayMode="label" footerDiv="false" id="column1" inputType="text"
    						removeBorderStyle="false" value="name4" width="*">
    					</w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody id="gBody1" style="">
    				<w2:row id="row2" style="">
    					<w2:column blockSelect="false" displayMode="label" footerDiv="false" id="col1" inputType="text"
    						removeBorderStyle="false">
    					</w2:column>
    					<w2:column blockSelect="false" displayMode="label" footerDiv="false" id="col2" inputType="text"
    						removeBorderStyle="false">
    					</w2:column>
    					<w2:column blockSelect="false" displayMode="label" footerDiv="false" id="col3" inputType="text"
    						removeBorderStyle="false">
    					</w2:column>
    					<w2:column blockSelect="false" displayMode="label" footerDiv="false" id="col4" inputType="text"
    						removeBorderStyle="false">
    					</w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    	</xf:group>
    </body>
</html>
 