<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    grid1.setCellMaxLength(0, 1, "5.2");
    grid1.setCellDisplayFormat(0, 1, "#,###.#0");
};
scwin.trigger2_onclick = function(e) {
    grid1.setCellMaxLength(0, 2, "5.2");
    grid1.setCellDisplayFormat(0, 2, "#,###.##");
};
scwin.onpageload = function() {
    grid1.setRef({
        ref: "vector",
        baseNode: "vector",
        repeatNode: "data"
    });
    grid1.insertRow();
    grid1.setCellInputType(0, 1, {
        inputType: "text",
        options: {
            dataType: "float",
            maxlength: "7.2",
            displayFormat: "#,###.##",
            applyFormat: "all"
        }
    });
    grid1.setCellInputType(0, 2, {
        inputType: "text",
        options: {
            dataType: "float",
            maxlength: "7.2",
            displayFormat: "#,###.#0",
            applyFormat: "all"
        }
    });
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:grid ref="vector" baseNode="vector" repeatNode="data" id="grid1" style="width:553px;height:150px;" fixedColumnWithHidden="true"
    		useShiftKey="true" setCellInputTypeCustom="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" style="height:20px;" width="120" inputType="text" displayMode="label"
    					value="property">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px;" width="120" inputType="text" displayMode="label"
    					value="setCellInputType">
    				</w2:column>
    				<w2:column blockSelect="false" id="column5" style="height:20px" inputType="text" width="120" displayMode="label"
    					value="api">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column2" style="" width="120" inputType="text" dataType="float" maxlength="7.2"
    					displayFormat="#,###.#0" applyFormat="all" value="" displayMode="label" defaultValue="">
    				</w2:column>
    				<w2:column blockSelect="false" id="column4" style="" width="120" inputType="custom" value="" displayMode="label"
    					defaultValue="">
    				</w2:column>
    				<w2:column blockSelect="false" id="column6" style="height:20px" inputType="custom" width="70" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:grid>
    	<xf:input id="" style="width: 144px;height: 21px;" dataType="float" maxlength="7.2" displayFormat="#,###.#0" applyFormat="all"></xf:input>
    	<xf:trigger type="button" id="trigger1" style="position: absolute;width: 80px;height: 23px;left:9px;top:183px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[1번]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2" style="position: absolute;width: 80px;height: 23px;left:107px;top:183px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[2번]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 