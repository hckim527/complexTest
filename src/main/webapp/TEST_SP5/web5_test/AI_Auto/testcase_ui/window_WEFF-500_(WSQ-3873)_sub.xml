<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list"
                    saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1"
                            dataType="text">
                        </w2:column>
                        <w2:column id="col2" name="name2"
                            dataType="text">
                        </w2:column>
                        <w2:column id="col3" name="name3"
                            dataType="text">
                        </w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <w2:textbox label="pickerType_default" id=""
            style="position: relative;width: 500px;height: 23px;font-size:18px;">
        </w2:textbox>
        <w2:calendar rightAlign="false"
            calendarValueType="yearMonthDateTimeSec" renderType="component" id="calendar_yearMonthDateTimeSec"
            renderDiv="true" pickerStatusRefresh="true"
            style="position: relative;width: 150px;height: 23px;" serverSync="true"
            focusOnDateSelect="false" footerDiv="false">
        </w2:calendar>
        <w2:calendar rightAlign="false"
            calendarValueType="yearMonthDateTime" renderType="component" id="calendar_yearMonthDateTime"
            renderDiv="true" pickerStatusRefresh="true"
            style="position: relative;width: 150px;height: 23px;" serverSync="true"
            focusOnDateSelect="false" footerDiv="false">
        </w2:calendar>
        <w2:calendar rightAlign="false"
            calendarValueType="yearMonthDate" renderType="component" id="calendar_yearMonthDate"
            renderDiv="true" pickerStatusRefresh="true"
            style="position: relative;width: 150px;height: 23px;" serverSync="true"
            focusOnDateSelect="false" footerDiv="false">
        </w2:calendar>
        <w2:calendar rightAlign="false"
            calendarValueType="yearMonth" renderType="component" id="calendar_yearMonth"
            renderDiv="true" pickerStatusRefresh="true"
            style="position: relative;width: 150px;height: 23px;" serverSync="true"
            focusOnDateSelect="false" footerDiv="false">
        </w2:calendar>
        <w2:calendar rightAlign="false"
            calendarValueType="year" renderType="component" id="calendar_year"
            renderDiv="true" pickerStatusRefresh="true"
            style="position: relative;width: 150px;height: 23px;" serverSync="true"
            focusOnDateSelect="false" footerDiv="false">
        </w2:calendar>
    </body>
</html>
 