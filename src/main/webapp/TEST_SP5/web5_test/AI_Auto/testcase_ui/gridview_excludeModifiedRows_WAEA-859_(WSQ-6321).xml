<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="gridview1">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:mfeSubmission/>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function() {
    var data = [];
    
    // 5개의 행을 생성
    for (var i = 0; i < 5; i++) {
        // 1. 첫 번째 컬럼(name1)에 정수값(i) 추가
        data.push(i); 

        // 2. 나머지 4개의 컬럼(name2~name5)에 문자열 추가
        // j의 범위를 1~4로 제한하여 한 행에 총 5개의 데이터가 들어가도록 맞춤
        for (var j = 1; j < 5; j++) {
            data.push(i + "_" + j);
        }
    }
    
    // dataList1의 컬럼이 5개일 때:
    // [0, "0_1", "0_2", "0_3", "0_4", 1, "1_1", "1_2", "1_3", "1_4", ...]
    // 이렇게 넣어야 각 행의 첫 번째 데이터(0, 1, 2...)가 name1 컬럼에 들어갑니다.
    dataList1.setData(data);
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView checkAllType="false" id="" style="width:500px; height:350px;" dataList="data:dataList1" rowStatusVisible="true" excludeModifiedRows="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" style="" inputType="text" id="column5" value="name1"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column4" value="name2"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column3" value="name3"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column2" value="name4"></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column1" value="name5"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" style="" inputType="text" id="col1" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col2" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col3" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col4" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="col5" value=""></w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:footer style="" id="footer1">
    			<w2:row style="" id="row3">
    				<w2:column width="70" style="" inputType="expression" id="column15" value="" expression="sum('col1')"></w2:column>
    				<w2:column width="70" style="" inputType="" id="column14" value="" expression=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column13" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column12" value=""></w2:column>
    				<w2:column width="70" style="" inputType="text" id="column11" value=""></w2:column>
    			</w2:row>
    		</w2:footer>
    	</w2:gridView>
    </body>
</html>
