<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.test = function(info) {
    var rowIndex = info.rowIndex;
    var colIndex = info.colIndex;
    var returnInfo = {
        id: "dynamic_checkbox_" + rowIndex + "_" + colIndex,
        inputType: "checkbox",
        options: {}
    };
    return returnInfo;
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    gridView1.setCellChecked(0, "col1", true);
};
scwin.trigger2_onclick = function(e) {
    alert("결과갑 다름" + gridView1.getCheckedIndex("col1").length);
};
scwin.trigger3_onclick = function(e) {
    alert("결과갑 다름" + gridView1.getCheckedIndex("col2").length);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    /** inputType custom 시 문제 있는 그리드 API 적용 안되는 항목
    gridView1.getCheckedIndex
    gridView1.getCheckedData
    gridView1.getCheckedJSON
    gridView1.getCheckedXML
    gridView1.checkAll
    gridView1.setCellChecked
    */
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">

    	<w2:gridView dataList="dataList1" applyAllColumnStyle="false" scrollByColumn="false" id="gridView1"
    		style="position: absolute;width:635px;height:382px;left:249px;top:144px;" fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5" style="height:20px;" inputType="text" width="70" value="custom"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px;" inputType="text" width="70" value="checkbox"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="height:20px;" width="70" inputType="text" value="name3"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="custom" width="70" typeGetter="scwin.test"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="checkbox" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" width="70" inputType="text"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="position: absolute;width: 80px;height: 23px;left:253px;top:69px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[버튼1]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2" style="position: absolute;width: 80px;height: 23px;left:370px;top:68px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[버튼2]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3"
    		style="position: absolute;width: 80px;height: 23px;left:467px;top:67px;" type="button">
    		<xf:label><![CDATA[버튼3]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 