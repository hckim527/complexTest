        <script type="text/javascript" lazy="false"><![CDATA[
scwin.mainClose = function(title) {
    var result = confirm("close?");
    if (result) {
        return true;
    } else {
        return false;
    }
};
scwin.createWindowTest = function(title) {
    wc1.createWindow(title, "", "", "windowTitle", "windowId", "newWindow", scwin.mainClose);
    //wc1.createWindow( title , iconUrl , src , windowTitle , windowId , openAction , closeAction , windowTooltip )
};
scwin.wc1_onbeforecloseall = function() {
    debugger;
};
scwin.onpageload = function() {
    scwin.createWindowTest("main");
    scwin.createWindowTest("aa");
    scwin.createWindowTest("bb");
    scwin.createWindowTest("cc");
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
