	scwin.onpageload = function() {
		const tooltip = document.getElementById("mf_tooltip");
		tooltip.style.display = "none";
		scwin.setInputBoxInGridHeader(gridView1, "column6");
	};
	
	scwin.onpageunload = function() {
		
	};
scwin.setInputBoxInGridHeader = function (gridObj, headerColumnId) {
	//debugger;


	var inputBoxObj = {
		div: null,
		getContent: function () {
			this.select = document.createElement("nobr");
			this.select.style.width = "10px";
			this.div = document.createElement("div");
			this.div.style.backgroundColor="yellow";
			this.div.style.height = "11px";


			this.select.id = headerColumnId;
			this.div.appendChild(this.select);


			this.select.innerHTML = "name1"

			this.image = document.createElement("img");
			this.image.style.width = "10px";
			this.image.style.height = "10px";

			this.image.setAttribute("src", "http://static.naver.net/green/v2/img/btn_security2_on.gif");
			this.div.appendChild(this.image);


			var _this = this;


			return this.div;

		}
	}



	gridObj.setHeaderUserObject(headerColumnId, inputBoxObj);
};	

scwin.getHeaderTooltip = function() {
	var txt = "text";

	return txt;
};
scwin.gridView1_onheaderover = function(info) {//debugger;
	console.log("콜백 grid1 headerover호출");
};
scwin.gridView1_onheadermouseout = function(info) {//debugger;
