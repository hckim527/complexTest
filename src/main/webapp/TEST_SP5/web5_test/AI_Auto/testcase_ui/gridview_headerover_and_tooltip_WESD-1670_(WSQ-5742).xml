};

scwin.gridView2_onheaderover = function(info) {
	const tooltip = document.getElementById("mf_tooltip");
	const target = document.getElementById(info.id);
	let _left = target.offsetLeft + "px";
	let _top = target.offsetTop + target.offsetHeight + "px";
	tooltip.style.left = _left;
	tooltip.style.top = _top;	
	tooltip.style.display = "flex";
	tooltip.value =info.id;
	console.log("콜백 grid2 headerover호출");
};
scwin.gridView2_onheadermouseout = function(info) {
	const tooltip = document.getElementById("mf_tooltip");
	tooltip.value = "";
	tooltip.style.display = "none";
	console.log("콜백 grid2 headerout호출");
};
scwin.gridView2_onbodymouseover = function(info) {
	//console.log(info);
};
