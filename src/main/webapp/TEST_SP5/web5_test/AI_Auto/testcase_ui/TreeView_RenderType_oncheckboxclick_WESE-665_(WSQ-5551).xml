<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dlt_tree" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="value" name="값" dataType="text"></w2:column>
            			<w2:column id="label" name="레이블" dataType="text"></w2:column>
            			<w2:column id="level" name="level" dataType="number"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<value><![CDATA[01]]></value>
            				<level><![CDATA[1]]></level>
            				<label><![CDATA[서울시]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[02]]></value>
            				<level><![CDATA[2]]></level>
            				<label><![CDATA[강남구]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[03]]></value>
            				<level><![CDATA[2]]></level>
            				<label><![CDATA[강북구]]></label>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[04]]></value>
            				<label><![CDATA[강서구]]></label>
            				<level><![CDATA[2]]></level>
            			</w2:row>
            			<w2:row>
            				<value><![CDATA[05]]></value>
            				<label><![CDATA[강동구]]></label>
            				<level><![CDATA[2]]></level>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.trv_test_oncheckboxclick = function(value,node,index) {

    console.log("oncheckboxclick 이벤트 실행");
    console.log("파라미터 값 확인 : val : " + value + "/ node : " + node + "/ Index :  " + index)

    debugger;

    var idx = trv_test.getSelectedIndex();
    var lbl = trv_test.getSelectedLabel();
    var node = trv_test.getSelectedNode();
    var val = trv_test.getSelectedValue();

    console.log("getSelectedIndex 값 확인 : " + idx);
    console.log("getSelectedIabel 값 확인 : " + lbl);
    console.log("getSelectedNode 값 확인 : " + node);
    console.log("getSelectedValue 값 확인 : " + val);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" style="">
    		<w2:textbox id="" label="TreeView의 Type이 virtual 일 때 이벤트 첫 실행 시 내부에서 getSelected~ 등의 API의 결과 값이 null 이거나 비어있는 현상"
    			style="width:801px;height:23px;" tagname="h3">
    		</w2:textbox>
    		<w2:treeview id="trv_test" dataType="listed" tooltipGroupClass="false" style="width: 200px;height: 300px;" renderType="virtual"
    			falseValue="0" alwaysDraw="true" showCheckbox="true" ev:oncheckboxclick="scwin.trv_test_oncheckboxclick">
    			<w2:itemset nodeset="data:dlt_tree">
    				<w2:label ref="label"></w2:label>
    				<w2:value ref="value"></w2:value>
    				<w2:depth ref="level"></w2:depth>
    				<w2:folder ref=""></w2:folder>
    				<w2:checkbox ref=""></w2:checkbox>
    				<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
    				<w2:image ref=""></w2:image>
    				<w2:iconImage ref=""></w2:iconImage>
    				<w2:selectedImage ref=""></w2:selectedImage>
    				<w2:expandedImage ref=""></w2:expandedImage>
    				<w2:leafImage ref=""></w2:leafImage>
    			</w2:itemset>
    		</w2:treeview>
    		<xf:textarea id="" style="width: 300px;height: 100px;"></xf:textarea>
    	</xf:group>
    	
    </body>
</html>
