<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.outter_wframe = function(udcID) {
    //udc 버튼 클릭 시 실행되는 부분.
    alert(udcID);
};

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <!-- [WEFF-598 / WSQ-3954 / WSQ-4293]
             config.js 의 wframe.scope 가 "true" 이므로 wframe 내부에 별도의 scwin 이 생성된다.
             (scope 속성을 비워두면 config 설정을 따른다.)
             내부 UDC 에서 main 의 scwin 함수를 호출하려면 아래 중 하나를 사용한다.
              - window.mf_scwin.xxx 로 글로벌 접근 (본 샘플에서 적용한 방법, sub2.xml 참고)
              - 이 wframe 에 scope="false" 지정
              - 이 wframe 에 scopeInherit="component|all|recursive" 지정 -->
        <w2:wframe id="wframe1" style="width: 500px;height: 300px;" src="wframe1_udc_WEFF-598_(WSQ-3954)_sub.xml" scope=""></w2:wframe>
    </body>
</html>
 