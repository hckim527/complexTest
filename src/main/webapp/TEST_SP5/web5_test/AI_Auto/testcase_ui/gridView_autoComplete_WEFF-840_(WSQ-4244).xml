        "up_value1": "a1"
    }, {
        "value": "a1-2",
        "label": "가2",
        "up_value1": "a1"
    }, {
        "value": "a2-1",
        "label": "나1",
        "up_value1": "a2"
    }, {
        "value": "a2-2",
        "label": "나2",
        "up_value1": "a2"
    }, {
        "value": "a3-1",
        "label": "다1",
        "up_value1": "a3"
    }];
    selectList2.setJSON(selList2);
    var data = [{
        "col1": "a1",
        "col2": "a1-2",
        "col4": "가"
    }, {
        "col1": "a3",
        "col2": "a3-1",
        "col4": "다"
    }, {
        "col1": "b2",
        "col2": "a2-1",
        "col4": "나"
    }];
    dataList1.setJSON(data);
};
scwin.onpageload = function() {
