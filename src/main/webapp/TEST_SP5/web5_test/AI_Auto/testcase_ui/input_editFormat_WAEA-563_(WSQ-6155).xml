        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    //input1.setValue(1111112222222);
};
scwin.displayFormatter = function(value){
    var rtnVal = "";
    if(value.length == 13){
        rtnVal = value.substring(0,6) + "-" + value.substring(6,13);
    }else{
        rtnVal = value;    
    }
    return rtnVal;
};


scwin.trigger1_onclick = function (e) {
    input1.setValue(1111113333333);
};

scwin.trigger2_onclick = function (e) {
    debugger;
    input2.setValue( input1.getValue() );
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:input id="input1" style="width: 144px;height: 21px;" ref="data:dataList1.col1" editFormat="######-#######"
