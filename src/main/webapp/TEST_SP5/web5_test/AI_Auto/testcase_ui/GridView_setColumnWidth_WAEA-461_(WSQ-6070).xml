<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="test">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
            		<w2:columnInfo>
            		</w2:columnInfo>
            		<w2:data use="true">
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();

    grid1.setColumnWidth("col1", 70);
};

scwin.trigger1_onclick = function (e) {
    grid1.setColumnWidth("col1", 10);
};

scwin.trigger2_onclick = function (e) {
    grid1.setColumnWidth("col1", 150);
};

scwin.trigger3_onclick = function (e) {
    grid1.setColumnWidth("col1", 0);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView ss_prevNextType="next" checkAllType="false" ss_dataType="0 - TopInsert(시간)" id="grid1"
    		style="width: 500px;height: 150px;" ss_itemFlag="2 - OUTPUT" ss_gridContent="0 - 사용안함" dataList="data:dataList1">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="" value="1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="2" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" ss_itemFlag="0 - NONE" ss_keyCodeType="0 - NONE" id="trigger1" ss_action="0 - NONE"
    		style="width:120px;height:25px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[Width 10]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" ss_itemFlag="0 - NONE" ss_keyCodeType="0 - NONE" id="trigger2" ss_action="0 - NONE"
    		style="width:120px;height:25px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[Width 150]]></xf:label>
    	</xf:trigger>

    	<xf:trigger type="button" ss_itemFlag="0 - NONE" ss_keyCodeType="0 - NONE" id="trigger3" ss_action="0 - NONE"
    		style="width:120px;height:25px;" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[Width 0]]></xf:label>
    	</xf:trigger>
    </body>
</html>
