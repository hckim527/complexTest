<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList_grd" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="text" dataType="text"></w2:column>
            			<w2:column id="col2" name="checkcombobox" dataType="text"></w2:column>
            			<w2:column id="col3" name="checkcombobox" dataType="text"></w2:column>
            			<w2:column id="col4" name="text" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
    scwin.startCnt = 0;
	scwin.onpageload = function() {
		var data = [];
		for (var i = scwin.startCnt; i < scwin.startCnt + 20; i ++) {
			data.push(i + "");
			data.push(i + "" + "_v");
		}
        scwin.startCnt += 20;
		dataList1.setData(data);
		var data_grd = [];
		for (var i = 0; i < 100; i ++) {
			data_grd.push(i + "_0");
			data_grd.push("");
			data_grd.push("");
			data_grd.push(i + "_3");
		}
		dataList_grd.setData(data_grd);
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger1_onclick = function(e) {
		var data = [];
		for (var i = scwin.startCnt; i < scwin.startCnt + 20; i ++) {
			data.push(i + "");
			data.push(i + "" + "_v");
		}
		dataList1.setData(data, true);
        scwin.startCnt += 20;
	};

    scwin.trigger2_onclick = function(e) {
        var data = [];
        for (var i = scwin.startCnt; i < scwin.startCnt + 100; i ++) {
            data.push(i + "");
            data.push(i + "" + "_v");
        }
        dataList1.setData(data, true);
        scwin.startCnt += 100;
    };

    scwin.trigger3_onclick = function(e) {
        var data = [];
        for (var i = scwin.startCnt; i < scwin.startCnt + 1000; i ++) {
            data.push(i + "");
            data.push(i + "" + "_v");
        }
        dataList1.setData(data, true);
        scwin.startCnt += 1000;
    };
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group style="position: relative;height: 100%;overflow-x: auto;" id="grp_wrap">
    		<xf:group style="position: relative;width: 100%;height: 70px;background: #fff;-webkit-box-shadow: 0px 0px 15px 0px rgba(0,0,0,0.2);-moz-box-shadow: 0px 0px 15px 0px rgba(0,0,0,0.2);box-shadow: 0px 0px 15px 0px rgba(0,0,0,0.2);z-index: 1000;font-weight: bold;" id="grp_header"></xf:group>
    		<xf:group style="    position: absolute;left: 0;top: 70px;right: 0;bottom: 0;background: #fff;" id="grp_container">
		     	<xf:group style="width:800px;height:275px;" id="">
		    		<w2:textbox id="" label="WESD-562 : checkcombobox 추가 기능" style="width:427px;height:23px;font-size:16px;"></w2:textbox>
		    		<w2:textbox id="" label='신규 속성 (공통)' style="width:426px;height:25px;font-size:14px;font-weight:bold;"></w2:textbox>
		    		<w2:textbox id="" label='checkboxClickSync="true"' style="width:426px;height:25px;font-size:14px;"></w2:textbox>
		    		<w2:textbox id="" label='allowChar="0-9,-"' style="width:426px;height:25px;font-size:14px;"></w2:textbox>
		    		<w2:textbox id="" label='useEdit="true"' style="width:426px;height:25px;font-size:14px;"></w2:textbox>
		    		<w2:textbox id="" label='rangeSeparator="-"' style="width:426px;height:25px;font-size:14px;"></w2:textbox>
		    		<w2:textbox id="" label='validateOnInput="true"' style="width:426px;height:25px;font-size:14px;"></w2:textbox>
		    		<w2:textbox id="" label='useDrag="true" : shift+drag시 선택해제, 그냥 drag시 선택'
		    			style="width:426px;height:25px;font-size:14px;font-weight:bold;">
		    		</w2:textbox>
		    		<xf:trigger type="button" style="width:233px;height:47px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
		    			<xf:label><![CDATA[add data (20 rows)]]></xf:label>
		    		</xf:trigger>
		    		<xf:trigger type="button" style="width:233px;height:47px;" id="trigger2" ev:onclick="scwin.trigger2_onclick">
		    			<xf:label><![CDATA[add data (100 rows)]]></xf:label>
		    		</xf:trigger>
		    		<xf:trigger type="button" style="width:233px;height:47px;" id="trigger3" ev:onclick="scwin.trigger3_onclick">
		    			<xf:label><![CDATA[add data (1000 rows)]]></xf:label>
		    		</xf:trigger>
		    	</xf:group>


		    	<xf:group style="position:relative;width:900px;height:300px;" id="">
		    		<xf:group id="" style="position:relative;width:440px;height:340px;float:left;">
		    			<w2:textbox id="" label="checkcombobox1" style="width:276px;height:23px;font-weight:bold;"></w2:textbox>
		    			<w2:textbox id="" label='visibleColNum="5" : 데이터 수에 관계없이 column은 5개로 고정' style="width:400px;height:23px;"></w2:textbox>
		    			<w2:textbox id="" label='submenuSize="auto" : 목록의 가로 길이는 checkcombobox 가로 길이와 같다' style="width:300px;height:50px;"></w2:textbox>
		    			<xf:checkcombobox submenuSize="auto" displayAllOptionLabel="false" chooseOption="" allOption=""
		    				separator="," displayMode="label" ref="" appearance="minimal" checkboxClickSync="true" useEdit="true" validateOnInput="true"
		    				disabled="false" style="width:300px;height:50px;" id="checkcombobox1" allowChar="0-9,-" useDrag="true" rangeSeparator="-"
		    				direction="auto" visibleColNum="5">
		    				<xf:choices>
		    					<xf:itemset nodeset="data:dataList1">
		    						<xf:label ref="col1"></xf:label>
		    						<xf:value ref="col2"></xf:value>
		    					</xf:itemset>
		    				</xf:choices>
		    			</xf:checkcombobox>

		    		</xf:group>
		    		<xf:group id="" style="position:relative;width:440px;height:340px;float:right;">
		    			<w2:textbox id="" label="checkcombobox2" style="width:276px;height:23px;font-weight:bold;"></w2:textbox>
		    			<w2:textbox id="" label='visibleColMax="10" : 데이터가 늘어날수록 column이 최대 10개까지 늘어난다' style="width:420px;height:23px;"></w2:textbox>
		    			<w2:textbox id="" label='submenuSize="column" : 목록의 가로 길이가 column 개수에 비례해서 결정된다.' style="width:300px;height:50px;"></w2:textbox>
		    			<xf:checkcombobox submenuSize="column" displayAllOptionLabel="false" chooseOption="" allOption=""
		    				separator="," displayMode="label" visibleColMax="10" ref="" appearance="minimal" checkboxClickSync="true" useEdit="true"
		    				validateOnInput="true" disabled="false" style="width:300px;height:50px;" id="checkcombobox2" visibleRowNum="7" allowChar="0-9,-"
		    				useDrag="true" rangeSeparator="-" direction="auto">
		    				<xf:choices>
		    					<xf:itemset nodeset="data:dataList1">
		    						<xf:label ref="col1"></xf:label>
		    						<xf:value ref="col2"></xf:value>
		    					</xf:itemset>
		    				</xf:choices>
		    			</xf:checkcombobox>
		    		</xf:group>
		    	</xf:group>
				<xf:group id="" style="height: 500px">
					<w2:textbox escape="false" id="" label="스크롤 생성을 위해 만든 그룹&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;" style="width:873px;height:77px;"
						tagname="span">
					</w2:textbox>
				</xf:group>   
		    			
    		</xf:group>
    	</xf:group>

 	
    </body>
</html>
