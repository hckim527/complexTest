<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[a]]></col1>
            				<col2><![CDATA[1]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[b]]></col1>
            				<col2><![CDATA[2]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[c]]></col1>
            				<col2><![CDATA[3]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[d]]></col1>
            				<col2><![CDATA[4]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[e]]></col1>
            				<col2><![CDATA[5]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
let isFilter = false;
let isSort = false;



scwin.onpageload = function() {
	
};



scwin.btn_setColumnFilter_onclick = function (e) {
	
};



scwin.btn_insertJSON_onclick = function (e) {
	dataList1.insertJSON(0, [{col1:"insert1",col2:"6"},{col1:"insert2",col2:"7"}]);
};



scwin.btn_setColumnFilter_onclick = function (e) {
    if (isFilter) {
        dataList1.clearFilter();  
        isFilter = false;  
    }
    else {
        dataList1.setColumnFilter( {type:'row', colIndex:'col1', key:"b", condition:'and'})             
        dataList1.setColumnFilter( {type:'row', colIndex:'col1', key:"d", condition:'or'})             
        isFilter = true;
    }	
};



scwin.btn_sort_onclick = function (e) {
    if (isSort) {    
        dataList1.clearSort();
        isSort = false;
    }
    else {
        dataList1.sort("col1", 1);
        isSort = true;
    }
}]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView checkAllType="false" id="gridView1" style="width:500px;height:358px;" dataList="data:dataList1" rowNumVisible="true" rowStatusVisible="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" style="" inputType="text" id="column1" value="name1"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="name2" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" style="" inputType="text" id="col1" value=""></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:button style="width: 100px;height: 100px;" id=""></w2:button>
    	</w2:gridView>
        <w2:button style="width:155px; height:46px;" id="btn_insertJSON" label="insertJSON" class=""
            ev:onclick="scwin.btn_insertJSON_onclick">
        </w2:button>
    	<w2:button style="width:155px;height:46px;" id="btn_setColumnFilter" label="필터 적용/해제"
    		ev:onclick="scwin.btn_setColumnFilter_onclick">
    	</w2:button>
    	<w2:button ev:onclick="scwin.btn_sort_onclick" id="btn_sort" label="정렬 적용/해제" style="width:155px;height:46px;"></w2:button>
    </body>
</html>
