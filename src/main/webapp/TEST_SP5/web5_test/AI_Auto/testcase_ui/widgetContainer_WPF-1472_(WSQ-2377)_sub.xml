<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" style="" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="항목" dataType="text"></w2:column>
            			<w2:column id="col2" name="item1" dataType="text"></w2:column>
            			<w2:column id="col3" name="item2" dataType="text"></w2:column>
            			<w2:column id="col4" name="item3" dataType="text"></w2:column>
            			<w2:column id="col5" name="배수" dataType="text"></w2:column>
            			<w2:column id="col6" name="총합" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataMap baseNode="map" id="dataMap1" style="">
            		<w2:keyInfo>
            			<w2:key id="key1" name="title" dataType="text"></w2:key>
            		</w2:keyInfo>
            		<w2:data use="true">
            			<key1><![CDATA[Widget]]></key1>
            		</w2:data>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.makeData = function() {
    var dataArr = [];
    for (var i = 1; i <= 100; i++) {
        var t1 = i;
        var t2 = t1 * 10;
        var t3 = t1 * 100;
        var t4 = 123;
        var t5 = ((i - 1) % 9) + 1;
        var t6 = (t2 + t3 + t4) * t5;
        dataArr.push(t1);
        dataArr.push(t2);
        dataArr.push(t3);
        dataArr.push(t4);
        dataArr.push(t5);
        dataArr.push(t6);
    }
    return dataArr;
}
scwin.bindData = function(dataArr) {
    dataList1.setData(dataArr, false);
}
scwin.init = function() {
    this.bindData(this.makeData());
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.currentDataArr = [];
    scwin.init();
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:textbox label="" id="textbox" style="position: relative;width:204px;height:26px;font-size:14pt;" ref="data:dataMap1.key1"></w2:textbox>
    	<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView" style="position: relative;width:500px;height:150px"
    		fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column15" style="height:20px" inputType="text" width="80" value="항목"></w2:column>
    				<w2:column blockSelect="false" id="column13" style="height:20px" inputType="text" width="80" value="item1"></w2:column>
    				<w2:column blockSelect="false" id="column11" style="height:20px" inputType="text" width="80" value="item2"></w2:column>
    				<w2:column blockSelect="false" id="column9" style="height:20px" inputType="text" width="80" value="item3"></w2:column>
    				<w2:column blockSelect="false" id="column7" style="height:20px" inputType="text" width="80" value="배수"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px" width="80" inputType="text" value="총합"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody4" style="">
    			<w2:row id="row5" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col4" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col5" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col6" style="height:20px" width="70" inputType="text"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 