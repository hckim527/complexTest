<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="target1" repeatNode="map" style="">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="col1" name="name1"></w2:column>
            			<w2:column dataType="text" id="col2" name="name2"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[WebSquare]]></col1>
            				<col2><![CDATA[1]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[Inswave]]></col1>
            				<col2><![CDATA[2]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[websquare]]></col1>
            				<col2><![CDATA[3]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[inswave]]></col1>
            				<col2><![CDATA[WebSquare]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[WebSquare AI]]></col1>
            				<col2><![CDATA[5]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[Inswave System]]></col1>
            				<col2><![CDATA[6]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};



scwin.btn_setColumnFilter_onclick = function (e) {   
    target1.setColumnFilter({type:'row', colIndex:0, key:'WebSquare', condition:'and', exactMatch:false});            
};



scwin.btn_removeColumnFilter_onclick = function (e) {
    target1.removeColumnFilter(0);    
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView checkAllType="false" dataList="data:target1" id="gridView1" rowStatusVisible="true"
    		style="width:500px;height:373px;">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column id="column1" inputType="text" style="" value="name1" width="182"></w2:column>
    				<w2:column displayMode="label" id="column4" inputType="text" style="" value="name2" width="184"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column id="col1" inputType="text" style="" value="" width="182"></w2:column>
    				<w2:column displayMode="label" id="col2" inputType="text" style="" value="" width="184"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:group style="" id="grp_etc">
            <w2:button ev:onclick="scwin.btn_setColumnFilter_onclick" id="btn_setColumnFilter" label="setColumnFilter(0)"
                style="">
            </w2:button>
            <w2:button ev:onclick="scwin.btn_removeColumnFilter_onclick" id="btn_removeColumnFilter" label="removeColumnFilter(0)" style=""></w2:button>
        </xf:group>
    </body>
</html>
