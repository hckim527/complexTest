		<style type="text/css"><![CDATA[
		/* Radio & Checkbox */
.w2checkbox .w2checkbox_item,.w2radio .w2radio_item {position:relative;display:inline-block;padding-left:24px;min-height:20px;}
.w2checkbox .w2checkbox_label,.w2radio .w2radio_label {line-height:22px;font-size:13px}
.w2checkbox .w2checkbox_item,.w2radio .w2radio_item {margin-right:10px}
.w2checkbox .w2checkbox_item:last-child,.w2radio .w2radio_item:last-child {margin-right:0;}

/* Radio & Checkbox Design */
.w2checkbox .w2checkbox_item input[type="checkbox"], .w2radio .w2radio_item input[type="radio"] {position:absolute;left:0;}
.w2checkbox_label:before {position:absolute;left:0;top:0;content:'';display: inline-block;width:20px;height:20px;border:1px solid #cfd5d8;box-sizing:border-box;background:#fff}
.w2radio_label:before {position:absolute;left:1px;top:0;content:'';display: inline-block;width:20px;height:20px;border:1px solid #cfd5d8;box-sizing:border-box;border-radius:50%;background:#fff}
input[type="checkbox"]:checked  + .w2checkbox_label:before {background-color:#1875f0;border:0}
input[type="checkbox"]:checked  + .w2checkbox_label:after {content:'';position:absolute;left:5px;top:5px;width:8px;height:4px;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:rotate(-45deg)}
input[type="checkbox"]:disabled  + .w2checkbox_label:before {background-color:#dadada}
input[type="checkbox"]:disabled:checked +  .w2checkbox_label:after {border-color:#a1a1a1;}
input[type="checkbox"]:indeterminate + .w2checkbox_label:before {background: #fff;}
input[type="checkbox"]:indeterminate + .w2checkbox_label:after {content:'';position:absolute;left:5px;top:9px;width:10px;border-bottom:3px solid #00aa91;}
input[type="radio"]:checked  + .w2radio_label:before {}
input[type="radio"]:checked  + .w2radio_label:after {content:'';position:absolute;left:7px;top:6px;width:8px;height:8px;border-radius:50%;background:#1875f0}
input[type="radio"]:disabled + .w2radio_label:before {background-color:#dadada}
input[type="radio"]:disabled:checked + .w2radio_label:after {background-color:#a1a1a1;} 
		
		
		
		
		 ]]></style>
