<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:ev="http://www.w3.org/2001/xml-events"
      xmlns:w2="http://www.inswave.com/websquare"
      xmlns:xf="http://www.w3.org/2002/xforms">
<head>
    <w2:type>DEFAULT</w2:type>
    <w2:buildDate/>
    <xf:model>
        <xf:instance>
            <data xmlns=""/>
        </xf:instance>
        <w2:dataCollection baseNode="map"/>
        <w2:workflowCollection/>
    </xf:model>
    <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    $p.top().scwin.log("[middle] onpageload fired (외부 tabControl 의 첫번째 content, wframe)");
};

scwin.btn_selectInner1_onclick = async function() {
    $p.top().scwin.log("[middle] inner tab[0] select 호출");
    await tabControl_inner.setSelectedTabIndex(0);
    $p.top().scwin.log("[middle] inner tab[0] select 완료");
};

scwin.btn_selectInner2_onclick = async function() {
    $p.top().scwin.log("[middle] inner tab[1] select 호출");
    await tabControl_inner.setSelectedTabIndex(1);
    $p.top().scwin.log("[middle] inner tab[1] select 완료");
};
]]></script>
</head>
<body ev:onpageload="scwin.onpageload">

    <w2:textbox label="[middle.xml] 내부 tabControl — 두 content 모두 alwaysDraw='true' wframe"
                style="position:relative;display:block;font-size:12px;font-weight:bold;margin-bottom:4px;"></w2:textbox>

    <xf:group style="position:relative;margin-bottom:4px;">
        <xf:trigger type="button" id="btn_selectInner1" ev:onclick="scwin.btn_selectInner1_onclick"
                    style="position:relative;width:160px;height:22px;">
            <xf:label><![CDATA[Inner Tab[0] 선택]]></xf:label>
        </xf:trigger>
        <xf:trigger type="button" id="btn_selectInner2" ev:onclick="scwin.btn_selectInner2_onclick"
                    style="position:relative;width:160px;height:22px;">
            <xf:label><![CDATA[Inner Tab[1] 선택]]></xf:label>
        </xf:trigger>
    </xf:group>

    <w2:tabControl id="tabControl_inner"
                   style="width:960px;height:320px;"
                   useTabKeyOnly="false" useMoveNextTabFocus="false"
                   useBackbridge="true" useConfirmMessage="false"
                   confirmTrueAction="exist" confirmFalseAction="new"
                   tabScroll="true">
        <w2:tabs id="inner_tab1" label="Inner Tab A (leaf_a.xml)"
                 style="width:220px;height:28px;" disabled="false"></w2:tabs>
        <w2:tabs id="inner_tab2" label="Inner Tab B (leaf_b.xml)"
                 style="width:220px;height:28px;" disabled="false"></w2:tabs>

        <w2:content id="content_inner_a" alwaysDraw="true" frameMode="wframe"
                    style="height:280px;" src="tabControl_alwaysDraw_WAEA-861_(WSQ-6323)_leaf_a.xml"></w2:content>
        <w2:content id="content_inner_b" alwaysDraw="true" frameMode="wframe"
                    style="height:280px;" src="tabControl_alwaysDraw_WAEA-861_(WSQ-6323)_leaf_b.xml"></w2:content>
    </w2:tabControl>

</body>
</html>
