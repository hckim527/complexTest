    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header2" style="">
    			<w2:row id="row3" style="">
    				<w2:column blockSelect="false" displayMode="label" id="column9" inputType="text" style="" value="아이디" width="70"></w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="column7" inputType="text" style="" value="성명" width="70"></w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="column5" inputType="text" style="" value="연락처" width="70"></w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="column3" inputType="text" style="" value="지역" width="70"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody2" style="">
