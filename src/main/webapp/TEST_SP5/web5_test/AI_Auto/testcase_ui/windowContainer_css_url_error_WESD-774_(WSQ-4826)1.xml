<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.grd_memberList_onrowindexchange = function(row, oldRow) {
    var id = scwin.$w.parent().dlt_memberList.getCellData(row, "id");
    var name = scwin.$w.parent().dlt_memberList.getCellData(row, "name");
    ibx_idName.setValue("[" + id + "] - " + name);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView applyAllColumnStyle="false" autoFit="allColumn" dataList="data:dlt_memberList" defaultCellHeight="20" id="grd_memberList"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false" scrollByColumn="false" scrollByColumnAdaptive="false"
    		showSortableUseFilter="false" style="height: 150px;" summaryAuto="false" summaryOnlyAuto="false" useFilterList="false"
