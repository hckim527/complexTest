<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
            		<w2:columnInfo></w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
            		<w2:columnInfo>
            			<w2:column id="name" name="name1" dataType="text"></w2:column>
            			<w2:column id="code" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<name><![CDATA[가]]></name>
            				<code><![CDATA[1]]></code>
            			</w2:row>
            			<w2:row>
            				<name><![CDATA[가나]]></name>
            				<code><![CDATA[2]]></code>
            			</w2:row>
            			<w2:row>
            				<name><![CDATA[가나다]]></name>
            				<code><![CDATA[3]]></code>
            			</w2:row>
            			<w2:row>
            				<name><![CDATA[abc]]></name>
            				<code><![CDATA[4]]></code>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList3">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row></w2:row>            			
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    //input1.setValue("가나다라");
};

scwin.typeGetter = function(info){
    var rowIndex = info.rowIndex;
    var colIndex = info.colIndex;

    var returnInfo;

     if(colIndex == "2") {
            returnInfo = {
                id : "dynamic_checkbox_" + rowIndex + "_" + colIndex,
                inputType : "checkbox",
                value : ""                  
            }
        }
        return returnInfo;

};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:autoComplete editType="select" id="autoComp" style="width: 148px;height: 21px;" submenuSize="auto" search="contain" allOption=""
    		chooseOption="" ref="" preserveInputCursorOnHomeEnd="true">
    		<w2:choices>
    			<w2:itemset nodeset="data:dataList2">
    				<w2:label ref="name"></w2:label>
    				<w2:value ref="code"></w2:value>
    			</w2:itemset>
    		</w2:choices>
    	</w2:autoComplete>
    	<xf:input id="input1" style="width: 144px;height: 21px;"></xf:input>
    	<w2:gridView checkAllType="false" id="" style="width:640px;height:309px;" dataList="dataList3">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="column3" value="컬럼1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="컬럼2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column1" value="컬럼3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="checkbox" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="custom" style="" id="col3" value="" displayMode="label" typeGetter="scwin.typeGetter"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
