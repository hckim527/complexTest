         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var row = 40;
		var col = 5;
		var data = [];
		for (var i = 0; i < row; i++) {
			for (var j = 0; j < col; j++) {
				if (j < 3) {
					data.push(i * (j+1));
				} else {
					data.push("i="+i+",j="+j);
				}
				
			}
		}
        dataListt21.setData(data);
        dataListt22.setData(data);
	};
	
	scwin.onpageunload = function() {
		
	};

    scwin.trigger1_onclick = function() {
        textboxt21.setValue("t2 self")
        textboxT1.setValue("t2 to W");
        dataList1.setData(["t2", "t2", "t2", "t2", "t2"]);
        dataList2.setData(["t2F", "t2F", "t2F", "t2F", "t2F"])
        textbox2.setValue("t2 to M")
    }
	
	]]></script>
