        font-family: 'SF Mono', Consolas, monospace;
        font-size: 11px;
        color: #6366f1;
    }

        ]]></style>
    </head>

    <body ev:onpageload="scwin.onpageload">

        <xf:group id="grp_page" class="page_wrap" style="position:relative;width:100%;">

            <!-- ── Header ── -->
            <xf:group id="grp_header" class="header_area" style="position:relative;">
                <w2:textbox id="txt_title" class="header_title" label="TabControl tabSplitAuto Test"/>
                <br/>
                <w2:textbox id="txt_subtitle" class="header_sub"
                    label="탭을 드래그하여 분리(tear-off)하면 별도 창에서 표시되고, 닫으면 자동 복귀됩니다."/>
            </xf:group>

            <!-- ── Info Cards ── -->
            <xf:group id="grp_infoRow" class="info_row" style="position:relative;">
                <xf:group id="grp_card1" class="info_card" style="position:relative;">
                    <w2:textbox class="info_card_label" label="핵심 속성"/>
                    <xf:group style="position:relative;margin-top:6px;">
                        <w2:textbox class="info_card_value"
                            label="tabSplit=&quot;true&quot;  tabSplitAuto=&quot;true&quot;"/>
                    </xf:group>
                </xf:group>
                <xf:group id="grp_card2" class="info_card" style="position:relative;">
                    <w2:textbox class="info_card_label" label="Viewer URL"/>
                    <xf:group style="position:relative;margin-top:6px;">
                        <w2:textbox class="info_card_value"
                            label="websquare/_websquare_/message/splitViewer.html"/>
                    </xf:group>
                </xf:group>
            </xf:group>

            <!-- ── Toolbar ── -->
            <xf:group id="grp_toolbar" class="toolbar_area" style="position:relative;">
                <w2:textbox id="txt_tabLabel" class="toolbar_left" label="Tab Panel"/>
                <xf:group id="grp_toolbarRight" class="toolbar_right" style="position:relative;">
                    <xf:trigger id="btn_addTab" class="btn_modern btn_primary" style="position:relative;" ev:onclick="scwin.btn_addTab_onclick">
                        <xf:label><![CDATA[+ 탭 추가]]></xf:label>
                    </xf:trigger>
                </xf:group>
            </xf:group>

            <!-- ── TabControl ── -->
            <w2:tabControl id="tabControl1" useTabKeyOnly="true" useMoveNextTabFocus="false"
                useConfirmMessage="false" confirmTrueAction="exist" confirmFalseAction="new"
                alwaysDraw="false" style="height:600px;" hiddenTab="false"
                tabMove=""
                tabSplit="true"
                tabSplitAuto="true">
                <w2:tabs disabled="false" style="width:80px;height:30px" label="tab1" id="tabs1"></w2:tabs>
                <w2:tabs disabled="false" style="width:80px;height:30px" label="tab2" id="tabs2"></w2:tabs>
                <w2:tabs disabled="false" style="width:80px;height:30px" label="tab3" id="tabs3"></w2:tabs>
                <w2:tabs disabled="false" style="width:80px;height:30px" label="tab4" id="tabs4"></w2:tabs>
                <w2:content frameMode="wframe" alwaysDraw="false" style="height:570px" id="content1" src="tabControl_tabSplitAuto_WAEA-741_(WSQ-6227)_sub.xml" scope="true" closable="true"></w2:content>
                <w2:content frameMode="wframe" alwaysDraw="false" style="height:570px" id="content2" src="tabControl_tabSplitAuto_WAEA-741_(WSQ-6227)_sub.xml" scope="true" closable="true"></w2:content>
                <w2:content frameMode="wframe" alwaysDraw="false" style="height:570px" id="content3" src="tabControl_tabSplitAuto_WAEA-741_(WSQ-6227)_sub.xml" scope="true" closable="true"></w2:content>
                <w2:content frameMode="wframe" alwaysDraw="false" style="height:570px" id="content4" src="tabControl_tabSplitAuto_WAEA-741_(WSQ-6227)_sub.xml" scope="true" closable="true"></w2:content>
            </w2:tabControl>

            <!-- ── Guide ── -->
            <xf:group id="grp_guide" class="guide_area" style="position:relative;">
                <w2:textbox id="txt_guideTitle" class="guide_title" label="How to Test"/>
                <ul class="guide_list">
                    <li>탭을 <strong>드래그</strong>하여 TabControl 영역 밖으로 끌어내면 별도 창으로 분리됩니다.</li>
                    <li>분리된 창의 <span class="guide_key">복귀</span> 버튼을 클릭하거나 창을 닫으면 원래 탭으로 자동 복귀합니다.</li>
                </ul>
            </xf:group>

        </xf:group>

    </body>
</html>
