    }
    .guide_list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .guide_list li {
        position: relative;
        padding: 8px 0 8px 20px;
        font-size: 13px;
        color: #4b5563;
        line-height: 1.5;
        border-bottom: 1px solid #f3f4f6;
    }
    .guide_list li:last-child {
        border-bottom: none;
    }
    .guide_list li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 14px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
