        <script lazy="false" type="text/javascript" src="../../w_sharing.js"></script>
        <script type="javascript" lazy="false"><![CDATA[

    scwin.onpageload = function() {
        // tabSplitAuto="true" — 엔진이 자동 처리하므로 수동 코드 불필요
    };

    scwin.btn_addTab_onclick = async function() {
        var idx = tabControl1.getTabCount();
        var tabId = "dynTab" + (idx + 1);
        var tabOpt = {openAction: "select", label: "Tab " + (idx + 1), tabWidth: 80};
        var contOpt = {src: "tabControl_tabSplitAuto_WAEA-741_(WSQ-6221)_sub", closable: true, frameMode: "wframe", scope: true};
        await tabControl1.addTab(tabId, tabOpt, contOpt);
    };

        ]]></script>

        <style type="text/css"><![CDATA[

    /* ─── Page ─── */
    .page_wrap {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        padding: 24px;
        box-sizing: border-box;
    }

    /* ─── Header ─── */
    .header_area {
        margin-bottom: 20px;
    }
    .header_title {
        font-size: 22px;
        font-weight: 700;
        color: #1a1a2e;
        letter-spacing: -0.3px;
    }
    .header_sub {
        font-size: 13px;
        color: #6b7280;
        margin-top: 4px;
    }
    /* ─── Info Cards ─── */
    .info_row {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
    }
    .info_card {
        flex: 1;
        background: #fff;
        border-radius: 10px;
