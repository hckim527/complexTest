<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            			<w2:column id="depth" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[메뉴1]]></label>
            				<value><![CDATA[1]]></value>
            				<depth><![CDATA[1]]></depth>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[메뉴2]]></label>
            				<value><![CDATA[2]]></value>
            				<depth><![CDATA[1]]></depth>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            			<w2:column id="depth" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[메뉴1]]></label>
            				<value><![CDATA[1]]></value>
            				<depth><![CDATA[1]]></depth>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[메뉴2]]></label>
            				<value><![CDATA[2]]></value>
            				<depth><![CDATA[1]]></depth>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    var saveDataJson = [{
        "label": "new",
        "value": "3",
        "depth": "1"
    }];
    dataList1.insertJSON(2, saveDataJson);
};
scwin.trigger2_onclick = function(e) {
    var saveDataJson = {
        "label": "new",
        "value": "3",
        "depth": "1"
    };
    dataList2.setRowJSON(treeview2.tree.nodeCount - 1, saveDataJson);
};
scwin.treeview1_onlabelclick = function(value, nodeElement, index) {
    alert(treeview1.getSelectedValue());
};
scwin.treeview2_onlabelclick = function(value, nodeElement, index) {
    alert(treeview2.getSelectedValue());
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="padding:20px;height:100%;">
    	<xf:group id="" style="height:213px;width:200px;float:left;">
    		<w2:textbox id="" style="position: relative;width:200px;font-weight:bold;" label="insertJSON"></w2:textbox>
    		<w2:treeview id="treeview1" dataType="listed" style="position: relative;width: 200px;height: 200px;" lineShow="" useDrag=""
    			tooltipGroupClass="false" ev:onlabelclick="scwin.treeview1_onlabelclick">
    			<w2:itemset nodeset="data:dataList1">
    				<w2:label ref="label"></w2:label>
    				<w2:value ref="value"></w2:value>
    				<w2:depth ref="depth"></w2:depth>
    				<w2:folder ref=""></w2:folder>
    				<w2:checkbox ref=''></w2:checkbox>
    				<w2:checkboxDisabled ref=''></w2:checkboxDisabled>
    				<w2:image ref=""></w2:image>
    				<w2:iconImage ref=''></w2:iconImage>
    				<w2:selectedImage ref=""></w2:selectedImage>
    				<w2:expandedImage ref=""></w2:expandedImage>
    				<w2:leafImage ref=""></w2:leafImage>
    			</w2:itemset>
    		</w2:treeview>
    		<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    			<xf:label><![CDATA[메뉴 추가]]></xf:label>
    		</xf:trigger>
    	</xf:group>
    	<xf:group id="" style="height:213px;width:200px;float:left;margin-left:15px;">
    		<w2:textbox id="" style="position: relative;width:200px;font-weight:bold;" label="setRowJSON"></w2:textbox>
    		<w2:treeview id="treeview2" dataType="listed" style="position: relative;width: 200px;height: 200px;" lineShow="" useDrag=""
    			tooltipGroupClass="false" ev:onlabelclick="scwin.treeview2_onlabelclick">
    			<w2:itemset nodeset="data:dataList2">
    				<w2:label ref="label"></w2:label>
    				<w2:value ref="value"></w2:value>
    				<w2:depth ref="depth"></w2:depth>
    				<w2:folder ref=""></w2:folder>
    				<w2:checkbox ref=""></w2:checkbox>
    				<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
    				<w2:image ref=""></w2:image>
    				<w2:iconImage ref=""></w2:iconImage>
    				<w2:selectedImage ref=""></w2:selectedImage>
    				<w2:expandedImage ref=""></w2:expandedImage>
    				<w2:leafImage ref=""></w2:leafImage>
    			</w2:itemset>
    		</w2:treeview>
    		<xf:trigger type="button" id="trigger2" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
    			<xf:label><![CDATA[메뉴 추가]]></xf:label>
    		</xf:trigger>
    	</xf:group></xf:group></body>
</html>
 