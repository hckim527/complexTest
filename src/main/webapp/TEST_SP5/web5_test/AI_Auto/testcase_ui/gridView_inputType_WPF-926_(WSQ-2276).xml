<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="main" name="main" dataType="text"></w2:column>
            			<w2:column id="select" name="select" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<select><![CDATA[1]]></select>
            				<main><![CDATA[가]]></main>
            			</w2:row>
            			<w2:row>
            				<select><![CDATA[2]]></select>
            				<main><![CDATA[나]]></main>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dlt_select" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="CD" name="name1" dataType="text"></w2:column>
            			<w2:column id="CD_NM" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<CD><![CDATA[1]]></CD>
            				<CD_NM><![CDATA[가]]></CD_NM>
            			</w2:row>
            			<w2:row>
            				<CD><![CDATA[2]]></CD>
            				<CD_NM><![CDATA[나]]></CD_NM>
            			</w2:row>
            			<w2:row>
            				<CD><![CDATA[3]]></CD>
            				<CD_NM><![CDATA[다]]></CD_NM>
            			</w2:row>
            			<w2:row>
            				<CD><![CDATA[4]]></CD>
            				<CD_NM><![CDATA[라]]></CD_NM>
            			</w2:row>
            			<w2:row>
            				<CD><![CDATA[5]]></CD>
            				<CD_NM><![CDATA[마]]></CD_NM>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" id="" style="position: relative;width: 500px;height: 150px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false" fixedColumnWithHidden="true" useShiftKey="true" copyOption="display">
    		<w2:header id="header1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column7" style="height:20px;" inputType="text" width="70" displayMode="label"
    					value="main">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px;" width="120" inputType="text" displayMode="label"
    					value="select">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody4" style="">
    			<w2:row id="row5" style="">
    				<w2:column blockSelect="false" id="main" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="select" style="height:20px" width="120" inputType="select" displayMode="label"
    					allOption="" chooseOption="">
    					<w2:choices>
    						<w2:itemset nodeset="data:dlt_select">
    							<w2:label ref="CD_NM"></w2:label>
    							<w2:value ref="CD"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 