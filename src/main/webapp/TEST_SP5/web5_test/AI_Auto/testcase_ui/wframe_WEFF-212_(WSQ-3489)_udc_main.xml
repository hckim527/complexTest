}
scwin.onpageload = function() {
    $p.log("main" + "_onpageload");
    for (var i = 1; i <= 5; i++) {
        try {
            $p.executeSubmission("submission" + i);
            if ($p.getSubmission("submission" + i) != null) {
                scwin.submitCnt++;
            }
        } catch (e) {
            $p.log("Error occurs at " + i);
        }
    }
}
scwin.onsubmitdone = function() {
    scwin.submitCnt--;
    if (scwin.submitCnt <= 0) {
        for (var i = 1; i <= 5; i++) {
            try {
                $p.getComponentById("udc_input" + i).set($p.id + i);
            } catch (e) {
                $p.log("Error occurs at " + i);
            }
        }
    }
}
scwin.trigger1_onclick = function() {
    common.viewCollection($p);
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.submitCnt = 0;
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
