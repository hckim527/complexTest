<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="number"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[1111122222]]></col1>
            				<col2><![CDATA[2]]></col2>
            				<col3><![CDATA[3]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[2222233333]]></col1>
            				<col2><![CDATA[3]]></col2>
            				<col3><![CDATA[4]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[3]]></col1>
            				<col2><![CDATA[4]]></col2>
            				<col3><![CDATA[5]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    alert("column5 Header rowspan : " + gridView1.getHeaderSpan("column5", "row"));
    alert("column5 Header colspan : " + gridView1.getHeaderSpan("column5", "col"));
};
scwin.trigger2_onclick = function(e) {
    alert("column9 Header rowindex : " + gridView1.getHeaderRowIndex("column9"));
    alert("column9 Header colindex : " + gridView1.getHeaderColIndex("column9"));
};
scwin.trigger3_onclick = function(e) {
    alert("Header inputType : " + gridView1.getHeaderInputType("column1"));
    alert("Header value : " + gridView1.getHeaderValue("column1"));
};
scwin.trigger4_onclick = function(e) {
    alert("col2 ColumnID : " + gridView1.getColumnID(1));
    alert("col2 ColumnIndex : " + gridView1.getColumnIndex("col2"));
    //alert("10자리의 값을 5자리만 가져온다.");
    gridView1.setMaxLength(1, 5);
    alert("col2 MaxLength : " + gridView1.getMaxLength(1));
};
scwin.trigger5_onclick = function(e) {
    alert("Col3 DataTyp : " + gridView1.getDataType(2));
    gridView1.setDataType(2, "text");
    alert("Col3 DataTyp : " + gridView1.getDataType(2));
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20" id="gridView1"
    		style="position: relative;width:574px;height:165px;" fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5" style="" inputType="text" width="70" value="column5" colSpan="3"
    					rowSpan="2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="name2"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="name3"></w2:column>
    			</w2:row>
    			<w2:row id="row3" style="">
    				<w2:column blockSelect="false" id="column9" style="height:20px;" width="70" inputType="text" value="column9"></w2:column>
    				<w2:column blockSelect="false" id="column8" style="height:20px;" width="70" inputType="checkbox" value="Type"></w2:column>
    				<w2:column blockSelect="false" id="column7" style="height:20px;" width="70" inputType="text" value="name6"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" width="70" inputType="text"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="position: relative;width:155px;height:41px;left:13px;top:109px;text-align:left;vertical-align:middle;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[SKT545(Header Span)]]></xf:label>
    	</xf:trigger><xf:trigger type="button" id="trigger2" style="position: relative;width:172px;height:42px;left:-145px;top:55px;text-align:left;vertical-align:middle;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[SKT546(Header Rowindex)]]></xf:label>
    	</xf:trigger><xf:trigger type="button" id="trigger3" style="position: relative;width:162px;height:41px;left:-316px;top:161px;text-align:left;vertical-align:middle;" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[SKT547(Header InputType)]]></xf:label>
    	</xf:trigger><xf:trigger type="button" id="trigger4" style="position: relative;width:269px;height:38px;left:-477px;top:219px;text-align:left;vertical-align:middle;" ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[SKT548(setMaxLength, getMaxLength)]]></xf:label>
    	</xf:trigger><xf:trigger type="button" id="trigger5" style="position: relative;width:161px;height:38px;left:-748px;top:3px;text-align:left;vertical-align:middle;" ev:onclick="scwin.trigger5_onclick">
    		<xf:label><![CDATA[SKT543(gridview edit)]]></xf:label>
    	</xf:trigger>
    	
    	
    	
    	
    </body>
</html>
 