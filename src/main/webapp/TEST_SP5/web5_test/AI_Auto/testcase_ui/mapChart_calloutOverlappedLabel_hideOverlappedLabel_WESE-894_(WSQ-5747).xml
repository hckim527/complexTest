<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
            scwin.onpageload = function() {

            };

            scwin.mapchart1_setTooltipStrFunc = function(name, code){

                return "<b style='color:#333;font-size:13px'>[" + name + " (code " + code + ")]</b>";
            }

            scwin.mapchart1_calloutLabelExceptionHandler = function() {
                //var exceptionList = ["11", "34"];
                //var exceptionList = ["서울특별시", "충청남도"];
                var exceptionList = ["11", "충청남도", "의왕시"];

                return exceptionList;
            }
            scwin.mapchart1_hideLabelExceptionHandler = function() {
                var exceptionList = ["11", "충청남도", "성남시 분당구", "의왕시", "군포시", "안산시 상록구"];

                return exceptionList;
            }
            
        ]]></script>
		<style type="text/css"><![CDATA[
			.w2mapchart_tooltip .kv{
			    background:#FFF0F0;
			    border-radius:5px;
			    font-size:12px;
			    padding:4px;
			    color:white;
			}
			.w2mapchart_marker_tooltip {
				display: inline-block;
			    border: 1px solid black;
			    border-radius: 5px;
			    padding: 5px;
			    background: #DCEBFF;
			}
            .wrap{ padding: 10px;height:100%;}
            .d_flex{ display: flex;}
            
            .callout_line_test {
                stroke: gray;
                stroke-width: 0.5px;
                stroke-dasharray: 7 3;
            }
            .callout_circle_test {
                fill: red;             /* 내부 색상을 빨간색으로 설정 */
                stroke: black;         /* 테두리 색상을 검은색으로 설정 */
                stroke-width: 1px;     /* 테두리 두께를 1픽셀로 설정 */
                opacity: 0.8;          /* 투명도를 80%로 설정 */
            }
         ]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="wrap" id="" style="">

			<xf:group class="d_flex" id="" style="flex-wrap: wrap;">
				<xf:group class="" id="" style="padding-left:10px;">

					<xf:group class="d_flex" id="" style="flex-wrap: wrap;">

                        <xf:group class="" id="" style="width:650px;height:590px;border: 1px solid #BDBDBD;">
                            <w2:mapchart id="mapchart1" style="width:100%;height:100%;" 
                                dataMapRatio_level0="simp1"
                                dataMapRatio_level1="simp1" 
                                dataMapRatio_level2="simp1" 
                                useMarker="" 
                                setTooltipStrFunc="scwin.mapchart1_setTooltipStrFunc"
                                event_zoom="none" 
                                calloutOverlappedLabel="true"
                                calloutLabelExceptionHandler="scwin.mapchart1_calloutLabelExceptionHandler"
                                calloutLineClass="callout_line_test"
                                calloutCircleClass="callout_circle_test">
                            </w2:mapchart>
                        </xf:group>
                        <xf:group class="" id="" style="width:650px;height:590px;border: 1px solid #BDBDBD;">
                            <w2:mapchart id="mapchart2" style="width:100%;height:100%;" 
                                dataMapRatio_level0="simp1"
                                dataMapRatio_level1="simp1" 
                                dataMapRatio_level2="simp1" 
                                useMarker="" 
                                setTooltipStrFunc="scwin.mapchart1_setTooltipStrFunc"
                                event_zoom="none" 
                                hideOverlappedLabel="true"
                                hideLabelExceptionHandler="scwin.mapchart1_hideLabelExceptionHandler">
                            </w2:mapchart>
                        </xf:group>
                        
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
