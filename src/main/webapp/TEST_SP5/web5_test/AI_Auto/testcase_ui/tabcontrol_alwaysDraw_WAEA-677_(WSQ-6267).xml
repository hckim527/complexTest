<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {

};
scwin.btn_disable_onclick = function (e) {
    tac_tabcontrol1.disableTab(0);
};


scwin.btn_enable_onclick = function (e) {
    tac_tabcontrol1.enableTab(0);
    tac_tabcontrol1setSelectedTabIndex(0);
};


scwin.trigger3_onclick = function (e) {
      tac_tabcontrol2.disableTab(0);
};

scwin.trigger4_onclick = function (e) {
      tac_tabcontrol2.enableTab(0);
      tac_tabcontrol2.setSelectedTabIndex(0);
};
]]></script>
</head>

    <body ev:onpageload="scwin.onpageload">

    	<w2:textbox id="" label="tabs disabled=false" style="width: 150px;height: 23px;"></w2:textbox>
    	<xf:trigger type="button" id="btn_disable" style="width: 100px;height: 23px;" ev:onclick="scwin.btn_disable_onclick">
    		<xf:label><![CDATA[disableTab(0)]]></xf:label>
    	</xf:trigger>

    	<xf:trigger id="btn_enable" style="width: 100px;height: 23px;margin-left:5px;" type="button"
    		ev:onclick="scwin.btn_enable_onclick">
    		<xf:label><![CDATA[enableTab(0)]]></xf:label>
    	</xf:trigger>

    	<xf:group id="" class="tbcbox">
    		<w2:tabControl alwaysDraw="true" style="width:700px;height:200px;border: #00ff00 solid 1px;" id="tac_tabcontrol1"
    			class="tbc tbc_status">

    			<w2:tabs style="height:40px;" id="tabs1" label="Tabs1" disabled="false"></w2:tabs>
    			<w2:tabs disabled="false" style="height:40px;" id="tabs3" label="Tabs2"></w2:tabs>

    			<w2:content style="" id="content1">
    				<xf:input id="ibx_test" style="width: 144px;" disabled="true"></xf:input>
    			</w2:content>

    			<w2:content style="" id="content3"></w2:content>

    		</w2:tabControl>

    	</xf:group>

    	<w2:textbox style="width: 150px;height: 23px;" id="" label="tabs disabled=true"></w2:textbox>
    	<xf:trigger id="trigger3" style="width: 100px;height: 23px;" type="button" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[disableTab(0)]]></xf:label>
    	</xf:trigger>
    	<xf:trigger id="trigger4" style="width: 100px;height: 23px;margin-left:5px;" type="button" ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[enableTab(0)]]></xf:label>
    	</xf:trigger>
    	<w2:tabControl alwaysDraw="true" class="tbc tbc_status" id="tac_tabcontrol2"
    		style="width:700px;height:200px;border: #00ff00 solid 1px;">
    		<w2:tabs disabled="true" id="tabs4" label="Tabs1" style="height:40px;"></w2:tabs>
    		<w2:tabs disabled="true" id="tabs5" label="Tabs2" style="height:40px;"></w2:tabs>
    		<w2:content id="content4" style="">
    			<xf:input disabled="true" id="input1" style="width: 144px;"></xf:input>
    		</w2:content>
    		<w2:content id="content5" style=""></w2:content>
    	</w2:tabControl>
    </body>
</html>