<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[0]]></col1>
            				<col2><![CDATA[0]]></col2>
            				<col3><![CDATA[0]]></col3>
            			</w2:row>
            			<w2:row>
            				<col3><![CDATA[0]]></col3>
            				<col1><![CDATA[0]]></col1>
            				<col2><![CDATA[0]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[0]]></col1>
            				<col2><![CDATA[0]]></col2>
            				<col3><![CDATA[0]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.customFormatter = function(val) {
    for (var i = 0; i < val.length; i++) {
        if (val[i] == ",") {
            val = val.substring(0, i) + val.substring(i + 1);
        }
    }
    return val;
}
scwin.customUnformatter = function(val) {
    var dotPos;
    for (var i = 0; i < val.length; i++) {
        if (val[i] == ".") {
            dotPos = i;
            break;
        }
    }
    dotPos -= 3;
    while (dotPos > 0) {
        val = val.substring(0, dotPos) + "," + val.substring(dotPos);
        dotPos -= 3;
    }
    return val;
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="data:dataList1" summaryAuto="false" useFilterList="false" applyAllColumnStyle="false" scrollByColumn="false"
    		showSortableUseFilter="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1"
    		style="position: absolute;width:599px;height:191px;left:12px;top:44px;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		summaryOnlyAuto="false" useShiftKey="true" autoFit="allColumn">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="#,###,##0.00" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col3" style="" width="70" inputType="text" value="" displayMode="label"
    					maskFormat="reverse" displayFormat="#,###,##0.00" applyFormat="all" dataType="number"
                        customModelFormatter="scwin.customFormatter" customModelUnformatter="scwin.customUnformatter">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox label='maskFormat="reverse" dataType="number" applyFormat="all"' id="" style="position: absolute;width:532px;height:23px;left:14px;top:17px;"></w2:textbox>
    
    </body>
