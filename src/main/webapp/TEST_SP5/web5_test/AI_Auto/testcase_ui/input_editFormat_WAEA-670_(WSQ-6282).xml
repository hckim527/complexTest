<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="128 217">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                	<checkbox>
                		<res></res>
                	</checkbox>
                </data>
            </xf:instance>
			<w2:dataCollection baseNode="map">
            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
						<w2:key id="key2" name="name2" dataType="text"></w2:key>
            			<w2:key id="key3" name="name3" dataType="text"></w2:key>
            			<w2:key id="key4" name="name4" dataType="text"></w2:key>
            		</w2:keyInfo>
            		<w2:data use="true">
            			<key1><![CDATA[1234SSSSXXXXAAAAaaaaZZZZzzzz*]]></key1>
            			<key2><![CDATA[]]></key2>
            		</w2:data>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript"><![CDATA[
		scwin.onpageload = function() {

			//input1.setValue("abc0123aa"); // -> abc_123_
			//input1.setValue("/ab-c0/12-3a/"); // -> abc_123_
		};
		scwin.input1_onchange = function(e) {
			//console.log("input1.getDisplayValue:", input1.getDisplayValue());
			console.log("input1.getFormattedValue:", input1.getFormattedValue());
			console.log("input1.getValue:", input1.getValue());
			console.log("dataMap1.get('key1') : " + dataMap1.get('key1'));
		};
		scwin.trigger0_onclick = function() {
			input1.setEditFormat("");
		}
		scwin.trigger1_onclick = function() {
			//input1.setEditFormat("##-##"); // 기존 값이 있다면 그 중 유효한 값만 세팅
			input1.setEditFormat("##-SS");
		}
		scwin.trigger2_onclick = function() {
			var result = input1.getEditFormat();
			console.log("getEditFormat : " + result);
		}
		scwin.trigger3_onclick = function() {
			input1.setEditPlaceholderChar("");
		}
		scwin.trigger4_onclick = function() {
			var result = input1.getEditPlaceholderChar();
			console.log("getEditPlaceholderChar : " + result);
		}
		scwin.trigger5_onclick = function() {
			input1.setValue("9999test");
		}
		scwin.trigger6_onclick = function() {
			var result = input1.getValue();
			console.log("getValue : " + result);
		}
		scwin.trigger7_onclick = function() {
			var result = input1.getFormattedValue();
			console.log("getFormattedValue : " + result);
		}
		scwin.trigger8_onclick = function(e) {
			dataMap1.set("key1", "9999test");
		}
		scwin.trigger9_onclick = function(e) {
			var result = dataMap1.get("key1");
			console.log("dataMap1.get('key1') : " + result);
		}

	]]></script>
	<style type="text/css"><![CDATA[
	    .inputClass{
	        width: 200px;
			height: 40px;
			font-size:16px;
			border:1px solid #cbd1d4;
			font-family: 'Consolas', 'Courier New', monospace;
			padding: 0 10px;
			letter-spacing: 0.05em;
			text-align: center;
			display:block;
			margin-bottom: 10px;
	    }
	]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">

		<xf:group class="sub_cont" id="" style="padding:10px">

			<w2:textbox label='editFormat="####/SSSS/XXXX/AAAA/aaaa/ZZZZ/zzzz/****" ref="data:dataMap1.key1"' style="position:relative;width:250px;font-size: 13px;" id=""></w2:textbox>
			<xf:input adjustMaxLength="false" id="input1" class="inputClass" style="position:relative;width:420px;"
				ref="data:dataMap1.key1"

				editFormat="####/SSSS/XXXX/AAAA/aaaa/ZZZZ/zzzz/****"
				editFormatParticalMask="true" 
				initValue=""
				
				editPlaceholderChar="_"
				editDisplayChar=""

				ev:onchange="scwin.input1_onchange"
				>
			</xf:input>
			<w2:textbox label='editFormat="{####}||####-####||{####}-####-{####}" editDisplayChar="*"' style="position:relative;width:400px;font-size: 13px;" id=""></w2:textbox>
			<xf:input adjustMaxLength="false" id="input2" class="inputClass" style="position:relative;width:250px;"

				editFormat="{####}||####-####||{####}-####-{####}"
				editFormatParticalMask="true" 
				initValue=""
				
				editPlaceholderChar=""
				editDisplayChar="*"

				>
			</xf:input>
			<w2:textbox label='editFormat="######-#{######}" editDisplayChar="*"' style="position:relative;width:250px;font-size: 13px;" id=""></w2:textbox>
			<xf:input adjustMaxLength="false" id="input3" class="inputClass"

				editFormat="######-#{######}"
				editFormatParticalMask="true" 
				initValue=""
				
				editPlaceholderChar=""
				editDisplayChar="*"
				>
			</xf:input>
			<w2:textbox label='editFormat="######-#{######}" editDisplayChar="*" editPlaceholderChar="_"' style="position:relative;width:250px;font-size: 13px;" id=""></w2:textbox>
			<xf:input adjustMaxLength="false" id="input4" class="inputClass"

				editFormat="######-#{######}"
				editFormatParticalMask="true" 
				initValue="1234567890"
				
				editPlaceholderChar="_"
				editDisplayChar="*"
				>
			</xf:input>
			<w2:textbox label='editFormat="####-####-####-####" editPlaceholderChar="_"' style="position:relative;width:250px;font-size: 13px;" id=""></w2:textbox>
			<xf:input adjustMaxLength="false" id="input5" class="inputClass"
				
				editFormat="####-####-####-####"
				editFormatParticalMask="true" 
				initValue=""
				
				editPlaceholderChar="_"
				editDisplayChar=""
				>
			</xf:input>
			<w2:textbox label='editFormat="####-####-####-{####}" editDisplayChar="*" editPlaceholderChar="_" editFormatParticalMask="true"' style="position:relative;width:250px;font-size: 13px;" id=""></w2:textbox>
			<xf:input adjustMaxLength="false" id="input6" class="inputClass"
				
				editFormat="####-####-####-{####}"
				editFormatParticalMask="true" 
				initValue=""
				
				editPlaceholderChar="_"
				editDisplayChar="*"
				>
			</xf:input>
			<w2:textbox label='editFormat="####-####-####-{####}" editPlaceholderChar="_" editDisplayChar="*" editFormatParticalMask="false"' style="position:relative;width:250px;font-size: 13px;" id=""></w2:textbox>
			<xf:input adjustMaxLength="false" id="input7" class="inputClass"
				
				editFormat="####-####-####-{####}"
				editFormatParticalMask="false" 
				
				editPlaceholderChar="_"
				editDisplayChar="*"
				>
			</xf:input>


			<xf:trigger type="" style="width:220px;height:30px;display:block;" id="trigger0"
				ev:onclick="scwin.trigger0_onclick" >
				<xf:label><![CDATA[input1.setEditFormat("")]]></xf:label>
			</xf:trigger>

			<xf:trigger type="" style="width:220px;height:30px;display:block;" id="trigger1"
				ev:onclick="scwin.trigger1_onclick" >
				<xf:label><![CDATA[input1.setEditFormat("##-SS")]]></xf:label>
			</xf:trigger>

			<xf:trigger type="" style="width:220px;height:30px;display:block;" id="trigger2"
				ev:onclick="scwin.trigger2_onclick" >
				<xf:label><![CDATA[input1.getEditFormat()]]></xf:label>
			</xf:trigger>

			<xf:trigger type="" style="width:220px;height:30px;display:block;" id="trigger3"
				ev:onclick="scwin.trigger3_onclick" >
				<xf:label><![CDATA[input1.setEditPlaceholderChar("")]]></xf:label>
			</xf:trigger>

			<xf:trigger type="" style="width:220px;height:30px;display:block;" id="trigger4"
				ev:onclick="scwin.trigger4_onclick" >
				<xf:label><![CDATA[input1.getEditPlaceholderChar()]]></xf:label>
			</xf:trigger>

			<xf:trigger type="" style="width:220px;height:30px;display:block;" id="trigger5"
				ev:onclick="scwin.trigger5_onclick" >
				<xf:label><![CDATA[input1.setValue("9999test");]]></xf:label>
			</xf:trigger>

			<xf:trigger type="" style="width:220px;height:30px;display:block;" id="trigger6"
				ev:onclick="scwin.trigger6_onclick" >
				<xf:label><![CDATA[input1.getValue();]]></xf:label>
			</xf:trigger>

			<xf:trigger type="" style="width:220px;height:30px;display:block;" id="trigger7"
				ev:onclick="scwin.trigger7_onclick" >
				<xf:label><![CDATA[input1.getFormattedValue();]]></xf:label>
			</xf:trigger>

			<xf:trigger type="" style="width:220px;height:30px;display:block;" id="trigger8"
				ev:onclick="scwin.trigger8_onclick" >
				<xf:label><![CDATA[dataMap1.set("key1", "9999test");]]></xf:label>
			</xf:trigger>

			<xf:trigger type="" style="width:220px;height:30px;display:block;" id="trigger9"
				ev:onclick="scwin.trigger9_onclick" >
				<xf:label><![CDATA[dataMap1.get("key1");]]></xf:label>
			</xf:trigger>

		</xf:group>
    </body>
</html>
