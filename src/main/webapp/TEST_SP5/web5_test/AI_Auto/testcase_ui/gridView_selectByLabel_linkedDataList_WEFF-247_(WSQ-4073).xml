<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false">
            			<w2:row>
            				<col2><![CDATA[a]]></col2>
            				<col1><![CDATA[1]]></col1>
            				<col3><![CDATA[a-label]]></col3>
            			</w2:row>
            			<w2:row>
            				<col2><![CDATA[b]]></col2>
            				<col1><![CDATA[2]]></col1>
            				<col3><![CDATA[a-label]]></col3>
            			</w2:row>
            			<w2:row>
            				<col2><![CDATA[c]]></col2>
            				<col1><![CDATA[3]]></col1>
            				<col3><![CDATA[a-label]]></col3>
            			</w2:row>
            			<w2:row></w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="sel_data" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:linkedDataList bind="sel_data" id="linkedDataList1">
            		<w2:condition type="filter"><![CDATA[]]></w2:condition>
            		<w2:condition type="sort"><![CDATA[]]></w2:condition>
            	</w2:linkedDataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    var jsonData = [{
            "label": "a-label",
            "value": "a"
        },
        {
            "label": "b-label",
            "value": "b"
        },
        {
            "label": "c-label",
            "value": "c"
        }
    ];
    sel_data.setJSON(jsonData);
    var data = [{
            "col1": "1",
            "col2": "a",
            "col3": "a-label"
        },
        {
            "col1": "2",
            "col2": "b",
            "col3": "b-label"
        },
        {
            "col1": "3",
            "col2": "c",
            "col3": "c-label"
        }
    ];
    dataList1.setJSON(data);
};
scwin.gridView1_onkeyup = function(e) {};
scwin.onpageload = function() {
    scwin.init();
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList1"
    		ev:onkeyup="scwin.gridView1_onkeyup" fixedColumnWithHidden="true"
    		id="gridView4" ignoreCellClick="false"
    		ignoreToggleOnDisabled="false" scrollByColumn="false"
    		scrollByColumnAdaptive="false" showSortableUseFilter="false"
    		style="position: relative;width: 500px;height: 150px;"
    		summaryAuto="false" summaryOnlyAuto="false" useFilterList="false"
    		useShiftKey="true" copyOption="display" selectByLabel="true">
    		<w2:caption id="caption1" style=""
    			value="this is a grid caption.">
    		</w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" displayMode="label"
    					id="column5" inputType="text" style="height:20px" value="name1"
    					width="70">
    				</w2:column>
    				<w2:column blockSelect="false" displayMode="label"
    					id="column3" inputType="text" style="height:20px" value="name2"
    					width="70">
    				</w2:column>
    				<w2:column blockSelect="false" displayMode="label"
    					id="column1" inputType="text" style="height:20px" value="name3"
    					width="70">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" displayMode="label"
    					id="col1" inputType="text" style="height:20px" width="70">
    				</w2:column>
    				<w2:column allOption="" blockSelect="false" chooseOption="" displayMode="label" id="col2" inputType="select"
    					style="height:20px" width="70" ref="">
    					<w2:choices>
    						<w2:itemset nodeset="data:linkedDataList1">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" displayMode="label"
    					id="col3" inputType="text" style="height:20px" width="70">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 