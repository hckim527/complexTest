<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
	
		
		//config.xml파일 적용
        <w2:config>      
            <WebSquare>
                <submission>
                    <preSubmitFunction value="scwin.setReqHeader" />
                </submission>
            </WebSquare>
        </w2:config>
		
	
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[2]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[4]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
			<xf:submission id="submission1" withCredentials="true" ref='data:json,{"id":"dataList1","action":"all"}' target="" action="/posts.json"
				method="post" mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
				 ev:submit="" ev:submitdone="scwin.submission1_submitdone" abortTrigger="true" ev:submiterror="" processMsg="">
			</xf:submission>
			<xf:submission id="submission2" ref='data:json,{"action":"all","id":"dataList2"}' target="" action="/posts2.json" method="post" mediatype="application/json"
				encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" ev:submit="scwin.submission2_submit"
				ev:submitdone="scwin.submission2_submitdone" ev:submiterror="" abortTrigger="" processMsg="">
			</xf:submission>
		</xf:model>
		<script type="text/javascript"><![CDATA[
scwin.trigger1_onclick = function(e) {
	WebSquare.layer.showProcessMessage("submission1~~~");
	$p.executeSubmission( "submission1" );
};			
				
scwin.trigger2_onclick = function(e) {
	WebSquare.layer.showProcessMessage("submission2~~~");
	$p.executeSubmission( "submission2" );
};

scwin.submission1_submitdone = function(e) {
	WebSquare.layer.hideProcessMessage("submission1~~~");
};

scwin.submission2_submitdone = function(e) {
	WebSquare.layer.hideProcessMessage("submission2~~~");
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" id="trigger1" style="position: absolute ;left: 175px;top: 94px;width: 197px;height: 40px;"
			timeout="60000" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[submission1]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger2"
			timeout="60000" style="position:absolute;left:178px;top:166px;width:197px;height:40px;" type="button" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[submission2]]></xf:label>
		</xf:trigger>
	</body>
</html>
