/**************************************************************************
 * 함 수 명: scwin.fnGetType
 * 기 능: 그리드 inputType getter
 **************************************************************************/
scwin.fnGetType = function(info) {
	let objReturnInfo;
	switch (info.colID) {
		// 선택
		case "chk" :
			let sInputType, bReadOnly;
			const sNew = dsSubList.getCellData(info.rowIndex, "new");

			// Y 가 아니면
			if (sNew != "Y") {
				sInputType = "text";
				bReadOnly = true;
			}
			else {
				sInputType = "checkbox";
				bReadOnly = false;
			}

			console.log(info)
			objReturnInfo = {
				id : "dynamic_" + sInputType + "_" + info.rowIndex + "_" + info.colIndex,
				inputType : sInputType,
				options : {
					readOnly: bReadOnly
				},
			};
			break;

		default:
			break;
	}
	return objReturnInfo;
};

scwin.dsMainList_onrowpositionchange = function(info) {
	const nRow = dsMainList.getRowPosition();

	//debugger;
	// 필터
	dsSubList.clearFilter();
	console.clear();
	dsSubList.setColumnFilter({
		type: "row",
		colIndex: "no",
		key: dsMainList.getCellData(nRow, "no"),
		condition: "and",
		exactMatch: true,
	});
};

scwin.btnRemoveFilter_onclick = function() {
	grdMain.removeFocusedCell();
	dsSubList.clearFilter();
};
