scwin.onpageload = function() {

};

scwin.autoComplete1_onchange = function (info) {
    //  console.log(tmp.replace(/&nbsp;/g, ' ').replace(/\s+/g, ' '));
    var tmp=autoComplete1.getText();
    console.log(tmp.replace(/&amp;nbsp;/g, '&nbsp;').replace(/&nbsp;/g, ' '));
