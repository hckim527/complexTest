};  


// 버튼 클릭 여부 체크용 변수
scwin.isTriggerClicked = false;

// 버튼을 누르는 시점(false->true->버튼클릭 이벤트->false)
scwin.btn_trigger_onmousedown = function(e) {
    scwin.isTriggerClicked = true; // 버튼 누름 표시 확인
};

// 3. Input의 blur (mousedown 직후 발생)
scwin.input1_onblur = function(e) {
   // debugger;
    alert("onblur 이벤트");
    //버튼 클릭 여부 확인
     if (scwin.isTriggerClicked) {
        scwin.trigger1_onmouseup();
        scwin.isTriggerClicked = false;
        return;
     }
     else{
        scwin.isTriggerClicked = false;
        return;
     }

};

// 4. 버튼의 mouseup 또는 click (마지막에 발생)
scwin.trigger1_onmouseup = function(e) {
   // debugger;
    alert("마우스 업 실행");
    scwin.isTriggerClicked = false;
};
scwin.trigger2_onclick = function (e) {
      var excelOpt = {}; 
	excelOpt.type = "1"; 
    excelOpt.useStyle = "true";
    excelOpt.useDataFormat = "true";
    excelOpt.fileName="test.xlsx";
    excelOpt.useClass = "true";
	gridView3.advancedExcelDownload(excelOpt);
};
]]></script>
