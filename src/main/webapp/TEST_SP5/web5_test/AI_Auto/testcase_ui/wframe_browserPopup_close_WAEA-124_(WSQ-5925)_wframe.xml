<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
                <w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                        <w2:column id="col5" name="name5" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
    if (!WebSquare.uiplugin.popup) {
        requires("uiplugin.popup");
    }
	scwin.onpageload = function() {
		var row = 40;
		var col = 5;
		var data = [];
		for (var i = 0; i < row; i++) {
			for (var j = 0; j < col; j++) {
				if (j < 3) {
					data.push(i * (j+1));
				} else {
					data.push("i="+i+",j="+j);
				}
				
			}
		}
		dataList1.setData(data);
        dataList2.setData(data);
	};
	
	scwin.onpageunload = function() {
		
	};

    scwin.cnt = 0;
    scwin.trigger1_onclick = function() {
        scwin.cnt++;
        var value = scwin.cnt % 2 ? "W" : "T";
        var options = {
            id: "popup" + scwin.cnt
            , type: "browserPopup"
            , width: "800px"
            , height: "600px"
            , modal: false
            , resizeEvent: false
            , resizable: false
        };
        var url = "wframe_browserPopup_close_WAEA-124_(WSQ-5925)_" + value + ".xml";
        $p.openPopup(url, options);
    };
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <w2:textbox id="textbox1" style="width: 200px;height: 30px;" label="textbox1"/>
        <w2:textbox id="textbox2" style="width: 200px;height: 30px;" label="textbox2"/>
        <xf:trigger type="button" style="position:relative;width: 210px;height: 30px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
            <xf:label>
                <![CDATA[openPopup]]>
            </xf:label>
        </xf:trigger>
    </body>
</html>
