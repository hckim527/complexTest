<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    icDefault.setValue("20260702");
    icToggle.setValue("20260702");
};
scwin.btnHide_onclick = function() {
    icToggle.setCalendarButtonHide(true);
};
scwin.btnShow_onclick = function() {
    icToggle.setCalendarButtonHide(false);
};
]]></script>
        <style type="text/css"><![CDATA[
/* base.css(.w2inputCalendar_div_input/.w2inputCalendar_divInput{width:100% !important;padding-right:30px}) 적용 시
   달력 버튼(absolute)이 입력칸 위에 겹쳐 setCalendarButtonHide 의 입력영역 폭 변화가 사라짐 → 토글 대상에만 한정해
   버튼 표시 상태: 버튼 칸(30px)을 뺀 폭 / 버튼 숨김 상태(엔진이 _div_img 에 w2inputCalendar_div_img_hide 추가): 전체 폭 */
.ic_btnhide_toggle .w2inputCalendar_div_input {width:calc(100% - 30px) !important}
.ic_btnhide_toggle .w2inputCalendar_divInput {padding-right:8px}
.ic_btnhide_toggle:has(> .w2inputCalendar_div_img_hide) .w2inputCalendar_div_input {width:100% !important}
]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group class="sub_contents" meta_componentContainer="true" style="">
            <w2:textbox label="default (calendarButtonHide unset, renderDiv=true)" style="display:block;width:420px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="icDefault" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDate"/>

            <w2:textbox label="calendarButtonHide=true (renderDiv=true)" style="display:block;width:420px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="icHideDiv" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDate" calendarButtonHide="true"/>
            <xf:input id="tabAfterHide" style="width:180px;height:23px;margin:8px;"/>

            <w2:textbox label="calendarButtonHide=true renderDiv=false" style="display:block;width:420px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="icHideTable" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDate" renderDiv="false" calendarButtonHide="true"/>

            <w2:textbox label="calendarButtonHide=true renderDiv=false useAnchor=true" style="display:block;width:460px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="icHideAnchor" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDate" renderDiv="false" useAnchor="true" calendarButtonHide="true"/>

            <w2:textbox label="calendarButtonHide=true useEditFormat=true validateOnInput=true" style="display:block;width:460px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="icHideEdit" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDate" calendarButtonHide="true" useEditFormat="true" validateOnInput="true"/>

            <w2:textbox label="dynamic toggle target (setCalendarButtonHide)" style="display:block;width:420px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="icToggle" class="ic_btnhide_toggle" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDate"/>
            <xf:trigger id="btnHide" type="button" style="width:120px;height:25px;margin:8px;" ev:onclick="scwin.btnHide_onclick">
                <xf:label>hide button</xf:label>
            </xf:trigger>
            <xf:trigger id="btnShow" type="button" style="width:120px;height:25px;margin:8px;" ev:onclick="scwin.btnShow_onclick">
                <xf:label>show button</xf:label>
            </xf:trigger>
        </xf:group>
    </body>
</html>
