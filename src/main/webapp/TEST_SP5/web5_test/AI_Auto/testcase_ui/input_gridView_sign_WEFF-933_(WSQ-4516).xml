<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataMap baseNode="map" id="dataMap1"></w2:dataMap>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="a" name="name1" dataType="text"></w2:column>
            			<w2:column id="b" name="name2" dataType="text"></w2:column>
            			<w2:column id="c" name="name3" dataType="text"></w2:column>
            			<w2:column id="d" name="name4" dataType="text"></w2:column>
            			<w2:column id="e" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false">
            			<w2:row>
            				<a><![CDATA[12345-]]></a>
            			</w2:row>
            			<w2:row>
            				<a><![CDATA[+-12345]]></a>
            			</w2:row>
            			<w2:row>
            				<a><![CDATA[-+12345]]></a>
            			</w2:row>
            			<w2:row>
            				<a><![CDATA[]]></a>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.setJSON([{
            "a": "12345-"
        },
        {
            "a": "+-12345"
        },
        {
            "a": "-+12345"
        },
        {
            "a": "++12345"
        },
        {
            "a": "12345+-"
        },
        {
            "a": "12345-+"
        },
        {
            "a": "12345++"
        },
    ])
};
scwin.onpageunload = function() {};
scwin.cusFn = function(data, formattedData, row, col) {
    console.log("customformatter", data, formattedData, row, col)
    return formattedData.replace(/NaN/g, "");
};
scwin.gridView1_onviewchange = function(info) {
    console.log("onviewchange", info);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
	<style type="text/css"><![CDATA[
        .grd_space.w2grid nobr { white-space: pre; }
    ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView id="gridView1" style="height: 340px;" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" autoFit="allColumn" visibleRowNum="10" ev:onviewchange="scwin.gridView1_onviewchange"
    		dataList="data:dataList1" class="grd_space">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" id="column1" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" id="column2" blockSelect="false" displayMode="label" value="Number applyFormat='all'">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" id="column3" blockSelect="false" displayMode="label" value="Number applyFormat=''">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" id="column4" blockSelect="false" displayMode="label" value="Float applyFormat='all'">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" id="column5" blockSelect="false" displayMode="label" value="Float applyFormat=''">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" id="a" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" id="b" blockSelect="false" dataType="number" displayMode="label" displayFormat="#,###.##0" maxLength="8" applyFormat="all" customFormatter="">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" id="c" blockSelect="false" dataType="number" displayMode="label" displayFormat="#,###.##0" maxLength="8" applyFormat="" customFormatter="">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" id="d" blockSelect="false" dataType="float" displayMode="label"  displayFormat="#,###.##0" maxLength="8.3" applyFormat="all" customFormatter="">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" id="e" blockSelect="false" dataType="float" displayMode="label"  displayFormat="#,###.##0" maxLength="8.3" applyFormat="" customFormatter="">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:input adjustMaxLength="false" id="a" style="width: 144px;height: 21px;" dataType="number" displayFormat="#,###.##0" maxByteLength="" maxlength="8" applyFormat="all"></xf:input>
    	<xf:input adjustMaxLength="false" id="b" style="width: 144px;height: 21px;" dataType="float" displayFormat="#,###.##0" maxByteLength="" maxlength="8.3" applyFormat="all"></xf:input>
    	<xf:input adjustMaxLength="false" id="c" style="width: 144px;height: 21px;" dataType="float" displayFormat="#,###.##0" maxByteLength="" maxlength="8.4"></xf:input>
    </body>
</html>
 