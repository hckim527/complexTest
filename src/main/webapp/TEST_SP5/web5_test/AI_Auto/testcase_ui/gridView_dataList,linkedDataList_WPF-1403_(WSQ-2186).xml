<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:linkedDataList id="linkedDataList1" bind="dataList1">
            		<w2:condition type="filter"><![CDATA[col1 > 10]]></w2:condition>
            		<w2:condition type="sort"><![CDATA[]]></w2:condition>
            	</w2:linkedDataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    dataList1.removeAll();
};
scwin.trigger2_onclick = function(e) {
    var data = [];
    for (var i = 1; i <= 100; i++) {
        for (var j = 1; j <= 3; j++) {
            data.push(i * j);
        }
    }
    dataList1.setData(data);
};
scwin.trigger3_onclick = function(e) {
    dataList1.insertRow();
};
scwin.trigger4_onclick = function(e) {
    dataList1.removeRow();
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.data = [];
    for (var i = 1; i <= 100; i++) {
        for (var j = 1; j <= 3; j++) {
            data.push(i * j);
        }
    }
    dataList1.setData(data);
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:textbox label="1. dataList연동 " id="" style="position: relative;width:269px;height:58px;font-size:18pt;"></w2:textbox>
    	<w2:gridView dataList="dataList1" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20" id="gridView1"
    		style="position: relative;
width:450px;
height:200px;
" useShiftKey="true" rowNumVisible="true" autoFit="allColumn">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5" style="" inputType="text" width="70" value="name1"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="name2"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="name3"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" width="70" inputType="text"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox id="" label="2. linkedDataList연동" style="position: relative;width:269px;height:58px;font-size:18pt;"></w2:textbox>
    	<w2:gridView dataList="linkedDataList1" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20" id="gridView2"
    		style="position: relative;width: 450px;height: 200px;" useShiftKey="true" autoFit="allColumn" rowNumVisible="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5" style="" inputType="text" width="70" value="name1"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="name2"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="name3"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" width="70" inputType="text"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="position: relative;width:160px;height:30px;
;left:450px;top:-199px;margin-top:-6px;margin-left:90px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[dataList1.removeAll()]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="position: relative;width:160px;height:30px; ;left:303px;top:-169px;margin-top:-6px;margin-left:-13px;" type="button">
    		<xf:label><![CDATA[dataList1.Reset()]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3" style="position: relative;width:160px;height:30px; ;left:161px;top:-139px;margin-top:-6px;margin-left:-18px;" type="button">
    		<xf:label><![CDATA[dataList1.insertRow()]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger4_onclick" id="trigger4" style="position: relative;width:160px;height:30px; ;left:161px;top:-109px;margin-left:-160px;margin-top:-6px;" type="button">
    		<xf:label><![CDATA[dataList1.RemoveRow()]]></xf:label>
    	</xf:trigger>

    </body>
</html>
 