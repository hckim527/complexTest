<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dc_sampleData" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="category" name="대분류" dataType="text"></w2:column>
						<w2:column id="subCategory" name="중분류" dataType="text"></w2:column>
						<w2:column id="itemName" name="상품명" dataType="text"></w2:column>
						<w2:column id="price" name="가격" dataType="number"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>

		<script type="text/javascript" lazy="false"><![CDATA[
        /**
         * WebSquare AI 스크립트 아키텍처 적용
         */
        scwin.onpageload = async function() {
            // 2. 최신 화된 샘플 데이터셋 구성 (짝수 묶음 위주의 중간 행 정렬 에러 테스트 케이스)
            const sampleList = [
                { "category": "AI가전", "subCategory": "로봇청소기", "itemName": "비스포크 AI 스팀 1호", "price": 1700000 },
                { "category": "AI가전", "subCategory": "로봇청소기", "itemName": "비스포크 AI 스팀 2호", "price": 1600000 },
                { "category": "AI가전", "subCategory": "로봇청소기", "itemName": "로보락 S9 Ultra", "price": 1800000 },
                { "category": "AI가전", "subCategory": "로봇청소기", "itemName": "LG 로보킹 AI", "price": 1550000 },
                // ↑ 총 4개 행(짝수 행) 병합 구간: mergeCellVerticalAlign="middle" 지정 시 가상 스크롤 동작에 따라 상/하단 정렬 치우침이 뚜렷하게 도드라집니다.
                
                { "category": "AI가전", "subCategory": "스마트TV", "itemName": "Neo QLED 8K", "price": 5400000 },
                { "category": "AI가전", "subCategory": "스마트TV", "itemName": "OLED EVO AI", "price": 4800000 },
                
                { "category": "모바일", "subCategory": "스마트폰", "itemName": "Galaxy S26 Ultra AI", "price": 1650000 },
                { "category": "모바일", "subCategory": "스마트폰", "itemName": "iPhone 17 Pro Max", "price": 1850000 },
                { "category": "모바일", "subCategory": "스마트폰", "itemName": "Pixel 10 Pro AI", "price": 1300000 }
                // ↑ 홀수 행 병합 구간 (비교용)
            ];
            
            // WebSquare AI 컴포넌트 인스턴스 직접 참조 API 패턴 적용
            dc_sampleData.setJSON(sampleList);
        };
        
        scwin.onpageunload = function() {
            // 언로드 스크립트 생략
        };
        ]]></script>

		<style type="text/css"><![CDATA[
            /* WebSquare AI 테마 디자인 시스템 가이드 스킨 적용 */
            .info_panel {
                background-color: #f0f4f9;
                border-radius: 8px;
                padding: 16px;
                margin-bottom: 20px;
                border: 1px solid #d3e3fd;
            }
            .info_panel .title {
                color: #0b57d0;
                font-weight: bold;
                font-size: 14px;
                margin-bottom: 6px;
            }
            .info_panel .desc {
                color: #444746;
                font-size: 13px;
                line-height: 1.6;
            }
        ]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
		<xf:group id="grp_main" style="padding: 24px;" class="wq_container">

			<w2:gridView id="grd_aiMergeSample" dataList="data:dc_sampleData" style="width: 750px; height: 420px;" scrollByColumn="false"
				mergedCellVerticalAlign="middle" defaultCellHeight="42" rowNumVisible="true" rowNumHeaderValue="번호" rowNumWidth="50" autoFit="allColumn" visibleRowNum="12"
				fastScroll="true" colMergeValueType="render" focusMode="row">
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column blockSelect="false" id="col_h_category" inputType="text" width="130" value="대분류 (Merge)" displayMode="label"></w2:column>
						<w2:column blockSelect="false" id="col_h_subCategory" inputType="text" width="130" value="중분류 (Merge)" displayMode="label"></w2:column>
						<w2:column blockSelect="false" id="col_h_itemName" inputType="text" width="200" value="인공지능 가전 상품명" displayMode="label"></w2:column>
						<w2:column blockSelect="false" id="col_h_price" inputType="text" width="110" value="출시 가격" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column blockSelect="false" id="category" inputType="text" width="130" displayMode="label" colMerge="true">
						</w2:column>
						<w2:column blockSelect="false" id="subCategory" inputType="text" width="130" displayMode="label" colMerge="true">
						</w2:column>
						<w2:column blockSelect="false" id="itemName" inputType="text" width="200" displayMode="label" textAlignment="left"></w2:column>
						<w2:column blockSelect="false" id="price" inputType="text" width="110" displayMode="label" textAlignment="right"
							dataType="number" displayFormat="#,###"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>