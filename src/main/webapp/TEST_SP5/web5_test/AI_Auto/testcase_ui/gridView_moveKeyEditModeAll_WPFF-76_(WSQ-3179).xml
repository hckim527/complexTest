<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            			<w2:column id="col6" name="name6" dataType="text"></w2:column>
            			<w2:column id="col7" name="name7" dataType="text"></w2:column>
            			<w2:column id="col8" name="name8" dataType="text"></w2:column>
            			<w2:column id="col9" name="name9" dataType="text"></w2:column>
            			<w2:column id="col10" name="name10" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList id="dataList3" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList id="dataList4" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList id="dataList5" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var data = [];
    var data2 = [];
    //var now = new Date().toISOString().slice(0,10).replace(/-/g, "");
    var now = "2018/01/15";
    for (var i = 0; i < 20; i++) {
        for (var j = 0; j < 10; j++) {
            if (j === 0 || j === 2 || j === 3 || j === 5 || j === 7 || j === 9) {
                data.push(WebSquare.date.dateAdd(now, i));
            } else {
                data.push(i + "");
            }
        }
    }
    for (var i = 0; i < 20; i++) {
        for (var j = 0; j < 2; j++) {
            data2.push(i + "");
        }
    }
    dataList2.setData(data2);
    dataList3.setData(data2);
    dataList4.setData(data2);
    dataList5.setData(data2);
    dataList1.setData(data);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="data:dataList1" summaryAuto="false" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" id="gridView1" style="width:1041px;height:180px;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		summaryOnlyAuto="false" useShiftKey="true" moveKeyEditModeAll="true">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column19" style="" inputType="text" width="100" value="name1(text)" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column17" style="" inputType="text" width="100" value="name2(select)" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column15" style="" inputType="text" width="100" value="name3(calendar)" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column13" style="" inputType="text" width="100" value="name4(link)" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column11" style="" inputType="text" width="100" value="name5(cb)" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column9" style="" inputType="text" width="100" value="name6(btn)" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column7" style="" inputType="text" width="100" value="name7(ccb)" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column5" style="" inputType="text" width="100" value="name8(secret)" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="100" value="name9(autoComplete)" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="100" inputType="text" value="name10(textarea)" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="text" width="100" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="select" width="100" value="" displayMode="label"
    					allOption="" chooseOption="" ref="">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="col1"></w2:label>
    							<w2:value ref="col2"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" style="" inputType="calendar" width="100" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col4" style="" inputType="link" width="100" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col5" style="" inputType="checkbox" width="100" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col6" style="" inputType="button" width="100" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col7" style="" inputType="checkcombobox" width="100" value="" displayMode="label"
    					allOption="" chooseOption="" ref="">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList3">
    							<w2:label ref="col1"></w2:label>
    							<w2:value ref="col2"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="col8" style="" inputType="secret" width="100" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col9" style="" inputType="autoComplete" width="100" value="" displayMode="label"
    					allOption="" chooseOption="" ref="">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList4">
    							<w2:label ref="col1"></w2:label>
    							<w2:value ref="col2"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="col10" style="" width="100" inputType="textarea" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 