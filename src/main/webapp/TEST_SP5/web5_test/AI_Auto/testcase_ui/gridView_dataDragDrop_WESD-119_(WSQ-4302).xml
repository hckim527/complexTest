         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    // datalist initialize
    var obj = [];
    for (var i = 1; i < 101; i++) {
        obj.push({
            "col1": i.toString()
        });
    }
    dataList1.setJSON(obj);
    document.documentElement.addEventListener("mouseup", function() {
        // mouseup시 스크롤 종료 
        scwin.dataDragStart = false;
        WebSquare.util.clearInterval("gridView1_dataDragDropAutoScroll");
    });
    document.documentElement.addEventListener("touchend", function() {
        // touch end시 스크롤 종료 
        scwin.dataDragStart = false;
        WebSquare.util.clearInterval("gridView1_dataDragDropAutoScroll");
    });
    document.documentElement.addEventListener("touchmove", function(e) {
        if (scwin.dataDragStart == true) {
            var elem = document.elementFromPoint(e.changedTouches[0].clientX, e.changedTouches[0].clientY);
            it = new WebSquare.targetIterator(elem);
            while (it.next()) {
                if (it.match("w2group")) {
                    var targetComp = WebSquare.wUnit.getObjById(it.getElement().id);
                    if (targetComp.id == group2.id) {
                        //scroll down
                        scwin.scrollDirection = 0;
                    } else if (targetComp.id == group1.id) {
                        //scroll up
                        scwin.scrollDirection = 1;
                    }
                } else if (it.match("w2grid")) {
                    // 원래 grid로 다시 돌아왔을 때 scroll 중지 
                    var targetComp = WebSquare.wUnit.getObjById(it.getElement().id);
                    if (targetComp.id == gridView1.id) {
                        scwin.scrollDirection = 2;
                    }
                }
            }
        }
    });
};
scwin.onpageunload = function() {};
scwin.gridView1_ondatadragstart = function(rowIndex) {
    scwin.dataDragStart = true;
    WebSquare.util.setInterval(function() {
        if (scwin.dataDragStart == true) {
            if (scwin.scrollDirection == 0) {
                // 아래로 scroll
                main_group.render.scrollTop += 30;
            } else if (scwin.scrollDirection == 1) {
                // 위로 scroll
                main_group.render.scrollTop -= 30;
            }
        }
    }, {
        key: "gridView1_dataDragDropAutoScroll",
        caller: this,
        delay: 70,
        args: []
    });
};
scwin.group1_onmouseover = function(e) {
    scwin.scrollDirection = 1;
};
scwin.group2_onmouseover = function(e) {
    scwin.scrollDirection = 0;
};
scwin.main_group_onmouseover = function(e) {
    scwin.scrollDirection = 2;
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    // drag시작 flag 설정 (mobile, pc 환경 둘다 사용 )
    // 위로 scroll
    // 아래로 scroll
    // drag 도중 다시 원래 grid로 돌아올때 스크롤을 멈춘다.
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
