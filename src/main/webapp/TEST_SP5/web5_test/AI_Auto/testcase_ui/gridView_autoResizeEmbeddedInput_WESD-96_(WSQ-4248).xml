     * 엑셀
     ****************************************************************************/
    callbackGrdExport = function(retObj) {
        btnExlExport.focus();
        if (retObj.isCloseYN == true) {
            com.gfn_grdExcelDownload(grdList, "1", "본인부담금계좌조회");
