};
scwin.commonCode_submitdone = function(e) {
    cmbYy.setValue(strToday.substr(0, 4));
    cmbMm.setValue(strToday.substr(4, 2));
    calStrtDd.setValue(strToday.substr(0, 6) + "01");
    calEndDd.setValue(strToday);
};
scwin.onpageunload = function() {};
scwin.btnRetrieve_onclick = function(e) {
    //console.log("@@@retObj=>"+ JSON.stringify(retObj) );
    var strSerchStdr = cmbSerchStdr.getValue();
    ds_param_search.setEmptyValue();
    if (ckbAll.getValue() != "1") {
        if (strSerchStdr == "1") { //계약시작년월		
            var strStrtYm = cmbYy.getValue() + cmbMm.getValue();
            ds_param_search.set("conStrtYm", strStrtYm);
        } else if (strSerchStdr == "2") { //계약종료년월		
            var strEndYm = cmbYy.getValue() + cmbMm.getValue();
            ds_param_search.set("conEndYm", cmbYy.getValue() + "" + cmbMm.getValue());
        } else if (strSerchStdr == "3") { //계약시작일자
            var strStrtYmd_strt = calStrtDd.getValue();
            var strStrtYmd_end = calEndDd.getValue();
            ds_param_search.set("conStrtDeStrt", strStrtYmd_strt);
            ds_param_search.set("conStrtDeEnd", strStrtYmd_end);
        } else if (strSerchStdr == "4") { //계약종료일자
            var strEndYmd_strt = calStrtDd.getValue();
            var strEndYmd_end = calEndDd.getValue();
            ds_param_search.set("conEndDeStrt", strEndYmd_strt);
            ds_param_search.set("conEndDeEnd", strEndYmd_end);
        }
    } else {
        ds_param_search.set("conStrtYm", "");
        ds_param_search.set("conEndYm", "");
        ds_param_search.set("conStrtDeStrt", "");
        ds_param_search.set("conStrtDeEnd", "");
        ds_param_search.set("conEndDeStrt", "");
        ds_param_search.set("conEndDeEnd", "");
    }
    //사용하지 않아서 주석처리
    //		if (mask_trgterIhidnum.getValue().length > 0 && mask_trgterIhidnum.getValue().length < 6)
    //        {
    //            com.alert("생년월일는 8자리를 입력 하십시오.", "mask_trgterIhidnum.focus()");
    //            return false;
    //        }
    ds_param_search.set("trgterNm", editTrgterNm.getValue()); // 대상자명
    ds_param_search.set("trgterIhidnum", editTrgterIhidNum.getValue()); // 주민등록번호
    ds_param_search.set("prinstId", cv_strJoinId); // 제공기관ID
    ds_param_search.set("chr_vuh_no", cv_chrVuhNo); // 바우처번호
    ds_param_search.set("user_auth_group", cv_strUserAuthGroup); // 사용자권한그룹
    ds_param_search.set("vouchPrinstNo", ""); // 담당자구분
    if (cv_strUserAuthGroup == "AUTHD002") /*제공기관 사업별 담당자 권한일 경우*/ {
        scwin.fn_vouch_Option(ds_param_search);
    } else /*전부 아닐 경우*/ {
        ds_param_search.set("vouchPrinstNo", "");
    }
    // output dataset 초기화
    ds_list.removeAll();
    $w.executeSubmission(SELECT);
};
scwin.SELECT_submitdone = function(e) {
    return;
    //WebSquare.logger.printLog( "[ds_list.getRowCount()]==>"+ ds_list.getRowCount() );
    if (ds_list.getRowCount() > 0) {
        /*조회 후 첫번째 row 선택*/
        //grdList.setFocusedCell( 0 , 1 , false );
    } else {
        com.alert("검색 결과가 없습니다.", "btnRetrieve.focus()");
    }
    stcCount.setLabel(com.transComma(parseInt(ds_list.getRowCount())));
};
scwin.fn_vouch_Option = function(e) {
    var txtvouch = "";
    txtvouch = cv_vchrVoc.replace(",", "','");
    txtvouch = "('" + txtvouch + "')";
    ds_param_search.set("vouchPrinstNo", txtvouch);
};
scwin.btnExlDownload_onclick = function(e) {
    /* 개인정보 열람정보 등록 : SMindvdlInfoInqireManageP_instt */
    if (grdList.getRowCount() > 0) {
        com.gfn_indvlInfoInqireSave(ds_list.getRowCount(), "callbackGrdExport");
        return;
    } else {
        com.alert("검색한 데이터가 없습니다.", "btnExlExport.focus()");
    }
};
scwin.ckbAll_oncheckboxclick = function(index, checked, value) {
    if (checked) {
        value = "1";
    } else {
        value = "0";
    }
    if (value == "1") {
        cmbYy.setDisabled(true);
        cmbMm.setDisabled(true);
        calStrtDd.setDisabled(true);
        calEndDd.setDisabled(true);
        cmbSerchStdr.setDisabled(true);
    } else {
        cmbYy.setDisabled(false);
        cmbMm.setDisabled(false);
        calStrtDd.setDisabled(false);
        calEndDd.setDisabled(false);
        cmbSerchStdr.setDisabled(false);
    }
};
scwin.btnBookMark_onclick = function(e) {
    com.addBookMark();
};
scwin.editTrgterNm_onkeydown = function(e) {
    if (e.keyCode == 13) {
        scwin.btnRetrieve_onclick();
