     * 01. 업무구분 : CP
     * 02. 화면 :  CPtrgterselfAlotmVirtlAcnutManage
     * 03. 화면 설명 : 본인부담금 계좌조회
     * 04. 관련 화면/서비스 : 
     * 05. 작성자 : 조용준
     * 06. 작성일 : 2011-09-30
     * 07. 수정이력 :
     ************************************************************************************************
     *     수정일        이  름    사유
     ************************************************************************************************
     *     2011-09-30   조용준    최초 작성
     *     2019-10-22             엑셀다운로드시 개인정보 열람정보 등록 추가 (INDEX_BKL_20191022_INDV_INFO)
     *     2020-03-13             웹접근성 1차 심사 결과에 따른 조치('19년 기능개선 2차, 2020-03-13)
     ************************************************************************************************/
    /*==============================================================================================
    *    2. Form 전역변수 선언
    ==============================================================================================*/
    window.cv_strTitle = "본인부담금계좌조회";
    window.cv_strUserAuthGroup = "aa" || $p.top().gdsSession.get("USER_AUTH_GROUP"); // 사용자권한그룹
    window.cv_strJoinId = "aa" || $p.top().gdsSession.get("JOIN_ID"); //제공기관 ID
    window.cv_chrVuhNo = "aa" || $p.top().gdsSession.get("CHR_VUH_NO"); //바우처번호
    window.cv_vchrVoc = "aa" || $p.top().gdsSession.get("VCHR_VOC"); // 바우처 제공기관 번호 리스트	
    window.strToday = WebSquare.date.getCurrentServerDate("yyyyMMdd");
    /*==============================================================================================
    *    3. Form onInit,onLoad 처리
    ==============================================================================================*/
    /*==============================================================================================
    *   5. 서비스 호출 처리부분
    ==============================================================================================*/
    //조회
