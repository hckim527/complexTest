<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    inputCalDateTimeSec.setValue("20260630112729");
    inputCalDateTimeSecEdit.setValue("20260630112729");
    inputCalDate.setValue("20260228");
    inputCalMonth.setValue("202612");
    inputCalDefaultOff.setValue("20260630");
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group class="sub_contents" meta_componentContainer="true" style="">
            <w2:textbox label="before" style="display:block;width:220px;height:23px;margin:8px;"/>
            <xf:input id="inputBefore" style="width:180px;height:23px;margin:8px;"/>

            <w2:textbox label="yearMonthDateTimeSec useInputSpin=true" style="display:block;width:360px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="inputCalDateTimeSec" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDateTimeSec" useInputSpin="true"/>

            <w2:textbox label="yearMonthDateTimeSec useEditFormat=true useInputSpin=true" style="display:block;width:460px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="inputCalDateTimeSecEdit" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDateTimeSec" useEditFormat="true" useInputSpin="true"/>

            <w2:textbox label="yearMonthDate useInputSpin=true" style="display:block;width:360px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="inputCalDate" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDate" useInputSpin="true"/>

            <w2:textbox label="yearMonth useInputSpin=true" style="display:block;width:360px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="inputCalMonth" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonth" useInputSpin="true"/>

            <w2:textbox label="yearMonthDate useInputSpin=false" style="display:block;width:360px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="inputCalDefaultOff" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDate"/>

            <w2:textbox label="yearMonthDate inputReadOnly useInputSpin=true" style="display:block;width:420px;height:23px;margin:8px;"/>
            <w2:inputCalendar id="inputCalInputReadOnly" style="width:220px;height:23px;margin:8px;"
                calendarValueType="yearMonthDate" useInputSpin="true" inputReadOnly="true"/>

            <w2:textbox label="after" style="display:block;width:220px;height:23px;margin:8px;"/>
            <xf:input id="inputAfter" style="width:180px;height:23px;margin:8px;"/>
        </xf:group>
    </body>
</html>
