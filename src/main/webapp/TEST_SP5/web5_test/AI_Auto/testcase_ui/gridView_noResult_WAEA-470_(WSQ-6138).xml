<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map" ev:oncelldatachange="scwin.dataList1_oncelldatachange">
            		<w2:columnInfo>
            			<w2:column id="col2" name="name2" dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>

            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
            		</w2:keyInfo>
            	</w2:dataMap>

				<w2:dataList baseNode="list" repeatNode="map" id="select_data" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" name="Label" id="label"></w2:column>
						<w2:column dataType="text" name="Value" id="code"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[A]]></label>
							<code><![CDATA[01]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[B]]></label>
							<code><![CDATA[02]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[C]]></label>
							<code><![CDATA[03]]></code>
						</w2:row>
					</w2:data>
				</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script lazy="false" type="text/javascript"><![CDATA[

scwin.onpageload = function() {
	var jsonData = [
		{col2:"111"},
		{col2:"02"},
		{col2:"03"},
		{col2:"01"},
		{col2:"02"},
		{col2:"03"}
	];
	dataList1.setJSON(jsonData);
	dataMap1.set("key1", "abc");
};
scwin.trigger1_onclick = function(e) {
    console.log("dataMap1.get('key1') : " + dataMap1.get("key1"));
    //autoComplete 값 확인
    console.log("autoComplete1.getValue() : " + autoComplete1.getValue());
};
scwin.dataList1_oncelldatachange = function(info) {
    console.log("info : " + JSON.stringify(info));
};
		]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList1" summaryAuto="false"
    		useFilterList="true" scrollByColumn="false"
    		showSortableUseFilter="false" scrollByColumnAdaptive="false"
    		id="gridView1"
    		style="position: relative;width: 500px;height: 200px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		summaryOnlyAuto="false" useShiftKey="true" 
    		ev:onviewchange="scwin.gridView1_onviewchange">
    		<w2:caption id="caption1" style="" value="this is a grid caption.">
    		</w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" useFilter="true"
    					style="height:20px" width="200" inputType="text"
    					displayMode="label" value="name2">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col2"
    					style="height:20px" width="70" inputType="autoComplete"
    					displayMode="label" allOption="" chooseOption=""
						editModeEvent="onclick" selectedData="false"
    					noResult="keepValue" 
						valueNotInList=""
						escape="">
    					<w2:choices>
    						<w2:itemset nodeset="data:select_data">
								<w2:label ref="label"></w2:label>
								<w2:value ref="code"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
		<w2:autoComplete submenuSize="auto" search="start" editType="select" useKeywordHighlight="false"
			style="width: 200px;height: 30px;" id="autoComplete1" useLocale="false" ref="data:dataMap1.key1" textAlign="center" 
			noResult="keepValue" 
			valueNotInList="">
			<w2:choices>
				<w2:itemset nodeset="data:select_data">
					<w2:label ref="label"></w2:label>
					<w2:value ref="code"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:autoComplete>
	
		<xf:trigger type="button" id="trigger1" style="width: 200px;height: 30px;" ev:onclick="scwin.trigger1_onclick" >
    		<xf:label><![CDATA[값 확인]]></xf:label>
    	</xf:trigger>
    </body>
</html>
