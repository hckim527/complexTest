<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="expr1" name="name2" dataType="text"></w2:column>
            			<w2:column id="col2" name="name3" dataType="text"></w2:column>
            			<w2:column id="col3" name="name4" dataType="text"></w2:column>
            			<w2:column id="col4" name="name5" dataType="text"></w2:column>
            			<w2:column id="expr2" name="name6" dataType="text"></w2:column>
            		</w2:columnInfo>
            	<w2:data use="true"></w2:data></w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script lazy="false" type="text/javascript"><![CDATA[

scwin.onpageload = function() {

	var data = [
	        {
	            "col1": "삼립빵",
	            "col2": 1,
	            "col3": 2,
	            "col4": 3
	        },
	        {
	            "col1": "마늘빵",
	            "col2": 4,
	            "col3": 5,
	            "col4": 6
	        },
	        {
	            "col1": "모카빵",
	            "col2": 7,
	            "col3": 8,
	            "col4": 9
	        }
	    ];

		var dataArr = {
			"columnInfo": ["col2", "col3", "col4", "col1"], 
			"data":[
				1,2,3,"삼립빵",
				4,5,6,"마늘빵",
				7,8,9,"모카빵"
			]
		};
		//dataList1.setJSON(data);	// importExp 가 setJSON, setXML 에는 지원됐었음
		dataList1.setArray(dataArr); // setArray 는 안됐음 -> 지원되도록 수정작업해야함
        
}

        
         ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1"
    		style="position: absolute ;left: 27px;top: 35px;width: 500px;height: 153px;" ignoreCellClick="false" fixedColumnWithHidden="true"
    		useShiftKey="true" sortable="true" showSortableImage="">
    		<w2:header id="header1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column11" style="height:20px;" inputType="text" width="70" value="col1"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="height:20px;color:red;" inputType="text" width="70" value="col2 + col3"></w2:column>
    				<w2:column blockSelect="false" id="column9" style="height:20px;" inputType="text" width="70" value="col2"></w2:column>
    				<w2:column blockSelect="false" id="column7" style="height:20px;" inputType="text" width="70" value="col3"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px;" inputType="text" width="70" value="col4"></w2:column>
    				<w2:column blockSelect="false" id="column2" style="height:20px;color:red;" inputType="text" width="110" value="(col2 + col3) * col3"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody4" style="">
    			<w2:row id="row5" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="" id="expr1" style="height:20px" inputType="text" width="70" 
						importExp="Number(col('col2')) + Number(col('col3'))"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col4" style="height:20px" width="70" inputType="text"></w2:column>
    				<w2:column blockSelect="" id="expr2" style="height:20px" inputType="text" width="70" 
						importExp="Number(col('expr1')) * Number(col('col3'))"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
