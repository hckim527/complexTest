<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:buildDate/>
        <xf:model>
            <w2:dataCollection></w2:dataCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    try {
        sub_msg.setValue("내부 화면 로딩 완료 " + new Date().toLocaleTimeString());
    } catch (e) {}
};
// 부모가 createWindowAsync resolve 후 내부 컴포넌트에 접근할 수 있음을 보여주기 위한 API
scwin.getMessage = function() {
    return sub_msg.getValue();
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <w2:textbox id="sub_title" label="WAEA-946 서브 화면" style="font-weight:bold;display:block;margin:6px;"></w2:textbox>
        <xf:input id="sub_msg" style="width:260px;height:24px;margin:6px;"></xf:input>
    </body>
</html>
