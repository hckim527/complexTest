<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
<head>
    <w2:type>DEFAULT</w2:type>
    <w2:buildDate />
    <xf:model>
        <xf:instance>
            <data xmlns="" />
        </xf:instance>
        <w2:dataCollection baseNode="map">
            <w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
                <w2:columnInfo>
                    <w2:column id="col1" name="name1" dataType="text"></w2:column>
                    <w2:column id="col2" name="name2" dataType="text"></w2:column>
                    <w2:column id="col3" name="name3" dataType="text"></w2:column>
                    <w2:column id="col4" name="name4" dataType="text"></w2:column>
                    <w2:column id="col5" name="name5" dataType="text"></w2:column>
                </w2:columnInfo>
            </w2:dataList>
            <w2:dataMap baseNode="map" id="dataMap1">
                <w2:keyInfo>
                    <w2:key id="key1" name="name1" dataType="text"></w2:key>
                    <w2:key id="key2" name="name2" dataType="text"></w2:key>
                    <w2:key id="key3" name="name3" dataType="text"></w2:key>
                </w2:keyInfo>
            </w2:dataMap>
        </w2:dataCollection>
        <w2:workflowCollection></w2:workflowCollection>
    </xf:model>
    <script type="text/javascript" lazy="false">
        <![CDATA[
        scwin.onpageload = function() {
            var row = 40;
            var col = 5;
            var data = [];
            for (var i = 0; i < row; i++) {
                for (var j = 0; j < col; j++) {
                    if (j < 3) {
                        data.push(i * (j + 1));
                    } else {
                        data.push("i=" + i + ",j=" + j);
                    }
                }
            }
            dataList1.setData(data);
        };
        scwin.onpageunload = function() {};
        scwin.trigger1_onclick = function() {}


        scwin.autoComplete1_onblur = function(e) {
            var value = autoComplete1.getValue();
            var label = autoComplete1.getText();
            console.log("autoComplete1_onblur", value, label)
        }

        scwin.autoComplete2_onblur = function(e) {
            var value = autoComplete2.getValue();
            var label = autoComplete2.getText();
            console.log("autoComplete2_onblur", value, label)
        }

        ]]>
    </script>
</head>

<body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:trigger ev:onclick="scwin.trigger1_onclick" style="width:150px;height:30px;" id="trigger1" type="button">
        <xf:label>
            <![CDATA[test_tt]]>
        </xf:label>
    </xf:trigger>
    <w2:autoComplete editType="select" id="autoComplete1" useKeywordHighlight="false" style="width: 148px;height: 21px;" submenuSize="auto" search="start" useLocale="false" allOption="" chooseOption="" ref="" ev:onblur="scwin.autoComplete1_onblur">
        <w2:choices>
            <w2:itemset nodeset="data:dataList1">
                <w2:label ref="col1"></w2:label>
                <w2:value ref="col2"></w2:value>
            </w2:itemset>
        </w2:choices>
    </w2:autoComplete>
    <w2:autoComplete editType="select" id="autoComplete2" useKeywordHighlight="false" style="position:relative;width:284px;height:54px;" submenuSize="auto" search="start" useLocale="false" allOption="" chooseOption="" ref="data:dataMap1.key2" ev:onblur="scwin.autoComplete2_onblur">
        <w2:choices>
            <w2:item>
                <w2:label>
                    <![CDATA[01]]>
                </w2:label>
                <w2:value>
                    <![CDATA[01]]>
                </w2:value>
            </w2:item>
            <w2:item>
                <w2:label>
                    <![CDATA[[나나나]상세조회]]>
                </w2:label>
                <w2:value>
                    <![CDATA[02]]>
                </w2:value>
            </w2:item>
            <w2:item>
                <w2:label>
                    <![CDATA[지급/해지내역(타행은행어쩌구)]]>
                </w2:label>
                <w2:value>
                    <![CDATA[03]]>
                </w2:value>
            </w2:item>
            <w2:item>
                <w2:label>
                    <![CDATA[04]]>
                </w2:label>
                <w2:value>
                    <![CDATA[04]]>
                </w2:value>
            </w2:item>
        </w2:choices>
    </w2:autoComplete>
</body>
</html>