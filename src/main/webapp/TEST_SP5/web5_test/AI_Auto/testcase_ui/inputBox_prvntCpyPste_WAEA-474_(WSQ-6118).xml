<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		ipt2.setValue("복사");
	};
	
	scwin.onpageunload = function() {
		
	};
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">

        <w2:textbox label="preventCopyPaste" id="txt1" style="pwidth: 100px;height: 20px;" >
        </w2:textbox>
    	<xf:input adjustMaxLength="false" id="input1" preventCopyPaste="true" value="a"
    	 style="width: 100px;height: 40px;"></xf:input>


        <w2:textbox label="preventCopy" id="txt2" style="pwidth: 100px;height: 20px;" >
        </w2:textbox>
        <xf:input adjustMaxLength="false" id="ipt2" preventCopy="true"
         style="width: 100px;height: 40px;"></xf:input>

        <w2:textbox label="preventPaste" id="txt3" style="pwidth: 100px;height: 20px;" >
