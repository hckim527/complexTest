<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    var jsonData = [{
            "col1": "    6 abcd"
        },
        {
            "col1": "3"
        },
        {
            "col1": "12"
        }
    ];
    dataList1.setJSON(jsonData);
};
scwin.trigger1_onclick = function(e) {
    var options = {
        type: "0"
    };
    grd.advancedExcelDownload(options);
};
scwin.onpageload = function() {
    formatFunc = function(fdata) {
        fdata = fdata.replaceAll(" ", "&nbsp;");
        return fdata + "개월제";
    };
    scwin.init();
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList1" summaryAuto="false"
    		useFilterList="false" scrollByColumn="false"
    		showSortableUseFilter="false" scrollByColumnAdaptive="false"
    		id="grd" style="position: relative;width: 500px;height: 150px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		summaryOnlyAuto="false" fixedColumnWithHidden="true"
    		useShiftKey="true" sortable="true" senseReader="true">
    		<w2:caption id="caption1" style=""
    			value="this is a grid caption.">
    		</w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5"
    					style="height:20px;" inputType="text" width="100"
    					displayMode="label" value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3"
    					style="height:20px;" inputType="text" width="100"
    					displayMode="label" value="name2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1"
    					style="height:20px;" width="100" inputType="text"
    					displayMode="label" value="name3">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1"
    					sortable="false" style="height:20px" inputType="text"
    					width="100" displayMode="label" customFormatter=""
    					textAlign="left" displayFormat=""
    					displayFormatter="formatFunc">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2"
    					style="height:20px" inputType="text" width="100"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3"
    					style="height:20px" width="100" inputType="secret"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:input id=""
    		style="position: relative;width: 144px;height: 21px;">
    	</xf:input>
    	<xf:trigger type="button" id="trigger1"
    		style="position: relative;width: 80px;height: 23px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[excel]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 