        <script type="text/javascript" lazy="false"><![CDATA[
scwin.test = function() {
    // 1. 다른 프레임에 있는 instane를 통째로 가져오는 방법  
    WebSquare.ModelUtil.getInstanceByXPath("response/vector_common/data", undefined, "wf_common");
    WebSquare.ModelUtil.getInstanceByXPath("response/vector2_wframe/data", undefined, "wf_wframe1");
    // 2. 다른 프레임에 있는 instance 노드에 접근 
    WebSquare.ModelUtil.findInstanceNodes("response/vector_common/data", undefined, "wf_common");
    WebSquare.ModelUtil.findInstanceNodes("response/vector_frame/data", undefined, "wf_wframe1");
    // 3. 다른 프레임에 있는 instance 값 바꾸기      	
    WebSquare.ModelUtil.setInstanceValue({
        xpath: "response/vector_common/data[1]/col2",
        scopeId: "wf_common",
        value: "test_aaa"
    });
    WebSquare.ModelUtil.setInstanceValue({
        xpath: "response/vector_wframe/data[2]/col2",
        scopeId: "wf_wframe1",
        value: "test_bbb"
    });
}
scwin.trigger1_onclick = function(e) {
    // dataScope : "" 으로 인자를 전달하면 최상위 화면에 있는 instance를 기준으로 한다.
    grid1.setRef({
        ref: "response/vector2_grid",
        baseNode: "vector2_grid",
        dataScope: ""
    });
};
scwin.onpageload = function() {
}
