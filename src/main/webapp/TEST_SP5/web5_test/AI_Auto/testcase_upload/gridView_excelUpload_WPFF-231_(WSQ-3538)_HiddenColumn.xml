scwin.maskTin = function(tin) {
        try {
            if (tin.length <= 0) return tin;
            var str = tin.replace(/\-/ig, "");
            if (str.length === 12 || str.length === 9) {
                if (str.replace(/^[P]|[\d]|[\-]/ig, "").length > 0) {
                    alert("test");
                    return tin;
                }
                return str.replace(/(\w{9})(\d)/g, "$1-$2");
            }
            return tin
        } catch (e) {
            $w.log("Error ::: scwin.maskTin = " + e.message);
            return tin;
        }
    };
scwin.onpageload2 = function() {
