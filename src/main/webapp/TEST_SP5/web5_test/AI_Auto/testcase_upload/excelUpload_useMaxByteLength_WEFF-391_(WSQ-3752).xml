        startRowIndex: 1,
        startColumnIndex: 0,
        headerExist: "0",
        append: "0",
        useMaxByteLength: "true", // 해당속성사용시 gridView cell maxByteLength 값만큼 업로드되어짐
        useMaxLength: "true"
    }
    gridView1.advancedExcelUpload(options);
