		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.customModelFormatter = function(domValue) {
    var value = domValue;
    return domValue.replace(",", ".");
}
scwin.customModelUnformatter = function(domValue) {
    return domValue.replace(".", ",");
}
scwin.trigger11_onclick = function(e) {
    debugger;
    //gridView1.advancedExcelDownload({"fileName":"test.xlsx", "type":"0"}, []);
    gridView1.advancedExcelDownload({
        "fileName": "test.xlsx",
        "type": "1",
        "applyDataFormat": "false"
    }, []);
};
scwin.trigger12_onclick = function(e) {
    debugger;
    var options = {};
    options.headerExist = "1";
    options.type = "1";
    //options.type = "0";
    gridView1.advancedExcelUpload(options);
};
scwin.trigger13_onclick = function(e) {
    var options = {
        common: {
            fileName: "excel.xlsx",
            showProcess: true,
            useStyle: "true",
            //useDataFormat:"true",
            printSet: {
                landScape: "true",
                fitToPage: "true",
                fitWidth: "4",
                fitHeight: "333",
                scale: "222"
            }
        },
        excelInfo: [{
            gridId: "gridView1",
            sheetName: "sheetName1",
            type: "1",
            //removeColumns: "0,2",
            //foldColumns: "4",
            startRowIndex: 2,
            startColumnIndex: 1,
            //dataProvider: "com.provider.Provider1",
            headerColor: "RED",
            bodyColor: "YELLOW"
        }, {
            gridId: "gridView2",
            sheetName: "sheetName2",
            type: "1",
            //removeColumns: "",
            //foldColumns: "4",
            startRowIndex: 2,
            startColumnIndex: 1,
            //dataProvider: "com.provider.Provider1",
            headerColor: "GREEN",
            bodyColor: "BLUE"
        }]
    };
    WebSquare.util.multipleExcelDownload(options);
};
scwin.onpageload = function() {
}
]]></script>
