		<script type="text/javascript" lazy="false"><![CDATA[
scwin.grd_ExcelSample_onviewchange = function(info) {
    var colId = grd_ExcelSample.getColumnID(info.colIndex);
    if (colId == "result") {
        var rowIndx = info.rowIndex;
        var value = info.newValue;
        if (value == "f") {
            grd_ExcelSample.setCellColor(rowIndx, info.colIndex, "red");
        } else if (value == "p") {
            grd_ExcelSample.setCellColor(rowIndx, info.colIndex, "blue");
        }
    } else if (colId == "lineCd") {
        dlt_ExcelData.setCellData(info.rowIndex, "lineValue", info.newValue);
    }
};
scwin.initScreen = function() {
    var reqOption = {
        service: "WS0101U07",
        append: true,
    };
    //ajaxLib.executeSubmission(reqOption);
};
scwin.btn_ExcelDown_onclick = function(e) {
    var options = {
        "fileName": "ExcelDownLoadSampe.xlsx"
            //"fileName" : "ExcelDownLoadSampe.xls"
            ,
        "sheetName": "sample",
        "type": "0",
        "startRowIndex": "0",
        "startColumnIndex": "0"
            //, "headerColor" : "#C0C0C0"
            ,
        "headerFontName": "굴림",
        "headerFontSize": "12"
            //, "headerFontColor" : "#0000ff"
            //, "bodyColor" : "#fff"
            ,
        "headerColor": "#EDEEF3",
        "subTotalColor": "#EFF4FE",
        "footerColor": "#DBE6FF",
        "showProcess": true,
        "useStyle": true,
        "bodyWordwrap": true
            //, "colMerge" : true
            ,
        "useSubTotal": true,
        "useDataFormat": true,
        "rowNumVisible": true,
        "rowNumHeaderValue": "No",
        "rowNumHeaderColor": "#EDEEF3",
        "rowNumSubTotalColor": "#EFF4FE"
    };
    //comLib.downloadExcel(grd_ExcelSample, options);
    grd_ExcelSample.advancedExcelDownload(options);
    //grd_ExcelSample
};
scwin.btn_ExcelUpload_onclick = function(e) {
    var options = {
        "type": "1",
        "sheetNo": "0",
        "startRowIndex": "0",
        "startColumnIndex": "1",
        "headerExist": "1",
        "append": 0,
        "hidden": "0",
        "fillHidden": "0",
        "footerExist": "1"
        //, "subTotalExist" : "1"
    };
    grd_ExcelSample.advancedExcelUpload(options);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
