<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map"
        			id="dataList1" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="col1" name="name1"
        					dataType="date">
        				</w2:column>
        				<w2:column id="col2" name="name2"
        					dataType="time">
        				</w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref=""
        		target='data:json,{"id":"dataList1","key":"dataList1"}' action="/data/jsonData.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance=""
        		replace="" errorHandler="" customHandler=""
        		mode="asynchronous" processMsg="" ev:submit=""
        		ev:submitdone="scwin.submission1_submitdone" ev:submiterror="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger5_onclick = function(e) {
    var options = {
        type: "1"
    };
    gridView1.advancedExcelUpload(options);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView scrollByColumn="false" id="gridView1"
    		ignoreToggleOnDisabled="false" scrollByColumnAdaptive="false"
    		useShiftKey="true" fixedColumnWithHidden="true"
    		style="position: relative ;left: 87px;top: 46px;width: 471px;height: 171px;"
    		dataList="dataList1" ignoreCellClick="false"
    		ev:onviewchange="scwin.gridView1_onviewchange">
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text"
    					style="height:20px" id="column3" blockSelect="false"
    					displayMode="label" value="name1">
    				</w2:column>
    				<w2:column width="70" inputType="text"
    					style="height:20px" id="column1" blockSelect="false"
    					displayMode="label" value="name2">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text"
    					style="height:20px" id="col1" blockSelect="false"
    					displayMode="label" dataType="date" calendarValueType="" excelDateFormat="yyyy-MM-dd hh:mm:ss a">
    				</w2:column>
    				<w2:column width="70" inputType="text"
    					style="height:20px" id="col2" blockSelect="false"
    					displayMode="label" dataType="time" excelDateFormat="yyyy-MM-dd hh:mm:ss a">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button"
    		style="position: relative ;left:-171px;top:79px;width: 82px;height: 17px;"
    		id="trigger4" ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[remove]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button"
    		style="position: relative ;left:-68px;top:-162px;width: 162px;height: 27px;"
    		id="trigger5" ev:onclick="scwin.trigger5_onclick">
    		<xf:label><![CDATA[excel]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 