<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="number">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col4" name="name4"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col5" name="name5"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col6" name="name6"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    dataList1.insertRow();
};
scwin.trigger1_onclick = function(e) {
    var options = {
        fileName: "test_test.xlsx"
    };
    grd.advancedExcelDownload(options);
};
scwin.grd_onfilereadend = function(value) {
    debugger;
};
scwin.trigger2_onclick = function(e) {
    var options = {
        decimal: 5
    };
    grd.advancedExcelUpload(options);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.init();
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:trigger type="button" id="trigger1"
    		style="position: relative;width: 80px;height: 23px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[excel]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[upload]]></xf:label>
    	</xf:trigger>
    	<w2:gridView dataList="dataList1" summaryAuto="false"
    		useFilterList="false" scrollByColumn="false"
    		scrollByColumnAdaptive="false" id="grd"
    		style="position: relative;width: 500px;height: 150px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		summaryOnlyAuto="false" fixedColumnWithHidden="true"
    		useShiftKey="true" ev:onfilereadend="scwin.grd_onfilereadend">
    		<w2:caption id="caption1" style=""
    			value="this is a grid caption.">
    		</w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column11"
    					style="height:20px;" inputType="text" width="70"
    					displayMode="label" value="name1" colSpan="" rowSpan="">
    				</w2:column>
    				<w2:column blockSelect="false" id="column9"
    					style="height:20px;" inputType="text" width="70"
    					displayMode="label" value="가나다&lt;br/&gt;마바사" colSpan="2"
    					rowSpan="">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1"
    					style="height:20px" inputType="text" width="70"
    					displayMode="label" dataType="number" displayFormat="#,##0.00000">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2"
    					style="height:20px" inputType="text" width="70"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3"
    					style="height:20px" inputType="text" width="70"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 