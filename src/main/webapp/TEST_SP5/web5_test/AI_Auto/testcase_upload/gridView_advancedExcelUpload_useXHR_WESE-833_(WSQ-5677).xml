<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
};

    
scwin.trigger1_onclick = function(e) {
    //download
    gridView1.advancedExcelDownload({fileName:"uploadTest.xlsx"});
};  
scwin.trigger2_onclick = function(e) {
    //upload
    gridView1.advancedExcelUpload({type:1, wframe:true, headerExist:1, useXHR:true})
};
]]></script>

        <style type="text/css"><![CDATA[
         ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[excel Down]]></xf:label>
        </xf:trigger>
        <xf:trigger type="button" id="trigger2" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
            <xf:label><![CDATA[excel Upload]]></xf:label>
        </xf:trigger>
    	<w2:gridView checkAllType="false" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1" rowNumVisible="true" 
    		style="width: 500px;height: 150px;" dataList="data:dataList1" 
    		tooltipHeader="true" useShiftKey="true" useCtrlKey="true" >
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column13" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column12" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column11" value="name3" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column10" value="name4" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column9" value="name5" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col5" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
