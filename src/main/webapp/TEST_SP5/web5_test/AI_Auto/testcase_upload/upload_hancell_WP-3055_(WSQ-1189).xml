<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    var options = {};
    options.fileName = "test1.cell";
    gridView1.advancedExcelDownload(options);
};
scwin.trigger2_onclick = function(e) {
    dataList1.removeAll();
};
scwin.trigger3_onclick = function(e) {
    var options = {
        type: "1",
        sheetNo: 0,
        startRowIndex: 1,
        startColumnIndex: 0,
        endColumnIndex: 2
    };
    gridView1.advancedExcelUpload(options);
};
scwin.onpageload = function() {
    window.jsonData = [{
        "col1": "a1",
        "col2": "a2",
        "col3": "a3"
    }, {
        "col1": "b1",
        "col2": "b2",
        "col3": "b3"
    }, {
        "col1": "c1",
        "col2": "c2",
        "col3": "c3"
    }];
    dataList1.setJSON(jsonData);
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1"
    		style="position: absolute ;left:122px;top:67px;width: 322px;height: 123px;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column9" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column7" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px" width="70" inputType="text" displayMode="label"
    					value="name3">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody4" style="">
    			<w2:row id="row5" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="position: absolute ;left:492px;top:70px;width: 67px;height: 34px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[excelDown]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2"
    		style="position: absolute ;left:492px;top:33px;width: 67px;height: 34px;" type="button">
    		<xf:label><![CDATA[remove]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3"
    		style="position: absolute ;left:492px;top:105px;width: 67px;height: 34px;" type="button">
    		<xf:label><![CDATA[excelUp]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 