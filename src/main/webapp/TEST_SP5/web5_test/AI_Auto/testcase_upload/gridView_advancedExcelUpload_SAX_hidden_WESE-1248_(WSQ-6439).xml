        <script lazy="false" type="text/javascript"><![CDATA[
var com = {}
com.gfnUploadGridViewExcel = function (grdObj, options = {}) {
    let opts = options;

    //const width = "435";
    const width = "448";
    const height = "180";
//    const top = ((document.body.offsetHeight / 2) - (parseInt(height) / 2) + $(document).scrollTop());
//    const left = ((document.body.offsetWidth / 2) - (parseInt(width) / 2) + $(document).scrollLeft());
    const top = ((window.innerHeight - Number(height)) / 2 + window.pageYOffset) + "px";
    const left = ((document.body.offsetWidth / 2) - (Number(width) / 2) + window.pageXOffset) + "px";

    const optionParam = {};
    optionParam.advancedHidden = options.advancedHidden || false; // Boolean 고급설정 노출 여부 옵션 [default: false]

    opts.name = "Excel 파일 업로드";
    opts.type = options.type || "1"; //String, 1이면 엑셀 파일이 그리드의 보이는 결과로 만들어져있을때 0이면 엑셀 파일이 그리드의 실제 데이터로 구성되어있을때
    opts.sheetNo = options.sheetNo || 0; //Number, excel파일에서 그리드의 데이터가 있는 sheet번호
    opts.startRowIndex = options.startRowIndex || 1; //Number, [defalut:0] excel파일에서 그리드의 데이터가 시작되는 행의 번호(헤더 포함)
    opts.startColumnIndex = options.startColumnIndex || 0; //Number, [defalut:0] excel파일에서 그리드의 데이터가 시작되는 열의 번호
    opts.endColumnIndex = options.endColumnIndex || 0; //Number, [defalut = 0] excel파일에서 그리드의 데이터가 끝나는 열의 index(엑셀컬럼수가 그리드컬럼수 보다 작은 경우 그리드 컬러수를 설정)
    opts.headerExist = options.headerExist || "0"; //String, [defalut:0] excel파일에서 그리드의 데이터에 header가 있는지 여부(1이면 header 존재 0이면 없음)
    opts.footerExist = options.footerExist || "1"; // String, [defalut = 1] excel파일에서 그리드의 데이터에 footer가 있는지 여부(1이면 footer 존재 0이면 없음 기본값은 1 그리드에 footer가 없으면 적용되지 않음)
    opts.append = options.append || "0"; // String, [defalut = 0] excel파일에서 가져온 데이터를 그리드에 append시킬지 여부(1이면 현재 그리드에 데이터를 추가로 넣어줌 0이면 현재 그리드의 데이터를 삭제하고 넣음)
    opts.hidden = options.hidden || "0"; // String, [defalut = 0] 읽어들이려는 엑셀파일에 hidden column이 저장되어 있는지 여부를 설정하는 int형 숫자(0이면 엑셀파일에 hidden 데이터가 없으므로 그리드 hidden column에 빈 데이터를 삽입 1 = 엑셀파일에 hidden 데이터가 있으므로 엑셀 파일로부터 hidden 데이터를 삽입)
    opts.fillHidden = options.fillHidden || "0"; // String, [defalut = 0] Grid에 hiddenColumn에 빈 값을 넣을지를 결정하기 위한 int형 숫자(1이면 hidden Column에 빈 값을 저장하지 않음, 0이면 hidden column이 저장되어있지 않은 Excel File이라 간주하고 hidden Column에 빈 값을 넣어줌)(hidden이 0인 경우에는 fillhidden은 영향을 끼치지 않음)
    opts.skipSpace = options.skipSpace || "0"; // String, [defalut = 0] 공백무시 여부(1이면 무시 0이면 포함)
    opts.insertColumns = options.insertColumns || ""; // Array, radio, checkbox와 같은 컬럼을 엑셀에서 받아 오지 않고 사용자 컬럼 설정 으로 업로드 (데이터 구조 = [ { columnIndex:1, columnValue:"1" } ])
    opts.popupUrl = options.popupUrl || ""; // String, 업로드시에 호출할 popup의 url
    opts.status = options.status || "R"; // String, [defalut = R]업로드된 데이터의 초기 상태값, 설정하지 않으면 "R"로 설정되며 "C"값을 설정 할 수 있다.
    opts.pwd = options.pwd || ""; // String, 엑셀파일에 암호가 걸려 있는 경우, 비밀번호
    opts.features = "top="+top+",left="+left+",height="+height+",width="+width+";location=no,menubar=no,resizable=yes,scrollbars=auto,status=no,titlebar=yes,toolbar=no";
    opts.wframe = true;
    opts.maxFileSize = options.maxFileSize || 1000000 * 10; // Number 업로드 파일 제한 사이즈 [default: 1000000 * 10]
    opts.optionParam = optionParam;
    //엑셀업로드 기본 동작방식 변경 (POI -> SAX)
    //POI : 엑셀 데이터(row) 전체 파싱
    //SAX : 엑셀 데이터(row) 분할 파싱 (chunkNum 지정값에 의존)
    //opts.loadingMode = options.loadingMode || "POI";
    ///* 260602 추가오류 발견으로 주석처리
    opts.loadingMode = options.loadingMode || "SAX";
    opts.chunkNum    = options.chunkNum || 10000;
    if(opts.loadingMode !== 'SAX') {
        delete opts.chunkNum;
    }
    //*/
    grdObj.advancedExcelUpload(opts);
};

/********************************************************************************
 * 설명 : 엑셀업로드 팝업
