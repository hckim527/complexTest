<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="col1" dataType="text"></w2:column>
						<w2:column id="col2" name="col2" dataType="text"></w2:column>
						<w2:column id="col3" name="col3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataMap id="dataMap1">
					<w2:keyInfo>
						<w2:key id="key1" name="key1" dataType="text"></w2:key>
						<w2:key id="key2" name="key2" dataType="text"></w2:key>
						<w2:key id="key3" name="key3" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target="data:json" action="submission_executeSubmission_WESD-90_(WSQ-4263).json" method="post" mediatype="application/json"
        		encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="" ev:submit=""
        		ev:submitdone="scwin.submission1_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        	<xf:submission id="submission2" ref="" target="data:json" action="submission_executeSubmission_WESD-90_(WSQ-4263).json" method="post" mediatype="application/json"
        		encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="synchronous" processMsg="" ev:submit=""
        		ev:submitdone="scwin.submission1_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.submission1_submitdone = function(e) {};
scwin.trigger1_onclick = function(e) {
    $p.executeSubmission("submission1");
};
scwin.trigger2_onclick = function(e) {
    $p.executeSubmission("submission2");
};
scwin.trigger3_onclick = function(e) {
    $p.ajax({
        "action": "submission_executeSubmission_WESD-90_(WSQ-4263)",
        "mode": "asynchronous",
        "mediatype": "application/json",
        "method": "post",
        "success": function(e) {
            $p.data.set("json", e.responseJSON);
        }
    });
};
scwin.trigger4_onclick = function(e) {
    $p.ajax({
        "action": "submission_executeSubmission_WESD-90_(WSQ-4263)",
        "mode": "synchronous",
        "mediatype": "application/json",
        "method": "post",
        "success": function(e) {
            $p.data.set("json", e.responseJSON);
        }
    });
};
scwin.trigger5_onclick = function(e) {
    textbox1.setValue($p.getCurrentServerDate("yyyyMMddHHmmssSSS"));
};
scwin.trigger16_onclick = function(e) {
    $p.createSubmission({
        "id": "submission_dynamic",
        "action": "submission_executeSubmission_WESD-90_(WSQ-4263)",
        "mode": "synchronous",
        "mediatype": "application/json",
        "method": "post",
        "submitDoneHandler": function(e) {
            $p.data.set("json", e.responseJSON);
        }
    });
    $p.executeSubmission("submission_dynamic");
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="height:35px;">
    		<xf:trigger id="trigger1" style="height:35px;width:180px;" type="button" ev:onclick="scwin.trigger1_onclick">
    			<xf:label><![CDATA[$p.executeSubmission(async)]]></xf:label>
    		</xf:trigger>
    		<xf:trigger id="trigger2" style="height:35px;width:180px;" type="button" ev:onclick="scwin.trigger2_onclick">
    			<xf:label><![CDATA[$p.executeSubmission(sync)]]></xf:label>
    		</xf:trigger>
    		<xf:trigger type="button" id="trigger16" style="height:35px;width:180px;" ev:onclick="scwin.trigger16_onclick">
    			<xf:label><![CDATA[$p.createSubmission(sync)]]></xf:label>
    		</xf:trigger>
    	</xf:group>
    	<xf:group id="" style="height:35px;"><xf:trigger id="trigger3" style="height:35px;width:180px;" type="button" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[$p.ajax(async)]]></xf:label>
    	</xf:trigger><xf:trigger id="trigger4" style="height:35px;width:180px;" type="button" ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[$p.ajax(sync)]]></xf:label>
    	</xf:trigger></xf:group>
    	<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id=""
    		style="width:505px;height:261px;">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70" value="col1"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" inputType="text" width="70" value="col2"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1" removeBorderStyle="false" style="" width="70" inputType="text" value="col3"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" width="70" inputType="text" value=""
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:input adjustMaxLength="false" id="" style="width:170px;height:34px;" ref="data:dataMap1.key1"></xf:input>

    	<xf:group id="" style="height:71px;">
    		<xf:trigger id="trigger5" style="width:180px;height:35px;" type="button" ev:onclick="scwin.trigger5_onclick">
    			<xf:label><![CDATA[$p.getCurrentServerDate]]></xf:label>
    		</xf:trigger>
    		<w2:textbox id="textbox1" style="width:250px;height:35px;" label=""></w2:textbox>
    	</xf:group>
    	
    </body>
</html>
 