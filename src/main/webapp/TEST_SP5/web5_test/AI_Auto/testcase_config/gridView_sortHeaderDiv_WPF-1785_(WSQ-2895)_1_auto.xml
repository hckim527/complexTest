scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. <sortable value='true'/><sortHeaderDiv value='true'/> 설정한다.
    //1. Set <sortable value = 'true' /> <sortHeaderDiv value = 'true' />
    //Verify 1. header에 오름차순 등이 보여야함.
    //1. The ascending order should be shown in the header.
    WebSquare.wUnit.addCommand("assert", "document.getElementsByClassName('w2grid_head_sort_div_main_btn w2grid_head_sort_none_btn')[0].innerText == '오름차순 정렬'", "true");
    WebSquare.wUnit.addCommand("assert", "document.getElementsByClassName('w2grid_head_sort_div_main_btn w2grid_head_sort_none_btn')[1].innerText == '오름차순 정렬'", "true");
    WebSquare.wUnit.addCommand("assert", "document.getElementsByClassName('w2grid_head_sort_div_main_btn w2grid_head_sort_none_btn')[2].innerText == '오름차순 정렬'", "true");
    WebSquare.wUnit.addCommand("pause", "2000");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

