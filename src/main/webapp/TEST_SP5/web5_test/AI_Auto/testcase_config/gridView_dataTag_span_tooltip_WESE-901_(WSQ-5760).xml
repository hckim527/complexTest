<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[여름]]></col1>
            				<col2><![CDATA[겨울]]></col2>
            				<col3><![CDATA[햇빛]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[봄]]></col1>
            				<col2><![CDATA[dfsdfsdfasdfsdfsdfsdfsdfsdfasd]]></col2>
            				<col3><![CDATA[눈]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[가을]]></col1>
            				<col2><![CDATA[장마]]></col2>
            				<col3><![CDATA[번개]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[r]]></col1>
            				<col2><![CDATA[r]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[s]]></col1>
            				<col2><![CDATA[d]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.tooltip = function(rowIndex, colIndex, label, isOverflow) {
  /* console.log(rowIndex);
  console.log(colIndex); */
  if (rowIndex==1 && colIndex==1) 
    return label;
  else
    return false;
    
};

  scwin.getType = function ( info ) {
             
            var rowIndex = info.rowIndex;
            var colIndex = info.colIndex;
            var returnInfo;
             
            //inputType을 바꿀 조건
            if (dataList1.getCellData(rowIndex, "col2") ==  "바람") {
                returnInfo = {
                    id : "dynamic_link_" + rowIndex + "_" + colIndex,
                    inputType : "link",
                    options : {
                    }
                };
                 
            } else {
                returnInfo = {
                    id : "dynamic_text_" + rowIndex + "_" + colIndex,
                    inputType : "text",
                    options : {
                    }
                };
                 
                 
            }
              
            if(returnInfo) {
                console.log( "[typeGetter] (" + rowIndex + ", " + colIndex + ") : " +returnInfo.inputType);
            }
             
            return returnInfo;
             
        };]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:textbox id="" label='inputType="custom"' style="width: 150px;height: 23px;font-size:18px;font-weight:bold;"></w2:textbox>
    	<w2:gridView checkAllType="false" defaultCellHeight="20" id="" style="width:500px;height:117px;" dataList="data:dataList1"
    		tooltipDisplay="true" tooltipFormatter="scwin.tooltip" tooltipShowAlways="true">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column5" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column4" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column3" value="name3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="custom" style="" id="col2" value="" displayMode="label" typeGetter="scwin.getType"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox id="" label='inputType="link"' style="width: 150px;height: 23px;font-size:18px;font-weight:bold;"></w2:textbox>
    	<w2:gridView checkAllType="false" dataList="data:dataList1" defaultCellHeight="20" id="" style="width: 500px;height: 150px;"
    		tooltipDisplay="true"  >
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header2" style="">
    			<w2:row id="row3" style="">
    				<w2:column displayMode="label" id="column5" inputType="text" style="" value="name1" width="70"></w2:column>
    				<w2:column displayMode="label" id="column4" inputType="text" style="" value="name2" width="70"></w2:column>
    				<w2:column displayMode="label" id="column3" inputType="autoComplete" style="" value="name3" width="70"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody2" style="">
    			<w2:row id="row4" style="">
    				<w2:column displayMode="label" id="col1" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col2" inputType="link" style="" value="" width="70"></w2:column>
    				<w2:column displayMode="label" id="col3" inputType="text" style="" value="" width="70"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
