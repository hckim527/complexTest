<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column></w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.fn_excel = function() {
    var options = {};
    options.fileName = "한글.xlsx";
    options.colMerge = "true";
    //options.type = "1";
    //options.rowNumVisible = "true";
    options.colMergeTextAlign = "top";
    grid1.advancedExcelDownload(options, {});
};
scwin.fn_upload = function() {
    var options = {};
    options.sheetNo = "0";
    options.footerExist = "0";
    options.headerExist = "1";
    options.hidden = "0"
    options.startRowIndex = "1";
    options.startColumnIndex = "0";
    options.endColumnIndex = "1";
    grid1.advancedExcelUpload(options);
};
scwin.trigger1_onclick = function(e) {
    scwin.fn_excel();
};
scwin.trigger2_onclick = function(e) {
    scwin.fn_upload();
};
scwin.onpageload = function() {
    window.jsonData = [{
            "col1": "1111",
            "col2": "2222"
        },
        {
            "col1": "1111",
            "col2": "2222"
        },
        {
            "col1": "1111",
            "col2": "2222"
        },
        {
            "col1": "1111",
            "col2": "2222"
        }
    ];
    dataList1.setJSON(jsonData);
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" id="grid1" style="position: relative;width: 500px;height: 150px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false" fixedColumnWithHidden="" useShiftKey="true" visibleRowNum=""
    		rowNumVisible="false" autoFit="lastColumn" rowNumHeaderValue="순번" rowStatusWidth="40" scrollByColumnAdaptive="false">
    		<w2:header id="header1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column3" style="height:20px;" width="120" inputType="text" displayMode="label" value="코드">
    				</w2:column>
    				<w2:column blockSelect="false" id="column10" style="height:20px;" inputType="text" width="190" displayMode="label" value="명">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row3" style="">
    				<w2:column blockSelect="false" id="col1" width="70" inputType="text" displayMode="label" readOnly="true"></w2:column>
    				<w2:column blockSelect="false" id="col2" width="70" inputType="text" displayMode="label" readOnly="true" colMerge="true"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[엑셀 다운]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[엑셀 업로드]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 