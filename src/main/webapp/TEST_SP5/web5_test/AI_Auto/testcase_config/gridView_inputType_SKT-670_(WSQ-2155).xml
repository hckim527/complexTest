		<script type="text/javascript" lazy="false"><![CDATA[
scwin.getType = function(info) {
    var rowIndex = info.rowIndex;
    var colIndex = info.colIndex;
    var returnInfo;
    var nodeSet = dataListGetType.getCellData(0, "nodeSet");
    switch (colIndex) {
        case 1:
            returnInfo = {
                id: "dynamic_select1_" + rowIndex + "_" + colIndex,
                inputType: "select",
                options: {
                    viewType: "icon"
                },
                itemSet: {
                    nodeset: nodeSet,
                    label: "col1",
                    value: "col2"
                }
            }
            break;
            break;
    }
    if (returnInfo) {
        console.log("[typeGetter] (" + rowIndex + ", " + colIndex + ") : " + nodeSet);
    }
    return returnInfo;
}

]]></script>
