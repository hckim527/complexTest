<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="ID" name="ID" dataType="text"></w2:column>
        				<w2:column id="Age" name="Age" dataType="text"></w2:column>
        				<w2:column id="Region" name="Region" dataType="text"></w2:column>
        				<w2:column id="Hobby" name="Hobby" dataType="text"></w2:column>
        				<w2:column id="Status" name="Status" dataType="text"></w2:column>
        				<w2:column id="Income" name="Income" dataType="text"></w2:column>
        				<w2:column id="Frequency" name="Frequency" dataType="text"></w2:column>
        				<w2:column id="Expense" name="Expense" dataType="text"></w2:column>
        				<w2:column id="Date" name="Date" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<!-- submission1 : withCredentials="true" 개별 지정 (현재 동작 O) -->
        	<xf:submission id="submission1" ref="" target="data:json,dataList1" action="data.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="" withCredentials="true">
        	</xf:submission>
        	<!-- submission2 : withCredentials 미지정 (전역 config 로 적용돼야 할 대상 / 현재는 false) -->
        	<xf:submission id="submission2" ref="" target="data:json,dataList1" action="data.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="" ev:submit="" ev:submitdone="" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
    // [검증 후킹] send 직전, 실제 XHR 객체의 withCredentials 값을 콘솔에 출력
    // 엔진팀 확인 포인트: submission2(미지정) 가 false 로 나가는 것이 전역 config 미지원의 직접 증거.
    if (!XMLHttpRequest.prototype.__wcHooked) {
        var origSend = XMLHttpRequest.prototype.send;
        XMLHttpRequest.prototype.send = function () {
            try {
                console.log("[withCredentials check] xhr.withCredentials = " + this.withCredentials);
            } catch (e) {}
            return origSend.apply(this, arguments);
        };
        XMLHttpRequest.prototype.__wcHooked = true;
    }
};

scwin.onpageunload = function () {

};

// 1) withCredentials="true" 개별 지정 → 현재도 xhr.withCredentials === true
scwin.trigger1_onclick = function (e) {
    var objSubmission = $p.getSubmission("submission1");
    objSubmission.action = scwin.getfolderPath() + '/data.json';
    console.log("=== [submission1] withCredentials 개별 지정(true) 실행 ===");
    $p.executeSubmission("submission1");
};

// 2) withCredentials 미지정 → 전역 config 로 true 가 적용돼야 하나, 현재는 false
scwin.trigger2_onclick = function (e) {
    var objSubmission = $p.getSubmission("submission2");
    objSubmission.action = scwin.getfolderPath() + '/data.json';
    console.log("=== [submission2] withCredentials 미지정(전역 config 의존) 실행 ===");
    $p.executeSubmission("submission2");
};

scwin.getfolderPath = function () {

    var currentPath = window.location.href;
    var folderPath;

    if (currentPath.includes("mainContainer")) {
        console.log("true  ===> " + $p.getFrameId());
        const cmtFrame = $p.getComponentById($p.getFrameId());
        currentPath = cmtFrame.getSrc();
        folderPath = currentPath.substring(0, currentPath.lastIndexOf('/'));
    } else {
        console.log("false  ===> ");
        folderPath = currentPath.split('w2xPath=')[1].substring(0, currentPath.split('w2xPath=')[1].lastIndexOf('/'));
    }
    return folderPath;
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="margin: 10px;"><w2:textbox tagname="h1" style="color: blue;margin-bottom: 10px;" id="textbox1" label="submission withCredentials 전역 config 미지원 재현" escape="false"></w2:textbox><w2:textbox tagname="h2" style="height: 23px;margin-bottom: 10px;color: blue;" id="textbox2" label="확인 방법 (개발자도구 Console)"></w2:textbox><w2:textbox style="color: blue;margin-bottom: 30px;" id="textbox3" label='1. 개발자도구(F12) Console 을 연다. &lt;br/&gt;2. [submission1] 버튼 클릭 → 로그 &quot;xhr.withCredentials = true&quot; (개별 지정은 정상 동작). &lt;br/&gt;3. [submission2] 버튼 클릭 → 로그 &quot;xhr.withCredentials = false&quot; (withCredentials 미지정, 전역 config 로 적용할 경로가 없음). &lt;br/&gt;※ 핫픽스(전역 config 지원) 적용 후에는 config 노드 설정 시 submission2 도 true 로 나가야 함.' escape="false">
    	</w2:textbox><xf:trigger ev:onclick="scwin.trigger1_onclick" style="display: block;height:42px;line-height:32px;padding:5px;background-color:coral;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" id="trigger1" type="button">
    		<xf:label><![CDATA[[submission1] withCredentials="true" 개별 지정]]></xf:label>
    	</xf:trigger><xf:trigger ev:onclick="scwin.trigger2_onclick" style="display: block;height:42px;line-height:32px;padding:5px;background-color:#5b9bd5;color:#fff;font-size:15px;weight: bolder;font-weight:bolder;margin-bottom:10px;text-align: left;" id="trigger2" type="button">
    		<xf:label><![CDATA[[submission2] withCredentials 미지정 (전역 config 의존)]]></xf:label>
    	</xf:trigger>
    	<w2:gridView scrollByColumnAdaptive="false" checkAllType="false" dataList="data:dataList1" style="border: solid gray 1px;"
    		scrollByColumn="false" id="gridView1" visibleRowNum="13" autoFit="allColumn" defaultCellHeight="20" visibleRowNumFix="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="height:20px" id="column9" value="ID" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column8" value="Age" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column7" value="Region" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column6" value="Hobby" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column5" value="Status" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column4" value="Income" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column3" value="Frequency" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column2" value="Expense" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column14" value="Date" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="height:20px" id="ID" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Age" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Region" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Hobby" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Status" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Income" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Frequency" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="Expense" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="Date" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView></xf:group></body>
</html>
