                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:linkedDataList bind="dataList1" id="linkedDataList1">
                    <w2:condition type="filter"><![CDATA[col1 == ref('data:dlt_excelDownload.date')]]></w2:condition>
                    <w2:condition type="sort"><![CDATA[]]></w2:condition>
                </w2:linkedDataList>
            </w2:dataCollection>
            <w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var aa = ["1", "DA1", "A1", "1", "DA2", "A2", "1", "DA3", "A3", "2", "DB1", "B1", "2", "DB2", "B2", "2", "DB3", "B3", "3", "DC1", "C1", "3", "DC2", "C2", "3", "DC3", "C3", "3", "DC4", "C4", "4", "DE1", "E1", "4", "DE2", "E2"];
    dataList1.setData(aa);
    var bb = ["1", "A1", "2", "B1", "3", "C1", "4", "E1", "1", "A2", "2", "B2", "3", "C2", "4", "E2", "1", "A1"];
    dlt_excelDownload.setData(bb);
};
scwin.trigger1_onclick = function(e) {
    var excelOpt = {}; //excel download 옵션 
    excelOpt.fileName = "excelData.xlsx"; //또는 xlsx 확장자 사용
    grd_excelDownload.advancedExcelDownload(excelOpt);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:group class="content_frame" id="mainGroup" style="">
            <xf:group class=" tit_wrap" id="" style="">
                <xf:group class="fl" id="" style="">
                    <xf:group class="total_count" id="" style=""></xf:group>
                </xf:group>
                <xf:group class="opts" id="" style="">
                    <xf:trigger type="button" style="width: 80px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
                        <xf:label><![CDATA[엑셀]]></xf:label>
                    </xf:trigger>
                </xf:group>
            </xf:group>
            <w2:gridView applyAllColumnStyle="false" autoFit="" class="grid flex_no" dataList="data:dlt_excelDownload"
