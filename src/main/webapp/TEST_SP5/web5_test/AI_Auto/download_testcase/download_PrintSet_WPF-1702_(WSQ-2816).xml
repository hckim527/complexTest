        <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    //var param = pageParam.params;
    var param = pageParam.params;
    var searchInfo = param.split("|");
    dm_searchInfo.set("year", searchInfo[0]);
    dm_searchInfo.set("type", searchInfo[1]);
    dm_searchInfo.set("titleNm", searchInfo[2]);
    scwin.fn_search();
};
scwin.fn_search = function() {
    // generator1.removeAll();
    var submission = $w.getSubmission("selectRecoverySupportStatList01");
    submission.action = "/" + CommonUtil.getContextName() + "/dmi/nd/cmm/recoverySupportStatList" + dm_searchInfo.get("type") + ".do";
    $w.executeSubmission("selectRecoverySupportStatList01");
};
scwin.fn_changeGridStyle = function(value, formattedValue, rowIdx, colIdx) {
    if ("3" == value) {
        //grid_recoverySupportStatList01.setCellBackgroundColor(rowIdx, 1 , '#0000FF'); //blue 로 배경색 설정   
        //grid_recoverySupportStatList01.setRowColor(rowIdx,'#0000FF');  
        grid_recoverySupportStatList01.setRowBackgroundColor(rowIdx, '#fff7f7');
        grid_recoverySupportStatList01.setRowColor(rowIdx, '#c60000');
        // dl_recoverySupportStatList01.getCellData( 0 , 5 );
        // grid_recoverySupportStatList01.getCellData(row ,col );
        // datalist.getCellData()
    } else if ("2" == value) {
        grid_recoverySupportStatList01.setRowBackgroundColor(rowIdx, '#f2fbff');
        grid_recoverySupportStatList01.setRowColor(rowIdx, 'blue');
        // grid_recoverySupportStatList01.setDisplayFormat( colIndex , displayFormat )
    }
    return formattedValue;
};
scwin.fn_addSpace = function(value, formattedValue, rowIdx, colIdx) {
    var val = grid_recoverySupportStatList01.getCellData(rowIdx, 13); // 해당 위치와 같은 데이터리스트가 가지고 있는 구분 값을 확인
    if ("2" == val) {
        formattedValue = "&nbsp&nbsp&nbsp&nbsp" + formattedValue;
    } else if ("1" == val) {
        formattedValue = "&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp" + formattedValue;
    } else if ("0" == val) {
        formattedValue = "&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp" + formattedValue;
    }
    return formattedValue;
};
scwin.btnExcel1_onclick = function() {
    var options = {};
    options.fileName = "test.xls";
    options.sheetName = "test";
    options.type = "0"; // displayformatter 혹은 customformatter 통해 이용한 것은 날려버림
    options.autoSizeColumn = "true";
    options.startRowIndex = 1;
    //              options.removeColumns    =  13; 
    options.startColumnIndex = 0;
    options.bodyFontSize = "8";
    // 				options.foldColumns      =  13;
    options.printSet = {
        "landScape": "false",
        "fitToPage": "false",
        "pageSize": "A4",
        "scale": "80"
    };
    var infoArr = [];
    var infoObj = {
        rowIndex: 0,
        colIndex: 0,
        rowSpan: 1,
        colSpan: 13,
        text: "그리드 다운로드 샘플 (천원단위)",
        textAlign: "left",
        drawBorder: false
    };
    infoArr.push(infoObj);
    grid_recoverySupportStatList01.advancedExcelDownload(options, infoArr);
};
scwin.selectRecoverySupportStatList01_submitdone = function(e) {
    if (!CommonUtil.errorCheck(dm_resultMap)) return;
    var frameSize = (dl_recoverySupportStatList01.getRowCount() * 20) + 100;
    WebSquare.wUnit.getJq("#grid_recoverySupportStatList01").height(frameSize);
    parent.fn_setIframeSize(frameSize + 200);
};
