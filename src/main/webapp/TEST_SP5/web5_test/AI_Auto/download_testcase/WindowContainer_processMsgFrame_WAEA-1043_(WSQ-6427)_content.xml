<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare"
    xmlns:xf="http://www.w3.org/2002/xforms">
<head meta_author="Inswave Systems" meta_screenName="멀티데이타리스트 엑셀다운로드 재현" meta_desc="multipleDataListDownload 시 processMsg 전체화면 표시/미소멸 재현용 콘텐츠 화면">
    <w2:type>COMPONENT</w2:type>
    <w2:buildDate />
    <xf:model>
        <xf:instance>
            <data xmlns="" />
        </xf:instance>
        <w2:dataCollection baseNode="map">
            <w2:dataList baseNode="list" repeatNode="map" id="dlt_sample" saveRemovedData="true">
                <w2:columnInfo>
                    <w2:column id="SAMPLE_CD" name="샘플코드" dataType="text"></w2:column>
                    <w2:column id="SAMPLE_NM" name="샘플명" dataType="text"></w2:column>
                    <w2:column id="IS_USE" name="사용여부" dataType="text"></w2:column>
                    <w2:column id="CONTENT" name="샘플설명" dataType="text"></w2:column>
                    <w2:column id="NOTE" name="비고" dataType="text"></w2:column>
                </w2:columnInfo>
                <w2:data use="true">
                    <w2:row>
                        <SAMPLE_CD><![CDATA[001000000]]></SAMPLE_CD>
                        <SAMPLE_NM><![CDATA[샘플 A]]></SAMPLE_NM>
                        <IS_USE><![CDATA[Y]]></IS_USE>
                        <CONTENT><![CDATA[재현용 데이터 1]]></CONTENT>
                        <NOTE><![CDATA[]]></NOTE>
                    </w2:row>
                    <w2:row>
                        <SAMPLE_CD><![CDATA[002000000]]></SAMPLE_CD>
                        <SAMPLE_NM><![CDATA[샘플 B]]></SAMPLE_NM>
                        <IS_USE><![CDATA[Y]]></IS_USE>
                        <CONTENT><![CDATA[재현용 데이터 2]]></CONTENT>
                        <NOTE><![CDATA[]]></NOTE>
                    </w2:row>
                    <w2:row>
                        <SAMPLE_CD><![CDATA[003000000]]></SAMPLE_CD>
                        <SAMPLE_NM><![CDATA[샘플 C]]></SAMPLE_NM>
                        <IS_USE><![CDATA[N]]></IS_USE>
                        <CONTENT><![CDATA[재현용 데이터 3]]></CONTENT>
                        <NOTE><![CDATA[]]></NOTE>
                    </w2:row>
                </w2:data>
            </w2:dataList>
        </w2:dataCollection>
        <w2:workflowCollection>
        </w2:workflowCollection>
    </xf:model>
    <w2:layoutInfo />
    <w2:publicInfo method="" />
    <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
};

/*
 * [정상 1] 그리드뷰 엑셀다운로드
 * processMsg가 정상 표시/종료됨 (고객사 환경에서도 정상 동작 케이스)
 */
scwin.btn_gridExcel_onclick = function () {
    grd_sample.advancedExcelDownload({ fileName : "excel_gridView.xlsx" });
};

/*
 * [정상 2] 멀티그리드뷰 엑셀다운로드
 * processMsg가 정상 표시/종료됨 (고객사 환경에서도 정상 동작 케이스)
 */
scwin.btn_multiGridDwn_onclick = function () {
    var options = {
        common : {
            fileName : "excel_multiGrid.xlsx",
            multipleSheet : true
        },
        excelInfo : [
            {
                gridId : "grd_sample",
                sheetName : "첫번째 sheet",
                wframeId : $p.getFrameId()
            }
        ]
    };
    WebSquare.util.multipleExcelDownload(options);
};

/*
 * [현상 재현] 멀티데이타리스트 엑셀다운로드
 * 현상 1: processMsg가 창 내부가 아닌 전체 화면(top)에 표시됨 (processMsgFrame:"true" 미적용)
 * 현상 2: 다운로드 완료 후에도 processMsg가 사라지지 않음
 * ※ wframeId 미지정 시 top 영역에서 dataList를 찾지 못해
 *    "Cannot read properties of undefined (reading 'getDataLength')" TypeError 발생
 */
scwin.btn_dataListDwn_onclick = function () {
    var options = {
        common : {
            fileName : "excel_dataList.xlsx",
            showProcess : true,
            multipleSheet : true
        },
        excelInfo : [
            {
                dataListId : "dlt_sample",
                sheetName : "첫번째 sheet",
                startRowIndex : 3,
                startColumnIndex : 0,
                wframeId : $p.getFrameId()
            }
        ]
    };
    WebSquare.util.multipleDataListDownload(options);
};
    ]]></script>
</head>
<body ev:onpageload="scwin.onpageload">
    <xf:group class="sub_contents" id="grp_content" style="padding:10px;">
        <xf:group id="" class="btnbox" style="margin-bottom:10px;">
            <xf:trigger type="button" id="btn_gridExcel" class="btn_cm download" style="" ev:onclick="scwin.btn_gridExcel_onclick">
                <xf:label><![CDATA[그리드뷰 엑셀다운로드 (정상)]]></xf:label>
            </xf:trigger>
            <xf:trigger type="button" id="btn_multiGridDwn" class="btn_cm download" style="" ev:onclick="scwin.btn_multiGridDwn_onclick">
                <xf:label><![CDATA[멀티그리드뷰 엑셀다운로드 (정상)]]></xf:label>
            </xf:trigger>
            <xf:trigger type="button" id="btn_dataListDwn" class="btn_cm download" style="" ev:onclick="scwin.btn_dataListDwn_onclick">
                <xf:label><![CDATA[멀티데이타리스트 엑셀다운로드 (현상 재현)]]></xf:label>
            </xf:trigger>
        </xf:group>
        <xf:group id="" class="gvwbox" style="">
            <w2:gridView id="grd_sample" dataList="data:dlt_sample" style="height:300px;"
                autoFit="allColumn" rowNumVisible="true" keepDefaultColumnWidth="true">
                <w2:caption id="caption1" style="" value="멀티데이타리스트 엑셀다운로드 재현용 그리드"></w2:caption>
                <w2:header id="header1" style="">
                    <w2:row id="row1" style="">
                        <w2:column id="SAMPLE_CD" inputType="text" value="샘플코드" width="100" style=""></w2:column>
                        <w2:column id="SAMPLE_NM" inputType="text" value="샘플명" width="200" style=""></w2:column>
                        <w2:column id="IS_USE" inputType="text" value="사용여부" width="80" style=""></w2:column>
                        <w2:column id="CONTENT" inputType="text" value="샘플설명" width="200" style=""></w2:column>
                        <w2:column id="NOTE" inputType="text" value="비고" width="100" style=""></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody id="gBody1" style="">
                    <w2:row id="row2" style="">
                        <w2:column id="SAMPLE_CD" inputType="text" width="100" style=""></w2:column>
                        <w2:column id="SAMPLE_NM" inputType="text" width="200" style="" textAlign="left"></w2:column>
                        <w2:column id="IS_USE" inputType="text" width="80" style=""></w2:column>
                        <w2:column id="CONTENT" inputType="text" width="200" style="" textAlign="left"></w2:column>
                        <w2:column id="NOTE" inputType="text" width="100" style="" textAlign="left"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
    </xf:group>
</body>
</html>
