<?xml version="1.0" encoding="EUC-KR"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>COMPONENT</w2:type>
    	<w2:buildDate />
    	<w2:MSA />
    	<xf:model>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
    				<w2:columnInfo>
    					<w2:column id="col1" name="name1" dataType="text"></w2:column>
    					<w2:column id="col2" name="name2" dataType="text"></w2:column>
    					<w2:column id="col3" name="name3" dataType="text"></w2:column>
    					<w2:column id="col4" name="name4" dataType="text"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection />
    	</xf:model>
    	<w2:layoutInfo />
    	<w2:publicInfo method="" />
    	<script lazy="false" type="text/javascript"><![CDATA[
			scwin.onpageload = function() {
				var jsonData = [{col1:"1", col2:"1","col4":"12"}
								,{col1:"1", col2:"1","col4":"123"}
								,{col1:"0", col2:"1","col4":"1234"}
								,{col1:"0", col2:"1","col4":"12345"}
								,{col1:"0", col2:"1","col4":"123456"}
								,{col1:"1", col2:"1","col4":"1234567"}
								,{col1:"0", col2:"1","col4":"12345678"}]
				dataList1.setJSON(jsonData);
				gridView1.setFocusedCell(0, 1, false);
			};

scwin.trigger1_onclick = function(e) {
	var opts = {};
	opts.fileName = "boldTest.xlsx";
	opts.type = "1";
	opts.useClass = "true";
	opts.useStyle = "true";
	
	opts.useXHR = true;
	
	gridView1.advancedExcelDownload(opts);
};



scwin.fn_custom = function(data, formatData, rowIdx, colIdx){
	var temp = dataList1.getCellData(rowIdx, "col1");
	if(temp == "1"){
		gridView1.setCellClass(rowIdx, "col4", "test1");
		
		gridView1.setCellClass(rowIdx, "col2", "test1");
		gridView1.setCellClass(rowIdx, "col1", "test1");
	}
	return data;
}
]]></script>
    	<style type="text/css"><![CDATA[
    		.test1 {font-weight: bold !important;}
    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[excel]]></xf:label>
    	</xf:trigger>
    	<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width: 500px;height: 150px;" dataList="data:dataList1" focusMode="row">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="" id="column12" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column11" value="name2" displayMode="label" colSpan=""
    					rowSpan="2">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="" id="column10" value="name3" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column9" value="name4" displayMode="label"></w2:column>
    			</w2:row>
    			<w2:row style="" id="row5">
    				<w2:column width="70" inputType="text" style="" id="column20" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column18" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column17" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col2" value="" class="test1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label" customFormatter="scwin.fn_custom"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>