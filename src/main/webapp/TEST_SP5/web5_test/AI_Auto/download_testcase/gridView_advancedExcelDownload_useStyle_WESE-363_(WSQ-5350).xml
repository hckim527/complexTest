    						<w2:column displayMode="label" id="book_name" inputType="text" textAlign="left" width="178"></w2:column>
    						<w2:column dataType="number" displayFormat="#,###" displayMode="label" id="price" inputType="text"
    							textAlign="right" width="63">
    						</w2:column>
    						<w2:column dataType="date" displayFormat="yyyy-MM-dd" displayMode="label" id="published_date" inputType="text"
    							width="83">
    						</w2:column>
    					</w2:row>
    				</w2:gBody>
    			</w2:gridView>
    		</xf:group>
