    	<w2:layoutInfo />
    	<w2:publicInfo method="" />
    	<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    //GridView 'grd_exam1'의 컬럼 '도서명'의 2번째 행의 셀에 class 'P00186_exam1'을 적용합니다.
    //class 'P00186_exam1'는 '/css/example.css'에 정의되어 있습니다.
    grd_exam1.setCellClass(1, "book_name", "P00233_exam1");
    //grd_exam1.setCellBackgroundColor(2, "book_name", "blue");
    //grd_exam1.setCellColor(2, "book_name", "white");
};

/**
 * 버튼 [엑셀 다운로드 - 기본] 클릭 시
 */
scwin.btn_ex1_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "SP5_EXAMPLE_P00233_TYPE1.xlsx"
    };
    
    grd_exam1.advancedExcelDownload(jsnOptions);
};

/**
 * 버튼 [엑셀 다운로드 - Style 적용하기] 클릭 시
 */
scwin.btn_ex2_onclick = function (e) {
    var jsnOptions;

    jsnOptions = {
        fileName: "SP5_EXAMPLE_P00233_TYPE2.xlsx", //엑셀의 파일명
        useStyle : "true",
        useClass : "true"
    };
    //options.useStyle <String:N> [default: false] 다운로드시 css를 제외한, style을 excel에도 적용할 지 여부 (배경색,폰트)

    //GridView "grd_exam1"의 엑셀 다운로드 실행
    grd_exam1.advancedExcelDownload(jsnOptions);
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" style="max-width: 500px;padding: 10px;">
