<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[X1]]></col1>
            				<col2><![CDATA[Y1]]></col2>
            				<col3><![CDATA[test1]]></col3>
            				<col4><![CDATA[1000]]></col4>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[X2]]></col1>
            				<col2><![CDATA[Y2]]></col2>
            				<col3><![CDATA[test2]]></col3>
            				<col4><![CDATA[2000]]></col4>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[X3]]></col1>
            				<col2><![CDATA[Y3]]></col2>
            				<col3><![CDATA[test3]]></col3>
            				<col4><![CDATA[3000]]></col4>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[X4]]></col1>
            				<col2><![CDATA[Y4]]></col2>
            				<col3><![CDATA[test4]]></col3>
            				<col4><![CDATA[4000]]></col4>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript"><![CDATA[
	scwin.onpageload = function() {
		
	};

	scwin.trigger1_onclick = function(e) {
		var options = {}; //excel download 옵션 

		options.type = "1";
		options.fileName = "excelData.xlsx";
		options.headerXFontSize = "15"; // [defalut: 10] excel파일에서 상단 header 영역의 font size (정상 : 15px로 적용)
		options.headerYFontSize = "15"; // [defalut: 10] excel파일에서 좌측축 영역의 font size (비정상 : 11px로 적용)
		
		pivot1.pivotExcelDownload(options);
	};
]]></script>
    </head>
    <body>
    	<w2:pivot style="position:relative;width:493px;height:378px;" dataList="data:dataList1" id="pivot1" vals="col4" cols="col1"
    		valuesAxis="column" rows="col2">
    		<w2:fieldInfo>
    			<w2:field id="col1" style="" name="col1"></w2:field>
    			<w2:field id="col2" style="" name="col2"></w2:field>
    			<w2:field id="col3" style="" name="col3"></w2:field>
    			<w2:field id="col4" style="" name="col4"></w2:field>
    		</w2:fieldInfo>
    	</w2:pivot>
    	<xf:trigger type="button" id="trigger1" style="position:relative;width:182px;height:23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[pivotExcelDownload]]></xf:label>
    	</xf:trigger>
    </body>
</html>
