<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="number">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.multiDown = function(grid1id, grid2id) {
    var options = {
        common: {
            fileName: "sample.xls",
            showProcess: false
        },
        //excelInfo에 각 그리드의 정보를 입력한다.
        excelInfo: [{
                gridId: grid1id,
                sheetName: "첫번째 sheet",
                removeColumns: ""
            },
            {
                gridId: grid2id,
                sheetName: "두번째 sheet",
                removeColumns: ""
            }
        ]
    };
    WebSquare.util.multipleExcelDownload(options);
};
scwin.trigger1_onclick = function(e) {
    scwin.multiDown("gridView1", "gridView2");
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //sampleData1
    window.data1 = [{
            "col1": "a",
            "col2": "1000"
        },
        {
            "col1": "b",
            "col2": "2000"
        },
        {
            "col1": "c",
            "col2": "3000"
        },
        {
            "col1": "d",
            "col2": "4000"
        }
    ];
    //sampleData2
    window.data2 = [{
            "col1": "a",
            "col2": "1000"
        },
        {
            "col1": "c",
            "col2": "3000"
        }
    ];
    dataList1.setJSON(data1);
    dataList2.setJSON(data2);
    //MultiExcelDownload Function
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false"
    		scrollByColumnAdaptive="false" id="gridView1"
    		style="position: relative;width: 500px;height: 150px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1"
    					style="height:20px;" width="70" inputType="text"
    					displayMode="label" value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3"
    					style="height:20px;" inputType="text" width="70"
    					displayMode="label" value="name2">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1"
    					style="height:20px" width="70" inputType="text"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2"
    					style="height:20px" inputType="text" width="70"
    					displayMode="label" dataType="number">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:gridView dataList="dataList2" scrollByColumn="false"
    		scrollByColumnAdaptive="false" id="gridView2"
    		style="position: relative;width: 500px;height: 150px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1"
    					style="height:20px;" width="70" inputType="text"
    					displayMode="label" value="col1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3"
    					style="height:20px;" inputType="text" width="70"
    					displayMode="label" value="col2">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1"
    					style="height:20px" width="70" inputType="text"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2"
    					style="height:20px" inputType="text" width="70"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1"
    		style="position: relative;width: 150px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[GridView Download]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 