scwin.trigger2_onclick = function(e) {
		var options = {
	    			fileName : "gear_excelDownload.xlsx",
	    			type : "1"
	    			,autoSizeColumn : "true"
	    			,useStyle:"true"
	    			,useClass:"true"
	    			,useSubTotal:"true"
	    			,useSubTotalData : "true"
	    			,useFooter:"true"
	    			,useFooterData : "true"
	    }
	    
	    options.openFile = "true";
	    options.useXHR = "true";
	    options.advancedExcelDownloadURL = MatrixGear.getExcelDownloadURL();

		options.onSuccessCallback = scwin.excel_onSuccessCallback;
		options.onFailureCallback = scwin.excel_onFailureCallback;


		return new Promise(function(res){
			let onSuccessCallback = options.onSuccessCallback;
			let onFailureCallback = options.onFailureCallback;

			options.onFailureCallback = async function(action, msg){
				res({isSuccess: false, fileName:options.fileName, message: msg});
				console.log("gear onFailureCallback");
				if(typeof onFailureCallback == "function"){
					onFailureCallback.apply(this, arguments);
				}
			};

			options.onSuccessCallback = async function(action, msg){
				res({isSuccess: true, fileName:options.fileName, message: msg});
				if(msg.result == false){
					console.log("gear onFailureCallback");
					if(typeof onFailureCallback == "function"){
						onFailureCallback.apply(this, arguments);
						return;
					}
				}

				console.log("gear onSuccessCallback");
				if(typeof onSuccessCallback == "function"){
					onSuccessCallback.apply(this, arguments);
				}
			};
		    var infoArr = [];
		    
			gridView1.advancedExcelDownload( options, infoArr );
		});
};

