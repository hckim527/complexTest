        <script type="text/javascript" lazy="false"><![CDATA[
scwin.fn_footerFormat = function() {
    var tmpArr = grid1.getColumnAllDataArray("c");
    var tmpArr2 = grid1.getColumnAllDataArray("b");
    var tmpSum = 0; //return 시킬 값
    var tmpVal = 0; // 전,후 비교를 위한 임의 변수
    var tmpVal2 = "";
    for (var i = 0; i < tmpArr.length; i++) {
        var curVal = Number(tmpArr[i]);
        var curVal2 = tmpArr2[i];
        if (tmpVal != curVal || tmpVal2 != curVal2) {
            tmpSum = tmpSum + curVal;
            tmpVal = curVal;
            tmpVal2 = curVal2;
        }
    }
    return tmpSum;
}
scwin.onpageload = function() {
    grid1.setXML(WebSquare.ModelUtil.findInstanceNode("vector"));
}
scwin.onpageload2 = function() {
