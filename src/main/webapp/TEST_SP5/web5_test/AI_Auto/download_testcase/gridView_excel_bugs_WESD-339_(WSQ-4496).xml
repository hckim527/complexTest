					</w2:anchor>
				</xf:group>
			</xf:group>
			<xf:group class="sub_area">
				<xf:group class="grid_box">
					<w2:gridView id="grdMain" dataList="data:dlt_list" class="grid01" style="height:500px;" fixedColumn="4" mergeCellsFixedCols="bycolrec" visibleRowNum="all">
						<w2:header id="header1">
							<w2:row id="row2">
								<w2:column id="column0101" inputType="text" style="height:20px;" value="구분" width="200" colSpan="2" rowSpan="2" />
								<w2:column id="column0102" inputType="text" style="height:20px;" value="(날짜1)" width="100" />
								<w2:column id="column0103" inputType="text" style="height:20px;" value="계" width="100" rowSpan="2" />
								<w2:column id="column0104" inputType="text" style="height:20px;" value="yyyy.MM.dd" width="100" />
							</w2:row>
							<w2:row id="row1">
								<w2:column id="column0201" inputType="text" style="height:20px;" value="(날짜2)" width="100" />
								<w2:column id="column0204" inputType="text" style="height:20px;" value="yyyy.MM.dd" width="100" />
							</w2:row>
						</w2:header>
						<w2:gBody>
							<w2:row id="row41">
								<w2:column width="100" id="TYPE01" inputType="text" style="height:20px;" />
								<w2:column width="100" id="TYPE02" inputType="text" style="height:20px;" />
								<w2:column width="100" id="TYPE03" inputType="text" style="height:20px;" />
								<w2:column width="100" id="VSUM" inputType="expression" style="height:20px;" displayFormat="##,###" expression='SUM("VAL01")' />
								<w2:column width="100" id="VAL01" inputType="text" style="height:20px;" displayFormat="##,###" />
							</w2:row>
						</w2:gBody>
						<w2:subTotal targetColumnID="TYPE02" id="subTotal1">
							<w2:row id="row43">
								<w2:column width="300" id="columnSt101" inputType="text" style="height:20px;" value="서브소계" colSpan="3" />
								<w2:column width="100" id="columnSt102" inputType="expression" style="height:20px;" displayFormat="##,###" expression='SUM("VSUM")' />
								<w2:column width="100" id="columnSt103" inputType="expression" style="height:20px;" displayFormat="##,###" expression='SUM("VSUM")' />
							</w2:row>
						</w2:subTotal>
						<w2:subTotal targetColumnID="TYPE01" id="subTotal2">
