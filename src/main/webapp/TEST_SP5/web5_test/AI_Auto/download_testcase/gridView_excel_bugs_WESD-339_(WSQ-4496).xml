		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.btnDownload_onclick = function() {
    var options = {};
    options.type = "1";
    options.useSubTotal = true;
    options.useSubTotalData = true; // 가이드 필요
    options.useFooter = true;
    options.mergeCell = true;
    options.fileName = "버그 케이스 02.xls";
    grdMain.advancedExcelDownload(options);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //---------------------------------------------------------------------------------------
    // 초기화
