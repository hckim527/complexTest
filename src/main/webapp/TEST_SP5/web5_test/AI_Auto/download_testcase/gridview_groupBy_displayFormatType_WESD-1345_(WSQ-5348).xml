	scwin.onpageload = function() {
			var options = {
			sortIndex: [0],
			closeGroup: false,
			hideHeader: false,
			hideFooter:true,
			groupbyHeader : [
								{ inputType: "expression", expression: 'depthStr()', align: "center" },
								{ inputType: "expression", expression: 'depthStr()', align: "center"},
								{ inputType: "expression", expression: 'depthStr()', align: "center"},
