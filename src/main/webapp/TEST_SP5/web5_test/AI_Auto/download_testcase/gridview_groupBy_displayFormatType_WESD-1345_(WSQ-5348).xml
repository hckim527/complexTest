								{ inputType: "expression", expression: 'sum("col2")', align: "center" ,"displayFormat":"#,##0" ,"displayFormatType":"number"},
								{ inputType: "expression", expression: 'sum("col3")', align: "center" ,"displayFormat":"#,##0.0" ,"displayFormatType":"number"},
