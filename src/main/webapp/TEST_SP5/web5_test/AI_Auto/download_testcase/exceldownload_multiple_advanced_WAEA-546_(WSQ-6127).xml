<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="d1_col1" name="필드1" dataType="text"></w2:column>
            			<w2:column id="d1_col2" name="필드2" dataType="text"></w2:column>
            			<w2:column id="d1_col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="d1_col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="do1_col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="d2_col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="d2_col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="d3_col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {

       var num = 10000
		var arr = [];
		for( var i=0;i<num;i++ ) {
			for(var j=0;j<5;j++) {
				arr[i*5+j] = "dataList1_" + i+j;
			}
		}
		dataList1.setData(arr);
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger11_onclick = function(e) {
		dataList1.removeAll();
	};
	
	scwin.trigger1_onclick = function(e) {
		
        var options = { 
		    common: { 
		        fileName : "multipleDataListDownload.xlsx"
		    }, 
		    //excelInfo에 각 그리드의 정보를 입력한다.
		    excelInfo: [ 
		        { 
		            dataListId : "dataList1", 
		            sheetName : "첫번째 sheet", 
                    foldColumns : "1,2",
		            removeColumns : "" 
		        }
		    ]
		};
		WebSquare.util.multipleDataListDownload( options ); 
	};
	
    scwin.trigger13_onclick = function (e) {
        var options = { 
            type: "1", 
            fileName : "advancedExcelDownload.xlsx",
            foldColumns : "1,2"
        }; 
        gridView1.advancedExcelDownload(options);
    };
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:trigger type="button" id="trigger1" style="position:absolute;left:47px;top:34px;width:192px;height:37px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[multipleDataListDownload]]></xf:label>
    	</xf:trigger>
    	<xf:trigger id="trigger11" style="position: absolute ;left:245px;top:34px;width: 122px;height: 37px;" type="button"
    		ev:onclick="scwin.trigger11_onclick">
    		<xf:label><![CDATA[dataList 초기화]]></xf:label>
    	</xf:trigger>
    	<w2:gridView dataList="data:dataList1" summaryAuto="false" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" id="gridView1" style="position: absolute ;left:52px;top:126px;width: 415px;height: 278px;"
    		ignoreCellClick="false" syncScroll="false" ignoreToggleOnDisabled="false" summaryOnlyAuto="false" useShiftKey="true"
    		columnMove="true">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column9" style="" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column7" style="" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column5" style="" inputType="text" width="70" value="name3" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="name4" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="name5" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="d1_col1" style="" inputType="text" width="70" value="" displayMode="label"
    					colMerge="false">
    				</w2:column>
    				<w2:column blockSelect="false" id="d1_col2" style="" inputType="text" width="70" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="d1_col3" style="" inputType="text" width="70" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="d1_col4" style="" inputType="text" width="70" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="do1_col5" style="" width="70" inputType="text" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger13" style="position:absolute;left:375px;top:34px;width:204px;height:37px;" ev:onclick="scwin.trigger13_onclick">
    		<xf:label><![CDATA[advancedExcelDownload]]></xf:label>
    	</xf:trigger>
    </body>
</html>
