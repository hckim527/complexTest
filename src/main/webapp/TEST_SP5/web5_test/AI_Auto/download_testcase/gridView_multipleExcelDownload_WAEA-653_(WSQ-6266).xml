<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var arr= [];
		for (var i = 0; i < 101; i++) {
			arr.push({"col1":"1"+i,"col2":"2"+i,"col3":"3"+i,"col4":"4"+i});	
		}
		
		dataList1.insertJSON( 0 , arr );
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger1_onclick = function(e) {
		grd_gridView1.advancedExcelDownload( {} );
	};
	
	
	scwin.trigger2_onclick = function(e) {
		grd_gridView2.advancedExcelDownload( {} );
	};
	
	scwin.trigger3_onclick = function(e) {
	var options = { 
		common: { 
			fileName:"test.xls",
			processMsg:"엑셀을 다운로드 중입니다.",
			multipleSheet:true,
			showProcess:true,
			bodyFontSize : "10",
			bodyColor : "#ECDFC8",
            footerFontName : "Tahoma",
            footerFontSize : "20",
            footerColor : "#3E6EF2"
		},
		excelInfo :[
			{
				gridId :grd_gridView1.id,
				sheetName :"첫번째",
				rowsByN : "10000", //[default: 100] 다운로드 가능한 최대 행 개수 (예: 이 값이 "1000"인 경우 1000 건 이상은 다운로드 할 수 없음.)
				type:"1",
                 rowNumVisible : "false",
			},			{
				gridId :grd_gridView2.id,
				sheetName :"두번째",
				rowsByN : "10000", //[default: 100] 다운로드 가능한 최대 행 개수 (예: 이 값이 "1000"인 경우 1000 건 이상은 다운로드 할 수 없음.)
				type:"1",
                 rowNumVisible : "true",
				
			},			{
				gridId :grd_gridView1.id,
				sheetName :"세번째",
				rowsByN : "10000", //[default: 100] 다운로드 가능한 최대 행 개수 (예: 이 값이 "1000"인 경우 1000 건 이상은 다운로드 할 수 없음.)
				type:"1",
                 rowNumVisible : "false",
				
			}
		]
		
		}
		WebSquare.util.multipleExcelDownload( options ); 
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="height:423px;">
    	<xf:trigger id="trigger1" style="width:161px;height:23px;" ev:onclick="scwin.trigger1_onclick" type="button">
    		<xf:label><![CDATA[1번그리드 엑셀다운로드]]></xf:label>
    	</xf:trigger>
    	<w2:gridView id="grd_gridView1" dataList="data:dataList1" style="width: 100%; height:200px;" visibleRowNum="" scrollByColumn="false"
    		defaultCellHeight="20" rowNumVisible="true" scrollByColumnAdaptive="false">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column7" removeBorderStyle="false" style="" inputType="text" width="70" value="name1"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70" value="name2"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" inputType="text" width="70" value="name3"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1" removeBorderStyle="false" style="" width="70" inputType="text" value="name4"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col4" removeBorderStyle="false" style="" width="70" inputType="text" value=""
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:footer style="" id="footer1">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="expression" style="height:20px" id="column11" value="" displayMode="label" expression="sum('col1')"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column10" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column9" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column8" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:footer>
    	</w2:gridView>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width:161px;height:23px;" type="button">
    		<xf:label><![CDATA[2번그리드 엑셀다운로드]]></xf:label>
    	</xf:trigger>
    	<w2:gridView id="grd_gridView2" dataList="data:dataList1" style="width: 100%; height:200px;" visibleRowNum="" scrollByColumn="false"
    		defaultCellHeight="20" rowNumVisible="true" scrollByColumnAdaptive="false">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column7" removeBorderStyle="false" style="" inputType="text" width="70" value="name1"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70" value="name2"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" inputType="text" width="70" value="name3"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1" removeBorderStyle="false" style="" width="70" inputType="text" value="name4"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col4" removeBorderStyle="false" style="" width="70" inputType="text" value=""
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:footer style="" id="footer1">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="height:20px" id="column11" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column10" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column9" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column8" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:footer>
    	</w2:gridView>

    	<xf:trigger type="button" id="trigger3" style="width:182px;height:23px;" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[멀티엑셀다운로드]]></xf:label>
    	</xf:trigger>
    </xf:group></body>
</html>
