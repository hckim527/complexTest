<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col4" name="name4"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col5" name="name5"
            				dataType="text">
            			</w2:column>
            			<w2:column id="ex001" name="name6"
            				dataType="text">
            			</w2:column>
            			<w2:column id="ex002" name="name7"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col8" name="name8"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.initFunc = function() {
    var jsonData = [{
        "col1": "1",
        "col2": "test",
        "col3": "10000",
        "col4": "11",
        "col5": "12"
    }];
    dataList1.setJSON(jsonData);
};
scwin.trigger1_onclick = function(e) {
    var options = {
        fileName: "sample.xlsx",
        type: "1"
    };
    gridView.advancedExcelDownload(options);
};
scwin.onpageload = function() {
    if (typeof scwin.onpageload === "function") {
        //scwin.onpageload();
    }
    scwin.initFunc();
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false"
    		scrollByColumnAdaptive="false" id="gridView"
    		style="position: absolute ;left: 4px;top: 9px;width:489px;height:278px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		fixedColumnWithHidden="true" useShiftKey="true"
    		tooltipDisplay="true" tooltipShowAlways="false"
    		tooltipFormatter="tooltipFunc"
    		ev:onheaderclick="scwin.gridView_onheaderclick" readOnly="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="h_chk"
    					style="height:20px;" inputType="checkbox"
    					width="70" displayMode="label" value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column13"
    					style="height:20px;" inputType="text" width="120"
    					displayMode="label" value="name2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column11"
    					style="height:20px;" inputType="text" width="70"
    					displayMode="label" value="name3">
    				</w2:column>
    				<w2:column blockSelect="false" id="column9"
    					style="height:20px;" inputType="text" width="70"
    					displayMode="label" value="name4">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1"
    					style="height:20px;;" inputType="checkbox" width="70"
    					displayMode="label" colSpan="" rowSpan="2">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2"
    					style="height:20px;;" inputType="text" width="120"
    					displayMode="label" dataType="number"
    					displayFormat="" value="" imageSrc="">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3"
    					preventCopy="true" style="height:20px;;" inputType="text"
    					width="70" displayMode="label" colSpan="" rowSpan="2">
    				</w2:column>
    				<w2:column blockSelect="false" id="col4"
    					style="height:20px;;" inputType="text" width="70"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    			<w2:row id="row3" style="">
