    					style="height:20px" width="120" inputType="text"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col8"
    					style="height:20px" width="70" inputType="text"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1"
    		style="position: absolute ;left:499px;top:91px;width: 77px;height: 29px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[download]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 