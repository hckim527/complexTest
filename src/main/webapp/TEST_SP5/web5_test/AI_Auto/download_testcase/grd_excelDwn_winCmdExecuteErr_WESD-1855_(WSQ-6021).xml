<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[1]]></col2>
            				<col3><![CDATA[1]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[2]]></col1>
            				<col2><![CDATA[2]]></col2>
            				<col3><![CDATA[2]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[3]]></col2>
            				<col3><![CDATA[3]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger1_onclick = function(e) {
		
		
		var options = {};
		options.bodyColor = "#FFFFFF";
		options.bodyFontColor = "#FFFF00";
		options.fileName = "excel.xlsx";
		options.sheetName = "sheet";
		options.type = "0";
		options.headerColor = "#0000FF";
		options.headerFontColor = "#FFFFFF"
		options.headerFontBold = "true";
	    options.fileName = '테스트 목록.xlsx';
	    options.startRowIndex = "4";
	    //options.lazyInfoArr = true;
	    
		
		var infoArr = [
			{"rowIndex" : 0 , "colIndex" : 0 , "colSpan" : 3 , "rowSpan" : "1", "text" : "테스트엑셀", borderColor : "#d6d6d6", bgColor : "#FFFFFF"},
			{"rowIndex" : 2 , "colIndex" : 0 , "colSpan" : 1 , "rowSpan" : "1", "text" : tbx_box1.getValue(), bgColor : "#d6d6d6"},
			{"rowIndex" : 2 , "colIndex" : 1 , "colSpan" : 1 , "rowSpan" : "1", "text" : input1.getValue(), bgColor : "#FFFFFF"}
		]
		
		
		gridView1.advancedExcelDownload(options, infoArr);
		
	};
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="">
    		<w2:textbox style="width: 150px;height: 23px;float: left;" id="tbx_box1" label="이름"></w2:textbox>
    		<xf:input adjustMaxLength="false" style="width: 144px;height: 21px;float: left;" id="input1"></xf:input>
    		<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;margin-left: 10px" ev:onclick="scwin.trigger1_onclick">
    			<xf:label><![CDATA[엑셀다운로드]]></xf:label>
    		</xf:trigger>
    	</xf:group>
    	<w2:gridView checkAllType="false" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1"
    		style="width: 500px;height: 150px;padding-top: 10px" dataList="data:dataList1">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column width="70" inputType="text" style="height:20px" id="column9" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column8" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column7" value="name3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column width="70" inputType="text" style="height:20px" id="col1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col2" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
