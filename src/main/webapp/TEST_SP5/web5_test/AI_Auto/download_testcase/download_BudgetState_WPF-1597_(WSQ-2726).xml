		<script type="text/javascript" lazy="false"><![CDATA[
scwin.initScreen = function() {
    var sessionMap = WebSquare.session.getAttribute("userSession");
    var AREA_CD = sessionMap.mberRow.AREA_CD;
    // 초기 지역코드 셋팅
    dl_ARCODEList.setJSON(onandonLib.getARCODEList(AREA_CD));
    /* 유형, 운영여부 셋팅
     * 초기 로그인시 dlt_Code(TCM_CODE datalist로 전체를 담는다.) 셋팅 데이터를 가져와서
       link-datalist로 가져오는작업
       ex) onandon_common.js 의 onandonLib.setCodeObject 참조
           유형: IF1
           운영여부: Z70
           은행: Z80
    */
    var date = onandonLib.dateInfo(); // 이전 날짜
    if (date != null && date != "") {
        dl_YYYYList.setJSON(date.DateList);
        year = date.baseStartDate.substring(0, 4);
    }
    dm_search.set("YYYY", year);
    var codeOption1 = [{
            group: "IF1",
            object: [slt_FCLTY_TY]
        },
        {
            group: "Z70",
            object: [slt_STTUS]
        }
    ];
    onandonLib.setCodeObject(codeOption1);
    // 특성 보이기
    dm_search.set("SHOW_YN", "Y");
    scwin.grd_BudgetState_resize();
};
scwin.getBudgetStateList = function() {
    var option = {
        id: "sbm_getBudgetStateList",
        action: "imggadm/operate/getBudgetStateList.do",
        ref: "data:json, {'id':'dm_search', 'key':'search'}",
        mode: "asynchronous",
        isProcessMsg: true,
        processMsg: "처리중입니다. 잠시만 기다려 주십시요.",
        target: "data:json, {'id':'dl_budgetStateList', 'key':'budgetStateList'}",
        submitDoneHandler: "getBudgetStateListCallback"
    };
    ajaxLib.executeSubmission(option);
};
scwin.getBudgetStateListCallback = function(response) {
    var FRL_BUDGET_DIFF_IDX = grd_BudgetState.getColumnIndex("FRL_BUDGET_DIFF");
    var LAST_BUDGET_DIFF_IDX = grd_BudgetState.getColumnIndex("LAST_BUDGET_DIFF");
    for (var i = 0; i < response.budgetStateList.length; i++) {
        if (response.budgetStateList[i].FRL_BUDGET_DIFF < 0) grd_BudgetState.setCellColor(i, FRL_BUDGET_DIFF_IDX, "red");
        if (response.budgetStateList[i].LAST_BUDGET_DIFF < 0) grd_BudgetState.setCellColor(i, LAST_BUDGET_DIFF_IDX, "red");
    }
    scwin.fn_SetFilter();
};
scwin.SLT_SHOW_YN_onchange = function() {
    if (dm_search.get("SHOW_YN") == "Y") {
        grd_BudgetState.setColumnVisible("PUBLIC_TY_AT", true);
        grd_BudgetState.setColumnVisible("CTRD_TY_AT", true);
        grd_BudgetState.setColumnVisible("KID_PRVUSE_AT", true);
        for (var i = 1; i <= 9; i++) {
            if (i == 9) {
                grd_BudgetState.setColumnVisible("CHILD_HOUSE_CHARTR" + i, true);
            } else {
                grd_BudgetState.setColumnVisible("CHILD_HOUSE_CHARTR" + i, true);
                grd_BudgetState.setColumnVisible("CO" + i, true);
            }
        }
    } else {
        grd_BudgetState.setColumnVisible("PUBLIC_TY_AT", false);
        grd_BudgetState.setColumnVisible("CTRD_TY_AT", false);
        grd_BudgetState.setColumnVisible("KID_PRVUSE_AT", false);
        for (var i = 1; i <= 9; i++) {
            if (i == 9) {
                grd_BudgetState.setColumnVisible("CHILD_HOUSE_CHARTR" + i, false);
            } else {
                grd_BudgetState.setColumnVisible("CHILD_HOUSE_CHARTR" + i, false);
                grd_BudgetState.setColumnVisible("CO" + i, false);
            }
        }
    }
};
scwin.fn_SetFilter = function() {
    dl_budgetStateList.removeColumnFilterAll();
    var id = "";
    var value;
    // 특성
    for (var i = 1; i <= 12; i++) {
        if (i == 1) id = "PUBLIC_TY_AT";
        else if (i == 2) id = "CTRD_TY_AT";
        else if (i == 3) id = "KID_PRVUSE_AT";
        else id = "CHILD_HOUSE_CHARTR" + (i - 3);
        value = eval("slt_PROPERTY_GB" + i).getValue();
        if (value == "Y") dl_budgetStateList.setColumnFilter(id, "Y", "and", true);
    }
    //조회대상
    var param = slt_DATAYN.getValue();
    dl_budgetStateList.setColumnFilter({
        type: 'func',
        colIndex: 'FRL_BUDGET_REV',
        key: fn_filter,
        condition: 'and',
        param: param
    });
}
scwin.fn_filter = function(cellData, tmpParam, rowIdx) {
    var FRL_BUDGET_EXP = dl_budgetStateList.getCellData(rowIdx, "FRL_BUDGET_EXP");
    if (tmpParam == "O") {
        if (cellData == "" && FRL_BUDGET_EXP == "") {
            return false;
        }
    } else if (tmpParam == "X") {
        if (cellData == "" && FRL_BUDGET_EXP == "") {
            return true;
        } else {
            return false;
        }
    }
    return true;
};
scwin.btn_search_onclick = function(e) {
    scwin.getBudgetStateList();
};
scwin.SCH_TXT_onkeyup = function(e) {
    if (e.keyCode == 13) {
        dm_search.set("TXT_SEARCH", txtSearch.getValue());
        scwin.getBudgetStateList();
    }
};
scwin.setAreaTitle = function(data, formattedData, row, col) {
    var fcltcd = parseInt(data);
    formattedData = dl_budgetStateList.getMatchedColumnData("FCLTCD", fcltcd, "AREA_NM", true);
    formattedData = formattedData + "계";
    return formattedData;
};
scwin.setFcltTyTitle = function(data, formattedData, row, col) {
    var fcltcd = parseInt(data);
    formattedData = dl_budgetStateList.getMatchedColumnData("FCLTCD", fcltcd, "FCLTY_TY_NM", true);
    formattedData = formattedData + "계";
    return formattedData;
};
scwin.btn_excel_onclick = function() {
    var sToday = WebSquare.date.getFormattedDate(new Date(), "yyyyMMdd");
    var options = {};
    options.fileName = "BudgetState" + sToday + ".xls";
    options.type = "1";
    options.removeColumns = "";
    options.startRowIndex = 0;
    options.startColumnIndex = 0;
    options.headerColor = "#DBEEF3";
    options.footerColor = "#92CDDC";
    options.showProcess = true;
    options.useSubTotal = true;
    options.useSubTotalData = true;
    grd_BudgetState.advancedExcelDownload(options);
};
scwin.grd_BudgetState_oncelldblclick = function(row, col) {
    var FCLTCD = dl_budgetStateList.getCellData(row, "FCLTCD");
    var options = {
        title: "어린이집정보",
        modal: true,
        width: 1200,
        height: 800
    };
    comLib.openPopup("popup_facilityInfo", "ui/imggadm/facilityinfo/popup_facilityInfoLayout.xml&FCLTCD=" + FCLTCD + "&P1=0&P2=0", options);
};
scwin.grd_BudgetState_resize = function() {
    var winHeight = WebSquare.wUnit.getJq(window).height();
    grd_BudgetState.setGridHeight(winHeight - 220);
};
scwin.callback = function() {
    dl_budgetStateList.setColumnFilter({
        type: 'func',
        colIndex: 'FRL_BUDGET_REV',
        key: fn_filter,
        condition: 'and',
        param: "O"
    });
}
scwin.group111_onclick = function(e) {
    scwin.btn_excel_onclick();
};
scwin.onpageload = function() {
    if (typeof scwin.onpageload === "function") {
        //scwin.onpageload();
    }
    /*** 특성 보이기/숨기기
     */
    //특성체크 조회 조건에 맞게 필터링 한다.
    // subTotal displayformatter 합계 지역설정
    // subTotal displayformatter 합계 유형설정
    WebSquare.wUnit.getJq(window).resize(function() {
        if (scwin.grd_BudgetState_resize) scwin.grd_BudgetState_resize();
    });
    //scwin.initScreen();
    $p.executeSubmission("submission1");
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
