<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true" customFormatter="scwin.doMap">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="number"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="date"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var json = [{
            "col1": "1234567",
            "col2": "col2",
            "col3": "20210520"
        },
        {
            "col1": "7654321",
            "col2": "col2",
            "col3": "20210520"
        },
        {
            "col1": "3425167",
            "col2": "col2",
            "col3": "20210520"
        }
    ];
    dataList1.setJSON(json);
    grd.setCellDisabled(0, 0, true)
};
scwin.doMap = function(obj, jsonData) {}
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    grd.advancedExcelDownload({
        fileName: "TEST.xlsx",
        useDataFormat: true
    });
};
scwin.trigger2_onclick = function(e) {
    grd.setFooterDisplayFormat("column8", "#,###");
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView id="grd" style="width: 500px;height: 150px;border: 1px solid black;" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" dataList="data:dataList1" tooltipDisplay="true">
    		<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header2">
    			<w2:row style="" id="row3">
    				<w2:column removeBorderStyle="false" width="125" inputType="text" style="height:20px" id="column5" value="name1"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="141" inputType="text" style="height:20px" id="column4" value="name2"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="182" inputType="text" style="height:20px" id="column3" value="name3"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody2">
    			<w2:row style="" id="row4">
    				<w2:column removeBorderStyle="false" width="125" inputType="text" style="height:20px" id="col1" value=""
    					blockSelect="false" displayMode="label" dataType="number">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="141" inputType="text" style="height:20px" id="col2" value=""
    					blockSelect="false" displayMode="label" dataType="text" disabled="true">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="182" inputType="text" style="height:20px" id="col3" value=""
    					blockSelect="false" displayMode="label" dataType="date" displayFormat="yyyy-MM-dd">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:footer style="" id="footer1">
    			<w2:row style="" id="row5">
    				<w2:column removeBorderStyle="false" width="125" inputType="expression" style="height:20px" id="column8" value=""
    					blockSelect="false" displayMode="label" expression='SUM("col1")'>
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="141" inputType="text" style="height:20px" id="column7" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="182" inputType="text" style="height:20px" id="column6" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:footer>
    	</w2:gridView>
    	<xf:trigger type="button" style="width:158px;height:38px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[엑셀 다운로드]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width:158px;height:38px;" type="button">
    		<xf:label><![CDATA[setFooterDisplayFormat]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 