scwin.btnExcelDownload_onclick = function(e) {
    var sToday = WebSquare.date.getFormattedDate(new Date(), "yyyyMMddHHmmss");
    var options = {
        //fileName: "testExcel_" + sToday + ".xlsx",
        //sheetName: "testExcel_" + sToday + ".xlsx",
		fileName: "testExcel_.xlsx",
		sheetName: "testExcel_.xlsx",
        type: "1",
        removeColumns: "",
        startRowIndex: 2,
        startColumnIndex: 0,
        showProcess: true,
        useStyle: "true",
        autoSizeColumn: "true",
        useDataFormat: "true"
    };
    var infoArr = [];
    var infoObj = {
        rowIndex: 0,
        colIndex: 0,
        rowSpan: 1,
        colSpan: gridResultView.getTotalCol(),
        text: "textExcel        [!~confidential~!]",
        textAlign: "center",
        bgColor: "yellow"
    };
    infoArr.push(infoObj);
    gridResultView.advancedExcelDownload(options, infoArr);
};
