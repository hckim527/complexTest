        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var totRow = 200;
    var totCol = grid1.getTotalCol();
    var arr = [];
    for (var i = 0; i < totRow; i++) {
        for (var j = 0; j < totCol; j++) {
            arr.push("index_" + i + "_" + j);
        }
    }
    grid1.setData(arr);
    grid2.setData(arr);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    grid1.advancedExcelDownload({
        fileName: 'test.xlsx',
        rowHeight: "24px",
        type: 1,
        useFooter: "false",
        useStyle: "true"
    });
};
scwin.trigger2_onclick = function(e) {
    grid2.advancedExcelDownload({
        fileName: 'test.xlsx',
        rowHeight: "24px",
        type: 1,
        useFooter: "false",
        useStyle: "true"
    });
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
