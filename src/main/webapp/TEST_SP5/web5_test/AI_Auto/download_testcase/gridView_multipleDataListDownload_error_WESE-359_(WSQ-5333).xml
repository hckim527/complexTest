<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dlt1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[a]]></col1>
            				<col2><![CDATA[1]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[b]]></col1>
            				<col2><![CDATA[2]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dlt2" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[c]]></col1>
            				<col2><![CDATA[3]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[d]]></col1>
            				<col2><![CDATA[4]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	  
};

// useXHR 미사용 - 정상 동작 
scwin.btnMultiDataList_onclick = function(e) {
    var options = {
        common: {
            fileName : "multipleDataList1111.xlsx",
            showProcess : true,
            multipleSheet : true
        },
        excelInfo: [
            {
                dataListId : "dlt1",
                sheetName : "첫번째 sheet",
                startRowIndex : 3,
                startColumnIndex : 0
            },
            {
                dataListId : "dlt2",
                sheetName : "두번째 sheet",
                startRowIndex : 3,
                startColumnIndex : 0
            }
        ]
    };
    WebSquare.util.multipleDataListDownload(options);

};

// useXHR 사용 - 에러는 표시되지 않고 파일다운로드가 되지 않음 
scwin.btnMultiDataListUseXHR_onclick = function(e) {
    var options = {
        common: {
            fileName : "multipleDataList2222.xlsx",
            useXHR : true,  // useXHR 을 사용하면 파일이 다운로드 되지 않습니다. 
            showProcess : true,
            multipleSheet : true
        },
        excelInfo: [
            {
                dataListId : "dlt1",
                sheetName : "첫번째 sheet",
                startRowIndex : 3,
                startColumnIndex : 0
            },
            {
                dataListId : "dlt2",
                sheetName : "두번째 sheet",
                startRowIndex : 3,
                startColumnIndex : 0
            }
        ]
    };
    WebSquare.util.multipleDataListDownload(options);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    <xf:group id="" style="padding: 10px;"><xf:group tagname="table" style="width:100%;" id="" class="w2tb">
    		<w2:attributes>
    			<w2:summary></w2:summary>
    		</w2:attributes>
    		<xf:group tagname="caption"></xf:group>
    		<xf:group tagname="colgroup">
    			<xf:group tagname="col" style="width:50.00%"></xf:group>
    			<xf:group tagname="col" style="width:50.00%"></xf:group>
    		</xf:group>
    		<xf:group tagname="tr">
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<w2:attributes>
    					<w2:colspan>2</w2:colspan>
    					<w2:rowspan>1</w2:rowspan>
    				</w2:attributes>
    				<xf:trigger type="button" style="width:150px;height:23px;margin-right: 10px;" id="btnMultiDataList" ev:onclick="scwin.btnMultiDataList_onclick">
    					<xf:label><![CDATA[useXHR 미사용]]></xf:label>
    				</xf:trigger>
    				<xf:trigger id="btnMultiDataListUseXHR" style="width:150px;height:23px;margin-right: 10px;" type="button" ev:onclick="scwin.btnMultiDataListUseXHR_onclick">
    					<xf:label><![CDATA[useXHR 사용]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    		<xf:group tagname="tr">
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<w2:gridView checkAllType="false" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="grd1"
    					style="width: 500px;height: 150px;" dataList="data:dlt1">
    					<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    					<w2:header style="" id="header2">
    						<w2:row style="" id="row3">
    							<w2:column width="70" inputType="text" style="" id="column4" value="name1" displayMode="label"></w2:column>
    							<w2:column width="70" inputType="text" style="" id="column3" value="name2" displayMode="label"></w2:column>
    						</w2:row>
    					</w2:header>
    					<w2:gBody style="" id="gBody2">
    						<w2:row style="" id="row4">
    							<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    							<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    						</w2:row>
    					</w2:gBody>
    				</w2:gridView>
    			</xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<w2:gridView checkAllType="false" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="grd2"
    					style="width: 500px;height: 150px;" dataList="data:dlt2">
    					<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    					<w2:header style="" id="header2">
    						<w2:row style="" id="row3">
    							<w2:column width="70" inputType="text" style="" id="column4" value="name1" displayMode="label"></w2:column>
    							<w2:column width="70" inputType="text" style="" id="column3" value="name2" displayMode="label"></w2:column>
    						</w2:row>
    					</w2:header>
    					<w2:gBody style="" id="gBody2">
    						<w2:row style="" id="row4">
    							<w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
    							<w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
    						</w2:row>
    					</w2:gBody>
    				</w2:gridView>
    			</xf:group>
    		</xf:group>
    	</xf:group></xf:group></body>
</html>
