<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" style="" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col2_1" name="name2_1" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger2_onclick = function(e) {
    var options = {};
    options.delim = ';';
    options.fileName = "test.csv";
    gridView1.saveCSV(options);
};
scwin.trigger3_onclick = function(e) {
    var options = {};
    options.delim = ',';
    //options.startRowIndex = 0;
    gridView1.readCSV(options);
};
scwin.trigger4_onclick = function(e) {
    gridView1.setHeaderValue("column9", "test123");
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.jsonData = [{
        "col1": "한글1",
        "col2": 10,
        "col2_1": 11,
        "col3": "111"
    }, {
        "col1": "한글2",
        "col2": 11,
        "col2_1": 12,
        "col3": "222"
    }, {
        "col1": "한글3",
        "col2": 12,
        "col2_1": 13,
        "col3": "333"
    }];
    dataList1.setJSON(jsonData);
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1"
    		style="position: absolute ;left:66px;top:30px;width:289px;height:184px;" fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column9" style="height:20px;" inputType="text" width="70" value="이름1"></w2:column>
    				<w2:column blockSelect="false" id="column7" style="height:20px;" inputType="text" width="70" value="이름2"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="height:20px;" inputType="text" width="70" value="이름2_1"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px;" width="70" inputType="text" value="이름3"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody4" style="">
    			<w2:row id="row5" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col2_1" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" width="70" inputType="text"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width:150px;height:25px;"
    		type="button">
    		<xf:label><![CDATA[csv down]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" style="width:150px;height:25px;" id="trigger4" ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[setHeaderValue]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 