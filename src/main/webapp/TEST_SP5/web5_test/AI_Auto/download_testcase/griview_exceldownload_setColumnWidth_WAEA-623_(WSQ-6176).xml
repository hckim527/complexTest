    증상 : 헤더 merge가 있는 gridview의 첫번째 컬럼을 제외한 setColumnWidth로 
     컬럼 너비를 조정했을 때 엑셀 다운로드 시 미반영됨

    재현방법 : 
    1. gridview 헤더 행 병합
    2. 첫번째 컬럼 제외한 컬럼으로 setColumnWidth
    3. 엑셀 다운로드

    기대결과 : 브라우저의 gridview와 동일한 엑셀 다운로드
    실제결과 : 다름(setColumnWidth 반영안됨)

    엔진버전 : 6.0_0.1349B.20250905.104222_1.8
     */
    gridViewSample1.setColumnWidth(1, 500);
};


scwin.btnClick_onclick = function (e) {
    var userOpt = [{}];
    scwin.cf_ExportExcel("gridViewSample1", "sheet", "temp", userOpt);
};


//엑셀다운로드-엔진
scwin.cf_ExportExcel = async function (sGridList, sSheetNameList, sFileName, userOpt = []) {
    let [preFileName, preExt] = sFileName.split(".");
    let excelExt = preExt?.match(/^xls$/)?.[0] || "xlsx"; // 기본 엑셀 다운로드 확장자
    var options = {
        common: {
            openFile: true,
            fileName: preFileName + `.${excelExt}`,
            showProcess: true,
            multipleSheet: true,
        },
        excelInfo: []
    };

    var aGrid = sGridList.split(",");
    var aSheetName = sSheetNameList.split(",");

    for (var i = 0; i < aGrid.length; i++) {

        options.excelInfo.push({
            gridId: aGrid[i],
            sheetName: aSheetName[i],
            type: "1",
            startRowIndex: 0,
            startColumnIndex: 0,
            onSuccessCallback: function (url, info) {
            }
        });
        options.excelInfo[i] = { ...options.excelInfo[i], ...(userOpt[i] || {}) }
    }
    WebSquare.util.multipleExcelDownload(options);

};
scwin.trigger1_onclick = function(e) {
    gridViewSample1.setColumnWidth(1, 500);
};
