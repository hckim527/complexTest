<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col4" name="name4"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    var jsonData = [];
    for (var i = 0; i < 550; i++) {
        var rowData = {
            col2: i,
            col3: i + 'click'
        }
        jsonData.push(rowData);
    }
    dataList1.setJSON(jsonData);
};
scwin.gridView1_onrowindexchange = function(row, oldRow) {
    console.log('oldRow :: ' + oldRow);
};
scwin.gridView1_oncellclick = function(row, col) {
    console.log('oncell : ' + row + col);
};
scwin.trigger2_onclick = function(e) {
    var options = {
        fileName: "test.cell",
        //headerFontName: "휴먼아미체",
		headerFontName: "궁서체",
        footerFontName: "궁서체",
        useStyle: 'true'
    };
    gridView1.advancedExcelDownload(options);
};
scwin.onpageload = function() {
    scwin.init();
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList1" summaryAuto="false"
    		applyAllColumnStyle="false" scrollByColumn="false"
    		defaultCellHeight="20" scrollByColumnAdaptive="false"
    		id="gridView1" focusMove="false" keyMoveEventMode="true"
    		style="position: relative;width: 500px;height: 150px;"
    		ignoreCellClick="false" syncScroll="false"
    		ignoreToggleOnDisabled="false" summaryOnlyAuto="false"
    		useShiftKey="true" hammerEnabled="true"
    		ev:onrowindexchange="scwin.gridView1_onrowindexchange"
    		senseReader="false">
    		<w2:caption id="caption1" style=""
    			value="this is a grid caption.">
    		</w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column7" style="height:20px;background: red;"
    					inputType="text" width="70" value="이름"
    					displayMode="label" class="">
    				</w2:column>
    				<w2:column blockSelect="false" id="column5" style="height:20px;"
    					inputType="text" width="70" value="나이"
    					displayMode="label" class="header">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px;"
    					inputType="text" width="70" value="숫자"
    					displayMode="label" class="header">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1" style="height:20px;"
    					width="70" inputType="text" value="한글"
    					displayMode="label" class="header">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style=""
    					inputType="checkbox" width="70" value="" displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" style=""
    					inputType="text" width="70" value="" displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" style=""
    					inputType="link" width="70" value="" displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col4" style=""
    					width="70" inputType="text" value="" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:footer id="footer1" style="">
    			<w2:row id="row3" style="">
    				<w2:column blockSelect="false" id="column11"
    					style="height:20px;" width="70" inputType="text" value="풋터"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column10"
    					style="height:20px;" width="70" inputType="text" value="폰트"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column9" style="height:20px;"
    					width="70" inputType="text" value="확인" displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column8" style="height:20px;"
    					width="70" inputType="text" value="" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:footer>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger2"
    		style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[down]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 