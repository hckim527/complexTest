<?xml version="1.0" encoding="UTF-8"?>

<html xmlns="http://www.w3.org/1999/xhtml"

    xmlns:ev="http://www.w3.org/2001/xml-events"

    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">

    <head>

    	<w2:type>DEFAULT</w2:type>

        <w2:buildDate/>

        <xf:model>

            <xf:instance>

                <data xmlns=""/>

            </xf:instance>

            <w2:dataCollection baseNode="map">

            	<w2:dataList baseNode="list" id="dst_msgTp" repeatNode="map" style="">

            		<w2:columnInfo>

            			<w2:column dataType="text" id="dateTypeText1" name="name1"></w2:column>

            			<w2:column dataType="text" id="dateTypeText2" name="name2"></w2:column>

            			<w2:column dataType="text" id="dateTypeText3" name="name3"></w2:column>

            			<w2:column dataType="number" id="dateTypeNumber1" name="name4"></w2:column>

            			<w2:column dataType="number" id="dateTypeNumber2" name="name5"></w2:column>

            			<w2:column dataType="number" id="dateTypeNumber3" name="name6"></w2:column>

            		</w2:columnInfo>

            		<w2:data use="true">

            			<w2:row>

            				<dateTypeText1><![CDATA[123456]]></dateTypeText1>

            				<dateTypeText2><![CDATA[123456]]></dateTypeText2>

            				<dateTypeText3><![CDATA[123456]]></dateTypeText3>

            				<dateTypeNumber1><![CDATA[123456]]></dateTypeNumber1>

            				<dateTypeNumber2><![CDATA[123456]]></dateTypeNumber2>

            				<dateTypeNumber3><![CDATA[123456]]></dateTypeNumber3>

            			</w2:row>

            		</w2:data>

            	</w2:dataList>

            </w2:dataCollection>

            <w2:workflowCollection>

            </w2:workflowCollection>

        </xf:model>

        <script type="text/javascript" lazy="false"><![CDATA[
scwin.form_onLoadCompleted = function() {
    var label = "name1~name3은 dataList의 datatype이 text name4~name5은 dataList의 datatype이 number,  dataList의 datatype이 number일경우 엑셀 다운로드시 grid에 displayformatter 적용안됨";
    textbox1.setValue(label);
};
scwin.trigger1_onclick = function(e) {
    var opt = {
        type: "1",
        useDataFormat: "true",
        fileName: "test.xlsx",
        applyDataFormat: "false"
    };
    grd_msg.advancedExcelDownload(opt);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>

    </head>

    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">

    	<xf:group id="group2" style="height:500px;">

    		<xf:group id="group1" style="position: relative;width: 100%;height: 500px;" class="">

    			<w2:gridView id="grd_msg" dataList="dst_msgTp" focusMode="row" rowNumHeaderValue="" autoFit="allColumn"

    				style="height:450px;" autoFitMinWidth="100" class="grid_01" editModeEvent="" ev:onscrollend="scwin.grd_msg_onscrollend"

    				fixedColumn="">

    				<w2:header>

    					<w2:row>

    						<w2:column id="temp_id_0" userData1="0" dataType="text" style="height:20px;" width="120" value="name1"></w2:column>

    						<w2:column id="temp_id_1" userData1="3" dataType="text" style="height:20px;" width="120" value="name2"></w2:column>

    						<w2:column id="temp_id_2" userData1="4" dataType="text" style="height:20px;" width="120" value="name3"></w2:column>

    						<w2:column id="temp_id_3" userData1="5" dataType="text" style="height:20px;" width="120" value="name4"></w2:column>

    						<w2:column id="temp_id_4" userData1="6" dataType="text" style="height:20px;" width="120" value="name5"></w2:column>

    						<w2:column id="temp_id_5" userData1="7" dataType="text" style="height:20px;" width="120" value="name6"></w2:column>

    					</w2:row>

    				</w2:header>

    				<w2:gBody>

    					<w2:row>

    						<w2:column id="dateTypeText1" userData1="3" dataType="number" width="40" inputType="text"

    							displayFormat="#,###">

    						</w2:column>

    						<w2:column id="dateTypeText2" userData1="3" dataType="number" width="40" inputType="text"

    							displayFormat="#,###">

    						</w2:column>

    						<w2:column id="dateTypeText3" userData1="4" dataType="number" width="40" inputType="text"

    							displayFormat="#,###">

    						</w2:column>

    						<w2:column id="dateTypeNumber1" userData1="5" dataType="number" width="40" inputType="text"

    							displayFormat="#,###">

    						</w2:column>

    						<w2:column id="dateTypeNumber2" userData1="6" dataType="number" width="40" inputType="text"

    							displayFormat="#,###">

    						</w2:column>

    						<w2:column id="dateTypeNumber3" userData1="7" dataType="number" width="40" inputType="text"

    							displayFormat="#,###">

    						</w2:column>

    					</w2:row>

    				</w2:gBody>

    			</w2:gridView>

    		</xf:group>

    		<xf:group id="group3" style="height:23px;">

    			<xf:trigger id="trigger1" style="position: relative;width:96px;height:23px;" type="button"

    				ev:onclick="scwin.trigger1_onclick">

    				<xf:label><![CDATA[엑셀다운로드]]></xf:label>

    			</xf:trigger>




    		</xf:group>

    		<xf:group id="group4" style="height:104px;"><w2:textbox label="" id="textbox1" style="position: relative;width: 100%;height: 23px;size:20px;"></w2:textbox></xf:group>

    	</xf:group>

    	

    </body>

</html> 