<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection>
    			<w2:dataList id="dataList1" baseNode="list" style="" repeatNode="map">
    				<w2:columnInfo>
    					<w2:column id="col1" name="number" dataType="number"></w2:column>
    					<w2:column id="col2" name="bigDecimal" dataType="bigDecimal"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
        "col1": 0.4,
        "col2": 64.5
    }, {
        "col1": 1111,
        "col2": 35.5
    }];
    dataList1.setJSON(jsonData);
}
scwin.onpageunload = function() {}
scwin.trigger1_onclick = function(e) {
    var options = {};
    options.fileName = "numberTest3.xls";
    options.type = "0";
    //options.useDataFormat = true;
    gridView1.advancedExcelDownload(options);
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    fn01 = function(val, format_val, row, col) {
        debugger;
        if (val == 64.5 || val == "64.5") {
            return Number(val) * 100;
        } else {
            return val;
        }
    };
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1" contextMenu="true"
    		columnMove="true"
    		style="position: absolute ;left:26px;top:103px;width:600px;height:229px;" fixedColumnWithHidden="true" useShiftKey="false"
    		enterKeyMove="" editModeEvent="onclick" adaptiveThreshold="" adaptive="" rowStatusVisible="true" focusFlow="linear"
    		rowNumVisible="true" rowNumBackgroundColor="" hideHeader="false">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="number" style="height:20px;" inputType="text" width="170"
    					value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="bigDecimal" style="height:49px;" inputType="text" width="210" value="name2">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
					<w2:column blockSelect="false" id="col1" style="" width="120" inputType="custom" value="" displayMode="label"
    					defaultValue="" applyFormat="all">
    				</w2:column>    				
    				<w2:column blockSelect="false" id="col2" style="height:20px" inputType="text" width="70" dataType="bigDecimal"
    					displayFormat="#,##0.00"  maxLength=""  imageSrc="" customFormatter="fn01" ><!--  excelFormat="#,##0.0" -->
    				</w2:column>
    				<!--1컬럼  displayFormat="#,##0"   -->
    				<!-- 2컬럼 displayFormat="#,##0"   -->
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="position: absolute ;left:58px;top:40px;width: 100px;height: 30px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[excel down]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 