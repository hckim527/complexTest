         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
			var options = {
			sortIndex: [0],
			closeGroup: false,
			hideHeader: false,
			hideFooter:true,
			groupbyHeader : [
								{ inputType: "expression", expression: 'depthStr()', align: "right" },
								{ inputType: "expression", expression: 'depthStr()', align: "right"},
								{ inputType: "expression", expression: 'depthStr()', align: "right"},
								{ inputType: "expression", expression: 'depthStr()', align: "right"},
			
							],
		};		
		gridView1.groupby(options);	
		gridView2.groupby(options);	


	};
	
	scwin.onpageunload = function() {		
			
	};
	
	
scwin.btn_trigger1_onclick = function(e) {
	gridView1.advancedExcelDownload({type:1,groupby:true,fileName:"test1.xlsx"})

};

scwin.btn_trigger2_onclick = function(e) {
	
	var options = {
    common: {
        fileName : "test2.xlsx",
        multipleSheet : false,
    },
    excelInfo: [
		{
            gridId : gridView1.id,
            type : "1",
            removeColumns : "0,1",
			startRowIndex:3,
            groupby:true, 
        },
        {
            gridId : gridView2.id,
            type : "1",
			startRowIndex:3,
            removeColumns : "0,1",
            groupby:true, 
        }
    ]
};
WebSquare.util.multipleExcelDownload( options );
};
]]></script>
