         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    requires("uiplugin.popup");
    var data = [];
    for (var i = 0; i < 20 * 40; i++) {
        data.push(i);
    }
    dataList1.setData(data);
    dataList_select.setData(["browserPopup", "browserPopup", "iframePopup", "iframePopup", "wframePopup", "wframePopup"]);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    var type = selectbox1.getValue();
    var options = {
        id: "111",
        popupName: "",
        type: type, // iframePopup, wframePopup, browserPopup
        width: "520px",
        height: "300px",
        top: "340px",
        left: "200px",
        popupName: '',
        xml: JSON.stringify(dataList1.getAllJSON()),
        closeAction: type === "iframePopup" ? scwin.popup_closeAction : undefined
    };
    scwin.$w.openPopup("popup_xml_fuction_WEFF-513_(WSQ-3889)_sub.xml", options);
};
scwin.trigger2_onclick = function(e) {
    var str = JSON.stringify(WebSquare.uiplugin.popup.popupParams);
    textarea1.setValue(str);
};
scwin.popup_closeAction = function() {
    return true;
};
scwin.checkVal = function() {
    return JSON.stringify(WebSquare.uiplugin.popup.popupParams) == '{}';
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플실행 후 "openPopup"버튼을 클릭한다.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 2. 샘플실행 후 'check popupParams'버튼을 클릭한다.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 3. 팝업을 닫는다.
    WebSquare.wUnit.addCommand("set", "scwin.$w.closePopup('111')");
    WebSquare.wUnit.addCommand("pause", "5000");
    //Test step 4. 샘플실행 후 'check popupParams'버튼을 클릭한다.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 5. 파라미터 정보가 제거되었는지 확인한다.
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
