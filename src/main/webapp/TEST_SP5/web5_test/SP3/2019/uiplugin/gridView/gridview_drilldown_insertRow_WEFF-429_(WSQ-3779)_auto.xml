<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
		    <xf:instance>
		        <data xmlns="" />
		    </xf:instance>
		    <w2:dataCollection baseNode="map">
		        <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
		            <w2:columnInfo>
		                <w2:column id="nameDis" name="name1" dataType="text"></w2:column>
		                <w2:column id="levelCnt" name="name2" dataType="text"></w2:column>
		                <w2:column id="menuId" name="name3" dataType="text"></w2:column>
		                <w2:column id="ro" name="name4" dataType="text"></w2:column>
		                <w2:column id="proName" name="name5" dataType="text"></w2:column>
		            </w2:columnInfo>
		        </w2:dataList>
		    </w2:dataCollection>
		    <w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
        "nameDis": "AAA",
        "levelCnt": "1",
        "menuId": "10001",
        "ro": "",
        "proName": "PRO1"
    }];
    dataList1.setJSON(jsonData);
};
scwin.trigger1_onclick = function(e) {
    var gri = gridView1.getRealRowIndex(0);
    console.log("gri: " + gri);
    dataList1.insertRow(gri);
    console.log(dataList1.getAllJSON());
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('gridView1_cell_1_4').innerText == 'PRO1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

]]></script>
		<style type="text/css"><![CDATA[
			 ]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
	    <xf:trigger type="button" id="trigger1" style="position: relative;width:157px;height:63px;" ev:onclick="scwin.trigger1_onclick">
	        <xf:label><![CDATA[dataList insertRow]]></xf:label>
	    </xf:trigger>
	    <w2:gridView autoFit="" class="cm_grid" fixedColumnWithHidden="true" id="gridView1" rowNumHeaderValue="순번" rowNumVisible="true"
	        rowNumWidth="40" scrollByColumn="false" style="position: relative;width:100%;height:337px;" useShiftKey="true" dataList="dataList1"
	        tooltipDisplay="true" contextMenu="true" fixedColumn="2" keyMoveEditMode="true">
	        <w2:header id="header1" style="">
	            <w2:row id="row2" style="">
	                <w2:column blockSelect="false" id="column21" inputType="text" style="height:25px;" value="레벨" width="50"
	                    fixColumnWidth="">
	                </w2:column>
	                <w2:column blockSelect="false" id="column19" inputType="text" style="height:25px;" value="메뉴ID" width="100"
	                    fixColumnWidth="true">
	                </w2:column>
	                <w2:column blockSelect="false" id="column23" style="height:25px;" inputType="text" width="70" displayMode="label"
	                    value="RO" fixColumnWidth="">
	                </w2:column>
	                <w2:column blockSelect="false" id="column17" inputType="text" style="height:25px;" value="메뉴명" width="200"></w2:column>
	                <w2:column blockSelect="false" id="column15" inputType="text" style="height:25px;" value="프로그램명" width="200">
	                </w2:column>
	            </w2:row>
	        </w2:header>
	        <w2:gBody id="gBody4" style="">
	            <w2:row id="row5" style="">
	                <w2:column blockSelect="false" id="levelCnt" inputType="text" style="height:25px;" value="" width="50"
	                    fixColumnWidth="true">
	                </w2:column>
	                <w2:column blockSelect="false" id="menuId" inputType="text" style="height:25px;" value="" width="100"></w2:column>
	                <w2:column blockSelect="false" id="ro" style="height:25px" inputType="text" width="70" displayMode="label"
	                    customFormatter="scwin.customFormatter">
	                </w2:column>
	                <w2:column blockSelect="false" id="nameDis" inputType="drilldown" style="height:25px;" width="200"
	                    depthColumn="levelCnt" showDepth="4" displayFormat="" depthType="div" displayMode="label" textAlign="left"
	                    class="drill_sell" customFormatter="">
	                </w2:column>
	                <w2:column blockSelect="false" id="proName" inputType="text" style="height:25px;" value="" width="200"></w2:column>
	            </w2:row>
	        </w2:gBody>
	    </w2:gridView>
	</body>
</html>
 