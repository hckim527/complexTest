                <script type="text/javascript" lazy="false"><![CDATA[
scwin.fn_displayFormatter = function(value) {
    debugger;
    if (value.trim() == "") {
        console.log("1234")
        return "ALL";
    } else {
        return "11111";
    }
};
scwin.test = function(data) {
    return "model_" + data;
};
scwin.trigger1_onclick = function(e) {
    dlResult.insertRow();
};
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('gvList_cell_0_2').innerText == '11111'", "true");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
scwin.onpageload = function() {
}
]]></script>
