scwin.selectCustom = function(itemArr) {
    debugger;
    var customArr = itemArr;
    for (var i = 0; i < itemArr.length; i++) {
        customArr[i].label = itemArr[i].label + " 라벨";
    }
    console.log("scwin.selectCusom: ", customArr);
    return customArr;
};
scwin.selectCustomLabel = function(label, value, isOpen) {
    console.log("scwin.selectCusomLabel: ", label, value);
    if (isOpen) {
        return label + " : " + value;
    } else {
        return label;
    }
};
