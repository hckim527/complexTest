<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <col1><![CDATA[a]]></col1>
                            <col2><![CDATA[1]]></col2>
                        </w2:row>
                        <w2:row>
                            <col1><![CDATA[b]]></col1>
                            <col2><![CDATA[2]]></col2>
                        </w2:row>
                        <w2:row>
                            <col1><![CDATA[c]]></col1>
                            <col2><![CDATA[3]]></col2>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
                <w2:dataMap baseNode="map" id="dataMap1">
                    <w2:keyInfo>
                        <w2:key id="checkbox1" name="name1" dataType="text"></w2:key>
                        <w2:key id="checkbox2" name="name1" dataType="text"></w2:key>
                        <w2:key id="radio1" name="name1" dataType="text"></w2:key>
                        <w2:key id="radio2" name="name1" dataType="text"></w2:key>
                    </w2:keyInfo>
                    <w2:data use="false">
                        <key1><![CDATA[-1]]></key1>
                    </w2:data>
                </w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    
};

scwin.trigger1_onclick = function() {
    radio2.setSelectedIndex(-1);
}

	scwin.checkVal1 = function() {
		const checkStr = WebSquare.logger.getLog()
		return checkStr.indexOf('Cannot read properties of undefined') == -1;
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()","true");
		WebSquare.wUnit.addCommand("pause", "500");	

				
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">        
        <xf:group>
            <xf:select1 id="radio2" selectedIndex="-1" appearance="full" style="position:relative;width: 150px;height: 70px;" cols="1" rows="" ref="data:dataMap1.radio2"
                renderType="radiogroup" title="rdtitle" useRadioTitle="true">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList1">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
        </xf:group>
        <xf:trigger type="button" style="width: 180px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[radio2.setSelectedIndex(-1);]]></xf:label>
        </xf:trigger>
    </body>
</html>