        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

	scwin.isWithinThreePercent = function(a, b) {	
		if (a === 0 && b === 0) return true;
		var maxVal = Math.max(Math.abs(a), Math.abs(b));
		return Math.abs(a - b) / maxVal <= 0.03;
	}
	scwin.checkVal = function() {
		const column_left = WebSquare.wUnit.getDomById('wq_uuid_3_column1').getBoundingClientRect().left
		const itemTable_left = WebSquare.wUnit.getDomById('wq_uuid_3_customFilter_scrollView').getBoundingClientRect().left
		return !scwin.isWithinThreePercent(column_left, itemTable_left);
	}	
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "1000");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_3_column1_filter').click()");
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");	
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()		
	
]]></script>
