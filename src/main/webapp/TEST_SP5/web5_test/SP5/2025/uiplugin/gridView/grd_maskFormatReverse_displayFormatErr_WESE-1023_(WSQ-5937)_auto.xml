        <script lazy="false" type="text/javascript"><![CDATA[WebSquare.uiplugin.input.prototype.maskFormatModelFormat = function(value) {
    try {
        if (!value) {
            return value;
        }
        var result = '';
        var value2 = value;
        value = value.toString();
        if (this._getMaskFormat()) {
            if (this.options.maskFormatModelExcludeChar) {
                var excludeList = this.options.maskFormatModelExcludeChar.split('');
                for (var i = 0; i < value.length; i++) {
                    var inExcludeList = false;
                    for (var j = 0; j < excludeList.length; j++) {
                        if (value[i] == excludeList[j]) {
                            inExcludeList = true;
                            break;
                        }
                    }
                    if (!inExcludeList) {
                        result += value[i];
                    }
                }
            } else {
                result = value;
            }
        } else {
            result = value;
        }
        if (typeof value2 === "number" && !isNaN(result)) {
            result = Number(result)
        }
        return result;
    } catch (e) {
        WebSquare.exception.printStackTrace(e, null, this);
    }
};

