        <xf:group pluginName="udc_gdInfo" class="componentBox">
            <script ev:event="oncreated(options)" type="text/javascript"><![CDATA[
                //debugger;
                udc_obj.clear = function(){
                    ibx_label.setValue('');
                };

                udc_obj.focus = function () {
                    ibx_value.focus();
                };
                
                udc_obj.validate = function () {
                    return ibx_value.validate();
                };

                udc_obj.$_getValidationControl = function () {
                    return ibx_value;
                };
                
                udc_obj.getValue = function () {
                    return ibx_value.getValue().toUpperCase();
                };

                udc_obj.setValue = function (value) {
                    ibx_value.setValue(value);
                    
                    if (value) {
                        app.ajaxUdcCdnm({
                            action: '/wares/popup/selectSEWR8817P1.do',
                            requestData : {
                                sewr8817p1VO : {
                                    wrsDsc: value.toUpperCase(),
                                }
                            },
                            name: 'sewr8817p1.wrsDsnm',
                            target: ibx_label,
                        }).then(function(data) {
                            udc_obj.trigger('onfind', [data]);
                        });
                    }
                };

                udc_obj.getLabel = function () {
                    return ibx_label.getValue();
                };

                udc_obj.setLabel = function (value) {
                    ibx_label.setValue(value);
                };
                
                udc_obj.setMandatory = function (mandatory) {
                    options.mandatory = $W.util.getBoolean(mandatory);
                    ibx_value.setMandatory(options.mandatory);
                };
                
                udc_obj.setDisabled = function(disabled){
                    options.disabled = $W.util.getBoolean(disabled);
                    ibx_value.setDisabled(options.disabled);
                    btn_click.setDisabled(options.disabled);
                };
                
                udc_obj.setGdTypeLcls = function(value){
                    ibx_gdTypeLcls.setValue(value);
                };
                
                udc_obj.getGdTypeLcls = function(){
                    return ibx_gdTypeLcls.getValue();
                };

                udc_obj.setMandatory(options.mandatory);
                udc_obj.setDisabled(options.disabled);

                if (options.width1) {
                    ibx_value.setStyle('width', options.width1);
                }

                if (options.width2) {
                    ibx_label.setStyle('width', options.width2);
                }

                if (options.gdTypeLcls) {
                    ibx_gdTypeLcls.setValue(options.gdTypeLcls);
                }
                
                if (options.nextTabID) {
                    
                    ibx_value.setNextTabID(options.nextTabID, this.scope.$p.getFrameId());
                }
                
				]]></script>
            <xf:input id="ibx_value" class="fl" style="width: 80px;text-transform:uppercase;" validateOnInput="true">
                <script ev:event="onchange(info)" type="text/javascript"><![CDATA[
                    if (!info.newValue) {
                        udc_obj.clear();
                    }
                ]]></script>
                <script ev:event="onkeydown(e)" type="text/javascript"><![CDATA[
                    udc_obj.__OLD_VALUE__ = ibx_value.getValue().trim().toUpperCase();
                    ibx_value.setValue(ibx_value.getValue().trim().toUpperCase());
                ]]></script>
                <script ev:event="onkeyup(e)" type="text/javascript"><![CDATA[
                    //console.log("1111");
                    //debugger;
                    var value = ibx_value.getValue().trim().toUpperCase();
                    if (value !== udc_obj.__OLD_VALUE__) {
                        udc_obj.clear();
                    }
                    console.log(e.key);
                    console.log(!value);
                    if(e.key !== 'Enter' || !value) {
                        return;
                    }
                    
                     app.ajaxJSON({
                        action: '/wares/popup/selectSEWR8817P1List.do',
                        progress: false,
                        requestData: {
                            sewr8817p1VO: {
                                gdTypeLcls : ibx_gdTypeLcls.getValue(),
                                keyword    : value,
                            }
                        },
                        success: function(res) {
                            var dataList = res.sewr8817p1List;
                            if (dataList.length === 0) {
                                // 데이터 없음
                                ibx_label.setValue(app.getLocale('AltNoData'));
                                return;
                            }
                            if (dataList.length !== 1) {
                                // 데이터가 다건이 검색됨
                                btn_click.click();
                                return;
                            }
                            
                            var data = dataList[0];
                            ibx_value.setValue(data.wrsDsc);
                            ibx_label.setValue(data.wrsDsnm);
                            
                            udc_obj.trigger('onfind', [data]);
                            udc_obj.trigger('onviewfind', [data]);
                        }
                    });
                ]]></script>
                
                
                <script ev:event="onblur()" type="text/javascript"><![CDATA[
                    var value = ibx_value.getValue().trim().toUpperCase();
                    if (value !== udc_obj.__OLD_VALUE__) {
                        udc_obj.clear();
                    }
                    if(!value) {
                        return;
                    }
                                       
                    app.ajaxJSON({
                        action: '/wares/popup/selectSEWR8817P1List.do',
                        progress: false,
                        requestData: {
                            sewr8817p1VO: {
                                gdTypeLcls : ibx_gdTypeLcls.getValue(),
                                keyword    : value,
                            }
                        },
                        success: function(res) {
                            var dataList = res.sewr8817p1List;
                            if (dataList.length === 0) {
                                // 데이터 없음
                                //ibx_label.setValue(app.getLocale('AltNoData'));
                                return;
                            }
                            if (dataList.length !== 1) {
                                // 데이터가 다건이 검색됨
                                //btn_click.click();
                                return;
                            }
                            
                            var data = dataList[0];
                            ibx_value.setValue(data.wrsDsc);
                            ibx_label.setValue(data.wrsDsnm);
                            
                            udc_obj.trigger('onfind', [data]);
                            udc_obj.trigger('onviewfind', [data]);
                        }
                    });
                ]]></script>
            </xf:input>
            <w2:anchor id="btn_click" clickEventElement="outerDiv" class="btn_icon_search fl">
                <script ev:event="onclick(e)" type="text/javascript"><![CDATA[
                    app.openModal('/ui/wares/popup/SEWR8817P1.xml', {
                        width: 550,
                        height: 600,
                        dataObject: {
                            keyword: ibx_value.getValue(),
                            gdTypeLcls: ibx_gdTypeLcls.getValue(),
                        },
                        popupName: '상품구분검색',
                        callback: function(data) {
                            if (!data){
                                return;
                            }
                            
                            ibx_value.setValue(data.wrsDsc);
                            ibx_label.setValue(data.wrsDsnm);
        
                            udc_obj.trigger('onfind', [data]);
                            udc_obj.trigger('onviewfind', [data]);
                            
                            var grp_srh =$("#"+udc_obj.getID()).closest("#mf_grp_search");
                            if(grp_srh){
                              grp_srh.trigger("change");
                            }
                        }
                    });
                ]]></script>
            </w2:anchor>
            <xf:input id="ibx_label" class="fl ml5" style="width:122px;margin-left:10px;" disabled="true" />
            <xf:input class="fl" id="ibx_gdTypeLcls" style="width: 0px;display: none;" />
        </xf:group>
