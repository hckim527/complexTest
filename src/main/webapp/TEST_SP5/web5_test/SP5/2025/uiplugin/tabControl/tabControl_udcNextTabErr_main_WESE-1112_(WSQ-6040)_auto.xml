		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate1 = function() {
		scwin.simulateWrapper('#input1', 'key-combo', {
			combo: 'TAB'
		});
	}	
	scwin.setSimulate2 = function() {
		scwin.simulateWrapper('#udc_wrsDsc_ibx_value', 'key-combo', {
			combo: 'TAB'
		});
	}		
	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('udc_wrsDsc_ibx_value').classList.contains('w2input_focus');
	}	
	scwin.checkVal2 = function() {
		return WebSquare.wUnit.getDomById('input4').classList.contains('w2input_focus');
	}		
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('input1').focus()");
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		

		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('udc_wrsDsc_ibx_value').focus()");
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate2()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
	
]]></script>
