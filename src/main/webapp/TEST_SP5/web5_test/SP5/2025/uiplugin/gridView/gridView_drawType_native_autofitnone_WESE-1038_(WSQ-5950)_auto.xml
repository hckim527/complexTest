         <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {
	var data = [];
	for (var i = 0; i < 5; i++) {
		for (var j = 1; j < 10; j++) {
			data.push(i + "_" + j);
		}
		data.push(i);
	}
	dataList1.setData(data);
};

scwin.onpageunload = function () {

};

	scwin.setSimulate = function() {
		scwin.simulateWrapper('#wq_uuid_3_cell_0_3', 'key-combo', {
			combo: 'TAB'
		});
	}
	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}

	scwin.checkVal = function() {
		let leftoffset = WebSquare.wUnit.getDomById('wq_uuid_3_scrollX_right').scrollLeft;
		return leftoffset < 69 && leftoffset > 65;
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "1000");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_3_cell_0_3').click()");
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
		WebSquare.wUnit.addCommand('pause', '500');	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()		
	
	
]]></script>
