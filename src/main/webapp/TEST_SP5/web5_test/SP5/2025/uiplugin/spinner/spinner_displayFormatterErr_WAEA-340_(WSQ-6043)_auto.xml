<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};

    scwin.spinner1_displayFormatter = function(tmpVal) {debugger
        return tmpVal+ "원";
    }
    scwin.input1_displayFormatter = function(tmpVal) {debugger
        return tmpVal;
    }

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('spinner1___input').value == '10000원';
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
			
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <xf:input id="input1" style="width: 144px;height: 21px;"
            initValue="10000"
            displayFormatter="scwin.input1_displayFormatter" >
        </xf:input>

    	<!-- <w2:spinner initValue="10000" skin="type1" buttonSize="30" inputReadOnly="false" 
            id="spinner1" style="position: relative;width: 200px;margin: 100px;height: 40px;"
            displayFormat="#,###"
            increment="1"
            allowChar=""
            validateOnInput="true"
            editType="select">
        </w2:spinner> -->
    	<w2:spinner initValue="10000" skin="type1" buttonSize="30" inputReadOnly="false" 
            id="spinner1" style="position: relative;width: 200px;margin: 100px;height: 40px;"
            displayFormatter="scwin.spinner1_displayFormatter"
            increment="1"
            allowChar=""
            validateOnInput="true"
            editType="select">
        </w2:spinner>

    </body>
</html>
