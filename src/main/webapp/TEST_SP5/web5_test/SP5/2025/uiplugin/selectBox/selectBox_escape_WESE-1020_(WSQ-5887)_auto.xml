<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[<img src="#" onerror=alert(11)>]]></label>
            				<value><![CDATA[<img src="#" onerror=alert(22)>]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.input1_onkeypress = function(e) {
console.log(e);
};

scwin.select1_onclick = function(e) {

};

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('mf_select1_label').innerText != '';
	}	
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest();	


]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:select1 id="select1" chooseOption="" style="position:absolute; top:53px; left:49px; width:148px; height:21px; "
    		submenuSize="auto" allOption="" disabled="false" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref=""
    		escape="true">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="label"></xf:label>
    				<xf:value ref="value"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1>
    	<w2:autoComplete editType="select" id="autoComplete1" style="position:absolute; top:53px; left:257px; width:148px; height:21px; " submenuSize="auto"
    		search="start" escape="true" allOption="" chooseOption="" ref="">
    		<w2:choices>
    			<w2:itemset nodeset="data:dataList1">
    				<w2:label ref="label"></w2:label>
    				<w2:value ref="value"></w2:value>
    			</w2:itemset>
    		</w2:choices>
    	</w2:autoComplete>
    </body>
</html>
