                    </w2:column>
                    <w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="col5" value=""
                        blockSelect="false" displayMode="label" dataType="number">
                    </w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
        <xf:trigger ev:onclick="scwin.trigger1_onclick" style="width:143px;height:36px;" id="trigger1" type="button">
            <xf:label><![CDATA[button]]></xf:label>
        </xf:trigger>
