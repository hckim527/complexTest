<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="319">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
scwin.trigger1_onclick = function(e) {
	tabcontrol1.deleteAllTabs();
};

scwin.trigger2_onclick = function(e) {
    var tabInfo = tabcontrol1.getTabInfo();
	for (var i in tabInfo) {
        var tabId = tabInfo[i].id;
        if(tabId != "tabs2"){
            tabcontrol1.deleteTab(tabId); 
        }
    }
};

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('tabcontrol1_tabhost').children.length == 1;
	}		
	scwin.unitTest = function() {
		//noResult="previous"
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
		WebSquare.wUnit.addCommand("pause", "500");	

		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "400");

		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:tabControl useTabKeyOnly="true" id="tabcontrol1" useMoveNextTabFocus="false" useConfirmMessage="false" confirmTrueAction="exist"
    		confirmFalseAction="new" alwaysDraw="false" style="position: relative ;width: 500px;height: 200px;" closable="true" tabMove="true">
    		<w2:tabs disabled="false" style="width:70px;height:30px;" id="tabs1" label="tab1"></w2:tabs>
    		<w2:tabs disabled="false" style="width:70px;height:30px" id="tabs2" label="tab2"></w2:tabs>
    		<w2:tabs disabled="false" style="width:70px;height:30px" id="tabs3" label="tab3"></w2:tabs>
    		<w2:tabs disabled="false" style="width:70px;height:30px" id="tabs4" label="tab4"></w2:tabs>
    		<w2:tabs disabled="false" style="width:70px;height:30px" id="tabs5" label="tab5"></w2:tabs>
    		<w2:tabs disabled="false" style="width:70px;height:30px" id="tabs6" label="tab6"></w2:tabs>
    		<w2:content alwaysDraw="false" style="height:170px" id="content1"></w2:content>
    		<w2:content alwaysDraw="false" style="height:170px" id="content2"></w2:content>
    		<w2:content alwaysDraw="false" style="height:170px" id="content3"></w2:content>
    		<w2:content alwaysDraw="false" style="height:170px" id="content4"></w2:content>
    		<w2:content alwaysDraw="false" style="height:170px" id="content5"></w2:content>
    		<w2:content alwaysDraw="false" style="height:170px" id="content6"></w2:content>
    	</w2:tabControl>
    	<xf:trigger type="button" style="position:absolute;width:80px;height:23px;left:69px;top:219px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[전체탭닫기]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" style="position:absolute;width:185px;height:23px;left:259px;top:217px;" id="trigger2" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[tab2제외하고 전체탭닫기]]></xf:label>
    	</xf:trigger>
    </body>
</html>
