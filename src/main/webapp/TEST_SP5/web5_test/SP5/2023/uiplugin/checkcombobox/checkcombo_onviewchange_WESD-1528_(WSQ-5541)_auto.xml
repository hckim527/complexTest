		<script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate = function() {
		scwin.simulateWrapper('#ccb_checkcombobox1_itemTable_0_checkbox', 'key-combo', {
			combo: 'Enter'
		});
	}		
	scwin.ccb_checkcombobox1_onviewchange = function(info) {
		debugger;
		//alert("info.newInfo[0].label + info.newInfo[0].checked = " + info.newInfo[0].label + info.newInfo[0].checked );
		localStorage.setItem('log', info.newInfo[0].checked)	
	};
	
	scwin.checkVal = function() {
		return localStorage.getItem('log') == 'true';
	}		
	scwin.unitTest = function() {
		//noResult="previous"
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('ccb_checkcombobox1_button').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('ccb_checkcombobox1_itemTable_0_checkbox').click()");
		WebSquare.wUnit.addCommand("pause", "500");			
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
		WebSquare.wUnit.addCommand("pause", "500");	
		
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "400");

		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	localStorage.removeItem("log");
	
	]]></script>
