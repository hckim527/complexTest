         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		comboJSON = [
            {"label":"label1","value":"value1"}
            ,{"label":"label2","value":"value2"}
            ,{"label":"label3","value":"value3"}
            ,{"label":"label4","value":"value4"}
            ,{"label":"label5label5label5label5label5label5","value":"value5value5value5value5value5"}
        ];
        dl_combo.setJSON( comboJSON );
	};
	
	scwin.onpageunload = function() {
		
	};
		
	scwin.autoCompleteTooltip = function(rowIndex, colIndex, label){
		if(colIndex === 0) {
       		return label + "test";
       	} else {
       		return label;
       	}
	};

    scwin.autoCompleteGridViewItemSetTooltip = function(rowIndex, colIndex, label){
            return label + " " + rowIndex + " test";
    };

    scwin.autoCompleteItemTooltipFormatter = function(label, index, rowIndex, colIndex){
        if (colIndex > -1) {
            return label + " " + index + " test" + "_" + rowIndex + "_" + colIndex;
        } else {
            return label + " " + index + " test";
        }
    };
	
	scwin.fireOver = function(node) {
		if (document.createEventObject) {
			node.fireEvent('onmouseover');
		} else if (document.createEvent) {
			window.evt = document.createEvent('MouseEvents');
			evt.initEvent('mouseover', true, false);
			node.dispatchEvent(evt);
		} else if (typeof node.onmouseover == 'function') {
			node.onmouseover();
		}
	}
	scwin.mouseOverBehaviour = function(id) {
		window.el = WebSquare.wUnit.getDomById(id);
		scwin.fireOver(el);
	}	
	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('autoComplete1_tooltip').innerText == '어드민 1 test';
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('autoComplete1_button').click()");
		WebSquare.wUnit.addCommand("pause", "500");			
		WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour('autoComplete1_itemTable_1')");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();		
        
	]]></script>
