<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dlt_menu" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="depth" name="depth" dataType="text"></w2:column>
            			<w2:column id="label" name="label" dataType="text"></w2:column>
            			<w2:column id="value" name="value" dataType="text"></w2:column>
            			<w2:column id="path" name="path" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<depth><![CDATA[1]]></depth>
            				<label><![CDATA[메뉴 1번]]></label>
            				<value><![CDATA[menu1]]></value>
            			</w2:row>
            			<w2:row>
            				<depth><![CDATA[2]]></depth>
            				<label><![CDATA[하위메뉴 2번]]></label>
            				<value><![CDATA[menu1-2]]></value>
            			</w2:row>
            			<w2:row>
            				<depth><![CDATA[2]]></depth>
            				<label><![CDATA[하위메뉴 3번]]></label>
            				<value><![CDATA[menu1-3]]></value>
            			</w2:row>
            			<w2:row>
            				<depth><![CDATA[3]]></depth>
            				<label><![CDATA[최하위 4번]]></label>
            				<value><![CDATA[menu1-5]]></value>
            			</w2:row>
            			<w2:row>
            				<depth><![CDATA[3]]></depth>
            				<label><![CDATA[최하위 5번]]></label>
            				<value><![CDATA[menu1-6]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    
};

scwin.btn_setJSON_onclick = function(e) {
    var data = [
        { "depth" : "1", "label":"메뉴 1번", "value":"menu1" },
        { "depth" : "2", "label":"하위메뉴 1번", "value":"menu1-2" },
        { "depth" : "2", "label":"하위메뉴 2번", "value":"menu1-3" },
        { "depth" : "3", "label":"최하위 메뉴 1번", "value":"menu1-5" },
        { "depth" : "3", "label":"최하위 메뉴 2번", "value":"menu1-6" },
    ];

    var data2 = [
        { "label":"메뉴 1번", "value":"menu1" },
        { "label":"하위메뉴 1번", "value":"menu1-2" },
        { "label":"하위메뉴 2번", "value":"menu1-3" },
        { "label":"최하위 메뉴 1번", "value":"menu1-5" },
        { "label":"최하위 메뉴 2번", "value":"menu1-6" },
    ];

    dlt_menu.setBroadcast(false);
    dlt_menu.setJSON(data2);
    dlt_menu.setCellData(0, "depth", "1");
    dlt_menu.setCellData(1, "depth", "2");
    dlt_menu.setCellData(2, "depth", "2");
    dlt_menu.setCellData(3, "depth", "3");
    dlt_menu.setCellData(4, "depth", "3");
    dlt_menu.setBroadcast(true, true);

    console.log("JSON SET 완료");
};

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('grd_menu_body_tbody').children.length != 0;
	}		
	scwin.unitTest = function() {
		//noResult="previous"
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "400");

		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" style="">
    		<w2:textbox id="" label="setBroadcast(false) 설정 후 setJSON으로 ds 바인딩 시킬 때 부모노드 클릭 시 데이터가 모두 display:none 되는 현상"
    			style="width:1010px;height:23px;" tagname="h3">
    		</w2:textbox>
    		<w2:gridView checkAllType="false" defaultCellHeight="20" id="grd_menu" style="width: 500px;height: 150px;"
    			dataList="data:dlt_menu">
    			<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    			<w2:header style="" id="header1">
    				<w2:row style="" id="row1">
    					<w2:column width="70" inputType="text" style="" id="column4" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="text" style="" id="column3" value="drilldown" displayMode="label"></w2:column>
    					<w2:column width="108" inputType="text" style="" id="column2" value="label" displayMode="label"></w2:column>
    					<w2:column width="125" inputType="text" style="" id="column1" value="value" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody style="" id="gBody1">
    				<w2:row style="" id="row2">
    					<w2:column width="70" inputType="text" style="" id="column8" value="" displayMode="label"></w2:column>
    					<w2:column width="70" inputType="drilldown" style="" id="depth" value="" displayMode="label" depthColumn="depth"
    						depthType="div">
    					</w2:column>
    					<w2:column width="108" inputType="text" style="" id="label" value="" displayMode="label"></w2:column>
    					<w2:column width="125" inputType="text" style="" id="value" value="" displayMode="label"></w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    		<xf:trigger type="button" id="btn_setJSON" style="width: 80px;height: 23px;" ev:onclick="scwin.btn_setJSON_onclick">
    			<xf:label><![CDATA[setJSON]]></xf:label>
    		</xf:trigger>
    	</xf:group>
    </body>
</html>
