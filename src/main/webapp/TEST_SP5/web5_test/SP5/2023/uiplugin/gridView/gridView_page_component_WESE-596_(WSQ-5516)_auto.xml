    				</xf:group>
    				<xf:group tagname="td" style="" class="w2tb_td">
    					<w2:textbox style="" id="" label="name2 에디터 모드로 진입시 오류 발생"></w2:textbox>
    				</xf:group>
    			</xf:group>
    			<xf:group tagname="tr">
    				<xf:group tagname="td" style="" class="w2tb_td">
    					<w2:gridView setCellInputTypeCustom="true" checkAllType="false" dataList="data:dlt_dataList2"
    						style="width: 500px;height: 150px;" id="gridView2" class="wq_gvw" defaultCellHeight="30">
    						<w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
    						<w2:header style="" id="header2">
    							<w2:row style="" id="row3">
    								<w2:column width="70" inputType="text" style="" id="column5" value="name1" displayMode="label"></w2:column>
    								<w2:column width="70" inputType="text" style="" id="column4" value="name1" displayMode="label"></w2:column>
    								<w2:column width="70" inputType="text" style="" id="column3" value="name2" displayMode="label"></w2:column>
    							</w2:row>
    						</w2:header>
    						<w2:gBody style="" id="gBody2">
