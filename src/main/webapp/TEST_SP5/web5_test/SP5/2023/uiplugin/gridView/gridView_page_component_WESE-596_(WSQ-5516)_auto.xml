    								<w2:column width="70" inputType="spinner" style="" id="col1"
    									value="" displayMode="label">
    								</w2:column>
    								<w2:column typeGetter="scwin.typeGetter" width="70" inputType="custom" style="" id="col2" value=""
    									displayMode="label">
    								</w2:column>
    							</w2:row>
    						</w2:gBody>
    					</w2:gridView>
    				</xf:group>
    				<xf:group tagname="td" style="" class="w2tb_td">
    					<w2:textbox id="" label="name2 에디터 모드로 진입시 오류 발생" style=""></w2:textbox>
    				</xf:group>
    			</xf:group>
