    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dlt_dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[2]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[2]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dlt_dataList2" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col0" name="name3" dataType="text"></w2:column><w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[2]]></col2>
            				<col0><![CDATA[1]]></col0>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[2]]></col2>
            				<col0><![CDATA[2]]></col0>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.typeGetter = function(info) { 
   var rowIndex = info.rowIndex;
   var colIndex = info.colIndex;
   var returnInfo;
   var colId = gridView1.getColumnID(colIndex);
   
   switch(colId) {
       case "col2": 
           returnInfo = {
               id : "dynamic_snipper_" + rowIndex + "_" + colIndex,
               inputType : "spinner",
               options : {}
           }
           break;
   }
   return returnInfo;
}

scwin.customFormatter = function(data, formattedData, rowIdex, colIndex){
    var colId = gridView2.getColumnID(colIndex);
    switch(colId) {
        case "col2": 
            var info = {
                inputType : "spinner",
                options : {}
            }
            gridView2.setCellInputType(rowIdex, colIndex, info);
            break;
    }
    return data;
};

	scwin.Dbclick = function(id) {
		var el = WebSquare.wUnit.getDomById(id);
		scwin.fireDbClick(el);
	}
	scwin.fireDbClick = function(node) {
		if (document.createEventObject) {
			node.fireEvent('ondbclick');
		} else if (document.createEvent) {
			var evt = document.createEvent('MouseEvents');
			evt.initEvent('dblclick', true, false);
			node.dispatchEvent(evt);
		} else if (typeof node.ondbclick == 'function') {
			node.ondbclick();
		}
	}	
	
	scwin.checkVal = function() {
		return WebSquare.logger.getErrorLog() == '';
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "scwin.Dbclick('gridView1_cell_0_1')");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group id="">
    		<xf:group style="display: block;" id="">
    			
    			
    		</xf:group>
    		<xf:group style="display: block;" id="">
    			
    			
    		</xf:group>
