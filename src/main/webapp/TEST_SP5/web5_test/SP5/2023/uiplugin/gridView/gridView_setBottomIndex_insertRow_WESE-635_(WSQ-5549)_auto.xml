};



scwin.btn_bottom_onclick = function(e) {

    var row = grd_bottom.getFocusedRowIndex();

    for ( var i = 0; i < dlt_bottom.getTotalRow(); i++ ) {
        if ( dlt_bottom.getCellData(i, "테스트1") == "" ) {
            grd_bottom.setBottomRowIndex(i);
            return;
        }
    }
    // setbottom
    //grd_bottom.setBottomRowIndex(row);
};

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('grd_bottom_cell_4_0').innerText == '';
	}		
	scwin.unitTest = function() {
		//noResult="previous"
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_addRow').click()");
