        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

	scwin.checkVal = function() {
		return document.getElementById('G_'+$p.id+'grd_test__col2').style.display == 'block';
	}
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_test_cell_0_0').click()");
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('G_'+$p.id+'grd_test__col1').value = '2'");
		WebSquare.wUnit.addCommand("pause", "500");		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_test_cell_0_1').click()");
		WebSquare.wUnit.addCommand("pause", "500");			

		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		
	
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest()
	
]]></script>
