<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="-261">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                        <w2:column id="col5" name="name5" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    dataList1.insertRow();
    
};

scwin.trigger1_onclick = function(e) {
    gridView1.setColumnOrder([0,2,3,4]);
    gridView1.setColumnVisible(3, false);
    var CurrentStyle = gridView1.getCurrentGridStyle();
    gridView1.setGridStyle(JSON.parse(CurrentStyle));
};

scwin.trigger3_onclick = function(e) {
    gridView1.advancedExcelDownload({fileName:"file.xlsx"});
};

	scwin.checkVal = function() {
		var errorlog = WebSquare.logger.getLog();
		return errorlog.indexOf('replace is not a function') == -1;
	}		
	scwin.unitTest = function() {
		//noResult="previous"
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click()");
		WebSquare.wUnit.addCommand("pause", "500");		
	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "400");

		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:trigger type="button" id="trigger1" style="width:334px;height:23px;" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[1.getCurrentGridStyle -> setGridStyle]]></xf:label>
        </xf:trigger>
        <xf:trigger type="button" id="trigger3" style="width:91px;height:23px;" ev:onclick="scwin.trigger3_onclick">
            <xf:label><![CDATA[2.excel down]]></xf:label>
        </xf:trigger>
        <w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width: 500px;height: 150px;"
            dataList="data:dataList1">
            <w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
            <w2:header style="" id="header2">
                <w2:row style="" id="row3">
                    <w2:column width="70" inputType="text" style="" id="column7" value="name1" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column6" value="name2" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column5" value="name3" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column4" value="name4" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="column3" value="name5" displayMode="label"></w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody style="" id="gBody2">
                <w2:row style="" id="row4">
                    <w2:column width="70" inputType="text" style="" id="col1" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="col2" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="col3" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="col4" value="" displayMode="label"></w2:column>
                    <w2:column width="70" inputType="text" style="" id="col5" value="" displayMode="label"></w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
    </body>
</html>
