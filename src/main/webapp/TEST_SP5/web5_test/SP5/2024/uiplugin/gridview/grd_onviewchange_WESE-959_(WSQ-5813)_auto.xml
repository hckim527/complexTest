	window.checkLog = dlt_memberList.getAllJSON();
    console.log(dlt_memberList.getAllJSON());
};


		scwin.Dbclick = function(id) {
			var el = WebSquare.wUnit.getDomById(id);
			scwin.fireDbClick(el);
		}
		scwin.fireDbClick = function(node) {
			if (document.createEventObject) {
				node.fireEvent('ondblclick');
			} else if (document.createEvent) {
				var evt = document.createEvent('MouseEvents');
				evt.initEvent('dblclick', true, false);
				node.dispatchEvent(evt);
			} else if (typeof node.ondblclick == 'function') {
				node.ondblclick();
			}
		}
		scwin.simulateWrapper = function(target, type, options) {
			WebSquare.wUnit.getJq(target).simulate(type, options);
		}
		scwin.setSimulate = function() {
			scwin.simulateWrapper('#G_'+$p.id+'grd_gridView1__name', 'key-combo', {
				combo: 'BACKSPACE'
			});
		}
		scwin.setValue = function() {
			WebSquare.wUnit.getDomById('G_'+$p.id+'grd_gridView1__name').value = '';
		}
		scwin.checkVal = function() {
			return window.checkLog[0].name == '';
		}			
		scwin.unitTest = function() {
			//init
			WebSquare.wUnit.start();
			WebSquare.wUnit.addCommand("pause", "500");
			WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_gridView1_cell_0_1').click()");
			WebSquare.wUnit.addCommand("pause", "500");		
			WebSquare.wUnit.addCommand("set", "scwin.Dbclick('grd_gridView1_cell_0_1')");
			WebSquare.wUnit.addCommand("pause", "500");
			WebSquare.wUnit.addCommand("set", "scwin.setValue()");
			WebSquare.wUnit.addCommand("pause", "500");
			WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_gridView1_cell_0_2').click()");
			WebSquare.wUnit.addCommand("pause", "500");					
			WebSquare.wUnit.addCommand("set", "scwin.checkVal()");
			WebSquare.wUnit.addCommand("pause", "500");
			//Run  and stop
			WebSquare.wUnit.run();
			WebSquare.wUnit.stop();
		}
		scwin.unitTest();
