	scwin.isValueWithinPercentageRange = function(leftValue, targetValue, percentRange){
		if (typeof leftValue !== 'number' || typeof targetValue !== 'number' || typeof percentRange !== 'number') {
			console.warn("모든 인자는 숫자여야 합니다.");
			return false;
		}
debugger;
		const range = targetValue * (percentRange / 100);  // 오차값 계산
		const lowerBound = targetValue - range;
		const upperBound = targetValue + range;

		return leftValue >= lowerBound && leftValue <= upperBound;
	}
	scwin.checkVal1 = function(){
		const left1 = WebSquare.wUnit.getDomById('checkcombobox1_btn_confirm').offsetTop;
		const left2 = WebSquare.wUnit.getDomById('checkcombobox1_btn_cancel').offsetTop;
		const reVal1 = scwin.isValueWithinPercentageRange(left1, 1, 2)
		const reVal2 = scwin.isValueWithinPercentageRange(left2, 1, 2)		
		return reVal1 && reVal2;
	}  
	scwin.checkVal2 = function(){
		const top1 = WebSquare.wUnit.getDomById('checkcombobox3_btn_confirm').offsetTop;
		const top2 = WebSquare.wUnit.getDomById('checkcombobox3_btn_cancel').offsetTop;
		const reVal1 = scwin.isValueWithinPercentageRange(top1, 1, 2)
		const reVal2 = scwin.isValueWithinPercentageRange(top2, 1, 2)		
		return reVal1 && reVal2;
	}   	
	scwin.unitTest = function(){
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('checkcombobox1_button').click()");
		WebSquare.wUnit.addCommand("pause", "500");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('checkcombobox3_button').click()");
