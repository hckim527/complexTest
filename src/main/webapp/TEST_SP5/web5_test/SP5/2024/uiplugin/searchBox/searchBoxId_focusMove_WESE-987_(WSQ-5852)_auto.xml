        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

	scwin.setSimulate = function() {
		scwin.simulateWrapper('#wq_uuid_4');
	}
	scwin.simulateWrapper = function(target) {
		WebSquare.wUnit.getJq(target).simulate("click");
	}

	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('search1___input').classList.contains('w2input_focus');
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
		WebSquare.wUnit.addCommand('pause', '500');	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();	

]]></script>
