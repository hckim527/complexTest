<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="chk" name="체크" dataType="text"></w2:column>
            			<w2:column id="menu" name="메뉴" dataType="text"></w2:column>
            			<w2:column id="depthNo" name="depth" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		var jsonData = [{
			"chk":"2",
			"menu":"aaa",
			"depthNo":1
		},{
			"chk":"2",
			"menu":"bbb",
			"depthNo":2
		},{
			"chk":"2",
			"menu":"ccc",
			"depthNo":3
		},{
			"chk":"2",
			"menu":"ddd",
			"depthNo":3
		},{
			"chk":"2",
			"menu":"fff",
			"depthNo":2
		},{
			"chk":"2",
			"menu":"ggg",
			"depthNo":1
		},{
			"chk":"2",
			"menu":"hhh",
			"depthNo":2
		},{
			"chk":"2",
			"menu":"iii",
			"depthNo":2
		},{
			"chk":"2",
			"menu":"jjj",
			"depthNo":3
		}];
			
		dataList1.setJSON( jsonData );
	};

	
scwin.trigger1_onclick = function(e) {
	gridView1.checkAll("chk", true);
};


	scwin.checkVal1 = function(){
		return WebSquare.wUnit.getDomById('gridView1_cell_1_1').innerText == '  bbb';
	} 	
	scwin.unitTest = function(){
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_0_1').children[0].children[0].click()");
		WebSquare.wUnit.addCommand("pause", "1000");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand("pause", "1000");		
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView id="gridView1" ignoreToggleOnDisabled="false" syncScroll="false" useShiftKey="true"
    		style="position: absolute ;left: 38px;top: 54px;width:323px;height:195px;" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" summaryAuto="false" summaryOnlyAuto="false" applyAllColumnStyle="false" dataList="data:dataList1"
    		ignoreCellClick="false" tooltipDisplay="true" drilldownRealRowIndexAll="true">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column footerDiv="false" removeBorderStyle="false" width="70" inputType="checkbox" style="" id="column5" value="체크"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column footerDiv="false" removeBorderStyle="false" width="70" inputType="text" style="" id="column3" value="메뉴"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column footerDiv="false" removeBorderStyle="false" width="70" inputType="text" style="" id="column1" value="depth"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column footerDiv="false" removeBorderStyle="false" width="70" inputType="checkbox" style="" id="chk" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column footerDiv="false" removeBorderStyle="false" width="70" inputType="drilldown" style="" id="menu" value=""
    					blockSelect="false" displayMode="label" showDepth="1" depthColumn="depthNo">
    				</w2:column>
    				<w2:column footerDiv="false" removeBorderStyle="false" width="70" inputType="text" style="" id="depthNo" value=""
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" style="position: absolute;width: 80px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[checkall]]></xf:label>
    	</xf:trigger>
    </body>
</html>
