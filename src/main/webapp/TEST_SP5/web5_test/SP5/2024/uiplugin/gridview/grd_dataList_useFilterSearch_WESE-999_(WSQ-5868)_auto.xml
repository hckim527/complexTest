	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('gridView1_customFilter_list_items_main').querySelectorAll("input").length == 4;
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_column3_filter').click()");
		WebSquare.wUnit.addCommand("pause", "400");	
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_customFilter_list_items_main').querySelectorAll('input')[1].click()");
		WebSquare.wUnit.addCommand("pause", "400");	
