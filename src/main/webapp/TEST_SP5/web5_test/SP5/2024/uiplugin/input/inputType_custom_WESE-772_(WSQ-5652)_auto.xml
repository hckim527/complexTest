scwin.trigger5_onclick = function (e) {

	var options = {

		fileName: "test.xlsx",
		useDataFormat : "true"

	};

	gridview1.advancedExcelDownload(options);

};

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('gridview1_cell_0_7').innerText == '2024/01/22';
	}	
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
	
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
	
]]></script>
