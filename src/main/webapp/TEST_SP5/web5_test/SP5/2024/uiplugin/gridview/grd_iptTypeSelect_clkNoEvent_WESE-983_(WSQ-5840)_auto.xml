<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.gridView1_oncellclick = function(row,col,colId) {
    console.log("셀 클릭");
	window.check_val = "oncellclick";
};

scwin.checkVal = function() {
	return window.check_val == "oncellclick";
}

scwin.unitTest = function() {
	//Unit
	WebSquare.wUnit.start();
	WebSquare.wUnit.addCommand("pause", "500");
	WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_0_0_select_input_0').click()");
	WebSquare.wUnit.addCommand("pause", "500");
	WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
	WebSquare.wUnit.addCommand("pause", "500");

	//Run test and stop
	WebSquare.wUnit.run();
	WebSquare.wUnit.stop();
}
scwin.unitTest();

]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView id="gridView1" style="width: 500px;height: 150px;" checkAllType="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" dataList="data:dataList1" senseReader="true" readOnly="true" ev:oncellclick="scwin.gridView1_oncellclick">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="column3" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2" value="name2" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column1" value="name3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="select" style="" id="col1" value="" displayMode="label" allOption="" chooseOption=""
    					ref="" noDisabledOnReadOnly="true">
    					<w2:choices>
    						<w2:item>
    							<w2:label><![CDATA[new row]]></w2:label>
    							<w2:value><![CDATA[]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[new row]]></w2:label>
    							<w2:value><![CDATA[]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[new row]]></w2:label>
    							<w2:value><![CDATA[]]></w2:value>
    						</w2:item>
    					</w2:choices>
    				</w2:column>
    				<w2:column width="70" inputType="checkbox" style="" id="col2" value="" displayMode="label" noDisabledOnReadOnly="true"></w2:column>
    				<w2:column width="70" inputType="autoComplete" style="" id="col3" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
