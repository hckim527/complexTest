};

scwin.checkBoxClick = function() {
    // gridView1.setCellChecked(0, "col1", true);
    const checkboxes = document.querySelectorAll('input[type="checkbox"]');
    checkboxes[1].click();
};

scwin.checkVal = function() {
    return scwin.check.length !== 1;
};

scwin.unitTest = function () {
    //Unit 
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.checkBoxClick()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");

    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
};

