	scwin.onpageload = function() {
		dataList1.setXML(WebSquare.ModelUtil.findInstanceNode("list"));

		pivot1.setFieldOption([{
			"id" : "ratYear",
			"sortOrder" : "2016년(총괄),2016년02월(A) (누계),2017년02월(B) (누계),증감(B-A)"
		}])
		pivot1.setOption({
			"rows" : "tacFicdCode",
			"cols" : "ratYear",
			"vals" : "reduRate,totReduAmt,totRatAmt",
			"valuesAxis" : "col"
		});

	};

	scwin.onpageunload = function() {

	};

	scwin.trigger1_onclick = function(e) {
		var options = {};
		
		pivot1.pivotExcelUpload(options);
	};

	scwin.trigger2_onclick = function(e) {
		var options = {};
		options.fileName = "testExcelDown.xlsx";
		options.sheetName = "sheetName";
		options.useDataFormat = "true";
		options.useXHR = "true";

		pivot1.pivotExcelDownload(options);
	};

scwin.trigger03_onclick = function (e) {
		var options = {};
		options.fileName = "testExcelDown.csv";
		options.useXHR = "true";

		pivot1.pivotCSVDownload(options);
};

scwin.trigger04_onclick = function (e) {
		var options = {};
		
		pivot1.pivotCSVUpload(options);
};
]]></script>
