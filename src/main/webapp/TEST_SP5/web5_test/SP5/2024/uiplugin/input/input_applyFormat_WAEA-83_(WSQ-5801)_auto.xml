        <script lazy="false" type="text/javascript"><![CDATA[scwin.disabled = false;
scwin.onpageload = function() {
	scwin.unitTest();
};

scwin.input1_onchange = function (info) {

};

scwin.trigger1_onclick = function (e) {
    scwin.disabled =! scwin.disabled;
    group1.setDisabled(scwin.disabled);
};

scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
};

scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#input1', 'key-sequence', {
        sequence: '12345678901'
    });
};

// scwin.setSimulate2 = function() {
//     scwin.simulateWrapper('#input1', 'key-combo', {
//         combo: 'LEFT_ARROW'
//     });
// };
// 커서를 맨 앞으로 이동
scwin.setSimulate2 = function () {
    const inputElement = WebSquare.wUnit.getDomById('input1');
    if (inputElement) {
        inputElement.setSelectionRange(0, 0); // 커서를 맨 앞으로 이동
    } else {
        console.error("input1 요소를 찾을 수 없습니다.");
    }
};

// Delete 시뮬레이션 및 커서 위치 확인
scwin.setSimulate3 = function () {
    var retVal;
    const inputElement = WebSquare.wUnit.getDomById('input1');
    if (inputElement) {
        // 현재 커서 위치를 가져옴
        const initialCursorPosition = inputElement.selectionStart;

        if (initialCursorPosition !== null) {
            console.log(`Delete 실행 전 커서 위치: ${initialCursorPosition}`);

            // 커서 위치의 값을 삭제
            inputElement.value =
                inputElement.value.slice(0, initialCursorPosition) +
                inputElement.value.slice(initialCursorPosition + 1);

            // 삭제 후 커서 위치 유지
            inputElement.setSelectionRange(initialCursorPosition, initialCursorPosition);

            // input 이벤트 트리거
            const inputEvent = new Event('input', { bubbles: true });
            inputElement.dispatchEvent(inputEvent);

            // 삭제 후 커서 위치를 가져옴
            const finalCursorPosition = inputElement.selectionStart;
            console.log(`Delete 실행 후 커서 위치: ${finalCursorPosition}`);

            // 커서 위치가 같은지 확인
            if (initialCursorPosition === finalCursorPosition) {
                // 위치 같음
                retVal = true;
            } else {
                // 위치 틀림
                retVal = false;
            }

            // 결과 리턴
            return retVal;
        }
    } else {
        console.error("input1 요소를 찾을 수 없습니다.");
    }
};

scwin.unitTest = function() {
	//Unit 
	WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // 12345678901 입력
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "500");
    // 커서를 맨 앞으로 이동
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate2()");
    WebSquare.wUnit.addCommand("pause", "500");
    // 맨 앞 문자 삭제 및 커서 위치 확인
    WebSquare.wUnit.addCommand("assert", "scwin.setSimulate3()", "true");
	//Run test and stop
	WebSquare.wUnit.run();
	WebSquare.wUnit.stop();
};
]]></script>
