// 아래의 라인부터는 페이지 로딩 위주로 작성합니다.
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

/**------------------------------------------------------------------
 * 페이지 진입
 */
scwin.onpageload = function() {

    if(!com.auth.checkPage()) return;

    scwin.fn.init();
};

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 아래의 라인부터는 사용자 정의 상수 위주로 작성합니다.
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
scwin.enumcode = {};//enum 코드

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 아래의 라인부터는 사용자 정의 Function 위주로 작성합니다.
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

scwin.fn = {};


/**------------------------------------------------------------------
 * 소수점 치환후 리턴 
 * ex) 33.1% 
 * ex) 10%
 */
scwin.fn.setFormatNumber = function(number){
    const str = number.toFixed(1); // 소수점 첫째 자리까지 표시
    return str.endsWith('.0') ? str.slice(0, -2) : str; // 마지막 숫자가 0이면 '.0' 제거
}

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 아래의 라인부터는 컴포넌트의 사용자 정의  Function 위주로 작성합니다.
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


/**
 * customFormatter function Object 생성 
 */
scwin.customFormatter = {};

/**
 * displayFormatter function Object 생성 
 */
scwin.displayFormatter = {};

scwin.displayFormatter.answerRate = function(data, formattedData, rowIndex , colIndex){
    formattedData = data + "%";
    return formattedData; 
} 

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// 아래의 라인부터는 컴포넌트의 이벤트 위주로 작성합니다.
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

/**------------------------------------------------------------------
 * 일반엑셀 다운로드
 */
scwin.btn_excelDown_onclick = function (e) {

    if(dlt_survey.getAllJSON().length == 0){
        com.win.alert("데이터가 없습니다.");
        return;
    }

    let startDate = com.date.formatDate(ipc_startDate.getValue(), "-");
    
    let endDate = com.date.formatDate(ipc_endDate.getValue(), "-");
    
    let option = {
        fileName: '고객만족도조사_' + startDate + '~' + endDate + '.xlsx'
        , type: 1   //0=실제데이터, 1=눈에보이는데이터 2=cell에 들어가있는 데이터
        , startRowIndex : 0     //[default: 0] Excel 파일에서 그리드의 데이터가 시작되는 행의 번호 (헤더 포함)
        , sheetName : "고객만족도조사"
        , subTotalColor : "#ccffcc"
        , footerColor : "#f0f1ff"
    };
    com.data.downloadGridViewExcel(grd_survey, option, null);
};

/**------------------------------------------------------------------
 * 리셋버튼 이벤트
 */
scwin.btn_reset_onclick = function(e) {
    scwin.fn.reset();
};

/**------------------------------------------------------------------
 * 검색버튼 이벤트
 */
scwin.btn_search_onclick = function(e) {
    dma_search.set("_referer", "search");
    gcm.win.historySave(dma_search);//브라우저 History 저장
    scwin.fn.search();
};

/**------------------------------------------------------------------
 * 시작일 변경 이벤트
 * 종료일을 시작일과 동일하게 바꾼다.
 */
scwin.ipc_startDate_onviewchange = function(info) {
    dma_search.set("endDate",info.newValue);
};

/**------------------------------------------------------------------
 * 그리드 cell 클릭이벤트
 */
scwin.grd_survey_oncellclick = function(row,col,colId) {
    if(colId == "masterCode"){
        let _getParam = com.parameters();
        let param = {
            masterCode : dlt_survey.getCellData(row,"masterCode")
            , startDate : _getParam.startDate || ""
            , endDate : _getParam.endDate || ""
            , masterName : _getParam.masterName || ""
            , teamCode : _getParam.teamCode || ""
        } 
        com.win.moveUrl("/static/ui/consult/cusSurveyDetail.xml", param);                        
/*      
        새창으로 띄울때
        let _masterCode = grd_survey.getCellData(row, "masterCode");
        let _startDate = _getParam.startDate || "";
        let _endDate = _getParam.endDate || "";
        let param = "masterCode=" + _masterCode;
        param = param + "&startDate="+_startDate+"&endDate="+_endDate;
        //com.win.moveUrl("/static/ui/consult/cusSurveyDetail.xml", param);    
        window.open("?page=/static/ui/consult/cusSurveyDetail.xml&menuId=CM_130&"+param, "_blank");    */   
    }
};

/**------------------------------------------------------------------
 * 합계 표기(값이 없을때 0으로 표기)
 * 초기값 오류 처리를 위해 function 으로 처리한다.
 */
scwin.userExpZero = function (col1) {

    if (com.util.isEmpty(col1)) {
        return 0;
    } else {
        return col1;
    }
};

/**------------------------------------------------------------------
 * 점수 합계 표기
 * 그리드 자체 1row에 평균값이 있기때문에 평균에 평균을구하면 안되기에 sum 한 데이터를 최종 응답자 합계로 나눠서 평균을 구한다.
 * 초기값 오류 처리를 위해 function 으로 처리한다.
 */
scwin.userExpCol = function (col1, col2) {

    if (com.util.isEmpty(col1) || com.util.isEmpty(col2)) {
        return 0;
    } else {
        return col1/col2;
    }
};

	scwin.checkVal1 = function() {
