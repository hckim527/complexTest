        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var data = [];
    for (var i = 0; i < 50; i++) {
        for (var j = 0; j < 15; j++) {
            data.push(j + i * 15);
        }
    }
    dataList1.setData(data);
};

	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getJq('#grid1_cell_0_0').hasClass('w2grid_fixedColumn_td');
	}	
	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getJq('#grid1_cell_0_12').hasClass('w2grid_fixedRightColumn_td');
	}		
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest(); 
	
	
]]></script>
    <style type="text/css"><![CDATA[
