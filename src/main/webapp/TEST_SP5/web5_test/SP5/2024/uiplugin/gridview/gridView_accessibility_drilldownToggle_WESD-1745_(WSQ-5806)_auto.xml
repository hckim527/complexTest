<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <script type="javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>	
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="depth" name="depth" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		var jsonData = [{"col2":"a1fewfekwlmfefewl","col3":"a1", "depth":"0"}
                        ,{"col2":"a1-1","col3":"a1-1", "depth":"1"}
						,{"col2":"a2","col3":"a2","depth":"0"}
						,{"col2":"a2-1","col3":"a2-1","depth":"1"}
                        ,{"col2":"a3","col3":"a3","depth":"0"}
                        ,{"col2":"a3-1","col3":"a3-1","depth":"1"}];
		dataList1.setJSON( jsonData );

	};
	
	scwin.onpageunload = function() {
		
	};

    scwin.simulateWrapper = function(target, type, options) {
        WebSquare.wUnit.getJq(target).simulate(type, options);
    };

    scwin.setSimulate = function() {
        scwin.simulateWrapper('#gridView2_cell_0_1', 'key-combo', {
            combo: 'ENTER'
        });
    };

    scwin.checkVal = function() {
        let celldata = gridView2.getCellDisplayData(1, 1);
        
        return celldata !== "a2";
    };

    scwin.unitTest = function() {
        //Unit 
        WebSquare.wUnit.start();
        WebSquare.wUnit.addCommand("pause", "500");
        WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView2_cell_0_1').click()");
        WebSquare.wUnit.addCommand("pause", "500");
        WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
        WebSquare.wUnit.addCommand("pause", "500");
        WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
        //Run test and stop
        WebSquare.wUnit.run();
        WebSquare.wUnit.stop();
    };

    scwin.unitTest();]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	
    	
    	<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView2"
    		dataDragSelect="true" useShiftKey="true" 
            tooltipDisplay="true" tooltipShowAlways="true"
            
    accessibility="true"
    senseReader="true"
    focusMove="false"
    keyMoveEditMode="true"
    captionAuto="true"
    autoResizeEmbeddedInput="true"
    sortHeaderDiv="true"
    scrollFocus="true"
    titleAuto="true"
    applyScopeHeaders="true"
    readOnly="true"

    drilldownToggle="enter" hammerEnabled="true"
            drilldownRealRowIndexAll="true" drilldownRealRowIndex="true"
    		style="position: absolute ;left: 63px;top: 0px;width: 484px;height: 188px;">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column7" removeBorderStyle="false" style="" inputType="checkbox" width="70" value="name1"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70" value="name2"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" inputType="text" width="70" value="name3"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1" removeBorderStyle="false" style="" width="70" inputType="text" value="depth"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="drilldown" width="70" value=""  displayMode="label" depthColumn="depth" showDepth="0">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="depth" removeBorderStyle="false" style="" width="70" inputType="text" value=""
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
