		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
    pgl_exam1_1.setCount(32);
    pgl_exam1_2.setCount(5);
    pgl_exam2_1.setCount(32);
    pgl_exam2_2.setCount(5);
    pgl_exam3_1.setCount(32);
    pgl_exam3_2.setCount(5);
    pgl_exam4_1.setCount(32);
    pgl_exam4_2.setCount(32);
    pgl_exam5_1.setCount(32);
    pgl_exam5_2.setCount(5);
};

scwin.unitTest = function () {
    //Unit 
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('pgl_exam4_1_next_btn').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('pgl_exam4_1_next_btn').title === '다음 10 페이지 목록'", "true");

    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
};

scwin.unitTest();]]>
		</script>
