		<script type="text/javascript" lazy="false"><![CDATA[
	/**
	 * 초기 스크립트 수행 함수 정의
	 */
	scwin.onpageload = function() {
		
	};
	
	/**
	 * 초기 스크립트 수행 함수 정의
	 */
	scwin.onpageunload = function() {
		com.sbm.execute(sbm_advancedExcel);
	};	
	
	/** 
	 * /ui/SP/Data/advancedExcel.json 파일을 읽어온다.
	 */ 
	scwin.btn_search_onclick = function() {
		com.sbm.execute(sbm_advancedExcel);
	};
	
	/**
	 * sbm_advancedExcel의 submitdone, 조회된 행의 총 갯수를 count한다.
	 */
	scwin.sbm_advancedExcel_submitdone = function(e) {
		spn_excelBasicCnt.setValue( dlt_advancedExcel.getRowCount() );
	};
	
	
	/** 
	 * 그리드뷰의 데이터를 엑셀로 다운로드 한다.
	 * 필요한 옵션이 있다면 options, infoArr배열에 옵션을 넣는다.
	 */
	scwin.btn_downloadExcelBasic_onclick = function() {
		var option = {};
		var info = {};
	
		if (rad_excelType.getValue() == "csv") {
			option.fileName = "data." + rad_excelType.getValue();
			com.data.downloadGridViewCSV(grd_excelGrid, option, info);
		} else if (rad_excelType.getValue() == "xls" || rad_excelType.getValue() == "xlsx") {
			option.fileName = "data." + rad_excelType.getValue();
			com.data.downloadGridViewExcel(grd_excelGrid, option, info);
		} else {
			com.win.alert("지원하지 않는 파일 형식입니다.");
		}
		
	};
	
	/**	 
	 * 엑셀의 데이터를 그리드뷰로 업로드 한다.
	 * 필요한 옵션이 있다면 options배열에 옵션을 넣는다.
	 */
	scwin.btn_uploadDataBasic_onclick = function() {
		var option = {};
		
		if (rad_excelType.getValue() == "csv") {
			com.data.uploadGridViewCSV(grd_excelGrid, option);
		} else if (rad_excelType.getValue() == "xls" || rad_excelType.getValue() == "xlsx") {
			com.data.uploadGridViewExcel(grd_excelGrid, option);
		} else {
			com.win.alert("지원하지 않는 파일 형식입니다.");
		}
	};
	
	/**
	 * 엑셀 업로드 후, 건수를 체크한다.
	 */
	scwin.grd_excelGrid_onfilereadend = function(value) {
		spn_excelBasicCnt.setValue(grd_excelGrid.getTotalRow());
	};
	
	/**
	 * 그리드의 데이터가 지워진다.
	 */
	scwin.btn_gridRemoveExcelBasic_onclick = function() {
		dlt_advancedExcel.removeAll();
	};
	
	/**
	 * 그리드 Excel 포맷을 다운로드 하는 기능 ( 업로드용  Excel 포맷 )
	 */
	scwin.btn_defaultExcelFormat_onclick = function() {
		if ( rad_excelType.getValue() == "csv" ) {
			com.win.alert("csv는 header 포맷 다운로드 기능을 제공하지 않습니다.");
			return;
		}
		  
		var option = {};
		option.fileName = "header." + rad_excelType.getValue();
		option.dataProvider = "com.inswave.template.provider.ExcelDownHeader";
		var info = {};
		
		com.data.downloadGridViewExcel(grd_excelGrid, option, info);	
		
	};

	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate = function() {
		scwin.simulateWrapper('#grd_excelGrid_item_0_autocomplete_column18_input', 'key-sequence', {
			sequence: '가'
		});
	}
	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('grd_excelGrid_noresult').style.display == 'none';
	}
	scwin.checkVal2 = function() {
		return WebSquare.wUnit.getDomById('grd_excelGrid_cell_0_2').innerText == '가나';
	}	
	scwin.unitTest = function() {
		//Init test
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_excelGrid_column18_filter').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_excelGrid_customFilter_list_items_main').children[0].children[1].click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_excelGrid_item_0_selectbox_column18_button').click()");
		WebSquare.wUnit.addCommand("pause", "400");		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_excelGrid_item_0_selectbox_column18_itemTable_12').click()");
		WebSquare.wUnit.addCommand("pause", "400");			
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_excelGrid_item_0_autocomplete_column18_label').click()");
		WebSquare.wUnit.addCommand("pause", "400");		
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
		WebSquare.wUnit.addCommand("pause", "400");		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_excelGrid_item_0_selectbox_column18_itemTable_12').click()");
		WebSquare.wUnit.addCommand("pause", "400");					
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_excelGrid_btnConform_column18').click()");
		WebSquare.wUnit.addCommand("pause", "400");				
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		
		//Run and Stop unit Test
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();

]]></script>
