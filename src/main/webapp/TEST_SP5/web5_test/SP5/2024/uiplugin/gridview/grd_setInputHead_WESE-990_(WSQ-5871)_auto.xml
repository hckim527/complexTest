<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="./NewFile1.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="">
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList baseNode="list" repeatNode="map" id="dataList1" removeDummyRowStatus="true" saveRemovedData="true">
        			<w2:columnInfo>
        				<w2:column id="1" name="name1" dataType="text"></w2:column>
        				<w2:column id="2" name="name2" dataType="text"></w2:column>
        				<w2:column id="3" name="name3" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        	</w2:dataCollection>
        	<w2:workflowCollection></w2:workflowCollection>
        	<xf:submission id="submission1" ref="" target="data:json,dataList1" action="/data/gridView_example.json" method="post"
        		mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
        		processMsg="조회중" singleMode="true" ev:submit="scwin.submission1_submit" ev:submitdone="scwin.submission1_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

scwin.onpageload = function () {

	var tmpJSON = [
		{ "1": "1", "2": "원", "3": "하나" },
		{ "1": "2", "2": "투", "3": "하나" },
		{ "1": "3", "2": "쓰리", "3": "삼" },
		{ "1": "4", "2": "포", "3": "넷" },
		{ "1": "5", "2": "파이브", "3": "오" }
	];
	dataList1.setJSON(tmpJSON);

};

scwin.onpageunload = function () {

};

var col;
scwin.gridView1_onheaderclick = function(headerId) {
	console.log(headerId);
	col="mf_gridView1_"+headerId;	
	gridView1.setInputHead(document.getElementById(col));
	
};

	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('gridView1_column3').querySelector('input').getAttribute('title') == '입력하세요';
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_column3').click()");
		WebSquare.wUnit.addCommand("pause", "400");	
		WebSquare.wUnit.addCommand("pause", "400");	
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		
	
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest()
]]></script>
<style type="text/css"><![CDATA[


]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView id="gridView1" style="width: 500px;height: 150px;" checkAllType="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" dataList="data:dataList1" ev:onheaderclick="scwin.gridView1_onheaderclick">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="210" inputType="text" style="" id="column4" value="header" displayMode="label" colSpan="3"
    					rowSpan="">
    				</w2:column>
    			</w2:row>
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="" id="column3" title="입력하세요" value="name1" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="column2"
    					value='&lt;span style="color : red;"&gt;*&lt;/span&gt; name2' displayMode="label" class="" escape="true">
    				</w2:column>
    				<w2:column width="70" inputType="select" style="" title="입력하세요" id="column1" value="name3" displayMode="label" allOption=""
    					chooseOption="" ref="">
    					<w2:choices>
    						<w2:item>
    							<w2:label><![CDATA[new row1]]></w2:label>
    							<w2:value><![CDATA[1]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[new row2]]></w2:label>
    							<w2:value><![CDATA[2]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[new row3]]></w2:label>
    							<w2:value><![CDATA[3]]></w2:value>
    						</w2:item>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="" id="1" value="" displayMode="label"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="2" value="" displayMode="label" class="" embeddedInput="true"></w2:column>
    				<w2:column width="70" inputType="text" style="" id="3" value="" displayMode="label" allOption="" chooseOption=""
    					ref="">
    					<w2:choices>
    						<w2:item>
    							<w2:label><![CDATA[new row]]></w2:label>
    							<w2:value><![CDATA[]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[new row]]></w2:label>
    							<w2:value><![CDATA[]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[new row]]></w2:label>
    							<w2:value><![CDATA[]]></w2:value>
    						</w2:item>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
