        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.trigger1_onclick = function(e) {
	var Mdata = dataList1.getModifiedJSON();
	console.log("Mdata == "+JSON.stringify(Mdata));

	debugger;
	dataList2.setJSON(Mdata,false,"",true);
	console.log("test == "+JSON.stringify(dataList2.getAllJSON()));

	let tem_string = JSON.stringify(dataList2.getAllJSON());
	let parsedArray = JSON.parse(tem_string);
	window.rowStatusValue = parsedArray[0].rowStatus;

	
};

	scwin.simulateWrapper = function(target, type, options) {
		WebSquare.wUnit.getJq(target).simulate(type, options);
	}
	scwin.setSimulate = function() {
		scwin.simulateWrapper('#G_'+$p.id+'grid1__col3', 'key-sequence', {
			sequence: '222'
		});
	}	
	
	scwin.Dbclick = function(id) {
		var el = WebSquare.wUnit.getDomById(id);
		scwin.fireDbClick(el);
	}
	scwin.fireDbClick = function(node) {
		if (document.createEventObject) {
			node.fireEvent('ondblclick');
		} else if (document.createEvent) {
			var evt = document.createEvent('MouseEvents');
			evt.initEvent('dblclick', true, false);
			node.dispatchEvent(evt);
		} else if (typeof node.ondblclick == 'function') {
			node.ondblclick();
		}
	}
	
	scwin.checkVal = function() {
		return window.rowStatusValue == 'U';
	}
	scwin.unitTest = function() {
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grid1_cell_1_2').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		
		WebSquare.wUnit.addCommand("set", "scwin.Dbclick('grid1_cell_1_2')");
		WebSquare.wUnit.addCommand("pause", "500");

		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('G_'+$p.id+'grid1__col3').value = ''");
		WebSquare.wUnit.addCommand("pause", "500");
		
		WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
		WebSquare.wUnit.addCommand("pause", "500");

		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
	
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}	
	scwin.unitTest() 

]]></script>
