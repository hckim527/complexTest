			"SORT_ORDER": 3,
			"GRP_CD": "00003",
			"IS_USE": "Y"
		}]);
};

scwin.grd_commonGrp_onheaderclick = function(headerId) {
	console.log("header click");
	click_cnt++;
	localStorage.setItem('log', click_cnt)
};

	scwin.checkVal1 = function() {
		return localStorage.getItem('log') == 1;
	}		
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('grd_commonGrp_chk').children[1].click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest(); 
	localStorage.removeItem("log");	
]]></script>
