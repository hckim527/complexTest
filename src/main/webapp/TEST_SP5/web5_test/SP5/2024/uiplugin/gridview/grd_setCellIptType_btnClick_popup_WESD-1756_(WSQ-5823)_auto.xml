		<script type="text/javascript" lazy="false"><![CDATA[
    scwin.init = function() {
        requires("uiplugin.popup");
        scwin.popupIdx = 0;
        var jsonData = [
            {"label":"button","code":"button"},
            {"label":"calendar","code":"calendar"},
            {"label":"checkbox","code":"checkbox"},
            {"label":"select","code":"select"},
            {"label":"radio","code":"radio"},
            {"label":"text","code":"text"}
        ];
        dlt_select.setJSON(jsonData);
        
        var sel_sampleData = [
            {"col1":"축구", "col2":"1"},
            {"col1":"농구", "col2":"2"},
            {"col1":"야구", "col2":"3"},
            {"col1":"배구", "col2":"4"}
        ];
        
        sel_sample.setJSON(sel_sampleData);
        
        
        var arr=[{"col3":"1"},{"col3":"2"},{"col3":"1"},{"col3":"1"},{"col3":"2"}];
        dataList1.setJSON(arr);
        dataList2.setJSON(arr);
        dataList3.setJSON(arr);
        dataList4.setJSON(arr);
    };
    
    scwin.inputTypeCustomObj = {
        text: {inputType: "text"},
        calendar : {inputType : "calendar"},
        radio: {inputType : "radio"},
        checkbox : {inputType :"checkbox"},
        input : {inputType : "input", className:"test1"},
        select : {inputType : "select",
            options : {viewType :"default",  
                chooseOption : true,
                chooseOptionLabel : "-선택-"},
            itemSet : {
                nodeset:"data:sel_sample",
                label : "col1",
                value : "col2"
            }
        },
        select2 : {inputType : "select",
            options : {
                viewType : "icon",
                chooseOption : true
            },
            itemSet : {
                nodeset:"data:sel_sample",
                label : "col1",
                value : "col2"
            }
        },
        button : {
                        inputType : "button", className: "test1", value: "button"
        },
         textImage : {
                        inputType : "textImage",
                        options : {
                            imageSrc : "/websquare/uiplugin/grid/images/plus.gif",
                            imageHeight : "20",
                            imageWidth : "20", 
                            viewType: "icon"
                        }}
    };
    
    //값 변경 시 col2의 inputType을 동적으로 변경한다.
    scwin.gridView1_onviewchange = function(info) {
        var inputType = info.newValue;
        var obj = scwin.inputTypeCustomObj[inputType];
        var temp = dataList1.getCellData(info.rowIndex, "col3");
        if(temp == "2"){
            obj = scwin.inputTypeCustomObj["select2"];
        }
        gridView1.setCellInputType( info.rowIndex , "col2" , obj );
    };

    scwin.gridView2_onviewchange = function(info) {
        var inputType = info.newValue;
        var obj = scwin.inputTypeCustomObj[inputType];
        var temp = dataList2.getCellData(info.rowIndex, "col3");
        if(temp == "2"){
            obj = scwin.inputTypeCustomObj["select2"];
        }
        gridView2.setCellInputType( info.rowIndex , "col2" , obj );
    };

    scwin.gridView_oncellclick = function(row, col, colId) {
        var inputType = this.getInputType(colId);
        console.log(this.id + " oncellclick column ID : " + colId + ", inputType : " + inputType);
        if (inputType == "button") {
            scwin.openPopup("wframePopup");
        } else if (inputType === "custom") {
            var cellInfo = this.getCellInfo(col);
            var cellManager = cellInfo.cellManagerHashByRowIndex[row];
            if (cellManager && cellManager.options.inputType === "button") {
                scwin.openPopup("wframePopup");
            }
        }
    }

    scwin.custom_cell_onclick = function(row, col, colId) {
        console.log(this.parentControl + " custom_cell_onclick");
    }
            
    scwin.onpageload = function() {
        scwin.init();
    };
    
    scwin.onpageunload = function() {
        
    };
    
    scwin.openPopup = function(type) {
        var top = "100px";
        var left = "100px";
        var locPosition = $p.top().scwin.popupIdx % 3;
        
        var modal = false;
         
        switch(locPosition) {
            case 0 : 
                top = "100px";
                left = "100px";
                break;
            case 1 :
                top = "370px";
                left = "400px";
                break;  
            case 2 :
                top = "100px";
                left = "700px";
                break;
            default :
        }
        
        var popupName = (type + $p.top().scwin.popupIdx) || ("wframePopup" + $p.top().scwin.popupIdx);
        
        if (modal === true) {
            popupName += " (modal)";
        } else {
            popupName += " (modaless)";
        }
        
        requires("uiplugin.popup");
        var options = {
            id : "popup" + $p.top().scwin.popupIdx,
            type : type || "wframePopup",
            width : "580px",
            height : "250px",
            top : top,
            left : left,
            popupName : popupName,
            modal : modal,
            useModalStack : true,
            resizable : true,
            status : true,
            menubar : false,
            scrollbars : false,
            accessibility : true,
            title : false
        };
        $p.openPopup("WESD_86_content1.xml", options);
        
        $p.top().scwin.popupIdx++;
    };
    scwin.getType = function ( info ) {
        var rowIndex = info.rowIndex;
        var colIndex = info.colIndex;
        var returnInfo;
        if(colIndex == 1){
            returnInfo = {
                id : "dynamic_button_" + rowIndex + "_" + colIndex,
                inputType : "button",
                value : "button",
                options : {
                }
            };
            console.log( "[typeGetter] (" + rowIndex + ", " + colIndex + ") : " +JSON.stringify(returnInfo));
        
        } else {
            returnInfo = {
                id : "dynamic_text_" + rowIndex + "_" + colIndex,
                inputType : "text",
                options : {
                }
            };
        }
        return returnInfo;
    };
    ]]></script>

        <style type="text/css"><![CDATA[
            .test1 { background-color:red !important; }
         ]]></style>
