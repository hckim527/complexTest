<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
        
	scwin.onpageload = function() {
		
	};
	
	scwin.onpageunload = function() {
		
	};
	
	
	scwin.trigger1_onclick = function(e) {
		win1.setSrc("iframe_sandbox_Cross-Origin_WESE-871_(WSQ-5717)_sub2.xml");
	};
	
	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('win2').getAttribute('sandbox') == 'allow-scripts allow-same-origin';
	}
	scwin.unitTest = function() {
		//Init test
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		//Run and Stop unit Test
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();	
	
	]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <xf:group id="" style="margin: 20px;border-width:1px;">
            <w2:iframe id="win1" src="iframe_sandbox_Cross-Origin_WESE-871_(WSQ-5717)_sub1.xml" scrolling="auto" spa="true" spaReplaceHistory="true" style="width: 500px;height: 300px;border-style:solid;border-color:#000000;border-width:1px;" 
                useSandbox="true" sandbox="allow-scripts allow-same-origin">
            </w2:iframe>
            <w2:iframe id="win2" src="https://www.tcpschool.com/" scrolling="auto" spa="true" spaReplaceHistory="true" style="width: 500px;height: 300px;border-style:solid;border-color:#000000;border-width:1px;" 
                useSandbox="true" sandbox="allow-scripts allow-same-origin">
            </w2:iframe>
            <xf:trigger ev:onclick="scwin.trigger1_onclick" style="width:196px;height:39px;margin-top:10px;margin-right:10px;font-family:sans-serif;font-size:15px;font-size-adjust:0;font-style:italic;font-weight:bold;display:block;background-color:#8080C0;" id="trigger1" type="button">
                <xf:label><![CDATA[setSrc("sub2.xml")]]></xf:label>
            </xf:trigger>
        </xf:group>
    </body>
</html>
