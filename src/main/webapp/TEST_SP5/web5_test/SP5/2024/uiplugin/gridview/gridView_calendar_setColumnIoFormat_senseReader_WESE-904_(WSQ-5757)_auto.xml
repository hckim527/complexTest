<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="date"></w2:column>
                        <w2:column id="col2" name="name2" dataType="date"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <col1><![CDATA[201612300101]]></col1>
                            <col2><![CDATA[201612300101]]></col2>
                        </w2:row>
                        <w2:row>
                            <col1><![CDATA[2017010300101]]></col1>
                            <col2><![CDATA[2017010300101]]></col2>
                        </w2:row>
                        <w2:row>
                            <col1><![CDATA[2017010900101]]></col1>
                            <col2><![CDATA[2017010900101]]></col2>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
                <w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="date"></w2:column>
                        <w2:column id="col2" name="name2" dataType="date"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <col1><![CDATA[201612300101]]></col1>
                            <col2><![CDATA[201612300101]]></col2>
                        </w2:row>
                        <w2:row>
                            <col1><![CDATA[2017010300101]]></col1>
                            <col2><![CDATA[2017010300101]]></col2>
                        </w2:row>
                        <w2:row>
                            <col1><![CDATA[2017010900101]]></col1>
                            <col2><![CDATA[2017010900101]]></col2>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[

            scwin.onpageload = function() {
            };

            scwin.onpageunload = function() {
            };

            scwin.trigger1_onclick = function() {
                gridView1.setColumnIoFormat({
                             colIndex : 0,
                             ioFormat : "ddMMyyyy",
                             dateMask : "dd-MM-yyyy" // 동작안됨
                });
            }

            scwin.trigger11_onclick = function() {
                gridView2.setColumnIoFormat({
                             colIndex : 0,
                             ioFormat : "ddMMyyyy",
                             dateMask : "dd-MM-yyyy" // 동작안됨
                });
            }
			
	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('gridView1_cell_0_0_calendar_input').value == '30-12-2016';
	}
	scwin.checkVal2 = function() {
		return WebSquare.wUnit.getDomById('gridView1_cell_1_0_calendar_input').value == '03-01-2017';
	}
	scwin.checkVal3 = function() {
		return WebSquare.wUnit.getDomById('gridView1_cell_2_0_calendar_input').value == '09-01-2017';
	}	
	scwin.unitTest = function(){
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
		WebSquare.wUnit.addCommand("pause", "500");	

		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal3()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();	
	

        ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
        <xf:group>
            <w2:textbox id="" label="gridView senseReader true" style="width: 300px;height: 40px;"></w2:textbox>
            <xf:trigger type="button" style="width: 180px;height: 23px;" value="setColumnIoFormat ddMMyyyy" id="trigger1" ev:onclick="scwin.trigger1_onclick"></xf:trigger>
            <w2:gridView dataList="dataList1" scrollByColumn="false" summaryAuto="false" scrollByColumnAdaptive="false" id="gridView1"
                style="width:443px;height:150px;" ignoreCellClick="false" ignoreToggleOnDisabled="false" senseReader="true"
                fixedColumnWithHidden="true" useShiftKey="true" autoFit="allColumn" excludeModifiedRows="" escape="" editModeEvent="">
                <w2:header id="header1" style="">
                    <w2:row id="row1" style="">
                        <w2:column id="column3" style="height:20px;" inputType="text" width="200" value='useIOFormatLength = "true"' >
                        </w2:column>
                        <w2:column id="column1" style="height:20px;" width="200" inputType="text" value='useIOFormatLength = "false"'>
                        </w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody id="gBody1" style="">
                    <w2:row id="row2" style="">
                        <w2:column id="col1" inputType="calendar" style="height:20px" width="200" useIOFormatLength="true" editModeEvent=""></w2:column>
                        <w2:column id="col2" inputType="calendar" style="height:20px" width="200" useIOFormatLength="false" editModeEvent=""></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
        <xf:group style="padding-top:30px;">
            <w2:textbox id="" label="gridView senseReader false" style="width: 300px;height: 40px;"></w2:textbox>
            <xf:trigger type="button" style="width: 280px;height: 23px;" value="setColumnIoFormat ddMMyyyy" id="trigger11" ev:onclick="scwin.trigger11_onclick"></xf:trigger>
            <w2:gridView dataList="dataList2" scrollByColumn="false" summaryAuto="false" scrollByColumnAdaptive="false" id="gridView2"
                style="width:443px;height:150px;" ignoreCellClick="false" ignoreToggleOnDisabled="false" senseReader="false"
                fixedColumnWithHidden="true" useShiftKey="true" autoFit="allColumn" excludeModifiedRows="" escape="" editModeEvent="">
                <w2:header id="header1" style="">
                    <w2:row id="row1" style="">
                        <w2:column id="column3" style="height:20px;" inputType="text" width="200" value='useIOFormatLength = "true"' >
                        </w2:column>
                        <w2:column id="column1" style="height:20px;" width="200" inputType="text" value='useIOFormatLength = "false"'>
                        </w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody id="gBody1" style="">
                    <w2:row id="row2" style="">
                        <w2:column id="col1" inputType="calendar" style="height:20px" width="200" useIOFormatLength="true" editModeEvent=""></w2:column>
                        <w2:column id="col2" inputType="calendar" style="height:20px" width="200" useIOFormatLength="false" editModeEvent=""></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
    </body>
</html>
