<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                        <w2:column id="col5" name="name5" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
    var row = 5;
    var col = 5;
    var data = [];
    for (var i = 0; i < row; i++) {
        for (var j = 0; j < col; j++) {
            var ss = String(i) + "," + String(j);
            data.push(ss);
        }
    }
    dataList1.setData(data);
};
scwin.trigger1_onclick = function() {
    iframe1.setSrc("gridview_iframe_setSrc_WESE-805_(WSQ-5701)_sub.xml");
}
scwin.trigger2_onclick = function() {
    iframe2.setSrc("gridview_iframe_setSrc_WESE-805_(WSQ-5701)_sub2.xml");
}
scwin.trigger3_onclick = function() {
    iframe3.setSrc("gridview_iframe_setSrc_WESE-805_(WSQ-5701)_sub3.xml");
}

	scwin.checkVal1 = function(){
		return WebSquare.wUnit.getDomById('iframe1').tagName == 'DIV';
	}
	scwin.unitTest = function(){
		//Unit
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		//Run test and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();
	
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group id="" style="position:relative;width:500px;height:300px;">
            <w2:iframe id="iframe1" style="position:relative;" blankSrcSkip="true"/>
        </xf:group>
        <xf:group id="" style="position:relative;width:500px;height:50px;">
            <xf:trigger style="width:120px;height:31px;" id="trigger1" type="button" ev:onclick="scwin.trigger1_onclick">
                <xf:label>
                    <![CDATA[iframe1 setSrc]]>
                </xf:label>
            </xf:trigger>
            <xf:trigger style="width:120px;height:31px;" id="trigger2" type="button" ev:onclick="scwin.trigger2_onclick">
                <xf:label>
                    <![CDATA[iframe2 setSrc]]>
                </xf:label>
            </xf:trigger>
            <xf:trigger style="width:120px;height:31px;" id="trigger3" type="button" ev:onclick="scwin.trigger3_onclick">
                <xf:label>
                    <![CDATA[iframe3 setSrc]]>
                </xf:label>
            </xf:trigger>
        </xf:group>
        <w2:iframe id="iframe2" style="position:relative;width:500px;height:300px;"/>
        <xf:group id="" style="position:relative;width:500px;height:200px;">
            <w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width:500px;height:190px;" dataList="data:dataList1" rowNumVisible="true">
                <w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
                <w2:header style="" id="header2">
                    <w2:row style="" id="row3">
                        <w2:column width="100" inputType="text" id="column7" value="name1" displayMode="label"></w2:column>
                        <w2:column width="100" inputType="text" id="column6" value="name2" displayMode="label"></w2:column>
                        <w2:column width="100" inputType="text" id="column5" value="name3" displayMode="label"></w2:column>
                        <w2:column width="100" inputType="text" id="column4" value="name4" displayMode="label"></w2:column>
                        <w2:column width="100" inputType="text" id="column3" value="name5" displayMode="label"></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody style="" id="gBody2">
                    <w2:row style="" id="row4">
                        <w2:column width="100" inputType="text" id="col1" displayMode="label" maxByteLength="8"></w2:column>
                        <w2:column width="100" inputType="text" id="col2" displayMode="label" maxByteLength="8"></w2:column>
                        <w2:column width="100" inputType="text" id="col3" displayMode="label" maxByteLength="8"></w2:column>
                        <w2:column width="100" inputType="text" id="col4" displayMode="label" maxByteLength="8"></w2:column>
                        <w2:column width="100" inputType="text" id="col5" displayMode="label" maxByteLength="8"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
        <xf:group id="" style="position:relative;width:410px;height:210px;">
            <w2:iframe id="iframe3" style="position:relative;width:400px;height:200px;"/>
        </xf:group>
        <xf:group id="">
            <xf:trigger style="width:99px;height:31px;" id="trigger4" type="button">
                <xf:label>
                    <![CDATA[btn4]]>
                </xf:label>
            </xf:trigger>
            <xf:input style="width: 144px;height: 21px;" id="input3" maxByteLength="8"></xf:input>
            <xf:trigger style="width:99px;height:31px;" id="trigger5" type="button">
                <xf:label>
                    <![CDATA[btn5]]>
                </xf:label>
            </xf:trigger>
            <w2:inputCalendar footerDiv="false" id="inputCalendar1" style="width: 144px;height: 21px;" calendarValueType="yearMonthDate" validateOnInput="true" displayFormat="yyyy/MM/dd">
            </w2:inputCalendar>
            <w2:autoComplete id="autoComplete1" style="potision:relative;width: 148px;height: 21px;"
                search="contain" delimiter="-" displayMode="value delim label" searchTarget="both">
                <w2:choices>
                    <w2:item>
                        <w2:label><![CDATA[aaa]]></w2:label>
                        <w2:value><![CDATA[01]]></w2:value>
                    </w2:item>
                    <w2:item>
                        <w2:label><![CDATA[강동구]]></w2:label>
                        <w2:value><![CDATA[02]]></w2:value>
                    </w2:item>
                    <w2:item>
                        <w2:label><![CDATA[K-CASH]]></w2:label>
                        <w2:value><![CDATA[03]]></w2:value>
                    </w2:item>
                </w2:choices>
            </w2:autoComplete>

            <xf:input style="width: 144px;height: 21px;" id="input4" maxByteLength="8"></xf:input>
            <xf:trigger style="width:99px;height:31px;" id="trigger6" type="button">
                <xf:label>
                    <![CDATA[btn6]]>
                </xf:label>
            </xf:trigger>
        </xf:group>
    </body>
</html>
