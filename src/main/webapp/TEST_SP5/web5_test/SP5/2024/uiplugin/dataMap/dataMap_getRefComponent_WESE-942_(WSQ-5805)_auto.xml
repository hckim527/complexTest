<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_vertical_guides="" meta_horizontal_guides="">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[3]]></col2>
            				<col3><![CDATA[5]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[2]]></col1>
            				<col2><![CDATA[4]]></col2>
            				<col3><![CDATA[6]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
            		<w2:columnInfo></w2:columnInfo>
            	</w2:dataList>
            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
            			<w2:key id="key2" name="name2" dataType="text"></w2:key>
            			<w2:key id="key3" name="name3" dataType="text"></w2:key>
            		</w2:keyInfo>
            		<w2:data use="true">
            			<key1><![CDATA[1]]></key1>
            			<key2><![CDATA[2]]></key2>
            			<key3><![CDATA[3]]></key3>
            		</w2:data>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {

};

scwin.trigger1_onclick = function(e) {
    var info = dataMap1.getInfo();
    console.log("Map_info : ", info);

    // mf id로 객체를 가져와 정보 불러오기
    var refCompHash = mf_dataMap1.refCompHash;
    console.log("dataMap_Components: ", refCompHash);
	var refArray = dataMap1.getRefComponent();
    
    // 전역변수에 데이터 맵 정보 추가
    window.refArr = refArray;
	console.log("refArray: ", refArray);
};

scwin.checkVal = function() {
    // 정의되어 있으면 true
    return typeof window.refArr !== 'undefined';
};

scwin.unitTest = function() {
	//Unit 
	WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
	//Run test and stop
	WebSquare.wUnit.run();
	WebSquare.wUnit.stop();
};

scwin.unitTest();]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:input id="input1" style="width:151px;height:21px;margin-bottom: 20px;" ref="data:dataMap1.key1"></xf:input>
    	<xf:select1 id="select1" chooseOption="false" style="width:155px;height:27px;display:block;margin-bottom:20px;" submenuSize="auto"
    		allOption="false" disabled="false" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled"
    		ref="data:dataMap1.key2">
    	</xf:select1>
    	<w2:textbox id="text1" label="" style="width:157px;height:32px;margin-bottom:0px;" ref="data:dataMap1.key3"></w2:textbox>
    	<xf:trigger type="button" id="trigger1" style="width:162px;height:51px;margin:100px 0;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[datamap]]></xf:label>
    	</xf:trigger>
    </body>
</html>
