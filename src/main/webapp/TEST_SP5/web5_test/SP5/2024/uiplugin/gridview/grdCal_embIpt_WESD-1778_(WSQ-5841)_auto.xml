        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};

scwin.checkVal = function() {
    let selectElement = WebSquare.wUnit.getDomById('mf_mf_wq_uuid_5_cell_0_2_calendar_calendar_selectbox_year');
    let options = selectElement.options;

    // '9999년'이 있는지 확인합니다.
    let hasYear9999 = false;
    for (let i = 0; i < options.length; i++) {
        if (options[i].value.trim() === '9999') {
            
            hasYear9999 = true;
            break;
        }
    }
    
    return hasYear9999;
};

scwin.unitTest = function () {
    //Unit 
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('mf_wq_uuid_5_cell_0_2_calendar_img').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");

    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
};

scwin.unitTest();]]></script>
