		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var rowCnt = dlt_commonCode.getRowCount();
	console.log('rowCnt :'+rowCnt);
	var bgColor = "#ffffff";
	//debugger;
	for(var i=0; i<rowCnt; i++) {
		if(i==0){
			// 스타일을 공백으로 만들었을 경우 에러 발생
			grd_commonGrp.setRowBackgroundColor(i, "");
			continue;
		}
		if(i%5 == 0) {
			if(bgColor=="#ffffff"){
				bgColor = "#DBEDFF";
			} else {
				bgColor = "#ffffff";
			}
		}
		console.log(((i<10)?"0":"")+i+'\'s bgColor:'+bgColor);
		grd_commonGrp.setRowBackgroundColor(i, bgColor);
	}
};

scwin.btn_excelGrp_onclick = function (e) {
	var options = {
		type: "1"
		, fileName:"test.xlsx"
		, useStyle:true
	};

	grd_commonGrp.advancedExcelDownload(options);
};

	scwin.checkVal = function() {
		return WebSquare.wUnit.getDomById('___processbar2_i').style.display == 'none';
	}		
	scwin.unitTest = function() {
		//init
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_excelGrp').click()");
		WebSquare.wUnit.addCommand("pause", "1000");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
		WebSquare.wUnit.addCommand("pause", "400");		
		//Run  and stop
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest(); 
]]></script>
