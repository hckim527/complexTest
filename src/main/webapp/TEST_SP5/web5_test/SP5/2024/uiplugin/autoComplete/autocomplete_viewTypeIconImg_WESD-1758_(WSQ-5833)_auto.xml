scwin.onpageload = function() {
	const totalCount = 4;

                var nameData = [
                    {"name" : "A",},
                    {"name" : "B",},
                    {"name" : "C",},
                    {"name" : "D",}
                ]
                categoryData.setJSON(nameData);
                gridViewData1.setJSON(nameData);

                var selectBoxObj = [
                    {"category":"A","value":"A1","label":"A1"},
                    {"category":"A","value":"A2","label":"A2"},
                    {"category":"A","value":"A2","label":"A3"},
                    {"category":"A","value":"A2","label":"A4"},
                ];
                category1.setJSON(selectBoxObj);
                
                selectBoxObj = [
                    {"category":"B","value":"B1","label":"B1"},
                    {"category":"B","value":"B2","label":"B2"},
                    {"category":"B","value":"B2","label":"B3"},
                    {"category":"B","value":"B2","label":"B4"}
                ];
                category2.setJSON(selectBoxObj);
                
                selectBoxObj = [
                    {"category":"C","value":"C1","label":"C1"},
                    {"category":"C","value":"C2","label":"C2"},
                    {"category":"C","value":"C2","label":"C3"},
                    {"category":"C","value":"C2","label":"C4"}
                ];
                category3.setJSON(selectBoxObj);
                
                selectBoxObj = [
                    {"category":"D","value":"D1","label":"D1"},
                    {"category":"D","value":"D2","label":"D2"},
                    {"category":"D","value":"D2","label":"D3"},
                    {"category":"D","value":"D2","label":"D4"}
                ];
                category4.setJSON(selectBoxObj);

                // row가 동적으로 생성되면 직접 insert
                // for (let row = 0; row < totalCount; row++){
                //     gridViewData1.insertRow();
                // }

                scwin.gridView1_select_ref();
};

scwin.gridView1_select_ref = function() {
                let count = gridView1.getTotalRow();

                for(let i = 0; i < count; i++){
                    var categoryDatas = `data:category${i+1}`;
                    var cellObj = {};
                    cellObj = {
                            inputType : "autoComplete",
                            options : {
                                viewType : "icon" ,
                                viewTypeIconImage : true,
                                chooseOption: true,
                                chooseOptionLabel : "선택"
                            },
                            itemSet : {
                                nodeset : categoryDatas,
                                label : "label",
                                value : "value"
                            
                    }}
                    gridView1.setCellInputType(i, "col1", cellObj);
                }
            }

scwin.checkVal = function () {
    const myElement = WebSquare.wUnit.getDomById('gridView1_cell_0_1');
    return scwin.isElementFocused(myElement);
};

// 특정 요소가 포커스를 가지고 있는지 확인하는 함수
scwin.isElementFocused = function (element) {
    return document.activeElement === element;
}
            
scwin.unitTest = function () {
    //Unit 
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_0_1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");

    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
};

scwin.unitTest();]]></script>
