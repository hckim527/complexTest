scwin.checkVal = function() {
    let scrlHeight = WebSquare.wUnit.getDomById('wq_uuid_1_scrollY_div');
    scrlHeight = scrlHeight.scrollHeight;

    // 스크롤이 추가로 더 생기면 540
    return scrlHeight === 510;
};

scwin.unitTest = function () {
    //Unit 
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "document.getElementsByClassName('treeview_icon_navi treeview_icon_open')[3].click()");
