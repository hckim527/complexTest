    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "document.getElementsByClassName('treeview_icon_navi treeview_icon_open')[2].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "document.getElementsByClassName('treeview_icon_navi treeview_icon_open')[2].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('wq_uuid_1_scrollY_div').scrollTop += 210");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");

    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
};

