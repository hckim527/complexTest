<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[a]]></col1>
            				<col2><![CDATA[aa]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[b]]></col1>
            				<col2><![CDATA[bb]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[c]]></col1>
            				<col2><![CDATA[cc]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[d]]></col1>
            				<col2><![CDATA[dd]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            		</w2:data>
            	</w2:dataList>
				<w2:dataList baseNode="list" id="dlt_location" repeatNode="map" saveRemovedData="true" style="">
					<w2:columnInfo>
						<w2:column dataType="text" id="COMCOD" name="name1"></w2:column>
						<w2:column dataType="text" id="COMNAM" name="name2"></w2:column>
						<w2:column dataType="text" id="VISIBLE" name="name3"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<COMCOD><![CDATA[KRPUS]]></COMCOD>
							<COMNAM><![CDATA[BUSAN, KOREA]]></COMNAM>
							<VISIBLE><![CDATA[true]]></VISIBLE>
						</w2:row>
						<w2:row>
							<COMCOD><![CDATA[KRCHO]]></COMCOD>
							<COMNAM><![CDATA[CHEONAN, KOREA]]></COMNAM>
							<VISIBLE><![CDATA[false]]></VISIBLE>
						</w2:row>
						<w2:row>
							<COMCOD><![CDATA[KRKAN]]></COMCOD>
							<COMNAM><![CDATA[GWANGYANG, KOREA]]></COMNAM>
							<VISIBLE><![CDATA[false]]></VISIBLE>
						</w2:row>
						<w2:row>
							<COMCOD><![CDATA[KRINC]]></COMCOD>
							<COMNAM><![CDATA[INCHEON, KOREA]]></COMNAM>
							<VISIBLE><![CDATA[true]]></VISIBLE>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dma_master">
					<w2:keyInfo>
						<w2:key id="location" name="name1" dataType="text"></w2:key>
						<w2:key id="terminal" name="name2" dataType="text"></w2:key>
						<w2:key id="description" name="name3" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
				<w2:dataMap baseNode="map" id="dataMap1" ev:onmodelchange="scwin.dataMap1_onmodelchange"
    				ev:onbeforemodelchange="scwin.dataMap1_onbeforemodelchange">
    				<w2:keyInfo>
    					<w2:key id="CODE_AC" name="name1" dataType="text"></w2:key>
    					<w2:key id="CNT" name="name2" dataType="text"></w2:key>
    					<w2:key id="CODE_S" name="name3" dataType="text"></w2:key>
    				</w2:keyInfo>
    				<w2:data use="false">
    					<ASDF><![CDATA[ ]]></ASDF>
    				</w2:data>
    			</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <style>
            .test_class {
                background : none !important;
                background-color : #00ccff !important;
            }
        </style>
        <script type="text/javascript" lazy="false"><![CDATA[
        
        	scwin.onpageload = function() {
			for(var i=0; i<dlt_location.getRowCount(); i++){
			var location = dlt_location.getCellData(i, "COMCOD");

			if(location == "KRPUS" || location == "KRINC"){
				dlt_location.setCellData(i, "VISIBLE", "true");
			} else {
				dlt_location.setCellData(i, "VISIBLE", "false");
			}
		}
		

        		dma_master.set("location", "KRCHO");
		dma_master.set("terminal", "test");
		dma_master.set("description", "test desc");
        	};
        	
        	scwin.onpageunload = function() {
        		
        	};

			// setTopRowIndex 
        	scwin.trigger3_onclick = function(e) {debugger;
        		gridView1.setTopRowIndex(3, false, true);
        	};
        	// setScrollTop
        	scwin.trigger4_onclick = function(e) {
        		gridView1.setScrollTop(30);
        	};
        	// setImageSrc
        	scwin.trigger5_onclick = function(e) {
        		gridView1.setImageSrc(0, "expand.gif");
        	};
        	// setHeaderBackgroundColor 
        	scwin.trigger6_onclick = function(e) {
        		gridView1.setHeaderBackgroundColor('column1', 'red');
        	};
			
	scwin.checkVal1 = function() {
		return WebSquare.wUnit.getDomById('gridView1_cell_0_0').classList.contains('focusedTd');
	}
	scwin.checkVal2 = function() {
		return WebSquare.wUnit.getDomById('gridView1_cell_0_0').previousElementSibling.previousElementSibling.innerText == 4;
	}
	scwin.unitTest = function() {
		//Init test
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click()");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "400");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");		
		//Run and Stop unit Test
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();			

]]>
        </script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="data:dataList2" summaryAuto="false" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" id="gridView1" style="position: absolute;width:407px;height:150px;display:block;" ignoreCellClick="false"
    		syncScroll="false" ignoreToggleOnDisabled="false" summaryOnlyAuto="false" useShiftKey="true" rowStatusVisible="true" rowNumVisible="true" focusMode="cell"
    		ev:onheaderclick="scwin.headerClick">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="name2" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" width="70" inputType="textImage" value="" displayMode="label"
    					imageSrc="icon01.gif" imageWidth="20" imageHeight="20" viewType="icon">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" style="" width="70" inputType="autoComplete" value="" displayMode="label"
    					allOption="" chooseOption=""  ref="data:dma_master.location">
    					<xf:choices>
							<xf:itemset nodeset="data:dlt_location">
								<xf:label ref="COMNAM"></xf:label>
								<xf:value ref="COMCOD"></xf:value>
							</xf:itemset>
						</xf:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:group style="position:absolute; top:200px;left:0; ">
			<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3" style="position:absolute;width:292px;height:23px;left:211px;top:60px;"
				type="button">
				<xf:label><![CDATA[setTopRowIndex(3)]]></xf:label>
			</xf:trigger>
			<xf:trigger ev:onclick="scwin.trigger4_onclick" id="trigger4" style="position:absolute;width:292px;height:23px;left:211px;top:91px;"
				type="button">
				<xf:label><![CDATA[setScrollTop(30)]]></xf:label>
			</xf:trigger>
			<xf:trigger ev:onclick="scwin.trigger5_onclick" id="trigger5"
				style="position:absolute;width:292px;height:23px;left:211px;top:123px;" type="button">
				<xf:label><![CDATA[setImageSrc(0, expand.gif)]]></xf:label>
			</xf:trigger>
			<xf:trigger ev:onclick="scwin.trigger6_onclick" id="trigger6"
				style="position:absolute;width:292px;height:23px;left:211px;top:155px;" type="button">
				<xf:label><![CDATA[setHeaderBackgroundColor(column1, red)]]></xf:label>
			</xf:trigger>
		</xf:group>
    </body>
</html>
