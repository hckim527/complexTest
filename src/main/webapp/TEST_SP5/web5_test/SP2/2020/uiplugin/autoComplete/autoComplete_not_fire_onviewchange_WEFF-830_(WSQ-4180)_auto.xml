scwin.gridView1_onviewchange = function(info) {
    debugger;
    $p.log("scwin.gridView1_onviewchange===[" + info.rowIndex + "][" + info.colIndex + "][" + info.oldValue + "][" + info.newValue + "]");
};
scwin.dataList1_oncelldatachange = function(info) {
    $p.log("scwin.dataList1_oncelldatachange===[" + info.rowIndex + "][" + info.colID + "][" + info.oldValue + "][" + info.newValue + "]");
};
scwin.getErrorLog = function() {
    var temp = WebSquare.logger.getLog();
    return temp.indexOf('gridView1_onviewchange') != -1;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_cell_0_2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('G_gridView1___autoComplete_0_col3_col3_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('G_gridView1___autoComplete_0_col3_col3_gridViewItemTable_gridView_cell_0_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.getErrorLog()", "true");
    WebSquare.wUnit.addCommand('pause', '500');
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
