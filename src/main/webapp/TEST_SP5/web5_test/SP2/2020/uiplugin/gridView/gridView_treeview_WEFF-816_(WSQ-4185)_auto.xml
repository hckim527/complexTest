scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#gridView1_cell_5_1', 'drag-n-drop', {
        dx: 0,
        dy: 300
    });
}
scwin.setSimulate2 = function() {
    scwin.simulateWrapper('#treeview1_label_3', 'drag-n-drop', {
        dx: 0,
        dy: -100
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 1. 샘플파일을 실행 후 상단의 그리드(options.closeGroup = false; 일경우)와 하단의 그리드(options.closeGroup = true; 일경우) 대리점항목명을 마우스로 드래그하여 위로 끌어다 놓는다. 
    //1. Run the sample file and drag it to the top grid (if options.closeGroup = false;) and the bottom grid (if options.closeGroup = true;
    //Verify step 1. The upper grid and the lower grid are grouped by the agency name and the time (duration 370 ms) is shown.
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate2()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log1') == $p.id+'treeview1 ondropfromgrid event'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log2') == $p.id+'gridView1 ondropfromtree event'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    localStorage.removeItem("log1");
    localStorage.removeItem("log2");
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
