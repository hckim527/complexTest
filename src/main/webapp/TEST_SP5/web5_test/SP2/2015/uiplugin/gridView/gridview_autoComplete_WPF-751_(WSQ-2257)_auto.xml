        <script type="text/javascript" lazy="false"><![CDATA[
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#wq_uuid_3_cell_0_0', 'key-combo', {
        combo: 'TAB'
    });
}
scwin.setSimulate2 = function() {
    scwin.simulateWrapper('#wq_uuid_3_cell_1_0', 'key-combo', {
        combo: 'ENTER'
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 1. gridview_autoComplete_WPF-751_(WSQ-2257).xml 실행한다.
    //1. Run gridview_autoComplete_WPF-751_ (WSQ-2257) .xml.
    //Verify step 1. gridview_autoComplete_WPF-751_(WSQ-2257).xml 실행된다.
    //1. gridview_autoComplete_WPF-751_ (WSQ-2257) .xml is executed.
    //Test step 2. 첫번째 컬럼을 마우스로 클릭 후 tab, enterkey클릭 이동한다.
    //2. Click on the first column with the mouse, then click tab and enterkey.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_3_cell_0_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate2()");
    //Verify step 2. edit모드로 이동되면서 3번째 컬럼인 autoComplete컬럼에서도 동일하게 동작되어진다.(이전에는 edit모드로 동작되지 않음)
    //2. It goes to edit mode and works the same way in the third column, autoComplete column (it did not work in edit mode before)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('.w2autoComplete_table_main').length > 0", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#G_wq_uuid_3___autoComplete_0_col3_col3_input').css('display')", "block");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload = function() {
