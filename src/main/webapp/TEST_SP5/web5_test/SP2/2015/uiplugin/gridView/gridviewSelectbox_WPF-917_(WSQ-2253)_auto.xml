        <script type="text/javascript" lazy="false"><![CDATA[
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#wq_uuid_3_cell_0_0', 'key-combo', {
        combo: 'TAB'
    });
}
scwin.setSimulate2 = function() {
    scwin.simulateWrapper('#G_wq_uuid_3___selectbox_col2_itemTable', 'key-combo', {
        combo: 'TAB'
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 2. keyMoveEditMode='true' 의 그리드뷰 첫번째 컬럼에 마우스를 클릭후 탭으로 2번 이동한다.
    //2. Click the mouse on the first column of keyMoveEditMode = 'true' grid view and move to tab twice.
    //Verify step 2. 2번째 컬럼으로 이동 시 콤보박스가 보여지고 3번째 컬럼 이동시 콤보박스가 보여지지 않는다.
    //2. When moving to the second column, the combo box is displayed and the combo box is not displayed when moving the third column
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_3_cell_0_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#G_wq_uuid_3___selectbox_col2_itemTable').css('display')", "block");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate2()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#G_wq_uuid_3___selectbox_col3_itemTable').css('display') == undefined", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.dataArr = [];
    for (var i = 0; i < 90; i++) {
        dataArr.push(1);
    }
    dataList1.setData(dataArr);
    //Function 
    //Created by: Quan.Nguyen
    //Created date: 09-Mar-2018
    window.comboBoxIsShowed = false;
    window.comboBoxIsHidden = false;
    //end
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
