scwin.__checkCountName = function() {
    var el = WebSquare.wUnit.getJq("#wq_uuid_3_body_tbody tr").not(".w2grid_hidedRow").find('*[col_id="NAME"]');
    return el.length;
}
scwin.checkVal = function() {
    return WebSquare.wUnit.getDomById('wq_uuid_3_column14').innerText == '5';
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");	
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
