scwin.unitTest = function() {
    // debugger;
    // Init test
    WebSquare.wUnit.start();
    // Test step 1: 1. Sorce 탭에서 linkedDataList filter 조건을 val("selectbox1") == col("col") 인지 확인한다.
    // 1. In the Sorce tab, verify that the linkedDataList filter condition is val ("selectbox1") == col ("col").
    // Verify 1: 1. val("selectbox1") == col("col")
    // 1. val ("selectbox1") == col ("col")
    WebSquare.wUnit.addCommand("pause", "1000");
    // Test step 2: 2. datalist1 를 편집한다. - 2. Edit datalist1.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('dataList1').setCellData(0,1,'abc')");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('dataList1').setCellData(1,1,'def')");
    // Verify 2: 2. 가운데 오작동부분에 데이터가 갱신된다. - 2. Data is updated in the middle malfunction part.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('linkedDataList1').getCellData(0,1)", "abc");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('linkedDataList1').getCellData(1,1)", "def");
    WebSquare.wUnit.addCommand("pause", "1000");
    // Test step 3: 3. 좌측에 datalist1 1 을 2 로 변경한다. (1 -> 2) - 3. Change datalist1 1 to 2 on the left. (1 -> 2)
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('selectbox1').setText('2')");
    // Verify 3: 3. select 값에 맞춰서 우측에 있는 linkedLit 가 변경된다. - 3. The linkedLit on the right changes to match the select value.
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("pause", "1000");
    // Test step 4: 4. datalist2 를 편집한다. - 4. Edit datalist2.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('dataList2').setCellData(0,1,'ghi')");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('dataList2').setCellData(1,1,'klm')");
    // Verify 4: 4. 가운데 오작동부분에 데이터가 갱신된다. - 4. The data is updated in the middle malfunction part.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('linkedDataList2').getCellData(0,1)", "ghi");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('linkedDataList2').getCellData(1,1)", "klm");
    WebSquare.wUnit.addCommand("pause", "1000");
    // Test step 5: 5. 좌측에 datalist2 1A 를 2A 로 변경한다. (1A -> 2A) - 5. Change datalist2 1A to 2A on the left. (1A -> 2A)
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('selectbox2').setText('2A')");
    // Verify 5: 5. select 값에 맞춰서 우측에 있는 linkedLit 가 변경된다. - 5. The linkedLit on the right is changed to match the select value.
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "1000");
    // Run test
    WebSquare.wUnit.run();
    // Stop test
    WebSquare.wUnit.stop();
}
