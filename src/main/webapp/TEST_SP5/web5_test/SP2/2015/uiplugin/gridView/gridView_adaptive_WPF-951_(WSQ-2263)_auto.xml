<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="id" name="id" dataType="text"></w2:column>
            			<w2:column id="test" name="test" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<id><![CDATA[1]]></id>
            				<test><![CDATA[test]]></test>
            			</w2:row>
            			<w2:row>
            				<id><![CDATA[2]]></id>
            				<test><![CDATA[test]]></test>
            			</w2:row>
            			<w2:row>
            				<id><![CDATA[3]]></id>
            				<test><![CDATA[test]]></test>
            			</w2:row>
            			<w2:row>
            				<id><![CDATA[4]]></id>
            				<test><![CDATA[test]]></test>
            			</w2:row>
            			<w2:row>
            				<id><![CDATA[5]]></id>
            				<test><![CDATA[test]]></test>
            			</w2:row>
            			<w2:row>
            				<id><![CDATA[6]]></id>
            				<test><![CDATA[test]]></test>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    grid1.doAdaptive();
};
scwin.trigger2_onclick = function(e) {
    grid1.undoAdaptive();
};
scwin.unitTest = function() {
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "50");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('grid1').getAttribute('adaptive')", "crosstab");
    WebSquare.wUnit.addCommand("pause", "50");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" id="grid1" style="position: relative;width: 500px;height: 150px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false" fixedColumnWithHidden="true" useShiftKey="true" adaptive="">
    		<w2:header id="header1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column7" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="id">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px" width="70" inputType="text" displayMode="label"
    					value="test">
    				</w2:column>
    				<w2:column blockSelect="false" id="column17" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column15" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column13" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column11" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column9" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column6" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column4" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody4" style="">
    			<w2:row id="row5" style="">
    				<w2:column blockSelect="false" id="id" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="test" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column18" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column16" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column14" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column12" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column10" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column8" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column5" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[crossTab]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2" style="position: relative;width: 120px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[undoCrossTab]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 