        <script type="text/javascript" lazy="false"><![CDATA[
scwin.treeview1_ontoggleclick = function(nodeElement, index, isRendered) {
    log = treeview1.isOpen(index);
    //alert();
};
scwin.checkVal1 = function() {
    return log == false;
}
scwin.checkVal2 = function() {
    return log == true;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. treeview_ontoggle_WPF-965_(WSQ-2254).xml 실행한다.
    //1. Execute treeview_ontoggle_WPF-965_ (WSQ-2254) .xml.
    //Test step 2. 조회된 tree메뉴를 접는다.
    //2. Collapse the query tree menu.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getJq('#treeview1_col_icon_navi_1 div').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 2. false alert창이 보여지고 접혀진다.
    //2. The false alert window is displayed and collapsed.
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 3. 조회된 tree메뉴를 펼친다.
    //3. Expand the displayed tree menu.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getJq('#treeview1_col_icon_navi_1 div').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 3. true alert창이 보여지고 펼쳐진다.
    //3. The true alert window is displayed and unfolded.
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.log = undefined;
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 07-Feb-2018
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
