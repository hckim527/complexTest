        <script type="text/javascript" lazy="false"><![CDATA[
scwin.checkTop = function() {
    if (WebSquare.wUnit.getJq("#wq_uuid_6_customFilter").position().top > WebSquare.wUnit.getJq("#wq_uuid_5").position().top) {
        return true;
    }
    return false;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 브라우저에서 useFiler 로 설정된 컬럼을 선택한다.
    // In the browser, select the column set to useFiler.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_6_column3_filter').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1. 사용자 지정 필터 창이 생성된다.
    //A custom filter window is created.
    WebSquare.wUnit.addCommand("assert", "scwin.checkTop()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#wq_uuid_6_customFilter').css('display') == 'block'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 29-Jan-2018
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
