<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map"></w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    upload1.submit();
};
scwin.trigger2_onclick = function(e) {
    upload2.submit();
};
scwin.checkVal = function() {
    return upload1.dom.fakeinput.onchange == null;
}
scwin.unitTest = function() {
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "false");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    	<style type="text/css"><![CDATA[
    	
    	#upload1 .w2upload_input  {
    		width: 228px;
    		height: 23px;
    	}
		
		#upload1 .w2upload_image  {
    		left:232px;
    	}    	
    	
    	#upload1 .w2upload_fakeInput{
    		width: 18px;
    	
    	}
    	
    	
    	 
    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:upload inputStyle="position:absolute;vertical-align:middle;word-wrap:break-word" type="" id="upload1"
    		style="position: absolute ;left:9px;top:50px;" imageStyle="position:absolute;vertical-align:middle;word-wrap:break-word" disabled=""
    		ev:ondone="scwin.upload1_ondone" ev:onInputValueChange="scwin.upload1_onInputValueChange">
    	</w2:upload>
    	<w2:upload inputStyle="position:absolute;vertical-align:middle;word-wrap:break-word" type="" id="upload2"
    		style="position: absolute ;left:8px;top:156px;width: 250px;height: 23px;"
    		imageStyle="position:absolute;vertical-align:middle;word-wrap:break-word" disabled=""
    		ev:onInputValueChange="scwin.upload1_onInputValueChange">
    	</w2:upload>
    	<w2:textbox label="2. 정상동작 upload" id="textbox1" style="position: relative ;left:10px;top:125px;width:222px;height:23px;">
    	</w2:textbox>
    	<w2:textbox id="textbox2" label="1. style속성에서 width, height 제거한 upload =&gt; ie8에서 onInputValueChange 미발생!"
    		style="position: relative ;left:7px;top:-7px;width:548px;height:23px;">
    	</w2:textbox>
    	<xf:trigger type="button" id="trigger1" style="position: relative ;left:282px;top:10px;width:65px;height:23px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[submit]]></xf:label>
    	</xf:trigger>
    	<xf:trigger id="trigger2" style="position: relative ;left:213px;top:111px;width:65px;height:23px;" type="button"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[submit]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 