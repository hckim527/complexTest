<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
    				<w2:columnInfo>
    					<w2:column id="col1" name="name1" dataType="text"></w2:column>
    					<w2:column id="col2" name="name2" dataType="text"></w2:column>
    					<w2:column id="col3" name="name3" dataType="text"></w2:column>
    					<w2:column id="col4" name="name4" dataType="text"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.test = function() {}
scwin.test = function() {}
scwin.trigger1_onclick = function(e) {
    var options = {};
    options.fileName = "테스트.xlsx";
    options.type = "1";
    options.rowNumVisible = true;
    options.rowStatusVisible = true;
    options.processMsg = "엑셀 다운로드 중..";
    options.showProcess = true;
    //options.dataProvider = "com.provider.Provider1";
    options.useFooter = true;
    options.useSubTotal = true;
    gridView1.advancedExcelDownload(options);
};
scwin.__styleIsBold = function() {
    var style = WebSquare.wUnit.getJq("#gridView1_column12").css("font-weight");
    return style == "700";
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 샘플파일을 실행하여 gridview footer의 3번째 컬럼의 글자('2') 크기를 확인한다.
    //1. Run the sample file to check the size of the third column ('2') of the gridview footer.
    // verify step 2. gridview footer의 3번째 컬럼의 글자('2')가 굵게 표기된다.(이전에는 굵게표기되지 않음)
    //2. The letter ('2') in the third column of the gridview footer is shown in bold (not previously shown in bold).
    WebSquare.wUnit.addCommand("assert", "scwin.__styleIsBold()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.test = function() {
        window.sum = 0;
        for (var ix = 0; ix < dataList1.getRowCount(); ix++) {
            if (ix % 2 == 1) {
                sum += dataList1.getCellData(ix, 1);
            }
        }
        return sum;
    }
    dataList1.setData([1, 2, 3, 4,
        1, 2, 3, 4,
        5, 6, 7, 8
    ]);
    //Function unitTest
    //Created By: Sang.do
    //Created By: 07-Feb-2018
    //end unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    	<style type="text/css"><![CDATA[
.fc {font-weight: bold;}
    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1" rowStatusVisible=""
    		style="position: relative ;left:24px;top:15px;width:390px;height:245px;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column16" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column13" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column10" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name3">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px" width="70" inputType="text" displayMode="label"
    					value="name4">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody4" style="">
    			<w2:row id="row5" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" inputType="text" width="70" displayMode="label" class="fc"></w2:column>
    				<w2:column blockSelect="false" id="col4" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    		 
    		<w2:subTotal id="subTotal1" style="" targetColumnID="col1">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column7" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column6" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column5" style="height:20px" width="70" inputType="expression" expression="scwin.test()"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column4" style="height:20px" width="70" inputType="expression" displayMode="label"
    					expression="sum('col4')">
    				</w2:column>
    			</w2:row>
    		</w2:subTotal>
    		 
    		<w2:footer id="footer7" style="" class="">
    			<w2:row id="row8" style="">
    				<w2:column blockSelect="false" id="column18" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column15" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column12" style="height:20px;" inputType="expression" expression="scwin.test()" width="70"
    					displayMode="label" columnClass="fc">
    				</w2:column>
    				<w2:column blockSelect="false" id="column9" style="height:20px" width="70" inputType="expression" displayMode="label"
    					expression="sum('col4');">
    				</w2:column>
    			</w2:row>
    		</w2:footer>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="position: relative ;left:424px;top:-227px;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[xls down ]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 