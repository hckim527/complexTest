        <script type="text/javascript" lazy="false"><![CDATA[
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.__triggerDbclick = function(id) {
    var el = WebSquare.wUnit.getDomById(id);
    var dataEditmodeevent = WebSquare.util.getDataPrefix("editmodeevent");
    var editMode = el.getAttribute(dataEditmodeevent)
    if (editMode == "onclick") {
        el.click();
        return;
    }
    scwin.fireDbClick(el);
}
scwin.__isChanged = function() {
    return WebSquare.wUnit.getDomById($p.id+'gridView1_cell_0_1').innerText != old;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 샘플파일을 실행 후 항목명(autoCom_valueLabel)의 값을 더블클릭하여 다른값으로 변경한다.
    //1. Run the sample file and double-click the value of the item name (autoCom_valueLabel) to change it to another value.
    WebSquare.wUnit.addCommand("set", "scwin.__triggerDbclick($p.id+'gridView1_cell_0_1')");
    WebSquare.wUnit.addCommand("pause", "1000");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('G_' + $p.id + 'gridView1___autoComplete_0_col2_col2_button').click()");
    WebSquare.wUnit.addCommand("pause", "1000");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('G_' + $p.id + 'gridView1___autoComplete_0_col2_col2_itemTable_1').click()");
    WebSquare.wUnit.addCommand("pause", "1000");
    // verify step 1. 선택값으로 값이 변경된다.(이전에는 변경되지 않음)
    //1. The value is changed to the selected value (not changed previously)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_0_1').innerText == '2 이동건'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
scwin.onpageload = function() {
    window.old = WebSquare.wUnit.getDomById($p.id+'gridView1_cell_0_1').innerText;
}
]]></script>
