<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<style type="text/css"><![CDATA[
            .w2accordion {
                overflow: auto;
                border : 0px !important;
            }
            
            .w2panels {
                position: relative;
                border: 1px solid #ffffff;
            }
            
            .w2panels_content_closed {
                display: none;
            }
            
            .w2panels_content_open {
                position: relative;
                display: block;
                overflow: auto;
            }
            
            .w2panels_title {
                position: relative;
                height: 25px;
                cursor: pointer;
                background: #ff6d00;
            }
            
            .w2panels_title_over {
                background: #0000ff;
                // 전체 panels에 mouse over시 색상
            }
        ]]></style>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.panels1_panelsOpen = function(e) {
    console.log("panels1_open");
}
scwin.panels1_mouseover = function(e) {
    console.log("panels1_over");
}
scwin.panels1_mouseout = function(e) {
    console.log("panels1_out");
}
scwin.panels2_panelsOpen = function(e) {
    console.log("panels1_open");
}
scwin.panels2_mouseover = function(e) {
    console.log("panels1_over");
}
scwin.panels2_mouseout = function(e) {
    console.log("panels1_out");
}
scwin.panels3_panelsOpen = function(e) {
    console.log("panels3_open");
}
scwin.panels3_mouseover = function(e) {
    console.log("panels3_over");
}
scwin.panels3_mouseout = function(e) {
    console.log("panels3_out");
}
scwin.trigger1_onclick = function(e) {
    accordion1.closePanel("panel1");
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "800");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#accordion1_panel_panel1_panelContent_content1').css('display') == 'none'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
scwin.onpageload = function() {
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="padding:30px;">
