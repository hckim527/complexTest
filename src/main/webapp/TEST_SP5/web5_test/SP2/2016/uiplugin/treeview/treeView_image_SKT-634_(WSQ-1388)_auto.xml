scwin.checkImageDisplayed = function() {
    var img = WebSquare.wUnit.getJq("#treeview1_icon_5").css("background-image");
    return img.lastIndexOf("/WS5/lib/images/arrow.png") != -1;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 2. 브라우저에서 상대경로로 설정된 img 부분을 확인한다.
    //2. In your browser, check the img part set to relative path.
    //Verify 2. 정상적으로 이미지가 표시된다.
    //2. The image is displayed normally.
    WebSquare.wUnit.addCommand("assert", "scwin.checkImageDisplayed()", "true");
    WebSquare.wUnit.addCommand("pause", "2000");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
