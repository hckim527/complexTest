scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.checkVal = function() {
    return log == 0;
}
scwin.setVal = function() {
    scwin.simulateWrapper('#wq_uuid_5_cell_0_1', 'drag-n-drop', {
        dx: 160,
        dy: 0
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 1. 브라우저에서 상단에 그리드의 컬럼을 하단에 그리드에 드래그&드랍한다.
    //1. In the browser, drag and drop the grid"s column at the top onto the grid at the bottom.
    //Verify step 1. The index value of the dragged and dropped column is popped up.
    WebSquare.wUnit.addCommand("set", "scwin.setVal()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
