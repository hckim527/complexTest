<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    checkbox1.checkAll(true);
};
scwin.trigger2_onclick = function(e) {
    checkbox1.checkAll(false);
};
scwin.checkVal = function() {
    return WebSquare.wUnit.getDomById($p.id + 'checkbox1_itemTable_0_checkbox').checked == false;
}
scwin.unitTest = function() {
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click();");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click();");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.trigger3_onclick = function(e) {
    WebSquare.wUnit.getDomById('trigger1').click();
    checkbox1.openSubLayer();
    WebSquare.wUnit.getDomById('trigger2').click();
    checkbox1.openSubLayer();
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:checkcombobox appearance="minimal" direction="auto" chooseOption="" id="checkbox1"
    		style="position: absolute ;left: 51px;top: 38px;width: 230px;height: 43px;" displayMode="label" displayAllOptionLabel="false"
    		allOption="true" submenuSize="auto" disabled="false">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[1]]></xf:label>
    				<xf:value><![CDATA[1]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[2]]></xf:label>
    				<xf:value><![CDATA[2]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[3]]></xf:label>
    				<xf:value><![CDATA[3]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[4]]></xf:label>
    				<xf:value><![CDATA[4]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[5]]></xf:label>
    				<xf:value><![CDATA[5]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[6]]></xf:label>
    				<xf:value><![CDATA[6]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:checkcombobox>
    	<xf:trigger type="button" id="trigger1" style="position: absolute ;left: 324px;top: 31px;width: 203px;height: 40px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[checkAll(true)]]></xf:label>
    	</xf:trigger>
    	<xf:trigger id="trigger2" style="position: absolute ;left:324px;top:88px;width: 203px;height: 40px;" type="button"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[checkAll(false)]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger3" style="position: absolute;width:206px;height:44px;left:324px;top:149px;" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[test]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 