        <script type="text/javascript" lazy="false"><![CDATA[
scwin._checkIP = function() {
    var dataColId = WebSquare.util.getDataPrefix("col_id");
    var el = WebSquare.wUnit.getJq('#gridView1_body_tbody tr').not('.w2grid_hidedRow').find("td["+dataColId+"='col2']");
    debugger;
    return el.find('.w2grid_input').length;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. Source 탭에서 style 부분을 확인한다.
    //1. Check the style section in the Source tab.
    //Test step 2. 브라우저에서 name2 컬럼들을 확인한다.
    //2. Check the name2 columns in your browser.
    //Verify 2. name1 / name3 컬럼과 다르게 입력창 블록이 표시된다.
    //2. Unlike the name1 / name3 column, the input window block is displayed.
    WebSquare.wUnit.addCommand("assert", "scwin._checkIP() == '3'", "true");
    WebSquare.wUnit.addCommand("pause", "1000");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 08-Feb-2018
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
