<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
    				<w2:columnInfo>
    					<w2:column id="col1" name="name1" dataType="text"></w2:column>
    					<w2:column id="col2" name="name2" dataType="text"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("assert", "document.getElementsByTagName('nobr')[3].style.width == 'auto'", "true");
    WebSquare.wUnit.addCommand("assert", "document.getElementsByTagName('nobr')[5].style.width == 'auto'", "true");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.jsonData = [{
            "col1": "text1",
            "col2": "a"
        },
        {
            "col1": "text2",
            "col2": "b"
        }
    ];
    dataList1.setJSON(jsonData);
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    	<style type="text/css"><![CDATA[
    	/*.gridBodyDefault_select nobr {width:auto !important}*/
    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="group1" style="height:321px;margin-bottom:10px;">
    		<w2:gridView ignoreCellClick="false" id="gridView1" dataList="dataList1" autoFit="allColumn" ignoreToggleOnDisabled="false"
    			style="position: relative;height:321px;" useShiftKey="true" scrollByColumn="false" fixedColumnWithHidden="true">
    			<w2:header id="header1" style="">
    				<w2:row id="row2" style="">
    					<w2:column id="column7" blockSelect="false" style="height:20px" width="70" inputType="text" value="name1"
    						displayMode="label">
    					</w2:column>
    					<w2:column id="column3" blockSelect="false" style="height:20px" inputType="text" width="70" value="name2"
    						displayMode="label">
    					</w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody id="gBody4" style="">
    				<w2:row id="row5" style="">
    					<w2:column id="col1" blockSelect="false" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    					<w2:column id="col2" blockSelect="false" style="height:20px" chooseOption="" inputType="select" width="70"
    						allOption="" displayMode="label" viewType="icon">
    						<w2:choices>
    							<w2:item>
    								<w2:label><![CDATA[select1]]></w2:label>
    								<w2:value><![CDATA[a]]></w2:value>
    							</w2:item>
    							<w2:item>
    								<w2:label><![CDATA[select2]]></w2:label>
    								<w2:value><![CDATA[b]]></w2:value>
    							</w2:item>
    						</w2:choices>
    					</w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    	</xf:group>
    </body>
</html>
 