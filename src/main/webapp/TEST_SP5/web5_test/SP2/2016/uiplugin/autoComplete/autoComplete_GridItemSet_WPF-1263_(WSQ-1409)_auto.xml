		<script type="text/javascript" lazy="false"><![CDATA[
scwin._checkStyle = function() {
    var el = WebSquare.wUnit.getJq('#autoComplete2_gridViewItemTable_gridView_body_tbody tr');
    var count = 0;
    for (var i = 0; i < el.length; i++) {
        if (el[i].style.display == "none") {
            count++;
        }
    }
    return count > 0;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. Source 탭에서 selectbox2 의 displayMode 를 확인한다.
    //1. In the Source tab, check the displayMode of selectbox2.
    //Verify 1. displayMode = 'label delim value'
    //Test step2. autoComplete2 의 displayMode 를 확인한다.
    //2. Check the displayMode of autoComplete2.
    //Verify 2. displayMode='label delim value'
    //Test step 3. 브라우저에서 GridItemset 에 SelectBox 와 AutoComplete를 클릭하여 itemset 리스트를 확인한다.
    //3. In the browser, click SelectBox and AutoComplete on the GridItemset to see the itemset list.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('autoComplete2_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 3. 정상적으로 itemset 리스트가 표시된다. (그전에는 표시되지 않음. / 그림참고)
    //3. The itemset list is displayed normally. (Not shown before / see figure)
    WebSquare.wUnit.addCommand("assert", "scwin._checkStyle()", "false");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 08-Feb-2018
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
