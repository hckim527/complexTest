scwin.getPopupID = function() {
    var w2xPath = WebSquare.net.getParameter("w2xPath");
    var tmp = w2xPath.split("/");
    var tmp2 = tmp.reverse();
    var filename = tmp2[0];
    filename = filename.split(".")[0]; // 확장자 제거
    return "Pop_" + filename;
}
scwin.showFloatingLayer = function(title, width, height, url, modal, usePost, postData) {
    parent.scwin.showFloatingLayer(title, width, height, url, modal, usePost, postData);
}
