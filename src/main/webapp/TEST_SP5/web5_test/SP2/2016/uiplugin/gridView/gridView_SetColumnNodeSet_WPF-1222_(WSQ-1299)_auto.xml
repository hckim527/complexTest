<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList> 
            	<w2:dataList id="dataList3" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>           	 
            	<w2:dataList id="dataList4" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
            		</w2:keyInfo>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사). 2026-11
scwin.__getJq = function(q) {
    var j = $(q); if (j.length) return j;
    var P = 'mf_', t = q.trim(), r = t.slice(1);
    if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
    return $(t.slice(0, 1) + r);
};
scwin.trigger1_onclick = function(e) {
    dataList4.setData(['bb', '22', 'cc', '33', 'dd', '44']);
    gridView1.setColumnNodeSet(0, "data:dataList4", "label", "value");
};
scwin.trigger2_onclick = function(e) {
    dataList4.setData(['bb', '22', 'cc', '33', 'dd', '44']);
    gridView1.redrawColumn("col1");
};
scwin.trigger3_onclick = function(e) {
    dataList4.setData(['bb', '22', 'cc', '33', 'dd', '44']);
    gridView1.refreshColumnItemset("col1");
};
scwin.checkCompareVal = function(vals) {
    var arr = document.getElementsByClassName("w2selectbox_native_select");
    for (var i = 0; i < arr.length; i++) {
        if (vals[i] != scwin.__getJq(arr[i]).val()) {
            return false;
        }
    }
    return true;
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    dataList2.setData(['aa', '11', 'bb', '22']);
    dataList1.setData(['11', '22', '11', '11', '33', '44']);
    //Function 
    //Created by: Quan.Nguyen
    //Created date: 12-Mar-2018
    //end
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" summaryAuto="false" scrollByColumnAdaptive="false" id="gridView1" style="width:319px;height:150px;" ignoreCellClick="false" ignoreToggleOnDisabled="false" fixedColumnWithHidden="true" useShiftKey="true" senseReader="true" focusMove="false" autoResizeEmbeddedInput="true" embeddedInput="true" keyMoveEditMode="true" summary="내용" readOnly="false">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" style="height:20px" width="70" inputType="text" displayMode="label" value="name1"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" width="70" inputType="select" displayMode="label" allOption="" chooseOption="">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="height: 23px;width:130px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[setColumnNodeSet]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2" style="height: 23px;width:130px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[redrawColumn]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger3" style="height:23px;width:163px;" ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[refreshColumnItemset]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 