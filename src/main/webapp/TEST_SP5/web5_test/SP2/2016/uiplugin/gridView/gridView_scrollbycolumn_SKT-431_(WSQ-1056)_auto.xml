        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function() {
    document.body.style.zoom = parseFloat(input1.getValue()) || 1;
}
scwin.checkRightEndColummIsShowed = function() {
    return WebSquare.wUnit.getJq("#gridView1_dataLayer").position().left + WebSquare.wUnit.getJq("#gridView1_dataLayer").width() >= WebSquare.wUnit.getJq("#gridView1_column3").position().left + WebSquare.wUnit.getJq("#gridView1_column3").width();
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일 실행 후 setFullView클릭하고 상단 그리드의 가로스크롤바를 오른쪽 끝까지 이동한다.(firefox는 setFullView 클릭과 상관없이 스크롤바로 이동후 확인하면됨. style의 zoom속성을 변경해도 화면 배율이 변경되지 않음)
    //1. After executing the sample file, click on setFullView and move the horizontal scroll bar of the upper grid to the right end (firefox can be checked after moving to the scroll bar regardless of the setFullView click, changing the zoom property of the style does not change the screen scale)
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_scrollX_right').scrollLeft = 500");
    WebSquare.wUnit.addCommand("pause", "100");
    //Verify step 1. 그리드 오른쪽끝값까지 정상적으로 보여진다.(이전에는 전부보이지 않음)
    //1. Grid right end value is shown normally (previously not shown)
    WebSquare.wUnit.addCommand("assert", "scwin.checkRightEndColummIsShowed()", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
