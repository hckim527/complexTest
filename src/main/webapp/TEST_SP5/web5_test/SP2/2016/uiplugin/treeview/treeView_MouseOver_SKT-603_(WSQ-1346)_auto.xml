}
scwin.fireOver = function(node) {
    if (document.createEventObject) {
        node.fireEvent('onmouseover');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('mouseover', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.onmouseover == 'function') {
        node.onmouseover();
    }
}
scwin.mouseOverBehaviour = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireOver(el);
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 3. 브라우저에서 TreeView 에 마우스오버한다.
    //3. Mouse over the TreeView in the browser.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour($p.id+'wq_uuid_1_label_3')");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 3. 마우스오버에 따라 해당 TreeView 의 툴팁이 생성된다.
    //3. Tooltip of the corresponding TreeView is generated according to mouse over.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'wq_uuid_1_tooltip').style.display == 'block'", "true");
    WebSquare.wUnit.addCommand("assert", "log", "text:::::tooltip~ index:::::3");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
