scwin.gridView2_onscrollend = function(e) {
    console.log("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA");
    if (G < 2000) {
        var u = [];
        G = G + 20;
        for (var i = 0; i < 20 * 3; i++) {
            u.push(i);
        }
        dataList1.setData(u, true);
    }
    log1 = true;
};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 2. 새로고침(F5)후 2번을 클릭한다.
    //2. Click Refresh (F5) and then 2.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 2. 그리드 스크롤의 index가 90번째가 맨위로 보이게 이동되고 onscrollend이벤트가 발생하지 않아 콘솔창에 값이 보여지지 않는다.
    //2. The index of the grid scroll is moved to the top so that the onscrollend event does not occur and the value is not displayed in the console window.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView2').getTopRowIndex() == 90", "true");
    WebSquare.wUnit.addCommand("assert", "log1", "false");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();


scwin.onpageload = function() {
    window.log1 = false;
    window.G = 100;
