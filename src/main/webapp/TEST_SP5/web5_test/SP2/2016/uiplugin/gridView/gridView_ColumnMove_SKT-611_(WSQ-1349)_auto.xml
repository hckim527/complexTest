<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="col1" dataType="text"></w2:column>
            			<w2:column id="col2" name="col2" dataType="text"></w2:column>
            			<w2:column id="col3" name="col3" dataType="text"></w2:column>
            			<w2:column id="col4" name="col4" dataType="text"></w2:column>
            			<w2:column id="col5" name="col5" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function() {
    gridView1.setColumnWidth("col1", 20);
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");	
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");	
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView1_cell_0_0').getBoundingClientRect().width == 20", "true");
    WebSquare.wUnit.addCommand("pause", "500");		
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
scwin.onpageload = function() {
    window.data = [];
    for (var i = 0; i < 30; i++) {
        for (j = 0; j < 5; j++) {
            data.push("col" + j + "_" + i);
        }
    }
    dataList1.setData(data);
    gridView1.setColumnOrder([2, 3, 0, 1, 4]);
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList1" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20" id="gridView1"
    		style="position: relative;width:501px;height:414px;" fixedColumnWithHidden="true" useShiftKey="true" columnMove="true" rowNumVisible="true" rowStatusVisible="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column9" style="" inputType="text" width="70" value="col1"></w2:column>
    				<w2:column blockSelect="false" id="column7" style="" inputType="text" width="70" value="col2"></w2:column>
    				<w2:column blockSelect="false" id="column5" style="" inputType="checkbox" width="70" value="col3"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="col4"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="col5"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" inputType="checkbox" width="70" readOnly="true"></w2:column>
    				<w2:column blockSelect="false" id="col4" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col5" style="" width="70" inputType="text"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
        <xf:trigger type="button" id="trigger1" style="position: relative;height:39px;width:220px;display:block;" ev:onclick="scwin.trigger1_onclick">
            <xf:label><![CDATA[setColumnWidth("col1", 20)]]></xf:label>
        </xf:trigger>
    </body>
</html>
 