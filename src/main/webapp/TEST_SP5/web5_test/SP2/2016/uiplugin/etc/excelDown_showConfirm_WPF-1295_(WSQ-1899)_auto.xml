        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    var options = {};
    options.fileName = "test.xlsx";
    options.showConfirm = true;
    gridView1.advancedExcelDownload(options);
};
scwin.checkSize = function(id) {
    if (WebSquare.wUnit.getJq("#" + id).width() > 250) {
        return true;
    }
    return false;
}
scwin.unitTest = function() {
    //init
    // WebSquare.wUnit.start();
    //Test step 1. 샘플파일 실행 후 'excel down'버튼을 클릭한다.
    //1. Run the sample file and click the 'excel down' button.
    //Verify step 1. The pop-up screen with the cancle button and the download button is displayed without scrolling (Previously, the horizontal and vertical scrollbars were created on the pop-up screen)
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("assert", "scwin.checkSize('gridDownLoadLayer')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 08-Feb-2018
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
