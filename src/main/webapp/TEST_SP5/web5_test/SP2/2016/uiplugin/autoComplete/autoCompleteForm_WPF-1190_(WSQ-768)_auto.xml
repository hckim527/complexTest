<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection baseNode="map">
        		<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
        			<w2:columnInfo>
        				<w2:column id="label" name="label" dataType="text"></w2:column>
        				<w2:column id="value" name="value" dataType="text"></w2:column>
        			</w2:columnInfo>
        			<w2:data use="true">
        				<w2:row>
        					<label><![CDATA[cusomNo]]></label>
        					<value><![CDATA[고객번호]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[receiptKind]]></label>
        					<value><![CDATA[수납종류]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[search]]></label>
        					<value><![CDATA[조회]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[office]]></label>
        					<value><![CDATA[사업소]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[name]]></label>
        					<value><![CDATA[성명]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[personalNo]]></label>
        					<value><![CDATA[대인번호]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[contactKind]]></label>
        					<value><![CDATA[계약종별]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[contactPower]]></label>
        					<value><![CDATA[계약전력]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[firmName]]></label>
        					<value><![CDATA[상호]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[address]]></label>
        					<value><![CDATA[주소]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[phoneNumber]]></label>
        					<value><![CDATA[전화번호]]></value>
        				</w2:row>
        				<w2:row>
        					<label><![CDATA[deadLine]]></label>
        					<value><![CDATA[납기일]]></value>
        				</w2:row>
        			</w2:data>
        		</w2:dataList>
        	</w2:dataCollection>        	
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    WebSquare.wUnit.getDomById('autoComplete1_label').click();
    WebSquare.wUnit.getDomById('autoComplete1_input').value = 'f';
    autoComplete1.inputKeyDown({
        keyCode: 70
    });
    //autoComplete1.enterHandle({keyCode:13});
};
scwin.setVal = function() {
    autoComplete1.enterHandle({
        keyCode: 13
    });
}
scwin.unitTest = function() {
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click();");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setVal()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('autoComplete1').getValue() === '사업소'", "true");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="height:399px;padding:30px;">
    	<w2:textbox id="" style="padding:10px 0;" label="WPF-1190" tagname="h2"></w2:textbox>
    	<w2:textbox id="" style="padding:0 0 10px;" label="" tagname="h2"></w2:textbox>
    	<xf:group id="" style="">
    		<xf:group id="" style="width:180px;" class="w2tb tb" tagname="table">
    			<w2:attributes>
    				<w2:summary></w2:summary>
    			</w2:attributes>
    			<xf:group tagname="colgroup">
    				<xf:group style="width:170px;" tagname="col"></xf:group>
    			</xf:group>
    			<xf:group tagname="thead">
    				<xf:group style="" tagname="tr">
    					<xf:group class="w2tb_th" tagname="th">autoComplete</xf:group>
    				</xf:group>
    			</xf:group>
    			<xf:group tagname="tbody">

    				<xf:group style="" tagname="tr">
    					<xf:group style="text-align:center;" class="w2tb_td" tagname="td">
    						<w2:autoComplete interactionMode="" caseSensitive="" displayMode="label delim value" allowEmptySubmission=""
    							id="autoComplete1" delimiter="" useKeywordHighlight="false" style="position: relative;width:170px;height: 21px;" search="contain"
    							editModeEvent="onclick" disabled="" editType="select" submenuSize="auto" searchTarget="both" noResult="first" allOption=""
    							chooseOption="">
    							<w2:choices>
    								<w2:itemset nodeset="data:dataList1">
    									<w2:label ref="label"></w2:label>
    									<w2:value ref="value"></w2:value>
    								</w2:itemset>
    							</w2:choices>
    						</w2:autoComplete>
    					</xf:group>
    				</xf:group>

    			</xf:group>
    		</xf:group>
    	</xf:group>

    	<xf:trigger type="button" id="trigger1" style="position: absolute ;left:30px;top:202px;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[test]]></xf:label>
    	</xf:trigger>
    </xf:group></body>
</html>
 