<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:linkedDataList id="linkedDataList1" bind="dataList1">
            		<w2:condition type="filter"><![CDATA[col("col1") like "%" + ref("dataMap1.key1")+"%"]]></w2:condition>
            		<w2:condition type="sort"><![CDATA[]]></w2:condition>
            	</w2:linkedDataList>
            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
            		</w2:keyInfo>
            	</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일을 실행한다.
    //1. Run the sample file.
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1. 실행결과 첨부파일(skt534후)처럼 보여진다.(컨디션 조건값에 따려 결과값이 보여지는게 다르다.)
    //1. Execution result Appears as attachment file (after skt534) (It differs according to condition condition value.)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#wq_uuid_6_body_tbody tr').not('.w2grid_hidedRow').length == 5", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#wq_uuid_6_scrollY_div').css('overflow-y') == 'hidden'", "true");
    WebSquare.wUnit.addCommand("pause", "1000");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    window.data = [];
    for (var i = 0; i < 3; i++) {
        for (var j = 0; j < 20; j++) {
            data.push("0" + String((j * 3 + i)) + "0");
        }
    }
    dataList1.setData(data);
    dataMap1.set("key1", "5");
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 14-Mar-2018
    //End unitTest
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="linkedDataList1" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20" id=""
    		style="position: relative;width:534px;height:401px;" fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5" style="" inputType="text" width="70" value="name1"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="name2"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="name3"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" width="70" inputType="text"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 