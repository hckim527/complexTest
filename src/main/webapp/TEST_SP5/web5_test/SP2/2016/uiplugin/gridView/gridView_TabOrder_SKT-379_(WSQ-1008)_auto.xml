        <script type="text/javascript" lazy="false"><![CDATA[
scwin.btn_close_onfocus = function() {
    isFocus = true;
};
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate = function() {
    scwin.simulateWrapper('#btn_find', 'key-combo', {
        combo: 'TAB'
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 1. 브라우저에서 상담일을 선택하고 Tab 키를 누른다. (조회버튼에서 Tab 시 확인버튼으로 이동되게 설정함)
    //1. In the browser, select the day of the meeting and press the Tab key. (It is set to move from the inquiry button to the confirmation button on the tab.)
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_find').click()");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_find').focus()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "isFocus", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.isFocus = false;
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 20-Apr-2018
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>

