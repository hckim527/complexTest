		<script type="text/javascript" lazy="false"><![CDATA[
scwin.fireOver = function(node) {
    if (document.createEventObject) {
        node.fireEvent('onmouseover');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('mouseover', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.onmouseover == 'function') {
        node.onmouseover();
    }
}
scwin.mouseOverBehaviour = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireOver(el.getElementsByTagName("img")[0]);
}
scwin.__hasId = function(id) {
    if (WebSquare.wUnit.getDomById($p.id + id)) {
        return true;
    }
    return false;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 3. 브라우저에서 inputType="textImage" 인 컬럼을 마우스오버한다.
    //3. In the browser, mouse over the column with inputType = "textImage".
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour($p.id+'grd_sum_cell_5_0')");
    WebSquare.wUnit.addCommand("pause", "1000");
    //Verify 3. 툴팁이생성된다. (그전엔진버전에서는 툴팁이 생성되지않는 현상이 발생함)
    //3. A tooltip is created. (Tool tip is not generated in previous engine version)
    WebSquare.wUnit.addCommand("assert", "scwin.__hasId('grd_sum_tooltip')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
