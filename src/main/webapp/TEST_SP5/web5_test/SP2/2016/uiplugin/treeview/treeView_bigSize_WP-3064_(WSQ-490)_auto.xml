scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 브라우저에서 확인한다.
    //1.Check in browser
    // verify step 1. 웹페이지 메시지 확인
    //1. Web page message confirmation
    WebSquare.wUnit.addCommand("assert", "log != ''", "true");
    WebSquare.wUnit.addCommand("assert", "time < 3000", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "time < 3000", "true");
    WebSquare.wUnit.addCommand("pause", "100");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.data = dataList1.getAllData();
    for (var ix = 0; ix < 8; ix++) {
        data = data.concat(data);
    }
    window.start = new Date();
    dataList1.setData(data);
    window.log = "";
    window.end = new Date();
    console.log("## 소요시간 = " + (end - start));
    console.log("## row건수 = " + dataList1.getRowCount());
    //alert("row건수 = " + dataList1.getRowCount() + "\n소요시간 = " + (end - start) + " ms");
    log = "row건수 = " + dataList1.getRowCount() + "\n소요시간 = " + (end - start) + " ms";
    window.time = (end - start);
    window.row = dataList1.getRowCount();
    //Function unitTest
    //Created By: Sang.do
    //Created By: 08-Feb-2018
    //end unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
