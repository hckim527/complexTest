    var toIdx = Number(grd_Idbi.getTotalCol()) - 1;
    for (var i = 0; i < toIdx; i++) {
        grd_Idbi.setColumnVisible(i, false);
    }
};
scwin.btnSearchIdbi_onclick = function(e) {
    scwin.initScreen();
};
scwin.trigger1_onclick = function(e) {
    grd1.setColumnVisible(str, false);
    str++;
};
scwin.trigger2_onclick = function(e) {
    var toIdx = Number(grd1.getTotalCol()) - 1;
    for (var i = 0; i < toIdx; i++) {
        grd1.setColumnVisible(i, false);
    }
};
scwin.checkOnlyOneColumeIsShowed = function() {
    var count = 0;
    var cols = document.getElementsByClassName("gridHeaderStyle_0")[0].childNodes;
    for (i = 0; i < cols.length; i++) {
        if (WebSquare.wUnit.getJq(cols[i]).is(":visible")) {
            count++;
        }
    }
    return count;
}
scwin.checkVal1 = function() {
    return WebSquare.wUnit.getJq('#grd_Idbi_body_table').width() >= 68 && WebSquare.wUnit.getJq('#grd_Idbi_body_table').width() <= 70 && WebSquare.wUnit.getJq('#grd_Idbi_column907').is(':visible');
}
scwin.checkVal2 = function() {
    return WebSquare.wUnit.getJq('#grd1_body_table').width() >= 68 && WebSquare.wUnit.getJq('#grd1_body_table').width() <= 70 && WebSquare.wUnit.getJq('#grd1_column1').is(':visible');
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();

    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btnSearchIdbi').click()");
    //Verify step 1. 34번째 컬럼만 보여진다.
    //1. Only the 34th column is shown.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    //Test step 2. "35개 for" 버튼을 클릭한다.
    //2. Click the "35 for" button.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    //Verify step 2. 35번째 컬럼이 숨겨져서 보여진다.(이전에는 정상적으로 숨겨지지않음)
    //2. The 35th column is hidden (previously not hidden normally).
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    window.str = 0;
    //Function 
