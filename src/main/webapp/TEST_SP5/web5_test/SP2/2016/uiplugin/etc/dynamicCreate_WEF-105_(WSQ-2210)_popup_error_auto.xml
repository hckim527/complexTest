<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.initError = function() {
    $w.log("popup scwin.initError");
};
scwin.serviceResult = function(mesgCd) {
    var resultMsg = "";
    switch (numLib.parseInt(mesgCd)) {
        case 0:
            resultMsg = "정상처리";
            break;
        case 1:
            resultMsg = "runtime exception";
            break;
        case 2:
            resultMsg = "application exception";
            break;
    };
    return resultMsg;
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.initError();
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
		<w2:floatingLayer id="flt_message" title="Message" style="width:70%;left:10%;top:10%;" class="err_pp" ev:onclose="" ev:onlayermove="">
			<xf:group id="" style="" class="defaultbox">
				<xf:group id="" style="" class="cb">
					<w2:textbox id="tbx_title" style="" class="df_tt fl" label="">
					</w2:textbox>
					<w2:textbox id="tbx_errListCnt" style="" class="err_total" label="" displayFormat="* !~Total~! : ###,### !~Counts~!" dataType="number">
					</w2:textbox>
				</xf:group>
				<w2:textbox id="" style="margin-left:10px;" class="ett" label="!~ErrorLabel~!">
				</w2:textbox>
			</xf:group>
			<xf:group id="grp_subErr" style="" class="tbbox_ofa">
				<xf:group id="tbl_err" style="width:100%;" class="w2tb tb" tagname="table">
					<w2:attributes>
						<w2:summary></w2:summary>
					</w2:attributes>
					<xf:group tagname="colgroup">
						<xf:group style="width:150px;" tagname="col">
						</xf:group>
						<xf:group style="" tagname="col"></xf:group>
					</xf:group>
					<xf:group tagname="thead">
						<xf:group style="" tagname="tr">
							<xf:group style="" class="w2tb_th" tagname="th">!~MsgCode~!</xf:group>
							<xf:group style="" class="w2tb_th" tagname="th">!~Message~!</xf:group>
						</xf:group>
					</xf:group>
					<w2:generator id="tbl_errList" style="" tagname="tbody">
						<xf:group id="" style="" class="" tagname="tr">
							<xf:group class="w2tb_th" id="" style="" tagname="th">
								<w2:textbox id="th_textbox" style="" label="" for="">
								</w2:textbox>
							</xf:group>
							<xf:group class="w2tb_td" id="" style="" tagname="td">
								<xf:group class="err_ttbox" id="err_ttbox" style="" tagname="">
									<w2:textbox id="td_textbox" style="" label="" class="err_tt">
									</w2:textbox>
									<w2:anchor id="td_btn" style="" outerDiv="false" class="btn_err_sh" name="">
										<xf:label><![CDATA[!~Details~!]]></xf:label>
									</w2:anchor>
								</xf:group>
								<xf:group class="err_ttcont" id="td_div" style="" tagname="" adaptiveThreshold="">
									<w2:textbox id="td_detail" style="" label="">
									</w2:textbox>
								</xf:group>
							</xf:group>
						</xf:group>
					</w2:generator>
				</xf:group>
			</xf:group>
			<xf:group id="" style="" class="defaultbox">
				<xf:group id="" style="" class="fr">
					<w2:anchor style="" class="btn_cm" outerDiv="true" ev:onclick="scwin._onclose">
						<xf:label><![CDATA[!~Close~!]]></xf:label>
					</w2:anchor>
				</xf:group>
			</xf:group>
		</w2:floatingLayer>
	</body>
</html> 