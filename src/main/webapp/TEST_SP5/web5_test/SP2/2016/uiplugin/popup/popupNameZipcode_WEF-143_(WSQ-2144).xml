<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                </data>
            </xf:instance>   
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.result = $w.getParameter("rowObj");
    //alert("result"+result.addr);
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>        
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:trigger type="button"
    		style="position:absolute;word-wrap:break-word;top:60px;left:40px;width:158px;height:21px;"
    		leftOnImageStyle="" centerOnImageStyle="" rightOnImageStyle=""
    		leftOffImageStyle="" centerOffImageStyle="" rightOffImageStyle=""
    		leftPressImageStyle="" centerPressImageStyle=""
    		rightPressImageStyle="" leftDisabledImageStyle=""
    		centerDisabledImageStyle="" rightDisabledImageStyle=""
    		id="trigger1">
    		<xf:label>close</xf:label>
    		<script type="javascript" ev:event="onclick"><![CDATA[

				WebSquare.core.closePopupWindow();				
			 ]]></script>
    	</xf:trigger>
    	<xf:input
    		style="position:absolute;vertical-align:middle;word-wrap:break-word;top:20px;left:40px;width:160px;height:30px;"
    		onFocusStyle="" id="input1">
    		<xf:label></xf:label>
    	</xf:input>
    </body>
</html>
 