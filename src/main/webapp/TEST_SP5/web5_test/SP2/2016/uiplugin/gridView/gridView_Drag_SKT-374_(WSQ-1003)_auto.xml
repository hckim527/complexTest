        <script type="text/javascript" lazy="false"><![CDATA[
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setVal = function() {
    scwin.simulateWrapper('#gridView1_cell_0_1', 'drag', {
        dx: 60,
        dy: 0
    });
}
scwin.checkVal = function() {
    return WebSquare.wUnit.getJq('#gridView1_cell_0_1').css('background-color') == 'rgb(252, 167, 60)';
}
scwin.checkVal2 = function() {
    return WebSquare.wUnit.getJq('#gridView1_cell_0_2').css('background-color') == 'rgb(252, 167, 60)';
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 2. 브라우저에서 임의의 컬럼을 선택 후 원하는 방향으로 드래그한다.
    //2. Select an arbitrary column in the browser and drag it in the desired direction.
    //Verify step 2. The dragged range is selected.
    WebSquare.wUnit.addCommand("set", "scwin.setVal()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload = function() {
    if (typeof scwin.onpageload === "function") {
        //scwin.onpageload();
    }
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 26-Apr-2018
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
