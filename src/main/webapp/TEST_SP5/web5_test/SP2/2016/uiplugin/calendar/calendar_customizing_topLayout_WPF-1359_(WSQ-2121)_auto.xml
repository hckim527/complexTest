    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사). 2026-11
scwin.__getJq = function(q) {
    var j = $(q); if (j.length) return j;
    var P = 'mf_', t = q.trim(), r = t.slice(1);
    if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
    return $(t.slice(0, 1) + r);
};
scwin.__isShowButtonOnTop = function(parentClass, clsLeft, clsRight) {
    var header = scwin.__getJq(parentClass);
    var elLeft = scwin.__getJq(header).find(clsLeft);
    var elRight = scwin.__getJq(header).find(clsRight);
    if (!elLeft || !elRight) {
        return false;
    }
    return scwin.__getJq(elLeft).css("left") < scwin.__getJq(elRight).css("left");
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
}
]]></script>
    	<style type="text/css"><![CDATA[
		
		/*년월 화살표 네비게이션 제거   */ 	
