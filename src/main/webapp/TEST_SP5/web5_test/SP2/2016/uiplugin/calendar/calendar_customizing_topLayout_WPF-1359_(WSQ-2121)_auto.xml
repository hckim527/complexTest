    	/* inputCalendar의 경우 닫기 버튼 위치값*/
    	.w2calendar_date_cancel {position:relative; top: -13px; left: 175px;} 
    	
    	    	
    	/* 달력푸터 제거 */
    	.w2calendar_footer {display: none;}
    	.w2calendar_class1 {height:170px;}
    	
    	 ]]></style>
