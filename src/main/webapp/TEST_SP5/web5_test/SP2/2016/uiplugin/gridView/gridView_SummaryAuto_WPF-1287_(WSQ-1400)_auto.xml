}
scwin.checkVal = function(domId, value) {
	if (WebSquare.util.isHTML5() === true) {
		return true;
	}
	return scwin.__getObj($p.getFrameId() + "_" + domId).getAttribute('value') == value;
}
scwin.onpageload2 = function() {
