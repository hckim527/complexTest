<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    //alert (autoComplete1.getValue());
    log = autoComplete1.getValue();
};
scwin.trigger2_onclick = function(e) {
    //alert (selectbox1.getValue());
    log1 = selectbox1.getValue();
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.a = [];
    for (var i = 1; i <= 8; i++) {
        a.push("test" + i);
        a.push(i);
    }
    dataList1.setData(a);
    autoComplete1.setSelectedIndex(-1);
    selectbox1.setSelectedIndex(-1);
    window.log = ""; window.log1 = "";
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 02-Mar-2018
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:autoComplete visibleRowNum="5" chooseOption="" id="autoComplete1"
    		style="position: relative;width:257px;height:73px;display:block;" search="start" interactionMode="" displayMode="label"
    		useKeywordHighlight="false" submenuSize="auto" editType="select" allOption="" emptyItem="true" emptyValue="선택해주세요1">
    		<w2:choices>
    			<w2:itemset nodeset="data:dataList1">
    				<w2:label ref="label"></w2:label>
    				<w2:value ref="value"></w2:value>
    			</w2:itemset>
    		</w2:choices>
    	</w2:autoComplete>
    	<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" direction="auto" chooseOption="" id="selectbox1"
    		style="position: relative;width:257px;height:73px;display:block;" displayMode="label" optionOrder="false" allOption=""
    		disabled="false" submenuSize="auto" emptyItem="true" emptyValue="선택해주세요2">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="label"></xf:label>
    				<xf:value ref="value"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1>
    	<xf:trigger type="button" id="triger1" style="position: absolute;width:177px;height:36px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[autoComplete1.getValue()]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="triger2" style="position: absolute;width:177px;height:33px;left:0px;top:186px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[selectbox1.getValue()]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 