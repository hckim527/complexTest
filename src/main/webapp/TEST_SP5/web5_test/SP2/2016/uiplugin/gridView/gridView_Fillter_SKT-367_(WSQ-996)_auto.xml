				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;">
			<xf:label><![CDATA[setData]]></xf:label>
			<script ev:event="onclick(e)" type="javascript"><![CDATA[
					dataList1.setData([1,2,3,4,2,6,7,1,9]);
			 ]]></script>
