						<w2:column id="comm_cd_val" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>							
			</w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    dst_scrnItmTypCd.setData(['a', '1', 'b', '2']);
    dataList1.setData(["1", "2", "3", "4", "2", "6", "7", "1", "9"]);
    gridView1.setCellReadOnly(0, 0, true);
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 28-Feb-2018
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
		<w2:gridView dataList="dataList1" applyAllColumnStyle="false" scrollByColumn="false" id="gridView1"
			style="width: 100%;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true" filterFocusMode="" useFilterList="true" readOnly="false" autoFit="allColumn" displayValueOnUseFilterList="true">
			<w2:header id="header1" style="">
				<w2:row id="row2" style="">
					<w2:column blockSelect="false" id="column9" style="height:20px" inputType="text" width="121" value="name1"
						useFilter="true">
					</w2:column>
					<w2:column blockSelect="false" id="column7" style="height:20px" inputType="text" width="121" value="name2"
						useFilter="true">
					</w2:column>
					<w2:column blockSelect="false" id="column3" style="height:20px" width="121" inputType="text" value="name3"
						useFilter="true">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4" style="">
