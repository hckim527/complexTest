    //Verify step 1. 그리드뷰의 7번, 8번, 9번 row가 정상적으로 comMerge되어 보여진다.(이전에는 7,8,9번 row가 comMerge되어지지 않고 라인이 보여짐)
    //1. The rows 7, 8, and 9 of the grid view are normally comma-delimited (previously rows 7, 8, and 9 are not comma-delimited)
    WebSquare.wUnit.addCommand("assert", "scwin.getBorderWidth() == 0", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
