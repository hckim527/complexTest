scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일을 실행 후 그리드뷰에서 마우스 스크롤을 아래로 이동한다.(끝까지 이동 시 2번 스크롤이동)
