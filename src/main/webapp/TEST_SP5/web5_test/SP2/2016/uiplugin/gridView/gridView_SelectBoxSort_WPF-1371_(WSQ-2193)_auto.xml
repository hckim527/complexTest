        <script type="text/javascript" lazy="false"><![CDATA[
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.__sortCol = function() {
    var el = WebSquare.wUnit.getDomById($p.id + "gridView1_column15");
    scwin.fireDbClick(el);
}
scwin.__isSorted = function() {
    var el = WebSquare.wUnit.getJq('.grid_body_row').not('.w2grid_hidedRow').find('td[col_id="col1"]');
    var arr = [];
    var tmp = [];
    for (var i = 0; i < el.length; i++) {
        arr.push(WebSquare.wUnit.getJq(el[i]).text());
        tmp.push(WebSquare.wUnit.getJq(el[i]).text());
    }
    tmp = tmp.sort();
    return scwin.__equalArr(arr, tmp);
}
scwin.__equalArr = function(arr1, arr2) {
    for (var i = 0; i < arr1.length; i++) {
        if (arr1[i] != arr2[i]) {
            return false;
        }
    }
    return true;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. Source 탭에서 col1 의 sortLabel 부분을 학인한다.
    //1. In the Source tab, examine the sortLabel part of col1.
    // verify step 1. sortLabel='true'
    //2. Sort the col1 column in the browser.
    //Test step 2. 브라우저에서 col1 컬럼을 Sort 한다.
    //2. Sort the col1 column in the browser.
    WebSquare.wUnit.addCommand("set", "scwin.__sortCol()");
    //Verify step 2. label 순으로 Sort 된다. (그전에는 라벨로 소트하는 기능이 없었음)
    WebSquare.wUnit.addCommand("assert", "scwin.__isSorted()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
