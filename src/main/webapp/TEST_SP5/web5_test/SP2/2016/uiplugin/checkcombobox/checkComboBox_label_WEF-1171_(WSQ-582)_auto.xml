<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    checkcombobox1.checkAll(true);
};
scwin.unitTest = function() {
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click();");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('checkcombobox1_label').textContent == '전체선택'", "true");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:checkcombobox appearance="minimal" direction="auto" chooseOption="" id="checkcombobox1" displayAllOptionLabel="true"
    		style="position: relative ;left: 295px;top: 66px;width:257px;height:42px;" displayMode="label" allOption="true" submenuSize="auto"
    		disabled="false">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[a]]></xf:label>
    				<xf:value><![CDATA[1]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[b]]></xf:label>
    				<xf:value><![CDATA[2]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[c]]></xf:label>
    				<xf:value><![CDATA[3]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[d]]></xf:label>
    				<xf:value><![CDATA[4]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:checkcombobox>
    	<xf:trigger type="button" id="trigger1" style="position: absolute;width:80px;height:47px;left:570px;top:65px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[test]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 