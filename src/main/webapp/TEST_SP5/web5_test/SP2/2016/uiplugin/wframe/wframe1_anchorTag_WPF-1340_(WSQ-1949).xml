<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.anchor1_onclick = function() {
    //alert('wframe1_anchor');
    window.log = "wframe1_anchor";
    window.count++;
};
scwin.trigger1_1_onclick = function(e) {
    alert('wframe1_trigger');
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.log = undefined; 
	window.count = 0;
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:anchor id="anchor1"
    		style="position: absolute ;top: 25px;width: 120px;height: 34px;"
    		outerDiv="false" ev:onclick="scwin.anchor1_onclick">
    		<xf:label><![CDATA[anchor button]]></xf:label>
    	</w2:anchor>
    	<xf:trigger type="button" id="trigger1_1"
    		style="position: absolute ;top: 80px;width: 121px;height: 31px;"
    		ev:onclick="scwin.trigger1_1_onclick">
    		<xf:label><![CDATA[trigger]]></xf:label>
    	</xf:trigger>
    	<w2:textbox label="anchor 클릭 시 이벤트 2번 호출함" id=""
    		style="position: absolute ;left: 2px;top: 1px;width: 236px;height: 21px;">
    	</w2:textbox>
    	<w2:textbox label="trigger는 정상적으로 한번만 호출" id=""
    		style="position: absolute ;top: 62px;width: 317px;height: 16px;">
    	</w2:textbox>
    </body>
</html>
 