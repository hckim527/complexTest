    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    //alert(input1.getFormattedValue());
    log = input1.getFormattedValue();
};
scwin.trigger3_onclick = function(e) {
    //textarea 는 getFormattedValue API 가 없음
    //alert(textarea1.getFormattedValue());
};
scwin.trigger4_onclick = function(e) {
    //secret 은 비공개 API
    //alert(secret1.getFormattedValue());
    log1 = secret1.getFormattedValue();
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.log = ""; window.log1 = "";
