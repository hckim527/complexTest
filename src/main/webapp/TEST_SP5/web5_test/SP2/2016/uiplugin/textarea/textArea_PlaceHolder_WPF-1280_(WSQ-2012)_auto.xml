    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    <xf:group id="group1" style="height:104px;width:500px;">
    	<xf:input id="input1" style="width: 144px;height: 21px;" placeholder="입력하세요"></xf:input>
    	<xf:trigger id="trigger1" style="width:145px;height:23px;" ev:onclick="scwin.trigger1_onclick" type="button">
    		<xf:label><![CDATA[getFormattedValue]]></xf:label>
    	</xf:trigger>
    	<xf:textarea id="textarea1" style="width: 300px;height: 100px;" placeholder="입력하세요"></xf:textarea>

    	<xf:trigger id="trigger3" style="width:145px;height:23px;vertical-align: top;" ev:onclick="scwin.trigger3_onclick" type="button">
    		<xf:label><![CDATA[getFormattedValue]]></xf:label>
    	</xf:trigger>
    	
    	<xf:secret id="secret1" style="width: 144px;height: 21px;" placeholder="입력하세요"></xf:secret><xf:trigger type="button" id="trigger4" style="width:145px;height:23px;" ev:onclick="scwin.trigger4_onclick">
