    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setVal()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('G_grd0__col2').setValue('D')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('grd0_cell_1_2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 3. 편집을 시도한 데이터 값이 지워지지 않고 제대로 변경된다. 
    //3. The data value that is attempted to be edited is not erased and changes properly.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('grd0_cell_1_1').textContent == 'D'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('wq_uuid_125').getValue() == 'D'", "true");
    WebSquare.wUnit.addCommand("assert", "document.getElementsByClassName('w2autoComplete_col_label')[0].textContent == 'DD'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
