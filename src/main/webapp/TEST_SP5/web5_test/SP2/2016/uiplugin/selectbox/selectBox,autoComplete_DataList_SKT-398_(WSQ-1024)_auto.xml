scwin.fireDbClick = function(node) {
    if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.setVal = function() {
    scwin.fireDbClick(WebSquare.wUnit.getDomById('grd0_cell_1_1'));
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 3. 브라우저에서 select Filter 버튼을 클릭한 후, gridView 의 name2 column의 데이터를 임의의 데이터로 편집한다. (예 : DataValue1 = C -> D)
