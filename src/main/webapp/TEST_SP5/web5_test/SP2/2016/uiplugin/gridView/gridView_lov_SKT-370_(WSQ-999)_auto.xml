scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 브라우저에서 Filter 버튼을 클릭한다.
    //1. Click the Filter button in your browser.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('auCom1_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#auCom1_itemTable_main tr').length == 3", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#auCom1_itemTable_main tr')[1].innerText == 'BB'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#auCom1_itemTable_main tr')[2].innerText == 'CC'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 2. 그리드뷰에 데이터를 임의로 클릭한다.
    //2. Randomly click on the data in the grid view.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('grd0_cell_1_2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 2. 선택한 데이터에 따라서 하단에 본문영역의 데이터가 변경된다. (그전에는 Filter 에 해당되지 않는 'A' / 'D' 선택시 그리드의 데이터가 삭제되는 현상이 발생했음)
    //2. Depending on the selected data, the data in the text area changes at the bottom. (Previously, when 'A' / 'D' which is not applicable to Filter was selected, data of grid was deleted.)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('wq_uuid_89_label').innerText == '서브3'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('auCom1_label').innerText == 'CC'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('wq_uuid_123').getValue() == 'C'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('grd0_cell_0_2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('wq_uuid_89_label').innerText == '서브2'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('auCom1_label').innerText == 'BB'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('wq_uuid_123').getValue() == 'B'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
