scwin.__isShowContentDefault = function() {
    //var caption = WebSquare.wUnit.getJq("#gridView2").find('#'+$p.id+'caption2').html();
    var caption = WebSquare.wUnit.getJq("#gridView2").find('#'+$p.id+'gridView2_caption2').html();
    var iPos = caption.indexOf("name4,name5,name6");
    return iPos == -1;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 샘플파일을 실행 후 개발자모드(F12) > Elements > 우측하단 gridView2의 Table속성의 caption영역을 확인한다.
    //1. After running the sample file, check the caption area of the Table property of gridView2 in Developer mode (F12)> Elements> right bottom.
    // verify step 1. gridView2의 Table의 Caption영역에 'test은(는) name4,name5,name6 을(를) 나타낸 표'로 보여진다.(이전에는 default로 this is a grid caption으로 보여짐)
    //1. In the Caption area of gridView2"s table, 'test is shown as table showing name4, name5, name6'.(Previously shown as this is a grid caption by default)
    WebSquare.wUnit.addCommand("assert", "scwin.__isShowContentDefault()", "false");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
