scwin.onpageload = function() {
    gridView1.setColumnOrder([0, 1, 2, 4, 5, 6, 7, 3, 8, 9]);
    scwin.trigger1_onclick();
    gridView1.setScrollLeft(350);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    var data = [];
    for (var i = 0; i < 4; i++) {
        for (var j = 0; j < 10; j++) {
            data.push(4 * i + j);
        }
    }
    dataList1.setData(data);
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_0_3').childNodes.length == 1", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_1_3').childNodes.length == 1", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_2_3').childNodes.length == 1", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_3_3').childNodes.length == 1", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
