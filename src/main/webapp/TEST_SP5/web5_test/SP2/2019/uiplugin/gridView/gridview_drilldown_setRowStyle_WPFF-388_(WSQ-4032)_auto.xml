scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.btn_trigger1_onclick = function(e) {
    for (i = 0; i < 7; i++) {
        grd_gridView1.setRowStyle(i, "text-decoration", "line-through");
        grd_gridView1.setRowBackgroundColor(i, "#00ff00");
        grd_gridView1.setCellClass(i, 0, "red");
        grd_gridView1.setCellBackgroundColor(i, 1, "#0000ff");
        grd_gridView1.setCellStyle(i, 2, "background-color", "#000000");
    }
    for (i = 0; i < 7; i++) {
        grd_gridView2.setRowStyle(i, "text-decoration", "line-through");
        grd_gridView2.setRowBackgroundColor(i, "#00ff00");
        grd_gridView2.setCellClass(i, 0, "red");
        grd_gridView2.setCellBackgroundColor(i, 1, "#0000ff");
        grd_gridView2.setCellStyle(i, 2, "background-color", "#000000");
    }
    for (i = 0; i < 7; i++) {
        grd_gridView3.setRowStyle(i, "text-decoration", "line-through");
        grd_gridView3.setRowBackgroundColor(i, "#00ff00");
        grd_gridView3.setCellClass(i, 0, "red");
        grd_gridView3.setCellBackgroundColor(i, 1, "#0000ff");
        grd_gridView3.setCellStyle(i, 2, "background-color", "#000000");
    }
};
scwin.btn_trigger2_onclick = function(e) {
    for (i = 0; i < 7; i++) {
        grd_gridView1.setRowStyle(i, "text-decoration", "initial");
        grd_gridView1.setRowBackgroundColor(i, "#ffffff");
        grd_gridView1.removeCellClass(i, 0, "red");
        grd_gridView1.setCellBackgroundColor(i, 1, "#ffffff");
        grd_gridView1.setCellStyle(i, 2, "background-color", "#ffffff");
    }
    for (i = 0; i < 7; i++) {
        grd_gridView2.setRowStyle(i, "text-decoration", "initial");
        grd_gridView2.setRowBackgroundColor(i, "#ffffff");
        grd_gridView2.removeCellClass(i, 0, "red");
        grd_gridView2.setCellBackgroundColor(i, 1, "#ffffff");
        grd_gridView2.setCellStyle(i, 2, "background-color", "#ffffff");
    }
    for (i = 0; i < 7; i++) {
        grd_gridView3.setRowStyle(i, "text-decoration", "initial");
        grd_gridView3.setRowBackgroundColor(i, "#ffffff");
        grd_gridView3.removeCellClass(i, 0, "red");
        grd_gridView3.setCellBackgroundColor(i, 1, "#ffffff");
        grd_gridView3.setCellStyle(i, 2, "background-color", "#ffffff");
    }
};
scwin.checkVal = function() {
    return WebSquare.wUnit.getDomById('grd_gridView1_cell_1_0').style.backgroundColor == "rgb(255, 255, 255)";
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_trigger1').click()");
    WebSquare.wUnit.addCommand('pause', '500');
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('btn_trigger2').click()");
    //WebSquare.wUnit.addCommand('pause', '500');
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand('pause', '500');
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
