<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    scwin.param = scwin.$w.getParameter("paramData");
    //console.log("[popup_wframe2 Screen] param data : " + JSON.stringify(scwin.param));
    var dataStr = scwin.$w.getPopupParam("id");
};
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.grd_memberList_onrowindexchange = function(row, oldRow) {
    var id = scwin.$w.parent().dlt_memberList.getCellData(row, "id");
    var name = scwin.$w.parent().dlt_memberList.getCellData(row, "name");
    ibx_idName2.setValue("Popup2 - [" + id + "] - " + name);
};
scwin.btn_trigger1_onclick = function(e) {
    var wfr = common.getPopupFrame(scwin.param.parentPopupId);
    wfr.getObj("scwin").setIdName(ibx_idName2.getValue());
    //alert(wfr.getObj("ibx_idName1").getValue());  // 부모 팝업 창에 ibx_idName1 컴포넌트에 접근
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.common = {};
    /**
     * popupId에 해당하는 팝업 프레임 객체를 반환한다.
     * @param {String} popupId 팝업 아이디
     * @return {Object} 팝업 프레임 객체
     */
    common.getPopupFrame = function(popupId) {
        return scwin.$w.getPopup(popupId).popupWin.frame;
    }
    scwin.init();
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView applyAllColumnStyle="false" autoFit="allColumn" dataList="data:dlt_memberList" defaultCellHeight="20"
    		id="grd_memberList" ignoreCellClick="false" ignoreToggleOnDisabled="false" scrollByColumn="false" scrollByColumnAdaptive="false"
    		showSortableUseFilter="false" style="height:120px;" summaryAuto="false" summaryOnlyAuto="false" useFilterList="false"
    		useShiftKey="true" ev:onrowindexchange="scwin.grd_memberList_onrowindexchange">
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header2" style="">
    			<w2:row id="row3" style="">
    				<w2:column blockSelect="false" displayMode="label" id="column9" inputType="text" style="" value="아이디" width="70"></w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="column7" inputType="text" style="" value="성명" width="70"></w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="column5" inputType="text" style="" value="연락처" width="70"></w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="column3" inputType="text" style="" value="지역" width="70"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody2" style="">
    			<w2:row id="row4" style="">
    				<w2:column blockSelect="false" displayMode="label" id="id" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="name" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="tel" inputType="text" style="" value="" width="70"></w2:column>
    				<w2:column blockSelect="false" displayMode="label" id="region" inputType="text" style="" value="" width="70"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:group tagname="table" style="width:100%;" id="" class="w2tb">
    		<w2:attributes>
    			<w2:summary></w2:summary>
    		</w2:attributes>
    		<xf:group tagname="caption"></xf:group>
    		<xf:group tagname="colgroup">
    			<xf:group tagname="col" style="width:25.00%;"></xf:group>
    			<xf:group tagname="col" style="width:25.00%"></xf:group>
    			<xf:group tagname="col" style="width:25.00%"></xf:group>
    			<xf:group tagname="col" style="width:25.00%"></xf:group>
    		</xf:group>
    		<xf:group tagname="tr" style="">
    			<xf:group tagname="th" style="" class="w2tb_th">
    				아이디&amp;nbsp;+&amp;nbsp;성명
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td">
    				<xf:input adjustMaxLength="false" id="ibx_idName2" style="width: 144px;height: 21px;" class="fm_w100"></xf:input>
    			</xf:group>
    			<xf:group tagname="th" style="" class="w2tb_th">
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group tagname="td" style="" class="w2tb_td"></xf:group>
    		</xf:group>
    	</xf:group>
    	<xf:trigger type="button" style="width:199px;height:23px;margin-top:5px;margin-left:5px;" id="btn_trigger1" ev:onclick="scwin.btn_trigger1_onclick">
    		<xf:label><![CDATA[부모 팝업창 함수 호출]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 