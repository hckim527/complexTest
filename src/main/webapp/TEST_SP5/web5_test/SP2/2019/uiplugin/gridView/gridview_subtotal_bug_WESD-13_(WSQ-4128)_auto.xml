scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand('set', $p.id+'wq_uuid_3_scrollY_div.scrollTop = 100');
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand('set', $p.id+'wq_uuid_3_scrollY_div.scrollTop = 0');
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'wq_uuid_3_scrollY_div').style.width != '0px'", "true");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
