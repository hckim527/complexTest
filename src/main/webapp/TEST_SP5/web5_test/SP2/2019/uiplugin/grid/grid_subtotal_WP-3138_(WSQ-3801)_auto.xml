        <script type="text/javascript" lazy="false"><![CDATA[
scwin.fn01_1 = function(val) {
    //debugger;
    var retVal = (val * 1).toFixed(3);
    return retVal;
}
scwin.fn01 = function(n) {
    debugger;
    n = (n * 1).toFixed(3);
    var reg = /(^[+-]?\d+)(\d{3})/; // 정규식
    n += ''; // 숫자를 문자열로 변환
    while (reg.test(n))
        n = n.replace(reg, '$1' + ',' + '$2');
    return n;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'grid3_body_tbody').children[32].children[1].innerText == '67,196.705'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
