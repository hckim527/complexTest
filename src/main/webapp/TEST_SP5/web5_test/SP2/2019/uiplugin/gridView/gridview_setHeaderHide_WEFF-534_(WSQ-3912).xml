<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>

        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var row = 100;
    var col = 3;
    var data = [];
    for (var i = 0; i < row; i++) {
        for (var j = 0; j < col; j++) {
            data.push(i * col + j);
        }
    }
    dataList1.setData(data);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function() {
    gridView1.setHeaderHide(scwin.bHeaderFlag);
    scwin.bHeaderFlag = !scwin.bHeaderFlag;
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.bHeaderFlag = true;
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="data:dataList1" summaryAuto="false" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" id="gridView1" style="position:relative;width:564px;height:272px;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		summaryOnlyAuto="false" useShiftKey="true" dataDragSelect="true" rowStatusVisible="true" rowNumVisible="true" autoFit="allColumn" sortable="true">
    		<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header2" style="">
    			<w2:row id="row3" style="">
    				<w2:column blockSelect="false" id="column7" style="" inputType="text" width="70" value="col1" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column5" style="" inputType="text" width="70" value="col2" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" width="70" inputType="text" value="col3" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody2" style="">
    			<w2:row id="row4" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="textarea" width="70" value="" displayMode="label" disabled="true"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="text" width="70" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" width="70" inputType="text" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
        <xf:trigger id="trigger1" style="position:relative;width:200px;height:30px;" type="button" ev:onclick="scwin.trigger1_onclick">
            <xf:label>setHeaderHide(toggle)</xf:label>
        </xf:trigger>
    </body>
</html>
 