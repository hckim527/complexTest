<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate />
        <xf:model>
            <xf:instance>
                <data xmlns="" />
            </xf:instance>
            <w2:dataCollection baseNode="map"></w2:dataCollection>
            <w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
}
]]></script>
        <style type="text/css"><![CDATA[
        .w2textbox {font-size:23px;width:100% !important;height:40px !important;}
         ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group class="" id="" style="margin-top:20px;">
    		<w2:textbox label="dataType=float maxLength='6.2'" id="" style="width: 400px;height: 23px;"></w2:textbox>
    		<xf:input adjustMaxLength="false" id="" style="width: 144px;height: 21px;margin-top:-5px;" dataType="float" maxlength="6.2">
    		</xf:input>
    	</xf:group>
    	<xf:group class="" id="" style="margin-top:20px;">
    		<w2:textbox id="" label="dataType=float maxLength='6.2' validateOnInput=&quot;true&quot;" style="width: 400px;height: 23px;"></w2:textbox>
    		<xf:input adjustMaxLength="false" dataType="float" id="" maxlength="6.2" style="width: 144px;height: 21px;margin-top:-5px;"
    			validateOnInput="true">
    		</xf:input>
    	</xf:group>
    	<w2:textbox label="paste example : 123456789.123456789" id="" style="font-size:15px;width:100% !important;height:40px;"></w2:textbox>
    </body>
</html>
 