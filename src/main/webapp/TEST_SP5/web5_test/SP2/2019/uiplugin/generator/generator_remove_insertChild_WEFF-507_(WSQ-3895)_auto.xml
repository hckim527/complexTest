        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    for (var idx = 0; idx < 5; idx++) {
        //generator1.insertChild(  );
        scwin.trigger1_onclick();
    }
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    var label = "test";
    var obj = generator1;
    //        var irow = obj.insert();
    var irow = obj.insertChild();
    obj.getChild(irow, "anchor1").setValue(label + irow);
    obj.getChild(irow, "anchor2").setValue("삭제" + irow);
    obj.getChild(irow, "anchor1").focus();
    return irow;
};
scwin.anchor2_onclick = function() {
    this.getGenerator().removeChild(this.getGeneratedIndex());
};
scwin.checkVal = function() {
    return WebSquare.wUnit.getDomById($p.id + 'generator1_5_anchor2') != null
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'generator1_4_anchor2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    /*
    scwin.trigger2_onclick = function(e) {
    	this.getGenerator().removeChild( this.getGeneratedIndex() );
    };
    */
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
