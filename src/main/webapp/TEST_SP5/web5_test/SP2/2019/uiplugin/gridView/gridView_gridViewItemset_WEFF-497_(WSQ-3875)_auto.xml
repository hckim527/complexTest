<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList id="dl_combo" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="chk" name="name3" dataType="text"></w2:column>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.insertRow();
    var comboJSON = [{
        "label": "라벨1",
        "value": "value1",
        "chk": "0"
    }, {
        "label": "라벨2",
        "value": "value2",
        "chk": "1"
    }, {
        "label": "라벨3",
        "value": "value3",
        "chk": "1"
    }, {
        "label": "라벨4",
        "value": "value4",
        "chk": "0"
    }];
    dl_combo.setJSON(comboJSON);
};
scwin.onpageunload = function() {};
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.Dbclick = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireDbClick(el);
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.Dbclick($p.id+'gridView1_cell_0_0')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('G_'+$p.id+'gridView1___selectbox_col1_gridViewItemTable').style.display == 'block'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.Dbclick($p.id+'gridView1_cell_0_1')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('G_'+$p.id+'gridView1___autoComplete_0_col2_col2_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('G_'+$p.id+'gridView1___autoComplete_0_col2_col2_gridViewItemTable').style.display == 'block'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.Dbclick($p.id+'gridView1_cell_0_2')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('G_'+$p.id+'gridView1___checkcombobox_col3_gridViewItemTable').style.display == 'block'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1"
            style="width:799px;height:150px;">
            <w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
            <w2:header id="header2" style="">
                <w2:row id="row3" style="">
                    <w2:column blockSelect="false" id="column7" removeBorderStyle="false" style="" inputType="text" width="141"
                        value="selectbox" displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="141"
                        value="autoComplete" displayMode="label">
                    </w2:column>
                    <w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" width="141" inputType="text"
                        value="checkcombobox" displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody id="gBody2" style="">
                <w2:row id="row4" style="">
                    <w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="select" width="141" value=""
                        displayMode="label">
                        <w2:choices>
                            <w2:gridViewItemset autoFit="allColumn" selectedRowColor="" height="250" visibleRowNum="" rowMouseOver=""
                                rowNumVisible="true" width="400" nodeset="data:dl_combo" value="value" rowMouseOverColor="" label="label"
                                hideHeader="">
                                <w2:item ref="label" style="" hidden="" headerStyle="" header="라벨"></w2:item>
                                <w2:item ref="value" style="" hidden="" headerStyle="" header="값"></w2:item>
                            </w2:gridViewItemset>
                        </w2:choices>
                    </w2:column>
                    <w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="autoComplete" width="141"
                        value="" displayMode="label" allOption="" chooseOption="" ref="">
                        <w2:choices>
                            <w2:gridViewItemset autoFit="" selectedRowColor="" height="240" visibleRowNum="" rowMouseOver="" checkColumn="0"
                                width="300" nodeset="data:dl_combo" value="value" rowMouseOverColor="" label="label" hideHeader="" navBtn="true">
                                <w2:item ref="chk" inputType="checkbox" style="" hidden="" headerStyle="" header="체크박스"></w2:item>
                                <w2:item ref="label" style="" hidden="" headerStyle="" header="라벨"></w2:item>
                                <w2:item ref="value" style="" hidden="" headerStyle="" header="값"></w2:item>
                            </w2:gridViewItemset>
                        </w2:choices>
                    </w2:column>
                    <w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" width="141" inputType="checkcombobox"
                        value="" displayMode="label">
                        <w2:choices>
                            <w2:gridViewItemset autoFit="" selectedRowColor="" height="240" visibleRowNum="" rowMouseOver="" checkColumn="0"
                                width="300" nodeset="data:dl_combo" value="value" rowMouseOverColor="" label="label" hideHeader="" navBtn="true">
                                <w2:item ref="chk" inputType="checkbox" style="" hidden="" headerStyle="" header="체크박스"></w2:item>
                                <w2:item ref="label" style="" hidden="" headerStyle="" header="라벨"></w2:item>
                                <w2:item ref="value" style="" hidden="" headerStyle="" header="값"></w2:item>
                            </w2:gridViewItemset>
                        </w2:choices>
                    </w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
        <xf:checkcombobox appearance="minimal" direction="auto" chooseOption="" id="checkcombobox1"
            style="position: relative;width:266px;height:74px;" search="" displayMode="label" displayAllOptionLabel="false" allOption=""
            disabled="false" submenuSize="auto" ref="" navBtn="true">
            <xf:choices>
                <w2:gridViewItemset hideHeader="" rowMouseOver="" nodeset="data:dl_combo" width="" selectedRowColor="" label="label"
                    visibleRowNum="" autoFit="" value="value" rowMouseOverColor="" height="" checkColumn="0">
                    <w2:item ref="chk" inputType="checkbox" hidden="" header="체크" style="" headerStyle=""></w2:item>
                    <w2:item ref="label" hidden="" header="라벨" style="" headerStyle=""></w2:item>
                    <w2:item ref="value" hidden="" header="값" style="" headerStyle=""></w2:item>
                </w2:gridViewItemset>
            </xf:choices>
        </xf:checkcombobox>
    </body>
</html>
 