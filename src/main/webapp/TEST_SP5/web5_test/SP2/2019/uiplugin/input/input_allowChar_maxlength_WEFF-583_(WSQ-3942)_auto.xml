<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate />
        <xf:model>
            <xf:instance>
                <data xmlns="" />
            </xf:instance>
            <w2:dataCollection baseNode="map"></w2:dataCollection>
            <w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    input1.setAllowChar("5-9.");
};
scwin.trigger2_onclick = function(e) {
    input1.setAllowChar("0-4.");
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
}
]]></script>
        <style type="text/css"><![CDATA[
        .w2textbox {font-size:23px;width:100% !important;height:40px !important;}
         ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group class="" id="" style="margin-top:20px;">
    		<w2:textbox label="dataType=float maxLength='6.2' allowChar=&quot;0-5.&quot;" id="" style="width: 400px;height: 23px;"></w2:textbox>
    		<xf:input adjustMaxLength="false" id="input1" style="width: 144px;height: 21px;margin-top:-5px;" dataType="float"
    			maxlength="6.2" allowChar="0-5.">
    		</xf:input>
    	</xf:group>

    	<xf:trigger type="button" id="trigger1" style="width:184px;height:38px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[setAllowChar("5-9.")]]></xf:label>
    	</xf:trigger>
    	<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width:184px;height:38px;" type="button">
    		<xf:label><![CDATA[setAllowChar("0-4.")]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 