<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="codeList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="code" name="name1" dataType="text"></w2:column>
            			<w2:column id="label" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.setData(["code1", "code1", "code2", "code2"]);
    codeList1.setData(["code1", "label1", "code2", "label2", "code3", "label3", "code4", "label4"]);
};
scwin.onpageunload = function() {};
scwin.fn01 = function(a, b, c, d) {
    return a;
};
scwin.fn02 = function(a) {};
scwin.selectCustom = function(itemArr) {
    var customArr = itemArr;
    /*
    for(var i=0; i<itemArr.length; i++) {
        customArr[i].label = itemArr[i].label + " 라벨";
    }
    
    */
    return customArr;
};
scwin.selectLabelCustom = function(label, value, isOpen) {
    if (isOpen) {
        return label + " " + value;
    } else {
        return value;
    }
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'selectbox1_label').innerText == 'code1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <w2:gridView id="gridView1" style="width: 500px;height: 150px;margin-left:10px;margin-top:10px;" scrollByColumn="false" defaultCellHeight="20"
            scrollByColumnAdaptive="false" dataList="data:dataList1">
            <w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
            <w2:header style="" id="header2">
                <w2:row style="" id="row3">
                    <w2:column removeBorderStyle="false" width="145" inputType="text" style="" id="column5" value="name1"
                        blockSelect="false" displayMode="label">
                    </w2:column>
                    <w2:column removeBorderStyle="false" width="145" inputType="text" style="" id="column3" value="name2"
                        blockSelect="false" displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody style="" id="gBody2">
                <w2:row style="" id="row4">
                    <w2:column removeBorderStyle="false" width="145" inputType="select" style="" id="col1" value="" blockSelect="false"
                        displayMode="value delim label" customFormatter="scwin.fn01" allOption="" chooseOption="" ref="">
                        <w2:choices>
                            <w2:itemset nodeset="data:codeList1">
                                <w2:label ref="label"></w2:label>
                                <w2:value ref="code"></w2:value>
                            </w2:itemset>
                        </w2:choices>
                    </w2:column>
                    <w2:column removeBorderStyle="false" width="145" inputType="select" style="" id="col2" value="" blockSelect="false"
                        displayMode="value delim label" allOption="" chooseOption="" ref="" displayFormatter="scwin.fn02">
                        <w2:choices>
                            <w2:itemset nodeset="data:codeList1">
                                <w2:label ref="label"></w2:label>
                                <w2:value ref="code"></w2:value>
                            </w2:itemset>
                        </w2:choices>
                    </w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
        <w2:textbox label="위 그리드뷰의 col1 과 같이 selectbox를 접었을때와 펼쳤을때 목록의 display 를 다르게 지정할 수 있는 기능이 가능할까요?" id=""
            style="position: relative;width:706px;height:23px;margin-left:10px;margin-top:10px;">
        </w2:textbox>
        <xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" chooseOption="" allOption="" submenuSize="auto"
            direction="auto" id="selectbox1" style="position: relative;width: 148px;height: 21px;margin-left:10px;margin-top:10px;" disabled="false" ref="" displayMode="value delim label" customFormatter="scwin.selectCustom" customLabelFormatter="scwin.selectLabelCustom">
            <xf:choices>
                <xf:itemset nodeset="data:codeList1">
                    <xf:label ref="label"></xf:label>
                    <xf:value ref="code"></xf:value>
                </xf:itemset>
            </xf:choices>
        </xf:select1>
    </body>
</html>
 