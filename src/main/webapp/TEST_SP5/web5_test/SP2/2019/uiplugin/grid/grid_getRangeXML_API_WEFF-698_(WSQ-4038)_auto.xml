<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                	<map>
                		<vector>
                			<map>
                				<stdNo value="11111111" />
                				<korNm value="김영남" />
                				<genNm value="남" />
                				<univNm value="문과대학" />
                				<scalAmt value="1000000" />
                			</map>
                			<map>
                				<stdNo value="22222222" />
                				<korNm value="김대학" />
                				<genNm value="남" />
                				<univNm value="이과대학" />
                				<scalAmt value="1500000" />
                			</map>
                			<map>
                				<stdNo value="33333333" />
                				<korNm value="김미영" />
                				<genNm value="여" />
                				<univNm value="공과대학" />
                				<scalAmt value="2000000" />
                			</map>
                			<map>
                				<stdNo value="44444444" />
                				<korNm value="영남대" />
                				<genNm value="남" />
                				<univNm value="음악대학" />
                				<scalAmt value="2500000" />
                			</map>
                		</vector>
                	</map>
                </data>
            </xf:instance>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.getRangeXML = function() {
    var data = grid1.scwin.getRangeXML(0, 1);
    var str = WebSquare.xml.serialize(data);
    var isHave = str.indexOf("김대학");
    localStorage.setItem("log", isHave);
    //alert(WebSquare.xml.serialize(data));
}
scwin.checkVal = function() {
    return localStorage.getItem('log') == -1;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand('pause', '500');
    //WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand('pause', '100');
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload = function() {
    if (typeof scwin.onpageload === "function") {
        //scwin.onpageload();
    }
    grid1.setXML(WebSquare.ModelUtil.findInstanceNode("map/vector"));
    localStorage.removeItem("log");
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    	<w2:grid baseNode="vector" repeatNode="map"
    		scrollByColumn="false" id="grid1"
    		style="position: absolute ;left: 43px;top: 37px;width:410px;height:157px"
    		readOnly="" readOnlyTabIgnore="" valueNode="value">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column id="column9" style="height:20px"
    					inputType="text" width="70" value="학번">
    				</w2:column>
    				<w2:column id="column7" style="height:20px"
    					inputType="text" width="70" value="성명">
    				</w2:column>
    				<w2:column id="column5" style="height:20px"
    					inputType="text" width="70" value="성별">
    				</w2:column>
    				<w2:column id="column3" style="height:20px"
    					inputType="text" width="70" value="대학">
    				</w2:column>
    				<w2:column id="column1" style="height:20px"
    					width="70" inputType="text" value="장학금">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column id="stdNo" style="height:20px"
    					inputType="text" width="70">
    				</w2:column>
    				<w2:column id="korNm" style="height:20px"
    					inputType="text" width="70">
    				</w2:column>
    				<w2:column id="genNm" style="height:20px"
    					inputType="text" width="70">
    				</w2:column>
    				<w2:column id="univNm" style="height:20px"
    					inputType="text" width="70">
    				</w2:column>
    				<w2:column id="scalAmt" style="height:20px"
    					width="70" inputType="text" dataType="number"
    					displayFormat="#,###">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:grid>
    	<xf:trigger type="button" id="trigger1"
    		style="position: absolute ;height:32px;width:200px;left:482px;top:43px;">
    		<xf:label>getRangeXML(0, 1)</xf:label>
    		<script ev:event="onclick" type="javascript"><![CDATA[
    			scwin.getRangeXML();
    		]]></script>
    	</xf:trigger>
    	<xf:output id="output1"
    		style="position: absolute ;left:483px;top:84px;width:461px;height:21px;color:red;"
    		label="">
    		<xf:label>
    			2.0 엔진에서는 0 번 행만 반환되는데 5.x 엔진에서는 0 ~ 1번행이 반환됨
    		</xf:label>
    	</xf:output>
    </body>
</html>
 