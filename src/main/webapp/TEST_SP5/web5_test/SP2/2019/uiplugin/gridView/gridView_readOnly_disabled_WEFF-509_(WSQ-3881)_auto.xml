<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate />
        <xf:model>
            <xf:instance>
                <data xmlns="" />
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection></w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
        "col1": "가가가",
        "col2": "aaa",
        "col3": 111
    }, {
        "col1": "나나나",
        "col2": "aaa",
        "col3": 111
    }, {
        "col1": "다다다",
        "col2": "aaa",
        "col3": 111
    }, {
        "col1": "라라라",
        "col2": "ddd",
        "col3": 111
    }, {
        "col1": "마마마",
        "col2": "eee",
        "col3": 555
    }];
    dataList1.setJSON(jsonData);
};
scwin.onpageunload = function() {};
scwin.checkVal = function() {
    var browse = navigator.userAgent.toLowerCase();
    var temp = WebSquare.wUnit.getDomById($p.id + 'gridView1_cell_1_2').getAttribute('class');
    if ((navigator.appName == 'Netscape' && browse.indexOf('trident') != -1) || (browse.indexOf("msie") != -1)) {
        return temp.indexOf('w2grid_default_readonly') == 62;
    } else {
        return temp.includes("w2grid_default_readonly");
    }
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
        <style type="text/css"><![CDATA[
            .w2grid_default_readonly {
                background-color:yellow;
            }
            
            .w2grid_default_disabled {
                background-color:green;
            }
            
        ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:group class="" id="group1" style="height: 200px;" tagname="">
            <w2:textbox label='readOnly = "true"' id="textbox1" style="width: 220px;height: 23px;font-size: 22px;"></w2:textbox>
            <w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false"
                id="gridView1" style="width: 500px;height: 150px;" readOnly="" mergeCells="" mergeCol="">
                <w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
                <w2:header id="header2" style="">
                    <w2:row id="row3" style="">
                        <w2:column blockSelect="false" id="column7" removeBorderStyle="false" style="" inputType="text" width="70"
                            value="name1" displayMode="label" readOnly="">
                        </w2:column>
                        <w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70"
                            value="name2" displayMode="label">
                        </w2:column>
                        <w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" width="70" inputType="text"
                            value="name3" displayMode="label">
                        </w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody id="gBody2" style="">
                    <w2:row id="row4" style="">
                        <w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                            displayMode="label" readOnly="true">
                        </w2:column>
                        <w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                            displayMode="label" readOnly="true">
                        </w2:column>
                        <w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" width="70" inputType="text" value=""
                            displayMode="label" readOnly="true" colMerge="true">
                        </w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
        <xf:group class="" id="group2" style="height: 200px;">
            <w2:textbox label='disabled="true"' id="" style="width: 220px;height: 23px;font-size: 22px;"></w2:textbox>
            <w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false"
                id="gridView2" style="width: 500px;height: 150px;" disabledBackgroundColor="" mergeCells="" mergeCol="">
                <w2:caption id="caption3" style="" value="this is a grid caption."></w2:caption>
                <w2:header id="header3" style="">
                    <w2:row id="row5" style="">
                        <w2:column blockSelect="false" id="column13" removeBorderStyle="false" style="" inputType="text" width="70"
                            value="name1" displayMode="label">
                        </w2:column>
                        <w2:column blockSelect="false" id="column11" removeBorderStyle="false" style="" inputType="text" width="70"
                            value="name2" displayMode="label">
                        </w2:column>
                        <w2:column blockSelect="false" id="column9" removeBorderStyle="false" style="" width="70" inputType="text"
                            value="name3" displayMode="label">
                        </w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody id="gBody3" style="">
                    <w2:row id="row6" style="">
                        <w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                            displayMode="label" disabled="true">
                        </w2:column>
                        <w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="text" width="70" value=""
                            displayMode="label" disabled="true">
                        </w2:column>
                        <w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" width="70" inputType="text" value=""
                            displayMode="label" disabled="true" colMerge="true">
                        </w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </xf:group>
    </body>
</html>
 