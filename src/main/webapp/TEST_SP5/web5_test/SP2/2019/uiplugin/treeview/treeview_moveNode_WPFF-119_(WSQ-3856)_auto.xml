        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    var a = dataList1.getAllJSON();
    var b = JSON.stringify(a, null, 2);
    textarea2.setValue(b);
};
scwin.trigger2_onclick = function(e) {
    treeview1.moveNode(5, 2, true);
};
scwin.checkVal = function() {
    var browse = navigator.userAgent.toLowerCase();
    var temp = WebSquare.wUnit.getJq('#textarea2').val();
    if ((navigator.appName == 'Netscape' && browse.indexOf('trident') != -1) || (browse.indexOf("msie") != -1)) {
        return temp.indexOf('"LEVEL_CNT": 3') == -1;
    } else {
        temp.indexOf('"LEVEL_CNT": 3');
        return temp.includes('"LEVEL_CNT": 3') == false;
    }
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.a = dataList1.getAllJSON();
    window.b = JSON.stringify(a, null, 2);
    textarea1.setValue(b);
