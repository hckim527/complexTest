scwin.cusFormatter = function(v, fv, row, col) {
    //debugger;
    fv = "<s>" + fv + "</s>";
    return fv;
};
scwin.fireOver = function(node) {
    if (document.createEventObject) {
        node.fireEvent('onmouseover');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('mouseover', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.onmouseover == 'function') {
        node.onmouseover();
    }
}
scwin.mouseOverBehaviour = function(id) {
    var el = WebSquare.wUnit.getDomById(id);
    scwin.fireOver(el);
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_cell_0_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour('G_'+$p.id+'gridView1___selectbox_col1_gridViewItemTable_gridView_cell_0_1')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#G_gridView1___selectbox_col1_gridViewItemTable_gridView_tooltip').css('display') == 'block'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
