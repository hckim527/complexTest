         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {

    window.common = {};
    common.nextTabFunction = function(compId) {
        window.dest = common.findNextFocusedComp(compId);
        while (dest != undefined) {
            if (dest.getDisabled() !== true && dest.getReadOnly() !== true) {
                dest.focus();
                break;
            }
            dest = common.findNextFocusedComp(dest.id);
        }
    }
    common.findNextFocusedComp = function(compId) {
        window.dest = "";
        window.source = WebSquare.wUnit.getObjById(compId);
        window.idPrefix = source.scope_id == null ? "" : source.scope_id + "_"
        switch (source.getOriginalID()) {
            case "input1":
                dest = "input2";
                break;
            case "input2":
                dest = "selectbox1";
                break;
            case "selectbox1":
                dest = "selectbox2";
                break;
            case "selectbox2":
                dest = "trigger3";
                break;
            case "inputCalendar1":
                dest = "inputCalendar2";
                break;
            case "input3":
                dest = "checkcombobox1";
                break;
            case "checkcombobox1":
                dest = "trigger1";
                break;
            case "selectbox3":
                dest = "selectbox4";
                break;
            case "selectbox4":
                dest = "inputCalendar3";
                break;
        }
        return WebSquare.util.getComponentById(dest, source.scope_id);
    }
    // 공통 키 event 처리
    common.keyEventHandler = function() {
        document.documentElement.addEventListener("keydown", function(e) {
            window.keyCode = (e.charCode) ? e.charCode : e.keyCode;
            window.elem = WebSquare.event.getTarget(e);
            window.className = " " + elem.className + " ";
            if (className.indexOf(" " + "w2selectbox" + " ") >= 0) {
                // selectbox 
                if (keyCode === 40) {
                    // arrow down 
                    window.selectbox = $p.getComponentById(elem.id);
                    selectbox.openSubLayer();
                    WebSquare.event.preventDefault(e); // 방향키의 기본 동작을 막아야 올바로 동작한다.
                }
            } else if (className.indexOf(" " + "w2checkcombobox" + " ") >= 0) {
                // checkcombobox
                if (keyCode === 40) {
                    // arrow down 
                    window.checkcomobobox = $p.getComponentById(elem.id);
                    checkcomobobox.openSubLayer();
                    WebSquare.event.preventDefault(e);
                } else if (keyCode === 187) {
                    // plus
                }
            } else if (className.indexOf(" " + "w2table" + " ") >= 0) {
                // itemTable (selectbox, checkcombobox, autoComplete을 펼쳤을 때 나타나는 목록)
                window.parentCompId = elem.id.slice(0, elem.id.length - 10);
                window.parentComp = $p.getComponentById(parentCompId); // 목록에 해당하는 부모 객체
                if (keyCode === 9 || keyCode === 13) {
                    parentComp.closeSubLayer();
                    common.nextTabFunction(parentCompId);
                    WebSquare.event.preventDefault(e); // tab이나 enter키 기본 동작을 막아야 올바로 동작한다. 
                }
            }
        });
    }
	
    var data1 = [];
    var data2 = [];
    for (var i = 0; i < 10; i++) {
        for (var j = 0; j < 4; j++) {
            data1.push(i);
            data2.push(i * 4 + j);
        }
    }
    dataList2.setData(data2);
    dataList1.setData(data1);
    common.keyEventHandler();
}
scwin.onpageunload = function() {};
scwin._triggerKeyboardEvent = function(el, keyCode) {
    var eventObj = document.createEventObject ?
        document.createEventObject() : document.createEvent("Events");
    if (eventObj.initEvent) {
        eventObj.initEvent("keydown", true, true);
    }
    eventObj.keyCode = keyCode;
    eventObj.which = keyCode;
    el.dispatchEvent ? el.dispatchEvent(eventObj) : el.fireEvent("onkeydown", eventObj);
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+$p.id+'selectbox1_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin._triggerKeyboardEvent(document.activeElement, 40)");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin._triggerKeyboardEvent(document.activeElement, 40)");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin._triggerKeyboardEvent(document.activeElement, 13)");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "document.activeElement.getAttribute('id') == $p.id+'selectbox2'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'checkcombobox1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin._triggerKeyboardEvent(document.activeElement, 40)");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin._triggerKeyboardEvent(document.activeElement, 40)");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin._triggerKeyboardEvent(document.activeElement, 13)");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "document.activeElement.getAttribute('id') == $p.id+'trigger1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

]]></script>
