scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "document.getElementsByTagName('caption')[0].getAttribute('id') == $p.id+'gridView1_caption1'", "true");
