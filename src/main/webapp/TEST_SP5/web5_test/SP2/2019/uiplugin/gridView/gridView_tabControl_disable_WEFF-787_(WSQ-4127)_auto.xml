scwin.onpageload = function() {
    dlSpltNo.setJSON([{
        "label": "1",
        "value": "1"
    }, {
        "label": "2",
        "value": "2"
    }, {
        "label": "3",
        "value": "3"
    }]);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    dlDgCgo.setJSON([{
        "spltNo": "2"
    }, {
        "spltNo": "1"
    }, {
        "spltNo": "3"
    }]);
};
scwin.trigger2_onclick = function(e) {
    tacSpclCgo.disableTab(0);
    tacSpclCgo.disableTab(1);
    tacSpclCgo.disableTab(2);
    tacSpclCgo.disableTab(3);
};
scwin.trigger3_onclick = function(e) {
    tacSpclCgo.enableTab(0);
    tacSpclCgo.disableTab(1);
    tacSpclCgo.disableTab(2);
    tacSpclCgo.disableTab(3);
};
scwin.checkVal = function() {
    var class_name = WebSquare.wUnit.getJq('#grvDgSplt_cell_0_0').attr('class');
    return class_name.indexOf("w2grid_default_disabled") >= 0;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "false");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
