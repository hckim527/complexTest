    	</w2:anchor>
    	<w2:textbox label='placeholder="placeholder test" 로 설정 시 noResult에 따른 동작' id="" style="width:532px;height:23px;"></w2:textbox>
    	<xf:group tagname="table" id="" style="width:500px;" class="w2tb">
