<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="number"></w2:column>
            			<w2:column id="col2" name="name2" dataType="number"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var arr = ["0", "0"];
    dataList1.setData(arr);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    //type이 0인 경우 실제 데이터 1인 경우 눈에 보이는 데이터를  2이면 들어가 있는 data 그대로(filter무시 expression 타입의 셀은 나오지 않음)
    var options = {};
    //options.type = 0;
    //options.type = 1;
    options.fileName = "test.xlsx";
    options.useDataFormat = "true";
    //options.numberToText="true";
    gridView1.advancedExcelDownload(options);
};
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_0_0').innerText == '0.00'", "true");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="data:dataList1" summaryAuto="false" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" id="gridView1" style="position: absolute ;left: 60px;top: 100px;width: 390px;height: 216px;"
    		ignoreCellClick="false" syncScroll="false" ignoreToggleOnDisabled="false" summaryOnlyAuto="false" useShiftKey="true">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="name2" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="text" width="70" value="" displayMode="label"
    					displayFormat="#0.00" dataType="number">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" style="" width="70" inputType="text" value="" displayMode="label"
    					displayFormat="##.00">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger ev:onclick="scwin.trigger1_onclick" id="trigger1"
    		style="position: absolute ;left:64px;top:26px;width: 221px;height: 56px;" type="button">
    		<xf:label><![CDATA[excelDownload]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 