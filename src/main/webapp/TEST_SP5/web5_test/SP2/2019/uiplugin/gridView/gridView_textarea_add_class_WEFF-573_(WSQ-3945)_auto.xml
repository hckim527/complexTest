<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[aaa]]></col1>
            				<col2><![CDATA[bbb]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[ccc]]></col1>
            				<col2><![CDATA[ddd]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <style type="text/css">
        
            .a {
                background-color:#C0C0C0;
            }
        
            .b {
                font-color:#FF0000;
            }
            
            .c {
                text-align:right;             
            }
            
            .d{
                color:orange;
            }
        </style>
         <script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
    var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
    var r = d(id); if (r) return r;
    var s = dd(P + id); r = d(s); if (r) return r;
    var g = s.indexOf('G_');
    if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
    return d(s.replace(P, ''));
};
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.Dbclick = function(id) {
    var el = scwin.__getDom($p.id + id);
    scwin.fireDbClick(el);
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView id="gridView1" style="width: 500px;height: 150px;" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false"
    		dataList="data:dataList1">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column3" value="name1"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="column1" value="name2"
    					blockSelect="false" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px" id="col1" value=""
    					blockSelect="false" displayMode="label" class="a b c">
    				</w2:column>
    				<w2:column removeBorderStyle="false" width="70" inputType="textarea" style="height:20px" id="col2" value=""
    					blockSelect="false" displayMode="label" class="a b c" keepCellClass="true">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 