    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.udc_Multi_onDone = function(data) {
    //  		debugger;
    var dataList1 = window[udc_Multi.UDC_DLT_MPD_ID];
    grp_iframe.clearChildren();
    for (var i = 0; i < data.length; i++) {
        for (var j = 0; j < dataList1.getTotalRow(); j++) {
            if (dataList1.getCellData(j, "name") == data[i].localFile) {
                dataList1.setCellData(j, "key", data[i].key);
                dataList1.setCellData(j, "file", data[i].file);
            }
        }
        WebSquare.util.dynamicCreate("iframe" + i, "iframe", {
            style: "display:none;"
        }, grp_iframe);
    }
};
scwin.downLoadFile = function() {
    alert("버튼동작");
    var inx = 0;
    var dataList1 = window[udc_Multi.UDC_DLT_MPD_ID];
    for (var j = 0; j < dataList1.getTotalRow(); j++) {
        if (dataList1.getCellData(j, "key")) {
            var fileUrl = dataList1.getCellData(j, "key");
            var fileName = dataList1.getCellData(j, "file");
            var realFile = dataList1.getCellData(j, "name");
            //					var url = "/bccard/jsp/downLoadFile.jsp?fileUrl="+fileUrl+"&fileName="+fileName+"&realFile="+realFile;
            var url = "/keri/jsp/downLoadFile.jsp?fileUrl=" + fileUrl + "&fileName=" + fileName + "&realFile=" + realFile;
            if (inx == 0) {
                iframe0.setSrc(url);
            } else if (inx == 1) {
                iframe1.setSrc(url);
            } else if (inx == 2) {
                iframe2.setSrc(url);
            } else if (inx == 3) {
                iframe3.setSrc(url);
            } else if (inx == 4) {
                iframe4.setSrc(url);
            } else if (inx == 5) {
                iframe5.setSrc(url);
            } else if (inx == 6) {
                iframe6.setSrc(url);
            } else if (inx == 7) {
                iframe7.setSrc(url);
            } else if (inx == 8) {
                iframe8.setSrc(url);
            } else if (inx == 9) {
                iframe9.setSrc(url);
            }
            inx++;
        }
    }
};
scwin.btn_1_onclick = function(e) {
    udc_Multi.getValue_1();
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>

