         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var data1 = [];
    var data2 = [];
    var data3 = [];
    var data_grid = [];
    var data5 = [];
    var row = 10;
    var col = 3;
    for (var i = 0; i < row; i++) {
        for (var j = 0; j < col; j++) {
            if (j === 0) {
                data1.push("label=" + String(i));
                data2.push("L=" + String(i));
                data3.push("_L_:" + String(i));
                data_grid.push("GV:" + String(i));
                data5.push("GL:" + String(i));
            } else if (j === 1) {
                data1.push("value=" + String(i));
                data2.push("V=" + String(i));
                data3.push("_V_:" + String(i));
                data_grid.push("GV:" + String(i));
                data5.push("GV:" + String(i));
            } else {
                data1.push("dummy=" + String(i));
                data2.push("D=" + String(i));
                data3.push("_d_:" + String(i));
                data_grid.push("GV:" + String(i));
                data5.push("GD:" + String(i));
            }
        }
    }
    dataList1.setData(data1);
    dataList2.setData(data2);
    dataList3.setData(data3);
    dataList5.setData(data5);
    dataList6.setData(data5.slice(0));
    dataList7.setData(data5.slice(0));
    dataList_grid.setData(data_grid);
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {};
scwin.selectbox1_onviewchange = function(info) {
    textarea1.setValue(textarea1.getValue() + "\n" + JSON.stringify(info));
}
scwin.gridView1_onviewchange = function(info) {
    textarea2.setValue(textarea2.getValue() + "\n" + JSON.stringify(info));
}
scwin._triggerKeyboardEvent = function(el, keyCode) {
    var eventObj = document.createEventObject ?
        document.createEventObject() : document.createEvent("Events");
    if (eventObj.initEvent) {
        eventObj.initEvent("keydown", true, true);
    }
    eventObj.keyCode = keyCode;
    eventObj.which = keyCode;
    el.dispatchEvent ? el.dispatchEvent(eventObj) : el.fireEvent("onkeydown", eventObj);
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'selectbox1_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin._triggerKeyboardEvent(document.activeElement, 40)");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'selectbox1_label').innerText == 'L=1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'textarea1').value != ''", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
