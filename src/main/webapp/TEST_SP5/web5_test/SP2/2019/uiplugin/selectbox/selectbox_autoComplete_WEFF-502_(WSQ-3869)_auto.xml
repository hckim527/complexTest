<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="label" name="name1" dataType="text"></w2:column>
                        <w2:column id="value" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var dl_json = [{
        "label": "라벨1",
        "value": "값1",
        "col3": ""
    }, {
        "label": "라벨2",
        "value": "값2",
        "col3": ""
    }, {
        "label": "라벨3",
        "value": "값3",
        "col3": ""
    }, {
        "label": "라벨4",
        "value": "값4",
        "col3": ""
    }, {
        "label": "라벨5",
        "value": "값5",
        "col3": ""
    }, {
        "label": "라벨6",
        "value": "값6",
        "col3": ""
    }, {
        "label": "라벨7",
        "value": "값7",
        "col3": ""
    }];
    dataList1.setJSON(dl_json);
};
scwin.onpageunload = function() {};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'autoComplete1_label').innerText == ''", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:group id="" style="height: 80px;">
            <w2:textbox label="selectbox" id="" style="width: 150px;height: 23px;font-size: 22px;"></w2:textbox>
            <xf:select1 id="selectbox1" disabledClass="w2selectbox_disabled" ref="" appearance="minimal" chooseOptionLabel="$blank"
                style="width: 148px;height: 21px;" direction="auto" chooseOption="true" allOption="true" disabled="false"
                submenuSize="auto">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList1">
                        <xf:label ref="label"></xf:label>
                        <xf:value ref="value"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
        </xf:group>
        <xf:group id="" style="height: 80px;">
            <w2:textbox label="checkcombobox" id="" style="width: 150px;height: 23px;font-size: 22px;"></w2:textbox>
            <xf:checkcombobox id="checkcombobox1" displayAllOptionLabel="false" appearance="minimal" style="width: 148px;height: 21px;"
                search="" direction="auto" chooseOption="true" allOption="true" displayMode="label" submenuSize="auto" disabled="false"
                chooseOptionLabel="$blank" ref="">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList1">
                        <xf:label ref="label"></xf:label>
                        <xf:value ref="value"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:checkcombobox>
            
        </xf:group>
        <xf:group id="" style="height: 80px;">
            <w2:textbox label="autoComplete" id="" style="width: 150px;height: 23px;font-size: 22px;"></w2:textbox>
            <w2:autoComplete interactionMode="" id="autoComplete1" ref="" useKeywordHighlight="false" chooseOptionLabel="$blank"
                style="width: 148px;height: 21px;" search="start" chooseOption="true" allOption="true" editType="select"
                submenuSize="auto">
                <w2:choices>
                    <w2:itemset nodeset="data:dataList1">
                        <w2:label ref="label"></w2:label>
                        <w2:value ref="value"></w2:value>
                    </w2:itemset>
                </w2:choices>
            </w2:autoComplete>
        </xf:group></body>
</html>
 