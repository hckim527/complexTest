};
scwin.setChart = function() {
    var maxChartSlAmt = dlt_vstOrdAllChartList.getRowJSON(0).maxChartSlAmt;
    var options = {
        pYAxisName: "유입수(PV)" // 좌측 Y축라벨
            ,
        pYAxisNameFont: "Arial" // 좌측 Y축라벨 폰트
            ,
        outCnvBaseFontSize: "11" // 캔버스 폰트 size
            ,
        sYAxisName: "주문전환율" // 우측 Y축라벨
            ,
        sYAxisNameFont: "Arial" // 좌측 Y축라벨 폰트
            ,
        sNumberSuffix: "%" // 우측 접미사
            //			, sYAxisMaxValue : scwin.isEmpty(maxChartSlAmt) ? "100" : maxChartSlAmt		// 우측 Y축 최대값 (데이터바인딩에 따라 유동적으로 변경됨)
            //			, pYAxisMaxValue : scwin.isEmpty(maxChartSlAmt) ? "500000" : maxChartSlAmt		// 좌측 Y축 최대값 (데이터바인딩에 따라 유동적으로 변경됨)
            ,
        labelFontSize: "12" // x축 라벨 font size
            ,
        showXAxisLine: "1" // x축 라인 표시
            ,
        drawCrossLine: "0" // 크로스라인툴팁 표시
            ,
        plottooltext: "<font size='2'><b>$dataValue원</b></font> $label, $seriesName<br/>위너상품수 : $displayValue<br/>" // 툴팁 메시지
            //			, plottooltext : "$seriesName,,," + ("$seriesName" === "매출금액" ? "1111" : "2222")		// 툴팁 메시지
            //			, plottooltext : "value : $value, dataValue : $dataValue, label : $label, displayValue : $displayValue, <br/>"
            //			+ "svalue : $svalue, seriesName : $seriesName, xAxisName : $xAxisName, xValue : $xValue, xDataValue : $xDataValue, <br/>"
            //			+ "yAxisName : $yAxisName, yValue : $yValue, yDataValue : $yDataValue, name : $name"		// 툴팁 메시지
            //			, paletteColors : ["#FF4B58", "#FFABB1"]							// 라인 색
            ,
        legendNumColumns: "4" // legend 열 수
            ,
        legendItemFontSize: "12" // legend 폰트 size
            ,
        legendItemFontColor: "#666666" // legend 폰트 color
            ,
        legendBorderThickness: "0" // legend 테두리 두께
            ,
        legendShadow: "0" // legend 그림자 효과
            ,
        chartLeftMargin: "80" // 차트 left margin
            ,
        chartTopMargin: "50" // 차트 top margin
            ,
        chartRightMargin: "80" // 차트 right margin
            ,
        chartBottomMargin: "20" // 차트 bottom margin
            ,
        showPlotBorder: "0" // 차트 막대기 테두리
            ,
        plotBorderThickness: "0" // 차트 막대기 두께
    }
    fct_vstOrdAll.setChartAttribute(options);
    // 차트 색 설정
    var colorArr = ["#4D51A9", "#A3A5D5"];
    fct_vstOrdAll.setPlotColor(colorArr);
    //2019-11-26 트렌드 라인 적용
    var tOptions = {
        startValue: 70000,
        color: "#00B050",
        displayValue: "TrendLine",
        thickness: "2",
        showOnTop: "1"
    };
    fct_vstOrdAll.addTrendLine(tOptions);
    fct_vstOrdAll.draw();
};
scwin.isEmpty = function(str) {
    if (str == null || str == "") {
        return true;
    }
    return false;
};
scwin.chartCheck = function() {
    //var className = 'raphael-group-32-axisReferenceVisualsTop';
    //var el = document.getElementsByClassName(className)[0];
    var el = document.querySelectorAll('[class*="-axisReferenceVisualsTop"]')[0]
    return el.children.length == 1;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "1000");
    WebSquare.wUnit.addCommand("assert", "scwin.chartCheck()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
