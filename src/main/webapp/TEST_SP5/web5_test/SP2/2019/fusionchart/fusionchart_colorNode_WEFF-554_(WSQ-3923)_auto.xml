		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "1500");
    WebSquare.wUnit.addCommand("assert", "scwin.getChartFillValue() == '#e44a00'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.getChartFillValue = function() {
	var majorVersion = FusionCharts.version[0];
    var minorVersion = FusionCharts.version[1];
    var noResultText = "";
    var queryString;
    if (majorVersion > 3 || (majorVersion == 3 && minorVersion > 11)) {
        queryString = "svg g[class*='plot'] rect";
    } else {
        queryString = "svg g[class*='columns'] rect";
    }
    var chartElem = WebSquare.wUnit.getDomById($p.id+'fusionchart2').querySelector(queryString);
    var value = chartElem.getAttribute('fill');
	return value;
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
