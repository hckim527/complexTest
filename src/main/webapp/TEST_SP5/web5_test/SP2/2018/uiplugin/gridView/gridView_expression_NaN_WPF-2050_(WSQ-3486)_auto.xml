        <script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('wq_uuid_4_body_tbody').querySelectorAll('nobr')[7].innerText == '0'", "true");
