<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map"></w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#autoComplete2').hasClass('w2autoComplete_mandatory') == false", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    	<style type="text/css"><![CDATA[
    	.w2autoComplete_mandatory{background-color:red;}
    	 ]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:textbox label='readOnly="true"' style="width: 150px;height: 23px;" id="textbox1"></w2:textbox>
    	<w2:autoComplete allOption="" chooseOption="" displayMode="label" editType="select" id="autoComplete2" interactionMode="" ref=""
    		search="start" style="width: 148px;height: 21px;" submenuSize="auto" useKeywordHighlight="false" visibleRowNum="5" readOnly="true">
    		<w2:choices>
    			<w2:item>
    				<w2:label><![CDATA[test1]]></w2:label>
    				<w2:value><![CDATA[a]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[test2]]></w2:label>
    				<w2:value><![CDATA[b]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[test3]]></w2:label>
    				<w2:value><![CDATA[c]]></w2:value>
    			</w2:item>
    		</w2:choices>
    	</w2:autoComplete>
    	<w2:textbox label='mandatory="true"' style="width: 150px;height: 23px;" id="textbox2"></w2:textbox>
    	<w2:autoComplete allOption="" chooseOption="" displayMode="label" editType="select" id="autoComplete3" interactionMode="" ref=""
    		search="start" style="width: 148px;height: 21px;" submenuSize="auto" useKeywordHighlight="false" visibleRowNum="5" mandatory="true">
    		<w2:choices>
    			<w2:item>
    				<w2:label><![CDATA[test1]]></w2:label>
    				<w2:value><![CDATA[a]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[test2]]></w2:label>
    				<w2:value><![CDATA[b]]></w2:value>
    			</w2:item>
    			<w2:item>
    				<w2:label><![CDATA[test3]]></w2:label>
    				<w2:value><![CDATA[c]]></w2:value>
    			</w2:item>
    		</w2:choices>
    	</w2:autoComplete>
    </body>
</html>
 