<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text" defaultValue="$blank"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[100]]></col1>
            				<col3><![CDATA[test]]></col3>
            				<col2><![CDATA[]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[200]]></col1>
            				<col3><![CDATA[test]]></col3>
            				<col2><![CDATA[250]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[300]]></col1>
            				<col3><![CDATA[test]]></col3>
            				<col2><![CDATA[]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[400]]></col1>
            				<col2><![CDATA[]]></col2>
            				<col3><![CDATA[test]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="code" name="name0" dataType="text"></w2:column>
                        <w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<code><![CDATA[100]]></code>
                            <label><![CDATA[100]]></label>
            				<value><![CDATA[100]]></value>
            			</w2:row>
                        <w2:row>
                            <code><![CDATA[100]]></code>
                            <label><![CDATA[150]]></label>
                            <value><![CDATA[150]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[200]]></code>
                            <label><![CDATA[200]]></label>
                            <value><![CDATA[200]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[200]]></code>
                            <label><![CDATA[250]]></label>
                            <value><![CDATA[250]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[300]]></code>
                            <label><![CDATA[300]]></label>
                            <value><![CDATA[300]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[300]]></code>
                            <label><![CDATA[350]]></label>
                            <value><![CDATA[350]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[400]]></code>
                            <label><![CDATA[400]]></label>
                            <value><![CDATA[400]]></value>
                        </w2:row>
                        <w2:row>
                            <code><![CDATA[400]]></code>
                            <label><![CDATA[450]]></label>
                            <value><![CDATA[450]]></value>
                        </w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:linkedDataList id="linkedDataList1" bind="dataList2">
            		<w2:condition type="filter"><![CDATA[code == ref('data:dataList1.col1')]]></w2:condition>
            		<w2:condition type="sort"><![CDATA[]]></w2:condition>
            	</w2:linkedDataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    //init
    // WebSquare.wUnit.start();
    //Test step 1. 샘플실행 후 ctrl + 마우스우클릭 > 로그보기 > dataCollection보기 클릭 > dataList1 선택 후 조회버튼 클릭하여 dataList1의 3번째 row의 col2값과 4번째 row의 col2값을 확인한다.
    //1. After executing sample, ctrl + right mouse click> View log> click dataCollection view> Select dataList1 and click the inquiry button to check the col2 value of the third row of dataList1 and the col2 value of the fourth row.
    //Verify step 1. The values '300' and '400' are displayed normally.(Previously shown as '100', '100' values)
    WebSquare.wUnit.addCommand("assert", "WebSquare.DataCollection.comp.mf_dataList1.dataArr[7] == '300'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.DataCollection.comp.mf_dataList1.dataArr[10] == '400'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 02-Mar-2018
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" summaryAuto="false" useFilterList="false" scrollByColumn="false" showSortableUseFilter="false"
    		scrollByColumnAdaptive="false" id="gv1" style="position: relative;width:500px;height:96px;" ignoreCellClick="false"
    		ignoreToggleOnDisabled="false" summaryOnlyAuto="false" useShiftKey="true">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1" style="height:20px" width="70" inputType="text" displayMode="label"
    					value="name3">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" inputType="select" width="70" displayMode="label"
    					allOption="" chooseOption="" selectedIndex="0">
    					<w2:choices>
    						<w2:itemset nodeset="data:linkedDataList1">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 