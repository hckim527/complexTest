                        <w2:column id="col5" name="name3" dataType="text"></w2:column>
                        <w2:column id="col6" name="name3" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="label" name="name1" dataType="text"></w2:column>
                        <w2:column id="value" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    /*
		var jsonData=[
            {"col1":"aaa","col2":"1111","col3":"20181123"}
            ,{"col1":"bbb","col2":"2222","col3":"20181125"}
            ,{"col1":"ccc","col2":"3333","col3":"20181122"}
            ,{"col1":"ddd","col2":"4444","col3":"20181120"}
        ];
        //dataList1.setJSON(jsonData);
        
        */
    var acData = [{
        "label": "라벨1",
        "value": "밸류1"
    }, {
        "label": "라벨2",
        "value": "밸류2"
    }, {
        "label": "라벨3",
        "value": "밸류3"
    }, {
        "label": "라벨4",
        "value": "밸류4"
    }];
    dataList2.setJSON(acData);
    dataList1.insertRow();
};
scwin.onpageunload = function() {};
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate = function() {
    scwin.simulateWrapper('#gridView1_cell_0_0', 'key-sequence', {
        sequence: 'z'
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_cell_0_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_cell_0_1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_0_0').innerText == 'z'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <w2:gridView id="gridView1" style="width: 500px;height: 150px;" scrollByColumn="false" defaultCellHeight="20"
