<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    tabControl1.disableTab(selectbox1.getValue());
};
scwin.trigger2_onclick = function(e) {
    tabControl1.enableTab(selectbox1.getValue());
};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('wq_uuid_6').getAttribute('disabled')", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('wq_uuid_7').getAttribute('disabled')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 1
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 2
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('wq_uuid_6').getAttribute('disabled')", "false");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('wq_uuid_7').getAttribute('disabled')", "false");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function unitTest
    //Create by park
    //Create date 29-jun3-2018
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[disableTab]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[enableTab]]></xf:label>
    	</xf:trigger>
    	<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" direction="auto" chooseOption="" id="selectbox1"
    		style="position: relative;width: 148px;height: 21px;" displayMode="label" optionOrder="false" allOption="" disabled="false"
    		submenuSize="auto" ref="">
    		<xf:choices>
    			<xf:item>
    				<xf:label><![CDATA[tab1]]></xf:label>
    				<xf:value><![CDATA[0]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[tab2]]></xf:label>
    				<xf:value><![CDATA[1]]></xf:value>
    			</xf:item>
    			<xf:item>
    				<xf:label><![CDATA[tab3]]></xf:label>
