    				<xf:value><![CDATA[3]]></xf:value>
    			</xf:item>
    		</xf:choices>
    	</xf:select1>
    	<w2:tabControl useMoveNextTabFocus="false" id="tabControl1" style="position: relative ;width: 500px;height: 200px;" forceChildCompEnabled="true"
    		confirmTrueAction="exist" useTabKeyOnly="true" useConfirmMessage="false" confirmFalseAction="new" alwaysDraw="false">
    		<w2:tabs label="tab1" id="tabs1" style="width:70px;height:30px;" disabled="false"></w2:tabs>
    		<w2:tabs id="tabs2" style="width:70px;height:30px" label="tab2" disabled="false"></w2:tabs>
    		<w2:content id="content1" style="height:170px" alwaysDraw="false">
    			<w2:autoComplete chooseOption="" search="start" displayMode="label" useKeywordHighlight="false" submenuSize="auto"
    				visibleRowNum="5" id="" style="position: relative;width: 148px;height: 21px;" interactionMode="" editType="select" allOption=""
    				ref="" disabled="true">
    				<w2:choices>
    					<w2:item>
    						<w2:label><![CDATA[new row]]></w2:label>
    						<w2:value><![CDATA[]]></w2:value>
    					</w2:item>
    					<w2:item>
    						<w2:label><![CDATA[new row]]></w2:label>
    						<w2:value><![CDATA[]]></w2:value>
    					</w2:item>
    					<w2:item>
    						<w2:label><![CDATA[new row]]></w2:label>
    						<w2:value><![CDATA[]]></w2:value>
    					</w2:item>
    				</w2:choices>
    			</w2:autoComplete>
    			<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" direction="auto" chooseOption="" id=""
    				style="position: relative;width: 148px;height: 21px;" displayMode="label" optionOrder="false" allOption="" disabled="false"
    				submenuSize="auto" ref="">
    				<xf:choices>
    					<xf:item>
    						<xf:label><![CDATA[new row]]></xf:label>
    						<xf:value><![CDATA[]]></xf:value>
    					</xf:item>
    					<xf:item>
    						<xf:label><![CDATA[new row]]></xf:label>
    						<xf:value><![CDATA[]]></xf:value>
    					</xf:item>
    					<xf:item>
    						<xf:label><![CDATA[new row]]></xf:label>
    						<xf:value><![CDATA[]]></xf:value>
    					</xf:item>
    					<xf:item>
    						<xf:label><![CDATA[new row]]></xf:label>
    						<xf:value><![CDATA[]]></xf:value>
    					</xf:item>
    				</xf:choices>
    			</xf:select1>
    		</w2:content>
    		<w2:content id="content2" style="height:170px" alwaysDraw="false"></w2:content>
    	</w2:tabControl>
    </body>
</html>
 