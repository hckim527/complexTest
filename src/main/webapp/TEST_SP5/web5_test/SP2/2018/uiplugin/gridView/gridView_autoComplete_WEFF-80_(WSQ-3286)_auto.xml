        <script type="text/javascript" lazy="false"><![CDATA[
scwin.doInit = function() {
    var v_node = WebSquare.ModelUtil.findInstanceNode("response/RES_SELECT_EMP_LIST/vector");
    grd_EmpList.setXML(v_node);
}
scwin.dbClick = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireDbClick(el);
}
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#G_grd_EmpList___autoComplete_0_DEPTNO_DEPTNO_input', 'key-sequence', {
        sequence: '111'
    })
}
scwin.checkVal = function() {
    return typeof WebSquare.wUnit.getDomById("G_"+$p.id+"grd_EmpList___autoComplete_0_DEPTNO_DEPTNO_input") == 'object';
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 1. 샘플실행 후 text항목의 첫번째 row에 마우스를 더블클릭한다.
    //1. After running the sample, double-click on the first row of the text item.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.dbClick($p.id+'grd_EmpList_cell_0_0')");
    WebSquare.wUnit.addCommand("pause", "100");
    //Verify step 1. edit모드로 변경되어진다.(이전에는 edit모드로 들어가지 않고 cell 바깥으로 포커스가 들어가서 바로 입력되지 않음)
    //1. It is changed to edit mode (it does not go into edit mode before, but focuses outside of cell and is not input immediately)
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    //Test step 2. '111'을 입력하고 Enterkey를 실행 시 정상적으로 입력되는지 확인한다.
    //2. Enter '111' and check if input is normally done by executing Enterkey.
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "1000");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('grd_EmpList_cell_0_1').click()");
    WebSquare.wUnit.addCommand("pause", "100");
    //Verify step 2. '111'값이 정상적으로 입력되어진다.(이전에도 동작은 동일하게 수행되어짐)
    // 2. The '111' value is entered normally (the operation is performed in the same way as before)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('grd_EmpList_cell_0_0').innerText == '111'", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
