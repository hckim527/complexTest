<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[a]]></col1>
            				<col2><![CDATA[aa]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[b]]></col1>
            				<col2><![CDATA[bb]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[c]]></col1>
            				<col2><![CDATA[cc]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[d]]></col1>
            				<col2><![CDATA[dd]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                        <w2:column id="col5" name="name5" dataType="text"></w2:column>
                        <w2:column id="col6" name="name6" dataType="text"></w2:column>
                        <w2:column id="col7" name="name7" dataType="text"></w2:column>
                        <w2:column id="col8" name="name7" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
                        <w2:row></w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <style>
            .test_class {
                background : none !important;
                background-color : #00ccff !important;
            }
        </style>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    gridView1.setColumnVisible('col2', false);
    gridView1.setColumnVisible('col3', false);
};
scwin.trigger2_onclick = function(e) {
    gridView1.setFixedRightColumn(5)
};
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    // Test step 1.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1.
    //1.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_column2').css('width') == '0px'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_column3').css('width') == '0px'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 2.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    // verify step 2.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_column3').css('width') == '0px'", "true");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function unitTest
    //Created By: park
    //Created By: 28-june-2018	
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]>
        </script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:group class="sub_contents" id="" style="">
        	<w2:gridView dataList="data:dataList2" summaryAuto="false" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20"
        		scrollByColumnAdaptive="false" id="gridView1" style="position: relative;width:607px;height:250px;" ignoreCellClick="false"
        		syncScroll="false" ignoreToggleOnDisabled="false" summaryOnlyAuto="false" useShiftKey="true" rowNumVisible="false">
        		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
        		<w2:header id="header1" style="">
        			<w2:row id="row1" style="">
        				<w2:column blockSelect="false" id="column1" style="" inputType="text" width="70" value="col1" displayMode="label"></w2:column>
        				<w2:column blockSelect="false" id="column2" style="" width="70" inputType="text" value="col2" displayMode="label"></w2:column>
                        <w2:column blockSelect="false" id="column3" style="" inputType="text" width="70" value="col3" displayMode="label"></w2:column>
                        <w2:column blockSelect="false" id="column4" style="" width="70" inputType="text" value="col4" displayMode="label"></w2:column>
                        <w2:column blockSelect="false" id="column5" style="" inputType="text" width="70" value="col5" displayMode="label"></w2:column>
                        <w2:column blockSelect="false" id="column6" style="" width="70" inputType="text" value="col6" displayMode="label"></w2:column>
                        <w2:column blockSelect="false" id="column7" style="" width="70" inputType="text" value="col7" displayMode="label"></w2:column>
                        <w2:column blockSelect="false" id="column8" style="" width="70" inputType="text" value="col8" displayMode="label"></w2:column>
        			</w2:row>
        		</w2:header>
        		<w2:gBody id="gBody1" style="">
        			<w2:row id="row2" style="">
        				<w2:column blockSelect="false" id="col1" style="" inputType="select" width="70" value="" displayMode="label"
        					allOption="" chooseOption="" ref="">
        					<w2:choices>
        						<w2:itemset nodeset="data:dataList1">
        							<w2:label ref="col1"></w2:label>
        							<w2:value ref="col2"></w2:value>
        						</w2:itemset>
        					</w2:choices>
        				</w2:column>
        				<w2:column blockSelect="false" id="col2" style="" width="70" inputType="autoComplete" value="" displayMode="label"
        					allOption="" chooseOption="" ref="">
        					<w2:choices>
        						<w2:itemset nodeset="data:dataList1">
        							<w2:label ref="col2"></w2:label>
        							<w2:value ref="col1"></w2:value>
        						</w2:itemset>
        					</w2:choices>
        				</w2:column>
                        <w2:column blockSelect="false" id="col3" style="" width="70" inputType="text" value=""></w2:column>
                        <w2:column blockSelect="false" id="col4" style="" width="70" inputType="text" value=""></w2:column>
                        <w2:column blockSelect="false" id="col5" style="" width="70" inputType="text" value=""></w2:column>
                        <w2:column blockSelect="false" id="col6" style="" width="70" inputType="text" value=""></w2:column>
                        <w2:column blockSelect="false" id="col7" style="" width="70" inputType="text" value=""></w2:column>
                        <w2:column blockSelect="false" id="col8" style="" width="70" inputType="text" value=""></w2:column>
        			</w2:row>
        		</w2:gBody>
        	</w2:gridView>
        	<xf:trigger type="button" id="trigger1" style="position: relative;width:292px;height:23px;"
        		ev:onclick="scwin.trigger1_onclick">
        		<xf:label><![CDATA[setColumnVisible col2, col3]]></xf:label>
        	</xf:trigger>
        	<xf:trigger id="trigger2" style="position: relative;width:292px;height:23px;" type="button"
        		ev:onclick="scwin.trigger2_onclick">
        		<xf:label><![CDATA[setFixedRightColumn(5)]]></xf:label>
        	</xf:trigger>
        </xf:group>
    </body>
</html>
 