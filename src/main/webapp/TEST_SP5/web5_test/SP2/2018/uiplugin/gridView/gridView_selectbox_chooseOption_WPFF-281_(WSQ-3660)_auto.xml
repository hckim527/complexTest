<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
	
	
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList id="dl_gridData" baseNode="list" saveRemovedData="true" repeatNode="map">
    				<w2:columnInfo>
    					<w2:column id="col1" name="name1" dataType="text"></w2:column>
    					<w2:column id="col2" name="name2" dataType="text"></w2:column>
    					<w2:column id="col3" name="name3" dataType="text"></w2:column>
    					<w2:column id="col4" name="name4" dataType="text"></w2:column>
    					<w2:column id="col5" name="name5" dataType="text"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    			<w2:dataList id="dl_selectData" baseNode="list" saveRemovedData="true" repeatNode="map">
    				<w2:columnInfo>
    					<w2:column id="label" name="name1" dataType="text"></w2:column>
    					<w2:column id="value" name="name2" dataType="text"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_cell_0_2').click()");
    WebSquare.wUnit.addCommand("pause", "1500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'G_'+$p.id+'gridView1___selectbox_col3_itemTable_0').innerText == 'la_a1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.jsonData = [{
        "label": "la_a1",
        "value": "a1"
    }, {
        "label": "la_a2",
        "value": "a2"
    }];
    dl_selectData.setJSON(jsonData);
    window.gridData = [{
        "col2": "a1"
    }, {
        "col2": "a2"
    }, {
        "col2": "a3"
    }, {
        "col2": "a4"
    }];
    dl_gridData.setJSON(gridData);
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="data:dl_gridData" summaryAuto="false" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" id="gridView1" style="position: absolute ;left: 53px;top: 34px;width:545px;height:235px;"
    		ignoreCellClick="false" syncScroll="false" ignoreToggleOnDisabled="false" summaryOnlyAuto="false" useShiftKey="true">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column9" style="" inputType="checkbox" width="70" value="name1" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column7" style="" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column5" style="" inputType="text" width="170" value="chooseOption=false" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="170" value="config chooseOption=true" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="70" inputType="text" value="name5" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="checkbox" width="70" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="text" width="70" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" inputType="select" width="70" value="" displayMode="label"
    					viewType="icon" allOption="" chooseOption="false" chooseOptionLabel="-선 택-">
    					<w2:choices>
    						<w2:itemset nodeset="data:dl_selectData">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="col4" style="" inputType="select" width="70" value="" displayMode="label"
    					viewType="icon" allOption="" chooseOptionLabel="-선 택-">
    					<w2:choices>
    						<w2:itemset nodeset="data:dl_selectData">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="col5" style="" width="70" inputType="text" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 