<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    dataList1.insertRow();
};
scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    gridView1.setColumnOrder(["col3", "col2", "col1"]);
};
scwin.__isCheckLog = function() {
    var log = WebSquare.logger.getErrorLog();
    return log.indexOf("getElementsByTagName") < 0;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();

    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('gridView1_column1').innerText", "name3");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('gridView1_column5').innerText", "name1");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.__isCheckLog()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
	scwin.init();
    //Function unitTest
    //Create by Truong.Luu
    //Create date 19-July-2018
    //End unitTest
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1"
    		columnMoveWithFooter="true" style="position: absolute ;left: 33px;top: 40px;width: 259px;height: 234px;" syncScroll="false" nextTabID="input1">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70" value="name1"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" inputType="text" width="70" value="name2"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1" removeBorderStyle="false" style="" width="70" inputType="text" value="name3"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" width="70" inputType="text" value=""
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>

    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1" style="position: absolute ;left:300px;top:41px;width: 171px;height: 41px;"
    		ev:onclick="scwin.trigger1_onclick" nextTabID="input2">
    		<xf:label><![CDATA[setColumnOrder]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 