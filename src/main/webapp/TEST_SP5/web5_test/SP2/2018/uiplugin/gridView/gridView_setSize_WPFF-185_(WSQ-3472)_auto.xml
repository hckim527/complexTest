scwin.onpageunload = function() {};
scwin.trigger1_onclick = function(e) {
    gridView1.setSize("300", "300");
};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플실행 후 'gridView setSize'버튼을 클릭한다.
    //1. After running the sample, click the 'gridView setSize' button.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1. gridView의 width가 줄어들고 하단에 가로스크롤이 생성되어 보여진다.(이전에는 가로스크롤이 생성되지 않음)
    //1. The width of the gridView is reduced and a horizontal scroll is created at the bottom (previously no horizontal scrolling is created). 
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_scrollX_div').css('height')", "18px");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function unitTest
    //Create by Truong.Luu
    //Create date 19-July-2018
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
