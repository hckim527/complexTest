<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/20180424/contents.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col4" name="name4"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col5" name="name5"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col6" name="name6"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col7" name="name7"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col8" name="name8"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col9" name="name9"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col10" name="name10"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col11" name="name11"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    var jsonData = [];
    for (var i = 0; i < 100; i++) {
        var row = {
            "col1": i,
            "col2": "col2",
            "col3": "col3",
            "col4": "col4",
            "col5": "col5",
            "col6": "col6",
            "col7": "col7",
            "col8": "col8"
        };
        jsonData.push(row);
    }
    dataList1.setJSON(jsonData);
};
scwin.trigger1_onclick = function(e) {
    grd.setColumnOrder(["col8", "col1", "col3", "col2"]);
};
scwin.trigger2_onclick = function(e) {
    grd.setColumnOrder(["col2", "col3", "col1", "col8"]);
};
scwin.trigger3_onclick = function(e) {
    grd.setColumnOrder(["col2", "col8", "col3", "col1"]);
};
scwin.trigger4_onclick = function(e) {
    grd.setColumnOrder(['col1', 'col8', 'col3', 'col2']);
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger4').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('grd_scrollY_div').scrollTop = 500");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('grd_scrollY_div').scrollTop = 1500");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.init();
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" summaryAuto="false"
    		applyAllColumnStyle="false" scrollByColumn="false"
    		defaultCellHeight="20" scrollByColumnAdaptive="false" id="grd"
    		style="position: relative;width:239px;height:400px;"
    		ignoreCellClick="false" syncScroll="false"
    		ignoreToggleOnDisabled="false" summaryOnlyAuto="false"
    		useShiftKey="true">
    		<w2:caption id="caption1" style=""
    			value="this is a grid caption.">
    		</w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column35"
    					style="height:40px;" inputType="text" width="70" value="col8"
    					displayMode="label" colSpan="" rowSpan="2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column21"
    					style="height:20px;" inputType="text" width="70" value="col1"
    					displayMode="label" colSpan="2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column17"
    					style="height:20px;" inputType="text" width="70" value="col2"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column26"
    					style="height:20px;" inputType="text" width="70"
    					displayMode="label" value="col3">
    				</w2:column>
    			</w2:row>
    			<w2:row id="row4" style="">
    				<w2:column blockSelect="false" id="column32"
    					width="70" inputType="text" displayMode="label"
    					style="height:20px;" value="col4">
    				</w2:column>
    				<w2:column blockSelect="false" id="column31"
    					width="70" inputType="text" displayMode="label"
    					style="height:20px;" value="col5">
    				</w2:column>
    				<w2:column blockSelect="false" id="column30"
    					style="height:20px;" width="70" inputType="text"
    					displayMode="label" colSpan="" value="col6" rowSpan="">
    				</w2:column>
    				<w2:column blockSelect="false" id="column34"
    					style="height:20px;" hidden="false" width="70" inputType="text"
    					value="col7" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col8"
    					style="height:40px;" inputType="text" width="70" value=""
    					displayMode="label" colSpan="" rowSpan="2">
    				</w2:column>
    				<w2:column blockSelect="false" id="col1"
    					style="height:20px;" inputType="text" width="70"
    					displayMode="label" colSpan="2">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2"
    					inputType="text" width="70" displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3"
    					inputType="text" width="70" displayMode="label">
    				</w2:column>
    			</w2:row>
    			<w2:row id="row3" style="">
    				<w2:column blockSelect="false" id="col4" width="70"
    					inputType="text" displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col5" width="70"
    					inputType="text" displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col6"
    					style="height:20px;" width="70" inputType="text"
    					displayMode="label" colSpan="" rowSpan="">
    				</w2:column>
    				<w2:column blockSelect="false" id="col7"
    					style="height:20px" hidden="false" width="70" inputType="text"
    					value="" displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1"
    		style="position: relative;width: 80px;height: 23px;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[8,1,3,2]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2"
    		style="position: relative;width: 80px;height: 23px;"
    		ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[2,3,1,8]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger3"
    		style="position: relative;width: 80px;height: 23px;"
    		ev:onclick="scwin.trigger3_onclick">
    		<xf:label><![CDATA[2,8,3,1]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger4"
    		style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger4_onclick">
    		<xf:label><![CDATA[1,8,3,2]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 