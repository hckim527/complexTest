        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    $w.local.setItem("getCurrentGridStyle", gridView1.getCurrentGridStyle());
};

scwin.trigger2_onclick = function(e) {
    //gridView1.setGridStyle(WebSquare.xml.parse($w.local.getItem("getCurrentGridStyle")));
    var gridStyleData = $w.local.getItem("getCurrentGridStyle");
    if (gridStyleData) {
        gridView1.setGridStyle(JSON.parse(gridStyleData));
    }	
};
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#gridView1_column1111', 'drag-n-drop', {
        dx: -80,
        dy: 0
    });
}
scwin.checkVal1 = function() {
    return WebSquare.wUnit.getDomById('gridView1_head_table').querySelectorAll('th')[5].innerText == '5';
}
scwin.checkVal2 = function() {
    return WebSquare.wUnit.getDomById('gridView1_head_table').querySelectorAll('th')[5].innerText == '3';
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");	

    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "500");	
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    window.data = [];
    for (var i = 0; i < 20 * 60; i++) {
        data.push(i);
    }
    dataList1.setData(data);
}
