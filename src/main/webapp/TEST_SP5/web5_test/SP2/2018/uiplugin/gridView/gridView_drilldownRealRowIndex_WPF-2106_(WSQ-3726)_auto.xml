    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    gridView1.spanAll(false);
    gridView1.setCellReadOnly(2, "label", false); //a1-2행을 수정 가능하도록
};
scwin.trigger2_onclick = function(e) {
    gridView1.spanAll(false);
    gridView1.setCellReadOnly(9, "label", false);
    dataList1.removeRow(9);
};
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate = function() {
    scwin.simulateWrapper('#gridView1_cell_5_2', 'key-combo', {
        combo: 'delete'
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "document.getElementsByClassName('w2grid_plus w2grid_root')[2].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_cell_5_2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'gridView1_cell_5_2').innerText != ''", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
