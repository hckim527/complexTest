<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.gridView1_oncellclick = function(row, col) {
    if (col = 2) {}
};
scwin.unitTest = function() {
    //init
    // WebSquare.wUnit.start();
    //Test step 1. 샘플실행 후 name3항목의 달력아이콘을 1번 클릭한다.
    //1. After running the sample, click the calendar icon of name3 item once.
    //Verify step 1. The calendar is displayed right away.(Previously, the calendar was expanded with two clicks)
    WebSquare.wUnit.addCommand("set", "document.getElementsByClassName('gridBodyDefault_calendar_div_img')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('G_'+$p.id+'gridView1__col3_calendar').style.display == 'block'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 08-Feb-2018
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false"
    		scrollByColumnAdaptive="false" id="gridView1"
    		style="position: relative;width:346px;height:172px;left:74px;top:23px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		fixedColumnWithHidden="true" useShiftKey="true"
    		keyMoveEditMode="true" editModeEvent="onclick" ev:oncellclick="scwin.gridView1_oncellclick" ev:onbeforeedit="scwin.gridView1_onbeforeedit" senseReader="" ev:onafteredit="scwin.gridView1_onafteredit"
    		>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5"
    					style="height:20px" inputType="text" width="70"
    					displayMode="label" value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3"
    					style="height:20px" inputType="text" width="70"
    					displayMode="label" value="name2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1"
    					style="height:20px" width="155" inputType="text"
    					displayMode="label" value="name3">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1"
    					style="height:20px" inputType="text" width="70"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2"
    					style="height:20px" inputType="text" width="70"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3"
    					style="height:20px" width="155" inputType="calendar"
    					displayMode="label" viewType="icon" editType="" editModeEvent="onclick" viewTypeIconImage="true">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:inputCalendar weekStartsOn="0" rightAlign="false"
    		calendarValueType="yearMonthDate" renderType="component" id=""
    		renderDiv="true"
    		style="position: relative;width: 150px;height: 23px;left:117px;top:87px;"
    		focusOnDateSelect="false" footerDiv="false">
    	</w2:inputCalendar>
