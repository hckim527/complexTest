scwin.titleSet = function(rowIndex, colIndex, data) {
    console.log("@@@@22222");
    //return dataList1.getCellData(rowIndex, colIndex);
    if (gridView1.getCellOption(rowIndex, colIndex, "id") == "col3") {
        return dataList1.getCellData(rowIndex, "col1") + "  값이어요";
    } else {
        return "";
