scwin.checkType = function() {
    return WebSquare.wUnit.getJq("input[type='tel']").length == 11;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "2000");
    //Verify step 1. 요소검사에서 111tel111값으로 검색 시 18개가 적용되어 보여진다.(이전에는 7개만 보여짐)
    //1. When searching for 111tel111 in the element check, 18 are shown to be applied (previously 7 are shown)
    WebSquare.wUnit.addCommand("assert", "scwin.checkType()", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
