<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
		
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>		
		
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.insertRow();
};
scwin.onpageunload = function() {};
scwin.filterGenre = function(value, name) {
    console.log("onChangeFunction");
    WebSquare.logger.printLog("onChangeFunction");
};
scwin.__simulate = function(id, options) {
    WebSquare.wUnit.getJq(id).simulate("key-sequence", options);
}
scwin.setSimulate = function() {
    scwin.__simulate('.w2grid_head_input', {
        sequence: '111',
        delay: 100
    });
}
scwin.checkLog = function() {
    //return WebSquare.logger.getErrorLog();
    var log = WebSquare.logger.getLog();
    return log.indexOf("onChangeFunction") > 0;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_dataLayer').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkLog()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:input adjustMaxLength="false" id="input1" style="position: absolute ;left:52px;top:30px;width: 106px;height: 38px;"></xf:input>
    	<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1"
    		style="position: absolute ;left: 58px;top: 103px;width: 456px;height: 178px;" syncScroll="false">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column7" removeBorderStyle="false" style="" inputType="text" width="70" value="name1"
    					displayMode="label" dataType="own" onChangeFunction="scwin.filterGenre">
    				</w2:column>
    				<w2:column blockSelect="false" id="column5" removeBorderStyle="false" style="" inputType="text" width="70" value="name2"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" removeBorderStyle="false" style="" inputType="text" width="70" value="name3"
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1" removeBorderStyle="false" style="" width="70" inputType="text" value="name4"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" removeBorderStyle="false" style="" inputType="text" width="70" value=""
    					displayMode="label">
    				</w2:column>
    				<w2:column blockSelect="false" id="col4" removeBorderStyle="false" style="" width="70" inputType="text" value=""
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 