<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                    <vector>
                        <map>
                            <itemId>value1</itemId>
                            <itemName>label1</itemName>
                        </map>
                        <map>
                            <itemId>value2</itemId>
                            <itemName>label2</itemName>
                        </map>
                    </vector>
                </data>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="itemId" name="name1" dataType="text"></w2:column>
            			<w2:column id="itemName" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
                <w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="itemId" name="name1" dataType="text"></w2:column>
                        <w2:column id="itemName" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList baseNode="list" repeatNode="map" id="dataList3" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="itemId" name="name1" dataType="text"></w2:column>
                        <w2:column id="itemName" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList baseNode="list" repeatNode="map" id="dataList4" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="itemId" name="name1" dataType="text"></w2:column>
                        <w2:column id="itemName" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList baseNode="list" repeatNode="map" id="dataList5" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="itemId" name="name1" dataType="text"></w2:column>
                        <w2:column id="itemName" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList baseNode="list" repeatNode="map" id="dataList6" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="itemId" name="name1" dataType="text"></w2:column>
                        <w2:column id="itemName" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                        <w2:column id="col4" name="name4" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    var data = ["value1", "label1", "", "", "value2", "label2", "", ""];
    dataList1.setData(data);
    dataList2.setData(data);
    dataList3.setData(data);
    dataList4.setData(data);
    dataList5.setData(data);
    dataList6.setData(data);
};
scwin.onpageunload = function() {};
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('autoComplete1_label').innerText == 'label1 value1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('autoComplete2_label').innerText  == 'value1 label1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
scwin.init()
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:autoComplete editType="select" id="autoComplete1" interactionMode="" chooseOption="false" useKeywordHighlight="false"
    		displayMode="label delim value" style="width: 148px;height: 21px; float:left;" visibleRowNum="5" submenuSize="auto" search="start">
    		<w2:choices>
    			<w2:gridViewItemset hideHeader="" rowMouseOver="" nodeset="data:dataList1" width="" selectedRowColor="" label="itemName"
    				visibleRowNum="" autoFit="" value="itemId" rowMouseOverColor="" height="">
    				<w2:item ref="itemId" hidden="" header="" style="" headerStyle=""></w2:item>
    				<w2:item ref="itemName" hidden="" header="" style="" headerStyle=""></w2:item>
    			</w2:gridViewItemset>
    		</w2:choices>
    	</w2:autoComplete>
    	<w2:autoComplete chooseOption="false" displayMode="value delim label" editType="select" id="autoComplete2" interactionMode=""
    		search="start" style="width: 148px;height: 21px; float:left;" submenuSize="auto" useKeywordHighlight="false" visibleRowNum="5">
    		<w2:choices>
    			<w2:gridViewItemset autoFit="" height="" hideHeader="" label="itemName" nodeset="data:dataList2" rowMouseOver=""
    				rowMouseOverColor="" selectedRowColor="" value="itemId" visibleRowNum="" width="">
    				<w2:item header="" headerStyle="" hidden="" ref="itemId" style=""></w2:item>
    				<w2:item header="" headerStyle="" hidden="" ref="itemName" style=""></w2:item>
    			</w2:gridViewItemset>
    		</w2:choices>
    	</w2:autoComplete>
        <w2:autoComplete editType="select" id="autoComplete3" interactionMode="" chooseOption="false" useKeywordHighlight="false"
            displayMode="label delim value" style="width: 148px;height: 21px; float:left;" visibleRowNum="5" submenuSize="auto" search="start">
            <w2:choices>
                <w2:gridItemset hideHeader="" rowMouseOver="" nodeset="vector/map" width="" selectedRowColor="" label="itemName"
                    visibleRowNum="" autoFit="" value="itemId" rowMouseOverColor="" height="">
                    <w2:item ref="itemId" hidden="" header="" style="" headerStyle=""></w2:item>
                    <w2:item ref="itemName" hidden="" header="" style="" headerStyle=""></w2:item>
                </w2:gridItemset>
            </w2:choices>
        </w2:autoComplete>
        <w2:autoComplete chooseOption="false" displayMode="value delim label" editType="select" id="autoComplete4" interactionMode=""
            search="start" style="width: 148px;height: 21px; float:left;" submenuSize="auto" useKeywordHighlight="false" visibleRowNum="5">
            <w2:choices>
                <w2:gridItemset autoFit="" height="" hideHeader="" label="itemName" nodeset="vector/map" rowMouseOver=""
                    rowMouseOverColor="" selectedRowColor="" value="itemId" visibleRowNum="" width="">
                    <w2:item header="" headerStyle="" hidden="" ref="itemId" style=""></w2:item>
                    <w2:item header="" headerStyle="" hidden="" ref="itemName" style=""></w2:item>
                </w2:gridItemset>
            </w2:choices>
        </w2:autoComplete>
        <w2:autoComplete editType="select" id="autoComplete5" interactionMode="" chooseOption="false" useKeywordHighlight="false"
            displayMode="label delim value" style="width: 148px;height: 21px; float:left;" visibleRowNum="5" submenuSize="auto" search="start">
            <w2:choices>
                <w2:itemset nodeset="data:dataList5">
                    <w2:label ref="itemId"></w2:label>
                    <w2:value ref="itemName"></w2:value>
                </w2:itemset>
            </w2:choices>
        </w2:autoComplete>
        <w2:autoComplete chooseOption="false" displayMode="value delim label" editType="select" id="autoComplete6" interactionMode=""
            search="start" style="width: 148px;height: 21px; float:left;" submenuSize="auto" useKeywordHighlight="false" visibleRowNum="5">
            <w2:choices>
                <w2:itemset nodeset="data:dataList6">
                    <w2:label ref="itemId"></w2:label>
                    <w2:value ref="itemName"></w2:value>
                </w2:itemset>
            </w2:choices>
        </w2:autoComplete>
    </body>
</html>
 