<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.btn_changeStatus_onclick = function(e) {
    scwin.$w.parent().scwin.status = "C";
    scwin.$w.parent().scwin.showStatus();
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group class="w2tb" id="" style="width:100.00%;" tagname="table">
    		<w2:attributes>
    			<w2:summary></w2:summary>
    		</w2:attributes>
    		<xf:group tagname="caption"></xf:group>
    		<xf:group tagname="colgroup">
    			<xf:group style="width:19.04%;" tagname="col"></xf:group>
    			<xf:group style="width:30.96%;" tagname="col"></xf:group>
    			<xf:group style="width:17.58%;" tagname="col"></xf:group>
    			<xf:group style="width:32.42%;" tagname="col"></xf:group>
    		</xf:group>
    		<xf:group style="" tagname="tr">
    			<xf:group class="w2tb_th" style="" tagname="th">
    				아이디
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group class="w2tb_td" style="" tagname="td">
    				<xf:input adjustMaxLength="false" class="fm_w100" id="" ref="data:dlt_memberList.id"
    					style="width: 144px;height: 21px;">
    				</xf:input>
    			</xf:group>
    			<xf:group class="w2tb_th" style="" tagname="th">
    				성명
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group class="w2tb_td" style="" tagname="td">
    				<xf:input adjustMaxLength="false" class="fm_w100" id="" ref="data:dlt_memberList.name"
    					style="width: 144px;height: 21px;">
    				</xf:input>
    			</xf:group>
    		</xf:group>
    		<xf:group style="" tagname="tr">
    			<xf:group class="w2tb_th" style="" tagname="th">
    				연락처
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group class="w2tb_td" style="" tagname="td">
    				<xf:input adjustMaxLength="false" class="fm_w100" id="" ref="data:dlt_memberList.tel"
    					style="width: 144px;height: 21px;">
    				</xf:input>
    			</xf:group>
    			<xf:group class="w2tb_th" style="" tagname="th">
    				지역
    				<w2:attributes>
    					<w2:scope>row</w2:scope>
    				</w2:attributes>
    			</xf:group>
    			<xf:group class="w2tb_td" style="" tagname="td">
    				<xf:input adjustMaxLength="false" class="fm_w100" id="" ref="data:dlt_memberList.region"
    					style="width: 144px;height: 21px;">
    				</xf:input>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    	<xf:trigger type="button" style="width:140px;height:26px;margin-top:5px;" id="btn_changeStatus" ev:onclick="scwin.btn_changeStatus_onclick">
    		<xf:label><![CDATA[Change Status]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 