    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_6').setActiveTab(1)");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1. tab2의 gridView가 정상적으로 보여진다. (이전에는 gridView가 보이지 않음)
