    WebSquare.wUnit.addCommand("assert", "scwin.__hasClass() == '4'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
