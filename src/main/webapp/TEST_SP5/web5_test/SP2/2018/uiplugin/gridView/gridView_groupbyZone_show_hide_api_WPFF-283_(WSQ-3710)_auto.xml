<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/css/contents.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""></data>
			</xf:instance>
			<w2:dataCollection>
				<w2:dataList id="dataList1" baseNode="list"
					saveRemovedData="true" repeatNode="map"
					getMatchedFromAllData="false" keepFilter="true"
					removeDummyRowStatus="true" removeDataMatch="true">
					<w2:columnInfo>
						<w2:column id="col1" name="분류1"
							dataType="text">
						</w2:column>
						<w2:column id="col2" name="분류2"
							dataType="text">
						</w2:column>
						<w2:column id="col3" name="금액"
							dataType="text">
						</w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<style type="text/css">
			.w2grid_groupby_depth_2{
				background-color: #ffffad;
			}
			.w2grid_groupby_depth_3{
				background-color: #affffff;
			}
		</style>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    scwin.data1 = [
        "0", "(주)A", 1,
        "0", "(주)A", 2,
        "0", "*A", 3,
        "0", "&B", 4,
        "0", "%C", 5,
        "0", "^A", 6,
        "0", "#B", 7,
        "0", "$C", 8,
        "0", "-A", 9,
        "0", "[주]B", 10,
        "0", "{주}C", 11,
        "0", "::A", 12,
        "0", "\\:B:\\", 13,
        "0", "C", 14,
        "0", "A", 15,
        "0", "B", 16,
        "0", "C", 17,
        "0", "A", 18,
        "0", "B", 19,
        "0", "C", 20,
        "0", "A", 21,
        "0", "B", 22,
        "0", "C", 23,
        "0", "A", 24,
        "0", "B", 25,
        "0", "C", 26,
        "0", "A", 27,
        "0", "B", 28,
        "0", "C", 29,
        "0", "A", 30
    ];
    dataList1.setData(scwin.data1.slice(0));
}
scwin.grid1_ongroupby = function(options) {
    return false;
}
scwin.trigger1_onclick = function() {
    gridView1.showGroupbyZone();
};
scwin.trigger2_onclick = function() {
    gridView1.hideGroupbyZone();
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'gridView1_groupbyZone_div').style.display == 'none'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
		<style type="text/css">
		</style>
	</head>
	<body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
		<w2:gridView
			style="position:relative;width:553px;height:400px;border:1px solid black;"
			groupbyZone="true" useRealColIndex="true" closeGroup="true"
			rowNumWidth="*" rowStatusVisible="true" rowStatusWidth="*" id="gridView1"
			baseNode="base" repeatNode="repeat" valueNode="value"
			readOnlyBackgroundColor="#80ff00" editModeEvent="ondblclick"
			rowNumVisible="true" tooltipDisplay="true" focusMode="cell"
			backgroundColorMode="always" sortable="true" dataList="dataList1"
			useFilterList="true" ev:ongroupby="scwin.grid1_ongroupby"
			ev:oncellclick="scwin.grid1_oncellclick">
			<w2:header style="height:20px;" columnStyle="" id="header1"
				width="490">
				<w2:row>
					<w2:column inputType="text" valueType="binary"
						style="height:20px;" id="header2" width="30" value="분류"
						useFilter="true">
					</w2:column>
					<w2:column inputType="text" valueType="binary"
						style="height:20px;" id="header3" width="*" value="분류2"
						useFilter="true" customFormatter="" displayFormatter="">
					</w2:column>
					<w2:column inputType="text" valueType="binary"
						style="height:20px;" id="header4" width="*" value="금액"
						useFilter="true">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody style="height:20px" columnStyle="" id="gBody1"
				width="490">
				<w2:row>
					<w2:column valueType="binary" style="height:20px"
						width="100" id="col1" dataType="text" inputType="checkbox">
					</w2:column>
					<w2:column inputType="text" valueType="binary"
						style="height:20px" width="70" id="col2" colMerge="">
					</w2:column>
					<w2:column inputType="text" dataType="text"
						valueType="binary" style="height:20px" width="70" id="col3"
						displayFormat="" customFormatter="">
					</w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer style="height:20px" columnStyle="" id="footer1"
				width="768">
				<w2:row>
					<w2:column inputType="text" valueType="binary"
						style="height:20px" id="footer1" width="100">
					</w2:column>
					<w2:column inputType="text" valueType="binary"
						style="height:20px" id="footer2" width="70">
					</w2:column>
					<w2:column inputType="expression" valueType="binary"
						expression="SUM('col3')" style="height:20px" id="footer3"
						width="70">
					</w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1"
			style="position: relative;width: 180px;height: 23px;"
			ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[showGroupbyZone]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2"
			style="position: relative;width: 180px;height: 23px;"
			ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[hideGroupbyZone]]></xf:label>
		</xf:trigger>
	</body>
</html> 