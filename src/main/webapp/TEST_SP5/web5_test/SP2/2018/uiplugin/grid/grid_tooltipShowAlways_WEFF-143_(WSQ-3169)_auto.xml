        <script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
    var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
    var r = d(id); if (r) return r;
    var s = dd(P + id); r = d(s); if (r) return r;
    var g = s.indexOf('G_');
    if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
    return d(s.replace(P, ''));
};
// 컴포넌트·전역 이름 조회(엔진 캐시 → 이름 그대로 실행 → mf_ 접두사 붙여 다시, 없으면 받은 id 문자열 반환). 2026-11
scwin.__getObj = function(id) {
    if (typeof id !== 'string') return id;
    var W = WebSquare, C = W.idCache, U = W.idToUUID, F = function(k) { return new Function('return ' + k)(); };
    if (!W.strictMode) id = id.replace(/mf_/g, '');
    if (C[U[id]]) return C[U[id]];
    var r; try { r = F(id); } catch (e) {}
    if (r == undefined && W.strictMode) {
        var P = W.strictModeFrame.id + '_';
        var s = id.slice(0, 2) === 'G_' ? 'G_' + P + id.slice(2) : (id.slice(0, P.length) !== P ? P + id : id);
        s = s.replace(new RegExp('(' + P + '){2,}', 'g'), P);
        if (C[U[s]]) r = C[U[s]]; else { try { r = F(s); } catch (e) { r = id; } }
    }
    return r == undefined ? id : r;
};
scwin.trigger1_onclick = function(e) {
    debugger;
    grid1.modifyRowStatus(0, 'R');
    grid1.modifyRowStatus(1, 'U');
    grid1.modifyRowStatus(2, 'C');
    grid1.modifyRowStatus(3, 'D');
    grid1.modifyRowStatus(4, 'V');
};
scwin.fireOver = function(node) {
    if (document.createEventObject) {
        node.fireEvent('onmouseover');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('mouseover', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.onmouseover == 'function') {
        node.onmouseover();
    }
}
scwin.setVal1 = function() {
    scwin.fireOver(scwin.__getObj('grid1_cell_0_1'));
}
scwin.setVal2 = function() {
    scwin.fireOver(scwin.__getObj('grid1_cell_0_3'));
}
scwin.checkVal = function() {
    return scwin.__getDom($p.id + 'grid1_tooltip').style.display == 'block';
}
scwin.onpageload2 = function() {
