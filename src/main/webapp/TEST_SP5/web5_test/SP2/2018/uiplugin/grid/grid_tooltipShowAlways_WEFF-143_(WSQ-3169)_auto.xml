        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    debugger;
    grid1.modifyRowStatus(0, 'R');
    grid1.modifyRowStatus(1, 'U');
    grid1.modifyRowStatus(2, 'C');
    grid1.modifyRowStatus(3, 'D');
    grid1.modifyRowStatus(4, 'V');
};
scwin.fireOver = function(node) {
    if (document.createEventObject) {
        node.fireEvent('onmouseover');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('mouseover', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.onmouseover == 'function') {
        node.onmouseover();
    }
}
scwin.setVal1 = function() {
    scwin.fireOver(WebSquare.wUnit.getObjById('grid1_cell_0_1'));
}
scwin.setVal2 = function() {
    scwin.fireOver(WebSquare.wUnit.getObjById('grid1_cell_0_3'));
}
scwin.checkVal = function() {
    return WebSquare.wUnit.getDomById($p.id + 'grid1_tooltip').style.display == 'block';
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플실행 후 AA, CC 컬럼에 마우스를 오버하여 tooltip이 보여지는지 확인한다.
    //1. After running the sample, mouse over AA and CC columns to see if the tooltip is visible.
    //Verify 1. AA, CC 컬럼에 tooltip이 정상적으로 보여진다.(기능추가전에는 보이지 않음)
    //1. The tooltip is displayed normally on the AA and CC columns (not visible until the function is added).
    //AA
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setVal1()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "1000");
    //CC
    WebSquare.wUnit.addCommand("set", "scwin.setVal2()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
