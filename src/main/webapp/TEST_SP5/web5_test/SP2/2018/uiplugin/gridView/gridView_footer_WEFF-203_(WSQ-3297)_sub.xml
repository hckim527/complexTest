						<w2:column id="trade" name="!~TI_TRD~!" dataType="number"></w2:column>
						<w2:column id="service" name="!~TI_SVC~!" dataType="number"></w2:column>
					</w2:columnInfo>
					<w2:data use="false"></w2:data>
				</w2:dataList>
