<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
		
		
		
        <w2:config>      
            <WebSquare>
                <gridView>
                    <header inputType="checkbox">
						<checkboxLabel value="title"/>
					</header>
                </gridView>
            </WebSquare>
        </w2:config>

		
		
        <w2:buildDate/>
        <xf:model>
        	<xf:instance>
        		<data xmlns="" />
        	</xf:instance>
        	<w2:dataCollection>
        		<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
        			<w2:columnInfo>
        				<w2:column id="col1" name="name1" dataType="text"></w2:column>
        				<w2:column id="col2" name="name2" dataType="text"></w2:column>
        			</w2:columnInfo>
        			<w2:data use="true">
        				<w2:row>
        					<col1><![CDATA[2]]></col1>
        					<col2><![CDATA[3]]></col2>
        				</w2:row>
        				<w2:row>
        					<col1><![CDATA[3]]></col1>
        					<col2><![CDATA[1]]></col2>
        				</w2:row>
        				<w2:row>
        					<col1><![CDATA[4]]></col1>
        					<col2><![CDATA[4]]></col2>
        				</w2:row>
        				<w2:row>
        					<col1><![CDATA[1]]></col1>
        					<col2><![CDATA[2]]></col2>
        				</w2:row>
        			</w2:data>
        		</w2:dataList>
        	</w2:dataCollection>
        </xf:model>
        <script type="javascript"><![CDATA[ 

        scwin.fireDbClick = function(node){
            if( document.createEventObject ) {
                node.fireEvent('ondblclick') ;
            } else if( document.createEvent ) {
                var evt = document.createEvent('MouseEvents');
                evt.initEvent('dblclick', true, false);
                node.dispatchEvent(evt);
            } else if (typeof node.ondblclick == 'function' ) {
                node.ondblclick();
            }
        }

        scwin.Dbclick = function(id){
            var el = WebSquare.wUnit.getDomById($p.id+id);
            scwin.fireDbClick(el);
        }

        scwin.checkValue = function(id, value) {
            if(WebSquare.wUnit.getDomById($p.id+id).innerText == value) {
                return true;
            }
            return false;
        }
        scwin.checkVal1 = function() {
            return WebSquare.wUnit.getJq(document.getElementsByClassName('w2checkbox_label')[1]).text() == 'title';
        }
        scwin.unitTest = function(){
            //init
            WebSquare.wUnit.start();

            WebSquare.wUnit.addCommand("set", "scwin.Dbclick('wq_uuid_3_column1')");
            WebSquare.wUnit.addCommand("pause", "500");

            WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");

            //Run  and stop
            WebSquare.wUnit.run();
            WebSquare.wUnit.stop();
        }
        scwin.unitTest();        
        ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id=""
