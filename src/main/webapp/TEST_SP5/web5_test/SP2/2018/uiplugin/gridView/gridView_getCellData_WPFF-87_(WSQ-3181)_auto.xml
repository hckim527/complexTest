<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col4" name="name4"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col4" name="name4"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    log = gridView1.getCellData(0, 1);
    //alert(gridView1.getCellData(0,1));
};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플실행 후 'gridView1.getCellData(0,1)'버튼을 클릭한다.
    //1. After running the sample, click the 'gridView1.getCellData (0,1)' button.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1. 알림창에 'bbbb1'값이 정상으로 보여진다. (이전에는 'undefined'값이 보여짐)
    //1. The 'bbbb1' value is displayed as normal in the notification window. (Previously the 'undefined' value is shown)
    WebSquare.wUnit.addCommand("assert", "log == 'bbbb1'", "true");
    WebSquare.wUnit.addCommand("pause", "1000");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.jsonData = [{
            "col1": "aaaa1",
            "col2": "bbbb1",
            "col3": "cccc1",
            "col4": "dddd1"
        },
        {
            "col1": "aaaa2",
            "col2": "bbbb2",
            "col3": "cccc2",
            "col4": "dddd2"
        },
        {
            "col1": "aaaa3",
            "col2": "bbbb3",
            "col3": "cccc3",
            "col4": "dddd3"
        },
        {
            "col1": "aaaa4",
            "col2": "bbbb4",
            "col3": "cccc4",
            "col4": "dddd4"
        }
    ];
    dataList1.setJSON(jsonData);
    window.log = undefined;
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 22-Feb-2018
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">

    	<xf:group id="" style="position: relative;width: 350px;height: 200px;" class="">
    		<w2:gridView dataList="dataList1" summaryAuto="false" useFilterList="false" scrollByColumn="false" showSortableUseFilter="false"
    			scrollByColumnAdaptive="false" id="gridView1" style="position: relative;width: 500px;height: 200px;" ignoreCellClick="false"
    			ignoreToggleOnDisabled="false" summaryOnlyAuto="false" fixedColumnWithHidden="true" useShiftKey="true"
    			ev:onviewchange="scwin.gridView1_onviewchange" autoFit="allColumn">
    			<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    			<w2:header id="header1" style="">
    				<w2:row id="row1" style="">
    					<w2:column blockSelect="false" id="column7" style="height:20px" inputType="text" width="70" displayMode="label"
    						value="name1">
    					</w2:column>
    					<w2:column blockSelect="false" id="column5" style="height:20px" inputType="text" width="70" displayMode="label"
    						value="name2">
    					</w2:column>
    					<w2:column blockSelect="false" id="column3" style="height:20px" inputType="text" width="200" displayMode="label"
    						value="name3" fixColumnWidth="true">
    					</w2:column>
    					<w2:column blockSelect="false" id="column1" style="height:20px" width="70" inputType="text" displayMode="label"
    						value="name4">
    					</w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody id="gBody1" style="">
    				<w2:row id="row2" style="">
    					<w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70" displayMode="label">
    					</w2:column>
    					<w2:column blockSelect="false" id="col2" style="height:20px" inputType="text" width="70" displayMode="label">
    					</w2:column>
    					<w2:column blockSelect="false" id="col3" style="height:20px" inputType="text" width="200" displayMode="label"
    						fixColumnWidth="true">
    					</w2:column>
    					<w2:column blockSelect="false" id="col4" style="height:20px" width="70" inputType="text" displayMode="label">
    					</w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>
    	</xf:group>
    	<xf:trigger type="button" id="trigger1" style="position: relative;width:176px;height:30px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[gridView1.getCellData(0,1)]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 