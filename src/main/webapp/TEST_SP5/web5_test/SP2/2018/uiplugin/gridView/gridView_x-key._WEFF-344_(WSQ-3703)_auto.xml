<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.min.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery-ui.custom.min.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/raphael-min.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/raphael.sketchpad.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/bililiteRange.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.ext.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.drag-n-drop.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-sequence.js"></script>
        <script type="javascript" src="/ROBOT_AUTO_LIB/jquery.simulate.key-combo.js"></script>		
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
                <w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                        <w2:column id="col3" name="name3" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
        "col1": "aaa",
        "col2": "1111",
        "col3": "가가가"
    }, {
        "col1": "bbb",
        "col2": "2222",
        "col3": "나나나"
    }, {
        "col1": "ccc",
        "col2": "3333",
        "col3": "다다다"
    }, {
        "col1": "ddd",
        "col2": "4444",
        "col3": "라라라"
    }];
    dataList1.setJSON(jsonData);
};
scwin.onpageunload = function() {};
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate = function() {
    scwin.simulateWrapper('#gridView1_cell_0_0', 'key-combo', {
        combo: 'x'
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_cell_0_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('G_'+$p.id+'gridView1__col1').style.display == 'block'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    /*
     * 그리드뷰에 키보드 x 키로 edit모드 진입이 안됩니다.
     * directEdit="true" 속성을 추가해도 x키로는 진입되지 않습니다.
     * 다른 문제로 z, c, v 키로는 진입까지만 되고 입력이 안된됩니다.
     */
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <w2:gridView id="gridView1" style="width: 500px;height: 150px;" scrollByColumn="false" defaultCellHeight="20"
            scrollByColumnAdaptive="false" dataList="data:dataList1" keyMoveEditMode="" directEdit="true">
            <w2:caption style="" id="caption2" value="this is a grid caption."></w2:caption>
            <w2:header style="" id="header2">
                <w2:row style="" id="row3">
                    <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column7" value="name1" blockSelect="false"
                        displayMode="label">
                    </w2:column>
                    <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column5" value="name2" blockSelect="false"
                        displayMode="label">
                    </w2:column>
                    <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="column3" value="name3" blockSelect="false"
                        displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody style="" id="gBody2">
                <w2:row style="" id="row4">
                    <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="col1" value="" blockSelect="false"
                        displayMode="label">
                    </w2:column>
                    <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="col2" value="" blockSelect="false"
                        displayMode="label">
                    </w2:column>
                    <w2:column removeBorderStyle="false" width="70" inputType="text" style="" id="col3" value="" blockSelect="false"
                        displayMode="label">
                    </w2:column>
                </w2:row>
            </w2:gBody>
        </w2:gridView>
    </body>
</html>
 