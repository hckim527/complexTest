<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list"
            		saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('inputCalendar1_img').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('inputCalendar1_calendar_picker_cell_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('inputCalendar1_input').value == '2026'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:inputCalendar rightAlign="false" pickerType="dynamic"
            calendarValueType="yearMonthDate" renderType="component" id="inputCalendar0"
            renderDiv="true"
            style="position: relative;width: 150px;height: 23px;float:left;"
            focusOnDateSelect="false" footerDiv="false">
        </w2:inputCalendar>
        <w2:inputCalendar rightAlign="false" pickerType="dynamic"
    		calendarValueType="year" renderType="component" id="inputCalendar1"
    		renderDiv="true"
    		style="position: relative;width: 150px;height: 23px;float:left;"
    		focusOnDateSelect="false" footerDiv="false">
    	</w2:inputCalendar>
        <w2:inputCalendar rightAlign="false" pickerType="dynamic"
            calendarValueType="yearMonth" renderType="component" id="inputCalendar2"
            renderDiv="true"
            style="position: relative;width: 150px;height: 23px;float:left;"
            focusOnDateSelect="false" footerDiv="false">
        </w2:inputCalendar>
        <w2:inputCalendar rightAlign="false"
            calendarValueType="year" renderType="component" id="inputCalendar3"
            renderDiv="true"
            style="position: relative;width: 150px;height: 23px;float:left;"
            focusOnDateSelect="false" footerDiv="false">
        </w2:inputCalendar>
    </body>
</html>
 