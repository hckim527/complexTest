scwin.__hasErrLog = function() {
    var err = WebSquare.logger.getErrorLog();
    console.log(err);
    return err ? true : false;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 샘플실행 후 ctrl + 마우스 우클릭 > 로그보기에서 정상로그를 확인한다.
    //1. After running the sample, check the normal log in ctrl + right mouse click> log view.
    // verify step 1. 정상로그가 확인되어진다.(이전에는 로그오류 발생)
    //1. The normal log is checked.(Previously a log error occurred)
    WebSquare.wUnit.addCommand("assert", "scwin.__hasErrLog()", "false");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
