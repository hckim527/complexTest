<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
    	<w2:buildDate />
    	<xf:model>
    		<xf:instance>
    			<data xmlns="" />
    		</xf:instance>
    		<w2:dataCollection baseNode="map">
    			<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
    				<w2:columnInfo>
    					<w2:column id="col1" name="name1" dataType="text"></w2:column>
    					<w2:column id="col2" name="name2" dataType="text"></w2:column>
    				</w2:columnInfo>
    			</w2:dataList>
                <w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList id="dataList3" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
                <w2:dataList id="dataList4" baseNode="list" saveRemovedData="true" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="col1" name="name1" dataType="text"></w2:column>
                        <w2:column id="col2" name="name2" dataType="text"></w2:column>
                    </w2:columnInfo>
                </w2:dataList>
    		</w2:dataCollection>
    		<w2:workflowCollection></w2:workflowCollection>
    	</xf:model>
    	<style type="text/css">
 		.w2table_sb {
            border: 10px solid #b5c7d6;
            padding: 3px;
            outline:none;
        }
        .w2selectbox{
            border: 10px solid #b3b3b3;
            padding: 3px;
            outline: none;
            margin-right:10px;
        }
    	</style>
    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var data = [];
    for (var i = 0; i < 3; i++) {
        data.push("R=" + i);
        data.push("" + i);
    }
    dataList1.setData(data);
    var data2 = [];
    for (var i = 0; i < 30; i++) {
        data2.push("R" + i);
        data2.push("" + i);
    }
    dataList2.setData(data2);
    var data3 = [];
    for (var i = 0; i < 3; i++) {
        data3.push("R=" + i + " label is long label is long  label is long  label is long  label is long ");
        data3.push("" + i);
    }
    dataList3.setData(data3);
    var data4 = [];
    for (var i = 0; i < 30; i++) {
        data4.push("R=" + i + " label is long label is long  label is long  label is long  label is long ");
        data4.push("" + i);
    }
    dataList4.setData(data4);
};
scwin.onpageunload = function() {};

scwin.checkVal1 = function() {
    if ((document.getElementById($p.id+'sel2').offsetWidth - document.getElementById($p.id+'sel2').clientWidth)/2 == 10) {
        return WebSquare.wUnit.getJq('#sel2').outerWidth() == WebSquare.wUnit.getJq('#sel2_itemTable').outerWidth();
    } else {
        return true;
    }
}

scwin.checkVal2 = function() {
    if ((document.getElementById($p.id+'self3').offsetWidth - document.getElementById($p.id+'self3').clientWidth)/2 == 10) {
        return WebSquare.wUnit.getJq('#self3').outerWidth() == WebSquare.wUnit.getJq('#self3_itemTable').outerWidth();
    } else {
        return true;
    }
}

scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('sel2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('sel3').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#sel3').outerWidth() < WebSquare.wUnit.getJq('#sel3_itemTable').outerWidth()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('self2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('self3').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:group style="height:130px;" id="">
        	<w2:textbox id="textbox1" style="width: 248px;height: 20px;font-size:20px;" label="submenuSize=auto"/>
            <xf:select1 submenuSize="auto" ref="" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOption=""
        		style="float:left; width: 248px;height: 51px;" disabled="false" id="sel1" allOption="" renderType="component"
        		displayMode="label" direction="auto">
        		<xf:choices>
        			<xf:itemset nodeset="data:dataList1">
        				<xf:label ref="col1"></xf:label>
        				<xf:value ref="col2"></xf:value>
        			</xf:itemset>
        		</xf:choices>
        	</xf:select1>
            <xf:select1 submenuSize="auto" ref="" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOption=""
                style="float:left;width: 248px;height: 51px;" disabled="false" id="sel2" allOption="" renderType="component"
                displayMode="label" direction="auto">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList2">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
            <xf:select1 submenuSize="auto" ref="" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOption=""
                style="float:left;width: 248px;height: 51px;" disabled="false" id="sel3" allOption="" renderType="component"
                displayMode="label" direction="auto">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList3">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
            <xf:select1 submenuSize="auto" ref="" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOption=""
                style="float:left;width: 248px;height: 51px;" disabled="false" id="sel4" allOption="" renderType="component"
                displayMode="label" direction="auto">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList4">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
        </xf:group>
        <xf:group style="height:130px;" id="">
            <w2:textbox id="textbox2" style="width: 248px;height: 20px;font-size:20px;" label="submenuSize=fixed"/>
            <xf:select1 submenuSize="fixed" ref="" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOption=""
                style="float:left;width: 248px;height: 51px;" disabled="false" id="self1" allOption="" renderType="component"
                displayMode="label" direction="auto">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList1">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
            <xf:select1 submenuSize="fixed" ref="" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOption=""
                style="float:left;width: 248px;height: 51px;" disabled="false" id="self2" allOption="" renderType="component"
                displayMode="label" direction="auto">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList2">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
            <xf:select1 submenuSize="fixed" ref="" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOption=""
                style="float:left;width: 248px;height: 51px;" disabled="false" id="self3" allOption="" renderType="component"
                displayMode="label" direction="auto">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList3">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
            <xf:select1 submenuSize="fixed" ref="" appearance="minimal" disabledClass="w2selectbox_disabled" chooseOption=""
                style="float:left;width: 248px;height: 51px;" disabled="false" id="self4" allOption="" renderType="component"
                displayMode="label" direction="auto">
                <xf:choices>
                    <xf:itemset nodeset="data:dataList4">
                        <xf:label ref="col1"></xf:label>
                        <xf:value ref="col2"></xf:value>
                    </xf:itemset>
                </xf:choices>
            </xf:select1>
        </xf:group>

    </body>
</html>
 