        <script type="text/javascript" lazy="false"><![CDATA[
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#wq_uuid_3_column5', 'drag-n-drop', {
        dx: 40,
        dy: 0
    });
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 1. 샘플실행 후 'name1'항목을 마우스로 드래그앤드롭하여 'name2'항목으로 이동시킨다.
    //1. After executing sample, drag and drop 'name1' item with mouse and move to 'name2' item.
    //Verify step 1. 'name1' item is not moved to drag
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#wq_uuid_3_head_table tr th:first').text() == 'name1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
