<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    $p.log($p.id + "onpageload");
    textbox1.setValue($p.id);
}
scwin.onpageunload = function() {
    $p.log($p.id + "onpageunload");
}
scwin.trigger1_onclick = function() {
    textbox_test.setValue(textbox_test.getID());
}
scwin.trigger2_onclick = function() {
    textbox_test.setValue(textbox_test.getOriginalID());
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:group>
            <xf:group>
                <w2:textbox id="textbox1" style="position: relative;width: 160px;height: 30px;font-size:18px;"/>
             </xf:group>
             <xf:group>
                <xf:trigger id="trigger1" style="position: relative;width: 180px;height: 30px;" type="button" ev:onclick="scwin.trigger1_onclick">
                    <xf:label><![CDATA[textbox_test.getID()]]></xf:label>
                </xf:trigger>
                <xf:trigger id="trigger2" style="position: relative;width: 180px;height: 30px;" type="button" ev:onclick="scwin.trigger2_onclick">
                    <xf:label><![CDATA[textbox_test.getOriginalID()]]></xf:label>
                </xf:trigger>
                <w2:textbox id="textbox_test" style="position: relative;width: 160px;height: 30px;font-size:18px;"/>
             </xf:group>
        </xf:group>
    </body>
</html> 