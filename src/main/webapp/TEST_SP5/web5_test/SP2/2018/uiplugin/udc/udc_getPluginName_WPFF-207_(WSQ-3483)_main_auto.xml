    		<w2:dataCollection baseNode="map">
    			<w2:dataMap baseNode="map" id="dma_MailRefValue" style="" attributeMap="">
    				<w2:keyInfo>
    					<w2:key id="mail" name="메일주소" dataType="text"></w2:key>
    					<w2:key id="mailType" name="메일타입" dataType="text"></w2:key>
    				</w2:keyInfo>
    			</w2:dataMap>
    		</w2:dataCollection>
    		<xf:submission id="sbm_WS0101UDC" ref="" target='data:json,{"id":"dma_MailRefValue","key":"MailUDC"}' action="" method="post"
    			mediatype="application/json" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
    			processMsg="" ev:submit="" ev:submitdone="WS0101UDC_CallBack" ev:submiterror="">
    		</xf:submission>
    	</xf:model>
    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.initScreen = function() {
    mailUDC_Sample1.setMail("k_0001@inswave.com");
    mailUDC_Sample2.setMail("k_0002@inswave.com");
    mailUDC_Sample3.setMail("k_0003@inswave.com");
};
scwin.trigger1_onclick = function(e) {
    WebSquare.logger.printLog(mailUDC_Sample1.getPluginName());
    console.log(mailUDC_Sample1.getPluginName());
    localStorage.setItem("log", mailUDC_Sample1.getPluginName());
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "1000");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "localStorage.getItem('log') == 'prototype_mailBoxUDC'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "localStorage.removeItem('log')");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.initScreen();
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
		<w2:require src="udc_getPluginName_WPFF-207_(WSQ-3483)_sub.xml"></w2:require>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
