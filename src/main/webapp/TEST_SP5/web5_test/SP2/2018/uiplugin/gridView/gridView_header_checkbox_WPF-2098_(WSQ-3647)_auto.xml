    	<script type="text/javascript" lazy="false"><![CDATA[
scwin.grd2_onheaderclick = function(headerId) {
    //alert(grd2.getHeaderValue("column7"));
    WebSquare.logger.printLog(grd2.getHeaderValue("column7"));
    console.log(grd2.getHeaderValue("column7"));
};
scwin._checkErr = function() {
    var log = WebSquare.logger.getLog();
    return log.indexOf("true") != -1;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getJq(WebSquare.wUnit.getDomById($p.id+'grd2_column7')).children()[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin._checkErr()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    dataList3.insertRow();
    dataList3.insertRow();
    dataList3.insertRow();
    dataList3.insertRow();
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList3" fixedColumnWithHidden="true" id="grd2" ignoreCellClick="false" ignoreToggleOnDisabled="false"
