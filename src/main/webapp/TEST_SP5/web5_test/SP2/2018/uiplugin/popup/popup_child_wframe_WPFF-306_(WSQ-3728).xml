<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    requires("uiplugin.popup");
    debugger;
    WebSquare.wUnit.getJq("#popup_window_wframe").css("height", 500);
    WebSquare.wUnit.getJq("#popup_window_wframe").css("width", 500);
    parent.WebSquare.wUnit.getJq("#popup_window_iframe").css("height", 500);
    parent.WebSquare.wUnit.getJq("#popup_window_iframe").css("width", 500);
    debugger;
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:trigger type="button" id="trigger4" style="position: relative;width: 200px;height: 23px;">
            <xf:label><![CDATA[isWFramePopup]]></xf:label>
            <script ev:event="onclick" type="javascript"><![CDATA[
                alert(scwin.$w.isWFramePopup());
        ]]></script>
        </xf:trigger>
    	<xf:trigger type="button" id="trigger1" style="position: relative;width: 200px;height: 23px; margin-bottom:5px;">
            <xf:label><![CDATA[getPopupParam]]></xf:label>
            <script ev:event="onclick" type="javascript"><![CDATA[
                alert(scwin.$w.getPopupParam());
        ]]></script>
        </xf:trigger>
        <xf:trigger type="button" id="trigger2" style="position: relative;width: 200px;height: 23px; margin-bottom:5px;">
            <xf:label><![CDATA[getPopupUrl]]></xf:label>
            <script ev:event="onclick" type="javascript"><![CDATA[
                alert(scwin.$w.getPopupUrl());
        ]]></script>
        </xf:trigger>
        <xf:trigger type="button" id="trigger3" style="position: relative;width: 200px;height: 23px; margin-bottom:5px;">
            <xf:label><![CDATA[getPopupId]]></xf:label>
            <script ev:event="onclick" type="javascript"><![CDATA[
                alert(scwin.$w.getPopupId());
        ]]></script>
        </xf:trigger>
    </body>
</html>
 