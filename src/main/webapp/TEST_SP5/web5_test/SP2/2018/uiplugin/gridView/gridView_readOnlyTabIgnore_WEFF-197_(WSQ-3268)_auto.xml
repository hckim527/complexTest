scwin.setSimulate1 = function() {
    WebSquare.wUnit.getJq('#grid1_cell_0_0').simulate('keydown', {
        keyCode: 9,
        which: 9,
        key: 'TAB'
    });
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플실행 후 0,0컬럼에 마우스 클릭 후 'tab' key를 입력한다.
    //1. After executing the sample, click mouse on the 0,0 column and input 'tab' key.
    //Verify 1. 'tab'key 입력 시 focus가 0,0 -> 1,0 -> 2,0 컬럼으로 focus가 이동되어진다. (이전에는 1,1 -> 2,1로 focus가 이동되어짐)
    //1. When you enter 'tab' key, the focus is shifted to 0,0 -> 1,0 -> 2,0 column. (Previously, focus shifted from 1,1 -> 2,1)
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('grid1_cell_0_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#G_grid1__col1').css('display')", "block");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
