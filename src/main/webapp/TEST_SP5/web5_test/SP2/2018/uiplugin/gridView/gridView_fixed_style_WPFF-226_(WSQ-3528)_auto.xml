scwin.selectbox1_onviewchange = function(info) {
    if (info.newValue > 0) {
        // fixedRow와 lastFixedRow는 현재 동시에 사용 불가능 
        selectbox2.setValue(0);
        gridView1.setLastFixedRow(0);
    }
    gridView1.setFixedRow(info.newValue);
};
scwin.selectbox2_onviewchange = function(info) {
