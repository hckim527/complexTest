    //textarea2.setValue(JSON.stringify(styleObj2, null, "\t"));
}
scwin.trigger1_onclick = function() {
    var styleObj = JSON.parse(textarea1.getValue());
    gridView1.setStyleAll(styleObj);
};
scwin.trigger2_onclick = function() {
