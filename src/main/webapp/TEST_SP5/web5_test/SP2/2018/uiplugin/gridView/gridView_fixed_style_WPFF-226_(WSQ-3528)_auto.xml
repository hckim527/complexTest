scwin.init = function() {
    var data1 = [];
    for (var i = 0; i < 20 * 50; i++) {
        data1.push(Math.floor(Math.sqrt(i) * Math.sqrt(i)) % (Math.ceil(Math.sqrt(i)) + 1));
    }
    dataList1.setData(data1);
    selectbox1.setValue(5);
    selectbox2.setValue(0);
    selectbox3.setValue(5);
    selectbox4.setValue(4);
    gridView1.setFixedRow(selectbox1.getValue());
    gridView1.setLastFixedRow(selectbox2.getValue());
    gridView1.setFixedColumn(selectbox3.getValue());
    gridView1.setFixedRightColumn(selectbox4.getValue());
