        "type": "row",
        "target": "fixed",
        "rowIndex": 2,
        "styleName": "text-align",
        "styleValue": "left"
    };
    //textarea1.setValue(JSON.stringify(styleObj, null, "\t"));
    var styleObj2 = {
        "type": "column",
        "target": "data",
        "colIndex": 6,
        "styleName": "background-color",
        "styleValue": "yellow"
