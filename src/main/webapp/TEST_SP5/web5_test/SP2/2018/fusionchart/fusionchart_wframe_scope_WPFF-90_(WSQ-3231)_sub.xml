<?xml version="1.0" encoding="UTF-8"?>
<!--
<?xml-stylesheet href="/websquare5/common/css/content.css" type="text/css"?>
-->
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
    xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:buildDate />
        <xf:model>
            <xf:instance>
                <data xmlns="" />
            </xf:instance>
            <w2:dataCollection>
                <w2:dataList id="dataList1" baseNode="list" style="" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="label" name="year" dataType="text"></w2:column>
                        <w2:column id="series1" name="상반기" dataType="number"></w2:column>
                        <w2:column id="series2" name="하반기" dataType="number"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <label><![CDATA[2011]]></label>
                            <series1><![CDATA[410]]></series1>
                            <series2><![CDATA[300]]></series2>
                        </w2:row>
                        <w2:row>
                            <label><![CDATA[2012]]></label>
                            <series1><![CDATA[450]]></series1>
                            <series2><![CDATA[420]]></series2>
                        </w2:row>
                        <w2:row>
                            <label><![CDATA[2013]]></label>
                            <series1><![CDATA[390]]></series1>
                            <series2><![CDATA[440]]></series2>
                        </w2:row>
                        <w2:row>
                            <label><![CDATA[2014]]></label>
                            <series1><![CDATA[420]]></series1>
                            <series2><![CDATA[450]]></series2>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
                <w2:dataList id="dataList2" baseNode="list" style="" repeatNode="map">
                    <w2:columnInfo>
                        <w2:column id="label" name="년" dataType="text"></w2:column>
                        <w2:column id="seriesA" name="F" dataType="number"></w2:column>
                        <w2:column id="seriesB" name="S" dataType="number"></w2:column>
                    </w2:columnInfo>
                    <w2:data use="true">
                        <w2:row>
                            <label><![CDATA[2001]]></label>
                            <seriesA><![CDATA[210]]></seriesA>
                            <seriesB><![CDATA[400]]></seriesB>
                        </w2:row>
                        <w2:row>
                            <label><![CDATA[2002]]></label>
                            <seriesA><![CDATA[250]]></seriesA>
                            <seriesB><![CDATA[220]]></seriesB>
                        </w2:row>
                        <w2:row>
                            <label><![CDATA[2003]]></label>
                            <seriesA><![CDATA[190]]></seriesA>
                            <seriesB><![CDATA[140]]></seriesB>
                        </w2:row>
                        <w2:row>
                            <label><![CDATA[2004]]></label>
                            <seriesA><![CDATA[120]]></seriesA>
                            <seriesB><![CDATA[150]]></seriesB>
                        </w2:row>
                    </w2:data>
                </w2:dataList>
            </w2:dataCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function() {
    fusionchart1.setChartColumnRef("data:dataList2", "label", "[['seriesA','seriesB']]");
}
scwin.trigger2_onclick = function() {
    fusionchart2.setChartColumnRef("data:dataList1", "label", "[['series1','series2']]");
}
scwin.onpageload = function() {
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group id="group1" style="position:relative;margin-top:100px;">
            <w2:textbox class="titlebox" id="textbox4" label="FusionChart" style="" tagname=""></w2:textbox>
            <xf:group id="group4" style="display:inline-block;">
                
                <w2:fusionchart seriesNode="" id="fusionchart1" ref="data:dataList1" chartType="MSColumn3D" valueNode=""
                    seriesColumns="[['series1','series2']]" style="clear:both;float:left;width: 300px;height: 200px;" seriesType="advanced"
                    drawType="mixed" labelNode="label" accessibility="false" plotColor="">
                </w2:fusionchart>
                <xf:trigger id="trigger1" style="width:182px;height:23px;margin-top:10px;" type="button" ev:onclick="scwin.trigger1_onclick">
                    <xf:label><![CDATA[setChartColumnRef]]></xf:label>
                </xf:trigger>
            </xf:group>
            <xf:group id="group5" style="display:inline-block;margin-left:10px;">
                

                 <w2:fusionchart seriesNode="" id="fusionchart2" ref="data:dataList2" chartType="MSColumn3D" valueNode=""
                    seriesColumns="[['seriesA','seriesB']]" style="clear:both;float:left;width: 300px;height: 200px;" seriesType="advanced"
                    drawType="mixed" labelNode="label" accessibility="false" plotColor="">
                </w2:fusionchart>
                <xf:trigger id="trigger2" style="width:182px;height:23px;margin-top:10px;" type="button" ev:onclick="scwin.trigger2_onclick">
                    <xf:label><![CDATA[setChartColumnRef]]></xf:label>
                </xf:trigger>
            </xf:group>
        </xf:group>
        
    </body>
</html> 