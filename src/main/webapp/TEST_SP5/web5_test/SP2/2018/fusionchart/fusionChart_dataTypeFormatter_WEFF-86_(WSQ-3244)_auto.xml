};
scwin.checkValue = function(cl, i, value) {
	var temp = document.getElementsByClassName('raphael-group-41-line')[0].getElementsByTagName("path").length;
	return temp > 9;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "2000");
    WebSquare.wUnit.addCommand("assert", "scwin.checkValue()", "true");
    WebSquare.wUnit.addCommand("pause", "500");

    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
]]></script>


	</head>
	<body ev:onpageload="scwin.onpageload">
