<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                	<root>
                		<ui>
                			<vector>
                				<vector_row>
                					<col1>false</col1>
	                				<col2>1111</col2>
	                				<col3>1</col3>
                				</vector_row>
                				<vector_row>
                					<col1>false</col1>
	                				<col2>2222</col2>
	                				<col3>2</col3>
                				</vector_row>
                				<vector_row>
                					<col1>false</col1>
	                				<col2>3333</col2>
	                				<col3>2</col3>
                				</vector_row>
                				<vector_row>
                					<col1>false</col1>
	                				<col2>4444</col2>
	                				<col3>1</col3>
                				</vector_row>
                				<vector_row>
                					<col1>false</col1>
	                				<col2>5555</col2>
	                				<col3>2</col3>
                				</vector_row>
                			</vector>
                		</ui>
                	</root>
                </data>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    grid1.setCellData(1, 1, "test data!!!");
};
scwin.trigger2_onclick = function(e) {
    log = grid1.getCellData(1, 1);
    //alert(grid1.getCellData( 1 , 1));
};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플실행 후 'getCellData'버튼을 클릭한다.
    //1. After running the sample, click the 'getCellData' button.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1. 알림창에 '2222'값이 정상적으로 보여진다. (이전에는 '4444'값이 보여짐)
    //1. The '2222' value will be displayed normally. (Previously the '4444' value is shown)
    WebSquare.wUnit.addCommand("assert", "log", "2222");
    WebSquare.wUnit.addCommand("pause", "1000");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.log = undefined;
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 23-Feb-2018
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:grid ref="root/ui/vector" baseNode="vector" repeatNode="vector_row" id="grid1" style="width: 500px;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column5" style="" inputType="text" width="120" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="" inputType="text" width="120" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="" width="120" inputType="text" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="" inputType="checkbox" width="120" value="" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="" inputType="drilldown" width="120" value="" displayMode="label" depthType="div" depthColumn="col3" showDepth="1"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="" width="120" inputType="text" value="" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:grid>
    	<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[setCellData]]></xf:label>
    	</xf:trigger>
    	<xf:trigger type="button" id="trigger2" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
    		<xf:label><![CDATA[getCellData]]></xf:label>
    	</xf:trigger>
    </body>
</html> 