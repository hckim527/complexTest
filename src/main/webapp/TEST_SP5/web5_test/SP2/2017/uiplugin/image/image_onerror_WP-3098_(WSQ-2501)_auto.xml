        <script type="text/javascript" lazy="false"><![CDATA[
scwin.occurrences = function(string, subString, allowOverlapping) {
    string += "";
    subString += "";
    if (subString.length <= 0) return (string.length + 1);
    var n = 0,
        pos = 0,
        step = allowOverlapping ? 1 : subString.length;
    while (true) {
        pos = string.indexOf(subString, pos);
        if (pos >= 0) {
            ++n;
            pos += step;
        } else break;
    }
    return n;
}
scwin._checkValue = function() {
    var vl = WebSquare.wUnit.getJq("#result").val();
    var count1 = scwin.occurrences(vl, "inline onerror function called.", false);
    var count2 = scwin.occurrences(vl, "config onerror function called.", false);
    return (count1 == 8) && (count2 == 8);
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일을 개발자모드(F12)에서 실행한다.
    //1. Run the sample file in developer mode (F12).
    //Verify 1. 우측에 config onerror function called, inline onerror function called가 각각 8번씩 보여진다.(정상) 
    //1. On the right side, the config onerror function called and the inline onerror function called are shown eight times each (normal)
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin._checkValue()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
