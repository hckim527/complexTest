		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사). 2026-11
scwin.__getJq = function(q) {
    var j = $(q); if (j.length) return j;
    var P = 'mf_', t = q.trim(), r = t.slice(1);
    if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
    return $(t.slice(0, 1) + r);
};
scwin.trigger1_onclick = function(e) {
    dataList1.removeRow(0);
};
scwin.__isDeleted = function() {
	var dataLabel = WebSquare.util.getDataPrefix("label");
    var tree = ((j) => j.length ? j : $('#mf_treeview1'))($('#treeview1')),
        childOftree = scwin.__getJq(tree).find('div.w2treeview_group'),
        labelAfter = ((j) => j.length ? j : $('#mf_treeview1_group_1'))($('#treeview1_group_1')).attr(dataLabel);
    return childOftree.length == 3 && labelAfter != rowLabel;
}

scwin.onpageload = function() {
    //Function unitTest
    //Created By: Sang.do
    //Created By: 23-Jan-2018
    var dataLabel = WebSquare.util.getDataPrefix("label");
    window.rowLabel = ((j) => j.length ? j : $('#mf_treeview1_group_1'))($('#treeview1_group_1')).attr(dataLabel);
    //end
    scwin.dataForceRefresh = WebSquare.util.getDataPrefix("forceRefresh");
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:treeview dataType="listed" id="treeview1"
