<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="a" name="name1" dataType="text"></w2:column>
            			<w2:column id="b" name="name2" dataType="text"></w2:column>
            			<w2:column id="c" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row></w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    WebSquare.wUnit.start();
    //pc
    //WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('tabControl1_tab_tabs2').click()");
    //mobile
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('tabControl1').setSelectedTabIndex(1)");
    WebSquare.wUnit.addCommand("pause", "500");
    //이슈 : 실행결과 화면의 name2의 width값이 70보다 커야하는데 결과값을 가져올수가 없음 
    WebSquare.wUnit.addCommand("assert", "scwin.checkAttribute()", "true");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
};
scwin.unitTest();
scwin.onpageload = function() {
};
scwin.checkAttribute = function() {
    var dataOr_wd = WebSquare.util.getDataPrefix("or_wd");
    if (WebSquare.wUnit.getObjById($p.id+'gridView1_cell_0_1').getAttribute(dataOr_wd) == '70') {
        return true;
    }
    return false;
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:tabControl useTabKeyOnly="true" useMoveNextTabFocus="false" useConfirmMessage="false" confirmTrueAction="exist"
    		confirmFalseAction="new" alwaysDraw="true" style="position: relative ;width: 500px;height: 200px;left:46px;top:19px;" id="tabControl1">
    		<w2:tabs label="alwayDraw = false" disabled="false" style="width:185px;height:30px;" id="tabs1"></w2:tabs>
    		<w2:tabs disabled="false" style="width:185px;height:30px;" label="alwayDraw = true" id="tabs2"></w2:tabs>
    		<w2:content alwaysDraw="false" style="height:170px" id="content1">
    			<w2:gridView scrollByColumn="false" id="" ignoreToggleOnDisabled="false" scrollByColumnAdaptive="false" summaryAuto="false"
    				useShiftKey="true" fixedColumnWithHidden="true" style="position: relative;width: 500px;height: 150px;" dataList="dataList1"
    				ignoreCellClick="false">
    				<w2:header style="" id="header1">
    					<w2:row style="" id="row1">
    						<w2:column width="70" inputType="text" style="height:20px" id="column5" blockSelect="false" displayMode="label"
    							value="name1">
    						</w2:column>
    						<w2:column width="*" inputType="text" style="height:20px" id="column3" blockSelect="false" displayMode="label"
    							value="name2">
    						</w2:column>
    						<w2:column width="100" inputType="text" style="height:20px" id="column1" blockSelect="false" displayMode="label"
    							value="name3">
    						</w2:column>
    					</w2:row>
    				</w2:header>
    				<w2:gBody style="" id="gBody1">
    					<w2:row style="" id="row2">
    						<w2:column width="70" inputType="text" style="height:20px" id="a" blockSelect="false" displayMode="label"></w2:column>
    						<w2:column width="70" inputType="text" style="height:20px" id="b" blockSelect="false" displayMode="label"></w2:column>
    						<w2:column width="70" inputType="text" style="height:20px" id="c" blockSelect="false" displayMode="label"></w2:column>
    					</w2:row>
    				</w2:gBody>
    			</w2:gridView>
    		</w2:content>
    		<w2:content alwaysDraw="true" style="height:170px" id="content2">
    			<w2:gridView scrollByColumn="false" id="gridView1" ignoreToggleOnDisabled="false" scrollByColumnAdaptive="false" summaryAuto="false"
    				useShiftKey="true" fixedColumnWithHidden="true" style="position: relative;width: 500px;height: 150px;" dataList="dataList1"
    				ignoreCellClick="false">
    				<w2:header style="" id="header1">
    					<w2:row style="" id="row1">
    						<w2:column width="70" inputType="text" style="height:20px" id="column5" blockSelect="false" displayMode="label"
    							value="name1">
    						</w2:column>
    						<w2:column width="*" inputType="text" style="height:20px" id="column3" blockSelect="false" displayMode="label"
    							value="name2">
    						</w2:column>
    						<w2:column width="100" inputType="text" style="height:20px" id="column1" blockSelect="false" displayMode="label"
    							value="name3">
    						</w2:column>
    					</w2:row>
    				</w2:header>
    				<w2:gBody style="" id="gBody1">
    					<w2:row style="" id="row2">
    						<w2:column width="70" inputType="text" style="height:20px" id="a" blockSelect="false" displayMode="label"></w2:column>
    						<w2:column width="70" inputType="text" style="height:20px" id="b" blockSelect="false" displayMode="label"></w2:column>
    						<w2:column width="70" inputType="text" style="height:20px" id="c" blockSelect="false" displayMode="label"></w2:column>
    					</w2:row>
    				</w2:gBody>
    			</w2:gridView>
    		</w2:content>
    	</w2:tabControl>
    </body>
</html>
 