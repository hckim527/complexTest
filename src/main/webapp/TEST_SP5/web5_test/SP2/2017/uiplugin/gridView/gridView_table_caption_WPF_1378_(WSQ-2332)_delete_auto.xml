scwin.__isCheckCaption = function() {
    var cap = WebSquare.wUnit.getJq('#caption2').html();
    return cap == "그룹1 테스트 은(는) title1,title4,title2,title5,title3,title6 을(를) 나타낸 표" || cap == "그룹1 테스트 is title1,title4,title2,title5,title3,title6 displayed in the table";
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.__isCheckCaption()", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

