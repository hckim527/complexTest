        xpath: "response/vector_common/data[1]/col2",
        scopeId: "wf_common",
        value: "test_aaa"
    });
    WebSquare.ModelUtil.setInstanceValue({
        xpath: "response/vector_grid/data[2]/col2",
        value: "test_bbb"
    });
}
