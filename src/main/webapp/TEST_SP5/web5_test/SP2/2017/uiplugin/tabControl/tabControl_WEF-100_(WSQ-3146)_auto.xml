		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
}		

scwin.testHiddenTabClass = function(id) {
    var dom = WebSquare.wUnit.getDomById($p.id + id);
    if (dom) {
        var labelArr = dom.getElementsByTagName("li");
        if (labelArr.length > 0) {
            var pos = labelArr[0].className.indexOf("li_1");
            if (pos > -1) {
                return true;
            }
        }
        return false;
    }
    return null;
}

	scwin.checkVal1 = function() {
		const element = WebSquare.wUnit.getDomById("tabControl1_btn_scrollRight");
		let reVal = false;
		if (element && element.tagName.toLowerCase() === "button" && element.type === "button") {
			reVal = true;
		}
		return reVal;
	}
	scwin.checkVal2 = function() {
		const container = WebSquare.wUnit.getDomById("tabControl1_itemTable");
		let reVal = false;

		if (!container) {
			return reVal;
		} else {
			var ulElement = container.querySelector("ul");

			if (!ulElement || ulElement.tagName.toLowerCase() !== "ul") {
				return reVal;
			} else {
				// ul 내부에 li 요소들을 모두 선택함
				var liElements = ulElement.querySelectorAll("li");

				if (liElements.length > 0) {
					reVal = true;
				} else {
					reVal = false;
				}
			}
		}
		return reVal;
	}	
	scwin.unitTest = function() {
		//Unit test
		WebSquare.wUnit.start();
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		
		WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('tabControl1_btn_submenu').click()");
		WebSquare.wUnit.addCommand("pause", "500");
		WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
		WebSquare.wUnit.addCommand("pause", "500");
		
		//Run and Stop test
		WebSquare.wUnit.run();
		WebSquare.wUnit.stop();
	}
	scwin.unitTest();

]]></script>
