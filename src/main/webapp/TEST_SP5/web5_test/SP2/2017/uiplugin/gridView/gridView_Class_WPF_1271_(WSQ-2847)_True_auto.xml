        <script type="text/javascript" lazy="false"><![CDATA[
// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사). 2026-11
scwin.__getJq = function(q) {
    var j = $(q); if (j.length) return j;
    var P = 'mf_', t = q.trim(), r = t.slice(1);
    if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
    return $(t.slice(0, 1) + r);
};
scwin.__isApplied = function(colid) {
    var dataCol_id = WebSquare.util.getDataPrefix("col_id");
    var tds = ((j) => j.length ? j : $('.mf_grid_body_row'))($('.grid_body_row')).not('.w2grid_hidedRow').find('td[' + dataCol_id + '="' + colid + '"]');
    var count = 0;
    for (var i = 0; i < tds.length; i++) {
        if (scwin.__getJq(tds[i]).children(1).hasClass("w2grid_input")) {
            count++;
        }
    }
    return count == tds.length;
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
}
]]></script>
