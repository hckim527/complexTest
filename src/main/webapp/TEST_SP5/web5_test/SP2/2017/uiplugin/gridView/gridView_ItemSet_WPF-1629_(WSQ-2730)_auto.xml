		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    dataList1.setColumnFilter({
        type: 'row',
        colIndex: 'name',
        key: '아몬드',
        condition: 'and'
    });
};
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. Script 탭 또는 Source 탭에서 scwin.trigger1_onclick 부분을 확인한다.
    //1. Check the scwin.trigger1_onclick section in the Script tab or Source tab.
    // verify step 1. 코멘트참고
    //1. Comment Reference
    //Test step 2. 브라우저에서 아몬드로 filter 버튼을 클릭후 GridItemset 의 SelectBox 와 AutoComplete을 클릭하여 리스트를 확인한다.
    //2. In the browser, click the filter button with almonds, then click SelectBox and AutoComplete in the GridItemset to see the list.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "1000");
    //Verify step 2. setColumnFilter의 키인 "아몬드"로 필터가 적용된다. (그전버전에서는 아래 그림처럼 필터가 적용되지 않음) 
    //2. The filter is applied to the setColumnFilter key "Almond". (Previous versions do not apply filters as shown below)
    //WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('selectbox2_button').click()");
    //WebSquare.wUnit.addCommand("pause", "500");
    //WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#selectbox2_gridViewItemTable_gridView_body_tbody tr').not('.w2grid_hidedRow').length == 1", "true");
    //WebSquare.wUnit.addCommand("pause", "500");
    //WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#selectbox2_gridViewItemTable_gridView_body_tbody tr').not('.w2grid_hidedRow').find('td')[1].innerText == '아몬드'", "true");
    //WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('autoComplete2_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#autoComplete2_gridViewItemTable_gridView_body_tbody tr').not('.w2grid_hidedRow').length == 1", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#autoComplete2_gridViewItemTable_gridView_body_tbody tr').not('.w2grid_hidedRow').find('td')[1].innerText == '아몬드'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function unitTest
    //Created By: Sang.do
    //Created By: 29-Jan-2018
    //end unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
