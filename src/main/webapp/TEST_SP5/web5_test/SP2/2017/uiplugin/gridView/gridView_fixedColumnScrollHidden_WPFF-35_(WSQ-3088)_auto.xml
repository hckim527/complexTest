            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.tooltip_test = function(label) {
    debugger;
    //console.log("tooltip Formatter label is	"+ label);
    return "label tooltip formatter";
}
scwin.__checkStyle = function() {
    var st = WebSquare.wUnit.getObjById('gridView1_scrollX_left').childNodes[0];
    return st.style.overflowX;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플 실행 후 하단의 가로 스크롤을 확인한다.
    //1. After running the sample, check the horizontal scroll at the bottom.
    //Verify 1. 그리드뷰의 왼쪽 고정된 영역의 스크롤이 보이지 않는다.(기능추가임)
    //1. I can not see the scrolling of the fixed area on the left side of the grid view.
    WebSquare.wUnit.addCommand("assert", "scwin.__checkStyle()", "hidden");
    WebSquare.wUnit.addCommand("pause", "1000");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.arr = [];
    for (var i = 0; i < 3 * 10; i++) {
        arr[i] = i;
    }
    dataList1.setData(arr);
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 23-Feb-2018
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView useFilterList="false" dataList="dataList1" scrollByColumn="false" tooltipHeader="true" summaryAuto="false"
