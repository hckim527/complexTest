scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 0. gridViewItemset속성에 추가한다.
    //Add it to the gridViewItemset property.
    //Verify 0. rowNumVisible="true", rowStatusVisible="true"
    //Test step 1. 샘플파일을 실행 후 하단의 selectbox값을 클릭한다
    //Run the sample file and click the selectbox value at the bottom.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_3_label').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1.1 selectbox의 height와 width의 값이 각각 20%, 80%로 적용되어 보여진다.(이전에는 픽셀단위로 적용됨)
    //The height and width values of the selectbox are applied at 20% and 80%, respectively (previously applied in pixels).
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'wq_uuid_3_gridViewItemTable').style.width == '80%'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1.2 rowNum과 rowStatus 항목이 추가되어 보여진다.(기능개선 건으로 이전에는 기능이 없었음)
    //rowNum and rowStatus items are added.(Function improvement case, there was no function before)
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
