        <script type="text/javascript" lazy="false"><![CDATA[
scwin._check = function() {
    return (WebSquare.wUnit.getJq("#wq_uuid_5").html() == "테이블명 abc은(는) 누락되는&nbsp;th,aaaa,dddd,eeee,ffff 을(를) 나타낸 표") ||
        (WebSquare.wUnit.getJq("#wq_uuid_5").html() == "테이블명 abc은(는) 누락되는 th,aaaa,dddd,eeee,ffff 을(를) 나타낸 표") ? true : false;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "1000");
    //WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#wq_uuid_5').html()", "테이블명 abc은(는) 누락되는&nbsp;th,aaaa,dddd,eeee,ffff 을(를) 나타낸 표");
    WebSquare.wUnit.addCommand("assert", "scwin._check()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 7. '31' 을 검색한다.
    //7. Search for '31'.
    //Verify step 7. The table name abc is displayed as a table showing the span component with the value and the Textbox component with the value. 
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#wq_uuid_31').html()", "테이블명 abc은(는) 값이 있는 span 컴포넌트,값이 있는 Textbox 컴포넌트 을(를) 나타낸 표");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 10-Apr-2018
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
