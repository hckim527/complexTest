        <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    var jsonData = [];
    dataList1.setJSON(jsonData);
}
scwin.checkTop = function() {
    if (WebSquare.wUnit.getObjById('gridView1_noresult').style.top == "168px" || WebSquare.wUnit.getObjById('gridView1_noresult').style.top == "186px") {
        return true;
    }
    return false;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 샘플파일 실행 후 noResultMessage의 위치를 확인한다.
    //1. After executing the sample file, check the location of noResultMessage.
    //WebSquare.wUnit.addCommand("set", "");
    // verify step 1. noResultMessage의 위치가 gridView header의 row의 갯수에 따라 유동적으로 gridView 중앙에 위치한다. (이전에는 중앙보다 위쪽으로 위치하였음)
    //1. The position of noResultMessage is centered on the gridView depending on the number of rows in the gridView header. (Formerly located above the center)
    WebSquare.wUnit.addCommand("assert", "scwin.checkTop()", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView1_noresult').style.left", "40%");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView2_noresult').style.top", "40%");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView2_noresult').style.left", "40%");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.init();
    //Function unitTest
    //Created By: Sang.do
    //Created By: 25-Jan-2018
    //end unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
