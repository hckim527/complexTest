        <script type="text/javascript" lazy="false"><![CDATA[
// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사). 2026-11
scwin.__getJq = function(q) {
    var j = $(q); if (j.length) return j;
    var P = 'mf_', t = q.trim(), r = t.slice(1);
    if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
    return $(t.slice(0, 1) + r);
};
scwin.trigger3_onclick = function(e) {
    grid1.setRowVisible(10, false);
    grid1.setRowVisible(11, false);
    grid1.setRowVisible(12, false);
    grid1.setRowVisible(13, false);
    grid1.setRowVisible(14, false);
};
scwin.__isShowDataNormal = function() {
    var row = ((j) => j.length ? j : $('.mf_grid_body_row'))($('.grid_body_row')).not(".w2grid_hidedRow");
    var count = 0;
    row.each(function() {
        if (scwin.__getJq(this).css("display") != "none") {
            count++;
        }
    });
    return count == row.length;
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
}
]]></script>
