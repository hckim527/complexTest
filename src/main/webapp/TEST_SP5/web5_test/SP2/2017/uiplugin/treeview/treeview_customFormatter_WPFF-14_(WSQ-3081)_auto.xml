		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    treeView1.deselectNode();
};
scwin.trigger2_onclick = function(e) {
    if (treeView1.options.showCheckbox == true) {
        treeView1.setShowCheckBox(false);
    } else {
        treeView1.setShowCheckBox(true);
    }
};
scwin.treeViewFormatter = function(orgLabel, label, node) {
	//debugger;
	return node.label + "_" + node.index;
};
scwin.checkVal1 = function() {
    return WebSquare.wUnit.getDomById('treeView1_label_1').textContent != 'New';
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
scwin.onpageload = function() {
}
]]></script>
