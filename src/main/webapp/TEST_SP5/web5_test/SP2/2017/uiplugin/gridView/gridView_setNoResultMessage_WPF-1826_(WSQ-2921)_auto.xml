scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일을 실행 후 상단의 tab2 > tab1 > setNoResultMessage 클릭 > tab2를 클릭하여 그리드뷰의 높이가 유지되는지 확인한다.
    //1. After running the sample file, click tab2> tab1> setNoResultMessage at the top and click tab2 to check if the height of the grid view is maintained.
    WebSquare.wUnit.addCommand("pause", "1000");
    //pc
    //WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_5_tab_tabs2').click()");
    //WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_5_tab_tabs1').click()");
    //WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger4').click()");
    //WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_5_tab_tabs2').click()");
    //mobile
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_5').setSelectedTabIndex(1)");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_5').setSelectedTabIndex(0)");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger4').click()");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('wq_uuid_5').setSelectedTabIndex(1)");
    //Verify step 1. 상단의 tab2에 해당하는 그리드뷰의 높이가 유지된다.
    //1. The height of the grid view corresponding to tab2 at the top is maintained.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'grd2').getBoundingClientRect().height > 200", "true");
    //Test step 2. 아래의 조회 > setNoResultMessage 클릭 > grp1.show() 클릭 시 하단에 보여지는 그리드뷰의 높이가 유지되는지 확인한다.
    //2. Click View> setNoResultMessage below> Grp1.show () Click to see if the height of the grid view shown at the bottom is maintained.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click()");
    //Verify step 2. 하단의 그리드뷰의 높이가 유지된다.(이전에는 tab2의 그리드뷰 및 하단의 그리드뷰 높이가 줄어들었음)
    //2. Maintains the height of the grid view at the bottom (previously the height of the grid view of tab2 and the height of the grid view at the bottom)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'grd3').getBoundingClientRect().height > 200", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
