        treeView1.setShowCheckBox(false);
    } else {
        treeView1.setShowCheckBox(true);
    }
};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플실행 후 상단의 트리뷰영역(-bb)을 클릭한다.
    //1. After running the sample, click on the treeview area (-bb) at the top.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('treeView1_col_icon_navi_3').childNodes[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1. 선택(클릭)한 노드가 선택되어진다.(첨부1)
    //1. Select (click) the selected node. (Attachment 1)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById($p.id+'treeView1_child_3').style.display == 'none'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 2. 'deselectNode'버튼을 클릭한다.
    //2. Click the 'deselectNode' button.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 2. 선택(클릭)한 노드가 선택해제되어 다시 보여진다.(첨부2) (이전에는 API기능 없었음)
    //2. The selected node is deselected and shown again. (Attachment 2)(Previously there was no API functionality)
    WebSquare.wUnit.addCommand("assert", "window.getComputedStyle(WebSquare.wUnit.getDomById($p.id+'treeView1_label_3')).getPropertyValue('color') == 'rgb(0, 0, 0)'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 23-Feb-2018
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
scwin.test = function() {
        debugger;
        return "bb";
    }
scwin.test2 = function() {
        return "aa";
    }
