<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataMap baseNode="map" id="dc_tmpData" style="">
					<w2:keyInfo>
						<w2:key dataType="text" id="input2" name="input2"></w2:key>
						<w2:key dataType="text" id="input3" name="input3"></w2:key>
						<w2:key dataType="text" id="input4" name="input4"></w2:key>
						<w2:key dataType="text" id="searchbox1" name="searchbox1"></w2:key>
						<w2:key dataType="text" id="secret1" name="secret1"></w2:key>
						<w2:key dataType="text" id="inputCalendar2" name="inputCalendar2"></w2:key>
						<w2:key dataType="text" id="textarea1" name="textarea1"></w2:key>
						<w2:key dataType="text" id="spinner1" name="spinner1"></w2:key>
						<w2:key dataType="text" id="spinner2" name="spinner2"></w2:key>
					</w2:keyInfo>
					<w2:data use="true">
						<input2><![CDATA[1299.678]]></input2>
						<input3><![CDATA[20200101]]></input3>
						<input4><![CDATA[1234]]></input4>
						<searchbox1><![CDATA[WebSquare]]></searchbox1>
						<secret1><![CDATA[1111]]></secret1>
						<inputCalendar2><![CDATA[20070101]]></inputCalendar2>
						<textarea1><![CDATA[여기에 글을 입력하세요.]]></textarea1>
						<spinner1><![CDATA[20070101]]></spinner1>
						<spinner2><![CDATA[4]]></spinner2>
					</w2:data>
				</w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
         <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    edu.onpageload = function() {
        editor1.setHTML("이곳에<br/>글을 입력하세요.");
    };
    edu.onpageunload = function() {};
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="" id="" style="padding:10px;">
    		<xf:group class="section_title" id="" style="padding: 10px;">
    			<w2:textbox id=""
    				label="폼을 구성하는 컴포넌트로, 텍스트 입력이 가능한 컴포넌트이다.&lt;br/&gt;InputBox, SearchBox, Secret, InputCalendar, TextArea, Editor, Spinner가 해당된다.&lt;br/&gt;( source : 01.xml )"
    				style="" tagname="">
    			</w2:textbox>
    		</xf:group>
    		<xf:group class="" id="" style="overflow:hidden;">
    			<xf:group id="" style="float:left;margin-right:10px;">
    				<xf:group class="section dmb" id="" style="width:213px;">
    					<w2:textbox class="contTitle02 dmb" id="" label="InputBox" style=""></w2:textbox>
    					<xf:group class="ofh dmb" id="" style="">
    						<w2:textbox class="fl dmr" id="" label="text"
    							style="padding-top:5px;padding-bottom:5px;width:60px;text-align:right;">
    						</w2:textbox>
    						<xf:input class="fl" dataType="text" id="" placeholder="이름을 입력하세요." ref="" style="height:25px;width:130px;"></xf:input>
    					</xf:group>
    					<xf:group class="ofh dmb" id="" style="">
    						<w2:textbox class="fl dmr" id="" label="number"
    							style="padding-top:5px;text-align:right;width:60px;padding-bottom:5px;">
    						</w2:textbox>
    						<xf:input class="fl" dataType="number" displayFormat="#,###.##" id="" placeholder="숫자만 입력가능"
    							ref="data:dc_tmpData.input2" style="height:25px;width:130px;">
    						</xf:input>
    					</xf:group>
    					<xf:group class="ofh dmb" id="" style="">
    						<w2:textbox class="fl dmr" id="" label="date"
    							style="padding-top:5px;text-align:right;width:60px;padding-bottom:5px;">
    						</w2:textbox>
    						<xf:input class="fl" dataType="date" dateMask="MM/dd/yyyy" id="" placeholder="날짜타입" ref="data:dc_tmpData.input3"
    							style="height:25px;width:130px;">
    						</xf:input>
    					</xf:group>
    				</xf:group>
    				<xf:group class="section dmb ofh" id="" style="width:213px;">
    					<w2:textbox class="contTitle01 fl" id="" label="SearchBox" style=""></w2:textbox>
    					<w2:searchbox class="fl" id="" ref="data:dc_tmpData.searchbox1" style="height:25px;width:120px;margin-top: 6px;"></w2:searchbox>
    				</xf:group>
    				<xf:group class="section dmb ofh" id="" style="width:213px;">
    					<w2:textbox class="contTitle01 fl" id="" label="Secret" style=""></w2:textbox>
    					<xf:secret class="fl dmt" id="" ref="data:dc_tmpData.secret1" style="height:25px;width:120px;"></xf:secret>
    				</xf:group>
    				<xf:group class="section dmb" id="" style="width:213px;">
    					<w2:textbox class="contTitle02" id="" label="InputCalendar" style=""></w2:textbox>
    					<xf:group class="dp" id="" style="">
    						<w2:inputCalendar calendarClass="" calendarImage="" calendarImageOver="" calendarValueType="yearMonthDate" id=""
    							ref="data:dc_tmpData.inputCalendar2" setCurrentDate="true" style="height:22px;width:100%">
    						</w2:inputCalendar>
    					</xf:group>
    				</xf:group>
    			</xf:group>
    			<xf:group id="" style="float:left;margin-right:10px;">
    				<xf:group class="section dmb" id="" style="overflow:hidden;width:213px;">
    					<w2:textbox class="contTitle02 dmb" id="" label="Textarea" style=""></w2:textbox>
    					<xf:group class="dp" id="" style="text-align: center;">
    						<xf:textarea id="" ref="data:dc_tmpData.textarea1" style="width:190px;height: 100px;"></xf:textarea>
    					</xf:group>
    				</xf:group>
    				<xf:group class="section dmb" id="" style="width:213px;">
    					<w2:textbox class="contTitle02 dmb" id="" label="Spinner" style=""></w2:textbox>
    					<xf:group class="ofh dmb" id="" style="">
    						<w2:textbox class="fl dmr" id="" label="date" style="padding:9px 0px;width:60px;text-align:right;"></w2:textbox>
    						<w2:spinner buttonSize="60" class="fl" dataType="date" dateMask="" id="" inputReadOnly="false"
    							ref="data:dc_tmpData.spinner1" skin="type2" style="height:30px;width:140px;position: relative;">
    						</w2:spinner>
    					</xf:group>
    					<xf:group class="ofh dmb" id="" style="">
    						<w2:textbox class="fl dmr" id="" label="number" style="padding:9px 0px;width:60px;text-align:right;"></w2:textbox>
    						<w2:spinner buttonSize="30" id="" increment="2" inputReadOnly="false" max="10" min="0"
    							ref="data:dc_tmpData.spinner2" skin="type1" style="position:relative;height:30px;width:140px;">
    						</w2:spinner>
    					</xf:group>
    				</xf:group>
    			</xf:group>
    			<xf:group class="section dmb" id="" style="float:left;width:500px;height:420px;clear:both;">
    				<w2:textbox class="contTitle02 dmb" id="" label="Editer ( CKEditor )" style=""></w2:textbox>
    				<w2:editor id="editor1" menubar="default" style="width:470px;height:280px;margin: 0px auto;"></w2:editor>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>
 