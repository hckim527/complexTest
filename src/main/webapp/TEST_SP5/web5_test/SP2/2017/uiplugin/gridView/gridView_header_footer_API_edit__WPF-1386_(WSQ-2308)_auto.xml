    dataMap1.set("key1", "555555");
    window.value = gridView1.getFormattedHeaderValue("column11", "555555");
    gridView1.setHeaderValue("column11", value);
    //Function 
    //Created by: Quan.Nguyen
    //Created date: 30-Jan-2018
    //end
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
