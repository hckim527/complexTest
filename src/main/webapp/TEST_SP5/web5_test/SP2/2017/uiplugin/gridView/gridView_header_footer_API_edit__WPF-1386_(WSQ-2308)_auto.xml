scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일을 실행하여 setHeaderValue 헤더의 값이 설정한 포멧형식으로 보여지는 지 확인한다.
    //1. Run the sample file to verify that the value of the setHeaderValue header is displayed in the format you set.
    WebSquare.wUnit.addCommand("pause", "1000");
    //Verify step 1. setHeaderValue 항목의 2번째 헤더의 값이 '555,555'로 보여진다.
    //1. The value of the second header of the setHeaderValue item is shown as '555,555'.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('gridView1_column11').innerText", "555,555");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
