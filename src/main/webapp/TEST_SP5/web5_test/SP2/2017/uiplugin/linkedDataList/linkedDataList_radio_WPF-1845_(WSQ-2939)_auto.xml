scwin.getTextCol = function(id) {
    return WebSquare.wUnit.getDomById($p.id + id).innerText;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 샘플파일을 실행 후 우측 상단의 radio버튼(2)을 클릭한다
    //1. Run the sample file and click the radio button (2) in the upper right corner.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('radio1_input_1').click()");
    // verify step 1. gridView에 a1, a2, a3값을 정상적으로 가져온다.
    //1. Import a1, a2, and a3 values into gridView as normal.
    WebSquare.wUnit.addCommand("assert", "scwin.getTextCol($p.id+'gridView5_cell_0_0')", "a1");
    WebSquare.wUnit.addCommand("assert", "scwin.getTextCol($p.id+'gridView5_cell_0_1')", "a2");
    WebSquare.wUnit.addCommand("assert", "scwin.getTextCol($p.id+'gridView5_cell_0_2')", "a3");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test
    WebSquare.wUnit.run();
    //stop
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
