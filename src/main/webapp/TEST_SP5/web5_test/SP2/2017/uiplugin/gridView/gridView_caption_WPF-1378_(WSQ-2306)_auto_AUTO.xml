        <script type="text/javascript" lazy="false"><![CDATA[
scwin.issetText = function() {
    var str = WebSquare.wUnit.getJq("caption").first().text();
    return str == "name1,name2,타이틀,name5 span추가 을(를) 나타낸 표";
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일에서 captionAuto = "true"이고 captionTitle="" 값으로 설정 후 개발자모드에서 header title값을 확인한다.
    //1. In the sample file, set captionAuto = "true" and captionTitle = "", and check the header title value in developer mode.            
    //Verify Step 1. "name2,타이틀,name5 span추가 을(를) 나타낸표"로 보여짐(첨부이미지 1-2참고)
    //1. Appears as 'Table showing the addition of name2, title, and name5 span' (see attached image 1-2)
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.issetText()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 2. 샘플파일 속성에서 footerCaption='QWERT'로설정하고 실행하여 개발자모드에서 caption을 확인한다.
    //2. Check the caption in developer mode by setting and running footerCaption = 'QWERT' in the sample file attribute.
    //Verify Step 2. caption부분에 'QWERT'로 보여짐(2번첨부참고)
    //2. Appears as 'QWERT' in caption (see Attachment 2)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#wq_uuid_3_foot_table caption').text() == 'QWERT'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    //Function 
    //Created by: Sang.Do
    //Created date: 29-Jan-2018
    // Test for option footerCaption="QWERT"
    //end
}
]]></script>
