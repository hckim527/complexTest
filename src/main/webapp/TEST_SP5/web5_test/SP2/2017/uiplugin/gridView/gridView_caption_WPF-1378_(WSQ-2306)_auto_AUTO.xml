        <xf:group id="" style="padding:20px;">
            <w2:textbox id="" style="margin-top:261px;" label="1. GridView컴포넌트 captionAuto, captionTitle" tagname="h1"/>
            <w2:textbox id="" label="&lt;strong&gt;html tag가 표시되는 경우&lt;/strong&gt;&lt;br/&gt;1) inputType=&quot;text&quot;가 아닐 경우(checkbox,selectbox)&lt;br/&gt;2) sortable=&quot;true&quot;(sortableImage=&quot;true&quot;) 일 경우&lt;br/&gt;3) 사용자가 직접 html을 사용 했을 경우" style="margin-top:172px;" tagname="p"></w2:textbox>
            <w2:textbox id="" label="[요청사항]&lt;br/&gt;captionAuto(summaryAuto) 수행 시 inputType=&quot;text&quot;의 값만 사용. 그외 inputType의 경우 생략&lt;br/&gt;&lt;br/&gt;[html 제거]&lt;br/&gt;inputType=&quot;text&quot;이지만 사용자가 직접 html tag를 사용 한 경우도 있기에 th에서 가져오는 값은 nobr 내부의 텍스트로 제한하고 그 안에서 직접 입력한 html tag 가 있을 경우 제거하여 cation에 출력" style="margin-top:170px;display:block;" tagname="strong"></w2:textbox>
        </xf:group>
