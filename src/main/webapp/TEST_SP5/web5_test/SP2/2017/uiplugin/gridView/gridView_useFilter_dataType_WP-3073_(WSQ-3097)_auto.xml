scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 1. 샘플 실행 후 상단의 필터를 클릭하여 사용자필터에서 필터조건(>=50)을 설정한다.
    //After running the sample, click the filter at the top to set the filter condition (> = 50) in the user filter.                
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_column1_filter').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getJq('.w2grid_customFilter_list_listRow')[0].click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_item_0_selectbox_column1_label').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_item_0_selectbox_column1_itemTable_4').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_item_0_autocomplete_column1_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_item_0_autocomplete_column1_itemTable_49').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_btnConform_column1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1. 필터링되어 50부터 큰값이 보여진다.(이전에는 6,7,8,9 등의 값도 보여지는 오류 있었음)
    //Filtered to show a large value from 50.(Previously, there were errors such as 6, 7, 8, 9, etc.)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_0_0').text() == '50'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_1_0').text() == '51'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_2_0').text() == '52'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_3_0').text() == '53'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_4_0').text() == '54'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_5_0').text() == '55'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_6_0').text() == '56'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_7_0').text() == '57'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_8_0').text() == '58'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_9_0').text() == '59'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_10_0').text() == '60'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_11_0').text() == '61'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
