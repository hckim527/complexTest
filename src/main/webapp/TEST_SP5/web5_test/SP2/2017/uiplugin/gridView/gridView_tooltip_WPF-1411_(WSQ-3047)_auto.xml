scwin.tooltip_test = function(label) {
    debugger;
    //console.log("tooltip Formatter label is	"+ label);
    return "label tooltip formatter";
}

scwin.fireOver = function(node) {
    if (document.createEventObject) {
        node.fireEvent('onmouseover');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('mouseover', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.onmouseover == 'function') {
        node.onmouseover();
    }
}
scwin.mouseOverBehaviour = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireOver(el);
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");	
    WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour('gridView1_column1')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_tooltip').text() == 'label tooltip formatter'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_tooltip').css('display') == 'block'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    window.arr = [];
    for (var i = 0; i < 3 * 10; i++) {
        arr[i] = i;
    }
    dataList1.setData(arr);
}
]]></script>
