scwin.isShowResult = function() {
    var dataList = WebSquare.wUnit.getJq("#gridView2_body_tbody tr").children("[col_id='NAME']");
    for (var i = 0; i < dataList.length; i++) {
        if (WebSquare.wUnit.getJq(dataList[i]).is(":visible")) {
            var hasTextSearch = dataList[i].innerText.indexOf("정");
            if (hasTextSearch < 0) {
                return false;
            }
        }
    }
    return true;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 브라우저에서 LinkedDataList Binding 에 Like 로 이름을 검색한다. (예 : %정%)
    //1. In the browser, search for the name as LinkedDataList Binding. (Expected%)
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('input1').setValue('%정%')");
    WebSquare.wUnit.addCommand("pause", "1000");
    // verify step 1. 앞뒤로 '정' 이 입력된 이름이 검색된다. (2017-01-26일 엔진에서는 Like 검색이 안되는 현상발생)
    //1. The name of the input 'front' is retrieved. (2017-01-26 engine does not search like the occurrence of the phenomenon)
    WebSquare.wUnit.addCommand("assert", "scwin.isShowResult()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
