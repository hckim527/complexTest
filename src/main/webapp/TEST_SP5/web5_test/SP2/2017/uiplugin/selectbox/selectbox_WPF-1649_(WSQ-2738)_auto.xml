<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
            		</w2:keyInfo>
            		<w2:data use="false"></w2:data>
            	</w2:dataMap>
                <w2:dataMap baseNode="map" id="dataMap2">
                    <w2:keyInfo>
                        <w2:key id="key1" name="name1" dataType="text"></w2:key>
                    </w2:keyInfo>
                    <w2:data use="false"></w2:data>
                </w2:dataMap>
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[1]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[2]]></col1>
            				<col2><![CDATA[2]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[3]]></col1>
            				<col2><![CDATA[3]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[4]]></col1>
            				<col2><![CDATA[4]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    //dataList1.setData([1,1,2,2,3,3,4,4]);
}
scwin.ff = function() {
    console.log("SELECT_ONCHANGE");
}
scwin.fff = function() {
    console.log("SELECT_onVIEWchange");
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일을 실행 후 개발자모드의 콘솔에서 dataMap1.get("key1"); 실행한다.
    // After running the sample file, in the developer mode console, type dataMap1.get ("key1"); .
    //Verify 1. 결과 값 "1"이 보여진다.
    //The result value '1' is displayed.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('dataMap1').get('key1') == '1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 2. 다시 개발자모드의 콘솔에서 dataMap2.get('key1'); 실행한다.
    //Again in the console of developer mode dataMap2.get ('key1'); .
    //Verify 2. 결과 값 '1'이 보여진다.(이전에는 ''값이 보여짐)
    //Result value '1' is displayed (Previously, '' value is shown)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('dataMap2').get('key1') == '1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 29-Jan-2018
    //End unitTest
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" direction="auto" chooseOption="" id="select1"
            style="position: relative;width:265px;height:61px;" displayMode="label" optionOrder="false" allOption="" disabled="false"
            submenuSize="auto" ref="data:dataMap1.key1" renderType="" ev:onchange="scwin.ff" ev:onviewchange="scwin.fff">
            <xf:choices>
                <xf:itemset nodeset="data:dataList1">
                    <xf:label ref="col1"></xf:label>
                    <xf:value ref="col2"></xf:value>
                </xf:itemset>
            </xf:choices>
        </xf:select1>
    	<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" direction="auto" chooseOption="" id="select2"
    		style="position: relative;width:265px;height:61px;" displayMode="label" optionOrder="false" allOption="" disabled="false"
    		submenuSize="auto" ref="data:dataMap2.key1" renderType="select" ev:onchange="scwin.ff" ev:onviewchange="scwin.fff">
    		<xf:choices>
    			<xf:itemset nodeset="data:dataList1">
    				<xf:label ref="col1"></xf:label>
    				<xf:value ref="col2"></xf:value>
    			</xf:itemset>
    		</xf:choices>
    	</xf:select1>
    </body>
</html>
 