		<script type="text/javascript" lazy="false"><![CDATA[
scwin.expTotal = function(row) {
    //debugger;
    var arr = dcList.getRowData(row).slice(dcList.getColumnIndex('target') + 1, dcList.getRowData(row).length - 1);
    var data = arr.reduce(function(a, b) {
        return Number(a) + Number(b)
    }, 0);
    return data;
};
scwin.gvGridList1_onviewchange = function(info) {
    //gvGridList1.refreshCell( info.rowIndex , "total" );
};
scwin.trigger1_onclick = function(e) {
    console.log("delete");
    dcList.deleteRow(1);
};
scwin.trigger2_onclick = function(e) {
    console.log("modify");
    dcList.modifyRowStatus(1, 'D');
    //dcList.modifyMatchedStatus( "chk" , "1" , "D" );
};
scwin.trigger4_onclick = function(e) {
    //debugger;
    dcList.modifyMatchedStatus("chk", "1", "D");
};
scwin.trigger5_onclick = function(e) {
    dcList.modifyRangeStatus(1, 2, 'D');
};
scwin.onpageload = function() {
}
]]></script>
