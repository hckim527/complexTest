<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[11]]></col2>
            				<col3><![CDATA[1]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[2]]></col1>
            				<col2><![CDATA[22]]></col2>
            				<col3><![CDATA[2]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[3]]></col1>
            				<col2><![CDATA[33]]></col2>
            				<col3><![CDATA[3]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[a]]></label>
            				<value><![CDATA[1]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[b]]></label>
            				<value><![CDATA[2]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[c]]></label>
            				<value><![CDATA[3]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dataList3" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[aa]]></label>
            				<value><![CDATA[11]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[bb]]></label>
            				<value><![CDATA[22]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[cc]]></label>
            				<value><![CDATA[33]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.gridView1_oncellclick = function(row, col) {
    var itemsetObj = gridView1.getColumnNodeSet(col);
    if (gridView1.getColumnType(col) != "text")
        alert("nodeset = " + itemsetObj.nodeset + "\n" + "label = " + itemsetObj.label + "\n" + " value = " + itemsetObj.value);
};
scwin.unitTest = function() {
    WebSquare.wUnit.start();
    //WebSquare.wUnit.addCommand('set', 'WebSquare.wUnit.getDomById($p.id+"gridView1_cell_0_2").click();' );
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView1').getColumnNodeSet(WebSquare.wUnit.getObjById('gridView1_cell_0_2')).nodeset == 'data:dataList2'", "true");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" summaryAuto="false" scrollByColumnAdaptive="false" id="gridView1"
    		style="position: absolute;width: 500px;height: 150px;left:82px;top:120px;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		fixedColumnWithHidden="true" useShiftKey="true" ev:oncellclick="scwin.gridView1_oncellclick" editModeEvent="onclick" autoFit="allColumn">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" style="height:20px;" width="70" inputType="text" displayMode="label"
    					value='inputType="text"'>
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px;" inputType="text" width="70" displayMode="label"
    					value='inputType="autoComplete"'>
    				</w2:column>
    				<w2:column blockSelect="false" id="column2" style="height:20px;" inputType="text" width="70" displayMode="label"
    					value='inputType="select"'>
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" width="70" inputType="autoComplete" displayMode="label"
    					allOption="" chooseOption="">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList3">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" width="70" inputType="select" displayMode="label">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:textbox label='inputType = "select" 또는 "autoComplete"인 cell을 클릭하면 alert 창이 뜨면서 해당 cell과 연결된 nodset정보가 나타납니다.' id="" style="position: absolute;width:895px;height:82px;left:80px;top:23px;font-size:24pt;"></w2:textbox>
    </body>
</html>
 