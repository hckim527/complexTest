<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.tooltip_test = function(label) {
    //console.log("tooltip Formatter label is	"+ label);
    return "label tooltip formatter";
}
scwin.__colScrolled = function(td) {
    var count = 0;
    td.each(function() {
        if (WebSquare.wUnit.getJq(this).css("width") == "0px") {
            count++;
        }
    });
    return count == td.length;
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1').setScrollLeft(110)");
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("assert", "scwin.__colScrolled(WebSquare.wUnit.getJq('#gridView1_body_tbody td[colindex=\"0\"]'))", "true");
    WebSquare.wUnit.addCommand("assert", "scwin.__colScrolled(WebSquare.wUnit.getJq('#gridView1_body_tbody td[colindex=\"1\"]'))", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    window.arr = [];
    for (var i = 0; i < 3 * 10; i++) {
        arr[i] = i;
    }
    dataList1.setData(arr);
    //Function unitTest
    //Created By: Sang.do
    //Created By: 19-Mar-2018
    //end unitTest
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView useFilterList="false" dataList="dataList1" scrollByColumn="false" tooltipHeader="true" summaryAuto="false"
    		scrollByColumnAdaptive="false" id="gridView1" style="position: absolute;width:470px;height:223px;left:121px;top:269px;"
    		ignoreCellClick="false" ignoreToggleOnDisabled="false" fixedColumnWithHidden="true" useShiftKey="true" tooltipDisplay="true"
    		tooltipShowAlways="true" rowStatusVisible="true" rowNumVisible="true" senseReader="" tooltipFormatter="tooltip_test" rowNumStatusFixed="false">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" style="height:20px;" width="165" inputType="text" displayMode="label"
    					value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px" inputType="text" width="153" displayMode="label"
    					value="name2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column2" style="height:20px" inputType="text" width="164" displayMode="label"
    					value="name3">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" width="4" inputType="text" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" width="153" inputType="text" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" width="164" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    		<w2:footer id="footer1" style="">
    			<w2:row id="row3" style="">
    				<w2:column blockSelect="false" id="column9" style="height:20px" width="4" inputType="text" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column8" style="height:20px" width="153" inputType="text" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column7" style="height:20px" width="164" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:footer>
    	</w2:gridView>
    	<w2:textbox label='tooltipHeader = "true" 속성이 추가된 GridView' id=""
    		style="position: absolute;width:418px;height:23px;left:119px;top:244px;font-size:14pt;">
    	</w2:textbox>
    </body>
</html>
 