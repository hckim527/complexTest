<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>UDC</w2:type>
		<script src="/TEST/20171027rc/treeView_udc_WPF-1947_(WSQ-3027)_splitter.js" type="text/javascript"></script>
	</head>
	<body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
		<!--/** WEBSQUARE UDC */
			{
			"inherit": "xf:group",
			"componentName": "AppSplitter",
			"pluginName": "app_splitter",
			"company": "",
			"developer": "",
			"category": "Basic",
			"notSupportBrowser": "",
			"version": "",
			"htmlRender": "",
			"icon": "",
			"disableIcon": "",
			"description": "",
			"width": "200px",
			"height": "200px",
			"properties": [
			{
			"name": "id",
			"default": "",
			"type": "string",
			"option": "",
			"necessary": "N",
			"hidden": "N",
			"description": ""
			},
			{
			"name": "orientation",
			"default": "horizontal",
			"type": "combobox",
			"option": "[horizontal,vertical]",
			"necessary": "N",
			"hidden": "N",
			"description": ""
			},
			{
			"name": "position",
			"default": "50%",
			"type": "string",
			"option": "",
			"necessary": "N",
			"hidden": "N",
			"description": ""
			},
			{
			"name": "minSize",
			"default": "0",
			"type": "number",
			"option": "",
			"necessary": "N",
			"hidden": "N",
			"description": ""
			},
			{
			"name": "collapse",
			"default": "",
			"type": "combobox",
			"option": "[left,right,top,bottom]",
			"necessary": "N",
			"hidden": "N",
			"description": ""
			}
			],
			"events": [],
			"apis": []
			}
		-->
		<xf:group pluginName="app_splitter" style="width: 100%;height: 100%;">
			<script ev:event="oncreated(options)" type="text/javascript"><![CDATA[
				var splitter = {};
				splitter.vertical = options.orientation !== 'vertical';
				splitter.minSize = 0;
				splitter.splitterSize = 20;

				if (options.position)
					splitter.position = options.position;
					
				switch (options.collapse) {
					case 'left':
					case 'right':
						splitter.collapse = options.collapse;
						break;
					case 'top':
						splitter.collapse = 'up';
						break;
					case 'bottom':
						splitter.collapse = 'down';
						break;
				}
				
				if (!$.fn.enhsplitter) {
					var count = 0;
					scwin.wait = function() {
						count++;

						if (count > 5) {
							//alert(app.getLocale('AltCompLoadErr')); // TODO [seri36]
							//app.logout();
							return;
						}

						setTimeout(function() {
							if (!$.fn.enhsplitter)
								scwin.wait();
							else
								WebSquare.wUnit.getJq(udc_obj.render).enhsplitter(splitter);
						}, 100);
					};
					
					scwin.wait();
				} else {
					setTimeout(function() {
						WebSquare.wUnit.getJq(udc_obj.render).enhsplitter(splitter);
					});
				}
			]]></script>
		</xf:group>
	</body>
</html>
 