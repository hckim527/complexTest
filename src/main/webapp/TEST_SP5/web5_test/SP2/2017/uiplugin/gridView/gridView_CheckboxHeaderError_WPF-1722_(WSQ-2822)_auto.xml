<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:config>
            <WebSquare>
                <gridView>
                    <header inputType="checkbox">
                        <checkboxLabel value="[config]chklbl"/>
                    </header>
                </gridView>
            </WebSquare>
        </w2:config>

    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript"><![CDATA[
            //Function unitTest
            //Created By: Sang.do
            //Created By: 12-Mar-2018
            scwin.__isApplied = function() {
                var labelElement = WebSquare.wUnit.getObjById($p.id+"gridView1_column7").querySelector("label")
                return labelElement.textContent == "[config]chklbl";
            }
            scwin.unitTest = function(){
                //Unit
                WebSquare.wUnit.start();
                WebSquare.wUnit.addCommand("pause", "500");
            
                // Test step 1. 브라우저에서 gridView 헤더를 확인한다.
                //1. Check the gridView header in your browser.
            
                // verify step 1. CheckBoxLabel 이 적용된다. (그전버전에서는 적용되지 않음)
                //1. CheckBoxLabel is applied. (Not available in previous versions)
                WebSquare.wUnit.addCommand("assert", "scwin.__isApplied()", "true");
                WebSquare.wUnit.addCommand("pause", "100");
            
                //Run test and stop
                WebSquare.wUnit.run();
                WebSquare.wUnit.stop();
            }
            scwin.unitTest();
            //end unitTest
            
        ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" summaryAuto="false" scrollByColumnAdaptive="false" id="gridView1"
    		style="position: absolute;width:650px;height:254px;left:29px;top:55px;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column7" style="height:20px" inputType="checkbox" width="70" displayMode="label"
    					value="name1" checkboxLabelPosition="left">
    				</w2:column>
    				<w2:column blockSelect="false" id="column5" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name3">
    				</w2:column>
    				<w2:column blockSelect="false" id="column1" style="height:20px" width="70" inputType="text" displayMode="label"
    					value="name4">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" inputType="checkbox" width="70" displayMode="label"
    					checkboxLabel="">
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="col4" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<w2:grid baseNode="vector" repeatNode="data/INFO" id="" style="position: absolute;width: 500px;height: 150px;left:716px;top:60px;"
    		fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column2" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:grid>
    </body>
</html>
 