        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    var data1 = dataList1.getMatchedJSON("col1", "1", true);
    dataList2.setJSON(data1, true);
    var data2 = dataList1.getMatchedJSON("col1", "2", true);
    dataList2.setJSON(data2, true);
};
scwin.trigger2_onclick = function(e) {
    var data1 = dataList2.getMatchedIndex("col1", "1", true);
    dataList2.removeRows(data1);
};
scwin.trigger3_onclick = function(e) {
    var data1 = dataList1.getMatchedJSON("col1", "8", true);
    dataList2.setJSON(data1, true);
};
scwin.count = function() {
    var a = dataList1.getMatchedData("col1", "1", true).length,
        b = dataList1.getMatchedData("col1", "2", true).length,
        c;
    c = a + b;
    return c;
}
scwin.data = function() {
    var d = dataList1.getMatchedArray("col1", "8", true).data[0];
    return d;
}
scwin.checkVal = function() {
    return scwin.count() === WebSquare.wUnit.getJq('#gridView2_body_tbody tr').not('.w2grid_hidedRow').length;
}
scwin.checkVal2 = function() {
    return dataList2.getMatchedData('col1', '1', true).length == '0';
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일을 실행 후 "setJSON"버튼을 클릭한다.
    //Run the sample file and click the "setJSON" button.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 1. 하단 그리드에 상단그리드의 row1, row2값이 동일하게 생성되어 보여진다.
    //Row1 and row2 values of the upper grid are generated in the lower grid.
    //WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView2_body_tbody tr').not('.w2grid_hidedRow').length == scwin.count()","true");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView2_cell_0_0').text() == '1'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView2_cell_4_0').text() == '2'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 2. 이후에 'deleteJSON'버튼을 클릭한다.
    //Click the 'deleteJSON' button afterwards.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger2').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 2. row1의 데이터가 삭제되어진다.
    //The data in row1 is deleted.
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView2_cell_0_0').text() == '2'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView2_body_tbody tr').not('.w2grid_hidedRow').length == 3", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 3. 이후에 'setSJON2'버튼을 클릭한다.
    //Click on the 'setSJON2' button afterwards.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify 3. 하단 그리드에 row8번째 값이 동일하게 생성되어 보여진다.(이전에는 생성되지 않음)
    //The row8 value is created and displayed on the lower grid (not created previously).
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView2_cell_3_0').text() == '8'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
