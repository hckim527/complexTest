<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            			<w2:column id="col4" name="name4" dataType="text"></w2:column>
            			<w2:column id="col5" name="name5" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row>
            				<col3><![CDATA[]]></col3>
            			</w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row>
            				<col3><![CDATA[]]></col3>
            			</w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row></w2:row>
            			<w2:row>
            				<col3><![CDATA[]]></col3>
            			</w2:row>
            			<w2:row>
            				<col3><![CDATA[]]></col3>
            			</w2:row>
            			<w2:row></w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
    //debugger;
    grd.setData(dataList1.getAllData());
    grd.setCellBackgroundColor(2, 2, 'yellow');
    grd.setCellInputType(2, 2, {
        inputType: "text",
        options: {
            allowChar: '0-5',
            dataType: 'text'
        },
        value: '0123테스트456'
    });
}
scwin.trigger1_onclick = function(e) {
    grd.setCellDataType(2, 2, 'number');
};
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('grd_cell_2_2').textContent == '012345'", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    scwin.init();
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 26-Feb-2018
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<w2:grid baseNode="vector" repeatNode="data/INFO" id="grd"
    		style="position: absolute;width:514px;height:224px;left:142px;top:149px;border: 1px solid #000;" fixedColumnWithHidden="true"
    		useShiftKey="true" setCellInputTypeCustom="true">
    		<w2:caption id="caption1" style="" value="this is a grid caption."></w2:caption>
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column3" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column5" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column7" style="height:20px" inputType="custom" width="104" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column9" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column1" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column4" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column6" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column8" style="height:20px" inputType="custom" width="104" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column10" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
    				<w2:column blockSelect="false" id="column2" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:grid>
    	<xf:trigger type="button" id="trigger1" style="position: absolute;width:353px;height:43px;left:690px;top:150px;font-size:13pt;"
    		ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[setCellDataType( 2, 2, 'number' );]]></xf:label>
    	</xf:trigger>
    </body>
</html>
 