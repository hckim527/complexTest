        <script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
    var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
    var r = d(id); if (r) return r;
    var s = dd(P + id); r = d(s); if (r) return r;
    var g = s.indexOf('G_');
    if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
    return d(s.replace(P, ''));
};
scwin.checkDocType = function(domId, summary) {
    var gridViewBodyTable = scwin.__getDom(domId);
	var domSummary = "";
    if (gridViewBodyTable) {
        domSummary = gridViewBodyTable.getAttribute('summary') ?? '';
    }
    if (WebSquare.util.isHTML5() === true || (WebSquare.util.isHTML5() !== true && summary === domSummary)) {
        return true;
    }
	return false;
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 06-Feb-2018
    //End unitTest
}
]]></script>
