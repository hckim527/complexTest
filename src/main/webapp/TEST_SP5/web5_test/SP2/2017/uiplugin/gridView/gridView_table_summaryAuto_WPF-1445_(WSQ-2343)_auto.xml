        <script type="text/javascript" lazy="false"><![CDATA[
scwin.checkDocType = function(domId, summary) {
    var gridViewBodyTable = WebSquare.wUnit.getDomById(domId);
	var domSummary = "";
    if (gridViewBodyTable) {
        domSummary = gridViewBodyTable.getAttribute('summary') ?? '';
    }
    if (WebSquare.util.isHTML5() === true || (WebSquare.util.isHTML5() !== true && summary === domSummary)) {
        return true;
    }
	return false;
};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일을 실행 후 개발자모드(F12)에서 gridView header를 elements하여 summary부분을 확인한다.(summary로 검색 3번째검색값) 
    //1. After executing the sample file, check the summary part by inserting the gridview header in developer mode (F12) (search as summary, 3rd search value)
    //Verify 1. gridView의 summary에 header title값만 가져온다.(html tag는 가져오지 않음) summary='name4,name5,name6'
    //1. Get only the header title value in the gridView summary (no html tags are imported). summary = 'name4, name5, name6'
	WebSquare.wUnit.addCommand("assert", "scwin.checkDocType('gridView2_body_table', 'name4,name5,name6')", "true");
	WebSquare.wUnit.addCommand("pause", "500");
	//Test step 2. 샘플파일을 실행 후 개발자모드(F12)에서 tableLayout title1부분의 header를 elements하여 summary부분을 확인한다.(summary로 검색 6번째검색값)
	//2. After executing the sample file, check the summary part by inserting the header of the title1 part of tableLayout in developer mode (F12).
	//Verify 2. tableLayout의 summary에 header title값만 가져온다.(html tag는 가져오지 않음) summary='title1,title2,title3,title4'
	//2. Get only the header title value in the tableLayout"s summary (no html tags are imported). summary = 'title1, title2, title3, title4'
	WebSquare.wUnit.addCommand("assert", "scwin.checkDocType($p.id+'wq_uuid_11', 'title1,title2,title3,title4')", "true");
	WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
