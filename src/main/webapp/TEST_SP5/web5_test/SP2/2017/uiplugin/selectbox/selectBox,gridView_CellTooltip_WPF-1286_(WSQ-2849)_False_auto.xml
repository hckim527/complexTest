        <script type="text/javascript" lazy="false"><![CDATA[
scwin.test = function(rowIndex, colIndex, label) {
    //debugger;
    if (colIndex === 1) {
        return label + "test";
    } else {
        return label;
    }
};
scwin.fireOver = function(node) {
    if (document.createEventObject) {
        node.fireEvent('onmouseover');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('mouseover', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.onmouseover == 'function') {
        node.onmouseover();
    }
}
scwin.mouseOverBehaviour = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireOver(el);
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('selectBox1_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour('selectBox1_itemTable_0')");
    // verify step 3. 툴팁이 생성되지 않는다.
    //3. Tooltip is not created.
    WebSquare.wUnit.addCommand("assert", "typeof selectBox1_tooltip === 'undefined'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 4. GridView 의 임의로 여러개 컬럼을 마우스오버한다.
    //4. Mouse over multiple columns in the GridView.
    // verify step 4. 모든 컬럼에서 툴팁이 생성된다.
    //4. Tooltips are created in all columns.
    WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour('gridView1_cell_0_0')");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_tooltip').text() == '0'", "true");
    WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour('gridView1_cell_0_1')");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_tooltip').text() == '1'", "true");
    WebSquare.wUnit.addCommand("set", "scwin.mouseOverBehaviour('gridView1_cell_0_2')");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_tooltip').text() == '2222222222222222222'", "true");
    WebSquare.wUnit.addCommand("pause", "200");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
