};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 2. 새로고침 후 하단의 'grid1.setFocusedCell(25,0)'버튼을 클릭하여 세로스크롤이 top의 위치에 있는지를 확인한다.
    // 2. After refreshing, click the 'grid1.setFocusedCell (25,0)' button at the bottom to check whether vertical scroll is in top position.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");
	
    //Verify 2. 세로스크롤이 top위치에 고정되어 움직이지 않는다.(이전에는 하단으로 이동되어짐)
    //2. The vertical scroll is fixed to the top position and does not move (previously moved to the bottom)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('grid1_scrollY_div').scrollTop == 0", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

