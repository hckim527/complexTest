        <script type="text/javascript" lazy="false"><![CDATA[
scwin.test = function() {
    checkcombo1.setNodeSet("data:dl_vistRsltDto", "inrv_rslt_cd_nm", "inrv_rslt_cd");
    inrv_rslt_s30.setNodeSet("data:dl_vistRsltDto", "inrv_rslt_cd_nm", "inrv_rslt_cd");
};
scwin.checkcombo1_onchange = function() {
    //alert("test");
    isChanged = true;
};
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 샘플파일을 실행 후 첫번째 checkcombobox를 클릭하여 'bbbb'값을 체크한 후 다른영역을 마우스로 클릭한다.
    //1. After running the sample file, click on the first checkcombobox, check the 'bbbb' value and click on the other area.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('checkcombo1').click()");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('checkcombo1_itemTable_1').click()");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('checkcombo1').click()");
    // verify step 1. checkcombobox의 onchange이벤트가 발생하여 알림창(test)이 보여진다.(이전에는 onchange, onviewchange 이벤트가 발생하지 않음)
    //1. A checkcombobox onchange event occurs and a notification window (test) is displayed.(Previously no onchange, onviewchange events)
    WebSquare.wUnit.addCommand("assert", "isChanged", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('checkcombo1').getText() == 'aaaa,bbbb'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run test
    WebSquare.wUnit.run();
    //stop
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.jsonData = [{
            "col1": "aaaa",
            "col2": "aaaa"
        },
        {
            "col1": "bbbb",
            "col2": "bbbb"
        },
    ];
    dataList1.setJSON(jsonData);
    scwin.test();
    inrv_rslt_s30.setValue("aaaa");
    checkcombo1.setValue("aaaa");
    window.isChanged = false;
    //Function unitTest
    //Created By: Sang.do
    //Created By: 22-Jan-2018
    //end unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
