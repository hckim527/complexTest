<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map"
            		id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col3" name="name3"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[1]]></col2>
            				<col3><![CDATA[a]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[2]]></col1>
            				<col2><![CDATA[2]]></col2>
            				<col3><![CDATA[b]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[3]]></col1>
            				<col2><![CDATA[3]]></col2>
            				<col3><![CDATA[c]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList baseNode="list" repeatNode="map"
            		id="dataList2" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1"
            				dataType="text">
            			</w2:column>
            			<w2:column id="col2" name="name2"
            				dataType="text">
            			</w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[b]]></col1>
            				<col2><![CDATA[b]]></col2>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[c]]></col1>
            				<col2><![CDATA[c]]></col2>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.checkVal1 = function() {
    if (gridView1.cellInfoHash.col2.options.selectedData === false) {
        return true;
    }
    return false;
}
scwin.checkVal2 = function() {
    if (gridView1.cellInfoHash.col2.options.selectedData === false) {
        return true;
    }
    return false;
}
scwin.checkVal3 = function() {
    if (gridView1.cellInfoHash.col2.options.selectedData === false) {
        return true;
    }
    return false;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. Source 탭에서 col2 의 selectedData 부분을 확인한다.
    //1. In the Source tab, check the selectedData portion of col2.
    //Verify 1. selectedData = 'false'
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal3()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 2. col3 의 inputType 부분을 확인한다.
    //2. Check the inputType part of col3.
    //Test step 3. 브라우저에서 확인한다.
    //3. Check in the browser.
    //Verify 3. 그리드뷰에 데이터('a')가 정상적으로 표시된다. (그전버전에서는 autoComplete 컬럼에 Match 된 값이 없을경우 빈값으로 표시됨)
    //Data ('a') is displayed normally in grid view. (In earlier versions, the autoComplete column would be blank if there were no matched values)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView1_cell_0_2').innerText == 'a'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();
scwin.onpageload = function() {
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView id="gridView1" ignoreToggleOnDisabled="false" useShiftKey="true" style="left: 171px;top: 105px;width: 500px;height: 150px;"
    		useFilterList="false" scrollByColumn="false" scrollByColumnAdaptive="false" summaryAuto="false" fixedColumnWithHidden="true"
    		showSortableUseFilterList="false" summaryOnlyAuto="false" dataList="dataList1" ignoreCellClick="false" columnMove="">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="70" inputType="text" style="height:20px" id="column5" blockSelect="false" displayMode="label"
    					value="name1">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column3" blockSelect="false" displayMode="label"
    					value="name2">
    				</w2:column>
    				<w2:column width="70" inputType="text" style="height:20px" id="column1" blockSelect="false" displayMode="label"
    					value="name3">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="70" inputType="text" style="height:20px" id="col1" blockSelect="false" displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="select" style="height:20px" id="col2" blockSelect="false" displayMode="label"
    					allOption="" chooseOption="" selectedData = "false">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="col1"></w2:label>
    							<w2:value ref="col2"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column width="70" inputType="autoComplete" style="height:20px" id="col3" blockSelect="false" displayMode="label"
    				selectedData = "false">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="col1"></w2:label>
    							<w2:value ref="col2"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 