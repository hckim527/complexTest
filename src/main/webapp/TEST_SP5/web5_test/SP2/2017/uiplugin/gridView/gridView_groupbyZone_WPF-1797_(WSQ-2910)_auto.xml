        <script type="text/javascript" lazy="false"><![CDATA[
scwin.grd_TrdStat_ongroupby = function(options) {
    options.closeGroup = false;
    options.groupbyHeader = [{
        colSpan: "20",
        inputType: "expression",
        expression: " toggle() + depthStr() + ' [ ' + count() + ' 건 ] ' ",
        align: "left"
    }];
    grd_TrdStat.groupby(options);
};
scwin.trigger1_onclick = function(e) {
    scwin.$w.executeSubmission("sub_List");
};
scwin.simulateWrapper = function(target, type, options) {
    WebSquare.wUnit.getJq(target).simulate(type, options);
}
scwin.setSimulate1 = function() {
    scwin.simulateWrapper('#grd_TrdStat_col_repTimeName', 'drag-n-drop', {
        dx: -50,
        dy: -50
    });
}
scwin.checkVal1 = function() {
    return WebSquare.wUnit.getDomById($p.id+"grd_TrdStat_cell_0_0").childNodes[0].innerText.trim() == 'A [ 5 건 ]';
}
scwin.checkVal2 = function() {
    return WebSquare.wUnit.getDomById($p.id+"grd_TrdStat_cell_7_0").childNodes[0].innerText.trim() == 'B [ 1 건 ]';
}
scwin.checkVal3 = function() {
    return WebSquare.wUnit.getDomById($p.id+"grd_TrdStat_cell_10_0").childNodes[0].innerText.trim() == 'SA [ 11 건 ]';
}
scwin.checkVal4 = function() {
    return WebSquare.wUnit.getJq('#grd_TrdStat_cell_0_0').is(':visible') == true;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일을 실행 후 'submission'버튼을 클릭한다.
    //1. Run the sample file and click the 'submission' button.
    WebSquare.wUnit.addCommand("pause", "1000");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "1000");
    //Verify step 1. gridView에 데이터가 보여진다.
    //1. Data is displayed in gridView.
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal4()", "true");
    //Test step 2. '시급'항목명을 마우스로 groupbyZon으로 끌어놓는다.
    //2. Drag the 'Urgent' item name to groupbyZon with your mouse.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('grd_TrdStat_scrollX_right').scrollLeft = 265.5");
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("set", "scwin.setSimulate1()");
    //Verify step 2. '시급'항목이 groupby되어지고 A[5건], B[1건], SA[11건]으로 groupby되어진다.
    //2. The 'urgent' item is grouped and grouped into A [5], B [1], SA [11].
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal3()", "true");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function 
    //Created by: Quan.Nguyen
    //Created date: 06-Feb-2018
    //end
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
