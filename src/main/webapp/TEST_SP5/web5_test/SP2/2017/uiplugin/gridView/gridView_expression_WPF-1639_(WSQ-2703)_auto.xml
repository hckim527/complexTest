<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="dataset" saveRemovedData="true" repeatNode="record">
            		<w2:columnInfo>
            			<w2:column id="address" name="우편" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false">
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.setNum = function(value, row) {
    return value;
};
scwin.checkVal = function() {
    return typeof WebSquare.wUnit.getDomById("mf_grd_head_selectbox_column3_itemTable") == 'object' && WebSquare.wUnit.getDomById($p.id+"mf_grd_head_selectbox_column3_itemTable").style.display == 'block';
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");	
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('grd_column3').getAttribute(dataInputtype) == 'select'", "true");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('grd_cell_0_0').getAttribute(dataInputtype) == 'expression'", "true");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById($p.id+'mf_grd_head_selectbox_column3_label').click()");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("assert", "scwin.checkVal()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    window.xmlData = "<dataset><record><address>서울</address><col2>대전</col2><col3>대구</col3></record></dataset>";
    dataList1.setXML(WebSquare.xml.parse(xmlData), false);
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 25-Jan-2018
    //End unitTest
    window.dataInputtype = WebSquare.util.getDataPrefix("inputtype");
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false"
    		id="grd" style="position: relative;width:146px;height:338px;"
    		fixedColumnWithHidden="true" useShiftKey="false"
    		autoFit="allColumn">
    		<w2:header id="header1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column3"
    					style="height:20px" width="70" inputType="select" value="1"
    					allOption="" chooseOption="">
    					<w2:choices>
    						<w2:item>
    							<w2:label><![CDATA[1]]></w2:label>
    							<w2:value><![CDATA[1]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[2]]></w2:label>
    							<w2:value><![CDATA[2]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[3]]></w2:label>
    							<w2:value><![CDATA[3]]></w2:value>
    						</w2:item>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="column88"
    					style="height:20px" inputType="select" width="70"
    					displayMode="label" allOption="" chooseOption="">
    					<w2:choices>
    						<w2:item>
    							<w2:label><![CDATA[11]]></w2:label>
    							<w2:value><![CDATA[11]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[22]]></w2:label>
    							<w2:value><![CDATA[22]]></w2:value>
    						</w2:item>
    						<w2:item>
    							<w2:label><![CDATA[33]]></w2:label>
    							<w2:value><![CDATA[33]]></w2:value>
    						</w2:item>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody4" style="">
    			<w2:row id="row5" style="">
    				<w2:column blockSelect="false" id="col3"
    					style="height:20px" width="70" inputType="expression"
    					displayFormatter="" expression="scwin.setNum('col3',rowIndex())">
    				</w2:column>
    				<w2:column blockSelect="false" id="address"
    					style="height:20px" inputType="text" width="70"
    					displayMode="label">
    				</w2:column>
    			</w2:row>
    			<w2:row style="" id="row6">
    				<w2:column width="70" inputType="text"
    					style="height:20px" id="column90" blockSelect="false"
    					displayMode="label">
    				</w2:column>
    				<w2:column width="70" inputType="expression"
    					style="height:20px" id="column89" blockSelect="false"
    					displayMode="label" expression="scwin.setNum('col3',rowIndex())">
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 