		<script type='text/javascript' lazy='false'><![CDATA[
scwin.convertStringInt = function(str) {
    var res = str.replace('px', '');
    return parseInt(res);
}
scwin.checkVal1 = function() {
    return scwin.convertStringInt(WebSquare.wUnit.getJq('#selectbox3_itemTable').css('left')) < 96;
}
scwin.checkVal2 = function() {
    return scwin.convertStringInt(WebSquare.wUnit.getJq('#inputCalendar1_calendar').css('left')) < 96;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");	
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('selectbox3_button').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('inputCalendar1_img').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    WebSquare.wUnit.getJq(window).resize(function() {
        window.contentWidth = WebSquare.wUnit.getJq("html").width();
        window.bodyWidth = WebSquare.wUnit.getJq("body").width();
        window.scalePoint = contentWidth / bodyWidth;
        window.scale = "scale(" + scalePoint + ")";
        //WebSquare.wUnit.getJq("body").css({"min-width":"1024px","-ms-transform":scale,"transform":scale,"transform-origin":"top left"});
        WebSquare.wUnit.getJq("body").css({
            "min-width": "1024px",
            "top": "0",
            "width": "1280px",
            "-ms-transform": scale,
            "transform": scale,
            "transform-origin": "top left"
        });
    }).resize();
    grd_master.insertRow();
    grd_master.insertRow();
    grd_master.insertRow();
    grd_master.insertRow();
    grd_master.insertRow();
    //Function 
    //Created by: Thuyet.Pham
    //Created date: 02-Apr-2018
}
]]></script>
