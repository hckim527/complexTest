scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 샘플파일을 실행 후 F12키를 눌러 consol창을 열고 'treeview.getChildData('1',true);'버튼을 클릭한다.
