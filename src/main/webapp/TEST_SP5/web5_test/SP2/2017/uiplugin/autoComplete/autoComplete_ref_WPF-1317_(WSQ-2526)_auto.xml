        <script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    //Unit test
    WebSquare.
    wUnit.start();
    //Test step 0. autoComplete에 noResult="first", noResultFirstItem="true" 설정한다.
    //Set autoComplete to noResult = "first", noResultFirstItem = "true".
    //Test step 1. 샘플파일을 실행한다.
    //1. Run the sample file.
    //Verify 1. gridView의 3번째 컬럼값에 "a"값이 보여진다.(이전에는 dataList의 첫번째 값이 보여지지 않음)
    //1. The 'a' value is shown in the third column of gridView. (Previously the first value of dataList is not shown)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView1_cell_0_2').innerText == 'a'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    dataList1.insertRow();
    gridView1.setFocusedCell(0, 0);
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 05-Feb-2018
    //End unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
