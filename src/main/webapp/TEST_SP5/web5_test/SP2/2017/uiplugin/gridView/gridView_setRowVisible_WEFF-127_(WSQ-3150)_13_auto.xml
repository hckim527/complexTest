scwin.getCount = function() {
    var tr = WebSquare.wUnit.getJq('#grid1_body_tbody tr');
    var count = 0;
    for (i = 0; i < tr.length; i++) {
        if (tr[i].style.display == '') {
            count++;
        }
    }
    return count;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");	
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getJq('#grid1').css('height', '544px')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger4').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.getCount() == '14'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

