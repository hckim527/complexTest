scwin.trigger3_onclick = function(e) {
    grid1.setRowVisible(1, false);
};
scwin.checkVal1 = function() {
    return WebSquare.wUnit.getJq('#grid1_body_tbody tr').length == 4;
}
scwin.checkVal2 = function() {
    return WebSquare.wUnit.getJq('#grid1_body_tbody tr:nth-child(2)').css('display') == 'none';
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger3').click()");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

