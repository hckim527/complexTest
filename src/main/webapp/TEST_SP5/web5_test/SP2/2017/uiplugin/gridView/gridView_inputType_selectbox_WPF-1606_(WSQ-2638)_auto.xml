scwin.__compareValues = function() {
    var name1Val = WebSquare.wUnit.getJq('#wq_uuid_5').find('td:first').text();
    var sel1Val = select1.getText();
    return name1Val == "김밥" && sel1Val == "김밥";
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 0-1 selectbox의 displayMode 속성에 value 옵션 추가
    //Added value option to displayMode property of selectbox
    //Verify 0-1 displayMode= value
    //Test step0-2 gridView의 inputType 속성에 selectBox옵션 추가하고 displayMode속성에 value 옵션 추가
    // Add the selectBox option to the inputType property of the gridView and add the value option to the displayMode property
    //Verify 0-2 inputType= selectBox, displayMode= value
    //Test step 1. 샘플파일을 실행하여 selectBox값과 gridView의 name1항목의 값(value)을 확인한다.
    //Execute the sample file and check the value of the selectBox value and the name1 item of gridView.
    //Verify  1. selectBox값과 gridView의 name1항목의 값(value)이 "김밥"등 으로 보여진다.
    //The selectBox value and the value of the name1 item of gridView are shown as "kimbap".
    WebSquare.wUnit.addCommand("assert", "scwin.__compareValues()", "true");
    WebSquare.wUnit.addCommand("pause", "1000");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
