<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[a]]></label>
            				<value><![CDATA[1]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[b]]></label>
            				<value><![CDATA[2]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[c]]></label>
            				<value><![CDATA[3]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            			<w2:column id="col3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[2]]></col2>
            				<col3><![CDATA[3]]></col3>
            			</w2:row>
            			<w2:row>
            				<col1><![CDATA[1]]></col1>
            				<col2><![CDATA[2]]></col2>
            				<col3><![CDATA[3]]></col3>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dataList3" baseNode="list" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="label" name="name1" dataType="text"></w2:column>
            			<w2:column id="value" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="true">
            			<w2:row>
            				<label><![CDATA[aa]]></label>
            				<value><![CDATA[1]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[bb]]></label>
            				<value><![CDATA[2]]></value>
            			</w2:row>
            			<w2:row>
            				<label><![CDATA[cc]]></label>
            				<value><![CDATA[3]]></value>
            			</w2:row>
            		</w2:data>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
    gridView1.setColumnNodeSet("col3", "data:dataList1", "label", "value");
};
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView1_cell_0_2').getAttribute(dataInputType) == 'checkcombobox'", "true");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_0_2').text() == 'c'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_cell_1_2').text() == 'c'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
    //Function unitTest
    //Create buy Truong.Luu
    //Create date 31-Jan-2018
    //End unitTest
    window.dataInputType = WebSquare.util.getDataPrefix("inputtype");
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList2" scrollByColumn="false" summaryAuto="false" scrollByColumnAdaptive="false" id="gridView1"
    		style="position: absolute;width: 500px;height: 150px;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
    		fixedColumnWithHidden="true" useShiftKey="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row1" style="">
    				<w2:column blockSelect="false" id="column1" style="height:20px" width="70" inputType="text" displayMode="label"
    					value="name1">
    				</w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name2">
    				</w2:column>
    				<w2:column blockSelect="false" id="column2" style="height:20px" inputType="text" width="70" displayMode="label"
    					value="name3">
    				</w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="col1" style="height:20px" width="70" inputType="autoComplete" displayMode="label">
    					<w2:choices></w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="col2" style="height:20px" width="70" inputType="select" displayMode="label">
    					<w2:choices></w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="col3" style="height:20px" width="70" inputType="checkcombobox" displayMode="label">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList3">
    							<w2:label ref="label"></w2:label>
    							<w2:value ref="value"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    	<xf:trigger type="button" id="trigger1"
    		style="position: absolute;width:359px;height:109px;left:44px;top:172px;font-weight:bold;font-size:14pt;" ev:onclick="scwin.trigger1_onclick">
    		<xf:label><![CDATA[col3 ###### &nbsp;setColumnNodeSet]]></xf:label>
    	</xf:trigger>
    	<w2:textbox label='버튼 click시, inputType = "autoComplete"인 세번째 컬럼에 연결된 &lt;br/&gt;dataCollection이 dataList1에서 dataList3으로 변경됨' id="" style="position: absolute;width:539px;height:98px;left:414px;top:177px;font-weight:bold;font-size:13pt;"></w2:textbox>
    </body>
</html>
 