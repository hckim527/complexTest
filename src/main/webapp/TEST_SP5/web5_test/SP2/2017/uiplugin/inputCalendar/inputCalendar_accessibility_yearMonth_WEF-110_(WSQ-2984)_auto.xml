		<script type="text/javascript" lazy="false"><![CDATA[
scwin.__isDivTag = function() {
    var el = WebSquare.wUnit.getJq(".w2inputCalendar_header_btn_close_div").get(0);
    return el.nodeName == "BUTTON";
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    // Test step 1. 샘플파일을 실행 후 달력버튼을 클릭한다.
    //1. Run the sample file and click the calendar button.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('inputCalendar1_img').click()");
    // verify step 1. 캘린더의 포커스가 맨앞의 '<<' 모양에 위치된다.
    //1. The focus of the calendar is placed in the first '<<' shape.
    WebSquare.wUnit.addCommand("assert", "document.activeElement.id == $p.id + 'inputCalendar1_calendar_last_year'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 2. inspect를 통해 확인, 취소부분의 태그를 확인한다.
    //2. Confirm the tag of the confirmation and cancellation through inspect.
    //Verify step 2. 태그가 button으로 보여진다.(이전에는 div로 보여짐)
    //2. The tag is shown as a button (previously shown as a div)
    WebSquare.wUnit.addCommand("assert", "scwin.__isDivTag()", "true");
    //Run test and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function unitTest
    //Created By: Sang.do
    //Created By: 09-Feb-2018
    //end unitTest
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
