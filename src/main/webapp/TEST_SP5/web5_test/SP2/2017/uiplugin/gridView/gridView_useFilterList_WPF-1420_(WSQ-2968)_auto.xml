<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList id="dataList1" baseNode="list" style="" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="id1" name="name1" dataType="text"></w2:column>
            			<w2:column id="id2" name="name2" dataType="text"></w2:column>
            			<w2:column id="id3" name="name3" dataType="text"></w2:column>
            		</w2:columnInfo>
            		<w2:data use="false">
            		</w2:data>
            	</w2:dataList>
            	<w2:dataList id="dataList2" baseNode="list" style="" saveRemovedData="true" repeatNode="map">
            		<w2:columnInfo>
            			<w2:column id="col1" name="name1" dataType="text"></w2:column>
            			<w2:column id="col2" name="name2" dataType="text"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
// 컴포넌트·전역 이름 조회(엔진 캐시 → 이름 그대로 실행 → mf_ 접두사 붙여 다시, 없으면 받은 id 문자열 반환). 2026-11
scwin.__getObj = function(id) {
    if (typeof id !== 'string') return id;
    var W = WebSquare, C = W.idCache, U = W.idToUUID, F = function(k) { return new Function('return ' + k)(); };
    if (!W.strictMode) id = id.replace(/mf_/g, '');
    if (C[U[id]]) return C[U[id]];
    var r; try { r = F(id); } catch (e) {}
    if (r == undefined && W.strictMode) {
        var P = W.strictModeFrame.id + '_';
        var s = id.slice(0, 2) === 'G_' ? 'G_' + P + id.slice(2) : (id.slice(0, P.length) !== P ? P + id : id);
        s = s.replace(new RegExp('(' + P + '){2,}', 'g'), P);
        if (C[U[s]]) r = C[U[s]]; else { try { r = F(s); } catch (e) { r = id; } }
    }
    return r == undefined ? id : r;
};
scwin.onpageload = function() {
    window.j2 = [{
        "col1": "aa",
        "col2": "a_name"
    }, {
        "col1": "bb",
        "col2": "b_name"
    }];
    dataList2.setJSON(j2);
    window.j1 = [{
        "id1": "a1",
        "id2": "aa",
        "id3": "aa"
    }, {
        "id1": "b1",
        "id2": "bb",
        "id3": "bb"
    }];
    dataList1.setJSON(j1);
    scwin.__getObj('gridView1').setColumnNodeSet("id3", "data:dataList2", "col2", "col1");
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1" style="position: absolute ;left:10px;top:9px;width:592px;height:194px;" fixedColumnWithHidden="true"
    		useShiftKey="true" useFilterList="true">
    		<w2:header id="header1" style="">
    			<w2:row id="row2" style="">
    				<w2:column blockSelect="false" id="column7" style="height:20px;" inputType="text" width="100" value="name1" useFilter="true"></w2:column>
    				<w2:column blockSelect="false" id="column3" style="height:20px;" width="100" inputType="text" value="nodeSet" useFilter="true"></w2:column>
    				<w2:column blockSelect="false" id="column8" style="height:20px;" inputType="text" width="185" displayMode="label" value="setColumnNodeSet" useFilter="true"></w2:column>
    			</w2:row>
    		</w2:header>
    		<w2:gBody id="gBody4" style="">
    			<w2:row id="row5" style="">
    				<w2:column blockSelect="false" id="id1" style="height:20px" inputType="text" width="70"></w2:column>
    				<w2:column blockSelect="false" id="id2" style="height:20px" inputType="select" width="100" allOption="" chooseOption="">
    					<w2:choices>
    						<w2:itemset nodeset="data:dataList2">
    							<w2:label ref="col2"></w2:label>
    							<w2:value ref="col1"></w2:value>
    						</w2:itemset>
    					</w2:choices>
    				</w2:column>
    				<w2:column blockSelect="false" id="id3" style="height:20px" inputType="select" width="185" displayMode="label">
    					<w2:choices></w2:choices>
    				</w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
    </body>
</html>
 