        <script type="text/javascript" lazy="false"><![CDATA[
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 1. 샘플파일을 실행 후 개발자모드(F12)를 실행 후 name1항목의 첫번째 값을 마우스로 클릭한다.
    //1. Execute the sample file and execute the developer mode (F12) and click the first value of the name1 item with the mouse.
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1_cell_0_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    //Verify  1. select항목에 'a', 'b'값이 보여진다.
    //1. The 'a' and 'b' values are displayed in the select item.
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('G_'+$p.id+'gridView1___selectbox_col1_itemTable').style.display", "block");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('G_'+$p.id+'gridView1___selectbox_col1_itemTable_0').parentElement.tagName", "LI");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getDomById('G_'+$p.id+'gridView1___selectbox_col1_itemTable_1').parentElement.tagName", "LI");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
