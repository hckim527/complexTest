        <script type="text/javascript" lazy="false"><![CDATA[
scwin.__setText = function() {
    WebSquare.wUnit.getJq("#gridView1_column7 nobr").text("name2_test");
}
scwin.__isChanged = function() {
    return text != WebSquare.wUnit.getJq("#gridView1_column7 nobr").text();
}
scwin.__checkItemName = function() {
    return WebSquare.wUnit.getJq("#gridView1_column7 nobr").text() == "name2_test";
}
scwin.__checkInitCaption = function() {
    return WebSquare.wUnit.getJq("#gridView1_caption1").text() == "테스트그리드은(는) test,name2,name3\n6개월,name4\n60개,name5\n60개월 을(를) 나타낸 표";
}
scwin.__checkCaption = function() {
    return WebSquare.wUnit.getJq("#gridView1_caption1").text() == "테스트그리드은(는) test,name2_test,name3\n6개월,name4\n60개,name5\n60개월 을(를) 나타낸 표";
}
scwin.unitTest = function() {
    //Unit
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_caption1').text() == '테스트그리드은(는) test,name2,name3\\n6개월,name4\\n60개,name5\\n60개월 을(를) 나타낸 표'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "document.getElementsByClassName('w2grid_head_sort_div_main_outer')[1].childNodes[0].textContent = 'name2_test'");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("assert", "document.getElementsByClassName('w2grid_head_sort_div_main_outer')[1].childNodes[0].textContent == 'name2_test'", "true");
    WebSquare.wUnit.addCommand("pause", "500");

    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('gridView1').setCaptionAuto()");
    WebSquare.wUnit.addCommand("pause", "500");

    //Verify 3. caption값을 확인한다.(name2_test로 항목명이 변경되어짐)
    //3. Check caption value (item name changed with name2_test)
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getJq('#gridView1_caption1').text() == '테스트그리드은(는) test,name2_test,name3\\n6개월,name4\\n60개,name5\\n60개월 을(를) 나타낸 표'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

scwin.onpageload = function() {
