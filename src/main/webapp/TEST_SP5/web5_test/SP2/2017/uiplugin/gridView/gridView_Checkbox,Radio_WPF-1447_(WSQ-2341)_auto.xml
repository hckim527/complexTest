        <script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
    var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
    var r = d(id); if (r) return r;
    var s = dd(P + id); r = d(s); if (r) return r;
    var g = s.indexOf('G_');
    if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
    return d(s.replace(P, ''));
};
scwin.gridView2_col1_checkboxLabelFormatter = function(row, col, label) {
    return "[" + row + "," + col + "]";
}
scwin.gridView2_col2_radioLabelFormatter = function(row, col, label) {
    return label + ":(" + row + "," + col + ")";
}
scwin.gridView3_col1_checkboxLabelFormatter = function(row, col, label) {
    return "[" + row + "," + col + "]";
}
scwin.gridView3_col2_radioLabelFormatter = function(row, col, label) {
    return "(" + row + "," + col + ")";
}
scwin.checkVal1 = function() {
    return gridView3.getAttribute('focusMove') == true;
}
scwin.checkVal2 = function() {
    return gridView3.getAttribute('senseReader') == true;
}
scwin.checkVal3 = function() {
    return gridView3.getAttribute('keyMoveEditMode') == true;
}
scwin.getAttr = function(id, attr) {
    var dataAttr = WebSquare.util.getDataPrefix(attr);
    return scwin.__getDom($p.id + id).getAttribute(dataAttr);
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //Function 
    //Created by: Quan.Nguyen
    //Created date: 30-Jan-2018
    //end	
}
]]></script>
