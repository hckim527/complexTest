            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" src="wframe_scope_WEFF-33_(WSQ-3050)wframe2.js"/>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var msg = "onpageload : " + scwin.$w.getFrameId();
    $w.log(msg);
    console.log(msg);
    scwin.onpageload2();
    textbox1.setValue(scwin.$w.getFrameId());
}
scwin.trigger9_onclick = function(e) {
    var scopeId = scwin.$w.getFrameId();
    WebSquare.ModelUtil.removeInstanceNode("root/ui/vector1", undefined, scopeId);
    var doc = WebSquare.xml.parse("<vector1/>");
    WebSquare.ModelUtil.setInstanceNode({
        "doc": doc,
        "xpath": "root/ui",
        "mode": "append",
        "scopeId": scopeId
    });
    WebSquare.ModelUtil.copyChildrenNodes({
        "srcXPath": "root/response/vector4",
        "destXPath": "root/ui/vector1",
        "mode": "replaceAll",
        "scopeId": scopeId
    });
};
scwin.trigger11_onclick = function(e) {
    var scopeId = scwin.$w.getFrameId();
    WebSquare.ModelUtil.removeInstanceNode("root/ui/vector1", undefined, scopeId);
    var doc = WebSquare.xml.parse("<vector1/>");
    WebSquare.ModelUtil.setInstanceNode({
        "doc": doc,
        "xpath": "root/ui",
        "mode": "append",
        "scopeId": scopeId
    });
    var doc = WebSquare.xml.parse("<vector1_row/>");
    WebSquare.ModelUtil.setInstanceNode({
        "doc": doc,
        "xpath": "root/ui/vector1",
        "mode": "append",
        "scopeId": scopeId
    });
    WebSquare.ModelUtil.copyChildrenNodes({
        "srcXPath": "root/response/vector4/vector1_row[1]",
        "destXPath": "root/ui/vector1/vector1_row[1]",
        "mode": "replaceAll",
        "scopeId": scopeId
    });
};
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    //case1
    //case2
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
        <xf:group id="" style="height:70px;width:520px;">
            <w2:textbox id="textbox1" style="width:338px;height:59px;font-weight:bold;font-size:24pt;" label=""></w2:textbox>
        </xf:group>
        <w2:grid baseNode="vector1" repeatNode="vector1_row" ref="root/ui/vector1" id="grid1" style="position:relative;width: 500px;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true">
            <w2:header id="header1" style="">
                <w2:row id="row1" style="">
                    <w2:column blockSelect="false" id="column5" style="height:20px;" inputType="text" width="120"  displayMode="label" value="col1"></w2:column>
                    <w2:column blockSelect="false" id="column3" style="height:20px;" inputType="text" width="120" displayMode="label" value="col2"></w2:column>
                    <w2:column blockSelect="false" id="column1" style="height:20px;" width="120" inputType="text" displayMode="label" value="col3"></w2:column>
                </w2:row>
            </w2:header>
            <w2:gBody id="gBody1" style="">
                <w2:row id="row2" style="">
                    <w2:column blockSelect="false" id="col1" style="" inputType="text" width="120" value="" displayMode="label"></w2:column>
                    <w2:column blockSelect="false" id="col2" style="" inputType="text" width="120" value="" displayMode="label"></w2:column>
                    <w2:column blockSelect="false" id="col3" style="" width="120" inputType="text" value="" displayMode="label"></w2:column>
                </w2:row>
            </w2:gBody>
        </w2:grid>
        
            
        <xf:group id="" style="width: 700px;height: 200px;" class="">   
    
            <xf:trigger type="button" id="trigger9" style="width:300px;height:23px;" ev:onclick="scwin.trigger9_onclick">
                <xf:label><![CDATA[remove and copy baseNode copyChildrenNodes]]></xf:label>
            </xf:trigger>
    
            <xf:trigger type="button" id="trigger11" style="width:300px;height:23px;" ev:onclick="scwin.trigger11_onclick">
                <xf:label><![CDATA[remove and copy repeatNode copyChildrenNodes index]]></xf:label>
            </xf:trigger>

        </xf:group>
