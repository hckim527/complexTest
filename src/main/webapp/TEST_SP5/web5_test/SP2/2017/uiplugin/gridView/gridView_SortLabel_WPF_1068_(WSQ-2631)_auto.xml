        <script type="text/javascript" lazy="false"><![CDATA[
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.Dbclick = function(id) {
    var el = WebSquare.wUnit.getDomById($p.id + id);
    scwin.fireDbClick(el);
}
scwin.checkVal = function(index, label11, value11, label22, value22, label33, value33, rowStatus) {
    var json = dataList8.getAllFilteredJSON()[index];
    if (json.label11 == label11 && json.value11 == value11 && json.label22 == label22 && json.value22 == value22 && json.label33 == label33 && json.value33 == value33 && json.rowStatus == rowStatus) {
        return true;
    }
    return false;
}
scwin.unitTest = function() {
    //init
    WebSquare.wUnit.start();
    //Test step 1. Property 탭 또는 Source 탭에서 gridView2 의 sortabel 부분을 확인한다. 
    //1. In the Property tab or Source tab, check the sortabel portion of gridView2.
    //Verify step 1. sortable = "true"
    //Test step 2. col1 / col2 / col3 의 inputType 부분을 확인한다.
    //2. Check the inputType part of col1 / col2 / col3.
    //Verify step 2. inputType = "select"
    //Test step 3. col2 의 sortLabel 부분을 확인한다.
    //3. Check the sortLabel part of col2.
    //Verify step 3. sortLabel = "true"
    //Test step 4. DataCollection 탭에서 datalist8 의 Column Info 에 ID부분을 확인한다. 
    //4. On the DataCollection tab, check the ID portion of the datalist8's Column Info.
    //Verify step 4. The label1 / value11 ~ expression.
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal(0, 'a', '1', '가', '1', '11', '4', 'R')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal(1, 'b', '2', '나', '2', '22', '3', 'R')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal(2, 'd', '3', '다', '4', '33', '2', 'R')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal(3, 'c', '4', '라', '3', '44', '1', 'R')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Test step 5. 브라우저에서 아래에 있는 그리드뷰의 name2 컬럼을 더블클릭해서 정렬한다.
    //5. In the browser, double-click the name2 column in the grid view below to sort it.
    //Verify step 5. The sortLabel function works normally and sorting is applied. (In previous versions, sortLabel does not apply if the ID value of the dataList bound to the selectbox is not 'label' / 'value'.)
    WebSquare.wUnit.addCommand("set", "scwin.Dbclick('gridView2_column15')");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView2_cell_0_1').innerText == '가'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView2_cell_1_1').innerText == '나'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView2_cell_2_1').innerText == '다'", "true");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('gridView2_cell_3_1').innerText == '라'", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run  and stop
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
