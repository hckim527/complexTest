scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    //Test step 0. configl.xml에서 속성을 추가한다.(추가하지 않고 확인해서 disabled되는지 확인하면됨)
    //Add the attribute in configl.xml (check it without adding it to see if it is disabled)
    //Verify 0. <submission> <useModal value='true' /> </submission>
    //Test step 1. 샘플파일을 실행 후 '데이터전송'버튼을 클릭한다.
    //Execute the sample file and click the 'Data Transfer' button.
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('trigger1').click()");
    //Verify 1. submission이 잠깐 실행될때 inputbox부분을 보면 disable되어지는것이 확인된다.
    //When the submission is executed for a while, it is confirmed that the input box is disabled.
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal1()", "true");
    WebSquare.wUnit.addCommand("assert", "scwin.checkVal2()", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
