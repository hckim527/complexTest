scwin.trigger1_onclick = function(e) {
    var childComps = WebSquare.util.getChildren(grp);
    var enabledComps = [];
    for (var i = 0, len = childComps.length; i < len; i++) {
        var comp = childComps[i];
        if (comp.getDisabled && comp.getDisabled() !== true) {
            enabledComps.push(comp);
        }
    }
    $w.executeSubmission("submission1", "", enabledComps);
};
scwin.preSubmitFn = function(submitobj) {
    var childComps = WebSquare.util.getChildren(grp);
    //alert("preSubmitFunction");
    for (var i = 0, len = childComps.length; i < len; i++) {
        var comp = childComps[i];
        if (comp.getDisabled && comp.getDisabled() !== true) {
            submitobj.linkedObj.push(comp);
        }
    }
    grp.invoke('setDisabled', 'true');
};
