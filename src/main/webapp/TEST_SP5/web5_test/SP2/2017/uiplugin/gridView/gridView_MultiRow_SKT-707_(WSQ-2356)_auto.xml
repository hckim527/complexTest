scwin.rgb2hex = function(rgb) {
    rgb = rgb.match(/^rgba?[\s+]?\([\s+]?(\d+)[\s+]?,[\s+]?(\d+)[\s+]?,[\s+]?(\d+)[\s+]?/i);
    return (rgb && rgb.length === 4) ? '#' +
        ('0' + parseInt(rgb[1], 10).toString(16)).slice(-2) +
        ('0' + parseInt(rgb[2], 10).toString(16)).slice(-2) +
        ('0' + parseInt(rgb[3], 10).toString(16)).slice(-2) : "";
}
scwin._checkRgb = function(id, hexa) {
    var rgb = WebSquare.wUnit.getJq('#' + id).css('background-color');
    if (rgb.indexOf('rgb') != -1) {
        return rgb == 'rgb(255, 0, 0)';
    }
    return rgb == hexa;
}
scwin.unitTest = function() {
    //Unit test
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getDomById('gridView1_cell_1_0').click()");
    WebSquare.wUnit.addCommand("pause", "500");
    WebSquare.wUnit.addCommand("assert", "scwin._checkRgb('gridView1_cell_1_0', 'red')", "true");
    WebSquare.wUnit.addCommand("assert", "scwin._checkRgb('gridView1_cell_1_7', 'red')", "true");
    WebSquare.wUnit.addCommand("pause", "500");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.unitTest();

