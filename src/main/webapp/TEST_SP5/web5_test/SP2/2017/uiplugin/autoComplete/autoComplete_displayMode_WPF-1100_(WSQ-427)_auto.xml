<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.setVal1 = function() {
    ac1.setText('value1:label1', false);
}
scwin.setVal2 = function() {
    ac2.setText('label1:value1', false);
}
scwin.unitTest = function() {
    WebSquare.wUnit.start();
    WebSquare.wUnit.addCommand("set", "scwin.setVal1()");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('ac1').endEdit();");
    WebSquare.wUnit.addCommand("set", "scwin.setVal2()");
    WebSquare.wUnit.addCommand("set", "WebSquare.wUnit.getObjById('ac2').endEdit();");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('ac1').getText() == 'value1:label1:value1:label1'", "false");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('ac2').getText() == 'label1:value1:label1:value1'", "false");
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload2" ev:onpageunload="scwin.onpageunload">
    	<xf:group id="" style="position: relative;width:246px;height:289px;float:left;" class="">
    		<w2:textbox label='displayMode="value delim label"' id="" style="position: relative;font-size:12pt;"></w2:textbox>
    		<w2:autoComplete visibleRowNum="5" chooseOption="true" id="ac1"
    			style="position: relative;width: 148px;height: 21px;margin-top:10px;margin-left:5px;" search="start" interactionMode=""
    			displayMode="value delim label" useKeywordHighlight="false" submenuSize="auto" editType="select" allOption="" chooseOptionLabel="ALL"
    			delimiter=":" noResult="useData" searchTarget="both">
    			<w2:choices>
    				<w2:item>
    					<w2:label><![CDATA[label1]]></w2:label>
    					<w2:value><![CDATA[value1]]></w2:value>
    				</w2:item>
    				<w2:item>
    					<w2:label><![CDATA[label2]]></w2:label>
    					<w2:value><![CDATA[value2]]></w2:value>
    				</w2:item>
    				<w2:item>
    					<w2:label><![CDATA[label3]]></w2:label>
    					<w2:value><![CDATA[value3]]></w2:value>
    				</w2:item>
    				<w2:item>
    					<w2:label><![CDATA[]]></w2:label>
    					<w2:value><![CDATA[value4]]></w2:value>
    				</w2:item>
    				<w2:item>
    					<w2:label><![CDATA[]]></w2:label>
    					<w2:value><![CDATA[value5]]></w2:value>
    				</w2:item>
    			</w2:choices>
    		</w2:autoComplete>
    	</xf:group>
    	<xf:group class="" id="" style="position: relative;width:246px;height:289px;float:left;">
    		<w2:textbox id="" label='displayMode="label delim value"' style="position: relative;font-size:12pt;"></w2:textbox>
    		<w2:autoComplete allOption="" chooseOption="true" chooseOptionLabel="ALL" delimiter=":" displayMode="label delim value"
    			editType="select" id="ac2" interactionMode="" noResult="useData" search="start" searchTarget="both"
    			style="position: relative;width: 148px;height: 21px;margin-top:10px;margin-left:5px;" submenuSize="auto" useKeywordHighlight="false"
    			visibleRowNum="5">
    			<w2:choices>
    				<w2:item>
    					<w2:label><![CDATA[label1]]></w2:label>
    					<w2:value><![CDATA[value1]]></w2:value>
    				</w2:item>
    				<w2:item>
    					<w2:label><![CDATA[label2]]></w2:label>
    					<w2:value><![CDATA[value2]]></w2:value>
    				</w2:item>
    				<w2:item>
    					<w2:label><![CDATA[label3]]></w2:label>
    					<w2:value><![CDATA[value3]]></w2:value>
    				</w2:item>
    				<w2:item>
    					<w2:label></w2:label>
    					<w2:value><![CDATA[value4]]></w2:value>
    				</w2:item>
    				<w2:item>
    					<w2:label></w2:label>
    					<w2:value><![CDATA[value5]]></w2:value>
    				</w2:item>
    			</w2:choices>
    		</w2:autoComplete>
    	</xf:group>
    </body>
</html>
 