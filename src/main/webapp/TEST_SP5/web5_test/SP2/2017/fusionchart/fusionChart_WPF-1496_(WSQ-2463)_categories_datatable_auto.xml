scwin.__isDefect = function() {
    if (FusionCharts.version.join(".") == "3.7.0") {//SP4에서 옵션에 설정된 버전이 없는경우 3.7.0 버전을 로딩함.
		var el = WebSquare.wUnit.getJq('.raphael-group-225-grid-header')[0],
	            tspans = el.getElementsByTagName('tspan'),
	            hasTextStart = tspans[0].innerText == "",
	            hasTextEnd = tspans[1].innerText == "";
	} else if (fwGanttChart2.options.version == "3.19" || fwGanttChart2.options.version == "3.23" || fwGanttChart2.options.version.startsWith('4')) {
    	var el = document.querySelectorAll('[class*="-gantt-header-text-container"]')[0]
        var texts = el.getElementsByTagName('text'),
            hasTextStart = texts[1].innerText == "",
            hasTextEnd = texts[2].innerText == "";
    } else {
        var el = WebSquare.wUnit.getJq('.raphael-group-113-guntt-header-text-container')[0],
            tspans = el.getElementsByTagName('tspan'),
            hasTextStart = tspans[1].innerText == "",
            hasTextEnd = tspans[2].innerText == "";
    }
    return hasTextEnd && hasTextStart;
}
scwin.unitTest = function() {
    //Init test
    WebSquare.wUnit.start();
    //Test step 1. firefox에서 샘플파일을 실행한다.-Run the sample file in firefox.
    //Verify 1. firefox에서 fwGanttChart2의 그래프가 정상적으로 보여진다.(이전에는 결함으로 보여지지 않음)-In Firefox, the graph of fwGanttChart2 is displayed normally (previously not seen as a defect).
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("assert", "WebSquare.wUnit.getObjById('fwGanttChart2').getAttribute('ref') == 'data:dataList1'", "true");
    WebSquare.wUnit.addCommand("pause", "100");
    WebSquare.wUnit.addCommand("assert", "scwin.__isDefect()", "false");
    //Run and Stop test
    WebSquare.wUnit.run();
    WebSquare.wUnit.stop();
}
scwin.onpageload2 = function() {
    if (typeof scwin.onpageload === "function") {
        scwin.onpageload();
    }
    window.obj = {
        "headerbgcolor": "#999999",
        "headerfontcolor": "#ffffff",
        "datacolumn": [{
                "bgcolor": "#eeeeee",
                "headertext": "Start"
            },
            {
                "bgcolor": "#eeeeee",
                "headertext": "End"
            }
        ]
    };
    fwGanttChart2.setDatatableAttribute(obj);
    fwGanttChart2.draw();
    //Function unitTest
    //Create by Truong.Luu
    //Create date 23-Jan-2018
    //end
    if (typeof scwin.unitTest === "function") {
        scwin.unitTest();
    }
}
