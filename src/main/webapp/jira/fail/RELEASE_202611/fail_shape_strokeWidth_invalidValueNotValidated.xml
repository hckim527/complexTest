<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] Shape strokeWidth 에 숫자가 아닌 값·음수 설정 시 NaN·음수가 SVG 에 그대로 기록됨" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20261112" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script type="text/javascript" lazy="false"><![CDATA[
// 도형 rect 의 stroke-width·stroke-dasharray 확인
scwin.btn_check_onclick = function (e) {
    [shp_abc, shp_minus].forEach(function (shp) {
        let rect = shp.getSVGElement().querySelector("rect");
        scwin.setReturnValue(shp.getID() + " → stroke-width : " + rect.getAttribute("stroke-width") + " / stroke-dasharray : " + rect.getAttribute("stroke-dasharray"));
    });
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
	</head>
	<body>
		<xf:group id="grp_root" style="padding:16px;">
			<w2:textbox escape="false" id="lbl_title" style="font-size:16px;margin-top:16px;margin-bottom:16px;"
				label="■ &lt;b&gt;[FAIL] Shape 의 strokeWidth 에 숫자가 아닌 값·음수 설정 시 NaN·음수가 SVG 에 그대로 기록됨&lt;/b&gt;&lt;br/&gt;[확인 방법] SVG 속성 확인 버튼 클릭&lt;br/&gt;[기대] 잘못된 값은 기본값(1)으로 처리되어 stroke-width 1, 점선 간격도 1 기준으로 표시&lt;br/&gt;[실제] stroke-width=&quot;NaN&quot;·stroke-dasharray=&quot;NaN NaN&quot;, 음수는 stroke-width=&quot;-2&quot;·stroke-dasharray=&quot;-8 -6&quot; 기록 (브라우저가 무효 값으로 처리하여 점선 대신 실선 표시)"></w2:textbox>

			<xf:group id="" style="display:flex;gap:24px;">
				<xf:group id="" style="">
					<w2:textbox id="" label="strokeWidth=&quot;abc&quot;, strokeStyle=&quot;dash&quot;" style="font-size:13px;margin-bottom:8px;"></w2:textbox>
					<w2:shape id="shp_abc" type="rectangle" strokeWidth="abc" strokeStyle="dash" stroke="#2563eb" style="width:160px;height:80px;"></w2:shape>
				</xf:group>
				<xf:group id="" style="">
					<w2:textbox id="" label="strokeWidth=&quot;-2&quot;, strokeStyle=&quot;dash&quot;" style="font-size:13px;margin-bottom:8px;"></w2:textbox>
					<w2:shape id="shp_minus" type="rectangle" strokeWidth="-2" strokeStyle="dash" stroke="#2563eb" style="width:160px;height:80px;"></w2:shape>
				</xf:group>
			</xf:group>

			<xf:group id="" style="margin-top:16px;">
				<w2:button ev:onclick="scwin.btn_check_onclick" id="btn_check" label="SVG 속성 확인" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
			</xf:group>

			<xf:group id="grp_bottom" style="">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid #C4CDD5;border-radius: 8px;width: 100%;height: 120px;" id="tbx_return"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
