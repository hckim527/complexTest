		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.mode = "";

scwin.onpageload = function () {
};

// A~F 열(endColumnIndex: 5)만 읽도록 업로드
scwin.upload = function (mode) {
    scwin.mode = mode;
    dlt_upload.removeAll();
    var opt = { header: 0, startRowIndex: 0, startColumnIndex: 0, endColumnIndex: 5, loadingMode: "POI" };
    if (mode == "XHR") opt.useXHR = "true";
    gridView1.advancedExcelUpload(opt);
};

scwin.btn_poi_onclick = function (e) {
    scwin.upload("POI");
};

scwin.btn_xhr_onclick = function (e) {
    scwin.upload("XHR");
};

scwin.gridView1_onfilereadend = function (value) {
    scwin.setReturnValue("[" + scwin.mode + "] " + value + " → " + dlt_upload.getRowCount() + "행");
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="padding:10px;">
			<w2:textbox escape="false" id="" label="■ &lt;b&gt;[FAIL] GridView 의 advancedExcelUpload 에서 clean 전처리를 켜고 endColumnIndex 를 지정해도, 읽기 범위 밖 셀이 많은 xlsx 파일이 '보안 위협' 으로 거부되어 업로드되지 않음&lt;/b&gt;&lt;br/&gt;[전제] websquare.xml 에 &amp;lt;excel&amp;gt;&amp;lt;upload&amp;gt;&amp;lt;clean enable=&quot;true&quot; size=&quot;1048576&quot; tempDir=&quot;(임시 폴더)&quot;/&amp;gt;&amp;lt;/upload&amp;gt;&amp;lt;/excel&amp;gt; 설정 후 WAS 재기동&lt;br/&gt;[확인 방법] POI 업로드 / XHR 업로드 버튼으로 WAEA_1509_control.xlsx, WAEA_1509_wide_extra_cells.xlsx 를 각각 업로드&lt;br/&gt;[기대] 두 파일 모두 281행·6열(KDB-0001 ~ KDB-0281) 표시&lt;br/&gt;[실제] control.xlsx 는 281행 표시, wide_extra_cells.xlsx 는 '엑셀 업로드 보안 위협이 감지되었습니다.' 메시지 후 0행" style="font-size:14px;margin-bottom:16px;"></w2:textbox>
			<xf:group style="margin-bottom:8px;">
				<w2:button id="btn_poi" label="POI 업로드" ev:onclick="scwin.btn_poi_onclick"
					style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;margin-right:6px;"></w2:button>
				<w2:button id="btn_xhr" label="XHR 업로드" ev:onclick="scwin.btn_xhr_onclick"
