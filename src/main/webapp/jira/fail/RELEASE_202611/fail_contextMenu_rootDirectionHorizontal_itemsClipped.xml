				label="■ &lt;b&gt;[FAIL] ContextMenu 에 rootDirection=&quot;horizontal&quot; 설정 시 메뉴바 폭이 1단계 항목 전체 폭보다 좁게 표시되어 마지막 항목이 가려짐&lt;/b&gt;&lt;br/&gt;[확인 방법] 메뉴바 열기 버튼 클릭 → 오른쪽 끝 Tools, Window, Help 항목 확인&lt;br/&gt;[기대] 메뉴바가 1단계 항목 File ~ Help 8개를 모두 표시하고 Help 를 바로 클릭할 수 있음&lt;br/&gt;[실제] 메뉴바 폭이 좁아 Tools 일부와 Window, Help 가 가려지고 가로 스크롤바가 생김"></w2:textbox>

			<w2:textbox id="" label="1단계 항목 8개 : File, Edit, View, Insert, Format, Tools, Window, Help" style="font-size:13px;font-weight:bold;margin-bottom:8px;"></w2:textbox>
			<w2:button id="btn_open" label="메뉴바 열기" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;width:140px;"></w2:button>

			<w2:contextMenu id="cm_menu" rootDirection="horizontal" triggerTarget="btn_open" openEvent="onclick" ev:onopen="scwin.cm_onopen" ev:onitemclick="scwin.cm_onitemclick" ev:onclose="scwin.cm_onclose">
