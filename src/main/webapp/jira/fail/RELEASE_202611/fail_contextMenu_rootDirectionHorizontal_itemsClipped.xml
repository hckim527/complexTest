		<script type="text/javascript" lazy="false"><![CDATA[
// 메뉴바 패널 폭과 항목 표시 상태
scwin.getBarState = function (cm) {
    let portal = document.getElementById(cm.id + "_portal");
    let panel = portal ? portal.querySelector(".w2contextMenu_depth1") : null;
    if (!panel) {
        return "메뉴바 없음";
    }
    let box = panel.getBoundingClientRect();
    let labels = panel.querySelectorAll(":scope > li .w2contextMenu_label");
    let hidden = [];
    for (let i = 0; i < labels.length; i++) {
        if (labels[i].getBoundingClientRect().right > box.left + panel.clientLeft + panel.clientWidth) {
            hidden.push(labels[i].textContent);
        }
    }
    return "패널 폭 " + Math.round(box.width) + "px / 항목 전체 폭 " + panel.scrollWidth + "px / 가려진 항목 : " + (hidden.length ? hidden.join(", ") : "없음");
};

scwin.cm_onopen = function (info) {
    scwin.setReturnValue("열림 → " + scwin.getBarState(this));
};

scwin.cm_onitemclick = function (info) {
    scwin.setReturnValue("항목 클릭 : " + info.label);
};

scwin.cm_onclose = function (info) {
    scwin.setReturnValue("닫힘 : " + info.reason);
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
