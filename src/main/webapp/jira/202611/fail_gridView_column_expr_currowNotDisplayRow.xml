<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenName="[FAIL] GridView Column expr=currow + 1 설정 시 정렬 후 getCellDisplayData 가 화면 순번과 다른 값 반환" meta_author="InswaveSystems" meta_type="메인">
		<w2:historyInfo>
			<w2:history meta_no="01" meta_desc="최초작성(결함 재현)" meta_date="20261111" meta_user="InswaveSystems"></w2:history>
		</w2:historyInfo>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_a">
					<w2:columnInfo>
						<w2:column id="name" name="name" dataType="text"></w2:column>
						<w2:column id="price" name="price" dataType="number"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><name><![CDATA[가]]></name><price><![CDATA[30]]></price></w2:row>
						<w2:row><name><![CDATA[나]]></name><price><![CDATA[10]]></price></w2:row>
						<w2:row><name><![CDATA[다]]></name><price><![CDATA[50]]></price></w2:row>
						<w2:row><name><![CDATA[라]]></name><price><![CDATA[20]]></price></w2:row>
						<w2:row><name><![CDATA[마]]></name><price><![CDATA[40]]></price></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script type="text/javascript" lazy="false"><![CDATA[
// 정렬 후 화면 순서대로 순번 Cell 표시값 출력
scwin.grd_a_onsort = function (sortInfo) {
    let list = [];
    for (let i = 0; i < grd_a.getTotalRow(); i++) {
        list.push(grd_a.getCellDisplayData(i, "seq"));
    }
    scwin.setReturnValue("getCellDisplayData 순번 : " + list.join(", "));
};

scwin.btn_excel_onclick = function (e) {
    grd_a.advancedExcelDownload({ fileName : "currow.xlsx" });
};

scwin.btn_csv_onclick = function (e) {
    grd_a.saveCSV({ fileName : "currow.csv" });
};

// 리턴 값 초기화
scwin.btn_clear_onclick = function (e) {
    tbx_return.setValue("");
};

// 리턴 값 설정
scwin.setReturnValue = function (strValue) {
    tbx_return.setValue(tbx_return.getValue() + strValue);
    tbx_return.setValue(tbx_return.getValue() + "\n");
};
]]></script>
	</head>
	<body>
		<xf:group id="grp_root" style="padding:16px;">
			<w2:textbox escape="false" id="lbl_title" style="font-size:16px;margin-top:16px;margin-bottom:16px;"
				label="■ &lt;b&gt;[FAIL] GridView Column 에 expr=&quot;currow + 1&quot; 설정 시 정렬 후 엑셀 다운로드하면 순번이 화면과 다르게 출력됨&lt;/b&gt;&lt;br/&gt;[확인 방법] price Header 를 클릭하여 정렬 후 advancedExcelDownload 버튼 클릭, 받은 파일의 순번 확인&lt;br/&gt;[기대] 파일의 순번이 화면에 표시된 순번과 같음&lt;br/&gt;[실제] 화면 순번은 1, 2, 3, 4, 5 인데 파일의 순번은 2, 4, 1, 5, 3 (정렬 전 행 순서)"></w2:textbox>

			<w2:gridView id="grd_a" dataList="data:dlt_a" sortable="true" sortEvent="onclick" style="width:400px;height:180px;" ev:onsort="scwin.grd_a_onsort">
				<w2:header id="hd_a" style="">
					<w2:row id="hr_a" style="">
						<w2:column id="h_seq" inputType="text" value="순번 (currow + 1)" width="150" sortable="false"></w2:column>
						<w2:column id="h_name" inputType="text" value="name" width="100" sortable="false"></w2:column>
						<w2:column id="h_price" inputType="text" value="price" width="100"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gb_a" style="">
					<w2:row id="br_a" style="">
						<w2:column id="seq" inputType="text" width="150" expr="currow + 1"></w2:column>
						<w2:column id="name" inputType="text" width="100"></w2:column>
						<w2:column id="price" inputType="text" width="100"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>

			<xf:group id="" style="display:flex;gap:8px;margin-top:12px;">
				<w2:button ev:onclick="scwin.btn_excel_onclick" id="btn_excel" label="advancedExcelDownload" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				<w2:button ev:onclick="scwin.btn_csv_onclick" id="btn_csv" label="saveCSV" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
			</xf:group>

			<xf:group id="grp_bottom" style="">
				<w2:textbox escape="false" id="" label="■ 리턴 값 확인" style="font-size:16px;font-weight:bold;margin-top:16px;margin-bottom:16px;"></w2:textbox>
				<xf:group id="" style="display: flex;justify-content: flex-end">
					<w2:button ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear" style="background-color:#005AB5;color:#FFFFFF;border-radius:4px;padding:5px;height:35px;"></w2:button>
				</xf:group>
				<xf:textarea style="border: 1px solid #C4CDD5;border-radius: 8px;width: 100%;height: 120px;" id="tbx_return"></xf:textarea>
			</xf:group>
		</xf:group>
	</body>
</html>
