<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.input2_onkeyup = function(e) {
	slider2.setValue(input2.getValue());
};

scwin.checkVal = function() {
	return ((j) => j.length ? j : $('#mf_slider2_thumb1'))($('#slider2_thumb1')).offset().left > 200;
};
]]></script>
	</head>
	<body>
		<w2:tabControl useTabKeyOnly="true" id="tab1" style="width:500px;height:200px;">
			<w2:tabs style="width:70px;height:30px;" id="tabs2"></w2:tabs>
			<w2:tabs style="width:70px;height:30px;" id="tabs3"></w2:tabs>
			<w2:tabs style="width:70px;height:30px;" id="tabs4"></w2:tabs>
			<w2:content alwaysDraw="false" style="height:170px;" id="content2"></w2:content>
			<w2:content alwaysDraw="false" style="height:170px;" id="content3"></w2:content>
			<w2:content alwaysDraw="true" style="height:170px;" id="content4">
				<xf:group style="width:448px;height:200px;" id="">
					<w2:slider style="position:relative;width:442px;height:30px;" id="slider2" setBackground="true" showScale="true" maxValue="100" minValue="0"></w2:slider>
					<xf:input adjustMaxLength="false" id="input2" style="width:144px;height:21px;float:left;" ev:onkeyup="scwin.input2_onkeyup"></xf:input>
				</xf:group>
			</w2:content>
		</w2:tabControl>
	</body>
</html>
