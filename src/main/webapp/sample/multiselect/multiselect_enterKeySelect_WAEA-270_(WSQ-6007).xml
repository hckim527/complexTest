<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<w2:MSA/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<w2:layoutInfo/>
		<w2:publicInfo method=""/>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.multiselect2_onviewchange = function(e) {
	var value = multiselect2.getValue();
	output2.setValue(value);
};

scwin.checkVal = function(checkVal) {
	return (document.getElementById('output2') || document.getElementById('mf_output2')).innerText == checkVal;
};
]]></script>
	</head>
	<body>
		<xf:group tagname="fieldset" style="height30px;border:1px solid red;">
			<legend>multiselect2 singleSelect=true  enterKeySelect=true</legend>
			<xf:select id="multiselect2" appearance="minimal" style="width:170px;height:100px;" ref="" accessibility="true" singleSelect="true" enterKeySelect="true"
				ev:onviewchange="scwin.multiselect2_onviewchange">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[a]]></xf:label>
						<xf:value><![CDATA[1]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[b]]></xf:label>
						<xf:value><![CDATA[2]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[c]]></xf:label>
						<xf:value><![CDATA[3]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[d]]></xf:label>
						<xf:value><![CDATA[4]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[e]]></xf:label>
						<xf:value><![CDATA[5]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[f]]></xf:label>
						<xf:value><![CDATA[6]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[g]]></xf:label>
						<xf:value><![CDATA[6]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:select>
		</xf:group>
		<xf:group>
			<xf:output style="width:148px;height:21px;" id="output2">
				<xf:label>output2</xf:label>
			</xf:output>
		</xf:group>
	</body>
</html>
