	var data2 = [];
	var data3 = [];
	var data4 = [];
	var data5 = [];
	for (var i = 0; i < row; i++) {
		var basic = i + "";
		data2.push(basic);
		data2.push(basic);
		data3.push("A_" + basic);
		data3.push(basic);
		data4.push("B_" + basic);
		data4.push(basic);
		data5.push("C_" + basic);
		data5.push(basic);
	}
	dataList2.setData(data2);
	dataList3.setData(data3);
	dataList4.setData(data4);
	dataList5.setData(data5);
	var data = [];
	var opt = {"rowStatusData": false};
	for (var i = 0; i < row; i++) {
		for (var j = 0; j < col; j++) {
			var rowData = "null";
			if (j === 0) {
				if (i % 4 === 0) {
					rowData = dataList2.getAllJSON(opt);
				} else if (i % 4 === 1) {
					rowData = dataList3.getAllJSON(opt);
				} else if (i % 4 === 2) {
					rowData = dataList4.getAllJSON(opt);
				} else {
					rowData = dataList5.getAllJSON(opt);
				}
			} else if (i === 0) {
				rowData = null;
			} else if (i === 1) {
				rowData = "";
			} else if (j === 2) {
				rowData = (i % 4 === 0) ? "1" : "";
			} else if (j === 5) {
				rowData = (i === 7) ? "1" : "";
			} else if (j === 10) {
				rowData = Math.ceil(((i%8)+3)/3);
			} else if (j === 4) {
				rowData = "btn_search.png";
			} else {
				rowData = i + "";
			}
			data.push(rowData);
		}
	}
	data[0] = "";
	data[col] = null;
	dataList1.setData(data);
	dataList11.setData(data);
	dataMap1.set("key1", null);
	dataMap1.set("key2", "");
	dataMap1.set("key3", "1");
	dataMap2.set("key1", null);
	dataMap2.set("key2", null);
	dataMap2.set("key3", null);
