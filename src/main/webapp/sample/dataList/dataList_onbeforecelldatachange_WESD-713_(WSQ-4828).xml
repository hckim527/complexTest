<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true" ev:onbeforecelldatachange="scwin.dataList1_onbeforecelldatachange">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dataMap1" ev:onbeforemodelchange="scwin.dataMap1_onbeforemodelchange">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
						<w2:key id="key2" name="name2" dataType="text"></w2:key>
						<w2:key id="key3" name="name3" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var row = 10;
	var col = 3;
	var data = [];
	for (var i = 0; i < row; i++) {
		for (var j = 0; j < col; j++) {
			data.push("data=" + i);
		}
	}
	dataList1.setData(data);
};
scwin.dataList1_onbeforecelldatachange = function(info) {
	if (info.newValue == "22") {
		return false;
	} else {
		return true;
	}
};
scwin.dataMap1_onbeforemodelchange = function(info) {
	if (info.newValue == "22") {
		return false;
	} else {
		return true;
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:input id="input1" style="width:249px;height:47px;" ref="data:dataMap1.key1"></xf:input>
		<w2:gridView id="gridView1" style="width:589px;height:246px;" checkAllType="false" defaultCellHeight="20" dataList="data:dataList1">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
