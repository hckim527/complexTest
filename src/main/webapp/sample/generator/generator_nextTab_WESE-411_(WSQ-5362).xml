<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map" />
			<w2:workflowCollection />
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	gen1.insertChild(0);
	gen1.getChild(0, "ipt1").setNextTabID(gen1.getChild(0, "ipt2").id);
};

scwin.checkVal = function() {
	return (document.getElementById('gen1_0_ipt3') || document.getElementById('mf_gen1_0_ipt3')).classList.contains('w2input_focus');
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="padding: 10px">
			<w2:generator style="padding: 10px;" id="gen1">
				<xf:input nextTabID="ipt2" maxByteLength="6" displayFormat="####-##" adjustMaxLength="false" style="width: 144px;height: 21px;margin-right: 10px;" id="ipt1" autoFocus="true"></xf:input>
				<xf:input nextTabID="ipt3" maxByteLength="6" displayFormat="####-##" adjustMaxLength="false" style="width: 144px;height: 21px;margin-right: 10px;" id="ipt2" autoFocus="true"></xf:input>
				<xf:input maxByteLength="6" displayFormat="####-##" adjustMaxLength="false" style="width: 144px;height: 21px;" id="ipt3" autoFocus="true"></xf:input>
			</w2:generator>
		</xf:group>
	</body>
</html>
