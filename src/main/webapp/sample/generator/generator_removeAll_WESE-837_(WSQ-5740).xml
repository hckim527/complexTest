<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	for (var index = 0; index < 1000; index++) {
		geGroup1.insertChild(index);
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:generator style="width: 200px;height: 100px;" id="geGroup1">
			<w2:accordion style="width:200px;height:147px;">
				<w2:panels id="panels1">
					<w2:panelTitle id="panelTitle1" label="센터 홍길동"></w2:panelTitle>
					<w2:panelContent id="panelContent1">
						<xf:group tagname="ul" class="m_listbox_flex">
							<xf:group tagname="li">
								<xf:group class="left">
									<w2:textbox label="활동일시" escape="false"></w2:textbox>
								</xf:group>
								<xf:group class="right">
									<w2:textbox id="tbx_actvYmd" label="2023.10.29" escape="false" displayFormat="####.##.##"></w2:textbox>
								</xf:group>
							</xf:group>
							<xf:group tagname="li">
								<xf:group class="left">
									<w2:textbox label="은행/지점" escape="false"></w2:textbox>
								</xf:group>
								<xf:group class="right">
									<w2:textbox id="tbx_bank" label="신한은행 도당동 지점" escape="false"></w2:textbox>
								</xf:group>
							</xf:group>
							<xf:group tagname="li">
								<xf:group class="left">
									<w2:textbox label="상담자" escape="false"></w2:textbox>
								</xf:group>
								<xf:group class="right">
									<w2:textbox id="tbx_cnslPesn" label="김세미" escape="false"></w2:textbox>
								</xf:group>
							</xf:group>
							<xf:group tagname="li">
								<xf:group class="left">
									<w2:textbox label="방문목적" escape="false"></w2:textbox>
								</xf:group>
								<xf:group class="right">
									<w2:textbox id="tbx_visPrpo" label="자료 전달" escape="false"></w2:textbox>
								</xf:group>
							</xf:group>
							<xf:group tagname="li" style="display:none">
								<xf:group class="left">
									<w2:textbox label="키" escape="false"></w2:textbox>
								</xf:group>
								<xf:group class="right">
									<w2:textbox id="tbx_actvAdmnPk" label="" escape="false"></w2:textbox>
								</xf:group>
							</xf:group>
							<xf:group tagname="li" style="display:none">
								<xf:group class="left">
									<w2:textbox label="비고" escape="false"></w2:textbox>
								</xf:group>
								<xf:group class="right">
									<w2:textbox id="tbx_rmk" label="" escape="false"></w2:textbox>
								</xf:group>
							</xf:group>
							<xf:group tagname="li" style="display:none">
								<xf:group class="left">
									<w2:textbox label="고객고유코드" escape="false"></w2:textbox>
								</xf:group>
								<xf:group class="right">
									<w2:textbox id="tbx_csPk" label="" escape="false"></w2:textbox>
								</xf:group>
							</xf:group>
						</xf:group>
						<xf:group class="m_grp_btn medium">
							<xf:group tagname="button" id="btn_rmk" class="m_btn" label="비고">
							</xf:group>
							<xf:group tagname="button" id="btn_input" class="m_btn">
							</xf:group>
						</xf:group>
					</w2:panelContent>
				</w2:panels>
			</w2:accordion>
		</w2:generator>
	</body>
</html>
