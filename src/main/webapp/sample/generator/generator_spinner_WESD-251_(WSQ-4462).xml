	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger11_onclick = function(e) {
	for (var i = 0; i < 1; i++) {
		generator1.insertChild(i);
		var tmpChild = generator1.getChild(i, "spinner1");
		tmpChild.setValue(i);
	}
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" style="width:141px;height:23px;" id="trigger11" ev:onclick="scwin.trigger11_onclick">
			<xf:label><![CDATA[generator]]></xf:label>
		</xf:trigger>
		<w2:generator id="generator1" style="position: relative;">
			<w2:spinner skin="type1" buttonSize="30" inputReadOnly="false" style="position: relative;width: 150px;height: 21px;" id="spinner1"></w2:spinner>
		</w2:generator>
	</body>
