<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance></xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	gp_generator.insertChild();
	gp_generator.insertChild();
	gp_generator.insertChild();
};

scwin.ge_searchbox_onchange = function() {
	localStorage.setItem("log", 'searchBox_onchange');
};

scwin.checkVal = function() {
	return localStorage.getItem('log') == 'searchBox_onchange';
};

localStorage.removeItem("log");
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:textbox id="" label="generator-searchBox" style="width: 150px;height: 23px;"></w2:textbox>
		<xf:group id="" tagname="ul">
			<w2:generator id="gp_generator">
				<w2:searchbox id="ge_searchbox" style="width: 150px;height: 21px;" ev:onchange="scwin.ge_searchbox_onchange"></w2:searchbox>
			</w2:generator>
		</xf:group>
	</body>
</html>
