<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns=""></data>
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.confirmMsg = function() {
	return confirm("닫아도 됩니까?");
};

scwin.confirmMsg1 = function() {
	return confirm("close?");
};

scwin.windowContainer1_onclosewindow = function(e) {
	alert(e.id);
};

scwin.onpageload = function() {
	windowContainer1.createWindow("naver", "", "http://www.naver.com", "네이버", "1", "", "confirmMsg");
	windowContainer1.createWindow("Daum", "", "http://www.daum.net", "다음", "2", "", "confirmMsg1");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:windowContainer defaultTop="130px" defaultLeft="150px" defaultWidth="500px" confirmFalseAction="newWindow" confirmTrueAction="existWindow"
			windowMaxNum="10" style="position:absolute;top:30px;left:30px;width:700px;height:480px;border:1px solid #000000; background-color:#3A6EA5;"
			id="windowContainer1" useCloseButton="false" closeType="all" useFixButton="true" ev:onclosewindow="scwin.windowContainer1_onclosewindow">
			<w2:windowToolbar showWindowControlIcon="true" position="bottom" style="height:24px; width:100px; background-repeat:x">
				<w2:nameLayer
					style="position:absolute; line-height:21px; overflow:hidden; top:1px; width:107px;height:21px; font-size:11px; font-weight:bold; font-family:Dotum; color:#6d8096; padding-top:1px; padding-left:3px;" />
				<w2:selectedNameLayer
					style="position:absolute; overflow:hidden; line-height:21px; top:1px; width:107px;height:21px; font-size:11px; font-weight:bold; font-family:Dotum; color:#30749e; padding-top:1px; padding-left:3px;" />
				<w2:controlIconLayer style="position:absolute; left:0px; top:1px; height:24px;width:140px;" iconWidth="23px" iconHeight="21px" iconGap="4px">
					<w2:controlIcon iconUrl="/web2_samples/uiplugin/xml/windowContainer/images/align1.gif"
						onIconUrl="/web2_samples/uiplugin/xml/windowContainer/images/align1on.gif" alignEvent="vertical" />
					<w2:controlIcon iconUrl="/web2_samples/uiplugin/xml/windowContainer/images/align2.gif"
						onIconUrl="/web2_samples/uiplugin/xml/windowContainer/images/align2on.gif" alignEvent="horizontal" />
					<w2:controlIcon iconUrl="/web2_samples/uiplugin/xml/windowContainer/images/align3.gif"
						onIconUrl="/web2_samples/uiplugin/xml/windowContainer/images/align3on.gif" alignEvent="cascade" />
					<w2:controlIcon iconUrl="/web2_samples/uiplugin/xml/windowContainer/images/align4.gif"
						onIconUrl="/web2_samples/uiplugin/xml/windowContainer/images/align4on.gif" alignEvent="sequential" />
					<w2:controlIcon iconUrl="/web2_samples/uiplugin/xml/windowContainer/images/align5.gif"
						onIconUrl="/web2_samples/uiplugin/xml/windowContainer/images/align5on.gif" alignEvent="closeAll" />
				</w2:controlIconLayer>
			</w2:windowToolbar>
		</w2:windowContainer>
		<xf:trigger type="button" style="position:absolute;word-wrap:break-word;top:60px;left:740px;width:148px;height:21px;" id="trigger2">
			<xf:label>Daum1</xf:label>
			<script type="javascript" ev:event="onclick"><![CDATA[
				windowContainer1.createWindow( "Daum" , "" , "http://www.daum.net", "다음", "2", "", "");
			 ]]></script>
		</xf:trigger>
	</body>
</html>
