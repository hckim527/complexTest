<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance></xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	scwin.px = "a";
};

scwin.trigger1_onclick = function() {
	var idx = selectbox1.getValue();
	var wId = String(scwin.px + idx);
	windowContainer1.createWindow(wId, null, "/sample/common_link/iframe_windowContainer_spaReplaceHistory_SKT-766_(WSQ-2668)" + idx + ".xml", wId, wId);
};

scwin.trigger2_onclick = function() {
	var idx = selectbox1.getValue();
	var wId = String(scwin.px + idx);
	windowContainer1.getWindowByWindowId(wId).history.back();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:windowContainer id="windowContainer1" style="position: relative;width:532px;height:335px;" windowMaxNum="8" tooltipGroupClass="false"
			spaInitCount="4" spaReplaceHistory="true">
			<w2:windowToolbar>
				<w2:nameLayer></w2:nameLayer>
				<w2:controlIconLayer>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
				</w2:controlIconLayer>
				<w2:selectedNameLayer></w2:selectedNameLayer>
			</w2:windowToolbar>
		</w2:windowContainer>
		<xf:trigger id="trigger1" style="position: relative;width:202px;height:62px;" ev:onclick="scwin.trigger1_onclick" type="button">
			<xf:label><![CDATA[createWindow]]></xf:label>
		</xf:trigger>
		<xf:select1 appearance="minimal" id="selectbox1" style="position: relative;width:221px;height:49px;" displayMode="label" selectedData="false" optionOrder="false">
			<xf:choices>
				<xf:item>
					<xf:label><![CDATA[a2]]></xf:label>
					<xf:value><![CDATA[2]]></xf:value>
				</xf:item>
			</xf:choices>
		</xf:select1>
	</body>
</html>
