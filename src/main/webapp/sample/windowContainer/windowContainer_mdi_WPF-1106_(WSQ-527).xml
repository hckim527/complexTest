<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// closeAction: 창을 닫을 때 호출, 인자는 createWindow 의 windowTitle
scwin.closeLog = [];
scwin.fn_close = function (arg) {
	scwin.closeLog.push(arg);
	tbx_log.setValue(scwin.closeLog.join(","));
	return true;
};
scwin.trigger1_onclick = function (e) {
	windowContainer1.createWindow("test1", null, "", "test1", "id1", "newWindow", "scwin.fn_close");
};
scwin.trigger2_onclick = function (e) {
	windowContainer1.createWindow("test2", null, "", "test2", "id1", "newWindow", "scwin.fn_close");
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" id="trigger1" style="width: 65px;height: 27px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[open1]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width: 65px;height: 27px;" type="button">
			<xf:label><![CDATA[open2]]></xf:label>
		</xf:trigger>
		<w2:textbox id="tbx_log" label=""></w2:textbox>
		<w2:windowContainer id="windowContainer1" windowAutoResize="false" style="position: relative;margin-top:10px;width:440px;height:275px;" tooltipDisplay="true" stopToggleOnLast="false" useFixButton="false" windowMaxNum="5" hideTitleOnMaximize="false" useStatusMsg="true" useCloseButton="false" windowMaximizeAll="false" toolbarPosition="bottom">
			<w2:windowToolbar>
				<w2:nameLayer></w2:nameLayer>
				<w2:controlIconLayer>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
				</w2:controlIconLayer>
				<w2:selectedNameLayer></w2:selectedNameLayer>
			</w2:windowToolbar>
		</w2:windowContainer>
	</body>
</html>
