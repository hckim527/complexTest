<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	scwin.windowId = 0;
};

scwin.createWindow = function() {
	var c_subName = "/sample/common_link/windowContainer_spaAuto_WPFF-148_(WSQ-3499)_sub";
	var c_xmlName = ".xml";
	var frameMode = "";
	if (scwin.windowId % 2) {
		frameMode = "iframe";
	} else {
		frameMode = "wframe";
	}
	windowContainer1.createWindow(c_subName + scwin.windowId + frameMode, null,
		c_subName + scwin.windowId + c_xmlName, "", null, "existWindow", null,
		null, null, null, frameMode);
	scwin.windowId++;
};

scwin.btn_createWindow_onclick = function(e) {
	scwin.createWindow();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="height:511px;width:900px;">
			<w2:textbox id="" label="WindowContainer nameLayerMove Test" style="position: relative;height:30px;font-size:18pt;width:100%;"></w2:textbox>
			<w2:windowContainer id="windowContainer1" nameLayerMove="true" style="position: relative;height:550px;width:100%;" windowAutoResize="true" windowMaxNum="10" frameMode="" spaAuto="true">
				<w2:windowToolbar>
					<w2:nameLayer></w2:nameLayer>
					<w2:controlIconLayer>
						<w2:controlIcon></w2:controlIcon>
						<w2:controlIcon></w2:controlIcon>
						<w2:controlIcon></w2:controlIcon>
						<w2:controlIcon></w2:controlIcon>
						<w2:controlIcon></w2:controlIcon>
					</w2:controlIconLayer>
					<w2:selectedNameLayer></w2:selectedNameLayer>
				</w2:windowToolbar>
			</w2:windowContainer>
			<xf:trigger ev:onclick="scwin.btn_createWindow_onclick" id="btn_createWindow" style="position: relative;width:144px;height:23px;" type="button">
				<xf:label><![CDATA[Create Window]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
