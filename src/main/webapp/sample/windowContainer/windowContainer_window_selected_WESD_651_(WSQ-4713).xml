<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<style>
			.w2window_selected {border-color:red;}
		</style>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	scwin.createWindow();
	var windowIdArr = [];
	for (i = 0; i < windowContainer1.windows.length; i++) {
		windowIdArr.push(windowContainer1.windows[i].windowId);
	}
	windowContainer1.setArrangeWindows("vertical", windowIdArr);
};

scwin.createWindow = function() {
	var c_cnt = 3;
	var c_subName = "sub";
	var c_menuName = "menu";
	for (var i = 0; i < c_cnt; i++) {
		var winObj = {
			title: c_subName + i,
			src: "sub.xml",
			windowId: c_menuName + i
		};
		windowContainer1.createWindow(winObj);
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="position:relative;height:600px;">
			<w2:windowContainer class="mdi" controlIconPosition="right" fixArrangeFullScreen="false" frameMode="wframe"
				hideTitleOnMaximize="false" horizontalArrangeNum="2" id="windowContainer1" sequentialArrangeColNum="2" sequentialArrangeRowNum="2" spaInitCount="0" nameLayerMoveGap="155" useWindowId="true"
				stopMinimizeOnNameLayer="true" stopToggleOnLast="true" toolbarPosition="top" tooltipDisplay="true" tooltipGroupClass="false"
				useCloseButton="true" useControlIconTitle="true" useCustomMsg="false" useNameContainer="true" useStatusMsg="true"
				verticalArrangeNum="2" windowAutoResize="false" windowMaxNum="100" windowMaximizeAll="true" windowTooltipDisplay="true"
				nameLayerMenu="false" useWindowScrollButton="true">
				<w2:windowToolbar>
					<w2:controlIconLayer>
						<w2:controlIcon></w2:controlIcon>
						<w2:controlIcon></w2:controlIcon>
						<w2:controlIcon></w2:controlIcon>
						<w2:controlIcon></w2:controlIcon>
						<w2:controlIcon></w2:controlIcon>
					</w2:controlIconLayer>
					<w2:nameLayer></w2:nameLayer>
					<w2:selectedNameLayer></w2:selectedNameLayer>
				</w2:windowToolbar>
			</w2:windowContainer>
		</xf:group>
	</body>
</html>
