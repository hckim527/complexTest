<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	winCon1.createWindow("testWindow", null, "");
};

scwin.trigger2_onclick = function(e) {
	winCon1.createWindow("testWindow2", null, "");
};

scwin.trigger3_onclick = function(e) {
	winCon1.createWindow("testWindow3", null, "");
};
]]></script>
	</head>
	<body>
		<w2:windowContainer tooltipGroupClass="false" keepSelectedWindow="true" id="winCon1" style="position: absolute ;left:25px;top:27px;width:653px;height:342px;" frameMode="wframe">
			<w2:windowToolbar>
				<w2:selectedNameLayer></w2:selectedNameLayer>
				<w2:controlIconLayer>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
					<w2:controlIcon></w2:controlIcon>
				</w2:controlIconLayer>
				<w2:nameLayer></w2:nameLayer>
			</w2:windowToolbar>
		</w2:windowContainer>
		<xf:trigger type="button" id="trigger1" style="position: absolute ;left:700px;top:25px;width:190px;height:40px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[createWindow]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="position: absolute ;left:700px;top:195px;width:190px;height:40px;" type="button">
			<xf:label><![CDATA[createWindow 2]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3" style="position: absolute ;left:700px;top:250px;width:190px;height:40px;" type="button">
			<xf:label><![CDATA[createWindow 3]]></xf:label>
		</xf:trigger>
	</body>
</html>
