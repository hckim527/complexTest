							<col1><![CDATA[20170926]]></col1>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.__getJq = function(q) {
	var j = $(q); if (j.length) return j;
	var P = 'mf_', t = q.trim(), r = t.slice(1);
	if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
	return $(t.slice(0, 1) + r);
};
scwin.trigger1_onclick = function(e) {
	calendar1.setHolidayRef("data:dataList1.col1");
};
scwin.checkColor = function(id, value, rgb) {
	var color = scwin.__getJq("#" + id).css("color");
	if (color.indexOf("rgb") != -1) {
		return color == rgb;
	}
	return color == value;
};
]]></script>
	</head>
	<body>
		<w2:calendar calendarValueType="yearMonthDate" id="calendar1" renderDiv="true" renderType="component"
			style="position:relative;width:300px;height:300px;">
		</w2:calendar>
		<xf:trigger type="button" id="trigger1" style="position:relative;width:80px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setHolidayRef]]></xf:label>
		</xf:trigger>
	</body>
