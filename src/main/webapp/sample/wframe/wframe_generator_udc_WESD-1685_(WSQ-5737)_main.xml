		<script type="text/javascript" lazy="false"><![CDATA[
scwin.test = function() {
	var z = gen_sbm.getChild(0, "udc_sbmMultiItem");
	var w = gen_sbm.getChild(0, "udc_sbmMultiItem2");
	window.result = z && w ? "success" : "fail";
};

scwin.btn_actAdd_onclick = function(e) {
	gen_sbm.insertChild(gen_sbm.getChildrenCount());
	scwin.test();
};

scwin.checkVal1 = function() {
	return (document.getElementById('gen_sbm_0_wframe1') || document.getElementById('mf_gen_sbm_0_wframe1')).innerText == 'wframe';
};

scwin.checkVal2 = function() {
	return window.result == 'success';
};
]]></script>
