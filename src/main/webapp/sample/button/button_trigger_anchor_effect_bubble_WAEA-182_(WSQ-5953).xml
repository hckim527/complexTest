<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.checkVal1 = function(elem) {
	var aTag = scwin.__getDom(elem);
	var hasEm = false;
	var hasI = false;
	for (var i = 0; i < aTag.children.length; i++) {
		var tag = aTag.children[i].tagName.toLowerCase();
		if (tag === "em") {
			hasEm = true;
		} else if (tag === "i") {
			hasI = true;
		}
	}
	return hasEm && hasI;
};
]]></script>
	</head>
	<body>
		<w2:textbox id="" label="trigger" tagname="h1"></w2:textbox>
		<xf:group tagname="fieldset" style="height:130px;border:1px solid red;">
			<legend style="font-size:20px;">animationType=bubble, animationColor=pink, type=anchor</legend>
			<xf:trigger type="anchor" id="" style="width:419px;height:106px;" class="btn_bubble" animationType="bubble" animationColor="pink">
				<xf:label><![CDATA[trigger]]></xf:label>
			</xf:trigger>
		</xf:group>
		<w2:textbox id="" label="Anchor" tagname="h1"></w2:textbox>
		<xf:group tagname="fieldset" style="height:130px;border:1px solid red;">
			<legend style="font-size:20px;">animationType=bubble, animationColor=blue</legend>
			<w2:anchor outerDiv="false" id="" style="width:419px;height:106px;" class="btn_bubble" animationType="bubble" animationColor="blue">
				<xf:label><![CDATA[anchor]]></xf:label>
			</w2:anchor>
		</xf:group>
		<w2:textbox id="" label="button" tagname="h1"></w2:textbox>
		<xf:group tagname="fieldset" style="height:130px;border:1px solid red;">
			<legend style="font-size:20px;">animationType=bubble, animationColor=gray</legend>
			<w2:button style="width:419px;height:106px;" id="" label="button" class="btn_bubble" animationType="bubble" animationColor="gray"></w2:button>
		</xf:group>
	</body>
</html>
