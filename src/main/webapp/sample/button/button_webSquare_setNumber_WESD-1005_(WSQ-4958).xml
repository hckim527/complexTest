<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	input1.setValue(WebSquare.util.setNumber(null));
};
scwin.trigger4_onclick = function(e) {
	input1.setValue(WebSquare.util.setNumber(undefined));
};
scwin.checkVal = function() {
	return (document.getElementById('input1') || document.getElementById('mf_input1')).value == '';
};
]]></script>
	</head>
	<body>
		<xf:input adjustMaxLength="false" id="input1" style="width:144px;height:21px;"></xf:input>
		<xf:trigger type="button" style="width:80px;height:23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[null]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" style="width:80px;height:23px;" id="trigger4" ev:onclick="scwin.trigger4_onclick">
			<xf:label><![CDATA[undefined]]></xf:label>
		</xf:trigger>
	</body>
</html>
