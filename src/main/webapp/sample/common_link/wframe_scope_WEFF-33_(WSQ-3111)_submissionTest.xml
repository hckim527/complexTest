<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
						<w2:key id="key2" name="name2" dataType="text"></w2:key>
						<w2:key id="key3" name="name3" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
				<w2:dataMap baseNode="map" id="dataMap2">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
						<w2:key id="key2" name="name2" dataType="text"></w2:key>
						<w2:key id="key3" name="name3" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
				<w2:linkedDataList id="linkedDataList1" bind="dataList1">
					<w2:condition type="filter"><![CDATA[]]></w2:condition>
					<w2:condition type="sort"><![CDATA[]]></w2:condition>
				</w2:linkedDataList>
				<w2:dataList id="wholiday" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.wcustomformatter1 = function(v, fv, r, c) {
	return "[w]" + fv;
};

scwin.onpageload = function() {
	textbox1.setValue(scwin.$w.getFrameId());
};

scwin.trigger4_onclick = function(e) {
	scwin.$w.deleteSubmission("submission2");
};

scwin.trigger3_onclick = function(e) {
	scwin.$w.executeSubmission("submission1");
	scwin.$w.executeSubmission("submission2");
};

scwin.trigger2_onclick = function(e) {
	scwin.createSubmission("submission2", 'data:json,[{"id":"dataList1","key":"dataList1"}, \{"id":"dataMap1","key":"dataMap1"},{"id":"dataMap2","key":"dataMap2"}]');
};

scwin.createSubmission = function(id, target) {
	var submissionObj = {
		"id": id,
		"target": target,
		"action": "/data/wframe_scope_WEFF-33_(WSQ-3111)_data1.json",
		"method": "post",
		"mediatype": "application/json",
		"encoding": "UTF-8",
		"instance": "",
		"replace": "",
		"mode": "asynchronous",
		"processMsg": "작업을 처리중입니다.",
	};
	scwin.$w.createSubmission(submissionObj);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:textbox label="" id="textbox1" style="position: relative;width: 250px;height: 40px;font-size:24px;"></w2:textbox>
		<xf:group id="" style="width:720px;height:700px;">
			<xf:group id="" style="width:350px;height:700px;float:left;">
				<w2:gridView dataList="dataList1" id="wgridView1" style="width:330px;height:200px;" scrollByColumn="false" useShiftKey="true" fixedColumnWithHidden="true">
					<w2:header id="header1">
						<w2:row id="row2">
							<w2:column id="column9" style="height:20px" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
							<w2:column id="column7" style="height:20px" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
							<w2:column id="column3" style="height:20px" width="70" inputType="text" value="name3" displayMode="label"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody4">
						<w2:row id="row5">
							<w2:column id="col1" style="height:20px" inputType="calendar" width="70" displayMode="label" holidayRef="data:wholiday.col1"></w2:column>
							<w2:column id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
							<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
				<w2:gridView dataList="linkedDataList1" fixedColumnWithHidden="true" id="wgridView2" scrollByColumn="false" style="width:330px;height:200px;" useShiftKey="true">
					<w2:header id="header1">
						<w2:row id="row2">
							<w2:column displayMode="label" id="column9" inputType="text" style="height:20px" value="name1" width="70"></w2:column>
							<w2:column displayMode="label" id="column7" inputType="text" style="height:20px" value="name2" width="70"></w2:column>
							<w2:column displayMode="label" id="column3" inputType="text" style="height:20px" value="name3" width="70"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody4">
						<w2:row id="row5">
							<w2:column displayMode="label" id="col1" inputType="text" style="height:20px" width="70"></w2:column>
							<w2:column displayMode="label" id="col2" inputType="text" style="height:20px" width="70" customFormatter="scwin.wcustomformatter1"></w2:column>
							<w2:column displayMode="label" id="col3" inputType="text" style="height:20px" width="70"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>
		</xf:group>
		<xf:group id="" style="height:37px;">
			<xf:trigger id="trigger2" style="width:173px;height:37px;" ev:onclick="scwin.trigger2_onclick" type="button">
				<xf:label><![CDATA[createSubmission2]]></xf:label>
			</xf:trigger>
			<xf:trigger id="trigger3" style="width:173px;height:37px;" ev:onclick="scwin.trigger3_onclick" type="button">
				<xf:label><![CDATA[executeSubmission1,2]]></xf:label>
			</xf:trigger>
			<xf:trigger id="trigger4" style="width:173px;height:37px;" ev:onclick="scwin.trigger4_onclick" type="button">
				<xf:label><![CDATA[deleteSubmission2]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
