<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>UDC</w2:type>
		<w2:buildDate/>
		<w2:model></w2:model>
	</head>
	<body>
		<!--/** WEBSQUARE UDC */
			{
			"icon": "",
			"apis": [
			{
			"description": "desc",
			"name": "onTrigger1",
			"return": [{
			"description": "desc",
			"type": "String"
			}],
			"params": []
			}
			],
			"events": [],
			"width": "300px",
			"properties": [
			{
			"default": "",
			"description": "Component id",
			"hidden": "N",
			"name": "id",
			"necessary": "Y",
			"type": "string",
			"bindparent": "",
			"option": ""
			},
			{
			"default": "",
			"description": "Component style",
			"hidden": "N",
			"name": "style",
			"necessary": "N",
			"type": "string",
			"bindparent": "",
			"option": ""
			}
			],
			"notSupportBrowser": "",
			"version": "",
			"category": "Basic",
			"htmlRender": "",
			"componentName": "udc_input_trigger",
			"height": "23px",
			"pluginName": "udc_input_trigger",
			"developer": "",
			"disableIcon": "",
			"description": "",
			"company": ""
			}
		-->
		<xf:group class="" id="" style="" pluginName="udc_input_trigger">
			<script ev:event="oncreated(options)" type="text/javascript"><![CDATA[
				udc_obj.onTrigger1 = function(){
					console.log("udc_obj.onTrigger1");
					var udcID = udc_obj.id;
					// Jira(WEFF-598 / WSQ-4293 첨부) 원본 로직: UDC 안에서 보이는 scwin 으로 wframe 바깥(main) 함수 호출
					var funcStr = "scwin.outter_wframe";
					var func = eval(funcStr);
					if(typeof func === "function") {
						func(udcID);
					} else {
						alert(funcStr + " is not a function");
					}
				};
				]]></script>
			<xf:input adjustMaxLength="false" id="" style="width: 144px;height: 21px;"></xf:input>
			<xf:trigger type="button" id="" style="width: 80px;height: 23px;">
				<xf:label><![CDATA[udc_trigger1]]></xf:label>
				<script ev:event="onclick(e)" type="text/javascript"><![CDATA[
					udc_obj.onTrigger1();
				]]></script>
			</xf:trigger>
		</xf:group>
	</body>
</html>
