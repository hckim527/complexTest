<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{
			"col1": "송하윤",
			"col2": "bbbb1",
			"col3": "",
			"col4": "신한"
		},
		{
			"col1": "이유비",
			"col2": "bbbb2",
			"col3": "",
			"col4": "국민"
		},
		{
			"col1": "고우리",
			"col2": "bbbb3",
			"col3": "",
			"col4": "우리"
		},
		{
			"col1": "김민주",
			"col2": "bbbb4",
			"col3": "",
			"col4": "농협"
		}
	];
	dataList1.setJSON(jsonData);
};

scwin.titleSet = function(rowIndex, colIndex, data) {
	if (gridView1.getCellOption(rowIndex, colIndex, "id") == "col3") {
		return dataList1.getCellData(rowIndex, "col1") + "  값이어요";
	} else {
		return "";
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" checkReadOnlyOnCut="true" checkDisabledOnCut="true" titleFormatter="scwin.titleSet" fixedColumnWithHidden="true" id="gridView1" scrollByColumn="false" scrollByColumnAdaptive="false" showSortableUseFilter="false" style="position: relative;width: 350px;height: 200px;" useFilterList="false" useShiftKey="true" checkReadOnlyOnPaste="true" titleAuto="" senseReader="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="column7" inputType="text" style="height:20px;" value="이름" width="70"></w2:column>
					<w2:column displayMode="label" id="column5" inputType="text" style="height:20px;" value="name2" width="70"></w2:column>
					<w2:column displayMode="label" id="column3" inputType="text" style="height:20px;" value="금액" width="70"></w2:column>
					<w2:column displayMode="label" id="column1" inputType="text" style="height:20px;" value="은행" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="col1" inputType="text" style="height:20px" width="70" readOnly="true"></w2:column>
					<w2:column displayMode="label" hidden="true" id="col2" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayMode="label" id="col3" inputType="text" style="height:20px" width="70" displayType=""></w2:column>
					<w2:column displayMode="label" id="col4" inputType="text" style="height:20px" width="70" readOnly="true"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
