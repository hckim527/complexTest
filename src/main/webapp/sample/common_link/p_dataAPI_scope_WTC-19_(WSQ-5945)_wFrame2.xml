<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<w2:MSA />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="code" name="코드" dataType="text"></w2:column>
						<w2:column id="label" name="코드명" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<code><![CDATA[C0001_2]]></code>
							<label><![CDATA[TYPE1_2]]></label>
						</w2:row>
						<w2:row>
							<code><![CDATA[C0002_2]]></code>
							<label><![CDATA[TYPE2_2]]></label>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="lang" name="언어코드" dataType="text"></w2:key>
						<w2:key id="output" name="출력값" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="true">
						<lang><![CDATA[ko_2]]></lang>
						<output><![CDATA[한국어_2]]></output>
					</w2:data>
				</w2:dataMap>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
};

scwin.btn_2_1_onclick = function (e) {
	var arrResult = $p.data.getAllDataCollection();
	console.log(arrResult);
};

scwin.btn_3_1_onclick = function (e) {
	var blnResult = $p.data.getBroadcast();
	console.log(blnResult);
};

scwin.btn_3_2_onclick = function (e) {
	$p.data.setBroadcast(false);
};

scwin.btn_3_3_onclick = function (e) {
	$p.data.setBroadcast(true);
};

scwin.btn_4_1_onclick = function (e) {
	var info = $p.data.getInfo();
	console.log(info);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger ev:onclick="scwin.btn_2_1_onclick" id="btn_2_1" style="height: 23px;" type="button">
			<xf:label><![CDATA[getAllDataCollection()]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.btn_3_1_onclick" id="btn_3_1" style="height: 23px;" type="button">
			<xf:label><![CDATA[getBroadcast()]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.btn_3_2_onclick" id="btn_3_2" style="height: 23px;" type="button">
			<xf:label><![CDATA[setBroadcast(false)]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.btn_3_3_onclick" id="btn_3_3" style="height: 23px;" type="button">
			<xf:label><![CDATA[setBroadcast(true)]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.btn_4_1_onclick" id="btn_4_1" style="height: 23px;" type="button">
			<xf:label><![CDATA[getInfo()]]></xf:label>
		</xf:trigger>
	</body>
</html>
