<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	scwin.initError();
};

// 수정 전: 동적 생성 시 이 함수가 여러 번 호출됨
scwin.initError = function() {
	console.log("popup scwin.initError");
	scwin.initCount = (scwin.initCount || 0) + 1;
	tbx_title.setValue("initError " + scwin.initCount);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:floatingLayer id="flt_message" title="Message" style="width:70%;left:10%;top:10%;">
			<w2:textbox id="tbx_title" label=""></w2:textbox>
			<xf:group id="tbl_err" style="width:100%;" class="w2tb" tagname="table">
				<w2:generator id="tbl_errList" tagname="tbody">
					<xf:group tagname="tr">
						<xf:group class="w2tb_td" tagname="td">
							<w2:textbox id="td_textbox" label=""></w2:textbox>
						</xf:group>
					</xf:group>
				</w2:generator>
			</xf:group>
		</w2:floatingLayer>
	</body>
</html>
