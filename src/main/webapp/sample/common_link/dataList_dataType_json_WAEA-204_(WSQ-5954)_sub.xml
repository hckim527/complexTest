<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:aliasDataList scope="../dataList1" id="aliasDataList1"></w2:aliasDataList>
				<w2:aliasDataList scope="../dataList2" id="aliasDataList2"></w2:aliasDataList>
				<w2:aliasDataList scope="../dataList3" id="aliasDataList3"></w2:aliasDataList>
				<w2:aliasDataList scope="../dataList4" id="aliasDataList4"></w2:aliasDataList>
				<w2:aliasDataList scope="../dataList5" id="aliasDataList5"></w2:aliasDataList>
				<w2:aliasDataMap scope="../dataMap1" id="aliasDataMap1"></w2:aliasDataMap>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
]]></script>
	</head>
	<body>
		<w2:gridView id="gridView1" style="width:700px;height:250px;" rowNumVisible="true"
			dataList="data:aliasDataList1" sortable="true" contextMenu="true" useFilterList="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="120" inputType="text" id="column19" value="text" displayMode="label" useFilter="true"></w2:column>
					<w2:column width="120" inputType="text" id="column18" value="link" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column17" value="checkbox" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column16" value="button" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column15" value="image" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column14" value="radio" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column13" value="select" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column12" value="calendar" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column11" value="expression" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column10" value="textarea" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column9" value="drilldown" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column8" value="textImage" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column7" value="checkcombobox" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column6" value="autoComplete" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="secret" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="text" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="spinner" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value="text" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="text" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="hcol20" value="YNFalse" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="link" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="checkbox" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="button" id="col4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="image" id="col5" displayMode="label"></w2:column>
					<w2:column width="70" inputType="radio" id="col6" displayMode="label"></w2:column>
					<w2:column width="70" inputType="select" id="col7" displayMode="label" allOption=""
						chooseOption="true" chooseOptionLabel="" ref="">
						<w2:choices>
							<w2:itemset nodeset="data:aliasDataList2">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="calendar" id="col8" displayMode="label"></w2:column>
					<w2:column width="70" inputType="expression" id="col9" displayMode="label" expression="SUM('col1') + SUM('col7')"></w2:column>
					<w2:column width="70" inputType="textarea" id="col10" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col11" displayMode="label" depthColumn="col11" showDepth="4"></w2:column>
					<w2:column width="70" inputType="textImage" id="col12" displayMode="label" imageSrc="btn_search.png" viewType="icon"></w2:column>
					<w2:column width="70" inputType="checkcombobox" id="col13" displayMode="label" allOption=""
						chooseOption="" ref="">
						<w2:choices>
							<w2:itemset nodeset="data:aliasDataList3">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="autoComplete" id="col14" displayMode="label" allOption=""
						chooseOption="" ref="">
						<w2:choices>
							<w2:itemset nodeset="data:aliasDataList4">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="secret" id="col15" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col16" displayMode="label"></w2:column>
					<w2:column width="70" inputType="spinner" id="col17" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col18" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col19" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col20" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:group style="position:relative;width:700;height:40px;">
			<xf:input id="input1" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap1.key1"/>
			<xf:input id="input2" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap1.key2"/>
			<xf:input id="input3" style="position:relative;width:227px;height:32px;" ref="data:aliasDataMap1.key3"/>
		</xf:group>
	</body>
</html>
