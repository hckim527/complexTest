<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="date"></w2:column>
						<w2:column id="col5" name="name5" dataType="date"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[12345.67]]></col1>
							<col2><![CDATA[12345.67]]></col2>
							<col3><![CDATA[12345.67]]></col3>
							<col4><![CDATA[20171231]]></col4>
							<col5><![CDATA[20171231000000]]></col5>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dataList3" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[aaaa]]></col1>
							<col2><![CDATA[aaaa]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[bbbb]]></col1>
							<col2><![CDATA[bbbb]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	gridView1.setColumnNodeSet("col6", "data:dataList3", "col1", "col2");
};
scwin.customModelFormatter = function(domValue) {
	return domValue.replace(",", ".");
};
scwin.customModelUnformatter = function(domValue) {
	return domValue.replace(".", ",");
};
scwin.trigger12_onclick = function(e) {
	var options = {};
	options.headerExist = "1";
	options.type = "1";
	gridView1.advancedExcelUpload(options);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1" style="position:relative;width: 500px;height: 150px;left:23px;top:48px;" fixedColumnWithHidden="true" useShiftKey="true" euroMask="#.###,##" autoFit="allColumn">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" width="70" inputType="text" displayMode="label" value="name1"></w2:column>
					<w2:column id="column3" inputType="text" width="70" displayMode="label" value="name2"></w2:column>
					<w2:column id="column2" inputType="text" width="70" displayMode="label" value="name3"></w2:column>
					<w2:column id="column4" inputType="text" width="100" value="name4" displayMode="label"></w2:column>
					<w2:column id="column6" inputType="text" width="120" value="name5" displayMode="label"></w2:column>
					<w2:column id="column7" inputType="text" width="70" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" width="70" inputType="text" displayMode="label" customModelFormatter="customModelFormatter" customModelUnformatter="customModelUnformatter" dataType="euro" applyFormat="all"></w2:column>
					<w2:column id="col2" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="col4" style="height:20px" inputType="calendar" width="100" displayMode="label" calendarValueType="yearMonthDate"></w2:column>
					<w2:column id="col5" inputType="calendar" width="120" displayMode="label" calendarValueType="yearMonthDateTimeSec"></w2:column>
					<w2:column id="col6" inputType="select" width="70" displayMode="label" chooseOption="true">
						<w2:choices></w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger id="trigger12" style="width:130px;height:23px;margin-top:170px;margin-left:25px;" type="button" ev:onclick="scwin.trigger12_onclick">
			<xf:label><![CDATA[advacnedExcelUpload]]></xf:label>
		</xf:trigger>
	</body>
</html>
