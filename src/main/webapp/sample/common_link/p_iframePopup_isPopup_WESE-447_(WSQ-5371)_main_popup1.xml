<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var _param = $p.getParameter("exam_param") || {};
	tbx_type.setValue(_param.type);
};
scwin.btn_exam1_onclick = function (e) {
	alert($p.isPopup());
};
scwin.btn_exam2_onclick = function (e) {
	alert($p.isPopup(true));
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding: 6px;">
			<w2:textbox id="tbx_type" label="팝업 유형" tagname="h2"></w2:textbox>
			<xf:group>
				<xf:trigger ev:onclick="scwin.btn_exam1_onclick" id="btn_exam1" style="min-width: 60px;height: 23px;padding: 0px 6px;margin-right: 6px;" type="button">
					<xf:label><![CDATA[isPopup]]></xf:label>
				</xf:trigger>
				<xf:trigger ev:onclick="scwin.btn_exam2_onclick" id="btn_exam2" style="min-width: 60px;height: 23px;padding: 0px 6px;margin-right: 6px;" type="button">
					<xf:label><![CDATA[isPopup( true )]]></xf:label>
				</xf:trigger>
			</xf:group>
			<xf:group>
				<w2:textbox label="하단 WFrame 영역" tagname="h2"></w2:textbox>
				<w2:wframe style="min-height: 100px;border: 2px solid #ddd;" id="wfm_sub" src="/sample/common_link/p_iframePopup_isPopup_WESE-447_(WSQ-5371)_main_popup2.xml"></w2:wframe>
