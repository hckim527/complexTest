<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:aliasDataList id="ds_dataList1" scope="/dataList1"/>
				<w2:aliasDataMap id="ds_dataMap1" scope="/dataMap1"/>
				<w2:aliasLinkedDataList id="ds_linkedDataList1" scope="/linkedDataList1"/>
			</w2:dataCollection>
			<w2:workflowCollection/>
		</xf:model>
	</head>
	<body>
		<w2:gridView dataList="data:ds_dataList1" id="gridView1" style="width: 280px;height: 150px;" defaultCellHeight="20">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column2" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column1" inputType="text" width="70" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" inputType="text" width="70" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:input id="input_gridView1" style="width:150px;height:25px;" ref="data:ds_dataList1.col1"></xf:input>
		<xf:input id="input_dataMap1" style="width:150px;height:25px;" ref="data:ds_dataMap1.key1"></xf:input>
	</body>
</html>
