<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		var row = 100;
		var col = 5;
		var data = [];
		for (var i = 0; i < row; i++) {
			for (var j = 0; j < col; j++) {
				data.push(i * col + j);
			}
		}
		dataList1.setData(data);
	};
	]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20"
			scrollByColumnAdaptive="false" id="gridView1" style="position:relative;width:620px;height:350px;" useShiftKey="true" rowNumVisible="true" contextMenu="true" columnMove="true" sortable="true">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column blockSelect="false" id="column7" inputType="text" width="110" value="col1" displayMode="label" useFilter="true"></w2:column>
					<w2:column blockSelect="false" id="column5" inputType="text" width="110" value="col2" displayMode="label" useFilter="true"></w2:column>
					<w2:column blockSelect="false" id="column3" width="110" inputType="text" value="col3" displayMode="label" useFilter="true"></w2:column>
					<w2:column blockSelect="false" id="column1" width="110" inputType="text" value="col4" displayMode="label" useFilter="true"></w2:column>
					<w2:column blockSelect="false" id="column9" width="110" inputType="text" value="col5" displayMode="label" useFilter="true"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row5">
					<w2:column blockSelect="false" id="col1" inputType="textarea" width="70" displayMode="label" disabled="true"></w2:column>
					<w2:column blockSelect="false" id="col2" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="col3" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="col4" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="col5" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
