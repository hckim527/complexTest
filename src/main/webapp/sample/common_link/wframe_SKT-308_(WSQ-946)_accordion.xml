		<style type="text/css"><![CDATA[
.w2accordion {
	overflow: auto;
	border : 0px !important;
}

.w2panels {
	position: relative;
	border: 1px solid #ffffff;
}

.w2panels_content_closed {
	display: none;
}

.w2panels_content_open {
	position: relative;
	display: block;
	overflow: auto;
}

.w2panels_title {
	position: relative;
	height: 25px;
	cursor: pointer;
	background: #ff6d00;
}
]]></style>
