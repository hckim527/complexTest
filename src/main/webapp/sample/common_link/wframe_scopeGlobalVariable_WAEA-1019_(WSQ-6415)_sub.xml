<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2006/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <xf:model/>
        <w2:global>
            <w2:var id="VR_ctl_nm" description="scope 격리 검증용" value="init"/>
            <w2:var id="VR_Count" description="scope 격리 검증용" value="0"/>
        </w2:global>
        <script type="text/javascript" lazy="false"><![CDATA[
        scwin.onpageload = function () {
            scvar.VR_ctl_nm = $p.getFrameId();
            txt_info.setValue("scope=" + $p.getFrameId() + " / scvar.VR_ctl_nm=" + scvar.VR_ctl_nm);
            $p.top().scwin.log("[sub] " + $p.getFrameId() + " onpageload : scvar.VR_ctl_nm=" + scvar.VR_ctl_nm);
        };
        ]]>
        </script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <xf:group style="padding:6px;">
            <xf:input id="txt_info" style="width:360px;"></xf:input>
        </xf:group>
    </body>
</html>
