<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
		</xf:model>
	</head>
	<body>
		<!--/** WEBSQUARE UDC */
		{
		"componentName": "Input Button",
		"pluginName": "exm_inputButton",
		"company": "",
		"developer": "",
		"category": "Basic",
		"notSupportBrowser": "",
		"version": "",
		"htmlRender": "",
		"icon": "",
		"disableIcon": "",
		"description": "",
		"width": "300px",
		"height": "23px",
		"properties": [
		{
		"name": "id",
		"default": "",
		"type": "string",
		"option": "",
		"necessary": "Y",
		"hidden": "N",
		"description": "아이디"
		},
		{
		"name": "defaultValue",
		"default": "",
		"type": "string",
		"option": "",
		"necessary": "N",
		"hidden": "N",
		"description": "기본값"
		}
		],
		"events": [
		{
		"name": "onChange()",
		"type": "basic",
		"description": "값이 변경시"
		},
		{
		"name": "onSearch()",
		"type": "basic",
		"description": "버튼 클릭시"
		}
		],
		"apis": [
		{
		"name": "getValue",
		"description": "값을 반환한다",
		"params": [],
		"return": [{
		"type": "String",
		"description": "값"
		}]
		},
		{
		"name": "setValue",
		"description": "값을 세팅한다",
		"params": [{
		"type": "String",
		"name": "value",
		"description": "값"
		}],
		"return": [{
		"type": "String",
		"description": ""
		}]
		}
		]
		}
		-->
		<xf:group id="" style="height:23px;" pluginName="exm_inputButton">
			<xf:input id="ibx_search" style="position: relative;width: 144px;height: 21px;"></xf:input>
			<xf:trigger id="btn_search" style="position: relative;width: 80px;height: 23px;margin-left:5px;" type="button">
				<xf:label><![CDATA[검색]]></xf:label>
			</xf:trigger>
			<script ev:event="oncreated(options)" type="javascript"><![CDATA[
				scwin.init = function() {
					btn_search.bind("onclick",
						function(e) {
							udc_obj.trigger("onSearch");
						}
					);
				};
				udc_obj.getValue= function(){
					return ibx_search.getValue();
				};
				udc_obj.setValue= function(value){
					ibx_search.setValue(value);
				};
				scwin.init();
			]]></script>
		</xf:group>
	</body>
</html>
