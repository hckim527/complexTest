<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:ev="http://www.w3.org/2001/xml-events"
      xmlns:w2="http://www.inswave.com/websquare"
      xmlns:xf="http://www.w3.org/2002/xforms">
<head>
    <w2:type>DEFAULT</w2:type>
    <w2:buildDate/>
    <xf:model>
        <xf:instance>
            <data xmlns=""/>
        </xf:instance>
        <w2:dataCollection baseNode="map"/>
        <w2:workflowCollection/>
    </xf:model>
    <script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    $p.top().scwin.log("[middle] onpageload fired (외부 tabControl 의 첫번째 content, wframe)");
};
]]></script>
</head>
<body ev:onpageload="scwin.onpageload">

    <w2:tabControl id="tabControl_inner"
                   style="width:960px;height:320px;"
                   useTabKeyOnly="false" useMoveNextTabFocus="false"
                   useBackbridge="true" useConfirmMessage="false"
                   confirmTrueAction="exist" confirmFalseAction="new"
                   tabScroll="true">
        <w2:tabs id="inner_tab1" label="Inner Tab A (leaf_a.xml)"
                 style="width:220px;height:28px;" disabled="false"></w2:tabs>
        <w2:tabs id="inner_tab2" label="Inner Tab B (leaf_b.xml)"
                 style="width:220px;height:28px;" disabled="false"></w2:tabs>

        <w2:content id="content_inner_a" alwaysDraw="true" frameMode="wframe"
                    style="height:280px;" src="/sample/common_link/tabControl_alwaysDraw_WAEA-861_(WSQ-6323)_leaf_a.xml"></w2:content>
        <w2:content id="content_inner_b" alwaysDraw="true" frameMode="wframe"
                    style="height:280px;" src="/sample/common_link/tabControl_alwaysDraw_WAEA-861_(WSQ-6323)_leaf_b.xml"></w2:content>
    </w2:tabControl>

</body>
</html>
