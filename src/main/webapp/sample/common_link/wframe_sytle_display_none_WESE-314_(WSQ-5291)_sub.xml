<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	$p.getFrame().show();
};
]]></script>
		<style type="text/css"><![CDATA[
		.sub_contents{min-height:calc(100vh - 180px);}
		]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" class="sub_contents">
			<xf:group id="" class="box res_tab_cont">
				<w2:tabControl confirmTrueAction="exist" confirmFalseAction="new" useTabKeyOnly="true" useMoveNextTabFocus="false" useConfirmMessage="false" alwaysDraw="false" id="resDetailManagerTabs" class="topfix">
					<w2:tabs disabled="false" id="tabs1" label="예약정보"></w2:tabs>
					<w2:tabs disabled="false" id="tabs2" label="출발고객"></w2:tabs>
					<w2:tabs disabled="false" id="tabs3" label="매출현황"></w2:tabs>
					<w2:tabs disabled="false" id="tabs4" label="결제내역"></w2:tabs>
					<w2:tabs disabled="false" id="tabs6" label="여행자계약서"></w2:tabs>
					<w2:tabs disabled="false" id="tabs7" label="발송내역"></w2:tabs>
					<w2:tabs disabled="false" id="tabs8" label="전자결재"></w2:tabs>
					<w2:tabs disabled="false" id="tabs9" label="랜드사"></w2:tabs>
					<w2:tabs disabled="false" id="tabs10" label="수배현황"></w2:tabs>
					<w2:content alwaysDraw="false" id="content1"></w2:content>
					<w2:content alwaysDraw="false" id="content2"></w2:content>
					<w2:content alwaysDraw="false" id="content3"></w2:content>
					<w2:content alwaysDraw="false" id="content4"></w2:content>
					<w2:content alwaysDraw="false" id="content6">
						<xf:group id="" class="tab_inner">
							<xf:group tagname="table" style="display:none;" id="afterTb" class="w2tb">
								<xf:group tagname="tr">
									<xf:group tagname="td" class="w2tb_td">
										<xf:group id="" class="ipt_combi select">
											<w2:inputCalendar footerDiv="false" rightAlign="false" focusOnDateSelect="false" id="" placeholder="yyyy-mm-dd" renderDiv="true" calendarValueType="yearMonthDate"></w2:inputCalendar>
										</xf:group>
									</xf:group>
									<xf:group tagname="td" class="w2tb_td">
										<xf:group id="" class="ipt_combi select">
											<w2:inputCalendar footerDiv="false" rightAlign="false" focusOnDateSelect="false" id="" placeholder="yyyy-mm-dd" renderDiv="true" calendarValueType="yearMonthDate"></w2:inputCalendar>
										</xf:group>
									</xf:group>
								</xf:group>
							</xf:group>
						</xf:group>
					</w2:content>
					<w2:content alwaysDraw="false" id="content7"></w2:content>
					<w2:content alwaysDraw="false" id="content8"></w2:content>
					<w2:content alwaysDraw="false" id="content9"></w2:content>
					<w2:content alwaysDraw="false" id="content10"></w2:content>
				</w2:tabControl>
			</xf:group>
		</xf:group>
	</body>
</html>
