<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger16_onclick = function(e) {
	var options = {
		type: "1",
		fileName: "test.xlsx",
		showProcess: true
	};
	gridView1.advancedExcelDownload(options);
};
]]></script>
	</head>
	<body>
	<xf:group id="" style="width:100%;height:100%;background-color:orange;">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" scrollByColumn="false" scrollByColumnAdaptive="false" style="width:500px;height:117px;left:-5px;top:1px;" rowNumVisible="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" style="height:20px;" width="70" inputType="text" value="name1"></w2:column>
					<w2:column id="column3" style="height:20px;" width="70" inputType="text" value="name2"></w2:column>
					<w2:column id="column13" style="height:20px;" width="70" inputType="text" value="name3"></w2:column>
					<w2:column id="column11" style="height:20px;" width="70" inputType="text" value="name4"></w2:column>
					<w2:column id="column9" style="height:20px;" width="70" inputType="text" value="name5"></w2:column>
					<w2:column id="column8" width="70" value="name6"></w2:column>
					<w2:column id="column10" width="70" value="name7"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" width="70" inputType="text"></w2:column>
					<w2:column id="col2" width="70" inputType="text"></w2:column>
					<w2:column id="col3" width="70" inputType="text"></w2:column>
					<w2:column id="col4" width="70" inputType="text"></w2:column>
					<w2:column id="col5" width="70" inputType="text"></w2:column>
					<w2:column id="col6" width="70"></w2:column>
					<w2:column id="col7" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger ev:onclick="scwin.trigger16_onclick" id="trigger16" style="width: 250px;height: 23px;" type="button">
			<xf:label><![CDATA[wframe excel upload]]></xf:label>
		</xf:trigger>
	</xf:group>
	</body>
</html>
