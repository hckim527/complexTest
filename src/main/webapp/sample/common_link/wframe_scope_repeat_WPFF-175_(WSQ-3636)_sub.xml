<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns="">
					<nodeset>
						<data index="0">
							<label>E-mart</label>
							<value>123</value>
						</data>
						<data index="1">
							<label>Homeplus</label>
							<value>456</value>
						</data>
						<data index="2">
							<label>Lottemart</label>
							<value>789</value>
						</data>
					</nodeset>
				</data>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var data = [];
	for (var i = 0; i < 100; i++) {
		data.push(i + "");
		data.push(i + "");
	}
	dataList1.setData(data);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:repeat id="repeat1" style="position: relative;width: 200px;height: 100px;" autoCount="false" cols="1" nodeset="nodeset/data">
			<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" displayMode="label" submenuSize="auto" direction="auto" id="selectbox1" style="position: relative;width: 148px;height: 21px;">
				<xf:choices>
					<xf:itemset nodeset="data:dataList1">
						<xf:label ref="col1"></xf:label>
						<xf:value ref="col2"></xf:value>
					</xf:itemset>
				</xf:choices>
			</xf:select1>
		</xf:repeat>
