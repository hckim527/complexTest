<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dsl_aply_days" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="cd" name="name1" dataType="text"></w2:column>
						<w2:column id="cd_nm" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<cd><![CDATA[MON]]></cd>
							<cd_nm><![CDATA[월]]></cd_nm>
						</w2:row>
						<w2:row>
							<cd><![CDATA[TUE]]></cd>
							<cd_nm><![CDATA[화]]></cd_nm>
						</w2:row>
						<w2:row>
							<cd><![CDATA[WED]]></cd>
							<cd_nm><![CDATA[수]]></cd_nm>
						</w2:row>
						<w2:row>
							<cd><![CDATA[THU]]></cd>
							<cd_nm><![CDATA[목]]></cd_nm>
						</w2:row>
						<w2:row>
							<cd><![CDATA[FRI]]></cd>
							<cd_nm><![CDATA[금]]></cd_nm>
						</w2:row>
						<w2:row>
							<cd><![CDATA[SAT]]></cd>
							<cd_nm><![CDATA[토]]></cd_nm>
						</w2:row>
						<w2:row>
							<cd><![CDATA[SUN]]></cd>
							<cd_nm><![CDATA[일]]></cd_nm>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dst_optr_qrst_rschd" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="title_nm" name="name6" dataType="text"></w2:column>
						<w2:column id="aply_days" name="적용요일" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript"><![CDATA[
scwin.btn_grdAddOptrQrstRschd_onclick = function(e) {
	var idx = dst_optr_qrst_rschd.insertRow();
	grd_optrQrstRschd.setFocusedCell(idx, 0, true);
};
]]></script>
	</head>
	<body>
		<w2:gridView dataList="dst_optr_qrst_rschd" defaultCellHeight="20" id="grd_optrQrstRschd" style="width: 500px;height: 150px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column blockSelect="false" id="column3" inputType="text" width="70" value="name1"></w2:column>
					<w2:column blockSelect="false" id="column1" width="70" inputType="text" value="name2"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column blockSelect="false" id="title_nm" inputType="text" width="70"></w2:column>
					<w2:column blockSelect="false" id="aply_days" width="70" inputType="checkcombobox" allOption="" chooseOption="">
						<w2:choices>
							<w2:itemset nodeset="data:dsl_aply_days">
								<w2:label ref="cd_nm"></w2:label>
								<w2:value ref="cd"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger class="btn_grd_add" ev:onclick="scwin.btn_grdAddOptrQrstRschd_onclick" id="btn_grdAddOptrQrstRschd" toolTip="행추가">
		</xf:trigger>
	</body>
</html>
