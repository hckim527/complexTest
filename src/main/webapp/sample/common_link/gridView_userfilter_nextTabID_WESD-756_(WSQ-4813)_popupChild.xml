<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var paramData = $p.getParameter("paramObj");
    var id = paramData.id;
    var name = paramData.name;
    ibx_custId.setValue(id);
    ibx_custName.setValue(name);
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="">
			<xf:group id="" style="position: absolute;width: 300px">
				<w2:textbox style="width: 150px;height: 23px;float: left;" id="tbx_id" label="아이디"></w2:textbox>
				<xf:input adjustMaxLength="false" style="width: 144px;height: 21px;float: left;" id="ibx_custId"></xf:input>
			</xf:group>
			<xf:group id="" style="position: absolute;top: 30px;width: 300px">
				<w2:textbox style="width: 150px;height: 23px;float: left;" id="tbx_name" label="고객명"></w2:textbox>
				<xf:input adjustMaxLength="false" style="width: 144px;height: 21px;float: left;" id="ibx_custName" nextTabID=""></xf:input>
			</xf:group>
		</xf:group>
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;position: absolute;top: 60px;" defaultCellHeight="20" dataList="data:dataList1" useFilterList="true" filterFocusMode="" nextTabID="ibx_custId" focusFlow="">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column6" value="name1" displayMode="label"></w2:column>
					<w2:column width="88" inputType="text" style="height:20px" id="column5" value="name2" displayMode="label" useFilter="true" closeonmouseleave=""></w2:column>
					<w2:column width="86" inputType="text" style="height:20px" id="column4" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name4" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column width="88" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
					<w2:column width="86" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
