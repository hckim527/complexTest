<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.focusHandler3 = function() {
	window.focusedInput = this.id;
};

scwin.onpageload = function() {
	input1.setValue(input1.id);
	input2.setValue(input2.id);
	input3.setValue(input3.id);
	input4.setValue(input4.id);
};
]]></script>
		<style type="text/css"><![CDATA[
			.focused {
				background-color : #ff6666;
			}
		]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="group1" style="position: relative;width: 520px;height: 296px;padding:20px;background-color:#9933FF">
			<xf:input id="input1" style="position: relative;height: 21px;width: 144px;display:block;font-weight:bold;" onFocusClass="focused" nextTabID="input3" nextTabScope="wframe1_wframe1" ev:onfocus="scwin.focusHandler3"></xf:input>
			<xf:input id="input2" style="position: relative;height: 21px;width: 144px;display:block;font-weight:bold;" onFocusClass="focused" nextTabID="input4" nextTabScope="wframe1_wframe1" ev:onfocus="scwin.focusHandler3"></xf:input>
			<xf:input id="input3" style="position: relative;height: 21px;width: 144px;display:block;font-weight:bold;" onFocusClass="focused" nextTabID="input2" nextTabScope="wframe1_wframe1" ev:onfocus="scwin.focusHandler3"></xf:input>
			<xf:input id="input4" style="position: relative;height: 21px;width: 144px;display:block;font-weight:bold;" onFocusClass="focused" nextTabID="input1" nextTabScope="" ev:onfocus="scwin.focusHandler3"></xf:input>
		</xf:group>
	</body>
</html>
