<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
		xmlns:xf="http://www.w3.org/2002/xforms">
		<head>
				<w2:type>DEFAULT</w2:type>
				<w2:buildDate />
				<xf:model>
						<xf:instance>
								<data xmlns="" />
						</xf:instance>
						<w2:dataCollection baseNode="map">
								<w2:dataList baseNode="list" repeatNode="map" id="dlList3" saveRemovedData="true">
										<w2:columnInfo>
												<w2:column id="col1" name="name1" dataType="text"></w2:column>
												<w2:column id="col2" name="name2" dataType="text"></w2:column>
												<w2:column id="col3" name="name3" dataType="text"></w2:column>
												<w2:column id="col4" name="name4" dataType="text"></w2:column>
										</w2:columnInfo>
								</w2:dataList>
								<w2:dataList baseNode="list" repeatNode="map" id="dlList4" saveRemovedData="true">
										<w2:columnInfo>
												<w2:column id="col1" name="name1" dataType="text"></w2:column>
												<w2:column id="col2" name="name2" dataType="text"></w2:column>
												<w2:column id="col3" name="name3" dataType="text"></w2:column>
												<w2:column id="col4" name="name4" dataType="text"></w2:column>
										</w2:columnInfo>
								</w2:dataList>
						</w2:dataCollection>
				</xf:model>
				<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var rows = [];
	for (var i = 0; i < 10; i++) rows.push({ "col1": "1", "col2": "2" });
	dlList3.setJSON(rows);
	dlList4.setJSON(rows);
};
]]></script>
		</head>
		<body ev:onpageload="scwin.onpageload">
				<xf:group class="wrap" id="">
					<w2:gridView id="grdList3" style="width: 100%;height: 200px;" dataList="data:dlList3" autoFit="none"
						rowStatusVisible="true" class="cm_grid edit"
						visibleRowNum="5" syncScroll="true"
						syncScrollId="grdList4">
						<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
						<w2:header id="header1">
							<w2:row id="row3">
								<w2:column width="100" inputType="text" id="column2" value="col1"
									displayMode="label">
								</w2:column>
								<w2:column width="100" inputType="text" id="column4" value="col2"
									displayMode="label">
								</w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody style="height:20px" id="gBody1">
							<w2:row id="row2">
								<w2:column width="70" inputType="text" id="col1"
									displayMode="label">
								</w2:column>
								<w2:column width="70" inputType="text" id="col2"
									displayMode="label">
								</w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
					<w2:gridView autoFit="none" class="cm_grid edit" dataList="data:dlList4"
						id="grdList4" rowStatusVisible="true" style="width: 100%;height: 200px;" visibleRowNum="5">
						<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
						<w2:header id="header1">
							<w2:row id="row3">
								<w2:column displayMode="label" id="column2" inputType="text"
									value="col1" width="100">
								</w2:column>
								<w2:column displayMode="label" id="column4" inputType="text"
									value="col2" width="100">
								</w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="gBody1" style="height:20px">
							<w2:row id="row2">
								<w2:column displayMode="label" id="col1" inputType="text"
									width="70">
								</w2:column>
								<w2:column displayMode="label" id="col2" inputType="text"
									width="70">
								</w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>
		</body>
</html> 