		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	input1.setValue(input1.id);
	input2.setValue(input2.id);
	input3.setValue(input3.id);
};
]]></script>
		<style type="text/css"><![CDATA[
			.focused {
				background-color : #ff6666;
			}
		]]></style>
		<w2:require src="/sample/common_link/wframe_udc_SKT-422_(WSQ-1047)_autoFocus2_udc.xml"></w2:require>
