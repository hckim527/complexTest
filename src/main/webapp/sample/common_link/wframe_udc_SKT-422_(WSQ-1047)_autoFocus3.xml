	<body ev:onpageload="scwin.onpageload" firstTabID="input2">
		<xf:group id="group1" style="position: relative;width: 520px;height: 426px;padding:20px;background-color:#9933FF;">
			<xf:input id="input1" style="position: relative;height: 21px;width: 144px;display:block;font-weight:bold;" onFocusClass="focused" nextTabID="inputCalendar1"></xf:input>
			<xf:input id="input2" style="position: relative;height: 21px;width: 144px;display:block;font-weight:bold;" onFocusClass="focused" nextTabID="input3"></xf:input>
