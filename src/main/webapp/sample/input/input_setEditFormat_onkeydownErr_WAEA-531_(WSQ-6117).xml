<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.inputbox00_onkeydown = function(e) {
	console.log("*********inputbox00_onkeydown********** key:" + e.key);
};

scwin.trigger00_onclick = function(e) {
	inputbox00.setEditFormat("##_##");
};
]]></script>
	</head>
	<body>
		<xf:input id="inputbox00" style="width: 144px;height: 21px;" ev:onkeydown="scwin.inputbox00_onkeydown" editFormat="###-###"></xf:input>
		<xf:trigger type="button" id="trigger00" style="width:97px;height:23px;" ev:onclick="scwin.trigger00_onclick">
			<xf:label><![CDATA[setEditFormat]]></xf:label>
		</xf:trigger>
	</body>
</html>
