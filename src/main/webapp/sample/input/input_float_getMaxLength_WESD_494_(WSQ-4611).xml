<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="false">
						<key1></key1>
					</w2:data></w2:dataMap>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
		scwin.onpageload = function() {
			input1.setValue("12345678.24");
		};
		scwin.trigger1_onclick = function() {
			var maxLen = input1.getMaxLength()
			localStorage.setItem('log', maxLen);
		};
		scwin.checkVal = function(){
			return localStorage.getItem('log') == 8.2;
		}
		localStorage.removeItem("log");
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="margin-top:100px;">
			<xf:input id="input1" style="width: 144px;height: 21px;float:left;margin-right:20px;" validateOnInput="true" floatNumber="true"
				ref="data:dataMap1.key1" maxLength="8.2" maxByteLength="" dataType="number" numberMask="#,###.##" displayFormat="#,###.##" customModelFormatter="customModelFormatter"
				customModelUnformatter="customModelUnformatter" applyFormat="all">
			</xf:input>
			<xf:trigger type="button" id="trigger1" style="height: 23px;margin-right:5px;" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[input.getMaxLength]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
