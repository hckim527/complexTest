<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	input2.setPlaceholder("API");
};

scwin.checkPlaceHolder = function() {
	return ((j) => j.length ? j : $('#mf_input1'))($('#input1')).attr("placeholder") == "프로퍼티" && ((j) => j.length ? j : $('#mf_input2'))($('#input2')).attr("placeholder") == "API";
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:input id="input1" style="position: absolute;width: 144px;height: 21px;" placeholder="프로퍼티"></xf:input>
		<xf:input id="input2" style="position: absolute;width: 144px;height: 21px;left:2px;top:44px;"></xf:input>
	</body>
</html>
