<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	window.log1 = undefined;
	window.log = undefined;
};

scwin.invaildFn = function(a, b) {
	this.getType();
};

scwin.trigger1_onclick = function(e) {
	var obj = WebSquare.util.getChildren("", {
		excludePlugin: "group trigger"
	});
	log1 = obj[1].validate();
};

scwin.trigger2_onclick = function(e) {
	var obj = WebSquare.util.getChildren("", {
		excludePlugin: "group trigger"
	});
	log = obj[0].validate();
};

scwin.trigger3_onclick = function(e) {
	input1.setValue("1234567.90");
};

scwin.trigger4_onclick = function(e) {
	input2.setValue("12345678");
};

scwin.checkVal1 = function() {
	return log == false;
};

scwin.checkVal2 = function() {
	return log1 == false;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="width:110px;height:25px;position: absolute;left:247px;top:332px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[4번 number check]]></xf:label>
		</xf:trigger>
		<xf:input applyFormat="" invalidMessageFunc="scwin.invaildFn" fireEventOnInvalid="" displayFormat="#,###.#0" id="input1" dataType="float" maxlength="4.2"
			style="position: absolute;width:270px;height:58px;left:26px;top:141px;font-size:12pt;">
		</xf:input>
		<xf:input id="input2" style="position: absolute;width:270px;height:59px;left:25px;top:208px;" maxlength="6" dataType="number" maxByteLength="6"
			invalidMessageFunc="scwin.invaildFn">
		</xf:input>
		<xf:trigger type="button" id="trigger2" style="width:110px;height:25px;position: absolute;left:27px;top:332px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[3번 float check]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger3" style="position: absolute;width:216px;height:26px;left:26px;top:291px;" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[1번 input1.setValue("1234567.90");]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger4" style="position: absolute;width:207px;height:30px;left:246px;top:289px;" ev:onclick="scwin.trigger4_onclick">
			<xf:label><![CDATA[2번 input2.setValue("12345678");]]></xf:label>
		</xf:trigger>
	</body>
</html>
