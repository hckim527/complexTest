<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	window.log = "";
	window.log1 = "";
};

scwin.trigger1_onclick = function(e) {
	log = input1.getFormattedValue();
};

scwin.trigger4_onclick = function(e) {
	log1 = secret1.getFormattedValue();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
	<xf:group id="group1" style="height:104px;width:500px;">
		<xf:input id="input1" style="width: 144px;height: 21px;" placeholder="입력하세요"></xf:input>
		<xf:trigger id="trigger1" style="width:145px;height:23px;" ev:onclick="scwin.trigger1_onclick" type="button">
			<xf:label><![CDATA[getFormattedValue]]></xf:label>
		</xf:trigger>
		<xf:textarea id="textarea1" style="width: 300px;height: 100px;" placeholder="입력하세요"></xf:textarea>
		<xf:secret id="secret1" style="width: 144px;height: 21px;" placeholder="입력하세요"></xf:secret>
		<xf:trigger type="button" id="trigger4" style="width:145px;height:23px;" ev:onclick="scwin.trigger4_onclick">
			<xf:label><![CDATA[getFormattedValue]]></xf:label>
		</xf:trigger>
	</xf:group>
	</body>
</html>
