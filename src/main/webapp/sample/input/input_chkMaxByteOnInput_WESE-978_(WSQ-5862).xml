<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map" />
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
]]></script>
	</head>
	<body>
		<xf:group style="width:400px;height: 80px">
			<w2:textbox label="maxByteLength(기존)" style="width:179px;height:15px;"></w2:textbox>
			<xf:input applyFormat="display" allowChar="1-9" adjustMaxLength="false" style="width: 144px;height: 21px;" id="input1"
				maxByteLength="10">
			</xf:input>
		</xf:group>
		<xf:group style="width:400px;height: 80px;">
			<w2:textbox label="checkMaxByteOnInput" style="width: 150px;height: 23px;"></w2:textbox>
			<xf:input adjustMaxLength="false" style="width: 144px;height: 21px;" id="input2" applyFormat="all" allowChar="1-9"
				checkMaxByteOnInput="true" maxByteLength="10">
			</xf:input>
		</xf:group>
