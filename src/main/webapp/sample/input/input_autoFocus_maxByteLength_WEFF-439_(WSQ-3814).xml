<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var data2 = [];
	for (var i = 0; i < 10; i++) {
		for (var j = 0; j < 4; j++) {
			data2.push(i * 4 + j);
		}
	}
	dataList2.setData(data2);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group tagname="table" id="table2" style="width:600px;" class="w2tb">
			<w2:attributes>
				<w2:summary></w2:summary>
			</w2:attributes>
			<xf:group tagname="caption"></xf:group>
			<xf:group tagname="colgroup">
				<xf:group style="width:25.00%;" tagname="col"></xf:group>
				<xf:group style="width:25.00%" tagname="col"></xf:group>
				<xf:group style="width:25.00%;" tagname="col"></xf:group>
				<xf:group style="width:25.00%" tagname="col"></xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group class="w2tb_th" tagname="th">
					input1
					<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes>
				</xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<xf:input adjustMaxLength="false" id="input1" style="width:135px;height:21px;" nextTabID="input2" maxlength="" autoFocus="true" maxByteLength="6"></xf:input>
				</xf:group>
				<xf:group class="w2tb_th" tagname="th">input2&amp;nbsp;(disabled)<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes></xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<xf:input adjustMaxLength="false" id="input2" style="width:135px;height: 21px;" nextTabID="selectbox2" disabled="true" autoFocus="true" maxByteLength="6" validateOnInput="true"></xf:input>
				</xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group class="w2tb_th" tagname="th">
					selectbox1
					<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes>
				</xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" chooseOption="" allOption="" submenuSize="auto"
						direction="auto" id="selectbox2" style="width:135px;height: 21px;" disabled="false" ref="" nextTabID="selectbox3" keyMoveListSync="true">
						<xf:choices>
							<xf:itemset nodeset="data:dataList2">
								<xf:label ref="col1"></xf:label>
								<xf:value ref="col2"></xf:value>
							</xf:itemset>
						</xf:choices>
					</xf:select1>
				</xf:group>
				<xf:group class="w2tb_th" tagname="th">
					selectbox2
					<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes>
				</xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" chooseOption="" allOption="" submenuSize="auto"
						direction="auto" id="selectbox3" style="width:135px;height: 21px;" disabled="false" ref="" nextTabID="trigger3" keyMoveListSync="true">
						<xf:choices>
							<xf:itemset nodeset="data:dataList2">
								<xf:label ref="col1"></xf:label>
								<xf:value ref="col2"></xf:value>
							</xf:itemset>
						</xf:choices>
					</xf:select1>
				</xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group class="w2tb_th" tagname="th">
					button
					<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes>
				</xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<xf:trigger type="button" id="trigger3" style="width: 120px;height: 21px;" nextTabID="inputCalendar1">
						<xf:label><![CDATA[button]]></xf:label>
					</xf:trigger>
				</xf:group>
				<xf:group class="w2tb_th" tagname="th">
					inputCalendar1
					<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes>
				</xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<w2:inputCalendar rightAlign="false" calendarValueType="yearMonthDate" renderType="component" id="inputCalendar1"
						renderDiv="true" style="width:130px;height: 23px;" focusOnDateSelect="false" footerDiv="false" nextTabID="inputCalendar2" autoFocus="true">
					</w2:inputCalendar>
				</xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group class="w2tb_th" tagname="th">
					inputCalendar2
					<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes>
				</xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<w2:inputCalendar rightAlign="false" calendarValueType="yearMonthDate" renderType="component" id="inputCalendar2"
						renderDiv="true" style="width:130px;height: 23px;" focusOnDateSelect="false" footerDiv="false" nextTabID="input3" autoFocus="true">
					</w2:inputCalendar>
				</xf:group>
				<xf:group class="w2tb_th" tagname="th">input4(number)<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes></xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<xf:input adjustMaxLength="false" id="input3" style="width:135px;height: 21px;" nextTabID="gridView1" maxlength="" autoFocus="true" maxByteLength="6" dataType="number" validateOnInput="true"></xf:input>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
