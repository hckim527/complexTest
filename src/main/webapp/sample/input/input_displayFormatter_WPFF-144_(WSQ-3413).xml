<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	input1.setValue("inputValue");
};

scwin.fn_formatter2 = function(data) {
	return data + "_test2";
};

scwin.fn_formatter = function(data) {
	return data + "_test1";
};

scwin.trigger1_onclick = function(e) {
	input1.setDisplayFormatter(scwin.fn_formatter);
};

scwin.trigger2_onclick = function(e) {
	input1.setDisplayFormatter(scwin.fn_formatter2);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:input id="input1" style="position: absolute ;left: 79px;top: 64px;width: 125px;height: 41px;"></xf:input>
		<xf:trigger type="button" id="trigger1" style="position: absolute ;left:254px;top:65px;width:185px;height:36px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[input.setDisplayFormat]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position: absolute ;left:254px;top:113px;width:185px;height:36px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[input.setDisplayFormat2]]></xf:label>
		</xf:trigger>
	</body>
</html>
