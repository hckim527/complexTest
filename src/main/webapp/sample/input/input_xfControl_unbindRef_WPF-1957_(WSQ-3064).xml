<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="col1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataMap1.setJSON({ "col1": "test" });
};

scwin.setCount = 1;

scwin.trigger1_onclick = function(e) {
	scwin.setCount++;
	dataMap1.setJSON({ "col1": "test" + scwin.setCount + scwin.setCount });
	tbx_data.setValue(dataMap1.get("col1"));
};

scwin.trigger2_onclick = function(e) {
	input.unbindRef();
};

scwin.trigger3_onclick = function(e) {
	tbx_data.setValue(dataMap1.get("col1"));
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:input id="input" style="width:300px;height:30px;" ref="data:dataMap1.col1"></xf:input>
		<xf:trigger type="button" id="trigger2" style="width:195px;height:30px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[input.unbindRef()]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger1" style="width:195px;height:30px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[dataMap1.setJSON()]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger3" style="width:195px;height:30px;" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[dataMap1.get()]]></xf:label>
		</xf:trigger>
		<w2:textbox id="tbx_data" label="" style="display:block;"></w2:textbox>
	</body>
</html>
