<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection>
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="col1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.btn_setEdit_onclick = function(e) {
	input1.setEditFormat("######-#######");
};
scwin.getErrorLog = function() {
	var temp = WebSquare.logger.getLog();
	return temp.indexOf("Cannot read properties of undefined") == -1;
}
]]></script>
	</head>
	<body>
		<xf:group tagname="fieldset" style="height:40px;border:1px solid red;">
			<legend>input1 editFormat = ""</legend>
			<xf:input id="input1" style="width:158px;height:21px;" dataType="text" ref="data:dataMap1.col1"></xf:input>
		</xf:group>
		<xf:group>
			<xf:trigger type="button" id="btn_setEdit" style="width:300px;height:23px;" ev:onclick="scwin.btn_setEdit_onclick">
				<xf:label><![CDATA[input1 setEditFormat 적용]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
