<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	var value = input1.getValue();
	var value2 = searchbox1.getValue();
	localStorage.setItem("log", value + value2);
};
scwin.checkVal = function() {
	return localStorage.getItem('log') == '12341234';
}
localStorage.removeItem("log");
]]></script>
	</head>
	<body>
		<xf:input id="input1" style="width:200px;height:39px;" displayFormat="#,###" dataType="number" maskFormat="reverse" maskFormatModelExcludeCharValue="true" maskFormatModelExcludeChar=",">
		</xf:input>
		<w2:searchbox adjustMaxLength="false" id="searchbox1" style="width:200px;height:39px;" displayFormat="#,###" dataType="number" maskFormat="reverse" maskFormatModelExcludeCharValue="true" maskFormatModelExcludeChar=",">
		</w2:searchbox>
		<xf:trigger type="button" style="width: 80px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[getValue]]></xf:label>
		</xf:trigger>
	</body>
</html>
