<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true" initRowPosition="0">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{
		"col1" : " test text ",
		"col2" : " test text ",
		"col3" : " test text "
	}]
	dataList1.setJSON(jsonData)
};
scwin.checkVal1 = function(){
	return ((j) => j.length ? j : $('#mf_input1'))($('#input1')).val() == 'test text ';
}
scwin.checkVal2 = function(){
	return ((j) => j.length ? j : $('#mf_input2'))($('#input2')).val() == ' test text';
}
scwin.checkVal3 = function(){
	return ((j) => j.length ? j : $('#mf_input3'))($('#input3')).val() == 'test text';
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding:20px;">
			<xf:input ltrim="true" id="input1" style="width: 144px;height: 21px;" ref="data:dataList1.col1"></xf:input>
			<xf:input rtrim="true" id="input2" style="width: 144px;height: 21px;" ref="data:dataList1.col2"></xf:input>
			<xf:input trim="true" id="input3" style="width: 144px;height: 21px;" ref="data:dataList1.col3"></xf:input>
		</xf:group>
	</body>
</html>
