<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.invalidCount = 0;
scwin.invaildFn = function(a, b) {
	scwin.invalidCount++;
};
scwin.trigger1_onclick = function(e) {
	txt_result.setValue("number:" + input2.validate() + "/" + scwin.invalidCount);
};
scwin.trigger2_onclick = function(e) {
	txt_result.setValue("float:" + input1.validate() + "/" + scwin.invalidCount);
};
]]></script>
	</head>
	<body>
		<xf:group style="height:40px;">
			<w2:textbox label="dataType : float, maxLength : 4.2" style="width:260px;height:23px;"></w2:textbox>
			<xf:input invalidMessageFunc="scwin.invaildFn" displayFormat="#,###.#0" id="input1" dataType="float" maxlength="4.2"
				style="width:270px;height:23px;">
			</xf:input>
		</xf:group>
		<xf:group style="height:40px;">
			<w2:textbox label="maxLength : 6" style="width:260px;height:23px;"></w2:textbox>
			<xf:input adjustMaxLength="false" id="input2" style="width:270px;height:23px;" maxlength="6" invalidMessageFunc="scwin.invaildFn"></xf:input>
		</xf:group>
		<xf:trigger type="button" id="trigger1" style="width:80px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[number]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width:80px;height:23px;" type="button">
			<xf:label><![CDATA[float]]></xf:label>
		</xf:trigger>
		<w2:textbox id="txt_result" label="" style="width:300px;height:23px;"></w2:textbox>
	</body>
</html>
