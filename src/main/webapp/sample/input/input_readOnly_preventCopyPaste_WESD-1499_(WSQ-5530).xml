<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function (e) {
	input1.setValue("preventCopyPaste = 'true'");
	input2.setValue("preventCopyPaste = 'true'");
};
]]></script>
	</head>
	<body>
		<xf:input adjustMaxLength="false" id="input1" style="position:absolute; top:53px; left:52px; width:144px; height:21px; "
			preventCopyPaste="true" readOnly="true" disabled="true">
		</xf:input>
		<xf:input adjustMaxLength="false" id="input2" style="position:absolute; top:93px; left:52px; width:144px; height:21px;" preventCopyPaste="true" readOnly="true"></xf:input>
		<xf:trigger type="button" id="trigger1" style="position:absolute; top:51px; left:252px; width:80px; height:23px; "
			ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setValue()]]></xf:label>
		</xf:trigger>
	</body>
</html>
