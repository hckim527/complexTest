<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:config>
			<WebSquare>
				<input>
					<focusStyle value=""/>
					<dateMask value="yyyy-MM-dd"/>
					<timeMask value="HH:mm"/>
					<focusCalcSize value="false"/>
					<dataType valueType="number">
						<displayFormat defaultValue="####,####.##"/>
					</dataType>
				</input>
			</WebSquare>
		</w2:config>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.checkValue = function(id, value) {
	var el = document.getElementById($p.id + id) || document.getElementById(id);
	return el.value == value;
};
]]></script>
	</head>
	<body>
		<xf:input id="input1" style="position: relative;width: 144px;height: 21px;" placeholder="입력해주세요" dataType="number"></xf:input>
	</body>
</html>
