<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	var refreshFlag = radio1.getValue();
	if (refreshFlag == "true") {
		selectbox1.addItem("444", "ddd", 4, true);
	} else if (refreshFlag == "false") {
		selectbox1.addItem("444", "ddd", 4, false);
	} else {
		selectbox1.addItem("444", "ddd", 4);
	}
	textarea2.setValue(WebSquare.xml.indent(dataList1.getAllXML()));
};

scwin.checkVal = function() {
	let ccc = (document.getElementById('textarea2') || document.getElementById('mf_textarea2')).value.indexOf('ccc');
	let ddd = (document.getElementById('textarea2') || document.getElementById('mf_textarea2')).value.indexOf('ddd');
	return ccc < ddd;
};


scwin.onpageload = function() {
	dataList1.setData(['aaa', '111', 'bbb', '222', 'ccc', '333']);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="group1" style="height:71px;">
			<xf:select1 id="radio1" selectedIndex="1" appearance="full" style="width:229px;height:51px;">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[Refresh true]]></xf:label>
						<xf:value><![CDATA[true]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[Refresh false]]></xf:label>
						<xf:value><![CDATA[false]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:select1>
			<xf:trigger id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick" type="button">
				<xf:label><![CDATA[addItem]]></xf:label>
			</xf:trigger>
		</xf:group>
		<xf:group id="group2" style="height:23px;">
			<xf:select1 appearance="minimal" displayMode="label" selectedData="true" optionOrder="false" id="selectbox1" style="width: 148px;height: 21px;">
				<xf:choices>
					<xf:itemset nodeset="data:dataList1">
						<xf:label ref="label"></xf:label>
						<xf:value ref="value"></xf:value>
					</xf:itemset>
				</xf:choices>
			</xf:select1>
		</xf:group>
		<xf:textarea id="textarea2" style="width:341px;height:323px;"></xf:textarea>
	</body>
</html>
