<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.btn_onclick = function(e) {
	sbx_1.setSelectedIndex(1);
	sbx_2.setSelectedIndex(1);
	sbx_3.setSelectedIndex(1);
};

scwin.checkVal = function() {
	return ((j) => j.length ? j : $('#mf_sbx_3'))($('#sbx_3')).height() > 10;
};
]]></script>
	</head>
	<body>
		<xf:select1 appearance="minimal" displayMode="value delim label" id="sbx_1" style="width:15.91%;">
			<xf:choices>
				<xf:item>
					<xf:label><![CDATA[가]]></xf:label>
					<xf:value><![CDATA[1]]></xf:value>
				</xf:item>
				<xf:item>
					<xf:label><![CDATA[나]]></xf:label>
					<xf:value><![CDATA[2]]></xf:value>
				</xf:item>
			</xf:choices>
		</xf:select1>
		<xf:trigger type="button" style="width:80px;height:23px;" id="btn" ev:onclick="scwin.btn_onclick">
			<xf:label><![CDATA[목록선택]]></xf:label>
		</xf:trigger>
		<!-- btn2 는 TSCP 가 쓰는 tabControl 자동 id(wq_uuid_4) 번호를 맞추기 위해 유지 -->
		<xf:trigger id="btn2" style="width:80px;height:23px;" type="button">
			<xf:label><![CDATA[값확인]]></xf:label>
		</xf:trigger>
		<w2:tabControl alwaysDraw="false" class="sub_tbc" id="" useTabKeyOnly="true">
			<w2:tabs id="tabs1" label="탭1"></w2:tabs>
			<w2:tabs id="tabs2" label="탭2"></w2:tabs>
			<w2:content alwaysDraw="false" id="content3">
				<xf:select1 appearance="minimal" displayMode="value delim label" id="sbx_2" style="width:15.91%;">
					<xf:choices>
						<xf:item>
							<xf:label><![CDATA[가]]></xf:label>
							<xf:value><![CDATA[1]]></xf:value>
						</xf:item>
						<xf:item>
							<xf:label><![CDATA[나]]></xf:label>
							<xf:value><![CDATA[2]]></xf:value>
						</xf:item>
					</xf:choices>
				</xf:select1>
			</w2:content>
			<w2:content alwaysDraw="false" id="content5" style="height:49px;">
				<xf:select1 appearance="minimal" displayMode="value delim label" id="sbx_3" style="width:15.91%;">
					<xf:choices>
						<xf:item>
							<xf:label><![CDATA[가]]></xf:label>
							<xf:value><![CDATA[1]]></xf:value>
						</xf:item>
						<xf:item>
							<xf:label><![CDATA[나]]></xf:label>
							<xf:value><![CDATA[2]]></xf:value>
						</xf:item>
					</xf:choices>
				</xf:select1>
			</w2:content>
		</w2:tabControl>
	</body>
</html>
