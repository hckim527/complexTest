<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
	</head>
	<body>
		<xf:group tagname="table" style="width:724px;" id="" class="w2tb">
			<xf:group tagname="colgroup">
				<xf:group tagname="col" style="width:130px;"></xf:group>
				<xf:group tagname="col" style="width:370px;"></xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group tagname="th" class="w2tb_th">component<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes></xf:group>
				<xf:group tagname="td" class="w2tb_td">
					<xf:input id="" style="width: 144px;height: 21px;"></xf:input>
					<xf:select1 id="sel1" style="width: 148px;height: 21px;"
						disabled="true" appearance="minimal" renderType="component">
					</xf:select1>
				</xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group tagname="th" class="w2tb_th">native<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes></xf:group>
				<xf:group tagname="td" class="w2tb_td">
					<w2:inputCalendar id="" style="width: 150px;height: 23px;" renderDiv="true"
						calendarValueType="yearMonthDate" renderType="component">
					</w2:inputCalendar>
					<xf:select1 id="sel2" style="width: 148px;height: 21px;"
						disabled="true" appearance="minimal" renderType="native">
					</xf:select1>
				</xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group tagname="th" class="w2tb_th">select<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes></xf:group>
				<xf:group tagname="td" class="w2tb_td">
					<xf:input id="" style="width: 144px;height: 21px;"></xf:input>
					<xf:select1 id="sel3" style="width: 148px;height: 21px;"
						disabled="true" appearance="minimal" renderType="select">
					</xf:select1>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
