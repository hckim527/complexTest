<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="codeList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="code" name="name1" dataType="text"></w2:column>
						<w2:column id="label" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		codeList1.setData(["code1", "label1", "code2", "label2", "code3", "label3", "code4", "label4"]);
	};

	scwin.selectCustom = function(itemArr) {
		var customArr = itemArr;
		return customArr;
	};

	scwin.selectLabelCustom = function(label, value, isOpen) {
		if (isOpen) {
			return label + " " + value;
		} else {
			return value;
		}
	};
	]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" submenuSize="auto" direction="auto" id="selectbox1"
			style="position: relative;width: 148px;height: 21px;margin-left:10px;margin-top:10px;" displayMode="value delim label"
			customFormatter="scwin.selectCustom" customLabelFormatter="scwin.selectLabelCustom">
			<xf:choices>
				<xf:itemset nodeset="data:codeList1">
					<xf:label ref="label"></xf:label>
					<xf:value ref="code"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
	</body>
</html>
