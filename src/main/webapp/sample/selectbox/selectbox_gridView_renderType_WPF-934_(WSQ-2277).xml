<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dl_select1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dl_select2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
						<w2:column id="select1_value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:linkedDataList id="linkedDataList1" bind="dl_select2">
					<w2:condition type="filter"><![CDATA[select1_value==val("selectbox1")]]></w2:condition>
					<w2:condition type="sort"></w2:condition>
				</w2:linkedDataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	log = "selectbox2 value : " + selectbox2.getValue() + "selectbox2 getSelectedIndex ==: " + selectbox2.getSelectedIndex();
};
scwin.trigger3_onclick = function(e) {
	log1 = "selectbox4 value : " + selectbox4.getValue() + "selectbox4 getSelectedIndex ==: " + selectbox4.getSelectedIndex();
};
scwin.onpageload = function() {
	window.jsonData1 = [{
		"label": "a1",
		"value": "a1"
	}, {
		"label": "a2",
		"value": "a2"
	}, {
		"label": "a3",
		"value": "a3"
	}];
	window.jsonData2 = [{
			"label": "a1_b1",
			"value": "b1",
			"select1_value": "a1"
		}, {
			"label": "a1_b2",
			"value": "b2",
			"select1_value": "a1"
		},
		{
			"label": "a1_b3",
			"value": "b3",
			"select1_value": "a1"
		}, {
			"label": "a2_b4",
			"value": "b4",
			"select1_value": "a2"
		}
	];
	dl_select1.setJSON(jsonData1);
	dl_select2.setJSON(jsonData2);
	window.log;
	window.log1;
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" direction="auto" id="selectbox1"
			style="position:absolute;left:28px;top:73px;width: 148px;height: 21px;" displayMode="label" optionOrder="false"
			disabled="false" submenuSize="auto">
			<xf:choices>
				<xf:itemset nodeset="data:dl_select1">
					<xf:label ref="label"></xf:label>
					<xf:value ref="value"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
		<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" direction="auto" id="selectbox2"
			style="position:absolute;left:234px;top:73px;width: 148px;height: 21px;" displayMode="label" optionOrder="false"
			disabled="false" submenuSize="auto">
			<xf:choices>
				<xf:itemset nodeset="data:linkedDataList1">
					<xf:label ref="label"></xf:label>
					<xf:value ref="value"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
		<xf:trigger type="button" id="trigger1" style="position:absolute;left:30px;top:18px;width: 170px;height: 30px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[selectbox2.getValue / getIndex]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3" style="position:absolute;left:29px;top:128px;width:463px;height:30px;" type="button">
			<xf:label><![CDATA[selectbox4.getValue / getIndex (renderType=select)]]></xf:label>
		</xf:trigger>
		<xf:select1 appearance="minimal" direction="auto" disabled="false" disabledClass="w2selectbox_disabled"
			displayMode="label" id="selectbox4" optionOrder="false" style="position:absolute;left:234px;top:173px;width: 148px;height: 21px;"
			submenuSize="auto" renderType="select">
			<xf:choices>
				<xf:itemset nodeset="data:linkedDataList1">
					<xf:label ref="label"></xf:label>
					<xf:value ref="value"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
	</body>
</html>
