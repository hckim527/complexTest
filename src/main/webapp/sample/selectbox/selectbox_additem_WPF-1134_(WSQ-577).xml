<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[테스트1]]></label>
							<value><![CDATA[1]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[테스트2]]></label>
							<value><![CDATA[2]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[테스트3]]></label>
							<value><![CDATA[3]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="true">
						<key1><![CDATA[2]]></key1>
					</w2:data>
				</w2:dataMap>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	selectBox1.addItem("", "-전체-", 0);
	output2.setValue("addItem 후 count : " + selectBox1.getItemCount());
	selectBox1.setSelectedIndex(0);
	output3.setValue("setSelectedIndex() 후 count : " + selectBox1.getItemCount());
};
scwin.onpageload = function() {
	output1.setValue("최초 count : " + selectBox1.getItemCount());
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:select1 optionOrder="false" id="selectBox1"
			displayMode="label" appearance="minimal"
			style="position: absolute;width: 148px;height: 21px;left:33px;top:33px;margin-top:0px;" ref="data:dataMap1.key1">
			<xf:choices>
				<xf:itemset nodeset="data:dataList1">
					<xf:label ref="label"></xf:label>
					<xf:value ref="value"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
		<xf:trigger type="button" style="position: absolute;width:114px;height:31px;left:206px;top:27px;" id="trigger1"
			ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[addItem]]></xf:label>
		</xf:trigger>
		<xf:output style="position: relative;height:23px;left:31px;top:80px;" id="output1">
			<xf:label></xf:label>
		</xf:output>
		<xf:output id="output2" style="position: relative;height:23px;left:31px;top:80px;margin-top:10px;">
			<xf:label></xf:label>
		</xf:output>
		<xf:output id="output3" style="position: relative;height: 23px;left:31px;top:80px;margin-top:10px;">
			<xf:label></xf:label>
		</xf:output>
	</body>
</html>
