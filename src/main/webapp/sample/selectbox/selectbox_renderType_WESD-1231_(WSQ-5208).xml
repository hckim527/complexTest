					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList3" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="code" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<code><![CDATA[0]]></code>
							<value><![CDATA[native]]></value>
						</w2:row>
						<w2:row>
							<code><![CDATA[1]]></code>
							<value><![CDATA[가]]></value>
						</w2:row>
						<w2:row>
							<code><![CDATA[2]]></code>
							<value><![CDATA[나]]></value>
						</w2:row>
						<w2:row>
							<code><![CDATA[3]]></code>
							<value><![CDATA[다]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.checkVal = function() {
		return (document.getElementById('select1_label') || document.getElementById('mf_select1_label')).getAttribute('style') != 'undefined';
	};
	]]></script>
	</head>
	<body>
		<xf:select1 appearance="minimal" direction="auto" renderType="native" disabledClass="w2selectbox_disabled" id="selectN"
			style="width:163px;height:21px;" submenuSize="auto">
			<xf:choices>
				<xf:itemset nodeset="data:dataList3">
					<xf:label ref="value"></xf:label>
					<xf:value ref="code"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>

		<xf:select1 appearance="minimal" direction="auto" renderType="" disabledClass="w2selectbox_disabled" id="select1"
			style="width:163px;height:21px;" submenuSize="auto">
			<xf:choices>
				<xf:itemset nodeset="data:dataList2">
					<xf:label ref="value"></xf:label>
					<xf:value ref="code"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
