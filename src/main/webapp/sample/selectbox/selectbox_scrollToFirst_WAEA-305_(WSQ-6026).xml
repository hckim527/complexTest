		<xf:group tagname="fieldset" style="font-size:18px;border:1px solid red;">
			<legend>scrollToFirst = true, scroll not exist</legend>
			<xf:select1 id="select3" chooseOption="true" style="width:163px;height:21px;position:relative;" submenuSize="auto" appearance="minimal" disabledClass="" visibleRowNum="4" scrollToFirst="true">
				<xf:choices>
					<xf:itemset nodeset="data:dataList2">
						<xf:label ref="value"></xf:label>
						<xf:value ref="code"></xf:value>
					</xf:itemset>
				</xf:choices>
			</xf:select1>
		</xf:group>
