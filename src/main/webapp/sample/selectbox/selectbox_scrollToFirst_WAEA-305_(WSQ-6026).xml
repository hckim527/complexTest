				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="code" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<code><![CDATA[1]]></code>
							<value><![CDATA[11]]></value>
						</w2:row>
						<w2:row>
							<code><![CDATA[2]]></code>
							<value><![CDATA[22]]></value>
						</w2:row>
						<w2:row>
							<code><![CDATA[3]]></code>
							<value><![CDATA[33]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		select1.setSelectedIndex(5);
		select2.setSelectedIndex(5);
		select3.setSelectedIndex(2);
	};

	scwin.checkVal = function() {
		const offSetTop = 48
		return ((j) => j.length ? j : $('#mf_select1_itemTable_0'))($('#select1_itemTable_0')).offset().top > offSetTop;
	}
	]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group tagname="fieldset" style="font-size:18px;border:1px solid red;">
			<legend>scrollToFirst = true</legend>
			<xf:select1 id="select1" style="width:163px;height:21px;position:relative;" submenuSize="auto" emptyItem="true" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" scrollToFirst="true">
				<xf:choices>
					<xf:itemset nodeset="data:dataList1">
						<xf:label ref="value"></xf:label>
						<xf:value ref="code"></xf:value>
					</xf:itemset>
				</xf:choices>
			</xf:select1>
		</xf:group>
		<xf:group tagname="fieldset" style="font-size:18px;border:1px solid red;">
			<legend>scrollToFirst = false</legend>
			<xf:select1 appearance="minimal" direction="auto" disabledClass="w2selectbox_disabled" id="select2" emptyItem="true" style="width:163px;height:21px;position:relative;" submenuSize="auto">
				<xf:choices>
