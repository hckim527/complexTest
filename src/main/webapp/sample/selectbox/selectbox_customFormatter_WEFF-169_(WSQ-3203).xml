<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[1번]]></label>
							<value><![CDATA[1]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[2번]]></label>
							<value><![CDATA[2]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[3번]]></label>
							<value><![CDATA[3]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[4번]]></label>
							<value><![CDATA[4]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[5번]]></label>
							<value><![CDATA[5]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.labelFormatter = function(itemArr) {
	var customArr = itemArr;
	for (var i = 0; i < itemArr.length; i++) {
		customArr[i].label = itemArr[i].label + " label change";
	}
	return customArr;
};
]]></script>
	</head>
	<body>
		<xf:select1 appearance="minimal" id="selectbox1"
			style="position: absolute;width:296px;height:94px;left:103px;top:87px;" displayMode="label" optionOrder="false" customFormatter="scwin.labelFormatter">
			<xf:choices>
				<xf:itemset nodeset="data:dataList1">
					<xf:label ref="label"></xf:label>
					<xf:value ref="value"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
	</body>
</html>
