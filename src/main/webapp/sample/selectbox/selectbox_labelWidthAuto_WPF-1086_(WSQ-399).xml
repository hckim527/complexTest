<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dc_codeAll">
					<w2:columnInfo>
						<w2:column id="codeType" name="codeType" dataType="text"></w2:column>
						<w2:column id="lbl" name="lbl" dataType="text"></w2:column>
						<w2:column id="code" name="code" dataType="text"></w2:column>
						<w2:column id="rowStatus" name="rowStatus" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data xmlns="" use="true">
						<w2:row>
							<codeType><![CDATA[c01]]></codeType>
							<lbl><![CDATA[남]]></lbl>
							<code><![CDATA[M]]></code>
							<rowStatus><![CDATA[R]]></rowStatus>
						</w2:row>
						<w2:row>
							<codeType><![CDATA[c01]]></codeType>
							<lbl><![CDATA[여]]></lbl>
							<code><![CDATA[F]]></code>
							<rowStatus><![CDATA[R]]></rowStatus>
						</w2:row>
						<w2:row>
							<codeType><![CDATA[c02]]></codeType>
							<lbl><![CDATA[배우]]></lbl>
							<code><![CDATA[001]]></code>
							<rowStatus><![CDATA[R]]></rowStatus>
						</w2:row>
						<w2:row>
							<codeType><![CDATA[c02]]></codeType>
							<lbl><![CDATA[가수]]></lbl>
							<code><![CDATA[002]]></code>
							<rowStatus><![CDATA[R]]></rowStatus>
						</w2:row>
						<w2:row>
							<codeType><![CDATA[c02]]></codeType>
							<lbl><![CDATA[개그맨]]></lbl>
							<code><![CDATA[003]]></code>
							<rowStatus><![CDATA[R]]></rowStatus>
						</w2:row>
						<w2:row>
							<codeType><![CDATA[c02]]></codeType>
							<lbl><![CDATA[운동선수]]></lbl>
							<code><![CDATA[004]]></code>
							<rowStatus><![CDATA[R]]></rowStatus>
						</w2:row>
						<w2:row>
							<codeType><![CDATA[c02]]></codeType>
							<lbl><![CDATA[무직]]></lbl>
							<code><![CDATA[005]]></code>
							<rowStatus><![CDATA[R]]></rowStatus>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:linkedDataList id="dc_test1" bind="dc_codeAll">
					<w2:condition type="filter"><![CDATA[codeType=='c01']]></w2:condition>
					<w2:condition type="sort"><![CDATA[]]></w2:condition>
				</w2:linkedDataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.testBtn1_onclick = function(e) {
	dc_test1.setCondition("filter", 'codeType=="c02"');
};
]]></script>
		<style type="text/css"><![CDATA[
			.dmr{margin-right: 6px;}
		]]></style>
	</head>
	<body>
		<xf:group id="" style="height:23px;margin-bottom: 10px;">
			<xf:select1 labelWidthAuto="true" appearance="minimal"
				class="dmr" displayMode="label" id="ui_test1" style="position: relative;width: 148px;height: 21px;">
				<xf:choices>
					<xf:itemset nodeset="data:dc_test1">
						<xf:label ref="lbl"></xf:label>
						<xf:value ref="code"></xf:value>
					</xf:itemset>
				</xf:choices>
			</xf:select1>
			<xf:trigger id="testBtn1" style="height: 23px;width:120px;" ev:onclick="scwin.testBtn1_onclick" type="button">
				<xf:label><![CDATA[filter 조건 변경]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
