<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list"
					saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dm_search">
					<w2:keyInfo>
						<w2:key id="yearCode" name="해당년도" dataType="text">
						</w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.selectbox1_onchange = function() {
	log = "onchange fired";
};
scwin.selectbox1_onviewchange = function(info) {
	log1 = "onviewchange!";
};
scwin.onpageload = function() {
	setTimeout(function() {
		dataList1.setJSON([{
			"label": "하나",
			"value": "1",
			"rowStatus": "R"
		}, {
			"label": "둘",
			"value": "2",
			"rowStatus": "R"
		}]);
	}, 500);
	window.log = "";
	window.log1 = "";
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:select1
			appearance="minimal" id="selectbox1"
			ref="data:dm_search.yearCode" style="width: 148px;height: 21px;"
			displayMode="label" optionOrder="false" ev:onchange="scwin.selectbox1_onchange" ev:onviewchange="scwin.selectbox1_onviewchange">
			<xf:choices>
				<xf:itemset nodeset="data:dataList1">
					<xf:label ref="label"></xf:label>
					<xf:value ref="value"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
	</body>
</html>
