<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
	window.f = [];
	for (var i = 0; i < 100; i++) {
		f.push(i);
		f.push(i);
	}
	dataList1.setData(f);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="position: relative;padding-top:40px;height:140px;width:700px;">
			<xf:group id="" style="position: relative;height:50%;"></xf:group>
			<xf:group id="" style="position: relative;height:50%;">
				<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" direction="auto" chooseOption="" id="" style="position: relative;width: 148px;height: 21px;" displayMode="label" optionOrder="false" allOption="" disabled="false" submenuSize="auto">
					<xf:choices>
						<xf:itemset nodeset="data:dataList1">
							<xf:label ref="col1"></xf:label>
							<xf:value ref="col2"></xf:value>
						</xf:itemset>
					</xf:choices>
				</xf:select1>
				<w2:autoComplete visibleRowNum="5" chooseOption="" id="" style="position: relative;width: 148px;height: 21px;" search="start" interactionMode="" displayMode="label" useKeywordHighlight="false" submenuSize="auto" editType="select" allOption="">
					<w2:choices>
						<w2:itemset nodeset="data:dataList1">
							<w2:label ref="col1"></w2:label>
							<w2:value ref="col2"></w2:value>
						</w2:itemset>
					</w2:choices>
				</w2:autoComplete>
				<xf:checkcombobox appearance="minimal" direction="auto" chooseOption="" id="" style="position: relative;width: 148px;height: 21px;" displayMode="label" allOption="" submenuSize="auto" disabled="false">
					<xf:choices>
						<xf:itemset nodeset="data:dataList1">
							<xf:label ref="col1"></xf:label>
							<xf:value ref="col2"></xf:value>
						</xf:itemset>
					</xf:choices>
				</xf:checkcombobox>
			</xf:group>
		</xf:group>
	</body>
</html>
