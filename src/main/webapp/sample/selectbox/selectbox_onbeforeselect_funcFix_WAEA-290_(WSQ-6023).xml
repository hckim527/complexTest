<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="code" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[AD.안도라]]></label>
							<code><![CDATA[1]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[AE.아랍에미리트]]></label>
							<code><![CDATA[2]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[AF.아프가니스탄]]></label>
							<code><![CDATA[3]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[AI.앙갈라]]></label>
							<code><![CDATA[4]]></code>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.beforeSelectLog = [];
scwin.select1_onbeforeselect = function (prev, next) {
	scwin.beforeSelectLog.push([prev, next]);
	window.checkVal = "select1 selectedIndex";
	return false;
};

scwin.setVal = function () {
	return select1.setSelectedIndex(1);
};

scwin.checkVal1 = function () {
	return (document.getElementById('mf_select1_label') || document.getElementById('select1_label')).innerText == 'AE.아랍에미리트';
};

scwin.checkVal2 = function () {
	return window.checkVal != 'select1 selectedIndex';
};
]]></script>
	</head>
	<body>
		<w2:select1 editType="select" id="select1" useKeywordHighlight="false" style="width: 148px;" submenuSize="auto" search="start" useLocale="false" allOption="" chooseOption="" chooseOptionLabel="-- 선택 --" ref="" ev:onbeforeselect="scwin.select1_onbeforeselect">
			<w2:choices>
				<w2:itemset nodeset="data:dataList1">
					<w2:label ref="label"></w2:label>
					<w2:value ref="label"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:select1>
	</body>
</html>
