<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="false"></w2:data>
				</w2:dataMap>
				<w2:dataMap baseNode="map" id="dataMap2">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="false"></w2:data>
				</w2:dataMap>
				<w2:dataMap baseNode="map" id="dataMap3">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="false"></w2:data>
				</w2:dataMap>
			<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[1]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[2]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[3]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[4]]></col1>
							<col2><![CDATA[4]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<xf:select1 appearance="minimal" id="select1"
			style="position: relative;width:265px;height:61px;" displayMode="label" optionOrder="false" ref="data:dataMap1.key1" renderType="">
			<xf:choices>
				<xf:itemset nodeset="data:dataList1">
					<xf:label ref="col1"></xf:label>
					<xf:value ref="col2"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
		<xf:select1 appearance="minimal" id="select2"
			style="position: relative;width:265px;height:61px;" displayMode="label" optionOrder="false" ref="data:dataMap2.key1" renderType="select">
			<xf:choices>
				<xf:itemset nodeset="data:dataList1">
					<xf:label ref="col1"></xf:label>
					<xf:value ref="col2"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
		<xf:select1 appearance="minimal" id="select3"
			style="position: relative;width:265px;height:61px;" displayMode="label" optionOrder="false" ref="data:dataMap3.key1" renderType="native">
			<xf:choices>
				<xf:itemset nodeset="data:dataList1">
					<xf:label ref="col1"></xf:label>
					<xf:value ref="col2"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
	</body>
</html>
