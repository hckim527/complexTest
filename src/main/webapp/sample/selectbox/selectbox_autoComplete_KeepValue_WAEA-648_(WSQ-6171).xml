<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="name1"></w2:column>
						<w2:column dataType="text" id="col2" name="name2"></w2:column>
						<w2:column dataType="text" id="col3" name="name2"></w2:column>
						<w2:column dataType="text" id="col6" name="name2"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[0]]></col2>
							<col3><![CDATA[0]]></col3>
							<col6><![CDATA[0]]></col6>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dsCombo">
					<w2:columnInfo>
						<w2:column id="name" dataType="text"></w2:column>
						<w2:column id="val" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<name><![CDATA[가]]></name>
							<val><![CDATA[1]]></val>
						</w2:row>
						<w2:row>
							<name><![CDATA[나]]></name>
							<val><![CDATA[2]]></val>
						</w2:row>
						<w2:row>
							<name><![CDATA[다]]></name>
							<val><![CDATA[3]]></val>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
	dataList1.setRowPosition(0);
};

scwin.autoComplete01_onchange = function (info) {
	console.log("================> autoComplete01_onchange");
};

scwin.autoComplete02_onchange = function (info) {
	console.log("================> autoComplete02_onchange");
};

scwin.autoComplete03_onchange = function (info) {
	console.log("================> autoComplete03_onchange");
};

scwin.sel3_onchange = function (info) {
	console.log("================> sel3_onchange");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_body" class="sub_contents">
			<w2:autoComplete editType="select" id="autoComplete01" style="width:148px;height:21px;position:relative;" ev:onchange="scwin.autoComplete01_onchange" ref="data:dataList1.col1" valueNotInList="keepValue" hideValueWhenNotInList="true" emptyItem="true">
				<w2:choices>
					<w2:itemset nodeset="data:dsCombo">
						<w2:label ref="name"></w2:label>
						<w2:value ref="val"></w2:value>
					</w2:itemset>
				</w2:choices>
			</w2:autoComplete>
			<w2:autoComplete editType="select" id="autoComplete02" style="width:148px;height:21px;position:relative;" ev:onchange="scwin.autoComplete02_onchange" ref="data:dataList1.col2" valueNotInList="keepValue" hideValueWhenNotInList="false" emptyItem="true">
				<w2:choices>
					<w2:itemset nodeset="data:dsCombo">
						<w2:label ref="name"></w2:label>
						<w2:value ref="val"></w2:value>
					</w2:itemset>
				</w2:choices>
			</w2:autoComplete>
			<w2:autoComplete editType="select" id="autoComplete03" style="width:148px;height:21px;position:relative;" ev:onchange="scwin.autoComplete03_onchange" ref="data:dataList1.col3" valueNotInList="keepValue" hideValueWhenNotInList="true" emptyItem="true">
				<w2:choices>
					<w2:itemset nodeset="data:dsCombo">
						<w2:label ref="name"></w2:label>
						<w2:value ref="val"></w2:value>
					</w2:itemset>
				</w2:choices>
			</w2:autoComplete>
		</xf:group>
		<xf:group class="sub_contents">
			<xf:select1 id="sel3" style="width: 148px;height: 21px;" submenuSize="auto" disabled="false" ev:onchange="scwin.sel3_onchange" valueNotInList="keepValue" hideValueWhenNotInList="true" emptyItem="true" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ref="data:dataList1.col6">
				<xf:choices>
					<xf:itemset nodeset="data:dsCombo">
						<xf:label ref="name"></xf:label>
						<xf:value ref="val"></xf:value>
					</xf:itemset>
				</xf:choices>
			</xf:select1>
		</xf:group>
	</body>
</html>
