<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns="">
					<milk>
						<item>
							<name label="choco" value="1"></name>
						</item>
						<item>
							<name label="starwberry" value="2"></name>
						</item>
						<item>
							<name label="banana" value="3"></name>
						</item>
						<item>
							<name label="coffee" value="4"></name>
						</item>
						<item>
							<name label="melon" value="5"></name>
						</item>
					</milk>
				</data>
			</xf:instance>
			<w2:dataCollection>

				<w2:dataList id="dataList1" baseNode="list" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[choco]]></label>
							<value><![CDATA[01]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[strawberry]]></label>
							<value><![CDATA[02]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[banana]]></label>
							<value><![CDATA[03]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[coffee]]></label>
							<value><![CDATA[04]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[melon]]></label>
							<value><![CDATA[05]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<xf:select1 id="selectbox1" displayMode="label"
			style="position: absolute;width: 148px;height: 21px;left:41px;top:200px;" appearance="minimal">
			<xf:choices>
				<w2:gridItemset hideHeader="true" rowMouseOver="" nodeset="data:dataList1" label="label" value="value">
					<w2:item ref="label" hidden="" header="" headerStyle=""></w2:item>
					<w2:item ref="value" hidden="" header="" headerStyle=""></w2:item>
				</w2:gridItemset>
			</xf:choices>
		</xf:select1>
		<xf:select1 id="selectbox2" displayMode="label"
			style="position: absolute;width: 148px;height: 21px;left:208px;top:201px;" appearance="minimal">
			<xf:choices>
				<w2:gridViewItemset hideHeader="true" rowMouseOver="" nodeset="data:dataList1" width="" selectedRowColor="" label="label"
					visibleRowNum="" autoFit="" value="value" rowMouseOverColor="" height="">
					<w2:item ref="label" hidden="" header="" headerStyle=""></w2:item>
					<w2:item ref="value" hidden="" header="" headerStyle=""></w2:item>
				</w2:gridViewItemset>
			</xf:choices>
		</xf:select1>
		<xf:select1 appearance="minimal" displayMode="label"
			style="position:absolute;top:202px;left:375px;width:148px;height:22px;" defaultStyle="text-align:center;vertical-align:middle" id="selectbox3">
			<xf:choices>
				<xf:itemset nodeset="milk/item/name/">
					<xf:label ref="@label"></xf:label>
					<xf:value ref="@value"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
	</body>
</html>
