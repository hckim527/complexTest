<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[item one]]></label>
							<value><![CDATA[1]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[item two]]></label>
							<value><![CDATA[2]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[item three]]></label>
							<value><![CDATA[3]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.fn_itemtooltip = function(label, idx) {
		return label + " is at index " + idx;
	};
	]]></script>
	</head>
	<body>
		<xf:group style="" id="">
			<xf:checkcombobox submenuSize="auto" ref="" accessibility="" chooseOption="" style="width: 148px;height:30px;" disabled="false" id="ccb1"
				allOption="" displayMode="label" direction="auto" tooltipDisplay="true" tooltipShowAlways="true" renderType="native">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[item one]]></xf:label>
						<xf:value><![CDATA[1]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[item two]]></xf:label>
						<xf:value><![CDATA[2]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[item three]]></xf:label>
						<xf:value><![CDATA[3]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:checkcombobox>
		</xf:group>
		<xf:group id="" style="">
			<xf:checkcombobox accessibility="" allOption="" chooseOption="" direction="auto" disabled="false" displayMode="label" id="checkcombobox1" ref=""
				style="width: 148px;height:30px;" submenuSize="auto" tooltipDisplay="true" tooltipShowAlways="true" renderType="componet">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[item one]]></xf:label>
						<xf:value><![CDATA[1]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[item two]]></xf:label>
						<xf:value><![CDATA[2]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[item three]]></xf:label>
						<xf:value><![CDATA[3]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:checkcombobox>
		</xf:group>
		<xf:group id="" style="">
			<xf:checkcombobox accessibility="true" allOption="" chooseOption="" direction="auto" disabled="false" displayMode="label" id="checkcombobox2" ref=""
				renderType="componet" style="width: 148px;height:30px;" submenuSize="auto" tooltipDisplay="true" tooltipShowAlways="true"
				itemTooltipDisplay="true">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[item one]]></xf:label>
						<xf:value><![CDATA[1]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[item two]]></xf:label>
						<xf:value><![CDATA[2]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[item three]]></xf:label>
						<xf:value><![CDATA[3]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:checkcombobox>
		</xf:group>
		<xf:group id="" style="">
			<xf:checkcombobox allOption="" chooseOption="" direction="auto" disabled="false" displayMode="label" id="checkcombobox3" ref=""
				style="width: 148px;height:30px;" submenuSize="auto" itemTooltipDisplay="true" itemTooltipFormatter="scwin.fn_itemtooltip" tooltipTime="0.2">
				<xf:choices>
					<xf:itemset nodeset="data:dataList1">
						<xf:label ref="label"></xf:label>
						<xf:value ref="value"></xf:value>
					</xf:itemset>
				</xf:choices>
			</xf:checkcombobox>
		</xf:group>
	</body>
</html>
