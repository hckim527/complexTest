<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.disabled = false;

scwin.trigger1_onclick = function(e) {
	scwin.disabled = !scwin.disabled;
	group1.setDisabled(scwin.disabled);
};

scwin.getErrorLog = function() {
	let temp = WebSquare.logger.getLog();
	return temp.indexOf("Cannot read properties of null") == -1;
};
]]></script>
	</head>
	<body>
		<xf:group id="group1">
			<xf:group tagname="table" style="width:100%;" id="" class="w2tb">
				<xf:group tagname="colgroup">
					<xf:group tagname="col" style="width:25.00%;"></xf:group>
					<xf:group tagname="col" style="width:25.00%"></xf:group>
					<xf:group tagname="col" style="width:25.00%;"></xf:group>
					<xf:group tagname="col" style="width:25.00%"></xf:group>
				</xf:group>
				<xf:group tagname="tr">
					<xf:group tagname="th" class="w2tb_th">testA</xf:group>
					<xf:group tagname="td" class="w2tb_td">
						<xf:checkcombobox submenuSize="auto" chooseOption="false" style="width:187px;height:18px;" id="checkcombobox1" allOption="false"
							displayMode="label" direction="auto" accessibility="true">
						</xf:checkcombobox>
					</xf:group>
					<xf:group tagname="th" class="w2tb_th">testC</xf:group>
					<xf:group tagname="td" class="w2tb_td">
						<xf:checkcombobox submenuSize="auto" style="width: 148px;height: 21px;" id="checkcombobox2" displayMode="label" direction="auto">
							<xf:choices>
								<xf:item>
									<xf:label><![CDATA[1]]></xf:label>
									<xf:value><![CDATA[]]></xf:value>
								</xf:item>
								<xf:item>
									<xf:label><![CDATA[2]]></xf:label>
									<xf:value><![CDATA[]]></xf:value>
								</xf:item>
							</xf:choices>
						</xf:checkcombobox>
					</xf:group>
				</xf:group>
				<xf:group tagname="tr">
					<xf:group tagname="th" class="w2tb_th">testB</xf:group>
					<xf:group tagname="td" class="w2tb_td">
						<xf:checkcombobox submenuSize="auto" style="width: 148px;height: 21px;" id="checkcombobox3" displayMode="label" direction="auto"
							accessibility="true">
							<xf:choices>
								<xf:itemset nodeset="data:dataList1">
									<xf:label ref="col1"></xf:label>
									<xf:value ref="col2"></xf:value>
								</xf:itemset>
							</xf:choices>
						</xf:checkcombobox>
					</xf:group>
				</xf:group>
			</xf:group>
			<xf:trigger type="button" style="width:220px;height:47px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[setDisabled]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
