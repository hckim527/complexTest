<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.test = function(selectData, b) {
		if ((ckhbox.getItemCount() - 1) == selectData.length) {
			return "전체(" + selectData.length + ")";
		} else {
			var a = [];
			for (var i = 0; i < selectData.length; i++) {
				//label값 : undefined, value값 사용
				a.push(selectData[i].label);
			}
			return a.join(",");
		}
	};

	scwin.checkVal = function() {
		return (document.getElementById('ckhbox_label') || document.getElementById('mf_ckhbox_label')).innerText == '공백,설정예정';
	};
	]]></script>
	</head>
	<body>
		<xf:group id="" style="position: relative;padding-top:40px;height:140px;width:700px;">
			<xf:group id="" style="position: relative;height:50%;">
				<xf:checkcombobox appearance="minimal" direction="auto" id="ckhbox" style="position: relative;width: 148px;height: 21px;"
					displayMode="label" submenuSize="auto" chooseOptionLabel="전체" customLabelFormatter="scwin.test"
					chooseOption="true" allOption="true" checkboxClickSync="true">
					<xf:choices>
						<xf:item>
							<xf:label><![CDATA[공백]]></xf:label>
							<xf:value><![CDATA[aaa]]></xf:value>
						</xf:item>
						<xf:item>
							<xf:label><![CDATA[개발]]></xf:label>
							<xf:value><![CDATA[개발]]></xf:value>
						</xf:item>
						<xf:item>
							<xf:label><![CDATA[설정예정]]></xf:label>
							<xf:value><![CDATA[설정예정]]></xf:value>
						</xf:item>
						<xf:item>
							<xf:label><![CDATA[운용]]></xf:label>
							<xf:value><![CDATA[운용]]></xf:value>
						</xf:item>
					</xf:choices>
				</xf:checkcombobox>
			</xf:group>
		</xf:group>
	</body>
</html>
