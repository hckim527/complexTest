<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	checkcombobox1.setDisplayAllOptionLabel(true);
};
scwin.trigger2_onclick = function(e) {
	checkcombobox1.setDisplayAllOptionLabel(false);
};
]]></script>
	</head>
	<body>
		<xf:checkcombobox id="checkcombobox1" style="position: relative;width:285px;height:109px;" displayMode="label" allOption="true">
			<xf:choices>
				<xf:item>
					<xf:label><![CDATA[1]]></xf:label>
					<xf:value><![CDATA[a]]></xf:value>
				</xf:item>
				<xf:item>
					<xf:label><![CDATA[2]]></xf:label>
					<xf:value><![CDATA[b]]></xf:value>
				</xf:item>
				<xf:item>
					<xf:label><![CDATA[3]]></xf:label>
					<xf:value><![CDATA[c]]></xf:value>
				</xf:item>
				<xf:item>
					<xf:label><![CDATA[4]]></xf:label>
					<xf:value><![CDATA[d]]></xf:value>
				</xf:item>
			</xf:choices>
		</xf:checkcombobox>
		<xf:group id="" style="height:134px;">
			<xf:trigger id="trigger1" style="position: relative;width:351px;height:52px;" type="button" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[setDisplayAllOptionLabel(true)]]></xf:label>
			</xf:trigger>
			<xf:trigger id="trigger2" style="position: relative;width:351px;height:52px;" type="button" ev:onclick="scwin.trigger2_onclick">
				<xf:label><![CDATA[setDisplayAllOptionLabel(false)]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
