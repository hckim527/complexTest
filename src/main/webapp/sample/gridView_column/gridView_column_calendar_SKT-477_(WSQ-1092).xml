<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="inputTypeList">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.getType = function(info) {
	var rowIndex = info.rowIndex;
	var colIndex = info.colIndex;
	var returnInfo;
	var inputType = inputTypeList.getCellData(rowIndex, colIndex);
	switch (inputType) {
		case "calendar":
			returnInfo = {
				id: "dynamic_calendar_" + rowIndex + "_" + colIndex,
				inputType: "calendar",
				options: {
					viewType: "icon"
				}
			};
			break;
	}
	return returnInfo;
};
scwin.onpageload = function() {
	var arr = [];
	for (var i = 0; i < 300; i++) {
		arr.push("");
	}
	dataList1.setData(arr.slice(0));
	inputTypeList.setData(arr.slice(0));
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="cont_wrap type1">
			<xf:group class="sub_cont">
				<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1" rowNumVisible="true"
					style="width:700px;height:300px;border:1px solid black;" ignoreCellClick="false" ignoreToggleOnDisabled="false"
					fixedColumnWithHidden="true" useShiftKey="true" class="grid_01">
					<w2:header id="header1">
						<w2:row id="row2">
							<w2:column id="header1" inputType="text" width="*" value="col1"></w2:column>
							<w2:column id="header2" inputType="text" width="*" value="col2"></w2:column>
							<w2:column id="header3" inputType="text" width="*" value="col3"></w2:column>
							<w2:column id="header4" inputType="text" width="*" value="col4"></w2:column>
							<w2:column id="header5" inputType="text" width="*" value="col5"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody4">
						<w2:row id="row5">
							<w2:column id="col1" inputType="custom" typeGetter="scwin.getType" dateValidCheck="true"></w2:column>
							<w2:column id="col2" inputType="custom" typeGetter="scwin.getType" dateValidCheck="true"></w2:column>
							<w2:column id="col3" inputType="custom" typeGetter="scwin.getType" dateValidCheck="true"></w2:column>
							<w2:column id="col4" inputType="custom" typeGetter="scwin.getType" dateValidCheck="true"></w2:column>
							<w2:column id="col5" inputType="calendar" typeGetter="scwin.getType" dateValidCheck="true"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>
		</xf:group>
	</body>
</html>
