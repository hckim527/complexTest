<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	grp.setDisabled(true);
	grp_ro.setReadOnly(true);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp" style="height: 150px;">
			<xf:input id="ipt" style="position: relative;width: 144px;height: 21px;"></xf:input>
			<xf:select1 id="sbx" appearance="minimal" direction="auto" chooseOption="false" style="position: relative;width: 148px;height: 21px;" displayMode="label" optionOrder="false" allOption="false" disabled="false" submenuSize="auto" renderType="native"></xf:select1>
			<w2:inputCalendar id="cal" renderType="component" weekStartsOn="0" renderDiv="true" style="position: relative;width: 150px;height: 23px;" rightAlign="false" focusOnDateSelect="false" footerDiv="false" calendarValueType="yearMonthDate"></w2:inputCalendar>
			<xf:select1 id="rad" appearance="full" style="position: relative;width: 150px;height: 21px;" selectedIndex="-1" cols="" rows="">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[new row]]></xf:label>
						<xf:value><![CDATA[]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:select1>
			<xf:select id="chk" appearance="full" style="position: relative;width: 148px;height: 21px;" selectedindex="-1" cols="" rows="">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[new row]]></xf:label>
						<xf:value><![CDATA[]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:select>
			<xf:textarea id="txa" style="position: relative;width: 300px;height:50px;"></xf:textarea>
		</xf:group>
		<xf:group id="grp_ro" style="height: 100px;">
			<xf:input id="ipt_ro" style="position: relative;width: 144px;height: 21px;"></xf:input>
			<w2:inputCalendar id="cal_ro" renderType="component" weekStartsOn="0" renderDiv="true" style="position: relative;width: 150px;height: 23px;" rightAlign="false" focusOnDateSelect="false" footerDiv="false" calendarValueType="yearMonthDate"></w2:inputCalendar>
			<xf:textarea id="txa_ro" style="position: relative;width: 300px;height:50px;"></xf:textarea>
		</xf:group>
		<xf:input id="ipt_free" style="position: relative;width: 144px;height: 21px;"></xf:input>
	</body>
</html>
