<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                	<checkbox>
                		<res></res>
                	</checkbox>
                </data>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column dataType="text" id="ID" name="ID"></w2:column>
            			<w2:column dataType="text" id="ID2" name="ID2"></w2:column>
            			<w2:column dataType="text" id="Date" name="Date"></w2:column>
            			<w2:column dataType="text" id="Date2" name="Date2"></w2:column>
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
        </xf:model>
        <script type="text/javascript"><![CDATA[
		scwin.onpageload = function() {
			var json = [
				{
					"ID": "12345678",
					"ID2": "1234567890123",
					"Date": "20190719",
					"Date2": "20230510"
				},
				{
					"ID": "",
					"ID2": "",
					"Date": "",
					"Date2": ""
				}
			];
			dataList1.setJSON(json);
		};
		scwin.trigger1_0_onclick = function() {
			gridView1.setColumnEditFormat(0, "");
		}
		scwin.trigger1_onclick = function() {
			gridView1.setColumnEditFormat(0, "##/##||####/##/##");
		}

		scwin.trigger_uef2_off_onclick = function() {
			gridView1.setColumnUseEditFormat(2, false);
		}
		scwin.trigger_uef2_on_onclick = function() {
			gridView1.setColumnUseEditFormat(2, true);
		}

	]]></script>
	<style type="text/css"><![CDATA[
	    .gridBodyDefault{
			font-size:16px;
			border:1px solid #cbd1d4;
			font-family: 'Consolas', 'Courier New', monospace;
			padding: 0 10px;
			letter-spacing: 0.05em;
			text-align: center;
	    }
	    .w2inputCalendar_divInput{
			font-size:16px;
			font-family: 'Consolas', 'Courier New', monospace;
			letter-spacing: 0.05em;
			text-align: center;
	    }
	    .w2input{
			font-size:16px;
			font-family: 'Consolas', 'Courier New', monospace;
			letter-spacing: 0.05em;
			text-align: center;
	    }
	    .w2grid .w2grid_embedded_input{
			font-family: 'Consolas', 'Courier New', monospace;
	    }
	]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	
		<xf:group class="sub_cont" id="" style="padding:10px">

			<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList1" defaultCellHeight="40" id="gridView1" rowNumVisible=""
    			scrollByColumn="false" scrollByColumnAdaptive="false" style="width:920px;height: 200px;margin-top: 50px;" visibleRowNum="5"
				editFormatGetCellDisplayData="true">
    			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
    			<w2:header id="header2">
    				<w2:row id="row3">
    					<w2:column width="230" inputType="text" style="height:20px" id="column20" value='inputType="text" &lt;br&gt; editFormat=&lt;br&gt; "{####}||####-####||{####}-####-{####}" &lt;br&gt; editDisplayChar="*"' displayMode="label"></w2:column>
    					<w2:column width="230" inputType="text" style="height:20px" id="column29" value='inputType="text" &lt;br&gt; editFormat="######-#{######}" &lt;br&gt; editDisplayChar="*" &lt;br&gt; editPlaceholderChar="_"' displayMode="label"></w2:column>
    					<w2:column width="230" inputType="text" style="height:20px" id="column12" value='inputType="calendar" &lt;br&gt; displayFormat="yyyy.MM.dd" &lt;br&gt; useEditFormat="true"' displayMode="label"></w2:column>
    					<w2:column width="230" inputType="text" style="height:20px" id="column22" value='inputType="calendar" &lt;br&gt; displayFormat="yyyy.MM.dd" &lt;br&gt; useEditFormat="true" &lt;br&gt; editPlaceholderChar="_"' displayMode="label"></w2:column>
    				</w2:row>
    			</w2:header>
    			<w2:gBody id="gBody2">
    				<w2:row id="row4">
    					<w2:column width="230" inputType="text" style="height:40px" id="ID" value="" displayMode="label"
							
							editFormat="{####}||####-####||{####}-####-{####}"
							editFormatParticalMask="true"
							editDisplayChar="*">
						</w2:column>
    					<w2:column width="230" inputType="text" style="height:40px" id="ID2" value="" displayMode="label"
							
							editFormat="######-#{######}"
							editFormatParticalMask="true"
							editPlaceholderChar="_"
							editDisplayChar="*">
						</w2:column>
    					<w2:column width="230" inputType="calendar" style="height:40px" id="Date" value="" displayMode="label" viewType="icon"
							
							calendarValueType="yearMonthDate" 
							displayFormat="yyyy.MM.dd"

							useEditFormat="true"
							editPlaceholderChar="">
						</w2:column>
    					<w2:column width="230" inputType="calendar" style="height:40px" id="Date2" value="" displayMode="label" viewType="icon"
							
							calendarValueType="yearMonthDate" 
							displayFormat="yyyy.MM.dd"

							useEditFormat="true"
							editPlaceholderChar="_">
						</w2:column>
    				</w2:row>
    			</w2:gBody>
    		</w2:gridView>

			<xf:group class="" id="" style="display:flex;gap:40px;">
				<xf:group class="" id="">
					<w2:button type="" style="width:250px;height:50px;display:block;" id="trigger1_0" ev:onclick="scwin.trigger1_0_onclick"
						label='gridView1.setColumnEditFormat &lt;br&gt; (0, "")'>
					</w2:button>
					<w2:button type="" style="width:250px;height:50px;display:block;" id="trigger1" ev:onclick="scwin.trigger1_onclick"
						label='gridView1.setColumnEditFormat &lt;br&gt; (0, "##/##||####/##/##")'>
					</w2:button>

				</xf:group>
				<xf:group class="" id="">
					<w2:button type="" style="width:250px;height:50px;display:block;" id="trigger_uef2_off" ev:onclick="scwin.trigger_uef2_off_onclick"
						label='gridView1.setColumnUseEditFormat &lt;br&gt; (2, false)'>
					</w2:button>
					<w2:button type="" style="width:250px;height:50px;display:block;" id="trigger_uef2_on" ev:onclick="scwin.trigger_uef2_on_onclick"
						label='gridView1.setColumnUseEditFormat &lt;br&gt; (2, true)'>
					</w2:button>

				</xf:group>

			</xf:group>

		</xf:group>
    </body>
</html>
