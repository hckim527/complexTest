<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns="">
                	<checkbox>
                		<res></res>
                	</checkbox>
                </data>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataMap baseNode="map" id="dataMap1">
            		<w2:keyInfo>
            			<w2:key id="key1" name="name1" dataType="text"></w2:key>
						<w2:key id="key2" name="name2" dataType="text"></w2:key>
            			<w2:key id="key3" name="name3" dataType="text"></w2:key>
            			<w2:key id="key4" name="name4" dataType="text"></w2:key>
            		</w2:keyInfo>
            		<w2:data use="true">
            			<key1><![CDATA[20250101]]></key1>
            			<key2><![CDATA[]]></key2>
            			<key3><![CDATA[]]></key3>
            		</w2:data>
            	</w2:dataMap>
            </w2:dataCollection>
        </xf:model>
        <script type="text/javascript"><![CDATA[
		scwin.onpageload = function() {
		};

		scwin.inputCalendar1_onchange = function(e) {
		};
		scwin.trigger011_onclick = function() {
			inputCalendar1.setUseEditFormat(false);
		}
		scwin.trigger012_onclick = function() {
			inputCalendar1.setUseEditFormat(true);
		}
		scwin.trigger1_onclick = function() {
			inputCalendar1.setIoFormat("yyyyMMdd", "yyyy/MM/dd");
		}

	]]></script>
	<style type="text/css"><![CDATA[
	    .w2inputCalendar_divInput{
	        width: 150px;
			height: 40px;
			font-size:16px;
			border:1px solid #cbd1d4;
			font-family: 'Consolas', 'Courier New', monospace;
			padding: 0 10px;
			letter-spacing: 0.05em;
			text-align: center;
			display:block;
	    }
	]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload">

		<xf:group class="sub_cont" id="" style="padding:10px">

			<w2:textbox label='displayFormat="yyyy.MM.dd" useEditFormat="true" editPlaceholderChar="_" ref="data:dataMap1.key1"' style="position:relative;width:200px;font-size: 13px;" id=""></w2:textbox>
			<w2:inputCalendar id="inputCalendar1" style="width: 170px; height: 50px;margin-bottom: 10px;" 
				ref="data:dataMap1.key1"
				calendarValueType="yearMonthDate" 
				displayFormat="yyyy.MM.dd"
				delimiter="/"

				useEditFormat="true"
				editPlaceholderChar="_"
				
				ev:onchange="scwin.inputCalendar1_onchange">
			</w2:inputCalendar>

			<w2:textbox label='displayFormat="yyyy.MM.dd" useEditFormat="true" editPlaceholderChar="_" ref="data:dataMap1.key2"' style="position:relative;width:200px;font-size: 13px;" id=""></w2:textbox>
			<w2:inputCalendar id="inputCalendar2" style="width: 170px; height: 50px;margin-bottom: 10px;" 
				ref="data:dataMap1.key2"
				calendarValueType="yearMonthDate" 
				displayFormat="yyyy.MM.dd"
				delimiter="/"

				useEditFormat="true"
				editPlaceholderChar="_">
			</w2:inputCalendar>

			<w2:textbox label='displayFormat="yyyy.MM.dd" delimiter="/" useEditFormat="true" ref="data:dataMap1.key3"' style="position:relative;width:200px;font-size: 13px;" id=""></w2:textbox>
			<w2:inputCalendar id="inputCalendar3" style="width: 170px; height: 50px;margin-bottom: 10px;" 
				ref="data:dataMap1.key3"
				calendarValueType="yearMonthDate" 
				displayFormat="yyyy.MM.dd"
				delimiter="/"

				useEditFormat="true"
				editPlaceholderChar="">
			</w2:inputCalendar>

			<w2:button type="" style="width:250px;height:50px;display:block;" id="trigger011" ev:onclick="scwin.trigger011_onclick" 
				label='inputCalendar1.setUseEditFormat(false)'>
			</w2:button>
			<w2:button type="" style="width:250px;height:50px;display:block;" id="trigger012" ev:onclick="scwin.trigger012_onclick" 
				label='inputCalendar1.setUseEditFormat(true)'>
			</w2:button>
			<w2:button type="" style="width:250px;height:50px;display:block;" id="trigger1" ev:onclick="scwin.trigger1_onclick" 
				label='inputCalendar1.setIoFormat &lt;br&gt; ("yyyyMMdd", "yyyy/MM/dd")'>
			</w2:button>
		</xf:group>
    </body>
</html>
