<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
};

// body 에 transform: scale 적용
scwin.setScale = function(scale) {
	document.body.style.transformOrigin = "top left";
	document.body.style.transform = "scale(" + scale + ")";
};

scwin.btn_scale15_onclick = function(e) {
	scwin.setScale(1.5);
};

scwin.btn_scale07_onclick = function(e) {
	scwin.setScale(0.7);
};

scwin.btn_scale1_onclick = function(e) {
	scwin.setScale(1);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="grp_btn" style="height:30px;">
			<xf:trigger type="button" id="btn_scale15" style="width:90px;height:23px;" ev:onclick="scwin.btn_scale15_onclick">
				<xf:label><![CDATA[scale 1.5]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="btn_scale07" style="width:90px;height:23px;" ev:onclick="scwin.btn_scale07_onclick">
				<xf:label><![CDATA[scale 0.7]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="btn_scale1" style="width:90px;height:23px;" ev:onclick="scwin.btn_scale1_onclick">
				<xf:label><![CDATA[scale 1]]></xf:label>
			</xf:trigger>
		</xf:group>
		<xf:group id="grp_comp" style="position:relative;height:300px;">
			<w2:inputCalendar id="inputCalendar1" calendarValueType="yearMonthDate" style="position:absolute;left:100px;top:20px;width:120px;height:23px;" weekStartsOn="0"></w2:inputCalendar>
			<xf:select1 id="selectbox3" allOption="true" appearance="minimal" chooseOption="" direction="auto" disabled="false" displayMode="label" optionOrder="false" style="position:absolute;left:300px;top:20px;width:120px;height:23px;" submenuSize="auto">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[item1]]></xf:label>
						<xf:value><![CDATA[1]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[item2]]></xf:label>
						<xf:value><![CDATA[2]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:select1>
		</xf:group>
	</body>
</html>
