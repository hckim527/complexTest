    { compId: 'secret1', colId: 'col_secret', getter: 'getValue', setter: 'setValue', testValue: 'newpass' },
    { compId: 'selectbox1', colId: 'col_selectbox', getter: 'getValue', setter: 'setValue', testValue: 'OPT3' },
    { compId: 'spinner1', colId: 'col_spinner', getter: 'getValue', setter: 'setValue', testValue: '999' },
    { compId: 'textarea1', colId: 'col_textarea', getter: 'getValue', setter: 'setValue', testValue: '테스트텍스트영역' },
    { compId: 'textbox1', colId: 'col_textbox', getter: 'getValue', setter: 'setValue', testValue: '테스트텍스트' },
    { compId: 'trigger1', colId: 'col_trigger', getter: 'getLabel', setter: 'setLabel', testValue: '테스트트리거' }
];

]]></script>

        <style type="text/css"><![CDATA[
/* ============================================================================
   ListView 테스트용 스타일 재정의
   ============================================================================ */
.w2group {
    background-color: unset;
}

.w2listView {
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
}

.w2listView_header {
    border: 1px solid #C4CDD5;
    border-radius: 6px;
    background-color: #e3f0ff;
}

.w2listView_body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 10px 0;
}

.w2listView_footer {
    border: 1px solid #C4CDD5;
    border-radius: 6px;
    padding: 10px 12px;
}

.w2listView_pageList {
    background-color: #ffffff;
    border: 1px solid #C4CDD5;
    border-radius: 6px;
    padding: 12px;
    margin-top: 10px;
}

/* 행 스타일 */
.header_row,
.body_row {
    display: flex;
    align-items: stretch;
    padding: 6px 8px;
    height: 60px;
}
.body_row {
    background-color: #ffffff;
    border: 1px solid #C4CDD5;
    border-radius: 4px;
}

.body_row:hover {
    background-color: #f5f9ff;
}

.w2listView_mobile .body_row {
    display: flex;
    flex-direction: column;
    height: auto;
}

.footer_row {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
}

/* 셀 스타일 */
.cell {
    padding: 4px 6px;
    box-sizing: border-box;
    border-right: 1px solid #e0e0e0;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 120px;
    flex-shrink: 0;
    overflow: hidden;
}

.cell:last-child {
    border-right: none;
}

/* Button */
.btn {
    padding: 4px 10px;
    border: 1px solid #C4CDD5;
    background: linear-gradient(#fcfbfc, #efefef);
    cursor: pointer;
}

.btn:hover {
    background: linear-gradient(#efefef, #e0e0e0);
}

/* 테스트 컨트롤 패널 */
.test_panel {
    border: 1px solid #b3d7ff;
    border-radius: 6px;
    background-color: #f0f7ff;
    padding: 10px 12px;
    margin-bottom: 12px;
}

.test_panel_title {
    font-weight: bold;
    color: #1d4ed8;
    margin-right: 10px;
}

.status_bar {
    border: 1px solid #C4CDD5;
    border-radius: 4px;
    background-color: #fffceb;
    padding: 8px 12px;
    margin-bottom: 8px;
    font-family: monospace;
    font-size: 12px;
}

/* ListView를 감싸는 가변 컨테이너 - self 모드 검증의 핵심 */
.list_container {
    border: 2px dashed #1d4ed8;
    padding: 4px;
    margin-top: 8px;
    transition: width 0.3s ease;
    box-sizing: border-box;
}
        ]]></style>
