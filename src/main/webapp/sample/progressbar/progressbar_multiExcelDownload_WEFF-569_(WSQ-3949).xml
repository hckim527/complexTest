<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dataList1" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dataList2" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		window.data1 = [
			{ "col1": "a", "col2": "1000" },
			{ "col1": "a", "col2": "1000" },
			{ "col1": "b", "col2": "b" },
			{ "col1": "c", "col2": "3000" },
			{ "col1": "d", "col2": "4000" }
		];
		window.data2 = [
			{ "col1": "a", "col2": "100" },
			{ "col1": "b", "col2": "200" },
			{ "col1": "c", "col2": "300" },
			{ "col1": "d", "col2": "400" }
		];
		dataList1.setJSON(data1);
		dataList2.setJSON(data2);
		window.mergeInfo = {};
		mergeInfo.rowIndex = 0;
		mergeInfo.colIndex = 0;
		mergeInfo.rowSpan = 2;
		mergeInfo.colSpan = 2;
		gridView1.mergeCell(mergeInfo);
	};
	]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1"
			style="position: relative ;left:18px;top:20px;width:262px;height:249px;" fixedColumnWithHidden="true" useShiftKey="true" mergeCells="byrow">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column blockSelect="false" id="column3" style="height:20px" inputType="text" width="70" value="name1"></w2:column>
					<w2:column blockSelect="false" id="column1" style="height:20px" width="70" inputType="text" value="name2"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70" colMerge="true"></w2:column>
					<w2:column blockSelect="false" id="col2" style="height:20px" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal1" targetColumnID="col1">
				<w2:row id="row2">
					<w2:column blockSelect="false" id="column5" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="column4" style="height:20px" width="70" inputType="expression" displayMode="label" expression="sum('col2')"></w2:column>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
		<w2:gridView dataList="dataList2" scrollByColumn="false" id="gridView2"
			style="position: relative ;left:22px;top:18px;width:275px;height:234px;margin-top:95px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header5">
				<w2:row id="row6">
					<w2:column blockSelect="false" id="column11" style="height:20px" inputType="text" width="70" displayMode="label" value="name1"></w2:column>
					<w2:column blockSelect="false" id="column7" style="height:20px" width="70" inputType="text" displayMode="label" value="name2"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody8">
				<w2:row id="row9">
					<w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70" displayMode="label" colMerge="true"></w2:column>
					<w2:column blockSelect="false" id="col2" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal13" targetColumnID="col1">
				<w2:row id="row14">
					<w2:column blockSelect="false" id="column16" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="column15" style="height:20px" width="70" inputType="expression" displayMode="label" expression="sum('col2')"></w2:column>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
		<xf:input id="input1" style="position: relative ;left:346px;top:-192px;width: 144px;height: 21px;" ref="data:dataList1.col1"></xf:input>
		<xf:input id="input2" ref="data:dataList1.col2" style="position: relative ;left:195px;top:-163px;width: 144px;height: 21px;"></xf:input>
		<xf:trigger type="button" id="trigger1" style="position: relative ;left:48px;top:-394px;width:202px;height:23px;">
			<xf:label><![CDATA[gridView1,gridView2 같이 받기 ]]></xf:label>
			<script ev:event="onclick(e)" type="javascript"><![CDATA[
				var options = {
					common: {
						fileName : "user.xls",
						printSet : {
							landScape : "true",
							fitToPage : "true",
							fitWidth : "4",
							fitHeight : "333",
							scale : "222"
						}
					},
					excelInfo: [
						{
							gridId : "gridView1",
							sheetName : "첫번째 sheet",
							type : "1",
							removeColumns : "",
							startRowIndex : 3,
							startColumnIndex : 0,
							mergeCell: true,
							headerColor : "#DBEEF3",
							bodyColor : "#92CDDC",
							infoArr : [
								{
									rowIndex : 1, colIndex : 3, rowSpan : 1, colSpan : 2, text : "데이터표시1" , textAlign : "center"
								}
							]
						},
						{
							gridId : "gridView2",
							sheetName : "두번째 sheet",
							type : "1",
							removeColumns : "",
							foldColumns : "2",
							startRowIndex : 3,
							startColumnIndex : 0,
							headerColor : "#DBEEF3",
							bodyColor : "#92CDDC",
							infoArr : [
								{
									rowIndex : 1, colIndex : 3, rowSpan : 1, colSpan : 2, text : "데이터표시2" , textAlign : "center"
								}
							]
						}
					]
				};

				gridView2.options.advancedExcelDownloadURL = "xmlToExcel2.wq?param1=10";
				WebSquare.util.multipleExcelDownload( options );
			]]></script>
		</xf:trigger>
	</body>
</html>
