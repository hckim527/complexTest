<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		progressbar1.set(14);
		progressbar2.set(28);
		progressbar3.set(30);
		progressbar4.set(70);
	};

	scwin.checkVal = function() {
		return (document.getElementById('progressbar1_label') || document.getElementById('mf_progressbar1_label')).innerText == '14%';
	};

	scwin.checkVal2 = function() {
		return (document.getElementById('progressbar2_label') || document.getElementById('mf_progressbar2_label')).innerText == '28%';
	};
	]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:progressbar valueType="percent" style="width: 200px;height: 30px;" id="progressbar1"></w2:progressbar>
		<w2:progressbar barColor="orange" id="progressbar2" progressColor="white" step="1" style="width:200px; height:30px;" type="line" valueType="percent"></w2:progressbar>
		<w2:progressbar barColor="orange" id="progressbar3" progressColor="white" step="1" style="width:200px; height:30px;" type="line" valueType="percent"></w2:progressbar>
		<w2:progressbar barColor="orange" id="progressbar4" progressColor="white" step="1" style="width:200px; height:30px;" type="line" valueType="percent"></w2:progressbar>
	</body>
</html>
