<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.btn_test_onclick = function(e) {
		WebSquare.layer.showProcessMessage("프로세스메세지 처리");
		input1.focus();
		setTimeout(function() {
			WebSquare.layer.hideProcessMessage();
		}, 2000);
	};
	scwin.btn_test2_onclick = function(e) {
		WebSquare.layer.showProcessMessage("프로세스메세지 처리");
		gridView1.setFocusedCell(1, 1, true);
		setTimeout(function() {
			WebSquare.layer.hideProcessMessage();
		}, 2000);
	};
	]]></script>
	</head>
	<body>
		<xf:group class="cont_wrap" id="">
			<xf:group class="grpbox" id="">
				<xf:group class="sub_cont" id="">
					<xf:trigger class="btn_gray" ev:onclick="scwin.btn_test_onclick" id="btn_test" type="button">
						<xf:label><![CDATA[input progress on]]></xf:label>
					</xf:trigger>
				</xf:group>
				<xf:group class="sub_cont" id="">
					<xf:input id="input1" />
				</xf:group>
				<xf:group class="sub_cont" id="">
					<xf:trigger class="btn_gray" ev:onclick="scwin.btn_test2_onclick" id="btn_test2" type="button">
						<xf:label><![CDATA[grid progress on]]></xf:label>
					</xf:trigger>
				</xf:group>
				<xf:group class="sub_cont" id="">
					<w2:gridView dataList="dataList1" id="gridView1" style="width:400px;height:150px;">
						<w2:header id="header1">
							<w2:row id="row2">
								<w2:column id="column3" inputType="text" value="name1" width="120"></w2:column>
								<w2:column id="column7" inputType="text" value="name2" width="120"></w2:column>
								<w2:column id="column9" inputType="text" value="name3" width="120"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="gBody4">
							<w2:row id="row5">
								<w2:column id="col1" inputType="text" width="120"></w2:column>
								<w2:column id="col2" inputType="text" width="120"></w2:column>
								<w2:column id="col3" inputType="text" width="120"></w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
