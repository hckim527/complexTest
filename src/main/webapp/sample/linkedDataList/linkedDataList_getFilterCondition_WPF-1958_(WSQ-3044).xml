<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="PersonInfo" baseNode="list" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="NAME" name="이름" dataType="date"></w2:column>
						<w2:column id="GENDER" name="성별" dataType="date"></w2:column>
						<w2:column id="BIRTH" name="생년월일" dataType="date"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<NAME><![CDATA[김유정]]></NAME>
							<GENDER><![CDATA[W]]></GENDER>
							<BIRTH><![CDATA[20020922]]></BIRTH>
						</w2:row>
						<w2:row>
							<NAME><![CDATA[이건]]></NAME>
							<GENDER><![CDATA[M]]></GENDER>
							<BIRTH><![CDATA[19871106]]></BIRTH>
						</w2:row>
						<w2:row>
							<NAME><![CDATA[이영재]]></NAME>
							<GENDER><![CDATA[M]]></GENDER>
							<BIRTH><![CDATA[19721229]]></BIRTH>
						</w2:row>
						<w2:row>
							<NAME><![CDATA[안영미]]></NAME>
							<GENDER><![CDATA[W]]></GENDER>
							<BIRTH><![CDATA[19530405]]></BIRTH>
						</w2:row>
						<w2:row>
							<NAME><![CDATA[박정우]]></NAME>
							<GENDER><![CDATA[M]]></GENDER>
							<BIRTH><![CDATA[19900217]]></BIRTH>
						</w2:row>
						<w2:row>
							<NAME><![CDATA[정은지]]></NAME>
							<GENDER><![CDATA[W]]></GENDER>
							<BIRTH><![CDATA[19770111]]></BIRTH>
						</w2:row>
						<w2:row>
							<NAME><![CDATA[이준혁]]></NAME>
							<GENDER><![CDATA[M]]></GENDER>
							<BIRTH><![CDATA[19761116]]></BIRTH>
						</w2:row>
						<w2:row>
							<NAME><![CDATA[정수인]]></NAME>
							<GENDER><![CDATA[W]]></GENDER>
							<BIRTH><![CDATA[19860621]]></BIRTH>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:linkedDataList id="Linked_PersonInfo" bind="PersonInfo">
					<w2:condition type="filter"><![CDATA[col('BIRTH') NOT LIKE val('input1')]]></w2:condition>
					<w2:condition type="sort"><![CDATA[DESC]]></w2:condition>
				</w2:linkedDataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	log = Linked_PersonInfo.getFilterCondition();
};
scwin.trigger2_onclick = function(e) {
	log1 = Linked_PersonInfo.getSortCondition();
};
scwin.checkLog = function() {
	return log == "col('BIRTH') NOT LIKE val('input1')";
};
scwin.checkLog1 = function() {
	return log1 == "DESC";
};
scwin.onpageload = function() {
	input1.setValue("19%1%.%");
	window.log = false;
	window.log1 = false;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:input id="input1"></xf:input>
		<w2:gridView id="gridView2" dataList="Linked_PersonInfo" style="position:relative;width:250px;height:220px;">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column11" style="height:23px" inputType="text" width="70" value="이름"></w2:column>
					<w2:column id="column9" style="height:20px" inputType="text" width="70" value="성별"></w2:column>
					<w2:column id="column7" style="height:20px" width="100" inputType="text" value="생년월일"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="NAME" style="height:23px" inputType="text" width="70"></w2:column>
					<w2:column id="GENDER" style="height:20px" inputType="select" width="70">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[남]]></w2:label>
								<w2:value><![CDATA[M]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[여]]></w2:label>
								<w2:value><![CDATA[W]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
					<w2:column id="BIRTH" style="height:20px" width="70" inputType="calendar"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:107px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[Filter Condition]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position: relative;width:95px;height:23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[Sort Condition]]></xf:label>
		</xf:trigger>
	</body>
</html>
