<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	editor1.setText('editor\n setText\t API \ \" \'');
};

scwin.trigger2_onclick = function(e) {
	console.log(editor1.getText());
};

scwin.trigger3_onclick = function(e) {
	editor1.setHTML('<em><span style="font-size:14px;">editor setHTML(html) API.</span></em>');
};

scwin.trigger4_onclick = function(e) {
	console.log(editor1.getHTML());
};

scwin.trigger5_onclick = function(e) {
	editor1.focus();
};

scwin.trigger6_onclick = function(e) {
	editor1.setDisabled(true);
};

scwin.trigger8_onclick = function(e) {
	editor1.setDomain("inswave.com");
};

scwin.trigger9_onclick = function(e) {
	console.log(editor1.getDomain());
};

scwin.trigger10_onclick = function(e) {
	console.log("editor1.options.imageUploadURL : " + editor1.options.imageUploadURL);
	console.log("editor1.options.imageLoadURL : " + editor1.options.imageLoadURL);
	console.log("editor1.getImageLoadURL() : " + editor1.getImageLoadURL());
};

scwin.editor1_onchange = function() {
	console.log("onchange occured");
};
]]></script>
	</head>
	<body>
		<w2:editor id="editor1" style="width: 100%;height: 700px; padding:20px;box-sizing: border-box;" ev:onchange="scwin.editor1_onchange" menubar="all"
			language="ko" resizable="true" placeholder="placeholder" placeholderLocaleRef="editorPlaceholder" accessibility="true" wAIEditor="true"
			autoMinHeight="500px" autoMaxHeight="80%" />
		<xf:group style="margin-top: 20px;">
			<xf:trigger type="button" id="trigger1" style="position: relative;height:30px;width:500px;" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[setText("setText");]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger2" style="position: relative;height:30px;width:500px;" ev:onclick="scwin.trigger2_onclick">
				<xf:label><![CDATA[getText();]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger3" style="position: relative;height:30px;width:500px;" ev:onclick="scwin.trigger3_onclick">
				<xf:label><![CDATA[setHTML('<em><span style="font-size:14px;">editor setHTML(html) API.</span></em>');]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger4" style="position: relative;height:30px;width:500px;" ev:onclick="scwin.trigger4_onclick">
				<xf:label><![CDATA[getHTML();]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger5" style="position: relative;height:30px;width:500px;" ev:onclick="scwin.trigger5_onclick">
				<xf:label><![CDATA[focus();]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger6" style="position: relative;height:30px;width:500px;" ev:onclick="scwin.trigger6_onclick">
				<xf:label><![CDATA[setDisabled(true);]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger8" style="position: relative;height:30px;width:500px;" ev:onclick="scwin.trigger8_onclick">
				<xf:label><![CDATA[setDomain();]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger9" style="position: relative;height:30px;width:500px;" ev:onclick="scwin.trigger9_onclick">
				<xf:label><![CDATA[getDomain();]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger10" style="position: relative;height:30px;width:500px;" ev:onclick="scwin.trigger10_onclick">
				<xf:label><![CDATA[getImageLoadURL();]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
