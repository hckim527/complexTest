<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.spinner_oneditenter = function() {
	localStorage.setItem("log", "Spinner Onedienter");
};

scwin.checkVal = function() {
	return localStorage.getItem('log') == 'Spinner Onedienter';
};
localStorage.removeItem("log");
]]></script>
	</head>
	<body>
		<w2:spinner skin="type1" buttonSize="30" inputReadOnly="false" id="spinner" style="position: relative;width: 150px;height: 21px;" ev:oneditenter="scwin.spinner_oneditenter"></w2:spinner>
	</body>
</html>
