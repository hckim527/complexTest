<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[a]]></col2>
							<col3><![CDATA[A]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[b]]></col2>
							<col3><![CDATA[B]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="code" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<code><![CDATA[a]]></code>
							<value><![CDATA[a]]></value>
						</w2:row>
						<w2:row>
							<code><![CDATA[b]]></code>
							<value><![CDATA[b]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger2_onclick = function(e) {
	for (var i = 0; i < 6; i++) {
		grd_spinner.setDisabled("cell", 1, i, false);
	}
};

scwin.checkVal = function() {
	return (document.getElementById('G_grd_spinner___spinner_col1___input') || document.getElementById('mf_G_grd_spinner___spinner_col1___input') || document.getElementById('mf_G_mf_grd_spinner___spinner_col1___input') || document.getElementById('G_mf_grd_spinner___spinner_col1___input')).value == '3';
};
]]></script>
	</head>
	<body>
		<w2:gridView id="grd_spinner" style="width:997px;height:150px;margin-top:10px;" scrollByColumn="false" defaultCellHeight="20"
			scrollByColumnAdaptive="false" dataList="data:dataList1" autoFit="allColumn">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="150" inputType="text" style="height:20px;" id="column8" value="스피너" displayMode="label"></w2:column>
					<w2:column width="150" inputType="text" style="height:20px;" id="column7" value="select" displayMode="label"></w2:column>
					<w2:column width="150" inputType="text" style="height:20px;" id="column6" value="text" displayMode="label"></w2:column>
					<w2:column width="150" inputType="text" style="height:20px;" id="column5" value="name4" displayMode="label"></w2:column>
					<w2:column width="150" inputType="text" style="height:20px;" id="column4" value="name5" displayMode="label"></w2:column>
					<w2:column width="150" inputType="text" style="height:20px;" id="column3" value="textarea" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="150" inputType="spinner" style="height:20px" id="col1" displayMode="label" viewType="icon" disabled="true"></w2:column>
					<w2:column width="150" inputType="select" style="height:20px" id="col2" displayMode="label" disabled="true">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="value"></w2:label>
								<w2:value ref="code"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="150" inputType="text" style="height:20px" id="col3" displayMode="label" disabled="true"></w2:column>
					<w2:column width="120" inputType="text" style="height:20px" id="col4" displayMode="label" disabled="true"></w2:column>
					<w2:column width="120" inputType="text" style="height:20px" id="col5" displayMode="label" disabled="true"></w2:column>
					<w2:column width="150" inputType="textarea" style="height:20px" id="col6" displayMode="label" disabled="true"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width:128px;height:23px;margin-top:10px;" type="button">
			<xf:label><![CDATA[disabled 변경2]]></xf:label>
		</xf:trigger>
	</body>
</html>
