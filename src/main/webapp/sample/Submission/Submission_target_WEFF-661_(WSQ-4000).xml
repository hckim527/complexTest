<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dtm_data" JSONPath="result.patient">
					<w2:keyInfo>
						<w2:key id="patNm" name="name1" dataType="text"></w2:key>
						<w2:key id="patBday" name="name2" dataType="text"></w2:key>
						<w2:key id="patAge" name="name3" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
				<w2:dataMap baseNode="map" id="dtm_VO">
					<w2:keyInfo>
						<w2:key id="patId" name="name1" dataType="text"></w2:key>
						<w2:key id="recNo" name="name2" dataType="number"></w2:key>
						<w2:key id="lshap" name="name3" dataType="text"></w2:key>
						<w2:key id="lkind" name="name4" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
				<w2:dataList baseNode="list" repeatNode="map" id="dtl_data" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="patNm" name="name1" dataType="text"></w2:column>
						<w2:column id="patBday" name="name2" dataType="text"></w2:column>
						<w2:column id="patAge" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
			<xf:submission id="submission1" ref='data:json,{"id":"dtm_VO","key":"dtm_VO"}' target='data:json,{"id":"dtm_data","key":"result.patient"}'
				action="/data/submission_target_WEFF-661_(WSQ-4000).json" method="post" mediatype="application/json" encoding="UTF-8" mode="asynchronous">
			</xf:submission>
			<!-- dataList target 계층 key(요건 재현방법 dtl_data) -->
			<xf:submission id="submission2" ref='data:json,{"id":"dtm_VO","key":"dtm_VO"}' target='data:json,{"id":"dtl_data","key":"result.patient"}'
				action="/data/submission_target_WEFF-661_(WSQ-4000).json" method="post" mediatype="application/json" encoding="UTF-8" mode="asynchronous">
			</xf:submission>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = {
		"patId": "00188490",
		"recNo": "",
		"lshap": "N",
		"lkind": "A"
	};
	dtm_VO.setJSON(jsonData);
	scwin.$w.executeSubmission(submission1);
	scwin.$w.executeSubmission(submission2);
};

scwin.getList = function() {
	return JSON.stringify([dtl_data.getRowCount(), dtl_data.getCellData(0, "patNm"), dtl_data.getCellData(0, "patBday")]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:textbox style="width: 150px;height: 23px;" id="" ref="data:dtm_data.patNm"></w2:textbox>
		<w2:textbox style="width: 150px;height: 23px;" id="" ref="data:dtm_data.patBday"></w2:textbox>
		<w2:textbox style="width: 150px;height: 23px;" id="" ref="data:dtm_data.patAge"></w2:textbox>
	</body>
</html>
