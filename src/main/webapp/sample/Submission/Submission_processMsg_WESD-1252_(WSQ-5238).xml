<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:config>
			<WebSquare>
				<submission>
					<preSubmitFunction value="scwin.setReqHeader" />
				</submission>
			</WebSquare>
		</w2:config>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[2]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[4]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
			<xf:submission id="submission1" withCredentials="true" ref='data:json,{"id":"dataList1","action":"all"}' action="/posts.json" method="post"
				mediatype="application/json" encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.submission1_submitdone" abortTrigger="true">
			</xf:submission>
			<xf:submission id="submission2" ref='data:json,{"action":"all","id":"dataList2"}' action="/posts2.json" method="post" mediatype="application/json"
				encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.submission2_submitdone">
			</xf:submission>
			<!-- submission processMsg 속성 경로(요건: showProcessMessage·processMsg 둘 다) -->
			<xf:submission id="submission3" ref='data:json,{"id":"dataList1","action":"all"}' action="/posts3.json" method="post" mediatype="application/json"
				encoding="UTF-8" mode="asynchronous" processMsg="processMsg3~~~">
			</xf:submission>
			<xf:submission id="submission4" ref='data:json,{"id":"dataList2","action":"all"}' action="/posts4.json" method="post" mediatype="application/json"
				encoding="UTF-8" mode="asynchronous" processMsg="processMsg4~~~">
			</xf:submission>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	WebSquare.layer.showProcessMessage("submission1~~~");
	$p.executeSubmission("submission1");
};
scwin.trigger2_onclick = function(e) {
	WebSquare.layer.showProcessMessage("submission2~~~");
	$p.executeSubmission("submission2");
};
scwin.runSubmission = function(id) {
	$p.executeSubmission(id);
};
scwin.submission1_submitdone = function(e) {
	WebSquare.layer.hideProcessMessage("submission1~~~");
};
scwin.submission2_submitdone = function(e) {
	WebSquare.layer.hideProcessMessage("submission2~~~");
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" id="trigger1" style="position:absolute;left:175px;top:94px;width:197px;height:40px;" timeout="60000"
			ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[submission1]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position:absolute;left:178px;top:166px;width:197px;height:40px;" timeout="60000"
			ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[submission2]]></xf:label>
		</xf:trigger>
	</body>
</html>
