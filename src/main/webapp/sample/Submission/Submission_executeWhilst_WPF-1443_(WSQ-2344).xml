						<w2:key id="key1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
			<xf:submission id="submission1" ref="data:json,req" target="data:json,res" action="sample.json" method="post" mediatype="application/json"
				encoding="UTF-8" mode="asynchronous" processMsg="loading" ev:submitdone="scwin.submission1_submitdone">
			</xf:submission>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	$w.executeWhilst("submission1", condFn, 10, "loading.....", finalDone, rejectFunc, "submissionWh");
};
scwin.onpageload = function() {
	rejectFunc = function(e) {};
	finalDone = function(e) {};
	condFn = function(id, idx) {
		count = idx;
		if (id == "submission1" && idx == 10) {
			return false;
		}
		return true;
	};
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="position:relative;width:80px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[submission]]></xf:label>
		</xf:trigger>
	</body>
</html>
