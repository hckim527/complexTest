<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger5_onclick = function(e) {
	textbox1.setValue($p.getCurrentServerDate("yyyyMMddHHmmssSSS"));
};
]]></script>
	</head>
	<body>
		<xf:group style="height:71px;">
			<xf:trigger type="button" id="trigger5" style="width:180px;height:35px;" ev:onclick="scwin.trigger5_onclick">
				<xf:label><![CDATA[$p.getCurrentServerDate]]></xf:label>
			</xf:trigger>
			<w2:textbox id="textbox1" label="" style="width:250px;height:35px;"></w2:textbox>
		</xf:group>
	</body>
</html>
