// 차트에 들어간 task 목록 (process 별 개수·색상 확인용)
scwin.getTasks = function() {
	var taskArr = fwGanttChart2.chartObj.tasks.task;
	var result = [];
	for (var i = 0; i < taskArr.length; i++) {
		result.push({ processid: taskArr[i].processid, id: taskArr[i].id, color: taskArr[i].color });
	}
	return result;
};

scwin.btnTaskColor_onclick = function(e) {
	fwGanttChart2.setTasksColor("6", "000000");
	fwGanttChart2.setTasksColor("8", "000000");
	fwGanttChart2.setTasksColor("8-2", "000000");
};
]]></script>
