<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
	scwin.radio_onchange = function(info) {
		inputbox1.focus();
	};

	scwin.checkVal = function() {
		return (document.getElementById('inputbox1') || document.getElementById('mf_inputbox1')).classList.contains('w2input_focus');
	};
	]]></script>
	</head>
	<body>
		<xf:input ss_juminBunho="0" ss_keyCodeType="0 - NONE" id="inputbox1" ss_imeNative="1 - English" style="width:144px; height:21px; "
			ss_itemFlag="1 - INPUT" ss_usePlainTextOnGet="false">
		</xf:input>
		<xf:select1 ss_itemFlag="1 - INPUT" ss_keyCodeType="0 - NONE" id="radio" selectedIndex="-1" appearance="full"
			style="width:150px; height:21px; " cols="" rows="" ref="" ev:onchange="scwin.radio_onchange">
			<xf:choices>
				<xf:item>
					<xf:label><![CDATA[1]]></xf:label>
					<xf:value><![CDATA[1]]></xf:value>
				</xf:item>
				<xf:item>
					<xf:label><![CDATA[2]]></xf:label>
					<xf:value><![CDATA[2]]></xf:value>
				</xf:item>
			</xf:choices>
		</xf:select1>
	</body>
</html>
