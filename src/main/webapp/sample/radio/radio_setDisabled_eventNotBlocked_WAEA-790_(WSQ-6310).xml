<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dl_radio" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[radio_item1]]></label>
							<value><![CDATA[1]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[radio_item2]]></label>
							<value><![CDATA[2]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[radio_item3]]></label>
							<value><![CDATA[3]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dl_selectbox" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[selectbox_item1]]></label>
							<value><![CDATA[1]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[selectbox_item2]]></label>
							<value><![CDATA[2]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[selectbox_item3]]></label>
							<value><![CDATA[3]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
	scwin.btn_setDisabledTrueAll_onclick = function (e) {
		target_radio.setDisabled(true);
		target_selectbox.setDisabled(true);
		scwin.setReturnValue("[setDisabled(true) - 전체 호출] radio.getDisabled=" + target_radio.getDisabled() + " / selectbox.getDisabled=" + target_selectbox.getDisabled());
	};

	scwin.target_radio_onclick = function (e) {
		scwin.setReturnValue("=====target_radio_onclick 이벤트 발생===== (disabled : " + target_radio.getDisabled() + ")");
	};

	scwin.target_radio_onfocus = function (e) {
		scwin.setReturnValue("=====target_radio_onfocus 이벤트 발생===== (disabled : " + target_radio.getDisabled() + ")");
	};

	scwin.target_radio_onchange = function (e) {
		scwin.setReturnValue("=====target_radio_onchange 이벤트 발생===== (disabled : " + target_radio.getDisabled() + ")");
	};

	scwin.target_selectbox_onclick = function (e) {
		scwin.setReturnValue("=====target_selectbox_onclick 이벤트 발생===== (disabled : " + target_selectbox.getDisabled() + ")");
	};

	scwin.target_selectbox_onfocus = function (e) {
		scwin.setReturnValue("=====target_selectbox_onfocus 이벤트 발생===== (disabled : " + target_selectbox.getDisabled() + ")");
	};

	scwin.target_selectbox_onchange = function (e) {
		scwin.setReturnValue("=====target_selectbox_onchange 이벤트 발생===== (disabled : " + target_selectbox.getDisabled() + ")");
	};

	scwin.btn_clear_onclick = function (e) {
		tbx_return.setValue("");
	};

	scwin.setReturnValue = function (strValue) {
		tbx_return.setValue(tbx_return.getValue() + strValue);
		tbx_return.setValue(tbx_return.getValue() + "\n");
	};
	]]></script>
	</head>
	<body>
		<xf:group class="tc_body_main" id="" style="display: flex;">
			<xf:group class="tc_body_right" id="body_right">
				<xf:group id="grp_sample">
					<xf:group style="display:flex; gap:40px;" id="grp_comp" class="tc_group_basic">
						<xf:group>
							<xf:select1 id="target_radio" tabIndex="0" selectedIndex="-1" appearance="full" style="width:150px;background-color:var(--ws-gray-300);"
								ev:onclick="scwin.target_radio_onclick"
								ev:onfocus="scwin.target_radio_onfocus"
								ev:onchange="scwin.target_radio_onchange">
								<xf:choices>
									<xf:itemset nodeset="data:dl_radio">
										<xf:label ref="label"></xf:label>
										<xf:value ref="value"></xf:value>
									</xf:itemset>
								</xf:choices>
							</xf:select1>
						</xf:group>
						<xf:group>
							<xf:select1 id="target_selectbox" style="width:200px; height:30px;"
								ev:onclick="scwin.target_selectbox_onclick"
								ev:onfocus="scwin.target_selectbox_onfocus"
								ev:onchange="scwin.target_selectbox_onchange">
								<xf:choices>
									<xf:itemset nodeset="data:dl_selectbox">
										<xf:label ref="label"></xf:label>
										<xf:value ref="value"></xf:value>
									</xf:itemset>
								</xf:choices>
							</xf:select1>
						</xf:group>
					</xf:group>
				</xf:group>
				<xf:group id="grp_parameter">
					<xf:group style="display:flex; gap:10px; flex-wrap:wrap;" id="grp_etc">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_setDisabledTrueAll_onclick" id="btn_setDisabledTrueAll" label="setDisabled(true)"></w2:button>
					</xf:group>
				</xf:group>
				<xf:group id="grp_bottom">
					<xf:group id="" style="display: flex;justify-content: flex-end">
						<w2:button class="tc_btn_basic" ev:onclick="scwin.btn_clear_onclick" id="btn_clear" label="clear"></w2:button>
					</xf:group>
					<xf:textarea style="border: 1px solid var(--ws-gray-400);border-radius: 8px;width: 100%;height: 240px;" id="tbx_return" class="tc_tbx_result_1"></xf:textarea>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
