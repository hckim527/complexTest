<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dataList1">
					<w2:keyInfo>
						<w2:key id="lavel" name="라벨" dataType="text"></w2:key>
						<w2:key id="value" name="밸류" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="code" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[AD.안도라]]></label>
							<code><![CDATA[1]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[AE.아랍에미리트]]></label>
							<code><![CDATA[2]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[AF.아프가니스탄]]></label>
							<code><![CDATA[3]]></code>
						</w2:row>
						<w2:row>
							<label><![CDATA[AI.앙갈라]]></label>
							<code><![CDATA[4]]></code>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		window.flg1 = false;
		window.flg2 = false;
		// allow1/allow2 = true 이면 선택 허용(return true), 아니면 취소(return false). args1/args2 = 이벤트 인자 기록
		window.allow1 = false;
		window.allow2 = false;
		window.args1 = [];
		window.args2 = [];
	};

	scwin.radio_onbeforeselect = function(prev, next) {
		flg1 = true;
		args1.push([prev, next]);
		return allow1 === true;
	};

	scwin.radioRef_onbeforeselect = function(prev, next) {
		flg2 = true;
		args2.push([prev, next]);
		return allow2 === true;
	};

	scwin.checkVal = function() {
		return flg1 && flg2;
	};
	]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="w2tb_td" tagname="div">
			<xf:select1 appearance="full" cols="" id="radio" ref="" renderType="radiogroup" rows="" selectedIndex="-1"
				displaymessage="true" mandatory="true" tabIndex="0" ev:onbeforeselect="scwin.radio_onbeforeselect">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[부장]]></xf:label>
						<xf:value><![CDATA[0]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[차장]]></xf:label>
						<xf:value><![CDATA[1]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[과장]]></xf:label>
						<xf:value><![CDATA[2]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[대리]]></xf:label>
						<xf:value><![CDATA[3]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:select1>
			<xf:select1 appearance="full" style="width:533px;" id="radioRef" selectedIndex="-1"
				rows="" ref="data:dataList1.lavel" renderType="radiogroup" cols=""
				ev:onbeforeselect="scwin.radioRef_onbeforeselect">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[A]]></xf:label>
						<xf:value><![CDATA[0001]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[B]]></xf:label>
						<xf:value><![CDATA[0002]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[C]]></xf:label>
						<xf:value><![CDATA[0003]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[D]]></xf:label>
						<xf:value><![CDATA[0004]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[E]]></xf:label>
						<xf:value><![CDATA[0004]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:select1>
		</xf:group>
	</body>
</html>
