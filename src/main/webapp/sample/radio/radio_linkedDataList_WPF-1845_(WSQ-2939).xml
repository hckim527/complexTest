<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:linkedDataList id="linkedDataList3" bind="dataList1">
					<w2:condition type="filter"><![CDATA[col2 == val("radio1")]]></w2:condition>
					<w2:condition type="sort"><![CDATA[]]></w2:condition>
				</w2:linkedDataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.getTextCol = function(id) {
	return scwin.__getDom($p.id + id).innerText;
};
scwin.onpageload = function() {
	dataList1.setData(['a1', 'a2', 'a3', 'a1', 'a5', 'a6', 'a1', 'a12', 'a13', 'a1', 'a15', 'a16']);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="group2" style="position:relative;float:left;height:171px;">
			<xf:select1 id="radio1" cols="0" selectedIndex="-1" appearance="full" style="position: relative;width:314px;height:21px;" rows="1">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[1]]></xf:label>
						<xf:value><![CDATA[a1]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[2]]></xf:label>
						<xf:value><![CDATA[a2]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:select1>
			<w2:gridView dataList="linkedDataList3" id="gridView5" style="position: relative;width: 500px;height: 150px;" useShiftKey="true">
				<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
				<w2:header id="header2">
					<w2:row id="row3">
						<w2:column id="column11" style="height:20px" inputType="text" width="70" displayMode="label" value="name1"></w2:column>
						<w2:column id="column9" style="height:20px" inputType="text" width="70" displayMode="label" value="name2"></w2:column>
						<w2:column id="column7" style="height:20px" width="70" inputType="text" displayMode="label" value="name3"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody2">
					<w2:row id="row4">
						<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
						<w2:column id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
						<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
