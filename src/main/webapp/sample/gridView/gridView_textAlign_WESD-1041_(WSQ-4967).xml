<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
        var jsonData = [{"col1":"a", "col2":"b","col3":"c"}
                        ,{"col1":"a", "col2":"b","col3":"c"}
                        ,{"col1":"a", "col2":"b","col3":"c"}];
        dataList1.setJSON(jsonData);
        gridView1.setCellReadOnly(0,4,true);
        gridView1.setCellReadOnly(1,4,true);
        gridView1.setCellReadOnly(2,4,true);
	};
	scwin.checkVal = function() {
		return (document.getElementById('gridView1_cell_1_0') || document.getElementById('mf_gridView1_cell_1_0')).style.textAlign == 'left';
	}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" sortable="true"
			focusMode="row" setCellInputTypeCustom="true" focusFlow="linear"
			keyMoveEditMode="true"
			readOnlyTabIgnore="true"
			ignoreNonEditableCell="true" ignoreNonEditableCellTabEnter="true"
			id="gridView1" style="position: absolute ;left:28px;top:41px;width:486px;height:100px;    border: 1px solid red;" autoFit="allColumn" visibleRowNum="all"
			useShiftKey="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" footerDiv="false" inputType="text"
						width="70" value="name1" displayMode="label">
					</w2:column>
					<w2:column id="column3" footerDiv="false" inputType="text"
						width="70" value="name2" displayMode="label">
					</w2:column>
					<w2:column id="column1" footerDiv="false" width="70"
						inputType="text" value="name3" displayMode="label">
					</w2:column>
					<w2:column id="column11" footerDiv="false" width="70"
						inputType="text" value="name3" displayMode="label" hidden="true">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" footerDiv="false" inputType="text" readOnly="true" textAlign="left"
						width="70" displayMode="label">
					</w2:column>
					<w2:column id="col2" footerDiv="false" inputType="text" readOnly="true"
						width="70" displayMode="label">
					</w2:column>
					<w2:column id="col3" footerDiv="false" width="70"
						inputType="text" readOnly="true"  displayMode="label">
					</w2:column>
					<w2:column id="col4" footerDiv="false" width="70"
						inputType="text" readOnly="false"  displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
