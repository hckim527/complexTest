<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.__hasError = function() {
	var logs = WebSquare.logger.getLog();
	var hasErrorIdCol1 = logs.indexOf("id[col1]") > 0;
	var hasErrorIdCol7 = logs.indexOf("id[column7]") > 0;
	return hasErrorIdCol7 && hasErrorIdCol1;
}
]]></script>
	</head>
	<body>
		<w2:gridView dataList="dataList1" id="gridView1"
			style="position: absolute ;left:10px;top:12px;width:439px;height:283px;"
			fixedColumnWithHidden="true" useShiftKey="true" rowStatusVisible="true" useFilterList="true" autoFitFilterList="true" sortable="true"
			useCtrlOnMultisort="false" readOnly="" rowNumVisible="false">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column7" style="height:20px" inputType="text" width="85" displayMode="label"
						value="name1" useFilter="true" autoFitFilterList="true">
					</w2:column>
					<w2:column id="column7" style="height:20px" inputType="text" width="85" displayMode="label"
						value="name2" useFilter="true" autoFitFilterList="true">
					</w2:column>
					<w2:column id="column7" style="height:20px" width="85" inputType="text" displayMode="label"
						value="name3" useFilter="true" autoFitFilterList="true">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gbody">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" inputType="text" width="92" displayMode="label"></w2:column>
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
 