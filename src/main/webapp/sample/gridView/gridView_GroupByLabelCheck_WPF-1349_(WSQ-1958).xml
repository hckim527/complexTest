<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection>
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="category1" name="category1" dataType="number"/>
						<w2:column id="category2" name="category2" dataType="number"/>
						<w2:column id="category3" name="category3" dataType="number"/>
						<w2:column id="category4" name="category4" dataType="number"/>
						<w2:column id="category5" name="category5" dataType="number"/>
						<w2:column id="category6" name="category6" dataType="number"/>
						<w2:column id="category7" name="category7" dataType="number"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.grid1_ongroupby = function(options) {
	return false;
};
scwin.onpageload = function() {
	// category1 = 1~5, category2 = 1~4 가 고르게 섞인 300 Row
	var arr = [];
	for (var i = 0; i < 300; i++) {
		arr.push(i % 5 + 1, Math.floor(i / 5) % 4 + 1);
		for (var j = 2; j < 7; j++) {
			arr.push((i * (j + 3)) % 100 + 1);
		}
	}
	dataList1.setData(arr);
};
scwin.trigger1_onclick = function(e) {
	grid1.groupby({
		sortIndex: [0, 1, 2],
		sortOrder: [1, 0, 1],
		rowNumHeader: {inputType: 'expression', expression: 'toggle()+depthStr()+"    [ "+count()+" 건 ]"', align: 'left', colSpan: 9},
		rowStatusHeader: {},
		groupbyHeader: [],
		rowNumFooter: {colSpan: 7},
		rowStatusFooter: {hidden: true},
		filter: {"category1": ["1", "2", "3"], "category2": ["1", "2", "3"]},
		groupbyFooter: [{value: '합계'}, {inputType: 'expression', expression: 'SUM("category7")'}]
	});
};
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="grid1" rowNumVisible="true" rowStatusVisible="true" style="position: absolute ;left:50px;top:40px;width: 693px;height: 700px;border: 1px solid black;" groupbyZone="true" ev:ongroupby="scwin.grid1_ongroupby" filterBoxvisibleRowNum="2" groupbyFilterBox="true" groupbyFilterBoxLocation="top">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="header_category1" style="height:20px" inputType="text" width="50" value="category1"/>
					<w2:column id="header_category2" style="height:20px" inputType="text" width="50" value="category2"/>
					<w2:column id="header_category3" style="height:20px" inputType="text" width="100" value="category3"/>
					<w2:column id="header_category4" style="height:20px" inputType="text" width="150" value="category4"/>
					<w2:column id="header_category5" style="height:20px" inputType="text" width="100" value="category5"/>
					<w2:column id="header_category6" style="height:20px" inputType="text" width="100" value="category6"/>
					<w2:column id="header_category7" style="height:20px" width="100" inputType="text" value="category7"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="category1" style="height:20px" inputType="text" width="70"/>
					<w2:column id="category2" style="height:20px" inputType="text" width="70"/>
					<w2:column id="category3" style="height:20px" inputType="text" width="70"/>
					<w2:column id="category4" style="height:20px" inputType="text" width="70"/>
					<w2:column id="category5" style="height:20px" inputType="text" width="70"/>
					<w2:column id="category6" style="height:20px" inputType="text" width="70"/>
					<w2:column id="category7" style="height:20px" width="70" inputType="select">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[a]]></w2:label>
								<w2:value><![CDATA[a]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[b]]></w2:label>
								<w2:value><![CDATA[b]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[c]]></w2:label>
								<w2:value><![CDATA[c]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row2">
					<w2:column id="footer_category1" style="height:20px" inputType="text" width="70"/>
					<w2:column id="footer_category2" style="height:20px" inputType="text" width="70"/>
					<w2:column id="footer_category3" style="height:20px" inputType="text" width="70"/>
					<w2:column id="footer_category4" style="height:20px" inputType="text" width="70"/>
					<w2:column id="footer_category5" style="height:20px" inputType="text" width="70"/>
					<w2:column id="footer_category6" style="height:20px" inputType="text" width="70"/>
					<w2:column id="footer_category7" style="height:20px" width="70" inputType="expression" expression="SUM('category7')"/>
				</w2:row>
			</w2:footer>
		</w2:gridView>
		<xf:trigger id="trigger1" style="position: absolute;left:778px;top:48px;width: 150px;height: 30px;" type="button" ev:onclick="scwin.trigger1_onclick">
			<xf:label>run</xf:label>
		</xf:trigger>	</body>
</html>
