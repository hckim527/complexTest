<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.trigger6_onclick = function (e) {
	var tmpArr = [{"col1":"ff","col2":"66","col3":"f6"},{"col1":"ff1","col2":"661","col3":"f61"},{"col1":"ff12","col2":"6612","col3":"f612"}];
	dataList1.setJSON( tmpArr );
	grid1.setRowClass(0, "rowClass1");
};

scwin.trigger7_onclick = function (e) {
	dataList1.removeAll();
	var tmpArr = [{"col1":"ff","col2":"66","col3":"f6"},{"col1":"ff1","col2":"661","col3":"f61"},{"col1":"ff12","col2":"6612","col3":"f612"}];
	dataList1.setJSON( tmpArr );
	grid1.removeRowClass(0);
	grid1.setRowClass(0, "rowClass2");
};

scwin.trigger8_onclick = function (e) {
	grid1.removeRowClass(0);
};
]]></script>
		<style type="text/css"><![CDATA[
	.rowClass1 {background-color:#FFE5EF !important; }
	.rowClass2 {font-weight : bold }
]]></style>
	</head>
	<body>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="grid1" style="position:absolute;top:19px;left:22px;width:500px;height:150px;" dataList="data:dataList1">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column5" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col3" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger6" style="position:absolute;top:246px;left:51px;width:80px;height:23px;" ev:onclick="scwin.trigger6_onclick">
			<xf:label><![CDATA[1번]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger7" style="position:absolute;top:248px;left:190px;width:80px;height:23px;" ev:onclick="scwin.trigger7_onclick">
			<xf:label><![CDATA[2번]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger8" style="position:absolute;top:248px;left:353px;width:80px;height:23px;" ev:onclick="scwin.trigger8_onclick">
			<xf:label><![CDATA[3번]]></xf:label>
		</xf:trigger>
	</body>
</html>
