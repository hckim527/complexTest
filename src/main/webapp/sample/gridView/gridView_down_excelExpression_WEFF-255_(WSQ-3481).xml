<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="number"/>
						<w2:column id="col2" name="name2" dataType="number"/>
						<w2:column id="col3" name="name3" dataType="number"/>
						<w2:column id="col4" name="name4" dataType="number"/>
						<w2:column id="col5" name="name5" dataType="number"/>
						<w2:column id="col6" name="name6" dataType="number"/>
						<w2:column id="col7" name="name7" dataType="number"/>
						<w2:column id="col8" name="name8" dataType="number"/>
						<w2:column id="col9" name="name9" dataType="number"/>
						<w2:column id="col10" name="name10" dataType="number"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	var arr = [
		100, 200, 300, 400, 500,
		101, 201, 301, 401, 501,
		102, 202, 302, 402, 502,
		103, 203, 303, 403, 503,
		104, 204, 304, 404, 504,
		105, 205, 305, 405, 505,
		106, 206, 306, 406, 506,
		107, 207, 307, 407, 507
	];
	dataList1.setData(arr);
};
scwin.trigger2_onclick = function(e) {
	var opt = {
		"fileName": "excel.xlsx",
		"type": "1",
		"bodyWordwrap": "",
		"useSubTotal": false,
		"useHeader": true,
		"startRowIndex": 0,
		"startColumnIndex": 0
	};
	var infoArr = [];
	gridView1.advancedExcelDownload(opt, infoArr);
};
		]]></script>
	</head>
	<body>
		<w2:gridView defaultCellHeight="20" dataList="data:dataList1" id="gridView1" style="position: absolute ;left:20px;top:39px;width: 474px;height: 199px;" useShiftKey="true">
			<w2:caption id="caption1" value="this is a grid caption."/>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column9" width="70" inputType="text" value="name1" displayMode="label"/>
					<w2:column id="column7" width="70" inputType="text" value="name2" displayMode="label"/>
					<w2:column id="column5" width="70" inputType="text" value="name3" displayMode="label"/>
					<w2:column id="column3" width="70" inputType="text" value="name4" displayMode="label"/>
					<w2:column id="column1" inputType="text" width="70" value="name5" displayMode="label"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" dataType="number" width="70" inputType="text" displayMode="label"/>
					<w2:column id="col2" dataType="number" width="70" inputType="text" displayMode="label"/>
					<w2:column id="col3" dataType="number" excelExpression="'col1'+'col2' + 1" width="70" inputType="text" displayMode="label"/>
					<w2:column id="col4" dataType="number" width="70" inputType="text" displayMode="label"/>
					<w2:column id="col5" dataType="number" excelExpression="sum( 'col1','col2','col3')" inputType="text" width="70" displayMode="label"/>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column id="col1" dataType="number" inputType="text" width="70" value="100" displayMode="label"/>
					<w2:column id="col2" dataType="number" inputType="text" width="70" value="200" displayMode="label"/>
					<w2:column id="col3" dataType="number" excelExpression="sum('col1') + sum('col2') + 1" inputType="text" width="70" value="300" displayMode="label"/>
					<w2:column id="col4" dataType="number" inputType="text" width="70" displayMode="label"/>
					<w2:column id="col5" dataType="number" excelExpression="sum('col1':'col2':'col3')" inputType="text" width="70" displayMode="label"/>
				</w2:row>
			</w2:footer>
		</w2:gridView>
		<xf:trigger id="trigger1" style="position: absolute ;left:517px;top:43px;width:181px;height:45px;" ev:onclick="scwin.trigger1_onclick" type="button">
			<xf:label><![CDATA[데이터 조회]]></xf:label>
		</xf:trigger>
		<w2:textbox id="" style="position: absolute ;left:23px;top:7px;width: 165px;height: 27px;font-size: 22px;" label="기본그리드"></w2:textbox>
		<xf:trigger id="trigger2" style="position: absolute ;left:516px;top:96px;width:181px;height:45px;" ev:onclick="scwin.trigger2_onclick" type="button">
			<xf:label><![CDATA[엑셀다운로드]]></xf:label>
		</xf:trigger>
	</body>
</html>
