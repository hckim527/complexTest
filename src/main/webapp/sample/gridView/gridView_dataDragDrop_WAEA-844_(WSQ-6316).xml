<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var data = [];
	for (var i = 0; i < 5; i++) {
		for (var j = 1; j < 10; j++) {
			data.push(i + "_" + j);
		}
		data.push(i);
	}
	dataList1.setData(data);

	var data = [];
	for (var i = 0; i < 5; i++) {
		for (var j = 1; j < 10; j++) {
			data.push(i + "@" + j);
		}
		data.push(i);
	}
	dataList2.setData(data);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" id="" style="width:500px; height:300px;" dataList="data:dataList1" dataDragDrop="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column5" value="name1"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name2"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name3"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value="name4"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="name5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="col1"></w2:column>
					<w2:column width="70" inputType="text" id="col2"></w2:column>
					<w2:column width="70" inputType="text" id="col3"></w2:column>
					<w2:column width="70" inputType="text" id="col4"></w2:column>
					<w2:column width="70" inputType="text" id="col5"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView checkAllType="false" id="" style="width:500px; height:300px;" dataList="data:dataList2">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column5" value="name1"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name2"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name3"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value="name4"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="name5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="col1"></w2:column>
					<w2:column width="70" inputType="text" id="col2"></w2:column>
					<w2:column width="70" inputType="text" id="col3"></w2:column>
					<w2:column width="70" inputType="text" id="col4"></w2:column>
					<w2:column width="70" inputType="text" id="col5"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
