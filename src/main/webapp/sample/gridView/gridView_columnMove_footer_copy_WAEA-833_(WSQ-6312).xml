<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" removeDummyRowStatus="true" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="number"></w2:column>
						<w2:column id="col5" name="name5" dataType="number"></w2:column>
						<w2:column id="col6" name="name6" dataType="number"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
	var tmpJSON = [
		{ "col1": "행1-1", "col2": "행1-2", "col3": "행1-3", "col4": 11, "col5": 12, "col6": 13 },
		{ "col1": "행2-1", "col2": "행2-2", "col3": "행2-3", "col4": 21, "col5": 22, "col6": 23 },
		{ "col1": "행3-1", "col2": "행3-2", "col3": "행3-3", "col4": 31, "col5": 32, "col6": 33 },
		{ "col1": "행4-1", "col2": "행4-2", "col3": "행4-3", "col4": 41, "col5": 42, "col6": 43 },
		{ "col1": "행5-1", "col2": "행5-2", "col3": "행5-3", "col4": 51, "col5": 52, "col6": 53 }
	];
	dataList1.setJSON(tmpJSON);
	gridView1.setFooterData("col1", "푸터-A");
	gridView1.setFooterData("col2", "푸터-B");
	gridView1.setFooterData("col3", "푸터-C");
	gridView1.setFooterData("col4", "푸터-D");
	gridView1.setFooterData("col5", "푸터-E");
	gridView1.setFooterData("col6", "푸터-F");
};
scwin.trigger_moveColumn_onclick = function (e) {
	gridView1.setColumnOrder(["col3", "col2", "col1", "col4", "col5", "col6"]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView defaultCellHeight="20" id="gridView1"
			style="position:absolute;top:80px;left:46px;width:705px;height:300px;"
			dataList="data:dataList1"
			columnMove="true"
			columnMoveWithFooter="true"
			focusFooter="true"
			focusMode="cell"
			useShiftKey="true">
			<w2:caption id="caption1" value="[재현 샘플] columnMove + columnMoveWithFooter + 푸터 다중 셀 복사"></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="110" inputType="text" style="height:20px" id="header_col1" value="name1" displayMode="label"></w2:column>
					<w2:column width="110" inputType="text" style="height:20px" id="header_col2" value="name2" displayMode="label"></w2:column>
					<w2:column width="110" inputType="text" style="height:20px" id="header_col3" value="name3" displayMode="label"></w2:column>
					<w2:column width="90" inputType="text" style="height:20px" id="header_col4" value="name4" displayMode="label"></w2:column>
					<w2:column width="90" inputType="text" style="height:20px" id="header_col5" value="name5" displayMode="label"></w2:column>
					<w2:column width="90" inputType="text" style="height:20px" id="header_col6" value="name6" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="110" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column width="110" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
					<w2:column width="110" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
					<w2:column width="90" inputType="text" style="height:20px" id="col4" displayMode="label"></w2:column>
					<w2:column width="90" inputType="text" style="height:20px" id="col5" displayMode="label"></w2:column>
					<w2:column width="90" inputType="text" style="height:20px" id="col6" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row_footer1">
					<w2:column width="110" inputType="text" style="height:20px" id="col1"></w2:column>
					<w2:column width="110" inputType="text" style="height:20px" id="col2"></w2:column>
					<w2:column width="110" inputType="text" style="height:20px" id="col3"></w2:column>
					<w2:column width="90" inputType="text" style="height:20px" id="col4"></w2:column>
					<w2:column width="90" inputType="text" style="height:20px" id="col5"></w2:column>
					<w2:column width="90" inputType="text" style="height:20px" id="col6"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
		<xf:trigger type="button" id="trigger_moveColumn"
			style="position:absolute;top:30px;left:46px;width:220px;height:30px;"
			ev:onclick="scwin.trigger_moveColumn_onclick">
			<xf:label><![CDATA[컬럼 이동 (col1 ↔ col3)]]></xf:label>
		</xf:trigger>
	</body>
</html>
