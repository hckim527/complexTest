<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[a]]></col1>
							<col2><![CDATA[aa]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[b]]></col1>
							<col2><![CDATA[bb]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[c]]></col1>
							<col2><![CDATA[cc]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[d]]></col1>
							<col2><![CDATA[dd]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.trigger1_onclick = function(e) {
	gridView1.setColumnDisableEdit(1, true);
};
scwin.trigger2_onclick = function(e) {
	gridView1.setColumnDisableEdit(1, false);
};
scwin.fireDbClick = function(node) {
	if (document.createEventObject) {
		node.fireEvent('ondblclick');
	} else if (document.createEvent) {
		var evt = document.createEvent('MouseEvents');
		evt.initEvent('dblclick', true, false);
		node.dispatchEvent(evt);
	} else if (typeof node.ondblclick == 'function') {
		node.ondblclick();
	}
}
scwin.Dbclick = function(id) {
	var el = scwin.__getDom($p.id + id);
	scwin.fireDbClick(el);
}
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList2" defaultCellHeight="20" id="gridView1" style="position: absolute;width:207px;height:150px;" useShiftKey="true" rowNumVisible="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="select" width="70" displayMode="label">
						<w2:choices>
							<w2:itemset nodeset="data:dataList1">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col2" width="70" inputType="autoComplete" displayMode="label">
						<w2:choices>
							<w2:itemset nodeset="data:dataList1">
								<w2:label ref="col2"></w2:label>
								<w2:value ref="col1"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: absolute;width:192px;height:23px;left:211px;top:0px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setColumnDisableEdit(1, true)]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger2" style="position: absolute;width:192px;height:23px;left:211px;top:30px;" type="button" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[setColumnDisableEdit(1, false)]]></xf:label>
		</xf:trigger>
	</body>
</html>
