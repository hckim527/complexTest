<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridView1.setRowStatusColumnWidth(0);
};
scwin.trigger2_onclick = function(e) {
	gridView2.setColumnWidth("col1", 0)
};
]]></script>
	</head>
	<body>
		<w2:textbox label=" &amp;nbsp; rowStatus 컬럼 넓이 변경" id="" style="position: relative;height: 23px;font-size:14pt;font-weight:bold;"></w2:textbox>
		<w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width:471px;height:163px;border:1px solid;" useShiftKey="true" rowStatusVisible="true" rowStatusHeaderValue="rowStatus" autoFit="allColumn">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column15" style="height:20px" inputType="text" width="70" displayMode="label" value="name1"></w2:column>
					<w2:column id="column13" style="height:20px" inputType="text" width="70" displayMode="label" value="name2"></w2:column>
					<w2:column id="column11" style="height:20px" width="70" inputType="text" displayMode="label" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:241px;height:41px;margin-top:5px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setRowStatusColumnWidth(0)]]></xf:label>
		</xf:trigger>
		<w2:textbox id="" label=" &amp;nbsp;일반 컬럼 넓이 변경" style="position: relative;height: 23px;font-size:14pt;font-weight:bold;margin-top:10px;"></w2:textbox><w2:gridView autoFit="allColumn" dataList="dataList1" id="gridView2" rowStatusHeaderValue="rowStatus" rowStatusVisible="true" style="position: relative;width:471px;height:163px;border:1px solid;margin-top:5px;" useShiftKey="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column displayMode="label" id="column15" inputType="text" style="height:20px" value="name1" width="70"></w2:column>
					<w2:column displayMode="label" id="column13" inputType="text" style="height:20px" value="name2" width="70"></w2:column>
					<w2:column displayMode="label" id="column11" inputType="text" style="height:20px" value="name3" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column displayMode="label" id="col1" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayMode="label" id="col2" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayMode="label" id="col3" inputType="text" style="height:20px" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="position: relative;width:241px;height:41px;margin-top:5px;" type="button">
			<xf:label><![CDATA[setColumnWidth(0)]]></xf:label>
		</xf:trigger>
	</body>
</html>
 