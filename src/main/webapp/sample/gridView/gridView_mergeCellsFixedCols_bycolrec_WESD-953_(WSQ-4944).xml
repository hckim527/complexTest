<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:config>
			<WebSquare>
				<grid>
					<mergeCellsFixedColsFirst value="true"></mergeCellsFixedColsFirst>
				</grid>
			</WebSquare>
		</w2:config>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns="">
					<root>
						<smp>
							<smp_row><chk>홍길동</chk><name>홍길동</name><tel>110031051777</tel><tel1>11031051777</tel1><dep>1</dep></smp_row>
							<smp_row><chk>1</chk><name>홍길동</name><tel>9001011234567</tel><tel1>1232145678</tel1><dep>2</dep></smp_row>
							<smp_row><chk></chk><name>신하이포탈</name><tel>1234561234567</tel><tel1>2345678901234</tel1><dep>3</dep></smp_row>
							<smp_row><chk></chk><name>PALSU</name><tel></tel><tel1>0123456789</tel1><dep>4</dep></smp_row>
						</smp>
					</root>
				</data>
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// 스크립트 없음(config grid/mergeCellsFixedColsFirst=true 일 때 고정 Column 병합 확인용)
]]></script>
	</head>
	<body>
		<w2:grid baseNode="smp" id="grid1" repeatNode="smp_row" useShiftKey="true" style="width: 300px;height: 350px;" ref="root/smp" nodeset="root/smp" fixedColumnWithHidden="true" fixedColumn="3" mergeCellsFixedCols="bycolrec" mergeCellsFixedRows="byrowrec">
			<w2:header style="" id="header1">
				<w2:row style="" id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="h_col1" value="chk"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="h_col2" value="name"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="h_col3" value="tel"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="h_col4" value="tel1"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="h_col5" value="dep"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody style="" id="gBody1">
				<w2:row style="" id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="chk"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="name"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="tel"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="tel1"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="dep"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:grid>
	</body>
</html>
