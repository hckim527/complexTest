<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data/>
			</xf:instance>
			<w2:dataCollection>
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="han_nm" name=""/>
					</w2:columnInfo>
					<w2:data use="false"></w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridView1.setDisabled(true);
};
scwin.trigger2_onclick = function(e) {
	gridView1.setDisabled(false);
};
scwin.onpageload = function() {
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	setTimeout(function() {
		gridView1.setFocusedCell(0, 0);
	}, 100);
	gridView1.setSize("height", 138);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="height:135px;width:200px;" class="grid_01" dataList="dataList1" wheelRows="1" wheelStop="true" rowNumVisible="true" disabledScrollHidden="true">
			<w2:header>
				<w2:row>
					<w2:column id="hanNm" dataType="text" width="58" value="상담사"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody>
				<w2:row>
					<w2:column id="han_nm" dataType="text" width="58" textAlign="center"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:122px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[gridView Disable]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position: relative;width:111px;height:23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[gridView Enable]]></xf:label>
		</xf:trigger>
	</body>
</html>
 