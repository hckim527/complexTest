<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlOut" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="ctrtNo" name="Contract Number" dataType="text"></w2:column>
						<w2:column id="amdtSeq" name="Amendment Sequence" dataType="text"></w2:column>
						<w2:column id="ctrtCustNm" name="Customer" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<ctrtNo><![CDATA[SC001]]></ctrtNo>
							<amdtSeq><![CDATA[1]]></amdtSeq>
							<ctrtCustNm><![CDATA[AAA]]></ctrtCustNm>
						</w2:row>
						<w2:row>
							<ctrtNo><![CDATA[SC002]]></ctrtNo>
							<amdtSeq><![CDATA[2]]></amdtSeq>
							<ctrtCustNm><![CDATA[BBB]]></ctrtCustNm>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.getErrorLog = function() {
	return WebSquare.logger.getErrorLog();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<!-- visibleRowNum 미지정(config.xml gridView 에도 없음) + initFixedHeightByRowNum 지정 -->
		<w2:gridView class="cm_grid" dataList="data:dlOut" id="gvOut" style="height:575px;" readOnly="false" rowNumWidth="50"
			initFixedHeightByRowNum="10">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column displayMode="label" id="column50" inputType="text" value="S/C Number" width="100"></w2:column>
					<w2:column displayMode="label" id="column48" inputType="text" value="AMD." width="50"></w2:column>
					<w2:column displayMode="label" id="column46" inputType="text" value="Customer" width="170"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column displayMode="label" id="ctrtNo" inputType="text" width="100" readOnly="true"></w2:column>
					<w2:column displayMode="label" id="amdtSeq" inputType="text" width="50" readOnly="true"></w2:column>
					<w2:column displayMode="label" id="ctrtCustNm" inputType="text" width="170" textAlign="left" readOnly="true"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
