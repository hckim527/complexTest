		useFooterData: true,
		hideTrigger: true
	});
};
scwin.get_iframeValue = function(id){
	var iframe = (document.getElementById('__processbarIFrame') || document.getElementById('mf___processbarIFrame'));
	var elmnt = iframe.contentWindow.document.getElementById(id);
	return elmnt;
};
scwin.checkVal = function(){
	return scwin.get_iframeValue('hideButton').style.display == 'block';
};
]]></script>
