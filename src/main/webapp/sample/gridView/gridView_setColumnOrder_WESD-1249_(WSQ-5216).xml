<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
};
scwin.trigger1_onclick = function(e) {
	// getColumnOrder(true) 로 만든 id 배열(역순)을 setColumnOrder 파라미터로 사용
	var columnOrderArray = gridView1.getColumnOrder(true).reverse();
	scwin.before = columnOrderArray.slice();
	gridView1.setColumnOrder(columnOrderArray);
	scwin.after = columnOrderArray;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="position: absolute ;left:31px;top:9px;width: 180px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setColumnOrder]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" autoFit="allColumn" style="left: 0px;top: 46px;height: 229px;">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column9" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column7" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column5" inputType="text" width="70" value="name3"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name4"></w2:column>
					<w2:column id="column1" inputType="text" width="70" value="name5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70"></w2:column>
					<w2:column id="col2" inputType="text" width="70"></w2:column>
					<w2:column id="col3" inputType="text" width="70"></w2:column>
					<w2:column id="col4" inputType="text" width="70"></w2:column>
					<w2:column id="col5" inputType="text" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
