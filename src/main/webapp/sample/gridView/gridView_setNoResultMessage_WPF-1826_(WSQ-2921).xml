	var jsonData = [];
	dataList1.setJSON(jsonData);
}
scwin.trigger1_onclick = function(e) {
	var jsonData = [];
	dataList2.setJSON(jsonData);
};
scwin.trigger2_onclick = function(e) {
	grd3.setNoResultMessage("test");
};
scwin.trigger3_onclick = function(e) {
	grp1.show();
};
scwin.trigger4_onclick = function(e) {
	grd2.setNoResultMessage("test2");
};
scwin.onpageload = function() {
	scwin.init();
};
]]></script>
