<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[2]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[4]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[5]]></col1>
							<col2><![CDATA[6]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[7]]></col1>
							<col2><![CDATA[8]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[9]]></col1>
							<col2><![CDATA[10]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[a]]></col1>
							<col2><![CDATA[b]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[c]]></col1>
							<col2><![CDATA[d]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[e]]></col1>
							<col2><![CDATA[f]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<w2:gridView id="" style="width: 500px;height: 150px;" defaultCellHeight="20" dataList="data:dataList1" dataDragDrop="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column2" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="name2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView dataList="data:dataList2" defaultCellHeight="20" id="" style="width: 500px;height: 150px;margin-top: 10px;border : 1px solid black;" dataDragDrop="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="column2" inputType="text" style="height:20px" value="name1" width="70"></w2:column>
					<w2:column displayMode="label" id="column1" inputType="text" style="height:20px" value="name2" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="col1" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayMode="label" id="col2" inputType="text" style="height:20px" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
