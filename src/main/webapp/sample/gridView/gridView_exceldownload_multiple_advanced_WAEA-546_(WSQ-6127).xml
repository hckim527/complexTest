<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="d1_col1" name="필드1" dataType="text"/>
						<w2:column id="d1_col2" name="필드2" dataType="text"/>
						<w2:column id="d1_col3" name="name3" dataType="text"/>
						<w2:column id="d1_col4" name="name4" dataType="text"/>
						<w2:column id="do1_col5" name="name5" dataType="text"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var num = 10000;
	var arr = [];
	for (var i = 0; i < num; i++) {
		for (var j = 0; j < 5; j++) {
			arr[i * 5 + j] = "dataList1_" + i + j;
		}
	}
	dataList1.setData(arr);
};
scwin.trigger1_onclick = function(e) {
	var options = {
		common: {
			fileName: "multipleDataListDownload.xlsx"
		},
		excelInfo: [
			{
				dataListId: "dataList1",
				sheetName: "첫번째 sheet",
				foldColumns: "1,2",
				removeColumns: ""
			}
		]
	};
	WebSquare.util.multipleDataListDownload(options);
};
scwin.trigger13_onclick = function(e) {
	var options = {
		type: "1",
		fileName: "advancedExcelDownload.xlsx",
		foldColumns: "1,2"
	};
	gridView1.advancedExcelDownload(options);
};
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="position:absolute;left:47px;top:34px;width:192px;height:37px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[multipleDataListDownload]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="data:dataList1" applyAllColumnStyle="false" defaultCellHeight="20" id="gridView1" style="position: absolute ;left:52px;top:126px;width: 415px;height: 278px;" syncScroll="false" summaryOnlyAuto="false" useShiftKey="true" columnMove="true">
			<w2:caption id="caption1" value="this is a grid caption."/>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column9" inputType="text" width="70" value="name1" displayMode="label"/>
					<w2:column id="column7" inputType="text" width="70" value="name2" displayMode="label"/>
					<w2:column id="column5" inputType="text" width="70" value="name3" displayMode="label"/>
					<w2:column id="column3" inputType="text" width="70" value="name4" displayMode="label"/>
					<w2:column id="column1" width="70" inputType="text" value="name5" displayMode="label"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="d1_col1" inputType="text" width="70" value="" displayMode="label" colMerge="false"/>
					<w2:column id="d1_col2" inputType="text" width="70" value="" displayMode="label"/>
					<w2:column id="d1_col3" inputType="text" width="70" value="" displayMode="label"/>
					<w2:column id="d1_col4" inputType="text" width="70" value="" displayMode="label"/>
					<w2:column id="do1_col5" width="70" inputType="text" value="" displayMode="label"/>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger13" style="position:absolute;left:375px;top:34px;width:204px;height:37px;" ev:onclick="scwin.trigger13_onclick">
			<xf:label><![CDATA[advancedExcelDownload]]></xf:label>
		</xf:trigger>
	</body>
</html>
