<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{"col1":"a1"},{"col1":"a2"},{"col1":"a3"},{"col1":"a4"}];
	dataList1.setJSON(jsonData);
	gridView1.setCellStyle(0, "col3", "background-color", "pink");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">

		<w2:gridView checkAllType="false" id="gridView1" rowMouseOverColor="red" style="width: 500px;height: 150px;" dataList="data:dataList1" rowMouseOverSkipColoredCells="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column12" value="name1"></w2:column>
					<w2:column width="70" inputType="text" id="column11" value="name2"></w2:column>
					<w2:column width="70" inputType="text" id="column10" value="name3"></w2:column>
					<w2:column width="70" inputType="text" id="column9" value="name4"></w2:column>
					<w2:column width="70" inputType="text" id="column8" value="name5"></w2:column>
					<w2:column width="70" inputType="text" id="column7" value="name6"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" style="color:yellow;font-size: 20pt;background-color: pink;" inputType="text" id="col1"></w2:column>
					<w2:column width="70" inputType="text" id="col2"></w2:column>
					<w2:column width="70" inputType="text" id="col3"></w2:column>
					<w2:column width="70" inputType="text" id="col4"></w2:column>
					<w2:column width="70" inputType="text" id="col5"></w2:column>
					<w2:column width="70" inputType="text" id="col6"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
