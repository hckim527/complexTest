<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" removeDummyRowStatus="true" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="number"></w2:column>
						<w2:column id="col5" name="name5" dataType="number"></w2:column>
						<w2:column id="col6" name="name6" dataType="number"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
	var tmpJSON = [];
	for (var i = 0; i < 28; i++) {
		var v = String((i % 4 + 1) * 10);
		tmpJSON.push({ "col1": "10", "col2": v, "col3": v, "col4": v, "col5": v, "col6": v });
	}
	dataList1.setJSON(tmpJSON);
};

scwin.trigger1_onclick = function (e) {
	var options = {
		advancedHidden: 1,
		wframe : true
	};
	gridView1.advancedExcelUpload(options);
};

// 비교: advancedHidden 미적용(0)
scwin.trigger2_onclick = function (e) {
	gridView1.advancedExcelUpload({ advancedHidden: 0, wframe: true });
};

scwin.checkVal = function() {
	return (document.getElementById('gridView1_excelPop_wframe_advancedSetting') || document.getElementById('mf_gridView1_excelPop_wframe_advancedSetting')).style.display == 'none';
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="position:absolute;top:31px;left:46px;width:705px;height:419px;" dataList="data:dataList1"
			mergeCells="byrow" drawType="virtual">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column6" displayMode="label" excelwidth="200" fixColumnWidth="true"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name2" displayMode="label" excelwidth="200"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name3" displayMode="label" excelwidth="600"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name4" displayMode="label" excelwidth="800"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column2" value="name5" displayMode="label" excelwidth="200"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="name6" displayMode="label" excelwidth="200"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label" editModeEvent="onclick" colMerge="true"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label" colMerge="true"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label" colMerge="true"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4" displayMode="label" colMerge="true"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col5" displayMode="label" colMerge="true"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col6" displayMode="label" colMerge="true"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position:absolute;top:134px;left:801px;width:199px;height:23px;"
			ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[advancedExcelUpload]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position:absolute;top:164px;left:801px;width:199px;height:23px;"
			ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[advancedHidden 0 (비교)]]></xf:label>
		</xf:trigger>
	</body>
</html>
