<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.viewChangeLog = [];
scwin.onpageload = function() {
	var rows = [];
	for (var i = 0; i < 20; i++) {
		rows.push({"col1": "r" + i});
	}
	dataList1.setJSON(rows);
};
scwin.gridView1_onviewchange = function(info) {
	scwin.viewChangeLog.push(info.rowIndex + ":" + info.colIndex + ":" + info.newValue);
	txt.setValue("");
	txt.setValue(info.newValue);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width:324px;height:150px;" useShiftKey="true" ev:onviewchange="scwin.gridView1_onviewchange">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column17" style="height:20px" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column15" style="height:20px" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column13" style="height:20px" inputType="text" width="70" value="name3"></w2:column>
					<w2:column id="column11" style="height:20px" inputType="text" width="70" value="name4"></w2:column>
					<w2:column id="column9" style="height:20px" inputType="text" width="70" value="name5"></w2:column>
					<w2:column id="column7" style="height:20px" inputType="text" width="70" value="name6"></w2:column>
					<w2:column id="column5" style="height:20px" inputType="text" width="70" value="name7"></w2:column>
					<w2:column id="column3" style="height:20px" inputType="text" width="70" value="name8"></w2:column>
					<w2:column id="column1" style="height:20px" width="70" inputType="text" value="name9"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col3" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col4" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col5" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col6" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col7" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col8" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col9" style="height:20px" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:textbox label="" id="txt" style="position: relative;width: 150px;height: 23px;"></w2:textbox>
	</body>
</html>
