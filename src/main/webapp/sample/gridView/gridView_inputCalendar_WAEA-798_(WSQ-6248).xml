<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<w2:gridView checkAllType="false" id="" style="width: 500px;height: 150px;" dataList="data:dataList1" editModeEvent="onclick">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column7" value="name1"></w2:column>
					<w2:column width="70" inputType="text" id="column6" value="name2"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="name3"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name4"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column renderType="native" showCalendarOnFocus="true" width="70" inputType="calendar" id="col1"></w2:column>
					<w2:column renderType="native" showCalendarOnFocus="true" width="70" inputType="calendar" id="col2"></w2:column>
					<w2:column renderType="native" showCalendarOnFocus="true" width="70" inputType="calendar" id="col3"></w2:column>
					<w2:column renderType="native" showCalendarOnFocus="true" width="70" inputType="calendar" id="col4"></w2:column>
					<w2:column renderType="native" showCalendarOnFocus="true" width="70" inputType="calendar" id="col5"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
