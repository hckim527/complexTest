	return (document.getElementById('gridview1_cell_0_0') || document.getElementById('mf_gridview1_cell_0_0')).innerText == '22-01 2024';
};
scwin.checkVal2 = function() {
	return (document.getElementById('gridview2_cell_0_0_text') || document.getElementById('mf_gridview2_cell_0_0_text')).value == '22-01 2024';
};
scwin.checkVal3 = function() {
