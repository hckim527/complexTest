<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="ID" name="ID"/>
						<w2:column dataType="text" id="ID2" name="ID2"/>
						<w2:column dataType="text" id="Date" name="Date"/>
						<w2:column dataType="text" id="Date2" name="Date2"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var json = [
		{"ID": "12345678", "ID2": "1234567890123", "Date": "20190719", "Date2": "20230510"},
		{"ID": "", "ID2": "", "Date": "", "Date2": ""}
	];
	dataList1.setJSON(json);
};

scwin.trigger_excel_onclick = function (e) {
	var options = {
		fileName : "excelDownload_test.xlsx",
		type : 1
	};
	var infoArr = [];

	gridView1.advancedExcelDownload( options, infoArr );
};
		]]></script>
		<style type="text/css"><![CDATA[
		.gridBodyDefault{
			font-size:16px;
			border:1px solid #cbd1d4;
			font-family: 'Consolas', 'Courier New', monospace;
			padding: 0 10px;
			letter-spacing: 0.05em;
			text-align: center;
		}
		.w2inputCalendar_divInput{
			font-size:16px;
			font-family: 'Consolas', 'Courier New', monospace;
			letter-spacing: 0.05em;
			text-align: center;
		}
		.w2input{
			font-size:16px;
			font-family: 'Consolas', 'Courier New', monospace;
			letter-spacing: 0.05em;
			text-align: center;
		}
		.w2grid .w2grid_embedded_input{
			font-family: 'Consolas', 'Courier New', monospace;
		}
		]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger_excel" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger_excel_onclick">
			<xf:label><![CDATA[excelDown]]></xf:label>
		</xf:trigger>
		<xf:group class="sub_cont" id="" style="padding:10px">
			<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dataList1" defaultCellHeight="40" id="gridView1" rowNumVisible="" style="width:920px;height: 200px;margin-top: 50px;" visibleRowNum="5" editFormatGetCellDisplayData="true">
				<w2:caption id="caption2" value="this is a grid caption."/>
				<w2:header id="header2">
					<w2:row id="row3">
						<w2:column width="230" inputType="text" style="height:20px" id="column20" value='inputType="text"  editFormat= "{####}||####-####||{####}-####-{####}"  editDisplayChar="*"' displayMode="label"/>
						<w2:column width="230" inputType="text" style="height:20px" id="column29" value='inputType="text"  editFormat="######-#{######}"  editDisplayChar="*"  editPlaceholderChar="_"' displayMode="label"/>
						<w2:column width="230" inputType="text" style="height:20px" id="column12" value='inputType="calendar"  displayFormat="yyyy.MM.dd"  useEditFormat="true"' displayMode="label"/>
						<w2:column width="230" inputType="text" style="height:20px" id="column22" value='inputType="calendar"  displayFormat="yyyy.MM.dd"  useEditFormat="true"  editPlaceholderChar="_"' displayMode="label"/>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody2">
					<w2:row id="row4">
						<w2:column width="230" inputType="text" style="height:40px" id="ID" displayMode="label" editFormat="{####}||####-####||{####}-####-{####}" editFormatParticalMask="true" editDisplayChar="*"/>
						<w2:column width="230" inputType="text" style="height:40px" id="ID2" displayMode="label" editFormat="######-#{######}" editFormatParticalMask="true" editPlaceholderChar="_" editDisplayChar="*"/>
						<w2:column width="230" inputType="calendar" style="height:40px" id="Date" displayMode="label" viewType="icon" calendarValueType="yearMonthDate" displayFormat="yyyy.MM.dd" useEditFormat="true" editPlaceholderChar=""/>
						<w2:column width="230" inputType="calendar" style="height:40px" id="Date2" displayMode="label" viewType="icon" calendarValueType="yearMonthDate" displayFormat="yyyy.MM.dd" useEditFormat="true" editPlaceholderChar="_"/>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
