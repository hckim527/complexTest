<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
						<w2:column id="col10" name="name10" dataType="text"></w2:column>
						<w2:column id="col11" name="name11" dataType="text"></w2:column>
						<w2:column id="col12" name="name12" dataType="text"></w2:column>
						<w2:column id="col13" name="name13" dataType="text"></w2:column>
						<w2:column id="col14" name="name14" dataType="text"></w2:column>
						<w2:column id="col15" name="name15" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var data = [];
    for (var i = 0; i < 50; i++) {
        for (var j = 0; j < 15; j++) {
            data.push(j + i * 15);
        }
    }
    dataList1.setData(data);
};	
]]></script>
	<style type="text/css"><![CDATA[
        .w2grid_fixedColumn_td {
            background-color:yellow;
        }
        .w2grid_fixedRightColumn_td {
            background-color:blue;
        }
        ]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group>
			<w2:gridView checkAllType="false" defaultCellHeight="20" id="grid1" style="width: 800px;height: 500px;" dataList="data:dataList1"
				fixedColumn="3" fixedRightColumn="3" fixedRow="2" lastFixedRow="2" rowNumVisible="true" rowStatusVisible="true">
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column width="70" inputType="text" id="column1" value="name1" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column2" value="name2" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column3" value="name3" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column4" value="name4" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column5" value="name5" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column6" value="name6" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column7" value="name7" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column8" value="name8" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column9" value="name9" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column10" value="name10" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column11" value="name11" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column12" value="name12" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column13" value="name13" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column14" value="name14" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column15" value="name15" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col3" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col4" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col5" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col6" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col7" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col8" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col9" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col10" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col11" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col12" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col13" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col14" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col15" displayMode="label"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
