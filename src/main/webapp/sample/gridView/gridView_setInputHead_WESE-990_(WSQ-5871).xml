<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" removeDummyRowStatus="true" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="1" name="name1" dataType="text"></w2:column>
						<w2:column id="2" name="name2" dataType="text"></w2:column>
						<w2:column id="3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
	var tmpJSON = [
		{ "1": "1", "2": "원", "3": "하나" },
		{ "1": "2", "2": "투", "3": "하나" },
		{ "1": "3", "2": "쓰리", "3": "삼" },
		{ "1": "4", "2": "포", "3": "넷" },
		{ "1": "5", "2": "파이브", "3": "오" }
	];
	dataList1.setJSON(tmpJSON);
};

scwin.gridView1_onheaderclick = function (headerId) {
	gridView1.setInputHead(document.getElementById("mf_gridView1_" + headerId) || document.getElementById("gridView1_" + headerId));
};

scwin.checkVal1 = function () {
	return (document.getElementById('gridView1_column3') || document.getElementById('mf_gridView1_column3')).querySelector('input').getAttribute('title') == '입력하세요';
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;" checkAllType="false" scrollByColumn="false" defaultCellHeight="20"
			scrollByColumnAdaptive="false" dataList="data:dataList1" ev:onheaderclick="scwin.gridView1_onheaderclick">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="210" inputType="text" id="column4" value="header" displayMode="label" colSpan="3"></w2:column>
				</w2:row>
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column3" title="입력하세요" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value='&lt;span style="color : red;"&gt;*&lt;/span&gt; name2' displayMode="label" escape="true"></w2:column>
					<w2:column width="70" inputType="select" title="입력하세요" id="column1" value="name3" displayMode="label">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[new row1]]></w2:label>
								<w2:value><![CDATA[1]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[new row2]]></w2:label>
								<w2:value><![CDATA[2]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[new row3]]></w2:label>
								<w2:value><![CDATA[3]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="2" displayMode="label" embeddedInput="true"></w2:column>
					<w2:column width="70" inputType="text" id="3" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
