<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[col1_1]]></col1>
							<col2><![CDATA[col2_1]]></col2>
							<col3><![CDATA[col3_1]]></col3>
							<col4><![CDATA[col4_1]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[col1_2]]></col1>
							<col2><![CDATA[col2_2]]></col2>
							<col3><![CDATA[col3_2]]></col3>
							<col4><![CDATA[col4_2]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[col1_3]]></col1>
							<col2><![CDATA[col2_3]]></col2>
							<col3><![CDATA[col3_3]]></col3>
							<col4><![CDATA[col4_3]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[col1_4]]></col1>
							<col2><![CDATA[col2_4]]></col2>
							<col3><![CDATA[col3_4]]></col3>
							<col4><![CDATA[col4_4]]></col4>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	// 일부 Column 에 배경색 설정
	target1.setColumnBackgroundColor("col1", "red");
	target1.setColumnColor("col1", "blue");

	// Column ID 설정
	console.log(target1.getColumnBackgroundColor("col1"));
	console.log(target1.getColumnColor("col1"));

	// Column Index 설정
	console.log(target1.getColumnBackgroundColor(0));
	console.log(target1.getColumnColor(0));
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" id="target1" style="width:500px; height:311px;" dataList="data:dataList1" evenRowBackgroundColor="" oddRowBackgroundColor="" oddEvenColorDisplay="">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="hd1" value="header1"></w2:column>
					<w2:column width="70" inputType="text" id="hd2" value="header2"></w2:column>
					<w2:column width="70" inputType="text" id="hd3" value="header3"></w2:column>
					<w2:column width="70" inputType="text" id="hd4" value="header4"></w2:column>
				</w2:row>
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="hd5" value="header5"></w2:column>
					<w2:column width="70" inputType="text" id="hd6" value="header6"></w2:column>
					<w2:column width="70" inputType="text" id="hd7" value="header7"></w2:column>
					<w2:column width="70" inputType="text" id="hd8" value="header8"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="col1"></w2:column>
					<w2:column width="70" inputType="text" id="col2"></w2:column>
					<w2:column width="70" inputType="text" id="col3"></w2:column>
					<w2:column width="70" inputType="text" id="col4"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column8" value="footer1"></w2:column>
					<w2:column width="70" inputType="text" id="column7" value="footer2"></w2:column>
					<w2:column width="70" inputType="text" id="column6" value="footer3"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="footer4"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
	</body>
</html>
