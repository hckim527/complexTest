<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
	dataList1.setJSON([
		{ "col1": "a", "col2": "b", "col3": "c", "col4": "d", "col5": "e", "col6": "f" },
		{ "col1": "aa", "col2": "bb", "col3": "cc", "col4": "dd", "col5": "ee", "col6": "ff" }
	]);
};

scwin.checkVal = function () {
	let elements = document.querySelectorAll('[class^="w2grid_textImage_"]');
	let tagNm = elements[1].tagName;
	return tagNm === 'DIV';
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group>
			<w2:textbox label="gridView textImage renderType div" style="width: 250px;height: 23px;"></w2:textbox>
		</xf:group>
		<xf:group>
			<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1" style="position: relative;width: 910px;height: 156px;" fixedColumnWithHidden="true" rowNumVisible="true" useShiftKey="false">
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column id="column1" style="height:20px;" inputType="text" width="50" value="text "></w2:column>
						<w2:column id="column2" style="height:20px;" inputType="text" width="150" value="textImage table"></w2:column>
						<w2:column id="column3" style="height:20px;" inputType="text" width="150" value="textImage div"></w2:column>
						<w2:column id="column4" style="height:20px;" inputType="text" width="150" value="textImage div img left"></w2:column>
						<w2:column id="column5" style="height:20px;" inputType="text" width="150" value="embedded textImage"></w2:column>
						<w2:column id="column6" style="height:20px;" inputType="text" width="150" value="embedded textImage left"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="col1" style="height:20px" width="150" inputType="text"></w2:column>
						<w2:column id="col2" style="height:20px" width="150" inputType="textImage" imageSrc="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" imageWidth="17" viewType="icon"></w2:column>
						<w2:column id="col3" style="height:20px" width="150" inputType="textImage" imageSrc="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" imageWidth="17" viewType="icon" textImageRenderType="div"></w2:column>
						<w2:column id="col4" style="height:20px" width="150" inputType="textImage" imageSrc="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" imageWidth="17" viewType="icon" textImageRenderType="div" imageAlign="left" class="test"></w2:column>
						<w2:column id="col5" style="height:20px" width="150" inputType="textImage" imageSrc="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" imageWidth="17" viewType="icon" textImageRenderType="div" embeddedInput="true"></w2:column>
						<w2:column id="col6" style="height:20px" width="150" inputType="textImage" imageSrc="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" imageWidth="17" viewType="icon" textImageRenderType="div" embeddedInput="true" imageAlign="left" class="test"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
