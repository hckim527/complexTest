<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	dataList1.insertJSON(0, jsonData2);
};
scwin.onpageload = function() {
	// 400건 조회(jsonData1) 후 trigger1 로 400건(jsonData2) 앞에 추가
	window.jsonData1 = [];
	window.jsonData2 = [];
	for (var i = 0; i < 400; i++) {
		jsonData1.push({ col1: i + "", col2: i + 'sample' });
		jsonData2.push({ col1: i + "", col2: i + 'sample2' });
	}
	dataList1.setJSON(jsonData1);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" defaultCellHeight="20" id="" style="position: relative;width: 500px;height: 150px;" useShiftKey="true" rowNumVisible="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" weekStartsOn="5" inputType="calendar" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[]]></xf:label>
		</xf:trigger>
	</body>
</html>
