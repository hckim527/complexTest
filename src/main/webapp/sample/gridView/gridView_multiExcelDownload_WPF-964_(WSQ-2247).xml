<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dataList1" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="text"/>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dataList2" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="text"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setJSON([
		{"col1":"a","col2":"1000"},
		{"col1":"a","col2":"1000"},
		{"col1":"b","col2":"2000"},
		{"col1":"c","col2":"3000"},
		{"col1":"d","col2":"4000"}
	]);
	dataList2.setJSON([
		{"col1":"a","col2":"100"},
		{"col1":"b","col2":"200"},
		{"col1":"c","col2":"300"},
		{"col1":"d","col2":"400"}
	]);
};
scwin.trigger1_onclick = function(e) {
	var options = {
		common: {
			fileName: "user.xls",
			showProcess: true,
			printSet: {
				landScape: "true",
				fitToPage: "true",
				fitWidth: "4",
				fitHeight: "333",
				scale: "222"
			}
		},
		excelInfo: [
			{
				gridId: "gridView1",
				sheetName: "첫번째 sheet",
				type: "1",
				removeColumns: "",
				foldColumns: "2",
				startRowIndex: 3,
				startColumnIndex: 0,
				headerColor: "#DBEEF3",
				bodyColor: "#92CDDC",
				infoArr: [{rowIndex: 1, colIndex: 3, rowSpan: 1, colSpan: 2, text: "데이터표시1", textAlign: "center"}],
				useSubTotal: "true",
				colMerge: "true"
			},
			{
				gridId: "gridView2",
				sheetName: "두번째 sheet",
				type: "1",
				removeColumns: "",
				foldColumns: "2",
				startRowIndex: 3,
				startColumnIndex: 0,
				headerColor: "#DBEEF3",
				bodyColor: "#92CDDC",
				infoArr: [{rowIndex: 1, colIndex: 3, rowSpan: 1, colSpan: 2, text: "데이터표시2", textAlign: "center"}],
				useSubTotal: "true",
				colMerge: "true"
			}
		]
	};
	WebSquare.util.multipleExcelDownload(options);
};
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" style="position: relative ;left:18px;top:20px;width:262px;height:249px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" style="height:20px" inputType="text" width="70" value="name1"/>
					<w2:column id="column1" style="height:20px" width="70" inputType="text" value="name2"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" colMerge="true"/>
					<w2:column id="col2" style="height:20px" width="70" inputType="text"/>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal1" targetColumnID="col1">
				<w2:row id="row2">
					<w2:column id="column5" style="height:20px" width="70" inputType="text" displayMode="label"/>
					<w2:column id="column4" style="height:20px" width="70" inputType="expression" displayMode="label" expression="sum('col2')"/>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
		<w2:gridView dataList="dataList2" id="gridView2" style="position: relative ;left:22px;top:18px;width:275px;height:234px;margin-top:95px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header5">
				<w2:row id="row6">
					<w2:column id="column11" style="height:20px" inputType="text" width="70" displayMode="label" value="name1"/>
					<w2:column id="column7" style="height:20px" width="70" inputType="text" displayMode="label" value="name2"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody8">
				<w2:row id="row9">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label" colMerge="true"/>
					<w2:column id="col2" style="height:20px" width="70" inputType="text" displayMode="label"/>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal13" targetColumnID="col1">
				<w2:row id="row14">
					<w2:column id="column16" style="height:20px" width="70" inputType="text" displayMode="label"/>
					<w2:column id="column15" style="height:20px" width="70" inputType="expression" displayMode="label" expression="sum('col2')"/>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="width:202px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[gridView1,gridView2 같이 받기 ]]></xf:label>
		</xf:trigger>
	</body>
</html>
