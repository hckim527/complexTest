<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[col1]]></col1>
							<col2><![CDATA[col2]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[col3]]></col1>
							<col2><![CDATA[col4]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// dataType="float" Column 편집 중에도 기능키 keydown 이벤트 발생 → 누른 키 이름을 alert 로 표시
scwin.gridView1_onkeydown = function(e) {
	alert(e.key);
};
]]></script>
	</head>
	<body>
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;" defaultCellHeight="20" dataList="data:dataList1" ev:onkeydown="scwin.gridView1_onkeydown">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="컬럼1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="컬럼2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label" dataType="float"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
