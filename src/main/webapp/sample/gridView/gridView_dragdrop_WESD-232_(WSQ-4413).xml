<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlTmpList1">
					<w2:columnInfo>
						<w2:column id="chk" name="choice" dataType="text" ignoreStatus="true"></w2:column>
						<w2:column id="menuCd" name="Menu Code" dataType="text"></w2:column>
						<w2:column id="menuCdNm" name="Menu Name" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dlTmpList2">
					<w2:columnInfo>
						<w2:column id="chk" name="choice" dataType="text" ignoreStatus="true"></w2:column>
						<w2:column id="menuCd" name="Menu Code" dataType="text"></w2:column>
						<w2:column id="menuCdNm" name="Menu Name" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dlTmpList1.setJSON([
		{ "menuCdNm": "AAA" }, { "menuCdNm": "BBB" }, { "menuCdNm": "CCC" }, { "menuCdNm": "DDD" }, { "menuCdNm": "EEE" }
	]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:textbox id="" label="그리드 드래그" tagname="h2"></w2:textbox>
		<w2:gridView id="gvGridList1" style="height: 150px;" dataList="data:dlTmpList1" rowStatusVisible="true" dataDragDrop="true" readOnly="true" autoFit="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="30" inputType="checkbox" id="column23" value="choice"></w2:column>
					<w2:column width="200" id="column21" value="Menu Code"></w2:column>
					<w2:column width="100" id="column19" value="Menu Name"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="30" inputType="checkbox" id="chk" trueValue="Y" falseValue="N" valueType="other"></w2:column>
					<w2:column width="200" id="menuCd"></w2:column>
					<w2:column width="100" id="menuCdNm"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:textbox id="" label="그리드 드랍(데이터 없는 GridView)" tagname="h2"></w2:textbox>
		<w2:gridView id="gvGridList2" style="height: 150px;" dataList="data:dlTmpList2" rowStatusVisible="true" dataDragDrop="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="30" inputType="checkbox" id="column23" value="choice"></w2:column>
					<w2:column width="200" id="column21" value="Menu Code"></w2:column>
					<w2:column width="100" id="column19" value="Menu Name"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="30" inputType="checkbox" id="chk" trueValue="Y" falseValue="N" valueType="other"></w2:column>
					<w2:column width="200" id="menuCd"></w2:column>
					<w2:column width="100" id="menuCdNm"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
