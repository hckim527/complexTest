<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.getType = function(info) {
	var rowIndex = info.rowIndex;
	var colIndex = info.colIndex;
	var returnInfo;
	if (dataList1.getCellData(rowIndex, "col2") == 1) {
		returnInfo = {
			id: "dynamic_radio_" + rowIndex + "_" + colIndex,
			inputType: "radio",
			options: {}
		};
	} else {
		returnInfo = {
			id: "dynamic_text_" + rowIndex + "_" + colIndex,
			inputType: "text"
		};
	}
	return returnInfo;
};

scwin.grd_onviewchange = function(info) {
	grd.refreshRow(info.rowIndex);
};

scwin.trigger1_onclick = function(e) {
	alert(dataList1.getAllArray().data);
};

scwin.onpageload = function() {
	dataList1.setJSON([
		{ "col2": "1" },
		{ "col2": "1" },
		{ "col2": "1" },
		{ "col2": "2" },
		{ "col2": "a3" },
		{ "col2": "1" }
	]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="grd" style="position: absolute;width: 500px;height: 600px;" useShiftKey="true"
			ev:onviewchange="scwin.grd_onviewchange">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column1" inputType="text" width="70" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="custom" width="70" typeGetter="scwin.getType"></w2:column>
					<w2:column id="col2" inputType="text" width="70"></w2:column>
					<w2:column id="col3" inputType="text" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:184px;height:25px;left:500px;top:9px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[dataList1.getAllArray().data]]></xf:label>
		</xf:trigger>
	</body>
</html>
