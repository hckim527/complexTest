<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="chkYn" name="체크박스" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
};
scwin.evLog = [];
scwin.gridView_onviewchange = function(info) {
    scwin.evLog.push([info.rowIndex, info.colIndex, info.oldValue, info.newValue]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" checkOnCellClick="true" ev:onviewchange="scwin.gridView_onviewchange" style="position: absolute ;left: 57px;top: 52px;width: 514px;height: 304px;">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="checkbox" width="70" value="체크박스" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column blockSelect="true" id="chkYn" inputType="checkbox" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
