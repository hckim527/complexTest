<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="Continent" name="Continent"></w2:column>
						<w2:column dataType="text" id="Country" name="Country"></w2:column>
						<w2:column dataType="text" id="Item" name="Item"></w2:column>
						<w2:column dataType="text" id="Quantity" name="Quantity"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.incLog = [];
scwin.onpageload = function() {
	var json = [
		{"Continent" : "Asia", "Country" : "China", "Item" : "TV", "Quantity" : "400"},
		{"Continent" : "Asia", "Country" : "China", "Item" : "Freezer", "Quantity" : "300"},
		{"Continent" : "Asia", "Country" : "China", "Item" : "Washer", "Quantity" : "100"},
		{"Continent" : "Asia", "Country" : "Japan", "Item" : "TV", "Quantity" : "100"},
		{"Continent" : "Asia", "Country" : "Japan", "Item" : "Freezer", "Quantity" : "300"},
		{"Continent" : "Asia", "Country" : "Japan", "Item" : "Washer", "Quantity" : "200"}
	];
	dataList1.setJSON(json);
};
scwin.button1_onclick = function() {
	gridView1.setColumnIncrement("Quantity", 0.1);
};
scwin.button2_onclick = function() {
	scwin.incLog.push(gridView1.getColumnIncrement("Quantity"));
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 500px;height: 400px;margin: 20px;" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" dataList="data:dataList1" autoFit="allColumn" visibleRowNum="" useShiftKey="true" dataDragDrop="true" focusMode="both" dataDragDropStatus="true" showSortableImage="true" autoFitMinWidth="100" cellStatusIconPosition="left" cellStatusVisible="true" hammerEnabled="true" checkEditOnPaste="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="Country" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column2" value="Item" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="Quantity" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="Country" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="Item" displayMode="label"></w2:column>
					<w2:column width="70" inputType="spinner" style="height:20px;" id="Quantity" displayMode="label" blockSelect="true" min="100" max="400" increment="0.5"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:button style="width:250px;height:40px;display:block;margin: 20px;" id="button1" ev:onclick="scwin.button1_onclick" label='setColumnIncrement("Quantity", 0.1)'></w2:button>
		<w2:button style="width:250px;height:40px;display:block;margin: 20px;" id="button2" ev:onclick="scwin.button2_onclick" label='getColumnIncrement("Quantity")'></w2:button>
	</body>
</html>
