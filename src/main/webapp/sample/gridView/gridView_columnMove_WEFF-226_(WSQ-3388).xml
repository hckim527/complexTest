<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[a]]></col1>
							<col2><![CDATA[가]]></col2>
							<col3><![CDATA[3]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[c]]></col1>
							<col2><![CDATA[구]]></col2>
							<col3><![CDATA[1]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[d]]></col1>
							<col2><![CDATA[다]]></col2>
							<col3><![CDATA[4]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[b]]></col1>
							<col2><![CDATA[게]]></col2>
							<col3><![CDATA[2]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거)
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
// column1 정렬만 취소(false), 그 외 정렬 진행
scwin.gridView1_onbeforesort = function(sortInfo) {
	if (sortInfo.headerId == "column1") {
		return false;
	} else {
		return true;
	}
};
scwin.dbClick = function(id) {
	var el = scwin.__getDom($p.id + id);
	var evt = document.createEvent('MouseEvents');
	evt.initEvent('dblclick', true, false);
	el.dispatchEvent(evt);
};
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList2" id="gridView1" sortControl="true" style="position: absolute;width:682px;height:219px;left:13px;top:20px;border: 1px solid #000;" useShiftKey="true"
			ev:onbeforesort="scwin.gridView1_onbeforesort">
