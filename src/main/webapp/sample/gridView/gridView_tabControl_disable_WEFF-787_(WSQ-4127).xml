<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
								<w2:dataList baseNode="list" repeatNode="map" id="dlSpltNo" saveRemovedData="true">
										<w2:columnInfo>
												<w2:column id="value" name="value" dataType="text"></w2:column>
												<w2:column id="label" name="label" dataType="text"></w2:column>
										</w2:columnInfo>
								</w2:dataList>
						<w2:dataList baseNode="list" repeatNode="map" id="dlDgCgo" saveRemovedData="true">
								<w2:columnInfo>
										<w2:column id="dcgoSeq" name="Dangerous Cargo Sequence" dataType="text"></w2:column>
										<w2:column id="dctrSeq" name="Dangerous Container Sequence" dataType="text"></w2:column>
										<w2:column id="cntrNo" name="Container Number" dataType="text"></w2:column>
										<w2:column id="cntrTpszCd" name="Container Type Size Code" dataType="text"></w2:column>
										<w2:column id="cntrCgoSeq" name="Container Cargo Sequence" dataType="text"></w2:column>
										<w2:column id="imdgUnNo" name="Imdg Un Number" dataType="text"></w2:column>
										<w2:column id="imdgUnVarntNo" name="Imdg Un Variant Number" dataType="text"></w2:column>
										<w2:column id="spltNo" name="Split No" dataType="text"></w2:column>
								</w2:columnInfo>
						</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dlSpltNo.setJSON([{ "label": "1", "value": "1" }, { "label": "2", "value": "2" }, { "label": "3", "value": "3" }]);
};
scwin.trigger1_onclick = function(e) {
	dlDgCgo.setJSON([{ "spltNo": "2" }, { "spltNo": "1" }, { "spltNo": "3" }]);
};
scwin.trigger2_onclick = function(e) {
    tacSpclCgo.disableTab(0);
    tacSpclCgo.disableTab(1);
    tacSpclCgo.disableTab(2);
    tacSpclCgo.disableTab(3);
};
scwin.trigger3_onclick = function(e) {
    tacSpclCgo.enableTab(0);
    tacSpclCgo.disableTab(1);
    tacSpclCgo.disableTab(2);
    tacSpclCgo.disableTab(3);
};
scwin.checkVal = function() {
    var class_name = ((j) => j.length ? j : $('#mf_grvDgSplt_cell_0_0'))($('#grvDgSplt_cell_0_0')).attr('class');
    return class_name.indexOf("w2grid_default_disabled") >= 0;
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:tabControl alwaysDraw="true" class="tabc_sub" confirmFalseAction="new" confirmTrueAction="exist" id="tacSpclCgo"
				useConfirmMessage="false" useMoveNextTabFocus="false" useTabKeyOnly="true">
				<w2:tabs disabled="false" id="tabDg" label="DG"></w2:tabs>
				<w2:tabs disabled="false" id="tabRf" label="RF"></w2:tabs>
				<w2:tabs disabled="false" id="tabAk" label="AK"></w2:tabs>
				<w2:tabs disabled="false" id="tabBb" label="BB"></w2:tabs>
				<w2:content alwaysDraw="true" id="content1">
						<w2:gridView autoFit="lastColumn" class="cm_grid" dataList="data:dlDgCgo" fixedColumn="3" id="grvDgSplt"
								noResultMessageVisible="false" preventAddRowOnPaste="true" readOnly="true" rowNumVisible="false" sortable="false"
								style="height:409px;min-height:409px;max-height:409px;" tooltipDisplay="true" visibleRowNum="14">
								<w2:header id="header2">
										<w2:row id="row3">
												<w2:column displayMode="label" id="column01" inputType="text"
														style="height:27px;" value="Split No." width="57">
												</w2:column>
												<w2:column colSpan="2" displayMode="label" id="column02" inputType="text"
														rowSpan="" style="height:27px;" value="CNTR Seq &amp; No." width="153">
												</w2:column>
												<w2:column displayMode="label" id="column6" inputType="text"
														style="height:27px;" value="TP/SZ" width="53">
												</w2:column>
												<w2:column displayMode="label" id="column03" inputType="text"
														style="height:27px;" value="Cargo&lt;br/&gt;Seq." width="58">
												</w2:column>
												<w2:column id="column04" inputType="text" style="height:27px;" value="UN No." width="90"></w2:column>
												<w2:column displayMode="label" id="column05" inputType="text"
														style="height:27px;" value="IMDG Class" width="100">
												</w2:column>
										</w2:row>
								</w2:header>
								<w2:gBody id="gBody2">
										<w2:row id="row4">
												<w2:column displayMode="label" id="spltNo" inputType="select"
														readOnly="false" width="57">
														<w2:choices>
																<w2:itemset nodeset="data:dlSpltNo">
																		<w2:label ref="label"></w2:label>
																		<w2:value ref="value"></w2:value>
																</w2:itemset>
														</w2:choices>
												</w2:column>
												<w2:column displayMode="label" id="dcgoSeq" inputType="text"
														upperColumn="col1" width="50">
												</w2:column>
												<w2:column displayMode="label" id="cntrNo" inputType="text"
														width="110">
												</w2:column>
												<w2:column displayMode="label" id="cntrTpszCd" inputType="text"
														width="53">
												</w2:column>
												<w2:column displayMode="label" id="cntrCgoSeq" inputType="text"
														width="58">
												</w2:column>
												<w2:column id="imdgUnNo" inputType="text" width="90"></w2:column>
												<w2:column displayMode="label" id="imdgUnVarntNo" inputType="text"
														width="100">
												</w2:column>
										</w2:row>
								</w2:gBody>
						</w2:gridView>
				</w2:content>
				<w2:content alwaysDraw="true" id="content2"></w2:content>
				<w2:content alwaysDraw="true" id="content3"></w2:content>
				<w2:content alwaysDraw="true" id="content4"></w2:content>
		</w2:tabControl>
		<xf:trigger id="trigger2" style="width:120px;height: 23px;" type="button" ev:onclick="scwin.trigger2_onclick">
				<xf:label><![CDATA[1. tab dis true]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" style="width:120px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[2. 조회]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger3" style="width:120px;height: 23px;" type="button" ev:onclick="scwin.trigger3_onclick">
				<xf:label><![CDATA[3. tab dis false]]></xf:label>
		</xf:trigger>
	</body>
</html> 