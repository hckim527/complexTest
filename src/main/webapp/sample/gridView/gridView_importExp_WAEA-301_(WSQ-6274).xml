<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="expr1" name="name2" dataType="text"></w2:column>
						<w2:column id="col2" name="name3" dataType="text"></w2:column>
						<w2:column id="col3" name="name4" dataType="text"></w2:column>
						<w2:column id="col4" name="name5" dataType="text"></w2:column>
						<w2:column id="expr2" name="name6" dataType="text"></w2:column>
					</w2:columnInfo>
				<w2:data use="true"></w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var dataArr = {
		"columnInfo": ["col2", "col3", "col4", "col1"],
		"data":[
			1,2,3,"삼립빵",
			4,5,6,"마늘빵",
			7,8,9,"모카빵"
		]
	};
	dataList1.setArray(dataArr);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1"
			style="position: absolute ;left: 27px;top: 35px;width: 500px;height: 153px;"
			useShiftKey="true" sortable="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column11" style="height:20px;" inputType="text" width="70" value="col1"></w2:column>
					<w2:column id="column1" style="height:20px;color:red;" inputType="text" width="70" value="col2 + col3"></w2:column>
					<w2:column id="column9" style="height:20px;" inputType="text" width="70" value="col2"></w2:column>
					<w2:column id="column7" style="height:20px;" inputType="text" width="70" value="col3"></w2:column>
					<w2:column id="column3" style="height:20px;" inputType="text" width="70" value="col4"></w2:column>
					<w2:column id="column2" style="height:20px;color:red;" inputType="text" width="110" value="(col2 + col3) * col3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="expr1" style="height:20px" inputType="text" width="70"
						importExp="Number(col('col2')) + Number(col('col3'))"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col3" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col4" style="height:20px" width="70" inputType="text"></w2:column>
					<w2:column id="expr2" style="height:20px" inputType="text" width="70"
						importExp="Number(col('expr1')) * Number(col('col3'))"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
