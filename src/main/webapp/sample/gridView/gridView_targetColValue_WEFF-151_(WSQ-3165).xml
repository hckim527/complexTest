<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.userExp = function(col1, col2, targetColValue) {
	var value = "";
	if (targetColValue == "A") {
		value = col1 - col2;
	} else if (targetColValue == "B") {
		value = col2 - col1;
	}
	return value;
};
scwin.__checkErrlog = function() {
	return WebSquare.logger.getErrorLog();
}
scwin.onpageload = function() {
	grid1.setData([
		'11', '22', 'A', '',
		'11', '22', 'A', '',
		'11', '22', 'A', '',
		'11', '22', 'B', '',
		'11', '22', 'B', ''
	]);
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:grid baseNode="vector" repeatNode="data/INFO" id="grid1" style="width: 500px;height: 300px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column7" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="column5" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col4" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal1" targetColumnID="col3">
				<w2:row id="row3">
					<w2:column id="column12" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column11" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column10" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column9" style="height:20px" width="70" inputType="expression" displayMode="label" expression="scwin.userExp(sum('col1'),sum('col2'),targetColValue())"></w2:column>
				</w2:row>
			</w2:subTotal>
		</w2:grid>
	</body>
</html>
