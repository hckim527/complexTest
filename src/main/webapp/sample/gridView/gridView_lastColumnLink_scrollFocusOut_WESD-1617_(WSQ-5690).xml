<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><col3><![CDATA[1]]></col3></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row><col3><![CDATA[4]]></col3></w2:row>
						<w2:row></w2:row>
						<w2:row><col3><![CDATA[6]]></col3></w2:row>
						<w2:row></w2:row>
						<w2:row><col3><![CDATA[8]]></col3></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row><col3><![CDATA[11]]></col3></w2:row>
						<w2:row></w2:row>
						<w2:row><col3><![CDATA[13]]></col3></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row><col3><![CDATA[last]]></col3></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<xf:input id="input1" style="position:relative;width:144px;height:21px;"></xf:input>
		<!-- 마지막 컬럼 link + scrollFocus: 스크롤바 포커스 중 상하 방향키에도 포커스 유지 -->
		<w2:gridView id="grid1" style="width:500px;height:150px;" defaultCellHeight="20" senseReader="true" focusMove="false" keyMoveEditMode="true" dataList="data:dataList2" scrollFocus="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" id="column7" value="name1"></w2:column>
					<w2:column width="70" id="column8" value="name2"></w2:column>
					<w2:column width="70" id="column9" value="link" inputType="text"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" id="col1" inputType="radio"></w2:column>
					<w2:column width="70" id="col2" inputType="text"></w2:column>
					<w2:column width="70" id="col3" inputType="link"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:input id="input2" style="position:relative;width:144px;height:21px;"></xf:input>
	</body>
</html>
