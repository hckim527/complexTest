<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="bigDecimal"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	grd.advancedExcelDownload({fileName: "fileTest"});
};
scwin.onpageload = function() {
	dataList1.setJSON([{"col1": "test", "col2": ""}, {"col1": "test", "col2": ""}, {"col1": "test", "col2": ""}]);
};
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="grd" style="position: relative;width: 500px;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" style="height:20px;" inputType="text" width="70" displayMode="label" value="name1"/>
					<w2:column id="column1" style="height:20px;" width="88" inputType="text" displayMode="label" value="bigDecimal"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"/>
					<w2:column id="col2" style="height:20px" width="88" inputType="text" displayMode="label" displayFormat="#,##0.00"/>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[excel]]></xf:label>
		</xf:trigger>
	</body>
</html>
