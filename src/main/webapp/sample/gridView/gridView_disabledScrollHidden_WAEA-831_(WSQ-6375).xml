<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dl1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
						<w2:column id="col10" name="name10" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="false"></w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dl2" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="name1"></w2:column>
						<w2:column dataType="text" id="col2" name="name2"></w2:column>
						<w2:column dataType="text" id="col3" name="name3"></w2:column>
						<w2:column dataType="text" id="col4" name="name4"></w2:column>
						<w2:column dataType="text" id="col5" name="name5"></w2:column>
						<w2:column dataType="text" id="col6" name="name6"></w2:column>
						<w2:column dataType="text" id="col7" name="name7"></w2:column>
						<w2:column dataType="text" id="col8" name="name8"></w2:column>
						<w2:column dataType="text" id="col9" name="name9"></w2:column>
						<w2:column dataType="text" id="col10" name="name10"></w2:column>
					</w2:columnInfo>
					<w2:data use="false"></w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.btn1_onclick = function (e) {
	const rows = ib1.getValue();
	const cols = 10;

	const data = Array.from({ length: rows }, (_, r) => {
		const rowNum = r + 1;
		let rowObj = {};

		rowObj['col1'] = String(Math.min((r % 10) + 1, 3));
		rowObj['col2'] = Math.trunc(r / 10).toString();
		rowObj['col3'] = 1;

		for (let c = 4; c <= cols; c++) {
			rowObj[`col${c}`] = `row${rowNum}_col${c}`;
		}

		return rowObj;
	}); 

	dl1.setJSON(data, false);
	dl2.setJSON(data, false);
};

scwin.button1_onclick = function (e) {
	gv1.setDisabled('grid', true);
};
]]></script>
	</head>
	<body>
		<w2:gridView checkAllType="false" id="gv1" style="width:500px;height:247px;" dataList="data:dl1" rowNumVisible="true"
			rowStatusVisible="true" sortable="true" disabledBackgroundColor="red" disabledScrollHidden="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" id="column10" value="name1"></w2:column>
					<w2:column width="70" id="column9" value="name2" useFilter="true"></w2:column>
					<w2:column width="70" id="column8" value="name3"></w2:column>
					<w2:column width="70" id="column7" value="name4"></w2:column>
					<w2:column width="70" id="column6" value="name5"></w2:column>
					<w2:column width="70" id="column5" value="name6"></w2:column>
					<w2:column width="70" id="column4" value="name7"></w2:column>
					<w2:column width="70" id="column3" value="name8"></w2:column>
					<w2:column width="70" id="column2" value="name9"></w2:column>
					<w2:column width="70" id="column1" value="name10"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="drilldown" id="col1" depthColumn="col1"></w2:column>
					<w2:column width="70" id="col2"></w2:column>
					<w2:column width="70" inputType="checkbox" id="col3" applyFormat="" disabled=""></w2:column>
					<w2:column width="70" id="col4"></w2:column>
					<w2:column width="70" id="col5"></w2:column>
					<w2:column width="70" id="col6"></w2:column>
					<w2:column width="70" id="col7"></w2:column>
					<w2:column width="70" id="col8"></w2:column>
					<w2:column width="70" id="col9"></w2:column>
					<w2:column width="70" id="col10"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column width="70" inputType="expression" id="column20" expression="sum('col1')" displayMode=""></w2:column>
					<w2:column width="70" id="column19"></w2:column>
					<w2:column width="70" id="column18"></w2:column>
					<w2:column width="70" id="column17"></w2:column>
					<w2:column width="70" id="column16"></w2:column>
					<w2:column width="70" id="column15"></w2:column>
					<w2:column width="70" id="column14"></w2:column>
					<w2:column width="70" id="column13"></w2:column>
					<w2:column width="70" id="column12"></w2:column>
					<w2:column width="70" id="column11"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
		<xf:group id="" style="width:600px;height:5px;"></xf:group>
		<xf:input id="ib1" style="width: 100px;height: 30px;" initValue="10"></xf:input>
		<w2:button style="width: 80px;height: 30px;" id="btn1" ev:onclick="scwin.btn1_onclick" label="load data"></w2:button>
		<w2:button ev:onclick="scwin.button1_onclick" id="button1" label="set disabled" style="width: 80px;height: 30px;"></w2:button>
		<xf:group id="" style="width:600px;height:5px;"></xf:group>
		<w2:gridView checkAllType="false" dataList="data:dl2" id="gv2" style="width: 500px;height: 150px;">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column10" value="name1" width="70"></w2:column>
					<w2:column id="column9" value="name2" width="70"></w2:column>
					<w2:column id="column8" value="name3" width="70"></w2:column>
					<w2:column id="column7" value="name4" width="70"></w2:column>
					<w2:column id="column6" value="name5" width="70"></w2:column>
					<w2:column id="column5" value="name6" width="70"></w2:column>
					<w2:column id="column4" value="name7" width="70"></w2:column>
					<w2:column id="column3" value="name8" width="70"></w2:column>
					<w2:column id="column2" value="name9" width="70"></w2:column>
					<w2:column id="column1" value="name10" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" width="70"></w2:column>
					<w2:column id="col2" width="70"></w2:column>
					<w2:column id="col3" width="70"></w2:column>
					<w2:column id="col4" width="70"></w2:column>
					<w2:column id="col5" width="70"></w2:column>
					<w2:column id="col6" width="70"></w2:column>
					<w2:column id="col7" width="70"></w2:column>
					<w2:column id="col8" width="70"></w2:column>
					<w2:column id="col9" width="70"></w2:column>
					<w2:column id="col10" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
