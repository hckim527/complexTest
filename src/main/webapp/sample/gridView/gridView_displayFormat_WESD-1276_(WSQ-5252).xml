<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[123456789]]></col1>
							<col2><![CDATA[5351576.25798]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[111122222]]></col1>
							<col2><![CDATA[5468713.23]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[]]></col1>
							<col2><![CDATA[53231.123]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[]]></col1>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// customPasteFormatter: 붙여넣기 값의 쉼표 제거
scwin.test = function(data) {
	if (!data) return false;
	var tmp = data.split("\n");
	var _data = [];
	var result = "";
	for (var i = 0; i < tmp.length; i++) {
		_data[i] = tmp[i].split("\t");
	}
	for (var i = 0; i < _data.length; i++) {
		for (var j = 0; j < _data[i].length; j++) {
			_data[i][j] = _data[i][j].replaceAll(",", "");
		}
		result = _data[i].join("\t") + "\n";
	}
	return result;
};
]]></script>
	</head>
	<body>
		<w2:gridView id="gridView1" style="position:relative;width:770px;height:150px;" checkAllType="false"
			defaultCellHeight="20" dataList="data:dataList1" customPasteFormatter="scwin.test" editModeEvent="onclick">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="182" style="height:20px" id="column9" value="name1" displayMode="label"></w2:column>
					<w2:column width="172" style="height:20px" id="column8" value="name2" displayMode="label"></w2:column>
					<w2:column width="113" style="height:20px" id="column7" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="182" style="height:20px" id="col1" displayMode="label" maxByteLength="6" byteCheckIgnoreChar="-"></w2:column>
					<w2:column width="172" style="height:20px" id="col2" displayMode="label" displayFormat="#,###.##"
						dataType="number" maxByteLength="6" byteCheckIgnoreChar=".-">
					</w2:column>
					<w2:column width="113" style="height:20px" id="col3" displayMode="label" dataType="float" maxLength="6">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
