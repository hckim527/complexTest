<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="number"></w2:column>
						<w2:column id="col2" name="name2" dataType="number"></w2:column>
						<w2:column id="col3" name="name3" dataType="bigDecimal"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[11]]></col1>
							<col4><![CDATA[11]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[100]]></col1>
							<col4><![CDATA[22]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col4><![CDATA[33]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[0]]></col1>
							<col4><![CDATA[55]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
						</w2:row>
						<w2:row>
							<col1><![CDATA[10]]></col1>
						</w2:row>
						<w2:row>
							<col1><![CDATA[0]]></col1>
							<col4><![CDATA[66]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[23]]></col1>
							<col4><![CDATA[8]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[0]]></col1>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	// Row 의 col1 표시값이 "0" 이면 "-"(문자), 아니면 그 값 그대로
	scwin.expr = function(row, col){
		if (col == "0") {
			return "-";
		} else {
			return col;
		}
	};
]]></script>
	</head>
	<body>
		<w2:gridView id="gridView1" style="position: relative;width: 500px;height: 150px;" checkAllType="false" defaultCellHeight="20" dataList="data:dataList1" sortable="true" preventMultisort="false">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" id="column14" value="name4"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column dataType="number" width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column expressionSort="true" expression='scwin.expr(rowIndex(), display("col1"))' dataType="text" width="70" inputType="expression" style="height:20px" id="col2" displayMode="label"></w2:column>
					<w2:column expressionSort="true" expression='scwin.expr(rowIndex(), display("col4"))' dataType="bigDecimal" width="70" inputType="expression" style="height:20px" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" id="col4"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
