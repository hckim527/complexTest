		<xf:trigger type="button" id="trigger1" style="position:absolute;top:447px;left:51px;width:198px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setDisabled("grid",true);]]></xf:label>
