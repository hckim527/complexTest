					<w2:column width="139" inputType="text" style="height:20px" id="column6" value="col1" displayMode="label" useFilter="true"></w2:column>
					<w2:column width="136" inputType="text" style="height:20px" id="column3" value="col4" displayMode="label"></w2:column>
					<w2:column width="138" inputType="text" style="height:20px" id="column2" value="col5" displayMode="label"></w2:column>
