	dataList1.setJSON(tmpJSON);
};

scwin.trigger1_onclick = function(e) {
	gridView1.setDisabled("grid",true);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="position:absolute;top:31px;left:42px;width:828px;height:308px;" dataList="data:dataList1" drawType="native" useFilterList="true" disabledBackgroundColor="#FFFF00" disabledScrollHidden="true">
			<w2:header id="header1">
