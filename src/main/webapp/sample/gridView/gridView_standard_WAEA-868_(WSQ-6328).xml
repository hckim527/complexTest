						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
	var tmpJSON = [
		{ "col1": "1", "col4": "20241015", "col5": "20241015" },
		{ "col1": "2", "col4": "20241015", "col5": "20241015" },
		{ "col1": "3", "col4": "20241015", "col5": "20241015" },
		{ "col1": "4", "col4": "20241015", "col5": "20241015" },
		{ "col1": "5", "col4": "20241015", "col5": "20241015" }
