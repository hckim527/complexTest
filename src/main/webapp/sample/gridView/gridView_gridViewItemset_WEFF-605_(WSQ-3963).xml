<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dl_combo" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="chk" name="name3" dataType="text"></w2:column>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// gridViewItemset 아이템 label 에 html 태그 포함
scwin.onpageload = function() {
	dataList1.setJSON([{ "col1": "value1", "col2": "222", "col3": "" }, { "col1": "value3", "col2": "444", "col3": "" }]);
	dl_combo.setJSON([
		{ "label": "<s>label1</s>", "value": "value1" },
		{ "label": "<font color='red'>label2</font>", "value": "value2" },
		{ "label": "<strong>label3</strong>", "value": "value3" },
		{ "label": "label4", "value": "value4" }
	]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="width:799px;height:150px;" escape="false">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column7" inputType="text" width="141" value="selectbox">
					</w2:column>
					<w2:column id="column5" inputType="text" width="141" value="autoComplete">
					</w2:column>
					<w2:column id="column3" width="141" inputType="text" value="checkcombobox">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="select" width="141" viewType="icon">
						<w2:choices>
							<w2:gridViewItemset autoFit="allColumn" visibleRowNum="10" rowNumVisible="true" width="400" nodeset="data:dl_combo" value="value" label="label">
								<w2:item ref="label" header="라벨"></w2:item>
								<w2:item ref="value" header="값"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col2" inputType="autoComplete" width="141" caseSensitive="false" viewType="icon">
						<w2:choices>
							<w2:gridViewItemset height="240" width="300" nodeset="data:dl_combo" value="value" label="label" navBtn="true">
								<w2:item ref="label" header="라벨"></w2:item>
								<w2:item ref="value" header="값"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col3" width="141" inputType="checkcombobox" viewType="icon">
						<w2:choices>
							<w2:gridViewItemset height="240" checkColumn="0" width="300" nodeset="data:dl_combo" value="value" label="label" navBtn="true">
								<w2:item ref="chk" inputType="checkbox" header="체크박스"></w2:item>
								<w2:item ref="label" header="라벨"></w2:item>
								<w2:item ref="value" header="값"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
