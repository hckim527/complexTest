<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
};
scwin.getChildrenIds = function(excludeInnerComp) {
	var options = { recursive: "true" };
	if (excludeInnerComp) {
		options.excludeInnerComp = "true";
	}
	var compArr = WebSquare.util.getChildren(grp1, options);
	var ids = [];
	for (var i = 0; i < compArr.length; i++) {
		ids.push(compArr[i].id);
	}
	return ids;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="width:508px;height:400px;border: 1px solid red;" id="grp1">
			<w2:gridView id="grid1" style="width: 500px;height: 150px;" scrollByColumn="false" defaultCellHeight="20" dataList="data:dataList1">
				<w2:header id="header2">
					<w2:row id="row3">
						<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name1"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name2"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name3"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody2">
					<w2:row id="row4">
						<w2:column width="70" inputType="text" style="height:20px" id="col1"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col2"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col3"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:group style="width:500px;height:160px;border: 1px solid blue;" id="grp2">
				<w2:gridView id="grid3" style="width: 500px;height: 150px;" scrollByColumn="false" defaultCellHeight="20" dataList="data:dataList1">
					<w2:header id="header2">
						<w2:row id="row3">
							<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name1"></w2:column>
							<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name2"></w2:column>
							<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name3"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody2">
						<w2:row id="row4">
							<w2:column width="70" inputType="text" style="height:20px" id="col1"></w2:column>
							<w2:column width="70" inputType="text" style="height:20px" id="col2"></w2:column>
							<w2:column width="70" inputType="text" style="height:20px" id="col3"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>
			<w2:inputCalendar footerDiv="false" id="inputCalendar1" style="width: 150px;height: 23px;" renderDiv="true" focusOnDateSelect="false"
				calendarValueType="yearMonthDate" rightAlign="false" renderType="component">
			</w2:inputCalendar>
		</xf:group>
	</body>
</html>
