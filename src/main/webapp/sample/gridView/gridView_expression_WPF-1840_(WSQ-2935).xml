<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.fn_expressionValue = function(rowIdx, col1Value, col2Value) {
	var returnValue = "";
	returnValue = col2Value;
	if (col1Value == "sum") {
		gridView1.setCellColor(rowIdx, "col3", "red");
	} else {
		gridView1.setCellColor(rowIdx, "col3", "blue");
	}
	returnValue = WebSquare.util.setNumber(returnValue);
	return returnValue + "_test";
}
scwin.trigger1_onclick = function(e) {
	var jsonData = [{
			"col1": "sum",
			"col2": "12345.00"
		}, {
			"col1": "avg",
			"col2": "123456.894"
		},
		{
			"col1": "sum",
			"col2": "467890.00"
		}, {
			"col1": "avg",
			"col2": "123456.7"
		}
	];
	dataList1.setJSON(jsonData);
};
scwin.trigger3_onclick = function(e) {
	dataList1.removeAll();
};
scwin.trigger4_onclick = function(e) {
	dataList1.insertRow();
};

]]></script>
	</head>
	<body>
		<w2:gridView dataList="dataList1" id="gridView1" expressionSort="true" ignoreEmptyStringOnSort="true"
			filterFocusMode="infocus" style="position: relative ;left:34px;top:69px;width:585px;height:233px;"
			useShiftKey="false" moveKeyEditMode="true" sortable="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" style="height:20px;" inputType="text" width="100"
						value="expression(col1,col2)">
					</w2:column>
					<w2:column id="column2" style="height:20px;" inputType="text" width="100"></w2:column>
					<w2:column id="column1" style="height:20px;" width="100" inputType="text" value="col1"></w2:column>
					<w2:column id="column5" style="height:20px;" inputType="text" width="100" displayMode="label"
						value="col2">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col3" style="height:20px" inputType="expression" width="100" dataType="expression"
						expression="scwin.fn_expressionValue(rowIndex(), display('col1'),display('col2'))" defaultValue="">
					</w2:column>
					<w2:column id="col4" style="height:20px" inputType="expression" width="100" dataType="expression"
						expression="SUM('col1','col2')">
					</w2:column>
					<w2:column id="col1" style="height:20px" width="100" inputType="text" expressionSort="true">
					</w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="100" displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative ;left:81px;top:-220px;width:109px;height:43px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[set]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger3" style="position: relative ;left:125px;top:-220px;width:113px;height:43px;" type="button" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[removeAll]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger4" style="position: relative ;left:167px;top:-220px;width:113px;height:43px;" type="button" ev:onclick="scwin.trigger4_onclick">
			<xf:label><![CDATA[insertRow]]></xf:label>
		</xf:trigger>
	</body>
</html>
 