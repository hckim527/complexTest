<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.userExp = function() {
	return dataMap1.get("key1");
};
scwin.onpageload = function() {
	var data = [];
	for (var i = 0; i < 25; i++) {
		data.push('111111');
	}
	dataList1.setData(data);
	dataMap1.set("key1", "555555");
	var value = gridView1.getFormattedHeaderValue("column11", "555555");
	gridView1.setHeaderValue("column11", value);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" style="width:706px;height:150px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column9" style="height:20px;" inputType="text" width="70" displayMode="label" value="name1"></w2:column>
					<w2:column id="column7" style="height:20px;" inputType="text" width="70" displayMode="label" value="value"></w2:column>
					<w2:column id="column5" style="height:20px;" inputType="text" width="170" displayMode="label" value="expression userExp"></w2:column>
					<w2:column id="column3" style="height:20px;" inputType="text" width="166" displayMode="label" value="expression SUM"></w2:column>
					<w2:column id="column1" style="height:20px;" width="166" inputType="text" displayMode="label" value="setHeaderValue"></w2:column>
				</w2:row>
				<w2:row id="row3">
					<w2:column id="column15" style="height:20px;" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column14" style="height:20px;" width="70" inputType="text" displayMode="label" value="555555" dataType="number" displayFormat="#,###"></w2:column>
					<w2:column id="column13" style="height:20px;" width="170" inputType="expression" displayMode="label" displayFormat="#,###" dataType="number" expression="scwin.userExp()"></w2:column>
					<w2:column id="column12" style="height:20px;" width="166" inputType="expression" displayMode="label" displayFormat="#,###" dataType="number" expression="sum('col4')"></w2:column>
					<w2:column id="column11" style="height:20px;" width="166" inputType="text" displayMode="label" displayFormat="#,###" dataType="number"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" inputType="text" width="170" displayMode="label"></w2:column>
					<w2:column id="col4" style="height:20px" inputType="text" width="166" displayMode="label"></w2:column>
					<w2:column id="col5" style="height:20px" width="166" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
