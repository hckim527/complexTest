		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		var returnInfo = {};
		returnInfo.options = {selectedData : false
							,     viewType : "icon"
							, chooseOption : true };
		returnInfo.inputType = "autoComplete";
		returnInfo.options.displayMode = "label";
		returnInfo.itemSet = {
			nodeset:"data:dataList2",
			label : "col1",
			value : "col2"
		}
		for (var i = 0; i < 5; i++) {
