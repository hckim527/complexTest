<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.colLog = [];
scwin.btn_col1_onclick = function(e) {
	scwin.colLog.push(grd1.getTotalHeaderCol());
};
scwin.btn_col2_onclick = function(e) {
	var options = {};
	options.mergedColumn = "Y";
	scwin.colLog.push(grd1.getTotalHeaderCol(options));
};
]]></script>
	</head>
	<body>
	<xf:group id="" style="padding: 10px">
		<w2:gridView checkAllType="false" dataList="data:dataList1"
			style="height: 150px;" id="grd1" defaultCellHeight="20">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column5" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col3" displayMode="label"></w2:column>
				</w2:row>
				<w2:row id="row5">
					<w2:column width="70" inputType="text" id="column8" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column7" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column6" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:group id="" style="margin-top: 10px"><xf:trigger style="width: 250px;height: 23px;margin-right: 10px;" id="btn_col1" type="button" ev:onclick="scwin.btn_col1_onclick">
			<xf:label><![CDATA[컬럼 갯수 확인(merge option 사용 안함)]]></xf:label>
		</xf:trigger><xf:trigger style="width: 220px;height: 23px;margin-right: 10px;" id="btn_col2" type="button" ev:onclick="scwin.btn_col2_onclick">
			<xf:label><![CDATA[컬럼 갯수 확인(merge opttion 사용)]]></xf:label>
		</xf:trigger></xf:group></xf:group></body>
</html>
