<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dl_gridData" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dl_selectData" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dl_selectData.setJSON([{ label: "la_a1", value: "a1" }, { label: "la_a2", value: "a2" }]);
	dl_gridData.setJSON([{ col2: "a1" }, { col2: "a2" }, { col2: "a3" }, { col2: "a4" }]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<!-- 전제: config.xml gridView/column[inputType=select] 에 chooseOption=true (complexTest config 에는 없어 TSCP 스크립트가 route 로 주입) -->
		<w2:gridView dataList="data:dl_gridData" defaultCellHeight="20" id="gridView1" style="position: absolute ;left: 53px;top: 34px;width:545px;height:235px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column9" inputType="checkbox" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column7" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column5" inputType="text" width="170" value="chooseOption=false" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="170" value="config chooseOption=true" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="checkbox" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" inputType="select" width="70" displayMode="label" viewType="icon" chooseOption="false" chooseOptionLabel="-선 택-">
						<w2:choices>
							<w2:itemset nodeset="data:dl_selectData">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col4" inputType="select" width="70" displayMode="label" viewType="icon" chooseOptionLabel="-선 택-">
						<w2:choices>
							<w2:itemset nodeset="data:dl_selectData">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
