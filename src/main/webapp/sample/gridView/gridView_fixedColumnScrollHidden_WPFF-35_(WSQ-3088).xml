<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// 컴포넌트·전역 이름 조회(엔진 캐시 → 이름 그대로 실행 → mf_ 접두사 붙여 다시, 없으면 받은 id 문자열 반환). 2026-11
scwin.__getObj = function(id) {
	if (typeof id !== 'string') return id;
	var W = WebSquare, C = W.idCache, U = W.idToUUID, F = function(k) { return new Function('return ' + k)(); };
	if (!W.strictMode) id = id.replace(/mf_/g, '');
	if (C[U[id]]) return C[U[id]];
	var r; try { r = F(id); } catch (e) {}
	if (r == undefined && W.strictMode) {
		var P = W.strictModeFrame.id + '_';
		var s = id.slice(0, 2) === 'G_' ? 'G_' + P + id.slice(2) : (id.slice(0, P.length) !== P ? P + id : id);
		s = s.replace(new RegExp('(' + P + '){2,}', 'g'), P);
		if (C[U[s]]) r = C[U[s]]; else { try { r = F(s); } catch (e) { r = id; } }
	}
	return r == undefined ? id : r;
};

scwin.__checkStyle = function() {
	var st = scwin.__getObj('gridView1_scrollX_left').childNodes[0];
	return st.style.overflowX;
}
scwin.onpageload = function() {
	window.arr = [];
	for (var i = 0; i < 3 * 10; i++) {
		arr[i] = i;
	}
	dataList1.setData(arr);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" style="position: absolute;width:470px;height:223px;left:121px;top:269px;" fixedColumnWithHidden="true" useShiftKey="true"
			rowStatusVisible="true" rowNumVisible="true" rowNumStatusFixed="true"
			fixedColumn="" fixedColumnScrollHidden="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" style="height:20px;" width="165" inputType="text" displayMode="label"
						value="name1">
					</w2:column>
					<w2:column id="column3" style="height:20px" inputType="text" width="153" displayMode="label"
						value="name2">
					</w2:column>
					<w2:column id="column2" style="height:20px" inputType="text" width="164" displayMode="label"
						value="name3">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" width="4" inputType="text" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" width="153" inputType="text" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" width="164" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column id="column9" style="height:20px" width="4" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column8" style="height:20px" width="153" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column7" style="height:20px" width="164" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>

	</body>
</html>
 