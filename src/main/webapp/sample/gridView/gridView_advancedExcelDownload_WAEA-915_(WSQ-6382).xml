scwin.grd_exam_typeGetter = function (argInfo) {
	var rowIndex = argInfo.rowIndex;
	var colIndex = argInfo.colIndex;
	var returnInfo;

	let strID = "dynamic_" + rowIndex + "_" + colIndex;

	switch (rowIndex) {
		case 0:
			returnInfo = {
				id: strID,
				inputType: "checkbox",
				options: { valueType: "other", trueValue: "Y", falseValue: "N", checkboxLabel: "선택" }
			};
			break;
		case 1:
			returnInfo = {
				id: strID,
				inputType: "calendar",
				options: { viewType: "icon", dataType: "date", displayFormat: "yyyy-MM-dd" }
			};
			break;
		case 2:
		default:
			returnInfo = {
				id: strID,
				inputType: "text",
				options: {}
			};
			break;
	}

	return returnInfo;

};

scwin.grd_exam_expression = function () {
	return "EXP";
};

scwin.btn_download_onclick = function (e) {
	var jsnOptions;

	jsnOptions = {
		fileName: "EXAMPLE_P00288.xlsx"
	};

	grd_exam.advancedExcelDownload(jsnOptions);
};
