<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    dataList1.insertRow();
    input2.setValue(1);
};
scwin.trigger2_onclick = function(e) {
    var rowIndex = parseInt(input2.getValue());
    if (gridView1.getCellDisabled(rowIndex, 0)) {
        gridView1.setCellDisabled(rowIndex, 0, false);
    } else {
        gridView1.setCellDisabled(rowIndex, 0, true);
    }
    input1.setValue(rowIndex);
}
scwin.trigger7_onclick = function(e) {
    if (gridView1.options.checkAllType === "include") {
        gridView1.options.checkAllType = "exclude";
        textbox1.setValue("exclude");
    } else {
        gridView1.options.checkAllType = "include";
        textbox1.setValue("include");
    }
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group>
			<xf:group>
				<xf:input adjustMaxLength="false" style="margin-left:20px;width: 30px;height: 21px;" id="input1"></xf:input>
				<xf:input adjustMaxLength="false" style="margin-left:20px;width: 30px;height: 21px;" id="input2"></xf:input>
				<xf:trigger type="button" id="trigger2" style="left:0px;top:9px;width: 90px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
					<xf:label><![CDATA[cell Disabled toggle]]></xf:label>
				</xf:trigger>
			</xf:group>
			<xf:group>
				<w2:textbox label="include" id="textbox1"></w2:textbox>
				<xf:trigger type="button" id="trigger7" style="left:0px;top:9px;width: 190px;height: 23px;" ev:onclick="scwin.trigger7_onclick">
					<xf:label><![CDATA[checkAllType toggle]]></xf:label>
				</xf:trigger>
			</xf:group>
			<w2:gridView dataList="data:dataList1" defaultCellHeight="20" rowNumVisible="true" checkAllType=""
				checkOnCellClick="true" id="gridView1" dataDragSelect="true"
				style="position: absolute ;left:38px;top:128px;width:537px;height:200px;" visibleRowNum="10"
				useShiftKey="true">
				<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column id="column1" inputType="checkbox" width="70" value="name1" displayMode="label"
							excelLabel="선택">
						</w2:column>
						<w2:column id="column2" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
						<w2:column id="column3" inputType="text" width="70" value="name3" displayMode="label"></w2:column>
						<w2:column id="column4" inputType="text" width="70" value="name4" displayMode="label"></w2:column>
						<w2:column id="column5" width="70" inputType="text" value="name5" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="col1" inputType="checkbox" width="70" displayMode="label" checkAlways="false" checkboxLabel="" valueType="other" trueValue="Y" falseValue="N">
						</w2:column>
						<w2:column id="col2" inputType="radio" width="70" displayMode="label"></w2:column>
						<w2:column id="col3" inputType="text" width="70" displayMode="label"></w2:column>
						<w2:column id="col4" inputType="text" width="70" displayMode="label"></w2:column>
						<w2:column id="col5" inputType="text" width="70" displayMode="label"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
