<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="date"></w2:column>
						<w2:column id="col2" name="name2" dataType="date"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[201612300101]]></col1>
							<col2><![CDATA[201612300101]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2017010300101]]></col1>
							<col2><![CDATA[2017010300101]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2017010900101]]></col1>
							<col2><![CDATA[2017010900101]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function() {
	gridView1.setColumnIoFormat({
		colIndex : 0,
		ioFormat : "ddMMyyyy",
		dateMask : "dd-MM-yyyy"
	});
};

scwin.checkVal1 = function() {
	return (document.getElementById('gridView1_cell_0_0_calendar_input') || document.getElementById('mf_gridView1_cell_0_0_calendar_input')).value == '30-12-2016';
};
scwin.checkVal2 = function() {
	return (document.getElementById('gridView1_cell_1_0_calendar_input') || document.getElementById('mf_gridView1_cell_1_0_calendar_input')).value == '03-01-2017';
};
scwin.checkVal3 = function() {
	return (document.getElementById('gridView1_cell_2_0_calendar_input') || document.getElementById('mf_gridView1_cell_2_0_calendar_input')).value == '09-01-2017';
};
]]></script>
	</head>
	<body>
		<xf:group>
			<w2:textbox label="gridView senseReader true" style="width: 300px;height: 40px;"></w2:textbox>
			<xf:trigger type="button" style="width: 180px;height: 23px;" value="setColumnIoFormat ddMMyyyy" id="trigger1" ev:onclick="scwin.trigger1_onclick"></xf:trigger>
			<w2:gridView dataList="dataList1" scrollByColumn="false" summaryAuto="false" scrollByColumnAdaptive="false" id="gridView1"
				style="width:443px;height:150px;" ignoreCellClick="false" ignoreToggleOnDisabled="false" senseReader="true"
				fixedColumnWithHidden="true" useShiftKey="true" autoFit="allColumn">
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column id="column3" style="height:20px;" inputType="text" width="200" value='useIOFormatLength = "true"'></w2:column>
						<w2:column id="column1" style="height:20px;" width="200" inputType="text" value='useIOFormatLength = "false"'></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="col1" inputType="calendar" style="height:20px" width="200" useIOFormatLength="true"></w2:column>
						<w2:column id="col2" inputType="calendar" style="height:20px" width="200" useIOFormatLength="false"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
