<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name2" dataType="text"></w2:column>
						<w2:column id="col4" name="name2" dataType="text"></w2:column>
						<w2:column id="col5" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name2" dataType="text"></w2:column>
						<w2:column id="col4" name="name2" dataType="text"></w2:column>
						<w2:column id="col5" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.getNewData = function(cnt, idx, prefix) {
	var data = [];
	for (var i = 0; i < cnt; i++) {
		var obj = {};
		for (var j = 1; j <= 5; j++) {
			obj["col" + j] = prefix + (idx + i) + "," + j;
		}
		data.push(obj);
	}
	return data;
};

scwin.trigger1_onclick = function(e) {
	var data = [];
	for (var i = 1; i <= 100; i++) {
		for (var j = 1; j <= 5; j++) {
			data.push(i + "," + j);
		}
	}
	dataList1.setData(data.slice(0));
	dataList2.setData(data.slice(0));
};

scwin.trigger2_onclick = function(e) {
	var newData = scwin.getNewData(3, dataList1.getRowCount(), "A_");
	dataList1.insertJSON(0, newData);
};

scwin.trigger3_onclick = function(e) {
	var opt = {
		"fixScroll": true
	};
	var newData = scwin.getNewData(3, dataList2.getRowCount(), "B_");
	dataList2.insertJSON(0, newData, opt);
};

scwin.trigger4_onclick = function(e) {
	var opt = {
		"fixScroll": true
	};
	dataList2.insertRow(0, opt);
};

scwin.trigger5_onclick = function(e) {
	dataList1.setBroadcast(false);
	var newData = scwin.getNewData(3, dataList1.getRowCount(), "A_");
	dataList1.insertJSON(0, newData);
	var cnt = dataList1.getRowCount();
	dataList1.removeRows([cnt - 1, cnt - 2, cnt - 3]);
	var param = {
		"gridView": [{
			"refreshInstance": true,
			"refreshScroll": false,
			"keepTop": true
		}]
	};
	dataList1.setBroadcast(true, true, param);
};

scwin.checkVal1 = function() {
	return (document.getElementById('gridView2_scrollY_div') || document.getElementById('mf_gridView2_scrollY_div')).scrollTop == 500;
};
]]></script>
	</head>
	<body>
		<xf:trigger id="trigger1" style="position:relative;width:150px;height:30px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[조회]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="data:dataList1" id="gridView1" style="position: relative;width:500px;height:300px;" rowNumVisible="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="h1" style="height:20px" inputType="text" width="70" displayMode="label" value="col1"></w2:column>
					<w2:column id="h2" style="height:20px" width="70" inputType="text" displayMode="label" value="col2"></w2:column>
					<w2:column id="h3" style="height:20px" width="70" inputType="text" displayMode="label" value="col3"></w2:column>
					<w2:column id="h4" style="height:20px" width="70" inputType="text" displayMode="label" value="col4"></w2:column>
					<w2:column id="h5" style="height:20px" width="70" inputType="text" displayMode="label" value="col5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="text" displayMode="label" textContent="true"></w2:column>
					<w2:column id="col2" inputType="text" displayMode="label" textContent="true"></w2:column>
					<w2:column id="col3" inputType="text" displayMode="label" textContent="true"></w2:column>
					<w2:column id="col4" inputType="text" displayMode="label" textContent="true"></w2:column>
					<w2:column id="col5" inputType="text" displayMode="label" textContent="true"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger id="trigger2" style="position:relative;width:400px;height:30px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[dataList1.insertJSON(0,scwin.newData);]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger5" style="position:relative;width:400px;height:30px;" ev:onclick="scwin.trigger5_onclick">
			<xf:label><![CDATA[dataList1 setBroadcast keepTop]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="data:dataList2" id="gridView2" style="position: relative;width:500px;height:300px;" rowNumVisible="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="h1" style="height:20px" inputType="text" width="70" displayMode="label" value="col1"></w2:column>
					<w2:column id="h2" style="height:20px" width="70" inputType="text" displayMode="label" value="col2"></w2:column>
					<w2:column id="h3" style="height:20px" width="70" inputType="text" displayMode="label" value="col3"></w2:column>
					<w2:column id="h4" style="height:20px" width="70" inputType="text" displayMode="label" value="col4"></w2:column>
					<w2:column id="h5" style="height:20px" width="70" inputType="text" displayMode="label" value="col5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="text" displayMode="label" textContent="true"></w2:column>
					<w2:column id="col2" inputType="text" displayMode="label" textContent="true"></w2:column>
					<w2:column id="col3" inputType="text" displayMode="label" textContent="true"></w2:column>
					<w2:column id="col4" inputType="text" displayMode="label" textContent="true"></w2:column>
					<w2:column id="col5" inputType="text" displayMode="label" textContent="true"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:group style="position:relative;width:410px;height:50px;">
			<xf:trigger id="trigger3" style="position:relative;width:400px;height:30px;" ev:onclick="scwin.trigger3_onclick">
				<xf:label><![CDATA[dataList2.insertJSON(0,scwin.newData,{fixScroll:true});]]></xf:label>
			</xf:trigger>
		</xf:group>
		<xf:group style="position:relative;width:410px;height:50px;">
			<xf:trigger id="trigger4" style="position:relative;width:400px;height:30px;" ev:onclick="scwin.trigger4_onclick">
				<xf:label><![CDATA[dataList2.insertRow(0,{fixScroll:true})]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
