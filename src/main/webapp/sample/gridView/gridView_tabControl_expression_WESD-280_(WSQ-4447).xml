<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map" ev:oncelldatachange="scwin.dataList1_oncelldatachange">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};

scwin.onpageload = function() {
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList2.insertRow();
	dataList2.insertRow();
	dataList2.insertRow();
};

scwin.dataList1_oncelldatachange = function(info) {
	if (info.colID == "col1") {
		dataList2.setCellData(info.rowIndex, "col1", info.newValue);
	}
};

scwin.fireDbClick = function(node) {
	if (document.createEventObject) {
		node.fireEvent('ondblclick');
	} else if (document.createEvent) {
		var evt = document.createEvent('MouseEvents');
		evt.initEvent('dblclick', true, false);
		node.dispatchEvent(evt);
	} else if (typeof node.ondblclick == 'function') {
		node.ondblclick();
	}
};

scwin.Dbclick = function(id) {
	var el = scwin.__getDom($p.id + id);
	scwin.fireDbClick(el);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:tabControl alwaysDraw="true" class="tab_ctrl_layout_noclose" id="Tab0" style="width:100%;height:100%;" useTabKeyOnly="true">
			<w2:tabs id="tab1" label="A"></w2:tabs>
			<w2:tabs id="tab2" label="B"></w2:tabs>
			<w2:content alwaysDraw="true" id="contents1">
				<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1" style="position: relative ;left:34px;top:69px;width:400px;height:233px;float:left;" fixedColumnWithHidden="true">
					<w2:header id="header1">
						<w2:row id="row1">
							<w2:column id="column3" style="height:20px;" inputType="text" width="70" value="col1"></w2:column>
							<w2:column id="column2" style="height:20px;" inputType="text" width="70" value="col2"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody1">
						<w2:row id="row2">
							<w2:column id="col1" style="height:20px" inputType="text" width="70"></w2:column>
							<w2:column id="col2" style="height:20px" inputType="text" width="70"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</w2:content>
			<w2:content alwaysDraw="true" id="contents2">
				<w2:gridView dataList="dataList2" scrollByColumn="false" id="gridView2" style="position: relative ;left:34px;top:69px;width:400px;height:233px;" fixedColumnWithHidden="true">
					<w2:header id="header1">
						<w2:row id="row1">
							<w2:column id="column3" style="height:20px;" inputType="text" width="70" value="col1"></w2:column>
							<w2:column id="column2" style="height:20px;" inputType="text" width="70" value="col2"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody1">
						<w2:row id="row2">
							<w2:column id="col1" style="height:20px" inputType="text" width="70"></w2:column>
							<w2:column id="col2" style="height:20px" inputType="expression" expression="sum('col1')" width="70"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</w2:content>
		</w2:tabControl>
	</body>
</html>
