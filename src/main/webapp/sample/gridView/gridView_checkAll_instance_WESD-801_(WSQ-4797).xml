<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns="">
					<!-- col2 는 grid 에 바인딩하지 않는 Column(Jira 조건) -->
					<vector>
						<data><chk>1</chk><col1>1111</col1><col2>a1</col2></data>
						<data><chk>0</chk><col1>2222</col1><col2>a1</col2></data>
						<data><chk>1</chk><col1>3333</col1><col2>a1</col2></data>
						<data><chk>1</chk><col1>4444</col1><col2>a1</col2></data>
						<data><chk>0</chk><col1>5555</col1><col2>a1</col2></data>
						<data><chk>1</chk><col1>6666</col1><col2>a1</col2></data>
					</vector>
				</data>
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	grid1.checkAll(0, "1");
};
scwin.getErrorLog = function() {
	var temp = WebSquare.logger.getErrorLog();
	return temp;
};
]]></script>
	</head>
	<body>
		<w2:grid ref="vector" baseNode="vector" repeatNode="data" id="grid1" style="width: 500px;height: 150px;">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="checkbox" width="70"></w2:column>
					<w2:column id="column1" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="chk" inputType="checkbox" width="70"></w2:column>
					<w2:column id="col1" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:grid>
		<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[checkAll]]></xf:label>
		</xf:trigger>
	</body>
</html>
