<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dl_selectData" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 헬퍼(원래 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.onpageload = function() {
	var jsonData = [];
	for (var i = 1; i <= 9; i++) {
		jsonData.push({ "label": "" + i, "value": "" + i });
	}
	dl_selectData.setJSON(jsonData);
};
scwin.trigger1_onclick = function(e) {
	dataList1.insertRow();
};
scwin.checkVal = function() {
	return scwin.__getDom('G_' + $p.id + 'gridView1___selectbox_col3_itemTable_0').classList.contains('w2table_sb_col_over');
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="position: absolute ;left:0px;top:9px;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[insertRow]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" rowNumVisible="true" checkOnCellClick="true" id="gridView1"
			style="position: absolute ;left:38px;top:128px;width:537px;height:200px;" visibleRowNum="5" senseReader="false" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" inputType="checkbox" width="70" value="name1"></w2:column>
					<w2:column id="column2" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="checkbox" width="70" valueType="other" trueValue="Y" falseValue="N"></w2:column>
					<w2:column id="col2" inputType="radio" width="70"></w2:column>
					<w2:column id="col3" inputType="select" width="70" emptyItem="true" viewType="icon">
						<w2:choices>
							<w2:itemset nodeset="data:dl_selectData">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
