<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dl_selectData" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{
		"label": "la_a1",
		"value": "a1"
	}, {
		"label": "la_a2",
		"value": "a2"
	}];
	dl_selectData.setJSON(jsonData);
	var jsonData2 = [{
		"col2": "a"
	}, {
		"col2": "b"
	}, {
		"col2": "a"
	}, {
		"col2": "a"
	}, {
		"col2": "c"
	}];
	dataList1.setJSON(jsonData2);
	gridView1.setRowVisible(1, false);
	gridView1.setRowVisible(3, false);
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
};
scwin.trigger1_onclick = function(e) {
	dataList1.insertRow();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="position: absolute ;left:0px;top:9px;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[insertRow]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" rowNumVisible="true"
			checkOnCellClick="true" id="gridView1"
			style="position: absolute ;left:38px;top:128px;width:537px;height:133px;" visibleRowNum="15" senseReader="true"
			useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" inputType="checkbox" width="70" value="name1" displayMode="label"
						excelLabel="선택">
					</w2:column>
					<w2:column id="column2" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name3" displayMode="label"></w2:column>
					<w2:column id="column4" inputType="text" width="70" value="name4" displayMode="label"></w2:column>
					<w2:column id="column5" width="70" inputType="text" value="name5" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="checkbox" width="70" displayMode="label" valueType="other" trueValue="Y" falseValue="N">
					</w2:column>
					<w2:column id="col2" inputType="radio" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" inputType="select" width="70" displayMode="label"
						viewType="icon" selectedIndex="0" readOnlyClass="grd_select_readOnly">
						<w2:choices>
							<w2:itemset nodeset="data:dl_selectData">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col4" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col5" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
