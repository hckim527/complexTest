	if (!scwin.keep) {
		scwin.keep = grid1.getColData("col1").map(function(v) { return v == "a111"; });
	}
};
scwin.trigger1_onclick = function(e) {
	scwin.setKeep();
	for (var i = 0; i < scwin.keep.length; i++) {
		grid1.setRowVisible(i, scwin.keep[i]);
	}
};
scwin.trigger2_onclick = function(e) {
	scwin.setKeep();
	var xmlData = WebSquare.ModelUtil.findInstanceNodes("vector/data");
	var start = performance.now();
	scwin.run++;
	for (var i = 0; i < xmlData.length; i++) {
		for (var c = 1; c <= 6; c++) {
			WebSquare.ModelUtil.setInstanceValue({
				xpath: "vector/data[@idx=" + i + "]/INFO/col" + c,
				value: "col" + c + "_" + i + "_" + scwin.run,
				scopeId: WebSquare.scope_obj
			});
		}
	}
	scwin.elapsed.push(Math.round(performance.now() - start));
};
]]></script>
	</head>
