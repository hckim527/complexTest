<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="number"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setJSON([
		{"col1": "a", "col2": "1000"},
		{"col1": "b", "col2": "2000"},
		{"col1": "c", "col2": "3000"},
		{"col1": "d", "col2": "4000"}
	]);
	dataList2.setJSON([
		{"col1": "a", "col2": "1000"},
		{"col1": "c", "col2": "3000"}
	]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width: 500px;height: 150px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" style="height:20px;" width="70" inputType="text" value="name1"></w2:column>
					<w2:column id="column3" style="height:20px;" inputType="text" width="70" value="name2"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" width="70" inputType="text"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70" dataType="number"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView dataList="dataList2" id="gridView2" style="position: relative;width: 500px;height: 150px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" style="height:20px;" width="70" inputType="text" value="col1"></w2:column>
					<w2:column id="column3" style="height:20px;" inputType="text" width="70" value="col2"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" width="70" inputType="text"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
