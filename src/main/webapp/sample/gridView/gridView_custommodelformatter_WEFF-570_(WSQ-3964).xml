<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlResult" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="trshpPortCd" name="T/S Port" dataType="text"></w2:column>
						<w2:column id="dchgFcltyCd" name="Discharging Terminal" dataType="text"></w2:column>
						<w2:column id="lodgFcltyCd" name="Loading Terminal" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// displayFormatter : 빈 값이면 "ALL", 아니면 "11111"
scwin.fn_displayFormatter = function(value) {
	if (value.trim() == "") {
		return "ALL";
	} else {
		return "11111";
	}
};
// customModelFormatter / customModelUnformatter : 앞에 "model_" 붙임
scwin.test = function(data) {
	return "model_" + data;
};
scwin.trigger1_onclick = function(e) {
	dlResult.insertRow();
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" style="width:80px;height:23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[insertRow();]]></xf:label>
		</xf:trigger>
		<!-- 두 번째 Column(textImage) 과 세 번째 Column(text) 에 같은 displayFormatter·customModelFormatter·customModelUnformatter 설정 -->
		<w2:gridView id="gvList" style="width:500px;height:150px;" dataList="data:dlResult">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column18" inputType="text" value="T/S Port" width="100"></w2:column>
					<w2:column id="column19" inputType="text" value="Discharging Terminal(textImage)" width="200"></w2:column>
					<w2:column id="column9" inputType="text" value="Loading Terminal(text)" width="150"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="trshpPortCd" inputType="textImage" width="100"></w2:column>
					<w2:column id="dchgFcltyCd" inputType="textImage" width="200"
						displayFormatter="scwin.fn_displayFormatter" customModelFormatter="scwin.test" customModelUnformatter="scwin.test">
					</w2:column>
					<w2:column id="lodgFcltyCd" inputType="text" width="150"
						displayFormatter="scwin.fn_displayFormatter" customModelFormatter="scwin.test" customModelUnformatter="scwin.test">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
