<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// 컴포넌트·전역 이름 조회(엔진 캐시 → 이름 그대로 실행 → mf_ 접두사 붙여 다시, 없으면 받은 id 문자열 반환). 2026-11
scwin.__getObj = function(id) {
	if (typeof id !== 'string') return id;
	var W = WebSquare, C = W.idCache, U = W.idToUUID, F = function(k) { return new Function('return ' + k)(); };
	if (!W.strictMode) id = id.replace(/mf_/g, '');
	if (C[U[id]]) return C[U[id]];
	var r; try { r = F(id); } catch (e) {}
	if (r == undefined && W.strictMode) {
		var P = W.strictModeFrame.id + '_';
		var s = id.slice(0, 2) === 'G_' ? 'G_' + P + id.slice(2) : (id.slice(0, P.length) !== P ? P + id : id);
		s = s.replace(new RegExp('(' + P + '){2,}', 'g'), P);
		if (C[U[s]]) r = C[U[s]]; else { try { r = F(s); } catch (e) { r = id; } }
	}
	return r == undefined ? id : r;
};
scwin.onpageload = function() {
	var totRow = 200;
	var totCol = scwin.__getObj('grid1').getTotalCol();
	var arr = [];
	for (var i = 0; i < totRow; i++) {
		for (var j = 0; j < totCol; j++) {
			arr.push("index_" + i + "_" + j);
		}
	}
	scwin.__getObj('grid1').setData(arr);
};
scwin.trigger1_onclick = function(e) {
	for (var i = 0; i < scwin.__getObj('grid1').getTotalRow(); i++) {
		if (i != 50 && i != 100 && i != 199) {
			scwin.__getObj('grid1').setRowVisible(i, false);
		}
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="width:146px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setRowVisible false]]></xf:label>
		</xf:trigger>
		<w2:grid baseNode="vector" repeatNode="data/INFO" id="grid1" style="width: 700px;height: 100px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column19" inputType="text" width="120" value="" displayMode="label"></w2:column>
					<w2:column id="column17" inputType="text" width="120" value="" displayMode="label"></w2:column>
					<w2:column id="column15" inputType="text" width="120" value="" displayMode="label"></w2:column>
					<w2:column id="column13" inputType="text" width="120" value="" displayMode="label"></w2:column>
					<w2:column id="column11" inputType="text" width="120" value="" displayMode="label"></w2:column>
					<w2:column id="column9" inputType="text" width="120" value="" displayMode="label"></w2:column>
					<w2:column id="column7" inputType="text" width="120" value="" displayMode="label"></w2:column>
