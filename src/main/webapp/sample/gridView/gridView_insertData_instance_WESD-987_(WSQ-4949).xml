<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns="">
					<root>
						<vector>
						</vector>
					</root>
				</data>
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	var dataArr = ["a", "b", "c", "d", "e", "a", "b", "c", "d", "e", "a", "b", "c", "d", "e"];
	var rowCount = grid1.getRowCount();
	grid1.insertData(rowCount, dataArr);
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" style="width: 180px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[insertData]]></xf:label>
		</xf:trigger>
		<w2:grid baseNode="vector" id="grid1" repeatNode="map" useShiftKey="true" style="width: 500px;height: 350px;" ref="root/vector" nodeset="root/vector/map" fixedColumnWithHidden="true">
			<w2:header style="" id="header1">
				<w2:row style="" id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="h_col1" value="col1"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="h_col2" value="col2"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="h_col3" value="col3"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="h_col4" value="col4"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="h_col5" value="col5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody style="" id="gBody1">
				<w2:row style="" id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col5"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:grid>
	</body>
</html>
