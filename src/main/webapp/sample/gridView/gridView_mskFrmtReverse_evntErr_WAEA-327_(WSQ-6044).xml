				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.dataList1_oncelldatachange = function (info) {
	window.checkLog = true;
	window.changeInfo = { rowIndex: info.rowIndex, colID: info.colID, oldValue: info.oldValue, newValue: info.newValue };
};
scwin.setSimulate1 = function() {
	window.checkLog = false;
};
scwin.setSimulate2 = function() {
	window.checkLog = false;
};
scwin.checkVal1 = function() {
	return window.checkLog;
};
]]></script>
	</head>
	<body>
		<w2:textbox id="" label="재현 순서&lt;br/&gt;1. 개발자 도구를 켭니다.&lt;br/&gt;2. 첫번째 컬럼의 바디 값을 변경합니다.&lt;br/&gt;3. 두번째 컬럼의 바디 값을 변경합니다.&lt;br/&gt;&lt;br/&gt;결과&lt;br/&gt;maskFormat=reverse 일 때 dataList1 의 oncelldatachange 값을 타지 않습니다." style="width:484px;height:99px;" escape="false"></w2:textbox>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="" style="width:821px;height:150px;" dataList="data:dataList1">
			<w2:header id="header2">
				<w2:row id="row3">
