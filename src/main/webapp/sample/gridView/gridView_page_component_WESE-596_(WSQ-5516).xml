<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[2]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[2]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col0" name="name3" dataType="text"></w2:column>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[2]]></col2>
							<col0><![CDATA[1]]></col0>
						</w2:row>
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[2]]></col2>
							<col0><![CDATA[2]]></col0>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.typeGetter = function(info) {
	var rowIndex = info.rowIndex;
	var colIndex = info.colIndex;
	var returnInfo;
	var colId = gridView1.getColumnID(colIndex);

	switch(colId) {
		case "col2":
			returnInfo = {
				id : "dynamic_snipper_" + rowIndex + "_" + colIndex,
				inputType : "spinner",
				options : {}
			}
			break;
	}
	return returnInfo;
};

scwin.customFormatter = function(data, formattedData, rowIdex, colIndex){
	var colId = gridView2.getColumnID(colIndex);
	switch(colId) {
		case "col2":
			var info = {
				inputType : "spinner",
				options : {}
			}
			gridView2.setCellInputType(rowIdex, colIndex, info);
			break;
	}
	return data;
};

scwin.checkVal = function() {
	return WebSquare.logger.getErrorLog() == '';
};
]]></script>
	</head>
	<body>
		<xf:group>
			<xf:group tagname="table" style="width:100%;" class="w2tb">
				<xf:group tagname="colgroup">
					<xf:group tagname="col" style="width:50.00%"></xf:group>
					<xf:group tagname="col" style="width:50.00%"></xf:group>
				</xf:group>
				<xf:group tagname="tr">
					<xf:group tagname="td" class="w2tb_td">
						<w2:gridView checkAllType="false" dataList="data:dlt_dataList1" style="width: 500px;height: 150px;"
							id="gridView1" defaultCellHeight="30" class="wq_gvw">
							<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
							<w2:header id="header2">
								<w2:row id="row3">
									<w2:column width="70" inputType="text" id="column4" value="name1" displayMode="label"></w2:column>
									<w2:column width="70" inputType="text" id="column3" value="name2" displayMode="label"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody2">
								<w2:row id="row4">
									<w2:column width="70" inputType="spinner" id="col1" displayMode="label"></w2:column>
									<w2:column typeGetter="scwin.typeGetter" width="70" inputType="custom" id="col2" displayMode="label"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
					<xf:group tagname="td" class="w2tb_td">
						<w2:textbox label="name2 에디터 모드로 진입시 오류 발생"></w2:textbox>
					</xf:group>
				</xf:group>
				<xf:group tagname="tr">
					<xf:group tagname="td" class="w2tb_td">
						<w2:gridView setCellInputTypeCustom="true" checkAllType="false" dataList="data:dlt_dataList2"
							style="width: 500px;height: 150px;" id="gridView2" class="wq_gvw" defaultCellHeight="30">
							<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
							<w2:header id="header2">
								<w2:row id="row3">
									<w2:column width="70" inputType="text" id="column5" value="name1" displayMode="label"></w2:column>
									<w2:column width="70" inputType="text" id="column4" value="name1" displayMode="label"></w2:column>
									<w2:column width="70" inputType="text" id="column3" value="name2" displayMode="label"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody2">
								<w2:row id="row4">
									<w2:column width="70" inputType="text" id="col0" displayMode="label" customFormatter="scwin.customFormatter"></w2:column>
									<w2:column width="70" inputType="spinner" id="col1" displayMode="label"></w2:column>
									<w2:column typeGetter="scwin.typeGetter" width="70" inputType="custom" id="col2" displayMode="label"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
					<xf:group tagname="td" class="w2tb_td">
						<w2:textbox label="name2 에디터 모드로 진입시 오류 발생"></w2:textbox>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
