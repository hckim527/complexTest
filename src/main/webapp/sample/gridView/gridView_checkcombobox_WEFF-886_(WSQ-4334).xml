<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="check" name="chk" dataType="text"></w2:column>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
						<w2:column id="gubun" name="gubun" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:linkedDataList bind="dataList2" id="linkedDataList1">
					<w2:condition type="filter"><![CDATA[gubun == ref('data:dataList1.col1')]]></w2:condition>
					<w2:condition type="sort"><![CDATA[]]></w2:condition>
				</w2:linkedDataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList2.setJSON([
		{ "label": "label1", "value": "value1", "gubun": "A" },
		{ "label": "label2", "value": "value2", "gubun": "A" },
		{ "label": "label3", "value": "value3", "gubun": "B" },
		{ "label": "label4", "value": "value4", "gubun": "B" }
	]);
	dataList1.setJSON([
		{ "col1": "A", "col2": "12341234\n12341234", "col3": "value1" },
		{ "col1": "A", "col2": "567856785\n67856785678", "col3": "value1 value2" },
		{ "col1": "B", "col2": "989898989\n8989898", "col3": "value3" }
	]);
};
scwin.getErrorLog = function() {
	return WebSquare.logger.getErrorLog();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;" defaultCellHeight="20"
			dataList="data:dataList1">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column7" value="name1" displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" id="column5" value="name2" displayMode="label">
					</w2:column>
					<w2:column width="150" inputType="text" id="column3" value="name3" displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="col1" displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="checkcombobox" id="col3" displayMode="label delim value" navBtn="true">
						<w2:choices>
							<w2:gridViewItemset nodeset="data:linkedDataList1" label="label" autoFit="allColumn" value="value" checkColumn="0" height="100px">
								<w2:item ref="check" header="CHK" inputType="checkbox"></w2:item>
								<w2:item ref="label" header="LABEL"></w2:item>
								<w2:item ref="value" header="VALUE"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		</body>
</html>
