<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[a]]></col1>
							<col2><![CDATA[aa]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[b]]></col1>
							<col2><![CDATA[bb]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name7" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridView1.setColumnVisible('col2', false);
	gridView1.setColumnVisible('col3', false);
};
scwin.trigger2_onclick = function(e) {
	gridView1.setFixedRightColumn(5)
};
]]></script>
	</head>
	<body>
		<xf:group class="sub_contents" id="">
			<w2:gridView dataList="data:dataList2" defaultCellHeight="20" id="gridView1" style="position: relative;width:607px;height:250px;" useShiftKey="true">
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column id="column1" inputType="text" width="70" value="col1" displayMode="label"></w2:column>
						<w2:column id="column2" width="70" inputType="text" value="col2" displayMode="label"></w2:column>
						<w2:column id="column3" inputType="text" width="70" value="col3" displayMode="label"></w2:column>
						<w2:column id="column4" width="70" inputType="text" value="col4" displayMode="label"></w2:column>
						<w2:column id="column5" inputType="text" width="70" value="col5" displayMode="label"></w2:column>
						<w2:column id="column6" width="70" inputType="text" value="col6" displayMode="label"></w2:column>
						<w2:column id="column7" width="70" inputType="text" value="col7" displayMode="label"></w2:column>
						<w2:column id="column8" width="70" inputType="text" value="col8" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="col1" inputType="select" width="70" displayMode="label" ref="">
							<w2:choices>
								<w2:itemset nodeset="data:dataList1">
									<w2:label ref="col1"></w2:label>
									<w2:value ref="col2"></w2:value>
								</w2:itemset>
							</w2:choices>
						</w2:column>
						<w2:column id="col2" width="70" inputType="autoComplete" displayMode="label" ref="">
							<w2:choices>
								<w2:itemset nodeset="data:dataList1">
									<w2:label ref="col2"></w2:label>
									<w2:value ref="col1"></w2:value>
								</w2:itemset>
							</w2:choices>
						</w2:column>
						<w2:column id="col3" width="70" inputType="text"></w2:column>
						<w2:column id="col4" width="70" inputType="text"></w2:column>
						<w2:column id="col5" width="70" inputType="text"></w2:column>
						<w2:column id="col6" width="70" inputType="text"></w2:column>
						<w2:column id="col7" width="70" inputType="text"></w2:column>
						<w2:column id="col8" width="70" inputType="text"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:trigger type="button" id="trigger1" style="position: relative;width:292px;height:23px;" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[setColumnVisible col2, col3]]></xf:label>
			</xf:trigger>
			<xf:trigger id="trigger2" style="position: relative;width:292px;height:23px;" type="button" ev:onclick="scwin.trigger2_onclick">
				<xf:label><![CDATA[setFixedRightColumn(5)]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
