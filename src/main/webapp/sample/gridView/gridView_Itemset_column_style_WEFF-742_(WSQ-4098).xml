<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList4" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var data1 = [];
	for (var i = 0; i < 10; i++) {
		data1.push("label=" + String(i));
		data1.push("value=" + String(i));
		data1.push("dummy=" + String(i));
	}
	dataList1.setData(data1);
	dataList4.insertRow();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="height:23px;">
			<xf:select1 id="selectbox1" disabledClass="w2selectbox_disabled" appearance="minimal" style="position: relative;width: 250px;height: 21px;"
				direction="auto" submenuSize="fixed">
				<xf:choices>
					<w2:gridViewItemset visibleRowNum="10" nodeset="data:dataList1" width="400px" label="label" height="250px" value="value">
						<w2:item ref="label" style="font-weight:bold;" headerStyle="font-weight:lighter !important;" header="G_label"></w2:item>
						<w2:item ref="value" style="font-weight:bold;" headerStyle="font-weight:lighter !important;" header="G_value"></w2:item>
						<w2:item ref="col3" style="font-weight:bold;" headerStyle="font-weight:lighter !important;" header="G_col3"></w2:item>
					</w2:gridViewItemset>
				</xf:choices>
			</xf:select1>
		</xf:group>
		<w2:gridView dataList="data:dataList4" scrollByColumn="false" defaultCellHeight="20" id="gridView1"
			style="position: relative;width: 500px;height: 150px;">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column7" inputType="text" width="250" value="selectbox"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="select" width="250" displayMode="label delim value" delimiter=" @@@ ">
						<w2:choices>
							<w2:gridViewItemset height="350px" width="40%" nodeset="data:dataList1" value="value" label="label" rowNumVisible="true"
								rowStatusVisible="true" displayMode="value delim label" delimiter=" !!! ">
								<w2:item ref="label" style="font-weight:bold;" header="gvIS label"></w2:item>
								<w2:item ref="value" headerStyle="font-weight:lighter;" header="gvIS value"></w2:item>
								<w2:item ref="col3" header="gvIS col3"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
