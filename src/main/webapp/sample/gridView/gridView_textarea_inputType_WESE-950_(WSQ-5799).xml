		<script lazy="false" type="text/javascript"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
    var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
    var r = d(id); if (r) return r;
    var s = dd(P + id); r = d(s); if (r) return r;
    var g = s.indexOf('G_');
    if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
    return d(s.replace(P, ''));
};
// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사). 2026-11
scwin.__getJq = function(q) {
    var j = $(q); if (j.length) return j;
    var P = 'mf_', t = q.trim(), r = t.slice(1);
    if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
    return $(t.slice(0, 1) + r);
};
scwin.onpageload = function() {
};
scwin.fireDbClick = function(node) {
	if (document.createEventObject) {
		node.fireEvent('ondblclick');
	} else if (document.createEvent) {
		var evt = document.createEvent('MouseEvents');
		evt.initEvent('dblclick', true, false);
		node.dispatchEvent(evt);
	} else if (typeof node.ondblclick == 'function') {
		node.ondblclick();
	}
};
scwin.Dbclick = function(id) {
	var el = scwin.__getDom(id);
	scwin.fireDbClick(el);
};
scwin.isWithinPercent = function(a, b, c) {
	const percentage = c; // 백분율 설정
	const lowerBound = b - (b * (percentage / 100)); // 하한 계산
	const upperBound = b + (b * (percentage / 100)); // 상한 계산
	return a >= lowerBound && a <= upperBound;
};
]]></script>
