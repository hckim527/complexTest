<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.fireDbClick = function(node) {
	if (document.createEventObject) {
		node.fireEvent('ondblclick');
	} else if (document.createEvent) {
		var evt = document.createEvent('MouseEvents');
		evt.initEvent('dblclick', true, false);
		node.dispatchEvent(evt);
	} else if (typeof node.ondblclick == 'function') {
		node.ondblclick();
	}
}
scwin.onpageload = function() {
	grid1.insertRow();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:grid baseNode="vector" repeatNode="data/INFO" id="grid1" style="width: 500px;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" width="70" inputType="text" value="" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="column2" width="70" inputType="text" value="" displayMode="label" dataType="float" displayFormat="#,###.#" maxLength="3.1"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:grid>
		<xf:input adjustMaxLength="false" id="" style="width: 144px;height: 21px;" displayFormat="#,###.#" dataType="float" maxlength="3.1"></xf:input>
	</body>
</html>
 