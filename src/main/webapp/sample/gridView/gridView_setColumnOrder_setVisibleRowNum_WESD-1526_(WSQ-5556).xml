<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
						<w2:column id="col10" name="name10" dataType="text"></w2:column>
						<w2:column id="col11" name="name11" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		// 같은 값 28 Row(col1~col11 값 = 컬럼 id)
		var rows = [];
		for (var i = 0; i < 28; i++) {
			var r = {};
			for (var c = 1; c <= 11; c++) r["col" + c] = "col" + c;
			rows.push(r);
		}
		dlt_dataList2.setJSON(rows);
	};
	scwin.btn_trigger1_onclick = function(e) {
		var colIdList = grd_sample.getColumnIdListMultiRow();
		colIdList[0].reverse()
		grd_sample.setColumnOrder(colIdList[0]);
	};
	scwin.btn_trigger11_onclick = function(e) {
		grd_sample.setVisibleRowNum(20);
	};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" style="width:197px;height:23px;" id="btn_trigger1" ev:onclick="scwin.btn_trigger1_onclick">
			<xf:label><![CDATA[setColumnOrder 실행]]></xf:label>
		</xf:trigger>
		<xf:trigger id="btn_trigger11" style="width:206px;height:23px;" type="button" ev:onclick="scwin.btn_trigger11_onclick">
			<xf:label><![CDATA[setVisibleRowNum 실행]]></xf:label>
		</xf:trigger>
		<w2:gridView id="grd_sample" style="height: 150px;border: 1px solid #eee;" checkAllType="false" defaultCellHeight="20"
			dataList="data:dlt_dataList2" visibleRowNumFix="true" visibleRowNum="10">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column11" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column10" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column9" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column8" value="name4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column7" value="name5" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column6" value="name6" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name7" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name8" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name9" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column2" value="name10" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="name11" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col5" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col6" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col7" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col8" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col9" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col10" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col11" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
