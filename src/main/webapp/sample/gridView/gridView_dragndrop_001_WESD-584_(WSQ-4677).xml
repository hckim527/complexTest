<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection>
				<w2:dataList id="dtl_colInfoAll1" baseNode="map/list" repeatNode="map" valueAttribute="">
					<w2:columnInfo>
						<w2:column id="name" name="name" dataType="text"></w2:column>
						<w2:column id="gender" name="gender" dataType="text"></w2:column>
						<w2:column id="info" name="info" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data xmlns="" use="true">
						<w2:row>
							<name><![CDATA[아이유]]></name>
							<gender><![CDATA[F]]></gender>
							<info><![CDATA[아이유는 로엔 엔터테인먼트 소속의 대한민국 여성 솔로 가수, 배우이다. 아이유(IU)라는 이름은 ‘I’와 ‘You’를 합친 합성어로 ‘너와 내가 음악으로 하나가 된다’는 의미이다.]]></info>
						</w2:row>
						<w2:row>
							<name><![CDATA[정형돈]]></name>
							<gender><![CDATA[A]]></gender>
							<info><![CDATA[정형돈은 대한민국의 개그맨이다.]]></info>
						</w2:row>
						<w2:row>
							<name><![CDATA[유승호]]></name>
							<gender><![CDATA[M]]></gender>
							<info><![CDATA[유승호는 대한민국의 배우이다. 1999년 n016 CF로 연예계에 데뷔하였다. 2000년 특집극 《가시고기》로 연기를 시작하였다.]]></info>
						</w2:row>
						<w2:row>
							<name><![CDATA[김민희]]></name>
							<gender><![CDATA[F]]></gender>
							<info><![CDATA[김민희는 대한민국의 탤런트이자 영화배우 모델이다.]]></info>
						</w2:row>
						<w2:row>
							<name><![CDATA[권지용]]></name>
							<gender><![CDATA[A]]></gender>
							<info><![CDATA[지드래곤은 대한민국의 싱어송라이터이자 프로듀서로, 음악 그룹 빅뱅의 리더이다.]]></info>
						</w2:row>
						<w2:row>
							<name><![CDATA[김현아]]></name>
							<birthday><![CDATA[19920606]]></birthday>
							<gender><![CDATA[F]]></gender>
							<work><![CDATA[1]]></work>
							<info><![CDATA[김현아는 대한민국의 댄스 팝 가수로, 현재는 포미닛의 멤버이다.]]></info>
						</w2:row>
						<w2:row>
							<name><![CDATA[김준현]]></name>
							<birthday><![CDATA[19801116]]></birthday>
							<gender><![CDATA[M]]></gender>
							<work><![CDATA[3]]></work>
							<info><![CDATA[김준현은 대한민국의 개그맨이다. 본관은 김녕이다. 부친은 前 KBS 교양 PD인 김상근이다.]]></info>
						</w2:row>
						<w2:row>
							<name><![CDATA[송중기]]></name>
							<birthday><![CDATA[19850919]]></birthday>
							<gender><![CDATA[M]]></gender>
							<work><![CDATA[4,5]]></work>
							<info><![CDATA[송중기는 대한민국의 배우이다. 2남 1녀 중 차남으로 대전광역시에서 태어났다. 성균관대학교 경영학과를 졸업하였다. 2008년 영화 《쌍화점》으로 데뷔하였다.]]></info>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dtl_codeGender" baseNode="list" repeatNode="map" valueAttribute="">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data xmlns="" use="true">
						<w2:row>
							<label><![CDATA[남자]]></label>
							<value><![CDATA[M]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[여자]]></label>
							<value><![CDATA[F]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[중성]]></label>
							<value><![CDATA[A]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:textbox id="" label="Single" style="width: 150px;height: 23px;font-weight: bold;font-size: 20px;"></w2:textbox>
		<w2:textbox id="" label='dataDragDrop="true" 설정으로 Drag &amp; Drop 기능이 활성화 된다.&lt;br/&gt;현재의 그리드뷰에서 Drag &amp; Drop 동작을 확인할 수 있다.'>
		</w2:textbox>
		<w2:gridView id="" style="height: 350px;" defaultCellHeight="30" dataList="data:dtl_colInfoAll1" dataDragDrop="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="100" inputType="text" id="column3" value="이름" displayMode="label">
					</w2:column>
					<w2:column width="100" inputType="text" id="column1" value="성별" displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="textImage" id="name" displayMode="label" viewType="icon" imageSrc="/websquare/images/devicePreview/icon01.gif" imageHeight="10" imageWidth="10">
					</w2:column>
					<w2:column width="70" inputType="select" id="gender" displayMode="label" allOption="" chooseOption="" ref="">
						<w2:choices>
							<w2:itemset nodeset="data:dtl_codeGender">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html> 