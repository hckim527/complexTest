<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width: 280px;height: 200px;" useShiftKey="true" filterShowAlways="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="column7" inputType="text" style="height:20px" value="메모"
						width="60" useFilter="true">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="col4" inputType="text" style="height:20px" width="70">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<!-- 기본 동작(filterShowAlways 미설정) 비교용: 좁은 컬럼에서도 Header 글자 잘림 없음 -->
		<w2:gridView dataList="dataList1" id="gridView2" style="position: relative;width: 280px;height: 200px;" useShiftKey="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column displayMode="label" id="column8" inputType="text" style="height:20px" value="메모"
						width="60" useFilter="true">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column displayMode="label" id="col4" inputType="text" style="height:20px" width="70">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
