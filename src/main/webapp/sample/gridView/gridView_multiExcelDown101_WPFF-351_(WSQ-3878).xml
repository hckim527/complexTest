<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="text"/>
						<w2:column id="col3" name="name3" dataType="text"/>
						<w2:column id="col4" name="name4" dataType="text"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var arr = [];
	for (var i = 0; i < 101; i++) {
		arr.push({
			"col1": "col1" + i,
			"col2": "col2" + i,
			"col3": "col3" + i,
			"col4": "col4" + i
		});
	}
	dataList1.insertJSON(0, arr);
};
scwin.trigger1_onclick = function(e) {
	grd_gridView1.advancedExcelDownload({});
};
scwin.trigger3_onclick = function(e) {
	var options = {
		common: {
			fileName: "test.xls",
			showProcess: true,
		},
		excelInfo: [{
			gridId: grd_gridView1.id,
			sheetName: "첫번째",
			type: "1"
		}, {
			gridId: grd_gridView2.id,
			sheetName: "드번째",
			type: "1"
		}]
	}
	WebSquare.util.multipleExcelDownload(options);
};
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="height:423px;">
			<xf:trigger id="trigger1" style="width:161px;height:23px;" ev:onclick="scwin.trigger1_onclick" type="button">
				<xf:label><![CDATA[1번그리드 엑셀다운로드]]></xf:label>
			</xf:trigger>
			<w2:gridView id="grd_gridView1" dataList="data:dataList1" style="width: 100%; height:200px;" visibleRowNum="" defaultCellHeight="20" rowNumVisible="true">
				<w2:caption id="caption1" value="this is a grid caption."/>
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column id="column7" removeBorderStyle="false" inputType="text" width="70" value="name1" displayMode="label"/>
						<w2:column id="column5" removeBorderStyle="false" inputType="text" width="70" value="name2" displayMode="label"/>
						<w2:column id="column3" removeBorderStyle="false" inputType="text" width="70" value="name3" displayMode="label"/>
						<w2:column id="column1" removeBorderStyle="false" width="70" inputType="text" value="name4" displayMode="label"/>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="col1" removeBorderStyle="false" inputType="text" width="70" displayMode="label"/>
						<w2:column id="col2" removeBorderStyle="false" inputType="text" width="70" displayMode="label"/>
						<w2:column id="col3" removeBorderStyle="false" inputType="text" width="70" displayMode="label"/>
						<w2:column id="col4" removeBorderStyle="false" width="70" inputType="text" displayMode="label"/>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<w2:gridView id="grd_gridView2" dataList="data:dataList1" style="width: 100%; height:200px;" visibleRowNum="" defaultCellHeight="20" rowNumVisible="true">
				<w2:caption id="caption1" value="this is a grid caption."/>
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column id="column7" removeBorderStyle="false" inputType="text" width="70" value="name1" displayMode="label"/>
						<w2:column id="column5" removeBorderStyle="false" inputType="text" width="70" value="name2" displayMode="label"/>
						<w2:column id="column3" removeBorderStyle="false" inputType="text" width="70" value="name3" displayMode="label"/>
						<w2:column id="column1" removeBorderStyle="false" width="70" inputType="text" value="name4" displayMode="label"/>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="col1" removeBorderStyle="false" inputType="text" width="70" displayMode="label"/>
						<w2:column id="col2" removeBorderStyle="false" inputType="text" width="70" displayMode="label"/>
						<w2:column id="col3" removeBorderStyle="false" inputType="text" width="70" displayMode="label"/>
						<w2:column id="col4" removeBorderStyle="false" width="70" inputType="text" displayMode="label"/>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:trigger type="button" id="trigger3" style="width:182px;height:23px;" ev:onclick="scwin.trigger3_onclick">
				<xf:label><![CDATA[멀티엑셀다운로드]]></xf:label>
			</xf:trigger>
		</xf:group></body>
</html>
