<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlgrid2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dlgrid3" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="float" id="col1" name="name1"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var dataArr = [];
	for (var i = 0; i < 99; i++) {
		dataArr.push("AEX");
	}
	dlgrid2.setData(dataArr);
	dlgrid3.setData(["1234.1", "1234.12", "1234.123", "1234.1234"]);
};
scwin.btnExcelUp_onclick = function(e) {
	var options = {
		type: "1",
		startRowIndex: 1
	};
	grd3.advancedExcelUpload(options);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" class="wrap">
			<xf:group class="grp_tbtitle" id="">
				<xf:group class="leftbox" id=""></xf:group>
			</xf:group>
			<w2:gridView id="grd2" style="width: 500px;height: 150px;" defaultCellHeight="20" dataList="data:dlgrid2">
				<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="column1" value="name1" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column removeBorderStyle="false" width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:group class="grp_tbtitle" id="">
				<xf:trigger ev:onclick="scwin.btnExcelUp_onclick" id="btnExcelUp" style="width: 80px;height: 23px;" type="button">
					<xf:label><![CDATA[excel Upload]]></xf:label>
				</xf:trigger>
			</xf:group>
			<w2:gridView dataList="data:dlgrid3" defaultCellHeight="20" id="grd3" style="width: 500px;height: 150px;">
				<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column displayMode="label" id="column1" inputType="text" removeBorderStyle="false" style="height:20px;" value="name1" width="128"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column displayMode="label" id="col1" inputType="text" removeBorderStyle="false" width="128" dataType="float" displayFormat="#,###.##" maxLength="7.2"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
