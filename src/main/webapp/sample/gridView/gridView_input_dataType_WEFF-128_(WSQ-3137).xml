<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	grid1.setRef({
		ref: "vector",
		baseNode: "vector",
		repeatNode: "data"
	});
	grid1.insertRow();
	grid1.setCellInputType(0, 0, {
		inputType: "text",
		options: {
			dataType: "float",
			displayFormat: "#,###.##"
		}
	});
	grid1.setCellData(0, 1, "float");
	grid1.insertRow();
	grid1.setCellInputType(1, 0, {
		inputType: "text",
		options: {
			dataType: "number",
			displayFormat: "#,###.##"
		}
	});
	grid1.setCellData(1, 1, "number");
};

scwin.fireDbClick = function(id) {
	var node = document.getElementById($p.id + id) || document.getElementById(id);
	var evt = document.createEvent('MouseEvents');
	evt.initEvent('dblclick', true, false);
	node.dispatchEvent(evt);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:grid ref="vector" baseNode="vector" repeatNode="data" id="grid1" style="width:553px;height:150px;" fixedColumnWithHidden="true" useShiftKey="true"
			setCellInputTypeCustom="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column blockSelect="false" id="column1" style="height:20px;" width="120" inputType="text" displayMode="label" value="custom"></w2:column>
					<w2:column blockSelect="false" id="column3" style="height:20px;" inputType="text" width="120" value="" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="column5" style="height:20px;" inputType="text" width="120" value="float" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="column7" style="height:20px;" inputType="text" width="120" value="number" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column blockSelect="false" id="column2" width="120" inputType="custom" value="" displayMode="label" defaultValue=""></w2:column>
					<w2:column blockSelect="false" id="column4" inputType="text" width="120" value="" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="column6" inputType="text" width="70" value="" displayMode="label" dataType="float" displayFormat="#,###.##"></w2:column>
					<w2:column blockSelect="false" id="column8" inputType="text" width="70" value="" displayMode="label" dataType="number" displayFormat="#,###.##"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:grid>
	</body>
</html>
