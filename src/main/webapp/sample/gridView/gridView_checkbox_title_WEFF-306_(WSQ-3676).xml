<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.titleFormatter = function(rowIndex, colIndex, value) {
	console.log(rowIndex + " : " + colIndex + " : " + value);
	return "title : " + value;
};

scwin.onpageload = function() {
	dataList1.setJSON([{
		col1: "1",
		col2: "2",
		col3: "3",
		col4: "4"
	}]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="position: absolute ;left:49px;top:41px;width: 500px;height: 150px;"
			useShiftKey="true" titleFormatter="scwin.titleFormatter" senseReader="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column7" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column5" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name3" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name4" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="radio" width="70" displayMode="label"></w2:column>
					<w2:column title="타이틀" checkboxLabelColumn="col4" id="col2" inputType="checkbox" width="70" displayMode="label" checkboxLabel="헬로"></w2:column>
					<w2:column id="col3" inputType="radio" width="70" displayMode="label" radioLabel="안녕" radioLabelPosition="left"></w2:column>
					<w2:column id="col4" width="70" inputType="button" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
