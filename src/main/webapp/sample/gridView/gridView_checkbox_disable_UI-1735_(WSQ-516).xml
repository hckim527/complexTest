<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col2><![CDATA[1]]></col2>
							<col3><![CDATA[2]]></col3>
							<col1><![CDATA[1]]></col1>
						</w2:row>
						<w2:row>
							<col2><![CDATA[2]]></col2>
							<col3><![CDATA[3]]></col3>
							<col1><![CDATA[2]]></col1>
						</w2:row>
						<w2:row>
							<col2><![CDATA[3]]></col2>
							<col3><![CDATA[4]]></col3>
							<col1><![CDATA[3]]></col1>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.trigger1_onclick = function(e) {
	grd.setCellReadOnly(1, 0, true);
};
scwin.checkVal = function() {
	return scwin.__getDom($p.id+"grd_cell_1_0").getAttribute('data-readonly') == 'true';
}
]]></script>
	</head>
	<body>
		<w2:gridView dataList="dataList1" id="grd"
			style="position: absolute;width: 500px;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" inputType="checkbox" width="70" value="name1"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="checkbox" width="70" checkAlways="true"></w2:column>
					<w2:column id="col2" inputType="text" width="70"></w2:column>
					<w2:column id="col3" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: absolute;width: 80px;height: 23px;left:13px;top:158px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[]]></xf:label>
		</xf:trigger>
	</body>
</html>
 