<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList3" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	scwin.init();
};
scwin.init = function() {
	gridView1.setColumnNodeSet("col2", "data:dataList3", "col2", "col1");
	var jsonData2 = [{
		"col1": "하나",
		"col2": "01"
	}, {
		"col1": "둘",
		"col2": "02"
	}, {
		"col1": "셋",
		"col2": "03"
	}];
	dataList2.setJSON(jsonData2);
	var jsonData3 = [{
		col1: "1",
		col2: "ONE"
	}, {
		col1: "2",
		col2: "TWO"
	}, {
		col1: "3",
		col2: "THREE"
	}];
	dataList3.setJSON(jsonData3);
	var jsonData1 = [{
		"col1": "01",
		"col2": "1"
	}, {
		"col1": "02",
		"col2": "2"
	}, {
		"col1": "03",
		"col2": "3"
	}];
	dataList1.setJSON(jsonData1);
};
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1"
			style="position: absolute ;left: 28px;top: 49px;width:186px;height:190px;">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="text" width="70" value="name1"
						displayMode="label">
					</w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name2"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="autoComplete" width="70"
						displayMode="value delim label" chooseOption="true" chooseOptionLabel="test">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col2" width="70" inputType="autoComplete"
						displayMode="value delim label" chooseOption="true" chooseOptionLabel="test">
						<w2:choices></w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: absolute ;left:227px;top:97px;width: 148px;height: 58px;"
			ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[init]]></xf:label>
		</xf:trigger>
	</body>
</html>
