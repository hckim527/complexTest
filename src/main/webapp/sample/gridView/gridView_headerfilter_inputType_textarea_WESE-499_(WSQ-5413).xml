<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
	var rows = [
		{ "col1": "1234", "col2": "4567", "col3": "ccc", "col4": "바바바바" },
		{ "col1": "A1234", "col2": "aA1245", "col3": "Aa5434", "col4": "가가가가" },
		{ "col1": "a4567", "col2": "Aa4534", "col3": "aA4512", "col4": "나나나나" },
		{ "col1": "B1234", "col2": "bB1247", "col3": "Bb7834", "col4": "다다다다" },
		{ "col1": "b4567", "col2": "Bb4523", "col3": "bB1267", "col4": "라라라라" },
		{ "col1": "c1342", "col2": "Cc1282", "col3": "cCc1234", "col4": "마마마마" }
	];
	var data = [];
	for (var i = 0; i < 3; i++) {
		data = data.concat(JSON.parse(JSON.stringify(rows)));
	}
	dataList1.setJSON(data);
};

//col4 의 바디 컬럼 값을 customformatter로 ABC_ 를 추가로 넣음
scwin.customFormatter_col4 = function (data, formattedData, rowIndex, colIndex) {
	return "ABC_" + formattedData;
};

//col3 의 바디 컬럼 값을 customformatter로 XYZ_ 를 추가로 넣음
scwin.customFormatter_col3 = function (data, formattedData, rowIndex, colIndex) {
	return "XYZ_" + formattedData;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<w2:textbox label='useFilterSearch="false" useFilterListFormat="false"' style="width:323px;height:23px;" escape="false"></w2:textbox>
			<w2:gridView scrollByColumnAdaptive="false" summaryAuto="false" useShiftKey="true" scrollByColumn="false"
				summaryOnlyAuto="false" fixedColumnWithHidden="true" dataList="dataList1" style="position: relative;width: 500px;height: 250px;"
				ignoreCellClick="false" id="gridView1" autoFit="allColumn" ignoreToggleOnDisabled="false" useFilterList="true" sortedImagePosition="top"
				showSortableUseFilter="true" showSortableImage="true" sortHeaderDiv="true" visibleRowNum="all">
				<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column width="120" style="height:30px;" inputType="text" id="column1" value="name1" blockSelect="false" displayMode="label" sortable="true"></w2:column>
						<w2:column width="120" style="height:30px;" inputType="text" id="column2" value="name2" blockSelect="false" displayMode="label" sortable="true"></w2:column>
						<w2:column width="120" style="height:30px;" inputType="text" id="column3" value="name3" blockSelect="false" displayMode="label" sortable="true"></w2:column>
						<w2:column width="120" style="height:30px;" inputType="text" id="column4" value="name4" blockSelect="false" displayMode="label" sortable="true"></w2:column>
					</w2:row>
					<w2:row id="row2">
						<w2:column width="120" style="height:30px;" inputType="text" id="column11" blockSelect="false" displayMode="label"></w2:column>
						<w2:column width="120" style="height:30px;" inputType="text" id="column22" blockSelect="false" displayMode="label"></w2:column>
						<w2:column width="120" style="height:30px;" inputType="text" id="column33" blockSelect="false" displayMode="label"></w2:column>
						<w2:column width="120" style="height:30px;" inputType="text" id="column44" blockSelect="false" displayMode="label" useFilter="true" hideCustomFilter="true"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column width="120" style="height:30px;" inputType="text" id="col1" blockSelect="false" displayMode="label" colSpan="" rowSpan="2"></w2:column>
						<w2:column width="120" style="height:30px;" inputType="text" id="col2" blockSelect="false" displayMode="label"></w2:column>
						<w2:column width="120" style="height:30px;" inputType="text" id="col3" blockSelect="false" displayMode="label" customFormatter="scwin.customFormatter_col3"></w2:column>
						<w2:column width="120" style="height:30px;" inputType="text" id="col4" blockSelect="false" displayMode="label" customFormatter="scwin.customFormatter_col4"></w2:column>
					</w2:row>
					<w2:row id="row4">
						<w2:column width="360" inputType="textarea" id="column51" displayMode="label" colSpan="3" rowSpan="" textAlign="left" escape="false" displayType="all"></w2:column>
					</w2:row>
				</w2:gBody>
				<w2:footer id="footer1">
					<w2:row id="row3">
						<w2:column width="360" inputType="text" id="column48" value="합계" displayMode="label" colSpan="3" rowSpan=""></w2:column>
						<w2:column width="120" inputType="text" id="column45" displayMode="label"></w2:column>
					</w2:row>
				</w2:footer>
			</w2:gridView>
		</xf:group>
	</body>
</html>
