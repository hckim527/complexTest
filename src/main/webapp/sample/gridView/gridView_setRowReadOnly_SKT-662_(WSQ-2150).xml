<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns='' />
			</xf:instance>
			<w2:dataCollection baseNode='map'>
				<w2:dataList id='dataList1' baseNode='list' saveRemovedData='true' repeatNode='map'>
					<w2:columnInfo>
						<w2:column id='col1' name='nm1' dataType='text' ignoreStatus='true'></w2:column>
						<w2:column id='col2' name='nm2' dataType='number'></w2:column>
						<w2:column id='col3' name='nm3' dataType='text'></w2:column>
						<w2:column id='col4' name='nm4' dataType='text'></w2:column>
						<w2:column id='col5' name='nm5' dataType='text'></w2:column>
						<w2:column id='col6' name='nm6' dataType='date'></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type='text/javascript' lazy='false'><![CDATA[
scwin.customFunc = function(data, formatData, row, col) {
	return (data, '11', 'aa', '22', 'bb', 'cc');
}
scwin.trigger4_onclick = function(e) {
	dataList1.insertRow(0);
};
scwin.grd_list1_onrowindexchange = function(row, oldRow) {
	log = dataList1.getCellData(row, 0);
};
]]></script>
	</head>
	<body>
		<xf:group id='grpIdTop' class='sub_cont'>
			<w2:gridView autoFit='allColumn' autoFitMinWidth='100' dataList='dataList1' dataDragSelect='true'
				fixedColumn='' id='grd_list1' style='height:400px;left:-6px;top:-3px;' editModeEvent='onclick' readOnly='' sortEvent='onclick'
				focusMove='' tooltipDisplay='true' focusMode='' useShiftKey='true' wheelRows=''
				rowNumVisible='true' defaultCellHeight='' tooltipShowAlways='true' ev:onrowindexchange='scwin.grd_list1_onrowindexchange'>
				<w2:header id='header1'>
					<w2:row id='row2'>
						<w2:column id='column1' width='70' inputType='checkbox' value='nm1' sortable='false'>
						</w2:column>
						<w2:column id='column3' width='70' inputType='text' value='nm2'></w2:column>
						<w2:column id='column8' inputType='text' width='70' value='nm3'></w2:column>
						<w2:column id='column9' inputType='text' width='70' value='nm4'></w2:column>
						<w2:column id='column10' inputType='text' width='70' value='nm5'></w2:column>
						<w2:column id='column11' inputType='text' width='70' value='nm6'></w2:column>
						<w2:column id='column31' inputType='text' width='70' value='nm7'></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id='gBody4'>
					<w2:row id='row5'>
						<w2:column id='col1' inputType='checkbox'></w2:column>
						<w2:column id='col2' inputType='text' displayFormat='#,###.00'
							customFormatter='scwin.customFunc'>
						</w2:column>
						<w2:column id='col3' inputType='text' readOnly='false'
							disabled=''>
						</w2:column>
						<w2:column id='col4' inputType='expression' dataType='text' chooseOption='true' expression=''>
						</w2:column>
						<w2:column id='col5' inputType='textarea' escape=''></w2:column>
						<w2:column id='col6' inputType='calendar' value='' readOnly='' dataType='date'
							calendarValueType='yearMonthDateTimeSec' displayFormat='' disabledClass='' skipConfirmOnly='true'>
						</w2:column>
						<w2:column id='column32' inputType='button' width='70' displayFormat=''></w2:column>
					</w2:row>
				</w2:gBody>
				<w2:footer id='footer1'>
					<w2:row id='row7'>
						<w2:column id='column23' width='70' inputType='text' value='합계'></w2:column>
						<w2:column id='column24' hidden='false' width='70' inputType='expression'
							expression="dataList1.getRowCount()">
						</w2:column>
						<w2:column id='column21' width='70' inputType='expression' expression="sum('col2')"></w2:column>
						<w2:column id='column20' width='70' inputType='text'></w2:column>
						<w2:column id='column19' width='70' inputType='text'></w2:column>
						<w2:column id='column18' width='70' inputType='text'></w2:column>
						<w2:column id='column34' inputType='text' width='70'></w2:column>
					</w2:row>
				</w2:footer>
			</w2:gridView>
			<xf:trigger type='button' id='trigger4' style='position: relative;width: 80px;height: 23px;'
				ev:onclick='scwin.trigger4_onclick'>
				<xf:label><![CDATA[행추가]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
