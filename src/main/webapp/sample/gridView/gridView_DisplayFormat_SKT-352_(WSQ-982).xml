					saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1"
							dataType="number">
						</w2:column>
						<w2:column id="col2" name="name2"
							dataType="number">
						</w2:column>
						<w2:column id="col3" name="name3"
							dataType="number">
						</w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1.59595]]></col1>
							<col2><![CDATA[5659.3633669]]></col2>
							<col3><![CDATA[1.23]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[262.26565]]></col1>
							<col2><![CDATA[565.3365]]></col2>
							<col3><![CDATA[3263.3696]]></col3>
						</w2:row>
						<w2:row>
