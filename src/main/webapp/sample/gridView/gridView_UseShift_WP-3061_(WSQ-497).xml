<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_grid" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="name" name="name" dataType="text"></w2:column>
						<w2:column id="age" name="age" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	window.jsonData = [{
			"name": "shin",
			"age": "10"
		},
		{
			"name": "kim",
			"age": "20"
		},
		{
			"name": "jung",
			"age": "30"
		},
		{
			"name": "song",
			"age": "40"
		}
	];
	dlt_grid.setJSON(jsonData);
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="" useShiftKey="false" style="position: relative ;left: 24px;top: 41px;width: 500px;height: 150px;" dataList="dlt_grid" useCtrlKey="">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column3" displayMode="label" value="name"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" displayMode="label" value="age"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="name" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="age" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
