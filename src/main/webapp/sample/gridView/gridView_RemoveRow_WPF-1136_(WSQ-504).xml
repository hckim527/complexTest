<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	jsonData1 = [{
		"col1": "test1_1",
		"col2": "test1_2"
	}]
	jsonData2 = [{
		"col1": "test2_1",
		"col2": "test2_2"
	}]
	jsonData3 = [{
		"col1": "test3_1",
		"col2": "test3_2"
	}]
	dataList1.setJSON(jsonData1, true);
	dataList1.setJSON(jsonData2, true);
	dataList1.setJSON(jsonData3, true);
};
scwin.trigger2_onclick = function(e) {
	dataList1.removeRow(2);
	dataList1.removeRow(1);
};
scwin.trigger3_onclick = function(e) {
	jsonData4 = [{
		"col1": "test4_1",
		"col2": "test4_2"
	}]
	dataList1.setJSON(jsonData4, true);
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" id="trigger1" style="position: relative;width: 150px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setp1.setJson(jsondata,true) ]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position: relative;width: 120px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[setp2.removeRow]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger3" style="position: relative;width: 150px;height: 23px;" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[step3.setJson(jsondata,true) ]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="dataList1" id="gridView1"
			style="position: relative;width: 500px;height: 150px;"
			fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column7" style="height:20px" inputType="text" width="70" displayMode="label"
						value="name1">
					</w2:column>
					<w2:column id="column3" style="height:20px" width="70" inputType="text" displayMode="label"
						value="name2">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
