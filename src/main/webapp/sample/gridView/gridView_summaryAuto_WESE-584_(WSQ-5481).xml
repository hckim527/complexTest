						<w2:column dataType="text" id="book_name" name="도서명"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dlt_exam2" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="categoryLabel" name="분류"></w2:column>
						<w2:column dataType="text" id="book_name" name="도서명"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
	let arrData = [
		{ "book_name": "거의 모든 전쟁의 역사", "categoryLabel": "역사/문화" },
		{ "book_name": "공정하다는 착각", "categoryLabel": "인문" },
		{ "book_name": "잘했고 잘하고 있고 잘 될 것이다", "categoryLabel": "시/에세이" },
		{ "book_name": "모든 사람에게 좋은 사람일 필요는 없어", "categoryLabel": "시/에세이" },
		{ "book_name": "기분을 관리하면 인생이 관리된다", "categoryLabel": "시/에세이" },
		{ "book_name": "나는 둔감하게 살기로 했다", "categoryLabel": "인문" },
		{ "book_name": "나로서 충분히 괜찮은 사람", "categoryLabel": "시/에세이" },
		{ "book_name": "나의 문화유산답사기", "categoryLabel": "역사/문화" },
		{ "book_name": "내가 틀릴 수도 있습니다", "categoryLabel": "인문" },
		{ "book_name": "너무 잘하려고 애쓰지 마라", "categoryLabel": "시/에세이" },
		{ "book_name": "마음의 법칙", "categoryLabel": "인문" },
		{ "book_name": "무엇이 옳은가", "categoryLabel": "인문" },
		{ "book_name": "문명의 붕괴(Collapse)", "categoryLabel": "역사/문화" },
		{ "book_name": "미움받을 용기", "categoryLabel": "인문" },
		{ "book_name": "선을 넘지 않는 사람이 성공한다", "categoryLabel": "자기계발" },
		{ "book_name": "우리는 여전히 삶을 사랑하는가", "categoryLabel": "인문" }
	];

	dlt_exam1.setJSON(arrData);
	dlt_exam2.setJSON(arrData);
};

	scwin.checkVal = function() {
		if (WebSquare.docType === "html5") {
			return (document.getElementById('grd_exam2_body_table') || document.getElementById('mf_grd_exam2_body_table')).getAttribute('summary') == null;
		} else {
			return (document.getElementById('grd_exam2_body_table') || document.getElementById('mf_grd_exam2_body_table')).getAttribute('summary') == '분류,도서명';
		}
	}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<xf:group class="example_div_tb_style_wrap">
				<xf:group class="example_div_tr_style">
					<w2:textbox class="example_div_th_style" escape="false" label='summary="Summary 설정 테스트입니다."'></w2:textbox>
					<xf:group class="example_div_td_style">
						<w2:gridView autoFit="lastColumn" autoFitMinWidth="240" class="gvw" dataList="data:dlt_exam1" defaultCellHeight="24"
							id="grd_exam1" style="height:100px;" visibleRowNum="4" readOnly="true" summary="Summary 설정 테스트입니다.">
							<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
							<w2:header id="header1">
								<w2:row id="row1">
									<w2:column width="70" inputType="text" id="column4" value="분류" displayMode="label"></w2:column>
									<w2:column displayMode="label" id="column3" inputType="text" value="도서명" width="178"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody1">
								<w2:row id="row2">
									<w2:column width="70" inputType="text" id="categoryLabel" displayMode="label"></w2:column>
									<w2:column displayMode="label" id="book_name" inputType="text" textAlign="left" width="178"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>
				<xf:group class="example_div_tr_style">
					<w2:textbox class="example_div_th_style" escape="false" label='summaryAuto="true"'></w2:textbox>
					<xf:group class="example_div_td_style">
						<w2:gridView autoFit="lastColumn" autoFitMinWidth="240" class="gvw" dataList="data:dlt_exam2" defaultCellHeight="24"
							id="grd_exam2" readOnly="true" style="height:100px;" visibleRowNum="4" summaryAuto="true">
							<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
							<w2:header id="header1">
								<w2:row id="row1">
									<w2:column displayMode="label" id="column4" inputType="text" value="분류" width="70"></w2:column>
									<w2:column displayMode="label" id="column3" inputType="text" value="도서명" width="178"></w2:column>
								</w2:row>
							</w2:header>
							<w2:gBody id="gBody1">
								<w2:row id="row2">
									<w2:column displayMode="label" id="categoryLabel" inputType="text" width="70"></w2:column>
									<w2:column displayMode="label" id="book_name" inputType="text" textAlign="left" width="178"></w2:column>
								</w2:row>
							</w2:gBody>
						</w2:gridView>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>