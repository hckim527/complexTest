<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="1" name="1" dataType="text"></w2:column>
						<w2:column id="2" name="2" dataType="text"></w2:column>
						<w2:column id="3" name="3" dataType="text"></w2:column>
						<w2:column id="4" name="4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<w2:gridView checkAllType="false" dataList="data:dataList1" defaultCellHeight="20" id="gridView1"
			senseReader="true" style="width: 500px;height: 250px;">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column4" value="1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value="3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="4" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:50px;color:black;" id="1" value="test" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:50px;" id="2" value="test2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:50px;" id="3" value="test3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:50px;" id="4" value="test4" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal1" targetColumnID="1">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="s1" value="소계" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="s2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="s3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="s4" displayMode="label"></w2:column>
				</w2:row>
			</w2:subTotal>
			<w2:footer id="footer1">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="f1" value="합계" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="f2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="f3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="f4" displayMode="label"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
	</body>
</html>
