<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="key3" name="name3" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="true">
						<key3><![CDATA[1234]]></key3>
					</w2:data>
				</w2:dataMap>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="소숫점숫자" dataType="number"></w2:column>
						<w2:column id="col2" name="소숫점숫자" dataType="bigDecimal"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1234]]></col1>
							<col2><![CDATA[1234]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.checkVal = function() {
	const valueText = document.getElementById('mf_ibx_key3').value;
	const innerText = document.getElementById('mf_tbx_key3').innerText;
	return valueText == '1,234.00' && innerText == '1234.00';
};
]]></script>
	</head>
	<body>
		<xf:input allowChar="0-9." dataType="number" displayFormat="#,###.#0" id="ibx_key3" maskFormat="reverse"
			maskFormatModelExcludeChar="," ref="data:dataMap1.key3" style="width: 200px;height: 21px;text-align: right;" maskFormatModelNumber="true"></xf:input>
		<w2:textbox id="tbx_key3" label="data" ref="data:dataMap1.key3" style="width: 150px;height: 23px;"></w2:textbox>
		<w2:gridView defaultCellHeight="20" id="grd_test" style="width: 300px;height: 150px;" dataList="data:dataList1" focusMode="row">
			<w2:header id="header3">
				<w2:row id="row5">
					<w2:column width="100" inputType="text" id="column6" value="number" displayMode="label"></w2:column>
					<w2:column width="100" inputType="text" id="column5" value="bigDecimal" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody3">
				<w2:row id="row6">
					<w2:column width="100" inputType="text" id="col1" displayMode="label" dataType="number"
						maskFormatModelExcludeChar="," maskFormat="reverse" displayFormat="#,###.#0" allowChar="0-9." textAlign="right" maskFormatModelNumber="true"></w2:column>
					<w2:column width="100" inputType="text" id="col2" displayMode="label" dataType="bigDecimal"
						maskFormatModelExcludeChar="," maskFormat="reverse" displayFormat="#,###.#0" allowChar="0-9." textAlign="right" maskFormatModelNumber="true"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
