<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[a]]></col1>
							<col2><![CDATA[1]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[b]]></col1>
							<col2><![CDATA[2]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[c]]></col1>
							<col2><![CDATA[3]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dl_combo2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="chk" name="name3" dataType="text"></w2:column>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		var comboJSON = [
            {"label":"가","value":"value1","chk":"0"}
            ,{"label":"나","value":"value2","chk":"0"}
            ,{"label":"다","value":"value3","chk":"0"}
            ,{"label":"라","value":"value4","chk":"0"}
        ];
        dl_combo2.setJSON( comboJSON );
	};
	]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 650px;height: 150px;" defaultCellHeight="20" focusFlow="linear" moveKeyEditModeAll="true" dataList="data:dataList2">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="90" inputType="text" style="height:20px" id="column6" value="autoComplete" displayMode="label"></w2:column>
					<w2:column width="200" inputType="text" style="height:20px" id="column3" value="autoComplete gridViewItemset" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="autoComplete" style="height:20px" id="col2" displayMode="label" directOpen="true" viewTypeIconImage="true" viewType="icon" emptyItem="true">
						<w2:choices>
							<w2:itemset nodeset="data:dataList1">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col5" directOpen="true" viewTypeIconImage="true" viewType="icon" inputType="autoComplete" findItemFirstKey="true" width="70" displayMode="label">
						<w2:choices>
							<w2:gridViewItemset autoFit="" selectedRowColor="" height="" visibleRowNum="" rowMouseOver="" width="70" nodeset="data:dl_combo2" value="value" rowMouseOverColor="" label="label" hideHeader="">
								<w2:item ref="label" hidden="" header="라벨" headerStyle=""></w2:item>
								<w2:item ref="value" hidden="" header="밸류" headerStyle=""></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
