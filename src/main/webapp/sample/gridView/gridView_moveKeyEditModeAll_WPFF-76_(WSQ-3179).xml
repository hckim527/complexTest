<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
						<w2:column id="col10" name="name10" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList3" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList4" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var data = [];
	var data2 = [];
	var now = "2018/01/15";
	for (var i = 0; i < 20; i++) {
		for (var j = 0; j < 10; j++) {
			if (j === 0 || j === 2 || j === 3 || j === 5 || j === 7 || j === 9) {
				data.push(WebSquare.date.dateAdd(now, i));
			} else {
				data.push(i + "");
			}
		}
	}
	for (var i = 0; i < 20; i++) {
		for (var j = 0; j < 2; j++) {
			data2.push(i + "");
		}
	}
	dataList2.setData(data2);
	dataList3.setData(data2);
	dataList4.setData(data2);
	dataList1.setData(data);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="width:1041px;height:180px;" useShiftKey="true" moveKeyEditModeAll="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column19" inputType="text" width="100" value="name1(text)" displayMode="label"></w2:column>
					<w2:column id="column17" inputType="text" width="100" value="name2(select)" displayMode="label"></w2:column>
					<w2:column id="column15" inputType="text" width="100" value="name3(calendar)" displayMode="label"></w2:column>
					<w2:column id="column13" inputType="text" width="100" value="name4(link)" displayMode="label"></w2:column>
					<w2:column id="column11" inputType="text" width="100" value="name5(cb)" displayMode="label"></w2:column>
					<w2:column id="column9" inputType="text" width="100" value="name6(btn)" displayMode="label"></w2:column>
					<w2:column id="column7" inputType="text" width="100" value="name7(ccb)" displayMode="label"></w2:column>
					<w2:column id="column5" inputType="text" width="100" value="name8(secret)" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="100" value="name9(autoComplete)" displayMode="label"></w2:column>
					<w2:column id="column1" width="100" inputType="text" value="name10(textarea)" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="100" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="select" width="100" displayMode="label" ref="">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col3" inputType="calendar" width="100" displayMode="label"></w2:column>
					<w2:column id="col4" inputType="link" width="100" displayMode="label"></w2:column>
					<w2:column id="col5" inputType="checkbox" width="100" displayMode="label"></w2:column>
					<w2:column id="col6" inputType="button" width="100" displayMode="label"></w2:column>
					<w2:column id="col7" inputType="checkcombobox" width="100" displayMode="label" ref="">
						<w2:choices>
							<w2:itemset nodeset="data:dataList3">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col8" inputType="secret" width="100" displayMode="label"></w2:column>
					<w2:column id="col9" inputType="autoComplete" width="100" displayMode="label" ref="">
						<w2:choices>
							<w2:itemset nodeset="data:dataList4">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col10" width="100" inputType="textarea" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
