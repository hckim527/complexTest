<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
	<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{col1:"afwafewfkjewlfae",col3:"a"},{col1:"c",col3:"c"},{col1:"d",col3:"d"},{col1:"b",col3:"b"}];
	dataList1.setJSON(jsonData);
};
scwin.gridView1_ongroupby = function(options) {
	scwin.test(options);
};
scwin.test = function(options) {
	options.closeGroup = true;
	options.groupbyHeader = [{colSpan: "3", inputType: "expression", expression: " toggle() + depthStr() + ' [ ' + count() + ' 건 ] ' ", align: "left" }];
	options.groupbyFooter = [
		{colSpan:"3",inputType: "expression", expression: " SUM('col2')", displayFormatter: "countFormatFunction", align: "center"}
	];
	gridView1.groupby( options ); //실제 groupby 실행
};
var countFormatFunction = function( value ) {
	return "총판매수량 : " + value + " 개 ";
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="left:0px;top:0px;width:400px;height:200px;" useFilterList="true" sortable="true" groupbyDisplayRowIndex="true" dataList="dataList1" rowNumVisible="true" autoFit="lastColumn" focusMode="row"  syncRowPositionOption="style" editModeEvent="onclick" scrollFocus="true" titleAuto="true" groupbyZone="true" ev:ongroupby="scwin.gridView1_ongroupby">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column1" inputType="text" value="name1" width="70"></w2:column>
					<w2:column id="column2" inputType="text" value="name2" width="70" useFilter="true"></w2:column>
					<w2:column id="column3" inputType="text" value="name3" width="70" useFilter="true"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column inputType="text" id="col1" width="70"></w2:column>
					<w2:column inputType="text" id="col2" width="70"></w2:column>
					<w2:column inputType="text" id="col3" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>