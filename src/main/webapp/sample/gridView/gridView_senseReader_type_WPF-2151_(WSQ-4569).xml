<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="number"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	window.jsonData = [{
		col1: "0",
		col2: "0",
		col3: "0"
	}, {
		col1: "0",
		col2: "0",
		col3: "0"
	}, {
		col1: "0",
		col2: "0",
		col3: "0"
	}]
	dataList1.setJSON(jsonData);
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:span label="senseReader='true'" id="span1" style="width: 91px;height: 33px;"></w2:span>
		<w2:gridView dataList="dataList1" senseReader="true" defaultCellHeight="20" id="gridView1" style="width: 500px;height: 150px;" useShiftKey="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" inputType="text" width="70" value="type number" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70" displayMode="label" dataType="number" type="number"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label" ime-mode="active"></w2:column>
					<w2:column id="col3" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:span label="senseReader='false'" id="span2" style="width: 91px;height: 33px;"></w2:span>
		<w2:gridView dataList="dataList1" senseReader="false" defaultCellHeight="20" id="gridView2" style="width: 500px;height: 150px;" useShiftKey="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" inputType="text" width="70" value="type number" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70" displayMode="label" dataType="number" type="number"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label" ime-mode="active"></w2:column>
					<w2:column id="col3" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
