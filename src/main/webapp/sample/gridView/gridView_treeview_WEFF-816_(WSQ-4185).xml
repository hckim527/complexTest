<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
						<w2:column id="depth" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[1]]></label>
							<value><![CDATA[1]]></value>
							<depth><![CDATA[1]]></depth>
						</w2:row>
						<w2:row>
							<label><![CDATA[1-1]]></label>
							<value><![CDATA[2]]></value>
							<depth><![CDATA[2]]></depth>
						</w2:row>
						<w2:row>
							<label><![CDATA[1-1-1]]></label>
							<value><![CDATA[3]]></value>
							<depth><![CDATA[3]]></depth>
						</w2:row>
						<w2:row>
							<label><![CDATA[1-2]]></label>
							<depth><![CDATA[2]]></depth>
							<value><![CDATA[4]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[2]]></label>
							<depth><![CDATA[1]]></depth>
							<value><![CDATA[5]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[2-1]]></label>
							<depth><![CDATA[2]]></depth>
							<value><![CDATA[6]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
						<w2:column id="depth" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[1]]></label>
							<value><![CDATA[1]]></value>
							<depth><![CDATA[1]]></depth>
						</w2:row>
						<w2:row>
							<label><![CDATA[1-1]]></label>
							<value><![CDATA[2]]></value>
							<depth><![CDATA[2]]></depth>
						</w2:row>
						<w2:row>
							<label><![CDATA[1-1-1]]></label>
							<value><![CDATA[3]]></value>
							<depth><![CDATA[3]]></depth>
						</w2:row>
						<w2:row>
							<label><![CDATA[1-2]]></label>
							<depth><![CDATA[2]]></depth>
							<value><![CDATA[4]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[2]]></label>
							<depth><![CDATA[1]]></depth>
							<value><![CDATA[5]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[2-1]]></label>
							<depth><![CDATA[2]]></depth>
							<value><![CDATA[6]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[3]]></label>
							<depth><![CDATA[1]]></depth>
							<value><![CDATA[5]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[3-1]]></label>
							<depth><![CDATA[2]]></depth>
							<value><![CDATA[6]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[3-1-1]]></label>
							<depth><![CDATA[3]]></depth>
							<value><![CDATA[6]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[3-1-2]]></label>
							<depth><![CDATA[3]]></depth>
							<value><![CDATA[6]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[3-2]]></label>
							<depth><![CDATA[2]]></depth>
							<value><![CDATA[6]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[3-2-1]]></label>
							<depth><![CDATA[3]]></depth>
							<value><![CDATA[6]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	localStorage.removeItem("log1");
	localStorage.removeItem("log2");
};
// gridView Row 를 treeview 에 drop → treeview 데이터에 추가
scwin.treeview1_ondropfromgrid = function(info) {
	localStorage.setItem("log1", this.id + " ondropfromgrid event");
	var dataArr = $p.getComponentById(info.dataListId).getRowArray(info.fromRowIndex).data;
	dataList2.insertData(info.toRowIndex + 1, dataArr);
};
// treeview 노드를 gridView 에 drop → gridView 데이터에 추가
scwin.gridView1_ondropfromtree = function(info) {
	localStorage.setItem("log2", this.id + " ondropfromtree event");
	var dataArr = $p.getComponentById(info.dataListId).getRowArray(info.fromRowIndex).data;
	dataList1.insertData(info.toRowIndex, dataArr);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1"
			style="width:315px;height:335px;left:0px;top:0px;" dataDragDrop="true"
			ev:ondropfromtree="scwin.gridView1_ondropfromtree">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column7" width="70" value="name1"></w2:column>
					<w2:column id="column8" width="70" value="name2"></w2:column>
					<w2:column id="column9" width="70" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="label" width="70"></w2:column>
					<w2:column id="value" width="70"></w2:column>
					<w2:column id="depth" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:treeview useDrag="true" id="treeview1" style="position:absolute;width:363px;height:312px;left:6px;top:339px;"
			tooltipGroupClass="false" dataType="listed" ev:ondropfromgrid="scwin.treeview1_ondropfromgrid">
			<w2:itemset nodeset="data:dataList2">
				<w2:label ref="label"></w2:label>
				<w2:value ref="value"></w2:value>
				<w2:depth ref="depth"></w2:depth>
			</w2:itemset>
		</w2:treeview>
	</body>
</html>
