<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
					<w2:columnInfo>
					</w2:columnInfo>
					<w2:data use="true">
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();

	grid1.setColumnWidth("col1", 70);
};

scwin.trigger1_onclick = function (e) {
	grid1.setColumnWidth("col1", 10);
};

scwin.trigger3_onclick = function (e) {
	grid1.setColumnWidth("col1", 0);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" id="grid1" style="width: 500px;height: 150px;" dataList="data:dataList1">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="" value="1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" value="2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="width:120px;height:25px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[Width 10]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger3" style="width:120px;height:25px;" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[Width 0]]></xf:label>
		</xf:trigger>
	</body>
</html>
