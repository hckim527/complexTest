<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridView1.setAutoFit({
		"type": "none"
	});
};
scwin.onpageload = function() {
	dataList1.setData([1, 2, 3, 4, 5, 6]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" defaultCellHeight="20" id="gridView1"
			style="position: relative;width:441px;height:226px;" useShiftKey="true" autoFit="none">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70"></w2:column>
					<w2:column id="col2" inputType="text" width="70"></w2:column>
					<w2:column id="col3" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:231px;height:46px;margin-bottom:10px;display:block;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setAutoFit({type:"none"})]]></xf:label>
		</xf:trigger>
	</body>
</html>
