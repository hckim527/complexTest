		<script type="text/javascript" lazy="false"><![CDATA[
scwin.nowRow = 0;
scwin.tmpData = "A";
scwin.tmpCounter = 0;
scwin.btn_AddRow_onclick = function(e) {
	var beidx = dataList1.insertRow(scwin.nowRow);
	dataList1.setCellData(beidx, "col5", scwin.tmpData + scwin.tmpCounter);
	gridView1.setCellReadOnly(beidx, "col5", false);
	gridView1.setCellBackgroundColor(beidx, "col5", "#FF0000");
	scwin.tmpCounter++;
};
scwin.btn_removeRows_onclick = function(e) {
	var chkArr = gridView1.getCheckedIndex('col1');
	dataList1.removeRows(chkArr);
};
scwin.gridView1_oncellclick = function(row, col, colId) {
	scwin.nowRow = row;
};
scwin.checkVal1 = function() {
	return (document.getElementById('gridView1_cell_3_4') || document.getElementById('mf_gridView1_cell_3_4')).style.backgroundColor == 'rgb(255, 0, 0)';
}
]]></script>
