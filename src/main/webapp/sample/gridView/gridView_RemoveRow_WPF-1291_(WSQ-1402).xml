<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	dataList1.removeRows([0]);
};
scwin._isCountTr = function() {
	var el = ((j) => j.length ? j : $('#mf_gridView1_body_tbody tr'))($('#gridView1_body_tbody tr')).not('.w2grid_hidedRow');
	return el.length;
}
scwin.onpageload = function() {
	window.jsonData = [{
		"col1": "a"
	}, {
		"col1": "b"
	}, {
		"col1": "c"
	}];
	dataList1.setJSON(jsonData);
	gridView1.setCellReadOnly(0, "col3", true);
	gridView1.setCellReadOnly(1, "col3", true);
	gridView1.setCellDisabled(0, "col4", true);
	gridView1.setCellDisabled(1, "col4", true);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1"
			style="position: absolute ;left:17px;top:93px;width:528px;height:187px;"
			fixedColumnWithHidden="true" useShiftKey="true" disabledBackgroundColor="orange" readOnlyBackgroundColor="skyblue">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column11" style="height:20px" inputType="text" width="70" displayMode="label"
						value="name1">
					</w2:column>
					<w2:column id="column9" style="height:20px" inputType="text" width="70" displayMode="label"
						value="name2">
					</w2:column>
					<w2:column id="column7" style="height:20px" inputType="text" width="70" displayMode="label"
						value="readOnly">
					</w2:column>
					<w2:column id="column3" style="height:20px" width="70" inputType="text" displayMode="label"
						value="disabled">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px;" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px;" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px;" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col4" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: absolute ;left: 36px;top: 24px;width: 177px;height: 34px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[removeRows([0])]]></xf:label>
		</xf:trigger>
	</body>
</html>
