<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""></data>
			</xf:instance>
			<w2:dataCollection>
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="분류1" dataType="text"></w2:column>
						<w2:column id="col2" name="분류2" dataType="text"></w2:column>
						<w2:column id="col3" name="금액" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setData([
		"가", "A", 1,
		"가", "B", 2,
		"나", "C", 3,
		"나", "A", 4,
		"다", "B", 5,
		"다", "C", 6
	]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<!-- margin-top: 스크립트가 헤더를 top 20~200px 범위에서 찾음 -->
		<w2:gridView id="grid1" dataList="dataList1"
			style="position:relative;width:553px;height:400px;margin-top:40px;border:1px solid black;"
			rowNumVisible="true" rowNumWidth="*" rowStatusVisible="true" rowStatusWidth="*" focusMode="cell"
			useFilterList="true" customFilterBox="true" autoFitFilterList="true">
			<w2:header id="header1">
				<w2:row>
					<w2:column inputType="text" style="height:20px" id="header2" width="*" value="분류" useFilter="true"></w2:column>
					<w2:column inputType="text" style="height:20px" id="header3" width="*" value="분류2" useFilter="true"></w2:column>
					<w2:column inputType="text" style="height:20px" id="header4" width="*" value="금액" useFilter="true"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row>
					<w2:column inputType="text" style="height:20px" width="100" id="col1"></w2:column>
					<w2:column inputType="text" style="height:20px" width="70" id="col2"></w2:column>
					<w2:column inputType="text" style="height:20px" width="70" id="col3"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
