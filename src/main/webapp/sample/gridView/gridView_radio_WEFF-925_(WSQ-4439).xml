<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlTmpList1">
					<w2:columnInfo>
						<w2:column id="chk" name="체크박스" dataType="text" ignoreStatus="true"></w2:column>
						<w2:column id="Yn" name="라벨1" dataType="text"></w2:column>
						<w2:column id="col1" name="공통코드1" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{
		"chk": "",
		"Yn": "N",
		"col1": "",
		"rowStatus": "R"
	}, {
		"chk": "",
		"Yn": "Y",
		"col1": "",
		"rowStatus": "R"
	}, {
		"chk": "",
		"Yn": "N",
		"col1": "",
		"rowStatus": "R"
	}];
	dlTmpList1.setJSON(jsonData);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView autoFit="none" class="cm_grid edit" dataList="data:dlTmpList1" id="gvTmpList"
			readOnly="" style="height: 150px;left:-2px;top:1px;" tooltipDisplay="true">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column1" inputType="checkbox" style="height:20px;" value="chk" width="30"></w2:column>
					<w2:column id="column2" inputType="text" style="height:20px;" value="radio" width="100"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column fixColumnWidth="true" id="chk" inputType="checkbox" width="30"></w2:column>
					<w2:column id="Yn" inputType="radio" textAlign="" width="100" valueType="other" trueValue="Y" falseValue="N">
						<w2:choices></w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
