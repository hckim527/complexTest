<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>

		<style>
			.readOnlyClass {
				background : #CCCCCC;
			}
		</style>

		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridView1.setReadOnly('row', 1, true);
};
scwin.__row1HasBackground = function() {
	var tds = document.getElementById($p.id + "gridView1_body_tbody").getElementsByTagName("tr")[1].getElementsByTagName("td");
	for (var i = 0; i < tds.length; i++) {
		if (!tds[i].classList.contains("readOnlyClass")) return false;
	}
	return tds.length > 0;
};
scwin.onpageload = function() {
	dataList1.setData([
		1, 2, 3, 4,
		1, 2, 3, 4,
		1, 5, 6, 7,
		3, 5, 6, 7,
		4, 4, 4, 4,
		3, 4, 4, 4
	]);
	//Created By: Sang.do
	//Created By: 23-Jan-2018
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1"
			id="gridView1" readOnlyClass="readOnlyClass"
			style="position: absolute ;left:50px;top:55px;width:361px;height:150px;"
			fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column11"
						style="height:20px" inputType="text" width="70"
						displayMode="label" value="name1">
					</w2:column>
					<w2:column id="column9"
						style="height:20px" inputType="text" width="70"
						displayMode="label" value="name2">
					</w2:column>
					<w2:column id="column7"
						style="height:20px" inputType="text" width="70"
						displayMode="label" value="name3">
					</w2:column>
					<w2:column id="column3"
						style="height:20px" width="70" inputType="text"
						displayMode="label" value="name4">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1"
						style="height:20px" inputType="text" width="70" readOnlyClass="readOnlyClass"
						displayMode="label" readOnly="true">
					</w2:column>
					<w2:column id="col2"
						style="height:20px" inputType="text" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col3"
						style="height:20px" inputType="text" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col4"
						style="height:20px" width="70" inputType="text"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1"
			style="position: absolute ;left:46px;top:21px;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setReadOnly]]></xf:label>
		</xf:trigger>
	</body>
</html>
