		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var data1 = [];
	for (var i = 0; i < 20 * 50; i++) {
		data1.push(Math.floor(Math.sqrt(i) * Math.sqrt(i)) % (Math.ceil(Math.sqrt(i)) + 1));
	}
	dataList1.setData(data1);
	selectbox1.setValue(5);
	selectbox2.setValue(0);
	selectbox3.setValue(5);
	selectbox4.setValue(4);
	gridView1.setFixedRow(selectbox1.getValue());
	gridView1.setLastFixedRow(selectbox2.getValue());
	gridView1.setFixedColumn(selectbox3.getValue());
	gridView1.setFixedRightColumn(selectbox4.getValue());
};
scwin.selectbox1_onviewchange = function(info) {
	if (info.newValue > 0) {
		// fixedRow와 lastFixedRow는 현재 동시에 사용 불가능
		selectbox2.setValue(0);
		gridView1.setLastFixedRow(0);
	}
	gridView1.setFixedRow(info.newValue);
};
scwin.selectbox2_onviewchange = function(info) {
	if (info.newValue > 0) {
		// fixedRow와 lastFixedRow는 현재 동시에 사용 불가능
		selectbox1.setValue(0);
		gridView1.setFixedRow(0);
	}
	gridView1.setLastFixedRow(info.newValue);
};
scwin.selectbox3_onviewchange = function(info) {
	gridView1.setFixedColumn(info.newValue);
};
scwin.selectbox4_onviewchange = function(info) {
	gridView1.setFixedRightColumn(info.newValue);
};
]]></script>
