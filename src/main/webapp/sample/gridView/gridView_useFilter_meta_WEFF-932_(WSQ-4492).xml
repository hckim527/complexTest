<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dl_listMain">
					<w2:columnInfo>
						<w2:column id="rec_no" name="rec_no" dataType="text"></w2:column>
						<w2:column id="cliCode" name="코드" dataType="text"></w2:column>
						<w2:column id="cliName" name="광고주" dataType="text"></w2:column>
						<w2:column id="mediaBrdCompName" name="매체" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	// 광고주: 1~25 삼성전자 / 26~29 삼성?전자 / 30~57 삼성전자(주) / 58~69 삼성전자(주)a / 70~100 삼성전자(주)?
	var json = [];
	for (var i = 0; i < 100; i++) {
		json.push({
			"rec_no": String(i + 1),
			"cliCode": (i > 48) ? "01438010" : "01438000",
			"cliName": (i > 68) ? "삼성전자(주)?" : (i > 56) ? "삼성전자(주)a" : (i > 28) ? "삼성전자(주)" : (i > 24) ? "삼성?전자" : "삼성전자",
			"mediaBrdCompName": "MBC-TV"
		});
	}
	dl_listMain.setJSON(json);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="grd_TrdStat" dataList="dl_listMain" readOnly="true" style="width:100%;height:360px;" useShiftKey="true" focusMode="both"
			sortable="true" sortEvent="onclick" useFilterList="true" useFilterListSync="true" autoFitFilterList="true" customFilterBox="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="col_rec_no" width="50" value="No" />
					<w2:column id="col_cliCode" inputType="text" width="80" value="코드" useFilter="true" />
					<w2:column id="col_cliName" inputType="text" width="150" value="광고주" useFilter="true" />
					<w2:column id="col_mediaBrdCompName" inputType="text" width="70" value="매체" useFilter="true" />
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="rec_no" inputType="text" />
					<w2:column id="cliCode" inputType="text" width="70" textAlign="left" />
					<w2:column id="cliName" inputType="text" width="150" textAlign="left" />
					<w2:column id="mediaBrdCompName" inputType="text" width="70" textAlign="left" />
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
