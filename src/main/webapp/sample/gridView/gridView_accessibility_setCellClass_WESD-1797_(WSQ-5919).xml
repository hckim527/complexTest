<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	dataList1.setData(["1","a","2","b","3","c","4","d","5","e"]);
	dataList2.setData(["1","a","2","b","3","c","4","d","5","e"]);
	gridView1.setCellClass(4, 0, "aaa");
	gridView2.setCellClass(4, 0, "aaa");
};
]]></script>
		<style type="text/css"><![CDATA[
		.aaa {
			background-color:red;
			color:gray;
		}
		.aaa .w2grid_embedded_input {
			color:gray;
		}
		]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="position: relative;width: 500px;height: 150px;"
			dataList="data:dataList1" sortable="true" sortOrderReverse="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column4" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:textbox id="" label="accessibility" style="position: relative;width: 150px;height: 23px;"></w2:textbox>
		<w2:gridView checkAllType="false" dataList="data:dataList2" defaultCellHeight="20" id="gridView2" sortable="true"
			style="position: relative;width: 500px;height: 150px;" accessibility="true" sortOrderReverse="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column displayMode="label" id="column4" inputType="text" value="name1" width="70"></w2:column>
					<w2:column displayMode="label" id="column3" inputType="text" value="name2" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column displayMode="label" id="col1" inputType="text" width="70"></w2:column>
					<w2:column displayMode="label" id="col2" inputType="text" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
