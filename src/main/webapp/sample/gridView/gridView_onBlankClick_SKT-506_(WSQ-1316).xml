	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dst_tr01_out01" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="A" name="선택" />
						<w2:column dataType="text" id="B" name="선택" />
						<w2:column dataType="text" id="C" name="선택" />
						<w2:column dataType="text" id="chk_col" name="선택" />
						<w2:column dataType="text" id="svc_cd" name="서비스코드" />
						<w2:column dataType="text" id="scrbr_trnsf_op_cd" name="이관업무코드" />
						<w2:column dataType="text" id="from_org_nm" name="FROM조직명" />
						<w2:column dataType="text" id="to_org_nm" name="TO조직명" />
						<w2:column dataType="text" id="req_dt" name="요청일자" />
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.__getJq = function(q) {
	var j = $(q); if (j.length) return j;
	var P = 'mf_', t = q.trim(), r = t.slice(1);
	if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
	return $(t.slice(0, 1) + r);
};
scwin.gridView2_onblankclick = function(e) {
	var row = dst_tr01_out01.insertRow();
	gridView2.setFocusedCell(row, 0, true);
};
scwin.div_Search_btn_Search_onclick = function(e) {
	var row = dst_tr01_out01.insertRow();
	gridView2.setFocusedCell(0, 0, true);
};
scwin.isFocus = function() {
	return scwin.__getJq(scwin.__getDom('G_'+$p.id+'gridView2__chk_col')).is(':focus');
}
]]></script>
	</head>
	<body>
		<w2:gridView dataList="dst_tr01_out01" id="gridView2"
			style="width: 500px;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true"
			ev:onblankclick="scwin.gridView2_onblankclick">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column9" style="height:20px;" inputType="text" width="70" value="1"></w2:column>
					<w2:column id="column3" style="height:20px;" inputType="text" width="70" value="2"></w2:column>
					<w2:column id="column1" style="height:20px;" width="70" inputType="text" value="3"></w2:column>
					<w2:column id="column5" style="height:20px;" inputType="text" width="70" value="4"></w2:column>
