					<w2:column id="svc_cd" inputType="text" width="70"></w2:column>
					<w2:column id="scrbr_trnsf_op_cd" width="70" inputType="text"></w2:column>
					<w2:column id="from_org_nm" inputType="text" width="70"></w2:column>
					<w2:column id="to_org_nm" inputType="text" width="70"></w2:column>
					<w2:column id="req_dt" inputType="" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="div_Search_btn_Search" style="width: 80px;height: 23px;"
			ev:onclick="scwin.div_Search_btn_Search_onclick">
			<xf:label><![CDATA[버튼]]></xf:label>
