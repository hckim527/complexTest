<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="name1"></w2:column>
						<w2:column dataType="text" id="col2" name="name2"></w2:column>
						<w2:column dataType="text" id="col3" name="name3"></w2:column>
						<w2:column dataType="text" id="col4" name="name4"></w2:column>
						<w2:column dataType="text" id="col5" name="name5"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	// 확인사항 2: 숨긴(display:none) group 안 그리드에 로드 시 setVisibleRowNum
	gridView2.setVisibleRowNum(3);
};
scwin.trigger1_onclick = function(e) {
	gridView1.setVisibleRowNum(2);
	var data = [];
	for (var i = 0; i < 18; i++) {
		for (var j = 0; j < 5; j++) {
			data.push(i);
		}
	}
	dataList1.setData(data);
};
scwin.trigger2_onclick = function(e) {
	grp_all.show("");
};
scwin.checkVal1 = function() {
	return (document.getElementById('gridView1_body_tbody') || document.getElementById('mf_gridView1_body_tbody')).children.length == 2;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="width:179px;height:23px;margin:30px;margin-bottom: 0px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setVisibleRowNum()]]></xf:label>
		</xf:trigger>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width: 500px;height: 400px;margin: 30px;" dataList="data:dataList1" rowNumVisible="true" visibleRowNum="10" autoFit="allColumn">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column2" value="name4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="name5" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col5" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger2" style="width:179px;height:23px;margin:30px;margin-bottom: 0px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[group 표시]]></xf:label>
		</xf:trigger>
		<xf:group id="grp_all" style="display:none">
			<w2:gridView id="gridView2" style="width: 500px;height: 400px;margin: 30px;" dataList="data:dataList1" visibleRowNum="10">
				<w2:header id="header2">
					<w2:row id="row3">
						<w2:column width="70" inputType="text" style="height:20px" id="h2col1" value="name1" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="h2col2" value="name2" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody2">
					<w2:row id="row4">
						<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
