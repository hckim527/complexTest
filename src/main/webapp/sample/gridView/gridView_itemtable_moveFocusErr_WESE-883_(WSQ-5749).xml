<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[11]]></col2>
							<col3><![CDATA[111]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[22]]></col2>
							<col3><![CDATA[222]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[33]]></col2>
							<col3><![CDATA[333]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<w2:gridView id="grid1" style="width:500px;height:150px;" defaultCellHeight="20" dataList="data:dataList1" enterKeyMove="editRight" keyMoveEditMode="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column3" value="name1"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value="name2"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="col1"></w2:column>
					<w2:column width="70" inputType="autoComplete" id="col2">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[label1]]></w2:label>
								<w2:value><![CDATA[0]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[label2]]></w2:label>
								<w2:value><![CDATA[1]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[label3]]></w2:label>
								<w2:value><![CDATA[2]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[label4_1]]></w2:label>
								<w2:value><![CDATA[3]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[label4_2]]></w2:label>
								<w2:value><![CDATA[4]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[label4_3]]></w2:label>
								<w2:value><![CDATA[5]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[label4_4]]></w2:label>
								<w2:value><![CDATA[6]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="text" id="col3"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
