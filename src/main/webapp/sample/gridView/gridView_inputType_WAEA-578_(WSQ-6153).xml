<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList3">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList4">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList5">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var dataArr = ["a","a","b","b","c","c"];
	dataList2.setData(dataArr.slice(0));
	dataList3.setData(dataArr.slice(0));
	dataList4.setData(dataArr.slice(0));
	dataList5.setData(dataArr.slice(0));
	var row = 10;
	var dataArr2 = [];
	for (var i = 0; i < row; i++) {
		dataArr2.push(dataArr[i % 6]);
		dataArr2.push(dataArr[(i + 1) % 6]);
		dataArr2.push(dataArr[(i + 2) % 6]);
		dataArr2.push(dataArr[(i + 3) % 6])
	}
	dataList1.setData(dataArr2);
};

scwin.trigger1_onclick = function (e) {
	dataList1.setJSON(dataList1.getAllJSON());
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="" style="width:500px;height:251px;" dataList="data:dataList1">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column6" value="name1"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="name2"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name3"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name4"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="select" id="col1" viewType="icon" escape="false">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="select" id="col2" viewType="icon"
						viewTypeIconImage="true" escape="true">
						<w2:choices>
							<w2:itemset nodeset="data:dataList3">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="select" id="col3" escape="true">
						<w2:choices>
							<w2:itemset nodeset="data:dataList4">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="select" id="col4" escape="false">
						<w2:choices>
							<w2:itemset nodeset="data:dataList5">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="width:207px;height:52px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[test]]></xf:label>
		</xf:trigger>
	</body>
</html>
