<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text" ignoreStatus="true"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList3" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text" ignoreStatus="false"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setData(["", ""]);
	dataList2.setData(["", ""]);
	dataList3.setData(["", ""]);
};
scwin.__hasClass = function() {
	return document.getElementById(gridView3.id + '_headerRowStatus_bodyRow_0').classList.contains('w2grid_rowStatus_U');
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;"
			dataList="data:dataList1" rowStatusVisible="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column5" value="name1"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name2"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="checkbox" id="col1"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" id="col2"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView id="gridView2" style="width: 500px;height: 150px;"
			dataList="data:dataList2" rowStatusVisible="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column5" value="name1"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name2"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="checkbox" id="col1"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" id="col2"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView dataList="data:dataList3" id="gridView3" rowStatusVisible="true"
			style="width: 500px;height: 150px;">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column displayMode="label" id="column5" inputType="text"
						value="name1" width="70">
					</w2:column>
					<w2:column displayMode="label" id="column3" inputType="text"
						value="name2" width="70">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column displayMode="label" id="col1" inputType="checkbox"
						width="70">
					</w2:column>
					<w2:column displayMode="label" id="col2" inputType="text"
						width="70">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
