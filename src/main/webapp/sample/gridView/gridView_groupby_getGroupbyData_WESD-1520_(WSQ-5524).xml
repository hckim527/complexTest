<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
	<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" repeatNode="map" keyNode="infoList" attributeMap="value" idAttribute="value" >
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="javascript" lazy="false"><![CDATA[
scwin.gbLog = [];
scwin.onpageload = function() {
	var jsonData = [{col1:"a",col3:"a"},{col1:"c",col3:"c"},{col1:"d",col3:"d"},{col1:"b",col3:"b"}];
	dataList1.setJSON(jsonData);
};
// groupbyZone 에 Header 를 끌어 놓으면 호출 → 실제 groupby 실행
scwin.gridView1_ongroupby = function(options) {
	options.closeGroup = true;
	options.groupbyHeader = [{colSpan: "3", inputType: "expression", expression: " toggle() + depthStr() + ' [ ' + count() + ' 건 ] ' ", align: "left" }];
	gridView1.groupby(options);
};
// getGroupbyData 반환값 기록(groupby 아닐 때 undefined)
scwin.trigger1_onclick = function(e) {
	var a = gridView1.getGroupbyData();
	scwin.gbLog.push(a === undefined ? "undefined" : JSON.stringify(a));
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[getGroupbyData]]></xf:label>
		</xf:trigger>
		<w2:gridView id="gridView1" useShiftKey="true" style="left:0px;top:0px;width:400px;height:200px;" useFilterList="true" sortable="false" fixedColumnWithHidden="true" dataList="dataList1" visibleRowNum="20" rowNumVisible="true" autoFit="lastColumn" readOnly="false" focusMode="row" overflowY="scroll" editModeEvent="onclick" senseReader="true" keyMoveEditMode="true" captionTitle="그리드 제목" captionAuto="true" autoResizeEmbeddedInput="true" sortHeaderDiv="true" scrollFocus="true" titleAuto="true" useStartEndDiv="true" groupbyZone="true" ev:ongroupby="scwin.gridView1_ongroupby">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column1" inputType="text" value="name1" width="70"></w2:column>
					<w2:column id="column2" inputType="text" useFilter="true" value="name2" width="70"></w2:column>
					<w2:column id="column3" inputType="text" useFilter="true" value="name3" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" inputType="text" width="70"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" ignoreCellClick="true" id="col3" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>