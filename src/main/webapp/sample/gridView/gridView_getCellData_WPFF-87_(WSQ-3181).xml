<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	log = gridView1.getCellData(0, 1);
};
scwin.onpageload = function() {
	var jsonData = [];
	for (var i = 1; i <= 4; i++) {
		jsonData.push({ col1: "aaaa" + i, col2: "bbbb" + i, col3: "cccc" + i, col4: "dddd" + i });
	}
	dataList1.setJSON(jsonData);
	window.log = undefined;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="position: relative;width: 350px;height: 200px;">
			<w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width: 500px;height: 200px;" useShiftKey="true" autoFit="allColumn">
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column id="column7" style="height:20px" inputType="text" width="70" displayMode="label" value="name1"></w2:column>
						<w2:column id="column5" style="height:20px" inputType="text" width="70" displayMode="label" value="name2"></w2:column>
						<w2:column id="column3" style="height:20px" inputType="text" width="200" displayMode="label" value="name3" fixColumnWidth="true"></w2:column>
						<w2:column id="column1" style="height:20px" width="70" inputType="text" displayMode="label" value="name4"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
						<w2:column id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
						<w2:column id="col3" style="height:20px" inputType="text" width="200" displayMode="label" fixColumnWidth="true"></w2:column>
						<w2:column id="col4" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:176px;height:30px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[gridView1.getCellData(0,1)]]></xf:label>
		</xf:trigger>
	</body>
</html>
