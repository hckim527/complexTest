		<script type="text/javascript" lazy="false"><![CDATA[
scwin.evLog = [];
scwin.onpageload = function() {
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
};
scwin.gridView1_onbeforecolumnmove = function(info) {
	scwin.evLog.push("onbeforecolumnmove");
};
scwin.gridView1_onaftercolumnmove = function(info) {
	scwin.evLog.push("onaftercolumnmove");
	localStorage.setItem('log', 'gridView1_onaftercolumnmove')
};
scwin.checkVal = function() {
	return localStorage.getItem('log') == 'gridView1_onaftercolumnmove';
}
localStorage.removeItem("log");
]]></script>
