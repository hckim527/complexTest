<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[a]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[b]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger2_onclick = function(e) {
	grd.setDisabled("grid", true);
};
scwin.trigger1_onclick = function(e) {
	tabControl1.disableTab(0);
};
scwin.checkVal = function() {
	return (document.getElementById('grd_cell_0_0') || document.getElementById('mf_grd_cell_0_0')).querySelector('input').getAttribute('checked') == '';
};
]]></script>
	</head>
	<body>
		<w2:tabControl confirmTrueAction="exist" useTabKeyOnly="true" id="tabControl1"
			style="position: relative ;width: 500px;height: 200px;" useConfirmMessage="false" confirmFalseAction="new">
			<w2:tabs id="tabs1" style="width:70px;height:30px;" disabled="false"></w2:tabs>
			<w2:content id="content1" style="height:170px" alwaysDraw="false">
				<w2:gridView dataList="dataList1" applyAllColumnStyle="false" scrollByColumn="false" id="grd"
					style="position: relative;width: 400px;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true">
					<w2:header id="header1">
						<w2:row id="row1">
							<w2:column blockSelect="false" id="column3" inputType="text" width="70" value="name1"></w2:column>
							<w2:column blockSelect="false" id="column1" width="70" inputType="text" value="name2"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody1">
						<w2:row id="row2">
							<w2:column blockSelect="false" id="col1" inputType="checkbox" width="70"></w2:column>
							<w2:column blockSelect="false" id="col2" width="70" inputType="text"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</w2:content>
		</w2:tabControl>
		<xf:trigger type="button" id="trigger2" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[grid-disable]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger1" style="position: relative;width: 80px;height: 23px;left:3px;top:0px;" type="button" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[tab-disable]]></xf:label>
		</xf:trigger>
	</body>
</html>
