		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	var options = {};

	options.rowNumVisible = "true";
	options.rowNumHeaderValue = "번호";

	options.rowNumHeaderColor = "#0065cd";
	options.rowNumHeaderFontColor="#000000"; // black

	options.fileName = "excel1.xlsx";

	gridView1.advancedExcelDownload(options);
};
