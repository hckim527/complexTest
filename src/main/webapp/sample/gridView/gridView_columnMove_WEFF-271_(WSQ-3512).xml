<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map" rowNumData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[a]]></col1>
							<col2><![CDATA[b]]></col2>
							<col3><![CDATA[b]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[a]]></col1>
							<col2><![CDATA[a]]></col2>
							<col3><![CDATA[a]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[a]]></col1>
							<col2><![CDATA[c]]></col2>
							<col3><![CDATA[c]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[b]]></col1>
							<col2><![CDATA[d]]></col2>
							<col3><![CDATA[d]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<!-- 2번째 컬럼(col2) 히든 -->
		<w2:gridView dataList="data:dataList1" id="grd" style="position: absolute;width:682px;height:219px;left:5px;top:6px;border: 1px solid #000;" useShiftKey="true"
			rowNumVisible="true" focusFlow="linear">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column7" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="name2" displayMode="label" hidden="true"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="name4" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col4" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
