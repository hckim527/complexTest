    dtl_01.setJSON(json);
    code_PC002.setJSON([{ "KOR_FMY_NM": "1", "DETAIL_CODE": "1" }, { "KOR_FMY_NM": "2", "DETAIL_CODE": "2" }, { "KOR_FMY_NM": "3", "DETAIL_CODE": "3" }]);
};
]]></script>
