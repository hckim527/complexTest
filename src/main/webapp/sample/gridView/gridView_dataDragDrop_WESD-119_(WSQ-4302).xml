<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
						<w2:column id="col10" name="name10" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var obj = [];
	for (var i = 1; i < 101; i++) {
		obj.push({
			"col1": i.toString()
		});
	}
	dataList1.setJSON(obj);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="main_group" style="position: absolute;width: 850px;height: 300px;overflow-y:auto;overflow-x:hidden;margin-left:50px;border:5px solid orange;top: 0px;z-index: 1;">
			<w2:gridView id="gridView1" dataList="data:dataList1" dataDragDropSelf="true" style="width:840px;height:1000px;"
				visibleRowNum="all" defaultCellHeight="20" hammerEnabled="true" rowNumVisible="true">
				<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column id="column9" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
						<w2:column id="column7" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
						<w2:column id="column5" inputType="text" width="70" value="name3" displayMode="label"></w2:column>
						<w2:column id="column3" inputType="text" width="70" value="name4" displayMode="label"></w2:column>
						<w2:column id="column1" width="70" inputType="text" value="name5" displayMode="label"></w2:column>
						<w2:column id="column11" width="70" value="name6"></w2:column>
						<w2:column id="column12" width="70" value="name7"></w2:column>
						<w2:column id="column13" width="70" value="name8"></w2:column>
						<w2:column id="column14" width="70" value="name9"></w2:column>
						<w2:column id="column15" width="70" value="name10"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="col1" inputType="text" width="70" displayMode="label"></w2:column>
						<w2:column id="col2" inputType="text" width="70" displayMode="label"></w2:column>
						<w2:column id="col3" inputType="text" width="70" displayMode="label"></w2:column>
						<w2:column id="col4" inputType="text" width="70" displayMode="label"></w2:column>
						<w2:column id="col5" width="70" inputType="text" displayMode="label"></w2:column>
						<w2:column id="col6" width="70"></w2:column>
						<w2:column id="col7" width="70"></w2:column>
						<w2:column id="col8" width="70"></w2:column>
						<w2:column id="col9" width="70"></w2:column>
						<w2:column id="col10" width="70"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
 