<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<w2:MSA/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
					<w2:columnInfo>
						<w2:column id="codeName" name="" dataType="text"></w2:column>
						<w2:column id="codeNo" name="" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<codeName><![CDATA[name1]]></codeName>
							<codeNo><![CDATA[1]]></codeNo>
						</w2:row>
						<w2:row>
							<codeNo><![CDATA[2]]></codeNo>
							<codeName><![CDATA[name2]]></codeName>
						</w2:row>
						<w2:row>
							<codeName><![CDATA[name3]]></codeName>
							<codeNo><![CDATA[3]]></codeNo>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList3">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.onpageload = function () {
	// WAEA-370 후속: inputType="custom" Column 의 select Cell 도 skipOpen 동작
	gridView2.setCellInputType(1, "col1", {
		inputType: "select",
		itemSet: { nodeset: "data:dataList2", label: "codeName", value: "codeNo" }
	});
};

scwin.trigger1_onclick = function (e) {
	gridView1.setFocusedCell(1, "col1", true, {skipOpen:true});
};

scwin.checkVal1 = function() {
	return scwin.__getDom('G_'+$p.id+'gridView1___selectbox_col1_itemTable').style.display == 'none';
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width: 500px;height: 150px;"
			dataList="data:dataList1">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column4" value="name1" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column chooseOption="" width="70" inputType="select" id="col1" allOption=""
						displayMode="label" editMode="true">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="codeName"></w2:label>
								<w2:value ref="codeNo"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="width:460px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[gridView1.setFocusedCell(row, "col1", true);]]></xf:label>
		</xf:trigger>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView2" style="width: 500px;height: 150px;"
			dataList="data:dataList3" setCellInputTypeCustom="true">
			<w2:header id="header3">
				<w2:row id="row5">
					<w2:column width="70" inputType="text" id="column5" value="custom" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody3">
				<w2:row id="row6">
					<w2:column width="70" inputType="custom" id="col1" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
