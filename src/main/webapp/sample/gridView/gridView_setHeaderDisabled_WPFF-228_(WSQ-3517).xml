<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridView1.setHeaderDisabled("column3", true);
};
scwin.trigger2_onclick = function(e) {
	gridView1.setHeaderDisabled("column3", false);
};
scwin.headerClick = function(headerId) {
	localStorage.setItem("headerclick", "true");
};
scwin.checkVal1 = function() {
	return localStorage.getItem('headerclick') != 'true';
}
scwin.checkVal2 = function() {
	return localStorage.getItem('headerclick') == 'true';
}
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="position: relative;width: 500px;height: 150px;" ev:onheaderclick="scwin.headerClick" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="button" width="70" value="column3" displayMode="label" dataType="own"></w2:column>
					<w2:column id="column1" width="70" inputType="button" value="column1" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:232px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[column3 header setDisabled true]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position: relative;width:232px;height:23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[column3 header setDisabled false]]></xf:label>
		</xf:trigger>
	</body>
</html>
