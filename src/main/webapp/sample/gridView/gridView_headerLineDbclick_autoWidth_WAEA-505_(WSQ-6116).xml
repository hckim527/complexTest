<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa]]></col1>
							<col2><![CDATA[abc]]></col2>
							<col4><![CDATA[a]]></col4>
						</w2:row>
						<w2:row>
							<col1><![CDATA[bbb]]></col1>
							<col2><![CDATA[abc]]></col2>
							<col3><![CDATA[1111111111111111111111]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[cccccccccccccccccccccccccccc]]></col1>
						</w2:row>
						<w2:row>
							<col1><![CDATA[dddddddd]]></col1>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="position:absolute;top:19px;left:16px;width:800px;height:500px;" dataList="data:dataList1">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column7" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column6" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name5" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col5" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
