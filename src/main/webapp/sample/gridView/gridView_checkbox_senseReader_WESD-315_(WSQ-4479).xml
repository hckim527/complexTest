<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true" ev:onbeforerowpositionchange="scwin.dataList1_onbeforerowpositionchange">
					<w2:columnInfo>
						<w2:column id="col1" name="체크박스" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var arr = [1, "가", "인천",
		0, "나", "인천",
		0, "다", "서울",
		1, "라", "뉴욕"
	];
	dataList1.setData(arr, "append");
};

// WESD-315: col2 가 "ERROR" 면 행 이동 차단(return false). 차단 상태에서 checkbox 라벨 클릭 시 이벤트가 1회만 호출되어야 함
scwin.dataList1_onbeforerowpositionchange = function(info) {
	console.log(info.oldRowIndex + " -> " + info.newRowIndex);
	if (dataList1.getRowJSON(info.oldRowIndex).col2 == "ERROR") {
		return false;
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" keyMoveEditMode="true" preventDuplicateFocusedCell="true"
			style="width:529px;height:139px;" senseReader="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="column11" inputType="checkbox" style="height:20px" width="153" value="체크박스"></w2:column>
					<w2:column displayMode="label" id="column9" inputType="text" style="height:20px" value="name1" width="70"></w2:column>
					<w2:column displayMode="label" id="column7" inputType="text" style="height:20px" value="name2" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column displayMode="label" id="col1" inputType="checkbox" style="height:20px" width="153" checkboxLabel="테스트"></w2:column>
					<w2:column displayMode="label" id="col2" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayMode="label" id="col3" inputType="text" style="height:20px" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
