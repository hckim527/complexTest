<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dlt_location" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="COMCOD" name="name1"></w2:column>
						<w2:column dataType="text" id="COMNAM" name="name2"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<COMCOD><![CDATA[KRPUS]]></COMCOD>
							<COMNAM><![CDATA[BUSAN, KOREA]]></COMNAM>
						</w2:row>
						<w2:row>
							<COMCOD><![CDATA[KRCHO]]></COMCOD>
							<COMNAM><![CDATA[CHEONAN, KOREA]]></COMNAM>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// setTopRowIndex(rowIndex, ?, autoFocus)
scwin.trigger3_onclick = function(e) {
	gridView1.setTopRowIndex(3, false, true);
};
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList2" defaultCellHeight="20" id="gridView1" style="position: absolute;width:407px;height:150px;display:block;" useShiftKey="true" rowStatusVisible="true" rowNumVisible="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" width="70" inputType="textImage" displayMode="label" imageSrc="icon01.gif" imageWidth="20" imageHeight="20" viewType="icon"></w2:column>
					<w2:column id="col2" width="70" inputType="autoComplete" displayMode="label">
						<xf:choices>
							<xf:itemset nodeset="data:dlt_location">
								<xf:label ref="COMNAM"></xf:label>
								<xf:value ref="COMCOD"></xf:value>
							</xf:itemset>
						</xf:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:group style="position:absolute; top:200px;left:0; ">
			<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3" style="position:absolute;width:292px;height:23px;left:211px;top:60px;" type="button">
				<xf:label><![CDATA[setTopRowIndex(3)]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
