<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	scwin.initGrid = grid1.getGridStyle();
	scwin.btn_sch_onclick();
};
scwin.btn_sch_onclick = function() {
	var data = [];
	for (var i = 0; i < 20; i++) {
		data.push("col1", "col2", "col3", "col4", "col5", "col6", "col7", "col8");
	}
	dataList1.setData(data);
};
scwin.btn_hide_onclick = function() {
	grid1.setColumnVisible("col4", false);
};
scwin.btn_pexport_onclick = function() {
	scwin.currGrid = grid1.getCurrentGridStyle();
};
scwin.btn_pinit_onclick = function() {
	dataList1.setData([]);
	grid1.setGridStyle(scwin.initGrid);
};
scwin.btn_pimport_onclick = function() {
	grid1.initGrid();
	grid1.setGridStyle(scwin.currGrid);
	scwin.btn_sch_onclick();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="btn_hide" style="width:110px;height:23px;" ev:onclick="scwin.btn_hide_onclick">
			<xf:label><![CDATA[col4 숨김]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="btn_pexport" style="width:110px;height:23px;" ev:onclick="scwin.btn_pexport_onclick">
			<xf:label><![CDATA[개인화 저장]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="btn_pinit" style="width:110px;height:23px;" ev:onclick="scwin.btn_pinit_onclick">
			<xf:label><![CDATA[개인화 초기화]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="btn_pimport" style="width:110px;height:23px;" ev:onclick="scwin.btn_pimport_onclick">
			<xf:label><![CDATA[개인화 불러오기]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="dataList1" id="grid1"
			style="width:600px;height:150px;" fixedColumnWithHidden="true"
			useShiftKey="true" columnMove="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column15" style="height:40px;" inputType="text" width="70"
						displayMode="label" value="name1" rowSpan="2">
					</w2:column>
					<w2:column hidden="false" width="70" inputType="text" style="height:20px;"
						id="column24" value="name2" displayMode="label" rowSpan="2">
					</w2:column>
					<w2:column id="column11" style="height:20px;" inputType="text" width="210"
						displayMode="label" value="name3" colSpan="3">
					</w2:column>
					<w2:column id="column5" inputType="text" width="70" displayMode="label" colSpan="2"
						value="name6">
					</w2:column>
					<w2:column id="column3" inputType="text" width="70" displayMode="label"
						value="name7">
					</w2:column>
				</w2:row>
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column21" value="3"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column20" value="4"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column19" value="5"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column18" value="6"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column17" value="7"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column16" value="8"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" inputType="text" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col3" style="height:20px" inputType="text" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col4" style="height:20px" inputType="text" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col5" style="height:20px" inputType="text" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col6" style="height:20px" inputType="text" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col7" style="height:20px" inputType="text" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col8" style="height:20px" width="70" inputType="text"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
