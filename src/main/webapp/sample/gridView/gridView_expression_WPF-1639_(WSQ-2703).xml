					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.setNum = function(value, row) {
	return value;
};
scwin.checkVal = function() {
	return typeof (document.getElementById('mf_grd_head_selectbox_column3_itemTable') || document.getElementById('grd_head_selectbox_column3_itemTable')) == 'object' && scwin.__getDom($p.id+"mf_grd_head_selectbox_column3_itemTable").style.display == 'block';
}

scwin.onpageload = function() {
	window.xmlData = "<dataset><record><address>서울</address><col2>대전</col2><col3>대구</col3></record></dataset>";
	dataList1.setXML(WebSquare.xml.parse(xmlData), false);
	window.dataInputtype = WebSquare.util.getDataPrefix("inputtype");
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1"
