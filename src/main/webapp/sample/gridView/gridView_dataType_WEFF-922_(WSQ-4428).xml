<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text" defaultValue="col1"></w2:column>
						<w2:column id="col2" name="name2" dataType="number" defaultValue="col2"></w2:column>
						<w2:column id="col3" name="name3" dataType="float" defaultValue="col3"></w2:column>
						<w2:column id="col4" name="name4" dataType="text" defaultValue="col4"></w2:column>
						<w2:column id="col5" name="name5" dataType="text" defaultValue="col5"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text" defaultValue="defaultValue col1"></w2:column>
						<w2:column id="col2" name="name2" dataType="number" defaultValue="defaultValue col2"></w2:column>
						<w2:column id="col3" name="name3" dataType="float" defaultValue="defaultValue col3"></w2:column>
						<w2:column id="col4" name="name4" dataType="text" defaultValue="defaultValue col4"></w2:column>
						<w2:column id="col5" name="name5" dataType="text" defaultValue="defaultValue col5"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.insertRow();
	dataList2.insertRow();
	var row = dataList1.getRowJSON(0);
	var json = [];
	for (var i = 0; i < 2; i++) {
		var tmp = {};
		for (var item in row) {
			if (item == "rowStatus") continue;
			else if (item == "col1" ||
				item == "col2" ||
				item == "col3"
			) tmp[item] = "0"
			else tmp[item] = item + "_" + i;
		}
		json.push(tmp);
	}
	dataList1.setJSON(json);
	row = dataList2.getRowJSON(0);
	json = [];
	for (var i = 0; i < 2; i++) {
		var tmp = {};
		for (var item in row) {
			if (item == "rowStatus") continue;
			else if (item == "col1" ||
				item == "col2" ||
				item == "col3"
			) tmp[item] = 0
			else tmp[item] = item + "_" + i;
		}
		json.push(tmp);
	}
	dataList2.setJSON(json);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1"
			style="position: relative;height: 288px;margin-left: 15px;margin-right: 15px;" autoFit="allColumn" fixedColumn="1" visibleRowNum="10"
			dataDragSelect="true" useShiftKey="true" rowStatusVisible="true" rowStatusHeaderValue="상태">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column9" inputType="text" width="70" value="text"
						displayMode="label">
					</w2:column>
					<w2:column id="column7" inputType="text" width="70" value="number"
						displayMode="label">
					</w2:column>
					<w2:column id="column5" inputType="text" width="70" value="float"
						displayMode="label">
					</w2:column>
					<w2:column id="column3" width="70" inputType="text" value="name4"
						displayMode="label">
					</w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name5"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="text" width="300"
						displayMode="label">
					</w2:column>
					<w2:column id="col2" inputType="text" width="200"
						displayMode="label">
					</w2:column>
					<w2:column id="col3" inputType="text" width="200"
						displayMode="label">
					</w2:column>
					<w2:column id="col4" inputType="text" width="200"
						displayMode="label">
					</w2:column>
					<w2:column id="col5" inputType="text" width="200"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView dataList="data:dataList2" defaultCellHeight="20" id="gridView2" rowStatusVisible="true"
			style="position: relative;height: 288px;margin-left: 15px;margin-right: 15px;" autoFit="allColumn" fixedColumn="1" visibleRowNum="10"
			dataDragSelect="true" useShiftKey="true" rowStatusHeaderValue="상태">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column9" inputType="text" width="70" value="text"
						displayMode="label">
					</w2:column>
					<w2:column id="column7" inputType="text" width="70" value="number"
						displayMode="label">
					</w2:column>
					<w2:column id="column5" inputType="text" width="70" value="float"
						displayMode="label">
					</w2:column>
					<w2:column id="column3" width="70" inputType="text" value="name4"
						displayMode="label">
					</w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name5"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="text" width="300"
						displayMode="label">
					</w2:column>
					<w2:column id="col2" inputType="text" width="200"
						displayMode="label">
					</w2:column>
					<w2:column id="col3" inputType="text" width="200"
						displayMode="label">
					</w2:column>
					<w2:column id="col4" inputType="text" width="200"
						displayMode="label">
					</w2:column>
					<w2:column id="col5" inputType="text" width="200"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
