<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dc_userDataList" baseNode="list" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="name" name="name" dataType="text" />
						<w2:column dataType="text" name="bm" id="bm" />
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var names = ["아이유", "정형돈", "유승호"], arr = [];
	for (var i = 0; i < 12; i++) {
		arr.push({ "name": names[i % 3], "bm": "" });
	}
	dc_userDataList.insertJSON(0, arr);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="wrapper" id="">
			<xf:group class="section_desc" id="group4" style="padding: 10px;">
				<w2:textbox id="section" label='showLastRow="true" 설정이 지정된 경우, 마지막 로우에 포커스가 지정된 상태에서 다른 로우를 클릭하면 마지막 로우의 포커스 렌더링이 해제되지 않습니다.'>
				</w2:textbox>
			</xf:group>
			<w2:gridView dataList="data:dc_userDataList" id="ui_gridView" rowNumHeaderValue="No" rowNumVisible="true"
				style="height:250px;" focusMode="row" readOnly="true" showLastRow="true" selectedRowColor="#aaaaff">
				<w2:header id="header1">
					<w2:row id="row3">
						<w2:column id="column17" inputType="text" value="이름" width="70" />
						<w2:column id="column111" inputType="text" value="기초대사량" width="108" />
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="name" inputType="link" style="height:40px;" width="70" />
						<w2:column id="bm" imageHeight="16" imageSrc="/ws5/img/calculator.png" imageWidth="16" inputType="textImage" style="height:40px;" viewType="icon" width="108" />
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
