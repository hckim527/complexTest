<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlSuperUser">
					<w2:columnInfo>
						<w2:column id="deptnm" name="DEPARTMENT NAME" dataType="text"></w2:column>
						<w2:column id="ofceCd" name="ofceCd" dataType="text"></w2:column>
						<w2:column id="trckNm" name="TECHNICAL MANAGER ID" dataType="text"></w2:column>
						<w2:column id="usrId" name="usrId" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dlSuperUser.setJSON([{ "deptnm": "D1", "ofceCd": "O1", "trckNm": "T1", "usrId": "U1" }, { "deptnm": "D2", "ofceCd": "O2", "trckNm": "T2", "usrId": "U2" }]);
};
scwin.trigger1_onclick = function(e) {
	textbox1.setValue(gvPgmList.getFixedColumnLastIndex(false));
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<!-- fixedColumn=2, rowNumVisible=true, rowStatusVisible=false -->
		<w2:gridView class="cm_grid" dataList="data:dlSuperUser" id="gvPgmList" style="height:150px;width:661px;" rowStatusVisible="false"
			rowStatusWidth="50" rowNumVisible="true" rowNumWidth="50" fixedColumn="2">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="100" inputType="text" id="column35" value="Region"></w2:column>
					<w2:column width="80" inputType="text" id="column37" value="Office"></w2:column>
					<w2:column width="120" inputType="text" id="column33" value="Track"></w2:column>
					<w2:column width="70" inputType="text" id="column45" value="UPDATE ID"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="100" inputType="text" id="deptnm" readOnly="true"></w2:column>
					<w2:column width="80" inputType="text" id="ofceCd" readOnly="true"></w2:column>
					<w2:column width="120" inputType="text" id="trckNm" readOnly="true"></w2:column>
					<w2:column width="70" inputType="text" id="usrId" readOnly="true"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<!-- fixedColumn=2, rowNumVisible=true, rowStatusVisible=true -->
		<w2:gridView class="cm_grid" dataList="data:dlSuperUser" id="gvPgmList2" style="height:150px;width:661px;" rowStatusVisible="true"
			rowStatusWidth="50" rowNumVisible="true" rowNumWidth="50" fixedColumn="2">
			<w2:header id="header2_2">
				<w2:row id="row3_2">
					<w2:column width="100" inputType="text" id="column35_2" value="Region"></w2:column>
					<w2:column width="80" inputType="text" id="column37_2" value="Office"></w2:column>
					<w2:column width="120" inputType="text" id="column33_2" value="Track"></w2:column>
					<w2:column width="70" inputType="text" id="column45_2" value="UPDATE ID"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2_2">
				<w2:row id="row4_2">
					<w2:column width="100" inputType="text" id="deptnm" readOnly="true"></w2:column>
					<w2:column width="80" inputType="text" id="ofceCd" readOnly="true"></w2:column>
					<w2:column width="120" inputType="text" id="trckNm" readOnly="true"></w2:column>
					<w2:column width="70" inputType="text" id="usrId" readOnly="true"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" style="width:211px;height:26px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[getFixedColumnLastIndex(false)]]></xf:label>
		</xf:trigger>
		<w2:textbox style="width:75px;height:34px;border: 1px solid black;" id="textbox1"></w2:textbox>
	</body>
</html>
