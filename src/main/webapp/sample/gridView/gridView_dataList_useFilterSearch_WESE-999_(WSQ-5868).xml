<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="상태" dataType="text"></w2:column>
						<w2:column id="col2" name="대분류코드" dataType="text"></w2:column>
						<w2:column id="col3" name="분류명" dataType="text"></w2:column>
						<w2:column id="col4" name="회계삼각기간" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="상태" dataType="text"></w2:column>
						<w2:column id="col2" name="대분류코드" dataType="text"></w2:column>
						<w2:column id="col3" name="분류명" dataType="text"></w2:column>
						<w2:column id="col4" name="회계삼각기간" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	gridView1.setColumnVisible("col1", false);
	gridView2.setColumnVisible("col1", false);
	// dataList1 = A1~M4(대문자), dataList2 = a1~m4(소문자)
	var upper = [], lower = [];
	"ABCDEFGHIJKLM".split("").forEach(function(c) {
		upper.push({ "col1": c + "1", "col2": c + "2", "col3": c + "3", "col4": c + "4" });
		var l = c.toLowerCase();
		lower.push({ "col1": l + "1", "col2": l + "2", "col3": l + "3", "col4": l + "4" });
	});
	dataList1.setJSON(upper);
	dataList2.setJSON(lower);
};

scwin.checkVal1 = function() {
	return (document.getElementById('gridView1_customFilter_list_items_main') || document.getElementById('mf_gridView1_customFilter_list_items_main')).querySelectorAll("input").length == 4;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:textbox label='datalist 순서와 gridView에 보여지는 순서를 "다르게" 배치 &lt;b&gt;(비정상)&lt;/b&gt;&lt;/br&gt;&lt;br/&gt;=&gt; gridView 칼럼의 id를 교체하여 "대분류코드"와 "분류명"의 바인딩 위치를 변경했을 경우,&lt;/br&gt;"대분류코드" 칼럼에 필터를 적용해도 "분류명"의 필터가 전체 선택되어 보여짐'
			style="width:519px;height:63px;" escape="false"></w2:textbox>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width: 500px;height: 150px;"
			dataList="data:dataList1" useFilterList="true" rowNumVisible="true" rowNumHeaderValue="No." autoFit="none" rowStatusVisible="true" columnMove="true"
			selectByLabel="true" useFilterSearch="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column4" value="상태" displayMode="label"></w2:column>
					<w2:column width="105" inputType="text" id="column3" value="대분류코드" displayMode="label" useFilter="true"></w2:column>
					<w2:column width="90" inputType="text" id="column2" value="분류명" displayMode="label" useFilter="true"></w2:column>
					<w2:column width="120" inputType="text" id="column1" value="회계삼각기간" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="105" inputType="text" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="104" inputType="text" id="col4" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:textbox label='datalist 순서와 gridView에 보여지는 순서를 "동일하게" 배치 &lt;b&gt;(정상)&lt;/b&gt;'
			style="width:503px;height:22px;margin-top:30px;" escape="false"></w2:textbox>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView2" style="width: 500px;height: 150px;"
			dataList="data:dataList2" useFilterList="true" rowNumVisible="true" rowNumHeaderValue="No." autoFit="none" rowStatusVisible="true"
			selectByLabel="true" useFilterSearch="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="90" inputType="text" id="column4" value="상태" displayMode="label"></w2:column>
					<w2:column width="110" inputType="text" id="column3" value="대분류코드" displayMode="label" useFilter="true"></w2:column>
					<w2:column width="90" inputType="text" id="column2" value="분류명" displayMode="label" useFilter="true"></w2:column>
					<w2:column width="110" inputType="text" id="column1" value="회계삼각기간" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="92" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col4" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
