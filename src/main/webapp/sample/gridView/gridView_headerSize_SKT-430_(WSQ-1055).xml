<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="false"></w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<xf:group style="width: 100%;border:1px solid red;" tagname="table">
			<xf:group style="width: 200px;height: 200px;border:1px solid red;" tagname="tr">
				<xf:group style="width: 200px;height: 200px;border:1px solid red;" tagname="td"></xf:group>
				<xf:group style="width: 200px;height: 200px;border:1px solid red;" tagname="td">
					<w2:gridView id="gridView1" useShiftKey="true" fixedColumnWithHidden="true" style="height: 400px;" dataList="dataList1" autoFit="allColumn">
						<w2:header id="header1">
							<w2:row id="row2">
								<w2:column width="70" inputType="text" style="height:20px" id="column13" displayMode="label" value="name1"></w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="column11" displayMode="label" value="name2"></w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="column9" displayMode="label" value="name3"></w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="column7" displayMode="label" value="name4"></w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="column3" displayMode="label" value="name5"></w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="gBody4">
							<w2:row id="row5">
								<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="col4" displayMode="label"></w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="col5" displayMode="label"></w2:column>
							</w2:row>
						</w2:gBody>
					</w2:gridView>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
