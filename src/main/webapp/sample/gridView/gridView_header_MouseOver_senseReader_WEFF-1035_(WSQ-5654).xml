<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="textareaarea" name="textareaarea" dataType="text"></w2:column>
						<w2:column id="texttext" name="texttext" dataType="text"></w2:column>
						<w2:column id="calecaledar" name="calecaledar" dataType="text"></w2:column>
						<w2:column id="custom" name="custom" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<textareaarea><![CDATA[11111111]]></textareaarea>
							<texttext><![CDATA[20231010]]></texttext>
							<calecaledar><![CDATA[30231010]]></calecaledar>
							<custom><![CDATA[40231010]]></custom>
						</w2:row>
						<w2:row>
							<textareaarea><![CDATA[22222222]]></textareaarea>
							<texttext><![CDATA[20231020]]></texttext>
							<calecaledar><![CDATA[30231010]]></calecaledar>
							<custom><![CDATA[40231010]]></custom>
						</w2:row>
						<w2:row>
							<textareaarea><![CDATA[33333333]]></textareaarea>
							<texttext><![CDATA[20231029]]></texttext>
							<calecaledar><![CDATA[30231010]]></calecaledar>
							<custom><![CDATA[40231010]]></custom>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	const tooltip = document.getElementById("mf_tooltip");
	tooltip.style.display = "none";
};

scwin.gridView1_onheaderover = function(info) {
	const tooltip = document.getElementById("mf_tooltip");
	const target = document.getElementById(info.id);
	let _left = target.offsetLeft + "px";
	let _top = target.offsetTop + target.offsetHeight + "px";
	tooltip.style.left = _left;
	tooltip.style.top = _top;
	tooltip.style.display = "flex";
	tooltip.value =info.id;
};

scwin.gridView1_onheadermouseout = function(info) {
	const tooltip = document.getElementById("mf_tooltip");
	tooltip.value = "";
	tooltip.style.display = "none";
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridview1"
			style="width: 1500px;height: 150px;" dataList="data:dataList1" editModeEvent="onclick"
			ev:onheadermouseover="scwin.gridView1_onheaderover"
			ev:onheadermouseout="scwin.gridView1_onheadermouseout">
			<w2:header style="background:red;" id="header2">
				<w2:row id="row3">
					<w2:column width="120" inputType="text" id="column4" value="textareaarea" displayMode="label"></w2:column>
					<w2:column width="120" inputType="text" id="column3" value="texttext" displayMode="label"></w2:column>
					<w2:column width="120" inputType="text" id="column5" value="calecaledar" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column6" value="custom" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="120" inputType="textarea" dataType="text" applyFormat="all" id="textareaarea" displayMode="label" editType="focus"></w2:column>
					<w2:column width="120" inputType="text" dataType="float" id="texttext" displayMode="label"></w2:column>
					<w2:column width="120" inputType="calendar" dataType="text" displayFormat="yyyy.MM.dd" applyFormat="all" id="calecaledar" displayMode="label" editType="focus"></w2:column>
					<w2:column width="70" inputType="text" dataType="text" applyFormat="all" id="custom" displayMode="label" editType="focus"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<input id="mf_tooltip" style="position:absolute;width:200px;height:20px;z-index:30;"></input>
	</body>
</html>
