<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection>
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="분류1" dataType="text"></w2:column>
						<w2:column id="col2" name="분류2" dataType="text"></w2:column>
						<w2:column id="col3" name="금액" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	// 금액(col3) = 8, 9, 10 x 69, 1 (72행)
	var data = [], amt = [8, 9];
	for (var i = 0; i < 69; i++) {
		amt.push(10);
	}
	amt.push(1);
	for (var i = 0; i < amt.length; i++) {
		data.push("0", "C", amt[i], 2, 3, 6);
	}
	dataList1.setData(data);
};
scwin.grid1_ongroupby = function(options) {
	options.groupbyHeader = [];
	options.groupbyFooter = [{
		inputType: "text",
		value: "test"
	}];
	this.groupby(options);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView style="position:relative;width:553px;height:307px;border:1px solid black;" groupbyZone="true" useRealColIndex="true" closeGroup="true" id="grid1"
			readOnlyBackgroundColor="#80ff00" rowNumVisible="true" backgroundColorMode="always" dataList="dataList1" ev:ongroupby="scwin.grid1_ongroupby"
			evenRowBackgroundColor="#00ff00" oddRowBackgroundColor="#ffff00">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column11" style="height:20px" inputType="text" width="70" displayMode="label" value="분류1"></w2:column>
					<w2:column id="column7" style="height:20px" inputType="text" width="70" displayMode="label" value="분류2"></w2:column>
					<w2:column id="column5" style="height:20px" inputType="text" width="70" displayMode="label" value="금액"></w2:column>
					<w2:column id="column3" style="height:20px" inputType="text" width="70" displayMode="label" value="name4"></w2:column>
					<w2:column id="column1" style="height:20px" width="70" inputType="text" displayMode="label" value="name5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70" displayMode="label" colMerge="true"></w2:column>
					<w2:column id="col3" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col4" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col5" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
