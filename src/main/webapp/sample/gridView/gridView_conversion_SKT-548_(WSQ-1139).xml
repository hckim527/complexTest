<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="number"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1111122222]]></col1>
							<col2><![CDATA[2]]></col2>
							<col3><![CDATA[3]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2222233333]]></col1>
							<col2><![CDATA[3]]></col2>
							<col3><![CDATA[4]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[4]]></col2>
							<col3><![CDATA[5]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger4_onclick = function(e) {
	alert("col2 ColumnID : " + gridView1.getColumnID(1));
	alert("col2 ColumnIndex : " + gridView1.getColumnIndex("col2"));
	gridView1.setMaxLength(1, 5);
	alert("col2 MaxLength : " + gridView1.getMaxLength(1));
};
]]></script>
	</head>
	<body>
		<w2:gridView dataList="dataList1" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20" id="gridView1"
			style="position:relative;width:574px;height:165px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column blockSelect="false" id="column5" inputType="text" width="70" value="column5" colSpan="3"
						rowSpan="2">
					</w2:column>
					<w2:column blockSelect="false" id="column3" inputType="text" width="70" value="name2"></w2:column>
					<w2:column blockSelect="false" id="column1" width="70" inputType="text" value="name3"></w2:column>
				</w2:row>
				<w2:row id="row3">
					<w2:column blockSelect="false" id="column9" style="height:20px;" width="70" inputType="text" value="column9"></w2:column>
					<w2:column blockSelect="false" id="column8" style="height:20px;" width="70" inputType="checkbox" value="Type"></w2:column>
					<w2:column blockSelect="false" id="column7" style="height:20px;" width="70" inputType="text" value="name6"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column blockSelect="false" id="col1" inputType="text" width="70"></w2:column>
					<w2:column blockSelect="false" id="col2" inputType="text" width="70"></w2:column>
					<w2:column blockSelect="false" id="col3" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger4" style="position:relative;width:270px;height:38px;" ev:onclick="scwin.trigger4_onclick">
			<xf:label><![CDATA[SKT548(setMaxLength, getMaxLength)]]></xf:label>
		</xf:trigger>
	</body>
</html>
