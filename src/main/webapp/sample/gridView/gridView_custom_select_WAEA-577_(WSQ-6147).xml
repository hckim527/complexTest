<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" ev:oncelldatachange="scwin.dataList1_oncelldatachange">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[1]]></col2>
							<col3><![CDATA[1]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[2]]></col2>
							<col3><![CDATA[0]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[1]]></col2>
							<col3><![CDATA[1]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col2><![CDATA[1]]></col2>
							<col1><![CDATA[일]]></col1>
						</w2:row>
						<w2:row>
							<col2><![CDATA[2]]></col2>
							<col1><![CDATA[이]]></col1>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var obj = { inputType: "checkbox", useRealRowIndex: true };
	gridView1.setCellInputType(1, "col3", obj);
};

scwin.dataList1_oncelldatachange = function(info) {
	var obj = {
		inputType: "select",
		useRealRowIndex: true,
		options: { viewType: "icon" },
		itemSet: {
			nodeset: "data:dataList2",
			label: "col1",
			value: "col2"
		}
	};
	gridView1.setCellInputType(1, "col3", obj);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" id="gridView1" style="width: 500px;height: 150px;" dataList="data:dataList1" setCellInputTypeCustom="true" dynamic="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column1" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="custom" id="col3" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
