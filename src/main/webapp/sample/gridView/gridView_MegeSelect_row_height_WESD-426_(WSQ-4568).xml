<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dl_basicData" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="col1"></w2:column>
						<w2:column dataType="text" id="col5" name="col5"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dl_ConsDv" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="cd" name="cd"></w2:column>
						<w2:column dataType="text" id="nm" name="nm"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<cd><![CDATA[01]]></cd>
							<nm><![CDATA[01]]></nm>
						</w2:row>
						<w2:row>
							<cd><![CDATA[02]]></cd>
							<nm><![CDATA[02]]></nm>
						</w2:row>
						<w2:row>
							<cd><![CDATA[03]]></cd>
							<nm><![CDATA[03]]></nm>
						</w2:row>
						<w2:row>
							<cd><![CDATA[04]]></cd>
							<nm><![CDATA[04]]></nm>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dl_basicData.setJSON([
		{ "col5": "02", "col1": "가" },
		{ "col5": "01", "col1": "가" },
		{ "col5": "03", "col1": "가" },
		{ "col5": "02", "col1": "라" },
		{ "col5": "01", "col1": "타" }
	]);
	grd_gridBasic.mergeCell({
		rowSpan: 2,
		colSpan: 1,
		colIndex: 0,
		rowIndex: 0
	});
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView autoFit="allColumn" dataList="dl_basicData" id="grd_gridBasic" style="width:300px;height:266px;">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="h_col05" inputType="text" style="height:29px;" value="select" width="100"></w2:column>
					<w2:column width="70" inputType="text" style="height:29px" id="column37" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column chooseOption="true" chooseOptionLabel="- 선택 -" displayMode="label" id="col5" inputType="select" style="height:29px;"
						viewType="icon" width="100">
						<w2:choices>
							<w2:itemset nodeset="data:dl_ConsDv">
								<w2:label ref="nm"></w2:label>
								<w2:value ref="cd"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="text" style="height:29px" id="col1" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
