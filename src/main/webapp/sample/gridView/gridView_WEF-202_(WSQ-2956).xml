		<script type="text/javascript" lazy="false"><![CDATA[
// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사)
scwin.__getJq = function(q) {
	var j = $(q); if (j.length) return j;
	var P = 'mf_', t = q.trim(), r = t.slice(1);
	if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
	return $(t.slice(0, 1) + r);
};
scwin.__isShowBorder = function() {
	var count = 0;
	var el = ((j) => j.length ? j : $('#mf_gridView1_body_tbody td'))($('#gridView1_body_tbody td')).find(".w2grid_hidedRow").each(function() {
		if (scwin.__getJq(this).css(border - width) == "1px") {
			count++;
		}
	});
	return el.length == count;
};
]]></script>
