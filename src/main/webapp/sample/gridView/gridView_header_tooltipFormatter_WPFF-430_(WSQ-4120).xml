<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[
scwin.tooltipFormatterHeaderFunc = function(colId, label) {
	console.log("-----> " + colId);
	return colId + label + "TEST";
};
]]></col1>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
						</w2:row>
						<w2:row>
							<col1><![CDATA[4]]></col1>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {};
scwin.onpageunload = function() {};
scwin.tooltipFormatterFunc = function(rowIndex, colIndex, label, isOverflow) {
	return rowIndex + colIndex + label + isOverflow + "TEST";
};
scwin.tooltipFormatterHeaderFunc = function(colId, label) {
	console.log("-----> " + colId);
	return colId + label + "TEST";
};
scwin.onpageload2 = function() {
	if (typeof scwin.onpageload === "function") {
		scwin.onpageload();
	}
	if (typeof scwin.unitTest === "function") {
		scwin.unitTest();
	}
}
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView"
			style="width: 500px;height: 150px;"
			tooltipFormatterHeader="scwin.tooltipFormatterHeaderFunc"
			tooltipHeader="true" tooltipDisplay="true" tooltipShowAlways="true" tooltipHeaderShowAlways="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" width="70" inputType="text" value="name1" displayMode="label">
					</w2:column>
					<w2:column id="column1" inputType="text" width="70" value="name2" displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" width="70" inputType="text" displayMode="label">
					</w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
