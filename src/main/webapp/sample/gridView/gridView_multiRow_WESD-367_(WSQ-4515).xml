		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    // 29행, extRow1 값이 있는 Row(0·7·8·13·16·17·21)만 2번째 줄 표시
    var ext = [0, 7, 8, 13, 16, 17, 21];
    var jsonData = [];
    for (var i = 0; i < 29; i++) {
        jsonData.push({
            "orderName": i == 0 ? "test1" : (i % 2 ? "test2" : "test3"),
            "orderKoreanName": "test1",
            "extRow1": ext.indexOf(i) > -1 ? "1" : ""
        });
    }
    orderList.setJSON(jsonData);
    scwin.chkMultiCellVisible(grd_orderList, "extRow1", "extChkRow,extRow1,extRow2");
};
// chkColumn 값이 없는 Row 는 2번째 줄 Cell 숨김
scwin.chkMultiCellVisible = function(grdComp, chkColumn, columnArrStr) {
    var dcObj = $p.getComponentById(grdComp.getDataList());
    var rowCnt = dcObj.getTotalRow();
    var multiColumnArr = columnArrStr.split(",");
    for (var i = 0; i < rowCnt; i++) {
        for (var j = 0; j < multiColumnArr.length; j++) {
            grdComp.setCellVisible(i, multiColumnArr[j], dcObj.getCellData(i, chkColumn).trim() != "");
        }
    }
};
]]></script>
