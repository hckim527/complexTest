<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [];
	for (var i = 1; i <= 19; i++) {
		jsonData.push({ col1: (i == 2 || i == 3 || i == 5 || i == 18) ? "Y" : "", col2: "" + i, col4: "col4" });
	}
	dataList1.setJSON(jsonData);
};
scwin.btn_setDisabled_onclick = function(e) {
	grd_main.setDisabled("column", "col4", true);
	grd_main.setDisabled("cell", "1", "col4", false);
};
]]></script>
		<style type="text/css"><![CDATA[
			.w2grid_input_disabled {background-color:red;}
		]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="grd_main" style="width: 500px;height: 150px;" defaultCellHeight="20" disabledBackgroundColor="#8080C0" dataList="data:dataList1">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column16" value="name1"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column15" value="name2"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column14" value="name3"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column13" value="name4"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" style="height:20px" id="col1"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" style="width: 80px;height: 23px;" id="btn_setDisabled" ev:onclick="scwin.btn_setDisabled_onclick">
			<xf:label><![CDATA[setDisabled]]></xf:label>
		</xf:trigger>
	</body>
</html>
