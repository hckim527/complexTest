						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	grd.setFocusedCell(8, 0)
};
scwin.trigger1_onclick = function(e) {
	grd.checkAll(0);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="grd" style="width: 500px;height: 150px;" scrollByColumn="false" defaultCellHeight="20" dataList="data:dataList1">
			<w2:header id="header3">
				<w2:row id="row5">
					<w2:column width="70" inputType="text" id="column9" value="name1"></w2:column>
					<w2:column width="70" inputType="text" id="column7" value="name2"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody3">
				<w2:row id="row6">
					<w2:column width="70" inputType="checkbox" id="col1"></w2:column>
					<w2:column width="70" inputType="text" id="col2"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" style="width: 80px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[checkAll]]></xf:label>
		</xf:trigger>
