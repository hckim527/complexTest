<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList3" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.insertRow();
	var jsonData = [{
			"col1": "aaaa",
			"col2": "aaaa"
		},
		{
			"col1": "bbbb",
			"col2": "bbbb"
		},
	];
	dataList2.setJSON(jsonData);
	var jsonData1 = [{
			"col1": "cccc",
			"col2": "cccc"
		},
		{
			"col1": "dddd",
			"col2": "dddd"
		}
	];
	dataList3.setJSON(jsonData1);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="" useShiftKey="true"
			style="position: absolute ;left: 69px;top: 43px;width:257px;height:81px;" scrollByColumn="false" defaultCellHeight="20"
			scrollByColumnAdaptive="false" dataList="data:dataList1">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column3" value="name1" blockSelect="false" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="name2" blockSelect="false" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="select" id="col1" blockSelect="false" displayMode="label"
						allOption="" chooseOption="true" chooseOptionLabel="">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="autoComplete" id="col2" blockSelect="false" displayMode="label"
						allOption="" chooseOption="true" chooseOptionLabel="">
						<w2:choices>
							<w2:itemset nodeset="data:dataList3">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" direction="auto" chooseOption="true" id=""
			style="width: 148px;height: 21px;" displayMode="label" optionOrder="false" allOption="" disabled="false" submenuSize="auto"
			chooseOptionLabel="">
			<xf:choices>
				<xf:itemset nodeset="data:dataList2">
					<xf:label ref="col1"></xf:label>
					<xf:value ref="col2"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
		<w2:autoComplete chooseOption="true" search="start" displayMode="label" useKeywordHighlight="false" submenuSize="auto"
			visibleRowNum="5" id="" style="width: 148px;height: 21px;" interactionMode="" editType="select" allOption=""
			chooseOptionLabel="">
			<w2:choices>
				<w2:itemset nodeset="data:dataList3">
					<w2:label ref="col1"></w2:label>
					<w2:value ref="col2"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:autoComplete>
	</body>
</html>
