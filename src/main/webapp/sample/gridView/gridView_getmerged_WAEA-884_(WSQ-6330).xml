<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dl2" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="name1"></w2:column>
						<w2:column dataType="text" id="col2" name="name2"></w2:column>
						<w2:column dataType="text" id="col3" name="name3"></w2:column>
						<w2:column dataType="text" id="col4" name="name4"></w2:column>
						<w2:column dataType="text" id="col5" name="name5"></w2:column>
						<w2:column dataType="text" id="col6" name="name6"></w2:column>
						<w2:column dataType="text" id="col7" name="name7"></w2:column>
						<w2:column dataType="text" id="col8" name="name8"></w2:column>
						<w2:column dataType="text" id="col9" name="name9"></w2:column>
						<w2:column dataType="text" id="col10" name="name10"></w2:column>
					</w2:columnInfo>
					<w2:data use="false"></w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	btn1.click();
};

scwin.btn1_onclick = function (e) {
	const rows = ib1.getValue();
	const cols = 10;

	const data = Array.from({ length: rows }, (_, r) => {
		const rowNum = r + 1;
		let rowObj = {};

		rowObj['col1'] = String(Math.min((r % 5) + 1, 3));
		rowObj['col2'] = Math.trunc(r / 5).toString();
		rowObj['col3'] = 1;
		rowObj['col4'] = r*100;
		rowObj['col5'] = "/cm/images/base/ico_upload.svg";

		for (let c = 6; c <= cols; c++) {
			rowObj[`col${c}`] = `row${rowNum}_col${c}`;
		}

		return rowObj;
	});

	dl2.setJSON(data, false);
};

scwin.button1_onclick = function (e) {
	alert(gv2.getMerged(0, 0));
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="width:600px;height:5px;"></xf:group>
		<xf:input id="ib1" style="width: 100px;height: 30px;" initValue="10"></xf:input>
		<w2:button style="width: 80px;height: 30px;" id="btn1" ev:onclick="scwin.btn1_onclick" label="load data"></w2:button>
		<w2:button ev:onclick="scwin.button1_onclick" id="button1" label="getmerged(0,0)" style="width:141px;height:30px;"></w2:button>
		<xf:group id="" style="width:600px;height:5px;"></xf:group>
		<w2:gridView checkAllType="false" dataList="data:dl2" id="gv2" style="width:778px;height:304px;" mergeCells="bycolupper">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column10" inputType="text" value="name1" width="70"></w2:column>
					<w2:column id="column9" inputType="text" value="name2" width="70"></w2:column>
					<w2:column id="column8" inputType="text" value="name3" width="70"></w2:column>
					<w2:column id="column7" inputType="text" value="name4" width="70"></w2:column>
					<w2:column id="column6" inputType="text" value="name5" width="70"></w2:column>
					<w2:column id="column5" inputType="text" value="name6" width="70"></w2:column>
					<w2:column id="column4" inputType="text" value="name7" width="70"></w2:column>
					<w2:column id="column3" inputType="text" value="name8" width="70"></w2:column>
					<w2:column id="column2" inputType="text" value="name9" width="70"></w2:column>
					<w2:column id="column1" inputType="text" value="name10" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70"></w2:column>
					<w2:column id="col2" inputType="text" width="70"></w2:column>
					<w2:column id="col3" inputType="text" width="70" upperColumn="col1"></w2:column>
					<w2:column id="col4" inputType="text" width="70"></w2:column>
					<w2:column id="col5" inputType="text" width="70"></w2:column>
					<w2:column id="col6" inputType="text" width="70"></w2:column>
					<w2:column id="col7" inputType="text" width="70"></w2:column>
					<w2:column id="col8" inputType="text" width="70"></w2:column>
					<w2:column id="col9" inputType="text" width="70"></w2:column>
					<w2:column id="col10" inputType="text" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
