<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col2><![CDATA[1]]></col2>
						</w2:row>
						<w2:row>
							<col2><![CDATA[2]]></col2>
						</w2:row>
						<w2:row>
							<col2><![CDATA[3]]></col2>
						</w2:row>
						<w2:row>
							<col2><![CDATA[4]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<w2:layoutInfo/>
		<w2:publicInfo method=""/>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.trigger1_onclick = function(e) {
	var info = {
		inputType : "textarea"
	};
	grd_1.setCellInputType(0, "col1", info);
};

scwin.textarea = function() {
	return document.getElementById('G_' + $p.id + 'grd_1__dynamic_textarea_0_0') || document.getElementById('G_mf_' + $p.id + 'grd_1__dynamic_textarea_0_0') || document.getElementById('G_' + $p.id + 'mf_grd_1__dynamic_textarea_0_0');
};

scwin.checkVal1 = function() {
	return scwin.textarea().style.display == 'block';
};

scwin.checkVal2 = function() {
	return scwin.textarea().style.display == 'none';
};
]]></script>
	</head>
	<body>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="grd_1" style="width:581px;height:233px;" dataList="data:dataList1"
			sortable="true" sortedIconPosition="right" showSortableImage="true" setCellInputTypeCustom="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="110" inputType="text" id="column3" value="name1" displayMode="label"></w2:column>
					<w2:column width="130" inputType="text" id="column2" value="name2" displayMode="label" sortable="true"></w2:column>
					<w2:column width="179" inputType="text" id="column1" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="110" inputType="custom" id="col1" displayMode="label"></w2:column>
					<w2:column width="130" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="179" inputType="text" id="col3" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[0 ROW]]></xf:label>
		</xf:trigger>
	</body>
</html>
