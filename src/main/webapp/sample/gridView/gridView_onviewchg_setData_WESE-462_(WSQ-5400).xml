<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.grd1_onviewchange = function(info) {
	if(info.colIndex == 0){
		dataList1.setCellData(info.rowIndex, "col2", "aaaaa");
	}
};
]]></script>
	</head>
	<body>
		<xf:group style="padding: 10px">
			<w2:gridView checkAllType="false" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="grd1"
				style="height: 150px;" dataList="data:dataList1" ev:onviewchange="scwin.grd1_onviewchange" editModeEvent="onclick" keyMoveEditMode="true" keepEditMode="true">
				<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
				<w2:header id="header2">
					<w2:row id="row3">
						<w2:column width="200" inputType="text" id="column4" value="첫번째" displayMode="label"></w2:column>
						<w2:column width="200" inputType="text" id="column3" value="두번째" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody2">
					<w2:row id="row4">
						<w2:column width="200" inputType="text" id="col1" displayMode="label"></w2:column>
						<w2:column width="200" inputType="text" id="col2" displayMode="label"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
