<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:linkedDataList bind="dataList1" id="linkedDataList1">
					<w2:condition type="filter"><![CDATA[col('col1') == '3']]></w2:condition>
					<w2:condition type="sort"><![CDATA[]]></w2:condition>
				</w2:linkedDataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var data = [];
	var row = 100;
	var col = 4;
	for (var i = 0; i < row; i++) {
		for (var j = 0; j < col; j++) {
			data.push(String(i%4));
		}
	}
	dataList1.setData(data);
	window.viewChangeLog = [];
};

scwin.gridView1_onviewchange = function(info) {
	window.viewChangeLog.push({ rowIndex: info.rowIndex, colIndex: info.colIndex, oldValue: info.oldValue, newValue: info.newValue });
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width:420px;height:276px;" dataList="data:linkedDataList1" rowNumVisible="true" rowStatusVisible="true" ev:onviewchange="scwin.gridView1_onviewchange">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column6" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name4" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col4" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
