scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.grd_TrdStat_ongroupby = function(options) {
	options.closeGroup = false;
	options.groupbyHeader = [{
		colSpan: "20",
		inputType: "expression",
		expression: " toggle() + depthStr() + ' [ ' + count() + ' 건 ] ' ",
		align: "left"
	}];
	grd_TrdStat.groupby(options);
};
scwin.trigger1_onclick = function(e) {
	scwin.$w.executeSubmission("sub_List");
};
scwin.checkVal1 = function() {
	return scwin.__getDom($p.id+"grd_TrdStat_cell_0_0").childNodes[0].innerText.trim() == 'A [ 5 건 ]';
}
scwin.checkVal2 = function() {
