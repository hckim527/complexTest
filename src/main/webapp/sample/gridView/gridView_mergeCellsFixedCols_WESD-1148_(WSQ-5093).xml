<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="number"></w2:column>
						<w2:column id="col2" name="name2" dataType="number"></w2:column>
						<w2:column id="col3" name="name3" dataType="number"></w2:column>
						<w2:column id="col4" name="name4" dataType="number"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.row = 20;
scwin.col = 5;
scwin.onpageload = function() {
	var row = scwin.row;
	var col = scwin.col;
	var data = [];
	for(var i = 0; i < row; i++){
		for(var j = 0; j < col; j++){
			data.push((i * row + j) + "");
		}
	}
	dataList1.setData(data);
	scwin.trigger1_onclick();
	scwin.trigger2_onclick();
	scwin.trigger3_onclick();
};
scwin.trigger1_onclick = function() {
	gridView1.mergeByFree(2,2,4,4);
}
scwin.trigger2_onclick = function() {
	gridView1.setFixedColumn(2);
	for (var i = 0; i < scwin.row; i++) {
		for (var j = 0; j < 2; j++) {
			dataList1.setCellData(i, j, (Math.floor(i/3) + ""));
		}
	}
}
scwin.trigger3_onclick = function() {
	dataList1.removeRows([1,3,11]);
}
scwin.checkVal = function() {
	return (document.getElementById('gridView1_cell_1_2') || document.getElementById('mf_gridView1_cell_1_2')).getAttribute('colspan') == '3' && (document.getElementById('gridView1_cell_1_2') || document.getElementById('mf_gridView1_cell_1_2')).getAttribute('rowspan') == '2';
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width:700px;height:297px;" defaultCellHeight="20" dataList="data:dataList1" mergeCellsFixedCols="byCol" rowNumVisible="true" fixedColumn="">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="120" inputType="text" style="height:20px" id="column22" value="name1"
						displayMode="label" dataType="number">
					</w2:column>
					<w2:column width="120" inputType="text" style="height:20px" id="column21" value="name2"
						displayMode="label" dataType="number">
					</w2:column>
					<w2:column width="120" inputType="text" style="height:20px;" id="column20" value="name3"
						displayMode="label" dataType="number">
					</w2:column>
					<w2:column width="120" inputType="text" style="height:20px" id="column18" value="name5"
						displayMode="label" dataType="number">
					</w2:column>
					<w2:column width="120" inputType="text" style="height:20px" id="column17" value="name6"
						displayMode="label" dataType="number">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" style="height:20px" id="col1"
						displayMode="label" dataType="number">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2"
						displayMode="label" dataType="number">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3"
						displayMode="label" dataType="number">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4"
						displayMode="label" dataType="number">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col5"
						displayMode="label" dataType="number">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger ev:onclick="scwin.trigger1_onclick" style="width:143px;height:36px;" id="trigger1" type="button">
			<xf:label><![CDATA[mergeTest]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger2_onclick" style="width:143px;height:36px;" id="trigger2" type="button">
			<xf:label><![CDATA[fixedColumn]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger3_onclick" style="width:143px;height:36px;" id="trigger3" type="button">
			<xf:label><![CDATA[removeRows]]></xf:label>
		</xf:trigger>
	</body>
</html>
