		for (let c = 1; c <= 13; c++) row["col" + c] = "test123";
		data.push(row);
	}
	dataList1.setJSON(data);
	checkcombobox1.checkAll(true);
};

scwin.checkcombobox1_oncheckboxclick = function(index, isChecked, value) {
	if (value == "all") {
		for (var i = 2; i <= 14; i++) {
			grd_sample1.setColumnVisible("col" + i, isChecked);
		}
	} else {
		if (index != "1") {
			grd_sample1.setColumnVisible("col" + index, isChecked);
		}
	}
};

scwin.checkVal = function() {
	const element = (document.getElementById('grd_sample1_cell_0_3') || document.getElementById('mf_grd_sample1_cell_0_3'));
	return Number(window.getComputedStyle(element).width.replace("px", "")) < 300;
};
