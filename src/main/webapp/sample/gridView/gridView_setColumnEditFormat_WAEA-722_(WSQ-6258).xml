<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.trigger1_onclick = function (e) {
	gridView1.setColumnEditFormat("col1", "####-####");
	dataList1.setJSON([{col1:"12345678"}]);
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" id="trigger1" style="width: 180px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setColumnEditFormat]]></xf:label>
		</xf:trigger>
		<w2:gridView checkAllType="false" id="gridView1" style="width: 800px;height: 350px;" defaultCellHeight="20" dataList="data:dataList1" rowNumVisible="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column10" value="name1"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="col1"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
