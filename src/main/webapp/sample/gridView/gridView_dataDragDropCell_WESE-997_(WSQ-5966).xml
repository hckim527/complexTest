						<w2:row>
							<col1><![CDATA[b1]]></col1>
							<col2><![CDATA[b2]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.dragEnd = function(targetRowIndex, rowIndex, info) {
	window.dragEndArgs = { targetRowIndex: targetRowIndex, rowIndex: rowIndex, fromColumnId: info.fromColumnId, fromColumnIndex: info.fromColumnIndex,
		toColumnId: info.toColumnId, toColumnIndex: info.toColumnIndex, cellDataArray: info.cellDataArray };
	dataList2.setCellData(targetRowIndex, info.toColumnIndex, info.cellDataArray[0].data);
	return true;
};
]]></script>
	</head>
	<body>
		<xf:group style="padding: 30px;">
			<w2:gridView autoFit="allColumn" dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="width: 400px;height: 150px;margin-top: 50px;"
				rowNumVisible="true" rowStatusVisible="true" useCtrlKey="true" useShiftKey="true" dataDragDrop="true" dataDragDropCell="true">
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column width="70" inputType="text" id="column28" value="text" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="column27" value="link" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column width="70" inputType="text" id="text" displayMode="label"></w2:column>
						<w2:column width="70" inputType="link" id="link" displayMode="label"></w2:column>
