<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="../../com/css/comm.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col2><![CDATA[1]]></col2>
							<col1><![CDATA[1]]></col1>
							<col3><![CDATA[1]]></col3>
							<col4><![CDATA[1]]></col4>
						</w2:row>
						<w2:row>
							<col2><![CDATA[2]]></col2>
							<col1><![CDATA[2]]></col1>
							<col3><![CDATA[2]]></col3>
							<col4><![CDATA[2]]></col4>
						</w2:row>
						<w2:row>
							<col2><![CDATA[3]]></col2>
							<col1><![CDATA[3]]></col1>
							<col3><![CDATA[3]]></col3>
							<col4><![CDATA[3]]></col4>
						</w2:row>
						<w2:row>
							<col2><![CDATA[4]]></col2>
							<col1><![CDATA[4]]></col1>
							<col3><![CDATA[4]]></col3>
							<col4><![CDATA[4]]></col4>
						</w2:row>
						<w2:row>
							<col2><![CDATA[5]]></col2>
							<col1><![CDATA[5]]></col1>
							<col3><![CDATA[5]]></col3>
							<col4><![CDATA[5]]></col4>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<w2:gridView dataList="data:dataList1" useFilterList="true" defaultCellHeight="20" id="gridView1" style="position: absolute;width: 500px;height: 150px;"
			useShiftKey="true" columnMove="true" dataDragSelect="true" columnMoveWithFooter="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column7" inputType="text" width="70" value="name1" displayMode="label" useFilter="true"></w2:column>
					<w2:column id="column5" inputType="text" width="70" value="name2" displayMode="label" sortable="true"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name3" displayMode="label" useFilter="true"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name4" displayMode="label" sortable="true"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col4" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column id="column12" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column11" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column10" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column9" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
		<!-- 필수점검사항: header inputType checkbox·select·checkcombobox (+useFilter/sortable) 컬럼 이동 -->
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView2" style="position: absolute;top: 200px;width: 500px;height: 150px;"
			columnMove="true">
			<w2:header id="header2">
				<w2:row id="row4">
					<w2:column id="hchk" inputType="checkbox" width="90" value="chk" useFilter="true"></w2:column>
					<w2:column id="hsel" inputType="select" width="90" value="sel" sortable="true">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[A]]></w2:label>
								<w2:value><![CDATA[1]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[B]]></w2:label>
								<w2:value><![CDATA[2]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
					<w2:column id="hccb" inputType="checkcombobox" width="90" value="ccb" useFilter="true">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[A]]></w2:label>
								<w2:value><![CDATA[1]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[B]]></w2:label>
								<w2:value><![CDATA[2]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
					<w2:column id="htxt" inputType="text" width="90" value="txt" sortable="true"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row5">
					<w2:column id="col1" inputType="checkbox" width="90"></w2:column>
					<w2:column id="col2" inputType="text" width="90"></w2:column>
					<w2:column id="col3" inputType="text" width="90"></w2:column>
					<w2:column id="col4" inputType="text" width="90"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
