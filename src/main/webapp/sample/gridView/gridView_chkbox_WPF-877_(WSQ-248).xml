<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dl_empInfo" baseNode="list" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="CH_ROW" name="선택" dataType="text" ignoreStatus="true"></w2:column>
						<w2:column id="EMPNO" name="사원번호" dataType="text"></w2:column>
						<w2:column id="ENAME" name="사원이름" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dl_empInfo.setJSON([
		{"CH_ROW": "0", "EMPNO": "7369", "ENAME": "SMITH"},
		{"CH_ROW": "0", "EMPNO": "7499", "ENAME": "ALLEN"},
		{"CH_ROW": "0", "EMPNO": "7521", "ENAME": "WARD"},
		{"CH_ROW": "0", "EMPNO": "7566", "ENAME": "JONES"}
	]);
};
scwin.btn_init_onclick = function(e) {
	grid_emp_list.initGrid();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dl_empInfo" id="grid_emp_list" style="width:400px;height:150px;">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" inputType="checkbox" style="height:20px;" width="40"></w2:column>
					<w2:column id="column13" inputType="text" style="height:20px;" value="사원번호" width="120"></w2:column>
					<w2:column id="column11" inputType="text" style="height:20px;" value="사원이름" width="120"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="CH_ROW" inputType="checkbox" style="height:20px" defaultValue="0" width="40"></w2:column>
					<w2:column id="EMPNO" inputType="text" readOnly="true" style="height:20px" width="120"></w2:column>
					<w2:column id="ENAME" inputType="text" readOnly="true" style="height:20px" width="120"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="btn_init" style="width:80px;height:23px;" ev:onclick="scwin.btn_init_onclick">
			<xf:label><![CDATA[초기화]]></xf:label>
		</xf:trigger>
	</body>
</html>
