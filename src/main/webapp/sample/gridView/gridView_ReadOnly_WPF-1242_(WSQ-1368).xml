<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.__getJq = function(q) {
	var j = $(q); if (j.length) return j;
	var P = 'mf_', t = q.trim(), r = t.slice(1);
	if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
	return $(t.slice(0, 1) + r);
};
scwin.rgb2hex = function(rgb) {
	rgb = rgb.match(/^rgba?[\s+]?\([\s+]?(\d+)[\s+]?,[\s+]?(\d+)[\s+]?,[\s+]?(\d+)[\s+]?/i);
	return (rgb && rgb.length === 4) ? "#" +
		("0" + parseInt(rgb[1], 10).toString(16)).slice(-2) +
		("0" + parseInt(rgb[2], 10).toString(16)).slice(-2) +
		("0" + parseInt(rgb[3], 10).toString(16)).slice(-2) : '';
}
scwin._checkRgb = function(id, hexa) {
	var rgb = scwin.__getJq("#" + id).css("background-color");
	var color;
	if (rgb.indexOf("rgb") != -1) {
		color = scwin.rgb2hex(rgb);
		return color == hexa;
	}
	return rgb == hexa;
}
scwin.onpageload = function() {
	for (var i = 0; i < 15; i++) {
		dataList1.insertRow();
	}
	gridView1.setColumnReadOnly("col1", true);
	gridView1.setColumnReadOnly("col3", true);
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1"
			ignoreNonEditableCell="true" focusFlow="linear"
			style="position: absolute ;left:31px;top:71px;width:607px;height:389px;" fixedColumnWithHidden="true" useShiftKey="false"
			readOnlyBackgroundColor="#FFBC6C" ignoreNonEditableCellTabEnter="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column13" style="height:20px" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column11" style="height:20px" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column9" style="height:20px" inputType="text" width="70" value="name3"></w2:column>
					<w2:column id="column7" style="height:20px" inputType="text" width="70" value="name4"></w2:column>
					<w2:column id="column3" style="height:20px" width="70" inputType="text" value="name5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col3" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col4" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col5" style="height:20px" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
