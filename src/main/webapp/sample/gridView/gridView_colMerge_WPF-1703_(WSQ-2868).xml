<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="text"/>
						<w2:column id="col3" name="name3" dataType="text"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [
		{"col1": "ZZ9LKPB", "col2": "LIGHT PINK SHIMMER", "col3": "100"},
		{"col1": "ZZ9LKPB", "col2": "WHITE/GOLD COMBO", "col3": "200"},
		{"col1": "AI72W5A", "col2": "WHITE/GOLD COMBO", "col3": "300"},
		{"col1": "AI72W5A", "col2": "WHITE/GOLD COMBO", "col3": ""},
		{"col1": "AI72W5A", "col2": "WHITE/GOLD COMBO", "col3": "400"},
		{"col1": "AI72W5A", "col2": "PINK MULTI DOT", "col3": "500"},
		{"col1": "AI72W5A", "col2": "PINK MULTI DOT", "col3": "600"},
		{"col1": "AI72W5A", "col2": "PINK MULTI DOT", "col3": "700"}
	];
	dataList1.setJSON(jsonData);
}
scwin.trigger1_onclick = function(e) {
	var excelOpt = {};
	excelOpt.fileName = "test.xlsx";
	excelOpt.type = "1";
	excelOpt.colMerge = "true";
	excelOpt.useSubTotal = "true";
	excelOpt.useSubTotalData = "true";
	gridView1.advancedExcelDownload(excelOpt);
};
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[excel]]></xf:label>
		</xf:trigger><w2:gridView dataList="dataList1" useFilterList="false" showSortableUseFilter="false" id="gridView1" style="position: relative;width:500px;height:174px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:caption id="caption1" value="this is a grid caption."/>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" style="height:20px" inputType="text" width="103" displayMode="label" value="name1"/>
					<w2:column id="column3" style="height:20px" inputType="text" width="168" displayMode="label" value="name2"/>
					<w2:column id="column1" style="height:20px" width="70" inputType="text" displayMode="label" value="name3"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" inputType="text" width="103" displayMode="label" colMerge="true"/>
					<w2:column id="col2" style="height:20px" inputType="text" width="168" displayMode="label" colMerge="true"/>
					<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"/>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal1" targetColumnID="col2">
				<w2:row id="row3">
					<w2:column id="column9" style="height:20px;background-color:#FF220B;" width="103" inputType="text" displayMode="label"/>
					<w2:column id="column8" style="height:20px;background-color:#FF220B;" width="168" inputType="text" displayMode="label" value="Color별 소계"/>
					<w2:column id="column7" style="height:20px;background-color:#FF220B;" width="70" inputType="text" displayMode="label"/>
				</w2:row>
			</w2:subTotal>
			<w2:subTotal id="subTotal2" targetColumnID="col1">
				<w2:row id="row4">
					<w2:column id="column12" style="height:20px;" width="103" inputType="text" displayMode="label" value="Po별 소계"/>
					<w2:column id="column11" style="height:20px;" width="168" inputType="text" displayMode="label"/>
					<w2:column id="column10" style="height:20px;" width="70" inputType="text" displayMode="label"/>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
	</body>
</html>
