<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [];
	for (var i = 0; i < 10; i++) {
		jsonData.push({ "col1": "123456", "col2": "78945" });
	}
	dataList1.setJSON(jsonData);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="position:absolute;top:20px;left:9px;width:236px;height:125px;" defaultCellHeight="20" dataList="data:dataList1" visibleRowNum="5">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="checkbox" style="height:20px;" id="column3"></w2:column>
					<w2:column width="142" inputType="text" style="height:20px;" id="column1" value="inputtype=text"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1"></w2:column>
					<w2:column width="142" inputType="text" style="height:20px" id="col2"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<!-- 요건 조건(두 번째 Column inputType=custom) 대조용 -->
		<w2:gridView id="gridView2" style="position:absolute;top:20px;left:300px;width:236px;height:125px;" defaultCellHeight="20" dataList="data:dataList1" visibleRowNum="5">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="checkbox" style="height:20px;" id="column3"></w2:column>
					<w2:column width="142" inputType="text" style="height:20px;" id="column1" value="inputtype=custom"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1"></w2:column>
					<w2:column width="142" inputType="custom" style="height:20px" id="col2"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
