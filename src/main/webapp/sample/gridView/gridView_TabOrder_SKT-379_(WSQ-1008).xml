<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data/>
			</xf:instance>
			<w2:dataCollection>
				<w2:dataList baseNode="list" id="dst_Output" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="prod_nm" name=""/>
						<w2:column dataType="text" id="title_nm" name=""/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.btn_close_onfocus = function() {
	isFocus = true;
};
scwin.onpageload = function() {
	window.isFocus = false;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="w2tb" id="tbl_search" tagname="table">
			<xf:group tagname="tr">
				<xf:group class="w2tb_th" tagname="th">상담일</xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<w2:inputCalendar id="cal_fromCnslDt" nextTabID="cal_toCnslDt"/>
					<w2:inputCalendar id="cal_toCnslDt" nextTabID="edt_prodNm"/>
				</xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<w2:attributes>
						<w2:rowspan>2</w2:rowspan>
					</w2:attributes>
					<xf:trigger id="btn_find" nextTabID="btn_close">
						<xf:label><![CDATA[조회]]></xf:label>
					</xf:trigger>
				</xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group class="w2tb_th" tagname="th">상품</xf:group>
				<xf:group class="w2tb_td" tagname="td">
					<xf:input id="edt_prodNm" nextTabID="cob_mainCnslCd"/>
					<xf:select1 appearance="minimal" id="cob_mainCnslCd" nextTabID="btn_find">
						<xf:choices>
							<xf:item>
								<xf:label><![CDATA[a]]></xf:label>
								<xf:value><![CDATA[1]]></xf:value>
							</xf:item>
						</xf:choices>
					</xf:select1>
				</xf:group>
			</xf:group>
		</xf:group>
		<w2:gridView dataList="dst_Output" id="grd_list" style="height:100px;">
			<w2:header>
				<w2:row>
					<w2:column id="temp_id_305" inputType="text" value="상품" width="110"/>
					<w2:column id="temp_id_306" inputType="text" value="상담내용" width="180"/>
				</w2:row>
			</w2:header>
			<w2:gBody>
				<w2:row>
					<w2:column id="prod_nm" inputType="text" width="110"/>
					<w2:column id="title_nm" inputType="text" width="180"/>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger id="btn_close" ev:onfocus="scwin.btn_close_onfocus">
			<xf:label><![CDATA[확인]]></xf:label>
		</xf:trigger>
	</body>
</html>
