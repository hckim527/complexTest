							<book_name><![CDATA[정글만리]]></book_name>
							<price><![CDATA[16500]]></price>
							<published_date><![CDATA[20130701]]></published_date>
						</w2:row>
						<w2:row>
							<book_name><![CDATA[불편한 편의점]]></book_name>
							<price><![CDATA[14000]]></price>
							<published_date><![CDATA[20210420]]></published_date>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="" />
		<script lazy="false" type="text/javascript"><![CDATA[
/**
 * 버튼 [컬럼 '정가'에 비활성화 적용하기] 클릭 시
 */
scwin.btn_ex3_onclick = function(e) {
	grd_exam2.setColumnDisabled("price", true);
};
]]></script>
	</head>
	<body>
		<xf:trigger class="btn_exam_exec btn_txt_of" escape="false" ev:onclick="scwin.btn_ex3_onclick" id="btn_ex3" style="padding:4px;white-space:normal;display:block;margin-bottom:6px;text-align:left;color: blue;" type="button">
			<xf:label><![CDATA[[오동작] 컬럼 '정가'에 비활성화 적용하기 - 속성 disabledBackgroundColor, disabledFontColor이 반영되지 않습니다.]]></xf:label>
		</xf:trigger>
		<w2:gridView autoFit="allColumn" autoFitMinWidth="240" class="wq_gvw" dataList="data:dlt_books"
			defaultCellHeight="24" disabledBackgroundColor="green" disabledFontColor="#bbb" id="grd_exam2" rowNumVisible="true"
			rowNumWidth="26" style="height:100px;" visibleRowNum="4" visibleRowNumFix="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="column3" inputType="text" value="도서명" width="174"></w2:column>
					<w2:column displayMode="label" id="column2" inputType="text" value="정가" width="63"></w2:column>
					<w2:column displayMode="label" id="column1" inputType="text" value="출간일" width="84"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="book_name" inputType="text" textAlign="left" width="174"></w2:column>
					<w2:column dataType="number" displayFormat="#,###" displayMode="label" id="price" inputType="text" textAlign="right" width="63"></w2:column>
					<w2:column dataType="date" displayFormat="yyyy-MM-dd" displayMode="label" id="published_date" inputType="text" width="84"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
