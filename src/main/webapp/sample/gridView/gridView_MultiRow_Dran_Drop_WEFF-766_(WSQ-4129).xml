<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	scwin.Z = [1, 3, 4, 6, 7, 8, 9, 12, 13, 14, 15, 16, 21, 24, 27, 28, 29, 30, 37, 38, 39];
	scwin.Z2 = {};
	for (var i = 0; i < scwin.Z.length; i++) {
		scwin.Z2[scwin.Z[i]] = true;
	}
	var data = [];
	for (var i = 0; i < 50; i++) {
		for (var j = 0; j < 5; j++) {
			if (scwin.Z2[i] !== true) {
				data.push(i + "_" + j);
			} else {
				data.push("[H]" + i + "_" + j);
			}
		}
		if (scwin.Z2[i] === true) {
			data.push("XX" + i + "_" + j + "XX");
			data.push("XX" + i + "_" + j + "XX");
		} else {
			data.push("OO" + i + "_" + j + "OO");
			data.push("OO" + i + "_" + j + "OO");
		}
	}
	dataList1.setData(data);
	scwin.refreshCellVisible();
};
scwin.refreshCellVisible = function() {
	for (var i = 0; i < scwin.Z.length; i++) {
		gridView1.setCellVisible(scwin.Z[i], 5, false);
		gridView1.setCellVisible(scwin.Z[i], 6, false);
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width:500px;height:650px;" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" dataList="data:dataList1" rowNumVisible="true" dataDragDrop="true">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="column13" value="name1" displayMode="label"></w2:column>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="column11" value="name2" displayMode="label"></w2:column>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="column9" value="name3" displayMode="label"></w2:column>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="column7" value="name4" displayMode="label"></w2:column>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="column5" value="name5" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="col3" displayMode="label"></w2:column>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="col4" displayMode="label"></w2:column>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="col5" displayMode="label"></w2:column>
				</w2:row>
				<w2:row id="row5">
					<w2:column removeBorderStyle="false" width="70" inputType="text" style="height:20px;" id="col6" displayMode="label"></w2:column>
					<w2:column removeBorderStyle="false" width="280" inputType="text" style="height:20px;" id="col7" displayMode="label" colSpan="4"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
