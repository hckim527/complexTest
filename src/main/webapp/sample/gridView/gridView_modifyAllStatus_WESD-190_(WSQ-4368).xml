<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text" defaultValue="col1"></w2:column>
						<w2:column id="col2" name="name2" dataType="text" defaultValue="col2"></w2:column>
						<w2:column id="col3" name="name3" dataType="text" defaultValue="col3"></w2:column>
						<w2:column id="col4" name="name4" dataType="text" defaultValue="col4"></w2:column>
						<w2:column id="depth" name="depth" dataType="text" defaultValue="col5"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    dataList1.insertRow();
    var row = dataList1.getRowJSON(0);
    var json = [];
    for (var i = 0; i < 30; i++) {
        var tmp = {};
        for (var item in row) {
            if (item == "rowStatus") continue;
            tmp[item] = i % 11 == 0 ? "\u001a" : item + "_" + i;
            if (item == "col2") tmp[item] = "N"
            if (item == "depth") tmp[item] = i % 5 == 0 ? 1 : i % 5;
        }
        json.push(tmp);
    }
    dataList1.setJSON(json);
};
scwin.setVal1 = function() {
    dataList1.getModifiedIndex();
    dataList1.modifyAllStatus("R");
    dataList1.resetOriginalDataArr();
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="position: relative;height: 288px;margin-left: 15px;margin-right: 15px;" autoFit="allColumn" fixedColumn="1" visibleRowNum="all" readOnly="false" dataDragSelect="true" useShiftKey="true" rowStatusVisible="true">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column9" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column7" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column5" inputType="text" width="70" value="name3" displayMode="label"></w2:column>
					<w2:column id="column3" width="70" inputType="text" value="name4" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="drilldown" width="300" displayMode="label" showDepth="10" depthType="div" depthColumn="depth"></w2:column>
					<w2:column id="col2" inputType="checkbox" width="200" displayMode="label" trueValue="Y" falseValue="N" valueType="other"></w2:column>
					<w2:column id="col3" inputType="text" width="200" displayMode="label"></w2:column>
					<w2:column id="col4" inputType="text" width="200" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
