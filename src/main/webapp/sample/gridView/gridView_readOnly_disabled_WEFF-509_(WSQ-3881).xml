<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.onpageload = function() {
	var jsonData = [{
		"col1": "가가가",
		"col2": "aaa",
		"col3": 111
	}, {
		"col1": "나나나",
		"col2": "aaa",
		"col3": 111
	}, {
		"col1": "다다다",
		"col2": "aaa",
		"col3": 111
	}, {
		"col1": "라라라",
		"col2": "ddd",
		"col3": 111
	}, {
		"col1": "마마마",
		"col2": "eee",
		"col3": 555
	}];
	dataList1.setJSON(jsonData);
};
scwin.checkVal = function() {
	var browse = navigator.userAgent.toLowerCase();
	var temp = scwin.__getDom($p.id + 'gridView1_cell_1_2').getAttribute('class');
	if ((navigator.appName == 'Netscape' && browse.indexOf('trident') != -1) || (browse.indexOf("msie") != -1)) {
		return temp.indexOf('w2grid_default_readonly') == 62;
	} else {
		return temp.includes("w2grid_default_readonly");
	}
}
]]></script>
		<style type="text/css"><![CDATA[
			.w2grid_default_readonly {
				background-color:yellow;
			}
			.w2grid_default_disabled {
				background-color:green;
			}
		]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="group1" style="height: 200px;">
			<w2:textbox label='readOnly = "true"' id="textbox1" style="width: 220px;height: 23px;font-size: 22px;"></w2:textbox>
			<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1" style="width: 500px;height: 150px;">
				<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
				<w2:header id="header2">
					<w2:row id="row3">
						<w2:column id="column7" removeBorderStyle="false" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
						<w2:column id="column5" removeBorderStyle="false" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
						<w2:column id="column3" removeBorderStyle="false" width="70" inputType="text" value="name3" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody2">
					<w2:row id="row4">
						<w2:column id="col1" removeBorderStyle="false" inputType="text" width="70" displayMode="label" readOnly="true"></w2:column>
						<w2:column id="col2" removeBorderStyle="false" inputType="text" width="70" displayMode="label" readOnly="true"></w2:column>
						<w2:column id="col3" removeBorderStyle="false" width="70" inputType="text" displayMode="label" readOnly="true" colMerge="true"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
		<xf:group id="group2" style="height: 200px;">
			<w2:textbox label='disabled="true"' id="" style="width: 220px;height: 23px;font-size: 22px;"></w2:textbox>
			<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView2" style="width: 500px;height: 150px;">
				<w2:caption id="caption3" value="this is a grid caption."></w2:caption>
				<w2:header id="header3">
					<w2:row id="row5">
						<w2:column id="column13" removeBorderStyle="false" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
						<w2:column id="column11" removeBorderStyle="false" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
						<w2:column id="column9" removeBorderStyle="false" width="70" inputType="text" value="name3" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody3">
					<w2:row id="row6">
						<w2:column id="col1" removeBorderStyle="false" inputType="text" width="70" displayMode="label" disabled="true"></w2:column>
						<w2:column id="col2" removeBorderStyle="false" inputType="text" width="70" displayMode="label" disabled="true"></w2:column>
						<w2:column id="col3" removeBorderStyle="false" width="70" inputType="text" displayMode="label" disabled="true" colMerge="true"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
