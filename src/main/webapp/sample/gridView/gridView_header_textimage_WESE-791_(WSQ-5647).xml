<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list"
					saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1"
							dataType="text">
						</w2:column>
						<w2:column id="col2" name="name2"
							dataType="text">
						</w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list"
					saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col3" name="name3"
							dataType="text">
						</w2:column>
						<w2:column id="col4" name="name4"
							dataType="text">
						</w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
	var tmpArr = [{"col3":12,"col4":22},{"col3":33,"col4":124},{"col3":77,"col4":66},{"col3":88,"col4":99}];
	dataList1.setData([1, 2, 3, 4]);
	dataList2.setJSON( tmpArr );
	window.textImageClickLog = [];
};

scwin.gridView1_onheadertextimageclick = function (headerId, headerValue) {
	window.textImageClickLog.push("gridView1:" + headerId + ":" + headerValue);
	console.log(headerId, headerValue);
	var targetElement = document.querySelector(`[data-header_id=${headerId}]`);
	if (targetElement) {
		var tooltip = document.getElementById($p.id + "contextGroup");
		if (tooltip) {
			if (tooltip.style.display === "none") {
				var rect = targetElement.getBoundingClientRect();
				tooltip.innerHTML = headerValue;
				tooltip.style.top = rect.bottom + 'px';
				tooltip.style.left = rect.left + (rect.width / 2) - (tooltip.offsetWidth / 2) + 'px';
				tooltip.style.display = "flex";
			} else if (tooltip.style.display === "flex") {
				tooltip.style.display = "none";
			}
		}
	}
};

scwin.gridView2_onheadertextimageclick = function (headerId, headerValue) {
	window.textImageClickLog.push("gridView2:" + headerId + ":" + headerValue);
	console.log(headerId, headerValue);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" showSortableUseFilter="false"
			id="gridView1" style="position: relative;width: 700px;height: 150px;"
			fixedColumnWithHidden="true" useShiftKey="true"
			sortable="true" showSortableImage="true" sortEvent="onclick"
			ev:onheadertextimageclick="scwin.gridView1_onheadertextimageclick"
			>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" style="height:20px"
					width="270" displayMode="label"
					value="첫번 째 textImage"
					inputType="textImage" imageSrc="http://static.naver.net/green/v2/img/btn_security2_on.gif" imageStyle="width:14px;height:14px;border:1px solid red;border-radius:10px;margin-left:16px;" viewType="icon"
					>
					</w2:column>
					<w2:column id="column1" style="height:20px" width="270" inputType="text" displayMode="label"
					useFilter=""
						value="첫번 째 text">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px"
					inputType="text"
					width="270" displayMode="label">
					</w2:column>
					<w2:column id="col2" style="height:20px" width="270" displayMode="label"
						inputType="text"
						>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView dataList="dataList2" showSortableUseFilter="false"
			id="gridView2" style="position: relative;width: 700px;height: 150px;"
			fixedColumnWithHidden="true" useShiftKey="true"
			useFilterList="true"
			ev:onheadertextimageclick="scwin.gridView2_onheadertextimageclick"
			>
			<w2:header id="header2">
				<w2:row id="row2">
					<w2:column id="column4" style="height:20px"
					inputType="textImage" imageSrc="http://static.naver.net/green/v2/img/btn_security2_on.gif" imageHeight="10" imageWidth="10" viewType="icon"
					width="270" displayMode="label"
					value="두번 째 textImage"
					useFilter="true"
					>
					</w2:column>
					<w2:column id="column5" style="height:20px" width="270"
					inputType="textImage" imageSrc="http://static.naver.net/green/v2/img/btn_security2_on.gif" imageHeight="10" imageWidth="10" viewType="icon"
					displayMode="label"
					useFilter=""
						value="두번 째 text">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody12">
				<w2:row id="row23">
					<w2:column id="col3" style="height:20px"
					inputType="text"
					width="270" displayMode="label">
					</w2:column>
					<w2:column id="col4" style="height:20px" width="270" displayMode="label"
						inputType="textImage" imageSrc="http://static.naver.net/green/v2/img/btn_security2_on.gif" imageHeight="10" imageWidth="10" viewTypeIconImage="true" viewType="icon"
						>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:group id="contextGroup" style="position: absolute ;width:100px;height: 30px;z-index: 100;display:none;justify-content:center;align-items:center;background:black;color:white;">tooltip 내용</xf:group>
	</body>
</html>
