<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[scwin.onpageload = function () {
  var data = new Array(10000).fill(null).map(() => ({ col1: "1" }));

  for (var i = 0; i < data.length; i++) {
	data[i].col1 = String(i + 1); // 1,2,3,... 증가
  }

  dlt_dataList1.setJSON(data);
};]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="" style="width: 500px;height: 150px;" dataList="data:dlt_dataList1"
			useFilterList="true">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="165" inputType="text" id="column3" value="name1" displayMode="label" useFilter="true"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="165" inputType="text" id="col1" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
