<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var totRow = 200;
	var totCol = grid1.getTotalCol();
	var arr = [];
	for (var i = 0; i < totRow; i++) {
		for (var j = 0; j < totCol; j++) {
			arr.push("index_" + i + "_" + j);
		}
	}
	grid1.setData(arr);
	grid2.setData(arr);
};
scwin.trigger1_onclick = function(e) {
	grid1.advancedExcelDownload({
		fileName: 'test.xlsx',
		rowHeight: "24px",
		type: 1,
		useFooter: "false",
		useStyle: "true"
	});
};
scwin.trigger2_onclick = function(e) {
	grid2.advancedExcelDownload({
		fileName: 'test.xlsx',
		rowHeight: "24px",
		type: 1,
		useFooter: "false",
		useStyle: "true"
	});
};
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="width:146px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[grid1 download]]></xf:label>
		</xf:trigger>
		<w2:grid baseNode="vector" repeatNode="data/INFO" id="grid1" style="width: 500px;height: 400px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column19" style="height:20px;" inputType="text" width="55" value="header1" displayMode="label"/>
					<w2:column id="column17" style="height:20px;" inputType="text" width="57" displayMode="label"/>
					<w2:column id="column15" style="height:20px;" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column13" style="height:20px;" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column11" style="height:20px;" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column9" style="height:20px;" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column7" style="height:20px;" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column5" style="height:20px;" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column3" style="height:20px;" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column1" style="height:20px;" width="120" inputType="text" displayMode="label"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="column20" inputType="text" width="55" displayMode="label"/>
					<w2:column id="column18" inputType="text" width="57" displayMode="label"/>
					<w2:column id="column16" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column14" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column12" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column10" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column8" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column6" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column4" inputType="text" width="120" displayMode="label"/>
					<w2:column id="column2" width="120" inputType="text" displayMode="label"/>
				</w2:row>
			</w2:gBody>
		</w2:grid>
		<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width:146px;height:23px;" type="button">
			<xf:label><![CDATA[grid2 download]]></xf:label>
		</xf:trigger>
		<w2:grid baseNode="vector" fixedColumnWithHidden="true" id="grid2" repeatNode="data/INFO" style="width: 500px;height: 400px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="column19" inputType="text" style="height:20px;" value="header1" width="232" colSpan="3" rowSpan=""/>
					<w2:column displayMode="label" id="column13" inputType="text" style="height:20px;" width="120"/>
					<w2:column displayMode="label" id="column11" inputType="text" style="height:20px;" width="120"/>
					<w2:column displayMode="label" id="column9" inputType="text" style="height:20px;" width="120"/>
					<w2:column displayMode="label" id="column7" inputType="text" style="height:20px;" width="120"/>
					<w2:column displayMode="label" id="column5" inputType="text" style="height:20px;" width="120"/>
					<w2:column displayMode="label" id="column3" inputType="text" style="height:20px;" width="120"/>
					<w2:column displayMode="label" id="column1" inputType="text" style="height:20px;" width="120"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="column20" inputType="text" width="55" excelwidth="200"/>
					<w2:column displayMode="label" id="column18" inputType="text" width="57" excelwidth="200"/>
					<w2:column displayMode="label" id="column16" inputType="text" width="120" excelwidth="200"/>
					<w2:column displayMode="label" id="column14" inputType="text" width="120"/>
					<w2:column displayMode="label" id="column12" inputType="text" width="120"/>
					<w2:column displayMode="label" id="column10" inputType="text" width="120"/>
					<w2:column displayMode="label" id="column8" inputType="text" width="120"/>
					<w2:column displayMode="label" id="column6" inputType="text" width="120"/>
					<w2:column displayMode="label" id="column4" inputType="text" width="120"/>
					<w2:column displayMode="label" id="column2" inputType="text" width="120"/>
				</w2:row>
			</w2:gBody>
		</w2:grid>
	</body>
</html>
