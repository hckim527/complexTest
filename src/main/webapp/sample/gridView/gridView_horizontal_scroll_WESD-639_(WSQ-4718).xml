					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<xf:group style="position:absolute;width:500px;height:500px;left:2000px;top:0px;background-color:blue;"/>
		<xf:group style="position:absolute;width:500px;height:500px;top:2000px;left:0px;background-color:red;"/>
		<w2:gridView id="" style="width: 300px;height: 150px;" defaultCellHeight="20" dataList="dataList1">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column2" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column7" value="name4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column9" value="name5" displayMode="label"></w2:column>
