<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="number"></w2:column>
						<w2:column id="col2" name="name2" dataType="number"></w2:column>
						<w2:column id="col3" name="name3" dataType="number"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col2><![CDATA[0]]></col2>
							<col3><![CDATA[0]]></col3>
							<col4><![CDATA[0]]></col4>
						</w2:row>
						<w2:row>
							<col2><![CDATA[0]]></col2>
							<col3><![CDATA[0]]></col3>
							<col4><![CDATA[0]]></col4>
						</w2:row>
						<w2:row>
							<col2><![CDATA[0]]></col2>
							<col3><![CDATA[0]]></col3>
							<col4><![CDATA[0]]></col4>
						</w2:row>
						<w2:row>
							<col2><![CDATA[0]]></col2>
							<col3><![CDATA[0]]></col3>
							<col4><![CDATA[0]]></col4>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<w2:gridView dataList="data:dataList1" useFilterList="false"
			showSortableUseFilter="false" id="gridView1" style="position: relative;width: 500px;height: 150px;"
			fixedColumnWithHidden="true" useShiftKey="true"
			preventAddRowOnPaste="false" senseReader="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column10" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" style="height:20px" inputType="text" id="column5" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" style="height:20px" inputType="text" id="column3" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" style="height:20px" inputType="text" id="column1" value="name4" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="checkbox" style="height:20px" id="col1" displayMode="label" headers="gridView1_column10"></w2:column>
					<w2:column dataType="number" width="70" style="height:20px" inputType="text" id="col2" value="0" displayMode="label" headers="gridView1_column5"></w2:column>
					<w2:column dataType="number" width="70" style="height:20px" inputType="text" id="col3" value="0" displayMode="label" headers="gridView1_column3"></w2:column>
					<w2:column dataType="number" width="70" style="height:20px" inputType="textarea" id="col4" value="0" displayMode="label" headers="gridView1_column1"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
