<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="">
					<root>
						<ui>
							<vector>
								<vector_row>
									<col1>false</col1>
									<col2>1111</col2>
									<col3>1</col3>
								</vector_row>
								<vector_row>
									<col1>false</col1>
									<col2>2222</col2>
									<col3>2</col3>
								</vector_row>
								<vector_row>
									<col1>false</col1>
									<col2>3333</col2>
									<col3>2</col3>
								</vector_row>
								<vector_row>
									<col1>false</col1>
									<col2>4444</col2>
									<col3>1</col3>
								</vector_row>
								<vector_row>
									<col1>false</col1>
									<col2>5555</col2>
									<col3>2</col3>
								</vector_row>
							</vector>
						</ui>
					</root>
				</data>
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
};

scwin.trigger1_onclick = function(e) {
	grid1.setCellData(1, 1, "test data!!!");
};

// Row 0~4 의 col2 값과 col1(checkbox) 값을 Row 인덱스 기준으로 읽음
scwin.trigger2_onclick = function(e) {
	var col2 = [];
	var col1 = [];
	for (var i = 0; i < 5; i++) {
		col2.push(grid1.getCellData(i, 1));
		col1.push(grid1.getCellData(i, 0));
	}
	txa_result.setValue(JSON.stringify({ col2: col2, col1: col1 }));
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:grid ref="root/ui/vector" baseNode="vector" repeatNode="vector_row" id="grid1" style="width: 500px;height: 300px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column blockSelect="false" id="column5" inputType="text" width="120" value="chk" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="column3" inputType="text" width="120" value="drilldown" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="column1" inputType="text" width="120" value="depth" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column blockSelect="false" id="col1" inputType="checkbox" width="120" displayMode="label"></w2:column>
					<w2:column blockSelect="false" id="col2" inputType="drilldown" width="120" displayMode="label" depthType="div" depthColumn="col3" showDepth="1"></w2:column>
					<w2:column blockSelect="false" id="col3" inputType="text" width="120" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:grid>
		<xf:trigger type="button" id="trigger1" style="width: 100px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setCellData]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="width: 100px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[getCellData]]></xf:label>
		</xf:trigger>
		<xf:textarea id="txa_result" style="width: 500px;height: 60px;"></xf:textarea>
	</body>
</html>
