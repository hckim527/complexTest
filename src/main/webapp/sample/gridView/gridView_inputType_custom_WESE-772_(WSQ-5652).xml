<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="ID" name="ID" dataType="text"></w2:column>
						<w2:column id="Region" name="Region" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<ID><![CDATA[id]]></ID>
							<Region><![CDATA[20240122]]></Region>
						</w2:row>
						<w2:row>
							<ID><![CDATA[id2]]></ID>
							<Region><![CDATA[20231231]]></Region>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
};
scwin.trigger3_onclick = function (e) {
	gridview1.setDataType("Region", "date");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridview1" style="width: 90%;height: 200px;margin-left: 30px;" scrollByColumn="false" defaultCellHeight="20"
			dataList="data:dataList1" autoFit="allColumn" editModeEvent="ondblclick" keyMoveEditMode="true" focusMode="none"
			setCellInputTypeCustom="true">
			<w2:header id="header1">
				<w2:row style="height: 25px;" id="row1">
					<w2:column width="70" inputType="text" style="height:20px;" id="column17" value="ID"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px;" id="column5" value="Region"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row style="height: 12px;" id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="ID"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="Region" dataType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger3" style="width:99px;height:23px;" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[setDataType]]></xf:label>
		</xf:trigger>
