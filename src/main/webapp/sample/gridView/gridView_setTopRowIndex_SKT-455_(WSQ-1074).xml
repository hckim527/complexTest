<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridView1.setTopRowIndex(7);
};
scwin.trigger2_onclick = function(e) {
	gridView1.setGridHeight(100);
};
scwin.trigger3_onclick = function(e) {
	gridView1.setGridHeight(200);
};
scwin.checkVal = function() {
	return gridView1.getTopRowIndex() == 3;
}
scwin.onpageload = function() {
	window.G = 9;
	window.u = [];
	for (var i = 0; i < G * 3; i++) {
		u.push(i);
	}
	dataList1.setData(u);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1"
			rowNumVisible="true" style="position: relative;width:348px;height:200px;" useShiftKey="true" defaultCellHeight="27">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="column9" inputType="text" style="height:20px" value="name1"
						width="70">
					</w2:column>
					<w2:column displayMode="label" id="column7" inputType="text" style="height:20px" value="name2"
						width="70">
					</w2:column>
					<w2:column displayMode="label" id="column3" inputType="text" style="height:20px" value="name3"
						width="70">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column displayMode="label" id="col1" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayMode="label" id="col2" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayMode="label" id="col3" inputType="text" style="height:20px" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:200px;height:50px;margin-bottom:20px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setTopRowIndex(7);]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position: relative;width:200px;height:50px;margin-bottom:20px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[setGridHeight(100)]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger3" style="position: relative;width:200px;height:50px;" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[setGridHeight(200)]]></xf:label>
		</xf:trigger>
	</body>
</html>
 