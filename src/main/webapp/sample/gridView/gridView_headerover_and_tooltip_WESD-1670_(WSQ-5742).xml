<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><col1><![CDATA[1]]></col1><col2><![CDATA[1]]></col2><col3><![CDATA[2]]></col3></w2:row>
						<w2:row><col1><![CDATA[2]]></col1><col2><![CDATA[2]]></col2><col3><![CDATA[1]]></col3></w2:row>
						<w2:row><col1><![CDATA[3]]></col1><col2><![CDATA[3]]></col2><col3><![CDATA[3]]></col3></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.getHeaderTooltip = function() {
	return "text";
};
scwin.gridView1_onheadermouseover = function(info) {
	console.log("콜백 grid1 headerover호출");
};
scwin.gridView1_onheadermouseout = function(info) {
	console.log("콜백 grid1 headerout호출");
};
]]></script>
	</head>
	<body>
		<w2:gridView id="gridView1" style="margin-top:200px;width:500px;height:150px;" dataList="data:dataList1" defaultCellHeight="20"
			rowMouseOver="true" tooltipDisplay="true" tooltipFormatterHeader="scwin.getHeaderTooltip" tooltipHeader="true" tooltipHeaderShowAlways="true"
			ev:onheadermouseover="scwin.gridView1_onheadermouseover" ev:onheadermouseout="scwin.gridView1_onheadermouseout">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" width="120" inputType="text" value="name1" displayMode="label"></w2:column>
					<w2:column id="column2" width="120" inputType="text" value="name2" displayMode="label"></w2:column>
					<w2:column id="column3" width="120" inputType="text" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" width="120" inputType="text" displayMode="label"></w2:column>
					<w2:column id="col2" width="120" inputType="text" displayMode="label"></w2:column>
					<w2:column id="col3" width="120" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
