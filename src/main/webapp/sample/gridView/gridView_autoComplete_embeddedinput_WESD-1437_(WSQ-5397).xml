<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
	<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" repeatNode="map" keyNode="infoList" attributeMap="value"
					idAttribute="value">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{col1:"a",col2:"a",col3:"a"},{col1:"c",col3:"c"},{col1:"d",col3:"d"},{col1:"b",col3:"b"}];
	dataList1.setJSON(jsonData);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView autoFit="lastColumn" autoResizeEmbeddedInput="true" captionAuto="true" captionTitle="그리드 제목"
			dataList="data:dataList1" editModeEvent="onclick" fixedColumnWithHidden="true" focusMode="row" id="gridView4"
			keyMoveEditMode="true" overflowY="scroll" rowNumVisible="true"
			scrollFocus="true" senseReader="true" sortHeaderDiv="true" sortable="true"
			style="left:0px;top:0px;width:400px;height:200px;" titleAuto="true" useFilterList="true"
			useShiftKey="true" useStartEndDiv="true" visibleRowNum="20">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column1" inputType="text" value="name1" width="70"></w2:column>
					<w2:column id="column2" inputType="text" useFilter="true" value="name2" width="70"></w2:column>
					<w2:column id="column3" inputType="text" useFilter="true" value="name3" width="70"></w2:column>
					<w2:column displayMode="label" id="column4" inputType="text" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" inputType="text" width="70"></w2:column>
					<w2:column displayMode="label" id="col2" inputType="autoComplete" width="70" embeddedInput="true">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[a]]></w2:label>
								<w2:value><![CDATA[a]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[b]]></w2:label>
								<w2:value><![CDATA[b]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
					<w2:column displayMode="label" id="col3" inputType="link" width="70"></w2:column>
					<w2:column displayMode="label" id="col4" inputType="calendar" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>