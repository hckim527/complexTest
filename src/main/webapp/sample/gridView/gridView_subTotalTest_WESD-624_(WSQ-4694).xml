<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dtl_list0" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="sub1" name="서브토탈1" dataType="text"></w2:column>
						<w2:column id="sub2" name="서브토탈2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	// sub1 1~16, sub2 A~P(13·14 는 N·M)
	var s2 = "ABCDEFGHIJKLNMOP";
	scwin.dataList0 = [];
	for (var i = 0; i < 16; i++) {
		scwin.dataList0.push({ "sub1": String(i + 1), "sub2": s2.charAt(i) });
	}
};
scwin.btn_srch0_onclick = function(e) {
	if (rad_srchDivsCd0.getValue() == "A") {
		dtl_list0.setJSON(scwin.dataList0);
		grd_list0.show("");
	} else {
		grd_list0.hide();
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sh_btn" id="">
			<xf:select1 appearance="full" id="rad_srchDivsCd0" renderType="radiogroup" selectedIndex="0">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[A]]></xf:label>
						<xf:value><![CDATA[A]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[B]]></xf:label>
						<xf:value><![CDATA[B]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:select1>
			<xf:trigger class="btn_sh" ev:onclick="scwin.btn_srch0_onclick" id="btn_srch0" type="button">
				<xf:label><![CDATA[검색]]></xf:label>
			</xf:trigger>
		</xf:group>
		<w2:gridView id="grd_list0" style="height:326px;" defaultCellHeight="20" dataList="data:dtl_list0">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column1"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="sub1"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="sub2"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:subTotal targetColumnID="sub1" id="subTotal1">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column9"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column8"></w2:column>
				</w2:row>
			</w2:subTotal>
			<w2:subTotal targetColumnID="sub2" id="subTotal2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" style="height:20px" id="column12"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column11"></w2:column>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
	</body>
</html>
