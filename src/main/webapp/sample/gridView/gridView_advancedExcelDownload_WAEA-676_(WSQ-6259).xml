<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="float"/>
						<w2:column id="col3" name="name3" dataType="number"/>
						<w2:column id="col4" name="name4" dataType="number"/>
						<w2:column id="col5" name="name5" dataType="number"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{"col1":"대기업","col2":"4.46", "col3":"10000.7", "col4":"", "col5":"10000.789"}
		, {"col1":"대기업","col2":"5.44", "col3":"10000.78", "col4":"", "col5":"10000.789"}
		, {"col1":"대기업(주)테스트기업","col2":"6.235", "col3":"10000.789", "col4":"", "col5":"10000.789"}
		, {"col1":"중소기업", col2:"100000", "col3":"120000000.78965", "col4":"", "col5":"10000.789"}
		, {"col1":"중소기업", col2:"200000", "col3":"10000.78964", "col4":"", "col5":"10000.789"}
		, {"col1":"중소기업", col2:"900000", "col3":"10000.7896", "col4":"", "col5":"123450000.789"}]
	dataList1.setJSON(jsonData);

	gridView1.setCellClass(1,2, "test2");
};

scwin.trigger1_onclick = function(e) {
	var options = {
		fileName : "excelDownload_test.xlsx",
		type : "1"
		,autoSizeColumn : "true"
		,useStyle:"true"
		,useClass:"true"
		,useSubTotal:"true"
		,useSubTotalData : "true"
		,useFooter:"true"
		//,useFooterData : "true"
		,excelFooterEmptyToZero : "true"
	}
	options.useXHR = "true";

	var infoArr = [];
	gridView1.advancedExcelDownload( options, infoArr );
};
		]]></script>
		<style type="text/css"><![CDATA[
			.test1 { color:red; }
			.test2 { color:blue; }
		]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[excelDown1]]></xf:label>
		</xf:trigger>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" readOnly="true" style="width:800px;height:198px;" tooltipSec="0" dataList="data:dataList1" autoFit="allColumn">
			<w2:caption id="caption2" value="this is a grid caption."/>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="119" inputType="text" style="height:20px" id="column7" value="name1" displayMode="label"/>
					<w2:column width="117" inputType="text" style="height:20px" id="column6" value="float" displayMode="label"/>
					<w2:column width="113" inputType="text" style="height:20px" id="column5" value="data+grid" displayMode="label"/>
					<w2:column width="115" inputType="text" style="height:20px" id="column4" value="displyFormat" displayMode="label"/>
					<w2:column width="128" inputType="text" style="height:20px" id="column3" value="excelFormat" displayMode="label"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="119" inputType="text" style="height:20px" id="col1" displayMode="label"/>
					<w2:column width="117" inputType="text" style="height:20px" id="col2" displayFormat="#,##0.00" dataType="float" excelCellType="float" displayMode="label"/>
					<w2:column width="113" inputType="text" style="height:20px" id="col3" dataType="number" displayFormat="#,##0.0###" excelFormat="#,##0.0###" displayMode="label" class="test1"/>
					<w2:column width="115" inputType="text" style="height:20px" id="col4" displayFormat="#,##0.0###" displayMode="label"/>
					<w2:column width="128" inputType="text" style="height:20px" id="col5" excelFormat="#,##0.0###" displayMode="label"/>
				</w2:row>
			</w2:gBody>
			<w2:subTotal targetColumnID="col1" id="subTotal1">
				<w2:row id="row5">
					<w2:column width="119" inputType="text" style="height:20px" id="column17" displayMode="label"/>
					<w2:column width="117" inputType="expression" expression="SUM('col2')" style="height:20px" id="column16" displayMode="label" displayFormat="#,##0.00" dataType="float" excelCellType="float"/>
					<w2:column width="113" inputType="expression" expression="SUM('col3')" displayFormat="#,##0" dataType="number" style="height:20px" id="column15" displayMode="label"/>
					<w2:column width="115" inputType="expression" expression="SUM('col4')" displayFormat="#,##0" dataType="number" style="height:20px" id="column14" displayMode="label"/>
					<w2:column width="128" inputType="expression" expression="SUM('col5')" displayFormat="#,##0" dataType="number" style="height:20px" id="column13" displayMode="label"/>
				</w2:row>
			</w2:subTotal>
			<w2:footer id="footer1">
				<w2:row id="row6">
					<w2:column width="119" inputType="text" style="height:20px" id="column22" displayMode="label"/>
					<w2:column width="117" inputType="expression" expression="SUM('col2')" style="height:20px" id="column21" displayMode="label" displayFormat="#,##0.00" dataType="float" excelCellType="float"/>
					<w2:column width="113" inputType="expression" expression="SUM('col3')" displayFormat="#,##0" dataType="number" style="height:20px" id="column20" displayMode="label"/>
					<w2:column width="115" inputType="expression" expression="SUM('col4')" displayFormat="#,##0" dataType="number" style="height:20px" id="column19" displayMode="label"/>
					<w2:column width="128" inputType="expression" expression="SUM('col5')" displayFormat="#,##0" dataType="number" style="height:20px" id="column18" displayMode="label"/>
				</w2:row>
			</w2:footer>
		</w2:gridView>
	</body>
</html>
