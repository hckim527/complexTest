<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.gridView1_oncontextopen = function(row, col) {
	return {
		hideSystemMenu: ["ColumnHide"],
		appendMenu: [{
			label: "특별한 컬럼 숨기기",
			userMenuId: "userColumnHide",
			className: "userMenu"
		}]
	};
};
scwin.__triggerMouse = function(id) {
	var node = document.getElementById($p.id + id);
	var evt = document.createEvent('MouseEvents');
	evt.initEvent('contextmenu', true, false);
	node.dispatchEvent(evt);
};
scwin.__isShowContextMenu = function() {
	var rows = $('#mf_gridView1_contextMenu_list').find(".w2list_listRow");
	return rows.length == 6;
};
scwin.__notErrorLog = function() {
	var err = WebSquare.logger.getErrorLog();
	return (err != "") ? true : false;
};
scwin.onpageload = function() {
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" scrollByColumn="false" id="gridView1" style="width: 500px;height: 150px;" fixedColumnWithHidden="true"
			useShiftKey="true" contextMenu="true" focusMode="row" ev:oncontextopen="scwin.gridView1_oncontextopen" useHeaderContextMenu="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column9" style="height:20px" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column7" style="height:20px" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column3" style="height:20px" inputType="text" width="70" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col3" style="height:20px" inputType="text" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
