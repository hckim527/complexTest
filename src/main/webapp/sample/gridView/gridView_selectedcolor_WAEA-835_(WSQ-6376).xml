<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dl1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
						<w2:column id="col10" name="name10" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[

scwin.btn1_onclick = function (e) {
	const rows = ib1.getValue();
	const cols = 10;

	const data = Array.from({ length: rows }, (_, r) => {
		const rowNum = r + 1;
		let rowObj = {};

		rowObj['col1'] = String(Math.min((r % 10) + 1, 3));
		rowObj['col2'] = Math.trunc(r / 10).toString();
		rowObj['col3'] = 1;

		for (let c = 4; c <= cols; c++) {
			rowObj[`col${c}`] = `row${rowNum}_col${c}`;
		}

		return rowObj;
	});

	dl1.setJSON(data, false);
};

scwin.button1_onclick = function (e) {
	gv1.setMultiFocus([{startRow:4, startCol:1, endRow:5, endCol:2}, {row:1, col:1}]);
};

scwin.button2_onclick = function (e) {
	gv1.removeMultiFocus([{row:4, col:2}]);
};

scwin.button3_onclick = function (e) {
	alert(JSON.stringify(gv1.getAllFocusedIndex(), null, 2));
};
]]></script>
	</head>
	<body>
		<w2:gridView checkAllType="false" id="gv1" style="width:500px;height:247px;" dataList="data:dl1" rowNumVisible="true" rowStatusVisible="true" sortable="true" applyColumnClass="true" focusMode="both" selectedCellOverColor="" selectedRowColor="green" selectedRowOverColor="" readOnlyBackgroundColor="black" disabledBackgroundColor="red" rowMouseOver="true" rowNumRowMouseOverColor="false" rowNumBackgroundColor="" class="">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column10" value="name1"></w2:column>
					<w2:column width="70" inputType="text" id="column9" value="name2" useFilter="true"></w2:column>
					<w2:column width="70" inputType="text" id="column8" value="name3"></w2:column>
					<w2:column width="70" inputType="text" id="column7" value="name4"></w2:column>
					<w2:column width="70" inputType="text" id="column6" value="name5"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="name6"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name7"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name8"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value="name9"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="name10"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="drilldown" id="col1" depthColumn="col1"></w2:column>
					<w2:column width="70" inputType="text" id="col2"></w2:column>
					<w2:column width="70" inputType="checkbox" id="col3" applyFormat=""></w2:column>
					<w2:column width="70" inputType="text" id="col4"></w2:column>
					<w2:column width="70" inputType="select" id="col5" class="mytest01">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[1]]></w2:label>
								<w2:value><![CDATA[1]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[2]]></w2:label>
								<w2:value><![CDATA[2]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="text" id="col6"></w2:column>
					<w2:column width="70" inputType="text" id="col7"></w2:column>
					<w2:column width="70" inputType="text" id="col8"></w2:column>
					<w2:column width="70" inputType="text" id="col9"></w2:column>
					<w2:column width="70" inputType="text" id="col10"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column width="70" inputType="expression" id="column20" expression="sum('col1')" displayMode=""></w2:column>
					<w2:column width="70" inputType="text" id="column19"></w2:column>
					<w2:column width="70" inputType="text" id="column18"></w2:column>
					<w2:column width="70" inputType="text" id="column17"></w2:column>
					<w2:column width="70" inputType="text" id="column16"></w2:column>
					<w2:column width="70" inputType="text" id="column15"></w2:column>
					<w2:column width="70" inputType="text" id="column14"></w2:column>
					<w2:column width="70" inputType="text" id="column13"></w2:column>
					<w2:column width="70" inputType="text" id="column12"></w2:column>
					<w2:column width="70" inputType="text" id="column11"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
		<xf:group id="" style="width:600px;height:5px;"></xf:group>
		<xf:input id="ib1" style="width: 100px;height: 30px;" initValue="10"></xf:input>
		<w2:button style="width: 80px;height: 30px;" id="btn1" ev:onclick="scwin.btn1_onclick" label="load data"></w2:button>
		<w2:button ev:onclick="scwin.button1_onclick" id="button1" label="focus" style="width: 80px;height: 30px;"></w2:button>
		<w2:button ev:onclick="scwin.button2_onclick" id="button2" label="unfocus" style="width: 80px;height: 30px;"></w2:button>
		<w2:button ev:onclick="scwin.button3_onclick" id="button3" label="check" style="width: 80px;height: 30px;"></w2:button>
	</body>
</html>
