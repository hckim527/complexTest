<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.fmtCnt = 0;
scwin.onpageload = function() {
    var jsonData = [{
        "col1": "1",
        "col2": "2"
    }, {
        "col1": "3",
        "col2": "4"
    }, {
        "col1": "a",
        "col2": "b"
    }, {
        "col1": "c",
        "col2": "d"
    }];
    dataList1.setJSON(jsonData);
};
scwin.setFormatFunc = function(data, formattedData, rowIndex, colIndex) {
    if (data == "1") {
        grid1.setCellReadOnly(3, "col1", true);
    } else {
        grid1.setCellDisabled(2, "col1", true);
    }
    scwin.fmtCnt++;
    return formattedData;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="grid1" style="width: 500px;height: 150px;" defaultCellHeight="20"
			dataList="data:dataList1">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="140" inputType="text" style="height:20px;" id="column4" value="name1"
						displayMode="label">
					</w2:column>
					<w2:column width="140" inputType="text" style="height:20px;" id="column5" value="name2"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="156" inputType="text" style="height:20px" id="col1"
						displayMode="label" customFormatter="scwin.setFormatFunc">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
