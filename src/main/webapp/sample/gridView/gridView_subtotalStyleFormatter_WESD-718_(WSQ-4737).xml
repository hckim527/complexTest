<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="number"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
						<w2:column id="col10" name="name10" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<style>
			.w2subtotalplus {
				color : red;
			}
			.w2subtotalminus {
				color : blue;
			}
		</style>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.onpageload = function() {
	// 5 Row 씩 col1 이 같은 50 Row × 10 Column
	var data = [];
	for (var i = 0; i < 50; i++) {
		for (var j = 0; j < 10; j++) {
			var t = Math.floor(i / 5);
			data.push(t * 100 + j * (t + 1));
		}
	}
	dataList1.setData(data);
};
scwin.gridView1_subtotalStyleFormatter = function(value, formattedValue) {
	if (value === 0 || !value) {
		return;
	}
	if (value > 0) {
		return "w2subtotalplus";
	} else {
		return "w2subtotalminus";
	}
};
scwin.checkVal = function() {
	var className1 = scwin.__getDom($p.id + 'gridView1_body_tbody').children[20].children[6].className;
	var className2 = scwin.__getDom($p.id + 'gridView1_body_tbody').children[21].children[3].className;
	return className1.indexOf("w2subtotalplus") > 0 && className2.indexOf("w2subtotalminus") > 0;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" rowNumVisible="true" style="width:843px;height:700px;" subtotalStyleFormatter="scwin.gridView1_subtotalStyleFormatter">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column21" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column19" inputType="text" width="70" value="name2" rowSpan="2"></w2:column>
					<w2:column id="column17" inputType="text" width="70" value="name3" rowSpan="2"></w2:column>
					<w2:column id="column15" inputType="text" width="70" value="name4"></w2:column>
					<w2:column id="column13" inputType="text" width="141" value="name5"></w2:column>
					<w2:column id="column11" inputType="text" width="70" value="name6"></w2:column>
				</w2:row>
				<w2:row id="row4">
					<w2:column id="column9" inputType="text" width="70" value="name7"></w2:column>
					<w2:column id="column7" inputType="text" width="70" value="name8"></w2:column>
					<w2:column id="column5" inputType="text" width="70" value="name9"></w2:column>
					<w2:column id="column3" width="70" inputType="text" value="name10"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row44">
					<w2:column id="col1" inputType="text" width="70"></w2:column>
					<w2:column id="col2" inputType="text" width="70" rowspan='2'></w2:column>
					<w2:column id="col3" inputType="text" width="70" rowspan='2'></w2:column>
					<w2:column id="col4" inputType="text" width="70"></w2:column>
					<w2:column id="col5" inputType="text" width="141"></w2:column>
					<w2:column id="col6" inputType="text" width="70"></w2:column>
				</w2:row>
				<w2:row id="row54">
					<w2:column id="col7" inputType="text" width="70"></w2:column>
					<w2:column id="col8" inputType="text" width="70"></w2:column>
					<w2:column id="col9" inputType="text" width="70"></w2:column>
					<w2:column id="col10" inputType="text" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal1" targetColumnID="col1">
				<w2:row id="row552">
					<w2:column id="column32" width="70" inputType="text"></w2:column>
					<w2:column id="column31" width="70" inputType="text" rowSpan="2" embeddedInput=""></w2:column>
					<w2:column id="column55" inputType="text" width="70" rowSpan="2"></w2:column>
					<w2:column id="column30" width="70" inputType="text"></w2:column>
					<w2:column id="column29" width="70" inputType="text"></w2:column>
					<w2:column id="column28" width="141" inputType="expression" expression="sum('col6') + sum('col10')" displayFormat="0###,###,###,###"></w2:column>
				</w2:row>
				<w2:row id="row551">
					<w2:column id="column26" width="70" inputType="text"></w2:column>
					<w2:column id="column25" width="70" inputType="text"></w2:column>
					<w2:column id="column24" width="70" inputType="text"></w2:column>
					<w2:column id="column23" width="70" inputType="expression" expression="sum('col6') - sum('col10')"></w2:column>
				</w2:row>
			</w2:subTotal>
			<w2:footer id="footer1">
				<w2:row id="row553">
					<w2:column width="70" inputType="text" style="height:20px" id="column61"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column60"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column59"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column58"></w2:column>
					<w2:column width="141" inputType="text" style="height:20px" id="column57"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column56"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
	</body>
</html>
