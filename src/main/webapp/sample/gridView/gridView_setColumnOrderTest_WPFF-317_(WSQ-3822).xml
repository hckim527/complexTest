<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="sampleList" saveRemovedData="true" repeatNode="sampleData" valueAttribute="">
					<w2:columnInfo>
						<w2:column id="sampleCol0" name="sampleCol0" dataType="text"></w2:column>
						<w2:column id="sampleCol1" name="sampleCol1" dataType="text"></w2:column>
						<w2:column id="sampleCol2" name="sampleCol2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data xmlns="" use="true">
						<w2:row>
							<sampleCol0><![CDATA[data0_0]]></sampleCol0>
							<sampleCol1><![CDATA[data0_1]]></sampleCol1>
							<sampleCol2><![CDATA[data0_2]]></sampleCol2>
						</w2:row>
						<w2:row>
							<sampleCol0><![CDATA[data1_0]]></sampleCol0>
							<sampleCol1><![CDATA[data1_1]]></sampleCol1>
							<sampleCol2><![CDATA[data1_2]]></sampleCol2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	grd_gridView.setColumnOrder([0, 1, 2])
};
]]></script>
	</head>
	<body>
		<w2:gridView dataList="dataList1" scrollByColumn="false" id="grd_gridView" style="position: relative;width: 500px;height: 150px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" style="height:20px" inputType="text" width="70" value="sampleCol0"></w2:column>
					<w2:column id="column3" style="height:20px" inputType="text" width="70" value="sampleCol1"></w2:column>
					<w2:column id="column1" style="height:20px" width="70" inputType="text" value="sampleCol2"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="sampleCol0" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="sampleCol1" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="sampleCol2" style="height:20px" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal1" targetColumnID="">
				<w2:row id="row3">
					<w2:column id="column8" style="height:20px;" width="140" inputType="text" colSpan="2" rowSpan=""></w2:column>
					<w2:column id="column6" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:194px;height:57px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setColumnOrder]]></xf:label>
		</xf:trigger>
	</body>
</html>
