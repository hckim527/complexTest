<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
        "col1": "col1",
        "col2": "col2",
        "col3": "col3",
        "col4": "0"
    }, {
        "col1": "col4",
        "col2": "col5",
        "col3": "col6",
        "col4": "0"
    }, {
        "col1": "col7",
        "col2": "col8",
        "col3": "col9",
        "col4": "0"
    }, {
        "col1": "col10",
        "col2": "col12",
        "col3": "col13",
        "col4": "0"
    }]
    dataList1.setJSON(jsonData);
};
scwin.trigger1_onclick = function() {
    var cellInfo = gridView1.getCellInfo(1);
    if (cellInfo.options.blockSelect === true) {
        gridView1.setBlockSelect(1, false);
    } else {
        gridView1.setBlockSelect(1, true);
    }
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group>
			<w2:gridView id="gridView1" style="width:491px;height:198px;" defaultCellHeight="20"
				dataList="data:dataList1" rowNumVisible="true" preventDuplicateFocusedCell="true" focusFlow="linear" dataDragSelect="true" useShiftKey="true">
				<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
				<w2:header id="header2">
					<w2:row id="row3">
						<w2:column width="70" inputType="text" style="height:20px" id="column6" value="name1"
							displayMode="label">
						</w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name2"
							displayMode="label">
						</w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name3"
							displayMode="label">
						</w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name4"
							displayMode="label">
						</w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody2">
					<w2:row id="row4">
						<w2:column width="70" inputType="text" style="height:20px" id="col1"
							displayMode="label">
						</w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col2"
							displayMode="label">
						</w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col3"
							displayMode="label">
						</w2:column>
						<w2:column width="70" inputType="checkbox" style="height:20px" id="col4"
							displayMode="label" checkboxLabel="Label">
						</w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
		<xf:group>
			<xf:trigger type="button" style="width: 180px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[col2 setBlockSelect toggle]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
