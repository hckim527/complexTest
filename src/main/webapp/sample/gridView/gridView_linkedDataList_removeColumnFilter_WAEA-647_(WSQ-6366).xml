<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_org" repeatNode="map">
					<w2:columnInfo>
						<w2:column dataType="text" id="cat1" name="category1"></w2:column>
						<w2:column dataType="text" id="cat2" name="category2"></w2:column>
						<w2:column dataType="text" id="label" name="display"></w2:column>
						<w2:column dataType="text" id="value" name="code"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<cat1><![CDATA[A]]></cat1>
							<cat2><![CDATA[A1]]></cat2>
							<label><![CDATA[A-A1-1]]></label>
							<value><![CDATA[AA11]]></value>
						</w2:row>
						<w2:row>
							<cat1><![CDATA[A]]></cat1>
							<cat2><![CDATA[A1]]></cat2>
							<label><![CDATA[A-A1-2]]></label>
							<value><![CDATA[AA12]]></value>
						</w2:row>
						<w2:row>
							<cat1><![CDATA[A]]></cat1>
							<cat2><![CDATA[A2]]></cat2>
							<label><![CDATA[A-A2-1]]></label>
							<value><![CDATA[AA21]]></value>
						</w2:row>
						<w2:row>
							<cat1><![CDATA[A]]></cat1>
							<cat2><![CDATA[A2]]></cat2>
							<label><![CDATA[A-A2-2]]></label>
							<value><![CDATA[AA22]]></value>
						</w2:row>
						<w2:row>
							<cat1><![CDATA[B]]></cat1>
							<cat2><![CDATA[B1]]></cat2>
							<label><![CDATA[B-B1-1]]></label>
							<value><![CDATA[BB11]]></value>
						</w2:row>
						<w2:row>
							<cat1><![CDATA[B]]></cat1>
							<cat2><![CDATA[B1]]></cat2>
							<label><![CDATA[B-B1-2]]></label>
							<value><![CDATA[BB12]]></value>
						</w2:row>
						<w2:row>
							<cat1><![CDATA[B]]></cat1>
							<cat2><![CDATA[B2]]></cat2>
							<label><![CDATA[B-B2-1]]></label>
							<value><![CDATA[BB21]]></value>
						</w2:row>
						<w2:row>
							<cat1><![CDATA[B]]></cat1>
							<cat2><![CDATA[B2]]></cat2>
							<label><![CDATA[B-B2-2]]></label>
							<value><![CDATA[BB22]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:linkedDataList bind="dlt_org" id="target1">
					<w2:condition type="filter"><![CDATA[cat1==ref('data:dlt_org.cat1')]]></w2:condition>
					<w2:condition type="sort"><![CDATA[]]></w2:condition>
				</w2:linkedDataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	dlt_org.setRowPosition(0);
};

scwin.btn_linkFilter_onclick = function (e) {
	target1.setColumnFilter({type:"row", colIndex:1, key:"A1", condition:"and"});
};

scwin.btn_removeColumnFilter_onclick = function (e) {
	target1.removeColumnFilter(1);
};

]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:dlt_org" id="gridView1" rowStatusVisible="true" sortable="true"
			style="width:500px; height:350px;" focusMode="row" syncRowPositionOption="style">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column4" value="cat1"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="cat2"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value="label"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="value"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="cat1"></w2:column>
					<w2:column width="70" inputType="text" id="cat2"></w2:column>
					<w2:column width="70" inputType="text" id="label"></w2:column>
					<w2:column width="70" inputType="text" id="value"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView autoFit="allColumn" checkAllType="false" dataList="data:target1" id="gridView2" rowStatusVisible="true" sortable="true"
			style="width:500px; height:300px;" focusMode="row" syncRowPositionOption="style">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column4" value="cat1"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="cat2"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value="label"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="value"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="cat1"></w2:column>
					<w2:column width="70" inputType="text" id="cat2"></w2:column>
					<w2:column width="70" inputType="text" id="label"></w2:column>
					<w2:column width="70" inputType="text" id="value"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:button id="btn_linkFilter" label="link filter" style="width:100px;height:39px;" ev:onclick="scwin.btn_linkFilter_onclick"></w2:button>
		<w2:button ev:onclick="scwin.btn_removeColumnFilter_onclick" style="width:142px;height:39px;" id="btn_removeColumnFilter" label="remove link filter"></w2:button>
	</body>
</html>
