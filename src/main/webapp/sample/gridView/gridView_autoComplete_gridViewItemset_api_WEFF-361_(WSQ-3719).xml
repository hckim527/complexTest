<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList3" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList4" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="c1" name="select" dataType="text"></w2:column>
						<w2:column id="c2" name="autoComplete" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<c1><![CDATA[_V_:1]]></c1>
							<c2><![CDATA[_V_:2]]></c2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
	var data1 = [];
	var data2 = [];
	var data3 = [];
	var row = 10;
	var col = 3;
	for (var i = 0; i < row; i++) {
		for (var j = 0; j < col; j++) {
			if (j === 0) {
				data1.push("label=" + String(i));
				data2.push("L=" + String(i));
				data3.push("_L_:" + String(i));
			} else if (j === 1) {
				data1.push("value=" + String(i));
				data2.push("V=" + String(i));
				data3.push("_V_:" + String(i));
			} else {
				data1.push("dummy=" + String(i));
				data2.push("D=" + String(i));
				data3.push("_d_:" + String(i));
			}
		}
	}
	dataList1.setData(data1);
	dataList2.setData(data2);
	dataList3.setData(data3);
};
scwin.getObj = function() {
	return {
		"nodeset": "data:dataList3",
		"label": "col1",
		"value": "col2",
		"width": 400,
		"height": 300,
		"visibleRowNum": 10,
		"item": [{ "ref": "col1", "header": "NLabel" }, { "ref": "col2", "header": "NValue" }, { "ref": "col3", "header": "NDummy" }]
	};
};
scwin.trigger2_onclick = function(e) {
	selectbox1.setGridItemset(scwin.getObj());
};
// 요건 보강: autoComplete·gridView(select/autoComplete 컬럼) 동적 gridViewItemset
scwin.trigger3_onclick = function(e) {
	autoComplete1.setGridItemset(scwin.getObj());
	gridView1.setColumnGridItemset(0, scwin.getObj());
	gridView1.setColumnGridItemset(1, scwin.getObj());
};
scwin.onpageload = function() {
	scwin.init();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="group1" style="height:42px;">
			<w2:autoComplete id="autoComplete1" style="height:40px;width:200px;" search="start" visibleRowNum="10" displayMode="label" editType="select" submenuSize="auto">
				<w2:choices>
					<w2:gridViewItemset autoFit="" height="200" selectedRowColor="" rowMouseOver="" visibleRowNum="" nodeset="data:dataList1" width="300" value="col2" label="col1" rowMouseOverColor="" hideHeader="">
						<w2:item ref="col1" style="" hidden="" headerStyle="" header="label"></w2:item>
						<w2:item ref="col2" style="" hidden="" headerStyle="" header="value"></w2:item>
						<w2:item ref="col3" style="" hidden="" headerStyle="" header="dummy"></w2:item>
					</w2:gridViewItemset>
				</w2:choices>
			</w2:autoComplete>
			<xf:select1 id="selectbox1" disabledClass="w2selectbox_disabled" appearance="minimal" style="height:40px;width:200px;" direction="auto" displayMode="label" submenuSize="auto">
				<xf:choices>
					<w2:gridViewItemset autoFit="" height="200" selectedRowColor="" rowMouseOver="" visibleRowNum="10" nodeset="data:dataList2" width="300" value="col2" label="col1" rowMouseOverColor="" hideHeader="">
						<w2:item ref="col2" style="" hidden="" headerStyle="" header="value"></w2:item>
						<w2:item ref="col1" style="" hidden="" headerStyle="" header="label"></w2:item>
						<w2:item ref="col3" style="" hidden="" headerStyle="" header="dummy"></w2:item>
					</w2:gridViewItemset>
				</xf:choices>
			</xf:select1>
		</xf:group>
		<xf:trigger id="trigger2" style="height:40px;width:200px;" type="button" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[setGridItemset]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger3" style="height:40px;width:300px;" type="button" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[autoComplete·gridView setGridItemset]]></xf:label>
		</xf:trigger>
		<w2:gridView id="gridView1" dataList="data:dataList4" style="width:400px;height:100px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" inputType="text" width="150" value="select"></w2:column>
					<w2:column id="column2" inputType="text" width="150" value="autoComplete"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="c1" inputType="select" width="150" displayMode="label">
						<w2:choices>
							<w2:gridViewItemset autoFit="" height="200" selectedRowColor="" rowMouseOver="" visibleRowNum="" nodeset="data:dataList1" width="300" value="col2" label="col1" rowMouseOverColor="" hideHeader="">
								<w2:item ref="col1" header="label"></w2:item>
								<w2:item ref="col2" header="value"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
					<w2:column id="c2" inputType="autoComplete" width="150" displayMode="label">
						<w2:choices>
							<w2:gridViewItemset autoFit="" height="200" selectedRowColor="" rowMouseOver="" visibleRowNum="" nodeset="data:dataList1" width="300" value="col2" label="col1" rowMouseOverColor="" hideHeader="">
								<w2:item ref="col1" header="label"></w2:item>
								<w2:item ref="col2" header="value"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
