<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
    xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
        <w2:type>DEFAULT</w2:type>
        <w2:buildDate />
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
                	<w2:columnInfo>
                		<w2:column id="col1" name="name1" dataType="text"></w2:column>
                		<w2:column id="col2" name="name2" dataType="text"></w2:column>
                		<w2:column id="col3" name="name3" dataType="text"></w2:column>
                		<w2:column id="col4" name="name4" dataType="text"></w2:column>
                		<w2:column id="col5" name="name5" dataType="number"></w2:column>
                		<w2:column id="col6" name="name6" dataType="text"></w2:column>
                		<w2:column id="col7" name="name7" dataType="text"></w2:column>
                		<w2:column id="col8" name="name8" dataType="text"></w2:column>
                		<w2:column id="col9" name="name9" dataType="text"></w2:column>
                		<w2:column id="col10" name="name10" dataType="text"></w2:column>
                	</w2:columnInfo>
                </w2:dataList>
            </w2:dataCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
// 원본 정적 데이터 226행과 동일 값 생성: col1 은 구간별 값(subtotal 경계), 나머지는 행번호 i 기준 규칙값
scwin.onpageload = function() {
    var runs = [[12,14],[13,2],[78,16],[13,11],[77,17],[13,3],[22,13],[13,36],[14,13],[15,9],[20,16],[15,23],[19,11],[15,9],[18,11],[15,7],[16,9],[17,6]];
    var data = [];
    var i = 0;
    for (var r = 0; r < runs.length; r++) {
        for (var k = 0; k < runs[r][1]; k++) {
            i++;
            data.push({ col1: String(runs[r][0]), col2: "제품" + i, col3: "방" + i, col4: String(11 + i), col5: String(33 + i),
                col6: String(59 + 2 * i), col7: String(76 + i), col8: String(80 + i), col9: String(94 + 2 * i), col10: String(12 + 2 * i) });
        }
    }
    dataList1.setJSON(data);
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
        <w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="width:843px;height:200px;margin-top:25px;margin-left:10px;" visibleRowNum="10">
        	<w2:header id="header2">
        		<w2:row id="row3">
        			<w2:column id="column21" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
        			<w2:column id="column19" inputType="text" width="70" value="name2" displayMode="label" rowSpan="2"></w2:column>
        			<w2:column id="column17" inputType="text" width="70" value="name3" displayMode="label" rowSpan="2"></w2:column>
        			<w2:column id="column15" inputType="text" width="70" value="name4" displayMode="label"></w2:column>
        			<w2:column id="column13" inputType="text" width="141" value="name5" displayMode="label"></w2:column>
        			<w2:column id="column11" inputType="text" width="70" value="name6" displayMode="label"></w2:column>
        		</w2:row>
        		<w2:row id="row4">
        			<w2:column id="column9" inputType="text" width="70" value="name7" displayMode="label"></w2:column>
        			<w2:column id="column7" inputType="text" width="70" value="name8" displayMode="label"></w2:column>
        			<w2:column id="column5" inputType="text" width="70" value="name9" displayMode="label"></w2:column>
        			<w2:column id="column3" width="70" inputType="text" value="name10" displayMode="label"></w2:column>
        		</w2:row>
        	</w2:header>
        	<w2:gBody id="gBody2">
        		<w2:row id="row44">
        			<w2:column id="col1" inputType="text" width="70" displayMode="label"></w2:column>
        			<w2:column id="col2" inputType="text" width="70" displayMode="label" rowspan='2'></w2:column>
        			<w2:column id="col3" inputType="text" width="70" displayMode="label" rowspan='2'></w2:column>
        			<w2:column id="col4" inputType="text" width="70" displayMode="label"></w2:column>
        			<w2:column id="col5" inputType="text" width="141" displayMode="label"></w2:column>
        			<w2:column id="col6" inputType="text" width="70" displayMode="label"></w2:column>
        		</w2:row>
        		<w2:row id="row54">
        			<w2:column id="col7" inputType="text" width="70" displayMode="label"></w2:column>
        			<w2:column id="col8" inputType="text" width="70" displayMode="label"></w2:column>
        			<w2:column id="col9" inputType="text" width="70" displayMode="label"></w2:column>
        			<w2:column id="col10" inputType="text" width="70" displayMode="label"></w2:column>
        		</w2:row>
        	</w2:gBody>
        	<w2:subTotal id="subTotal1" targetColumnID="col1">
        		<w2:row id="row552">
        			<w2:column id="column32" width="70" inputType="text" displayMode="label"></w2:column>
        			<w2:column id="column31" width="70" inputType="text" displayMode="label" rowSpan="2"></w2:column>
        			<w2:column id="column55" inputType="text" width="70" displayMode="label" rowSpan="2"></w2:column>
        			<w2:column id="column30" width="70" inputType="text" displayMode="label"></w2:column>
        			<w2:column id="column29" width="70" inputType="text" displayMode="label"></w2:column>
        			<w2:column id="column28" width="141" inputType="expression" displayMode="label" expression="sum('col6')" displayFormat="###,###,###,###"></w2:column>
        		</w2:row>
        		<w2:row id="row551">
        			<w2:column id="column26" width="70" inputType="text" displayMode="label"></w2:column>
        			<w2:column id="column25" width="70" inputType="text" displayMode="label"></w2:column>
        			<w2:column id="column24" width="70" inputType="text" displayMode="label"></w2:column>
        			<w2:column id="column23" width="70" inputType="text" displayMode="label"></w2:column>
        		</w2:row>
        	</w2:subTotal>
        	<w2:footer id="footer1">
        		<w2:row id="row553">
        			<w2:column width="70" inputType="text" style="height:20px" id="column61" displayMode="label"></w2:column>
        			<w2:column width="70" inputType="text" style="height:20px" id="column60" displayMode="label"></w2:column>
        			<w2:column width="70" inputType="text" style="height:20px" id="column59" displayMode="label"></w2:column>
        			<w2:column width="70" inputType="text" style="height:20px" id="column58" displayMode="label"></w2:column>
        			<w2:column width="141" inputType="text" style="height:20px" id="column57" displayMode="label"></w2:column>
        			<w2:column width="70" inputType="text" style="height:20px" id="column56" displayMode="label"></w2:column>
        		</w2:row>
        	</w2:footer>
        </w2:gridView>
    </body>
</html>
