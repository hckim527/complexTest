<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[temp]]></col1>
							<col2><![CDATA[a]]></col2>
							<col3><![CDATA[가]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[user]]></col1>
							<col2><![CDATA[b]]></col2>
							<col3><![CDATA[나]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[user]]></col1>
							<col2><![CDATA[c]]></col2>
							<col3><![CDATA[다]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[admin]]></col1>
							<col2><![CDATA[어드민]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[user]]></col1>
							<col2><![CDATA[사용자]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[temp]]></col1>
							<col2><![CDATA[관리자]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList3" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[aa]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[bb]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[cc]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
};
// gridView Cell 툴팁(col1 만 "test" 붙임)
scwin.autoCompleteTooltip = function(rowIndex, colIndex, label) {
	if (colIndex === 0) {
		return label + "test";
	} else {
		return label;
	}
};
// autoComplete 아이템 툴팁(가이드: label·index 전달). gridView Column 에서는 rowIndex·colIndex 가 전달되지 않아(undefined) 원본의 "_row_col" 분기는 동작하지 않음
scwin.autoCompleteItemTooltipFormatter = function(label, index) {
	return label + " " + index + " test";
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;" defaultCellHeight="20"
			dataList="data:dataList1" tooltipDisplay="true" tooltipFormatter="scwin.autoCompleteTooltip" tooltipShowAlways="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="111" inputType="text" style="height:20px" id="column5" value="autoComplete" displayMode="label"></w2:column>
					<w2:column width="110" inputType="text" style="height:20px" id="column4" value="autoComplete ul" displayMode="label"></w2:column>
					<w2:column width="101" inputType="text" style="height:20px" id="column3" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="111" inputType="autoComplete" style="height:20px" id="col1" displayMode="label"
						chooseOption="true" tooltipDisplay="false" itemTooltipDisplay="true" itemTooltipFormatter="scwin.autoCompleteItemTooltipFormatter" tooltipTime="0.01">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="col2"></w2:label>
								<w2:value ref="col1"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="111" inputType="autoComplete" style="height:20px" id="col2" displayMode="label" tableRender="ul"
						chooseOption="true" tooltipDisplay="false" itemTooltipDisplay="true" itemTooltipFormatter="scwin.autoCompleteItemTooltipFormatter" tooltipTime="0.01">
						<w2:choices>
							<w2:itemset nodeset="data:dataList3">
								<w2:label ref="col2"></w2:label>
								<w2:value ref="col1"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="101" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:autoComplete chooseOption="true" displayMode="label" editType="select" id="autoComplete1" style="position: relative;height:56px;width:255px;"
			submenuSize="auto" visibleRowNum="20" itemTooltipDisplay="true" itemTooltipFormatter="scwin.autoCompleteItemTooltipFormatter" tooltipTime="0.01">
			<w2:choices>
				<w2:itemset nodeset="data:dataList2">
					<w2:label ref="col2"></w2:label>
					<w2:value ref="col1"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:autoComplete>
		<w2:autoComplete chooseOption="true" displayMode="label" editType="select" id="autoComplete2" style="position: relative;height:56px;width:255px;" tableRender="ul"
			submenuSize="auto" visibleRowNum="20" itemTooltipDisplay="true" itemTooltipFormatter="scwin.autoCompleteItemTooltipFormatter" tooltipTime="0.01">
			<w2:choices>
				<w2:itemset nodeset="data:dataList2">
					<w2:label ref="col2"></w2:label>
					<w2:value ref="col1"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:autoComplete>
	</body>
</html>
