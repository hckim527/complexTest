<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list"
					saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1"
							dataType="text">
						</w2:column>
						<w2:column id="col2" name="name2"
							dataType="text">
						</w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[a]]></col1>
							<col2><![CDATA[a1]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[b]]></col1>
							<col2><![CDATA[b1]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[c]]></col1>
							<col2><![CDATA[c1]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[d]]></col1>
							<col2><![CDATA[d1]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list"
					saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1"
							dataType="text">
						</w2:column>
						<w2:column id="col2" name="name2"
							dataType="text">
						</w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[a1]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[a2]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[a3]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[4]]></col1>
							<col2><![CDATA[a4]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.doInit = function() {
	grid.setCellReadOnly(3, 0, false);
	grid.setCellBackgroundColor(3, 0, "#ff0000");
	grid1.setCellDisabled(3, 0, false);
	grid1.setCellBackgroundColor(3, 0, "#ff0000");
}
scwin.trigger2_onclick = function(e) {
	dataList1.setRowJSON(
		4, {
			"col1": "e",
			"col2": "e1"
		}
	);
	grid.setCellReadOnly(4, 1, false);
	grid.setCellBackgroundColor(4, 1, "#0000ff");
};
scwin.trigger3_onclick = function(e) {
	dataList1.removeRow(3);
};
scwin.trigger5_onclick = function(e) {
	dataList2.setRowJSON(
		4, {
			"col1": "5",
			"col2": "a5"
		}
	);
	grid1.setCellDisabled(4, 1, false);
	grid1.setCellBackgroundColor(4, 1, "#0000ff");
};
scwin.trigger6_onclick = function(e) {
	dataList2.removeRow(3);
};
scwin.fireDbClick = function(node) {
	if (document.createEventObject) {
		node.fireEvent('ondblclick');
	} else if (document.createEvent) {
		var evt = document.createEvent('MouseEvents');
		evt.initEvent('dblclick', true, false);
		node.dispatchEvent(evt);
	} else if (typeof node.ondblclick == 'function') {
		node.ondblclick();
	}
}
scwin.Dbclick = function(id) {
	var el = scwin.__getDom(id);
	scwin.fireDbClick(el);
}
scwin.onpageload = function() {
	scwin.doInit();
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="height:215px;">
			<xf:group id="" style="height:150px;padding:10px;">
				<w2:gridView dataList="dataList1" id="grid"
					autoFit="allColumn" readOnly="" style="width: 500px;height: 150px;" useShiftKey="true" columnMove="true"
					fixedColumnWithHidden="true">
					<w2:header id="header1">
						<w2:row id="row2">
							<w2:column id="column7"
								style="height:20px" width="70" inputType="text" value="name1"
								displayMode="label">
							</w2:column>
							<w2:column id="column3"
								style="height:20px" inputType="text" width="70" value="name2"
								displayMode="label">
							</w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody4">
						<w2:row id="row5">
							<w2:column id="col1"
								readOnly="true" style="height:20px" width="70" inputType="text"
								displayMode="label">
							</w2:column>
							<w2:column id="col2"
								readOnly="true" style="height:20px" inputType="text" width="70"
								displayMode="label">
							</w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>
			<xf:group id=""
				style="width: 100%;height: 25px;padding:10px;">
				<xf:trigger id="trigger2"
					style="position: relative;width: 80px;height: 23px;"
					ev:onclick="scwin.trigger2_onclick" type="button">
					<xf:label><![CDATA[insertRow(4)]]></xf:label>
				</xf:trigger>
				<xf:trigger id="trigger3"
					style="position: relative;width: 80px;height: 23px;"
					ev:onclick="scwin.trigger3_onclick" type="button">
					<xf:label><![CDATA[deleteRow(3)]]></xf:label>
				</xf:trigger>
			</xf:group>
		</xf:group>
		<xf:group id="" style="height:215px;">
			<xf:group id="" style="height:150px;padding:10px;">
				<w2:gridView autoFit="allColumn" columnMove="true"
					dataList="dataList2" fixedColumnWithHidden="true" id="grid1" readOnly="" style="width: 500px;height: 150px;"
					useShiftKey="true">
					<w2:header id="header11">
						<w2:row id="row12">
							<w2:column id="column17"
								style="height:20px" inputType="text" width="70"
								displayMode="label" value="name1">
							</w2:column>
							<w2:column id="column13"
								style="height:20px" width="70" inputType="text"
								displayMode="label" value="name2">
							</w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody14">
						<w2:row id="row15">
							<w2:column id="col1"
								style="height:20px" inputType="text" width="70"
								displayMode="label" disabled="true">
							</w2:column>
							<w2:column id="col2"
								style="height:20px" width="70" inputType="text"
								displayMode="label" disabled="true">
							</w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>
			<xf:group id=""
				style="width: 100%;height: 25px;padding:10px;">
				<xf:trigger ev:onclick="scwin.trigger5_onclick"
					id="trigger5" style="position: relative;width: 80px;height: 23px;"
					type="button">
					<xf:label><![CDATA[insertRow(4)]]></xf:label>
				</xf:trigger>
				<xf:trigger ev:onclick="scwin.trigger6_onclick"
					id="trigger6" style="position: relative;width: 80px;height: 23px;"
					type="button">
					<xf:label><![CDATA[deleteRow(3)]]></xf:label>
				</xf:trigger>
			</xf:group>
		</xf:group>
	</body>
</html>
 