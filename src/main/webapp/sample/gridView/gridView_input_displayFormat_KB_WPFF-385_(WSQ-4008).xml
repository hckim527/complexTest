<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="number"></w2:column>
						<w2:column id="col2" name="name2" dataType="number"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var arr = ["0", "0"];
	dataList1.setData(arr);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" summaryAuto="false" applyAllColumnStyle="false" scrollByColumn="false" defaultCellHeight="20"
			scrollByColumnAdaptive="false" id="gridView1" style="position: absolute ;left: 60px;top: 100px;width: 390px;height: 216px;"
			ignoreCellClick="false" syncScroll="false" ignoreToggleOnDisabled="false" summaryOnlyAuto="false" useShiftKey="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70" displayMode="label" displayFormat="#0.00" dataType="number"></w2:column>
					<w2:column id="col2" width="70" inputType="text" displayMode="label" displayFormat="##.00"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
