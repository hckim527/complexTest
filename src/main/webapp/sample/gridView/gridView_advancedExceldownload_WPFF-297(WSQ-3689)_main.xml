<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="text"/>
						<w2:column id="col3" name="name3" dataType="text"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var json = [{"col1": "1111"}];
	dataList1.setJSON(json);
};
scwin.trigger1_onclick = function(e) {
	var options = {type: "1"};
	grd.advancedExcelDownload(options);
};
scwin.func = function(val) {
	return val + ".";
};
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="grd" style="width: 500px;height: 150px;" defaultCellHeight="20" dataList="data:dataList1">
			<w2:caption id="caption1" value="this is a grid caption."/>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="column5" value="name1" displayMode="label"/>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="column3" value="name2" displayMode="label"/>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="column1" value="name3" displayMode="label"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="col1" displayMode="label" escapeFormatter="scwin.func"/>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="col2" displayMode="label"/>
					<w2:column removeBorderStyle="false" width="70" inputType="text" id="col3" displayMode="label"/>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" style="width: 80px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[down]]></xf:label>
		</xf:trigger>
	</body>
</html>
