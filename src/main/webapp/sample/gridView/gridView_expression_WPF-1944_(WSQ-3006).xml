				<w2:row id="row6">
					<w2:column id="column21" style="height:20px;" colSpan="2" inputType="text" width="140" rowSpan="" value="총계" displayMode="label">
					</w2:column>
					<w2:column expression="sum('col3')" id="column19" style="height:20px;" inputType="expression" width="70" value="" displayMode="label">
					</w2:column>
					<w2:column expression="sum('col4')" id="column18" style="height:20px;" inputType="expression" width="70" value="" displayMode="label">
					</w2:column>
					<w2:column expression="sum('col5')" id="column17" style="height:20px;" inputType="expression" width="70" value="" displayMode="label">
					</w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView><xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;margin-top:5px;margin-left:5px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[data변경]]></xf:label>
		</xf:trigger><w2:fusionchart plotColor="" valueNode="" seriesColumns="[['col3','col4','col5']]" seriesType="" labelNode="col2" runflashAt="" version="" id="fusionchart1" seriesNode="" chartType="MSColumn2D" ref="data:dataList1" style="height:300px;width:500px;margin-top:15px;margin-left:5px;" drawType="javascript" accessibility="">
		</w2:fusionchart></xf:group>
	</body>
</html>
 