			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="number"></w2:column>
						<w2:column id="col4" name="name4" dataType="number"></w2:column>
						<w2:column id="col5" name="name5" dataType="number"></w2:column>
					</w2:columnInfo>
					<w2:data></w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
	var json = [
		{ "col1": "", "col2": "", "col3": "1", "col4": "2", "col5": "4" },
		{ "col1": "", "col2": "", "col3": "1", "col4": "2", "col5": "4" },
		{ "col1": "", "col2": "", "col3": "1", "col4": "2", "col5": "4" },
		{ "col1": "", "col2": "", "col3": "1", "col4": "2", "col5": "4" },
		{ "col1": "", "col2": "", "col3": "1", "col4": "2", "col5": "4" }
	];
	dataList1.setJSON(json);
}
scwin.trigger1_onclick = function(e) {
	var json = [
		{ "col1": "", "col2": "", "col3": "1", "col4": "2", "col5": "4" },
		{ "col1": "", "col2": "", "col3": "1", "col4": "4", "col5": "1" },
		{ "col1": "", "col2": "", "col3": "1", "col4": "3", "col5": "1" },
		{ "col1": "", "col2": "", "col3": "1", "col4": "1", "col5": "1" },
		{ "col1": "", "col2": "", "col3": "1", "col4": "1", "col5": "1" }
	];
	dataList1.setJSON(json);
};
scwin.onpageload = function() {
	scwin.init();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="padding:10px;"><w2:gridView autoFit="" defaultCellHeight="20" dataList="dataList1" id="" style="position: relative;width:754px;height:150px;margin-top:5px;margin-left:5px;" useShiftKey="true">
			<w2:header id="header2">
				<w2:row id="row4">
					<w2:column id="column15" width="45" inputType="text" value="name1" displayMode="label"></w2:column>
					<w2:column id="column13" width="45" inputType="text" value="name2" displayMode="label"></w2:column>
					<w2:column id="column11" width="*" inputType="text" value="name3" displayMode="label"></w2:column>
					<w2:column id="column9" width="*" inputType="text" value="name4" displayMode="label"></w2:column>
					<w2:column id="column7" inputType="text" width="*" value="name5" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row5">
