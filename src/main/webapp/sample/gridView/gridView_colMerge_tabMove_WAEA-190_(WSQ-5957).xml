<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<w2:layoutInfo/>
		<w2:publicInfo method=""/>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.trigger1_onclick = function(e) {
    dataList1.insertRow();
};
scwin.trigger2_onclick = function(e) {
    dataList2.insertRow();
};
	scwin.checkVal = function() {
		return (document.getElementById('gridView1_cell_0_1') || document.getElementById('mf_gridView1_cell_0_1')).classList.contains("focusedTd");
	}
]]></script>
	</head>
	<body>
		<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[행추가]]></xf:label>
		</xf:trigger>
		<w2:gridView defaultCellHeight="20" id="gridView1" style="width:633px;height:150px;"
			dataList="data:dataList1">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="107" inputType="text" id="column15" value="name1" displayMode="label"></w2:column>
					<w2:column width="100" inputType="text" id="column14" value="name2" displayMode="label"></w2:column>
					<w2:column width="108" inputType="text" id="column13" value="name3" displayMode="label"></w2:column>
					<w2:column width="106" inputType="text" id="column12" value="name4" displayMode="label"></w2:column>
					<w2:column width="120" inputType="text" id="column11" value="name5" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="107" inputType="select" id="col1" displayMode="label" colMerge="true">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[업무1]]></w2:label>
								<w2:value><![CDATA[1]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[업무2]]></w2:label>
								<w2:value><![CDATA[2]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
					<w2:column width="100" inputType="select" id="col2" displayMode="label" colMerge="true">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[유형1]]></w2:label>
								<w2:value><![CDATA[1]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[유형2]]></w2:label>
								<w2:value><![CDATA[2]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
					<w2:column width="108" inputType="text" id="col3" displayMode="label"></w2:column>
					<w2:column width="106" inputType="text" id="col4" displayMode="label"></w2:column>
					<w2:column width="120" inputType="text" id="col5" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger2" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[행추가]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="data:dataList2" defaultCellHeight="20" id="gridView2"
			style="width:633px;height:150px;">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column displayMode="label" id="column15" inputType="text" value="name1" width="107"></w2:column>
					<w2:column displayMode="label" id="column14" inputType="text" value="name2" width="100"></w2:column>
					<w2:column displayMode="label" id="column13" inputType="text" value="name3" width="108"></w2:column>
					<w2:column displayMode="label" id="column12" inputType="text" value="name4" width="106"></w2:column>
					<w2:column displayMode="label" id="column11" inputType="text" value="name5" width="120"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column colMerge="true" displayMode="label" id="col1" inputType="text"
						width="107">
					</w2:column>
					<w2:column colMerge="true" displayMode="label" id="col2" inputType="text"
						width="100">
					</w2:column>
					<w2:column displayMode="label" id="col3" inputType="text" width="108"></w2:column>
					<w2:column displayMode="label" id="col4" inputType="text" width="106"></w2:column>
					<w2:column displayMode="label" id="col5" inputType="text" width="120"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
