<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="number" defaultValue="0"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거)
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.onpageload = function() {
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
};
scwin.dbClick = function(id) {
	var el = scwin.__getDom($p.id + id);
	var evt = document.createEvent('MouseEvents');
	evt.initEvent('dblclick', true, false);
	el.dispatchEvent(evt);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="" style="position: absolute ;left:33px;top:23px;width:516px;height:301px;">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label" dataType="number"></w2:column>
					<w2:column id="col3" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column id="column9" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column8" width="70" inputType="expression" displayMode="label" dataType="number" expression="SUM('col2')"></w2:column>
					<w2:column id="column7" width="70" inputType="expression" displayMode="label" expression="SUM('col3')"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
	</body>
</html>
