<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dlt_select" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="code" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="sel_sample" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	// 값 변경 시 col2의 inputType을 동적으로 변경한다.
	scwin.inputTypeCustomObj = {
		calendar: { inputType: "calendar" },
		radio: { inputType: "radio" },
		checkbox: { inputType: "checkbox" },
		input: { inputType: "input" },
		select: {
			inputType: "select",
			options: { viewType: "default" },
			itemSet: { nodeset: "data:sel_sample", label: "col1", value: "col2" }
		}
	};
};
scwin.init = function() {
	dlt_select.setJSON([
		{ "label": "input", "code": "input" },
		{ "label": "calendar", "code": "calendar" },
		{ "label": "checkbox", "code": "checkbox" },
		{ "label": "select", "code": "select" },
		{ "label": "radio", "code": "radio" }
	]);
	sel_sample.setJSON([
		{ "col1": "축구", "col2": "1" },
		{ "col1": "농구", "col2": "2" },
		{ "col1": "야구", "col2": "3" },
		{ "col1": "배구", "col2": "4" }
	]);
	var arr = [];
	for (var i = 0; i < 5; i++) {
		arr.push(new Array);
	}
	dataList1.setJSON(arr);
};
scwin.grd_onviewchange = function(info) {
	var inputType = info.newValue;
	var obj = scwin.inputTypeCustomObj[inputType];
	grd.setCellInputType(info.rowIndex, "col2", obj);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" setCellInputTypeCustom="true"
			id="grd" style="width: 500px;height: 150px;"
			useShiftKey="true" ev:onviewchange="scwin.grd_onviewchange">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="select" width="70" displayMode="label">
						<w2:choices>
							<w2:itemset nodeset="data:dlt_select">
								<w2:label ref="label"></w2:label>
								<w2:value ref="code"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col2" inputType="custom" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" width="70" inputType="custom" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
