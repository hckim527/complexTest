<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	grid1.insertRow();
	grid1.insertRow();
	grid1.insertRow();
	grid1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:grid baseNode="vector" repeatNode="data/INFO" id="grid1" style="position: relative;width:247px;height:150px;"
			fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="column1" style="height:20px" width="70" inputType="text" dataType="own"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="column4" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="column2" style="height:20px" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:grid>
		<w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width:256px;height:150px;margin-top:20px;"
			fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" style="height:20px" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column1" style="height:20px" width="70" inputType="text" value="name2" dataType="own"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col2" style="height:20px" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
