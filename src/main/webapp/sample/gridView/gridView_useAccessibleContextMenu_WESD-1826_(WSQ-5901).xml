<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setJSON([
		{col1:'Name1', col2:'Value1', col3:'Option1'},
		{col1:'Name2', col2:'Value2', col3:'Option2'},
		{col1:'Name3', col2:'Value3', col3:'Option3'}
	]);
};
// 시스템 메뉴 중 ColumnHide 숨기고 사용자 메뉴 1개 추가
scwin.gridView1_oncontextopen = function(row,col) {
	return {
		hideSystemMenu: [ "ColumnHide" ],
		appendMenu: [{ label:"특별한 컬럼 숨기기", userMenuId:"userColumnHide", className:"" }]
	};
};
]]></script>
		<style><![CDATA[
			/* useAccessibleContextMenu(ul/li) 용 css (WESD 댓글) */
			.w2grid_contextMenu_accessibility {
				overflow: hidden;
				background-color: white;
				position:absolute; 
				border: 3px solid #B1C5D5; 
				z-index: 9999; 
				padding:0px; 
				display:block;
				list-style: none;
				margin: 0;
			}
			.w2grid_contextMenu_accessibility .w2grid_contextMenu_column {
				color:#066196;
				font-size:12px;
				font-weight:normal;
				white-space:nowrap;
				list-style: none;
				text-decoration: none;
				display: inline-block;
			}
		]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" style="width: 500px;height: 150px;"
			fixedColumnWithHidden="true" useShiftKey="true"
			contextMenu="true" ev:oncontextopen="scwin.gridView1_oncontextopen"
			accessibility="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column9" style="height:20px" inputType="text" width="70" displayMode="label" value="name1"></w2:column>
					<w2:column id="column7" style="height:20px" inputType="text" width="70" displayMode="label" value="name2"></w2:column>
					<w2:column id="column3" style="height:20px" width="70" inputType="text" displayMode="label" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView dataList="dataList1" id="gridView2" style="width: 500px;height: 150px;"
			fixedColumnWithHidden="true" useShiftKey="true"
			contextMenu="true" ev:oncontextopen="scwin.gridView1_oncontextopen"
			useAccessibleContextMenu="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column9" style="height:20px" inputType="text" width="70" displayMode="label" value="name1"></w2:column>
					<w2:column id="column7" style="height:20px" inputType="text" width="70" displayMode="label" value="name2"></w2:column>
					<w2:column id="column3" style="height:20px" width="70" inputType="text" displayMode="label" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView dataList="dataList1" id="gridView3" style="width: 500px;height: 150px;"
			fixedColumnWithHidden="true" useShiftKey="true"
			contextMenu="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column9" style="height:20px" inputType="text" width="70" displayMode="label" value="name1"></w2:column>
					<w2:column id="column7" style="height:20px" inputType="text" width="70" displayMode="label" value="name2"></w2:column>
					<w2:column id="column3" style="height:20px" width="70" inputType="text" displayMode="label" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
