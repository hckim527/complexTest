<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.test = function() {}
scwin.__styleIsBold = function() {
	var style = ((j) => j.length ? j : $('#mf_gridView1_column12'))($('#gridView1_column12')).css("font-weight");
	return style == "700";
}
scwin.onpageload = function() {
	scwin.test = function() {
		window.sum = 0;
		for (var ix = 0; ix < dataList1.getRowCount(); ix++) {
			if (ix % 2 == 1) {
				sum += dataList1.getCellData(ix, 1);
			}
		}
		return sum;
	}
	dataList1.setData([1, 2, 3, 4,
		1, 2, 3, 4,
		5, 6, 7, 8
	]);
};
]]></script>
		<style type="text/css"><![CDATA[
.fc {font-weight: bold;}
]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" rowStatusVisible=""
			style="position: relative ;left:24px;top:15px;width:390px;height:245px;"
			fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column16" style="height:20px" inputType="text" width="70" displayMode="label"
						value="name1">
					</w2:column>
					<w2:column id="column13" style="height:20px" inputType="text" width="70" displayMode="label"
						value="name2">
					</w2:column>
					<w2:column id="column10" style="height:20px" inputType="text" width="70" displayMode="label"
						value="name3">
					</w2:column>
					<w2:column id="column3" style="height:20px" width="70" inputType="text" displayMode="label"
						value="name4">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" inputType="text" width="70" displayMode="label" class="fc"></w2:column>
					<w2:column id="col4" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer7">
				<w2:row id="row8">
					<w2:column id="column18" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="column15" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="column12" style="height:20px;" inputType="expression" expression="scwin.test()" width="70"
						displayMode="label" columnClass="fc">
					</w2:column>
					<w2:column id="column9" style="height:20px" width="70" inputType="expression" displayMode="label"
						expression="sum('col4');">
					</w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
	</body>
</html>
 