<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlCond" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="bkgCtrtCgoTpCd" name="select"></w2:column>
						<w2:column dataType="text" id="bkgImdgClssCd" name="autoComplete"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><bkgCtrtCgoTpCd><![CDATA[5]]></bkgCtrtCgoTpCd><bkgImdgClssCd><![CDATA[]]></bkgImdgClssCd></w2:row>
						<w2:row><bkgCtrtCgoTpCd><![CDATA[1]]></bkgCtrtCgoTpCd><bkgImdgClssCd><![CDATA[2]]></bkgImdgClssCd></w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" id="dlImdgClssCd" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="intgCdVal" name="CODE"></w2:column>
						<w2:column dataType="text" id="intgCdValNm" name="NAME"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><intgCdVal><![CDATA[1]]></intgCdVal><intgCdValNm><![CDATA[EXPLOSIVE]]></intgCdValNm></w2:row>
						<w2:row><intgCdVal><![CDATA[2]]></intgCdVal><intgCdValNm><![CDATA[GAS]]></intgCdValNm></w2:row>
						<w2:row><intgCdVal><![CDATA[3]]></intgCdVal><intgCdValNm><![CDATA[FLAMMABLE LIQUIDS]]></intgCdValNm></w2:row>
						<w2:row><intgCdVal><![CDATA[4]]></intgCdVal><intgCdValNm><![CDATA[FLAMMABLE SOLIDS]]></intgCdValNm></w2:row>
						<w2:row><intgCdVal><![CDATA[5]]></intgCdVal><intgCdValNm><![CDATA[OXIDZING SUBSTANCES(AGENTS) AND ORGANIC PEROXIDES]]></intgCdValNm></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// 스크립트 없음(gridView select · autoComplete 의 gridViewItemset 목록 높이 확인용)
]]></script>
	</head>
	<body>
		<w2:gridView arrowMove="true" autoFit="none" dataList="data:dlCond" id="gvCond" rowStatusVisible="true" sortable="false" style="height:208px;width:400px;" visibleRowNum="5" editModeEvent="onclick">
			<w2:header id="header2" style="">
				<w2:row id="row1" style="">
					<w2:column id="column1" inputType="text" value="select" width="120"></w2:column>
					<w2:column id="column2" inputType="text" value="autoComplete" width="120"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2" style="">
				<w2:row id="row2" style="">
					<w2:column chooseOption="true" chooseOptionLabel="$blank" displayMode="label" id="bkgCtrtCgoTpCd" inputType="select" textAlign="center" width="120" viewType="icon">
						<w2:choices>
							<w2:gridViewItemset height="" hideHeader="true" label="intgCdVal" nodeset="data:dlImdgClssCd" value="intgCdVal" visibleRowNum="10" width="300px;">
								<w2:item header="Code" ref="intgCdVal" style="width:15%;"></w2:item>
								<w2:item header="Name" ref="intgCdValNm" style="width:85%; text-align:left;"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
					<w2:column chooseOption="true" chooseOptionLabel="$blank" displayMode="label" id="bkgImdgClssCd" inputType="autoComplete" textAlign="center" viewTypeIconImage="true" width="120" viewType="icon">
						<w2:choices>
							<w2:gridViewItemset height="" hideHeader="true" label="intgCdVal" nodeset="data:dlImdgClssCd" value="intgCdVal" visibleRowNum="10" width="300px;">
								<w2:item header="Code" ref="intgCdVal" style="width:15%;"></w2:item>
								<w2:item header="Name" ref="intgCdValNm" style="width:85%; text-align:left;"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
