<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection>
				<w2:dataList id="dataList_menu">
					<w2:columnInfo>
						<w2:column id="MENU_NM" name="메뉴명" dataType="text"></w2:column>
						<w2:column id="LEVEL_CNT" name="레벨수" dataType="text"></w2:column>
						<w2:column id="SRC_PATH" name="파일경로" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList_menu.setJSON([
		{ "MENU_NM": "Education", "LEVEL_CNT": 2 },
		{ "MENU_NM": "Basic", "LEVEL_CNT": 3 },
		{ "MENU_NM": "DataCollection", "LEVEL_CNT": 2 },
		{ "MENU_NM": "DataMap Binding", "LEVEL_CNT": 3 },
		{ "MENU_NM": "DataList Binding", "LEVEL_CNT": 3 },
		{ "MENU_NM": "TableLayout", "LEVEL_CNT": 2 },
		{ "MENU_NM": "Table Layout", "LEVEL_CNT": 3 },
		{ "MENU_NM": "Adaptive Layout", "LEVEL_CNT": 3 }
	]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<!-- editType="focus" : 편집 시작 시 값 전체 선택 없이 커서만 위치 -->
		<w2:gridView id="gridView1" dataList="dataList_menu" style="width:600px;height:200px;" visibleRowNum="all" autoFit="allColumn">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column9" style="height:20px;" width="187" value="Menu."></w2:column>
					<w2:column id="column5" style="height:20px;" width="45" value="Depth"></w2:column>
					<w2:column id="column3" style="height:20px;" width="350" value="FilePath."></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="MENU_NM" style="height:20px" inputType="drilldown" width="187" depthColumn="LEVEL_CNT" depthType="div" showDepth="3" textAlign="left" editType="focus"></w2:column>
					<w2:column id="LEVEL_CNT" style="height:20px" width="59" textAlign="right" editType="focus"></w2:column>
					<w2:column id="SRC_PATH" style="height:20px" width="351" textAlign="left" editType="focus"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<!-- 대조군 editType="select" : 편집 시작 시 값 전체 선택 -->
		<w2:gridView id="gridView2" dataList="dataList_menu" style="width:600px;height:200px;" visibleRowNum="all" autoFit="allColumn">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column9" style="height:20px;" width="187" value="Menu."></w2:column>
					<w2:column id="column5" style="height:20px;" width="45" value="Depth"></w2:column>
					<w2:column id="column3" style="height:20px;" width="350" value="FilePath."></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="MENU_NM" style="height:20px" inputType="drilldown" width="187" depthColumn="LEVEL_CNT" depthType="div" showDepth="3" textAlign="left" editType="select"></w2:column>
					<w2:column id="LEVEL_CNT" style="height:20px" width="59" textAlign="right" editType="select"></w2:column>
					<w2:column id="SRC_PATH" style="height:20px" width="351" textAlign="left" editType="select"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
