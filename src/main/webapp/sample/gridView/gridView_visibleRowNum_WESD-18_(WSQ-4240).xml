<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.insertRow();
};
scwin.trigger2_onclick = function(e) {
	var jsonData2 = [{
		"col1": "",
		"col2": "1<br/>2<br/>3<br/>4<br/>5<br/>6<br/>7<br/>8<br/>9<br/>10<br/>11<br/>12<br/>13<br/>14<br/>15<br/>16<br/>17<br/>18"
	}];
	dataList1.setJSON(jsonData2);
};
scwin.trigger4_onclick = function(e) {
	var aaa = "1<br/>2<br/>3<br/>4<br/>5<br/>6<br/>7<br/>8<br/>9<br/>10<br/>11<br/>12<br/>13<br/>14<br/>15<br/>16<br/>17<br/>18";
	dataList1.setCellData(0, 1, aaa);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width:160px;height:23px;left:10px;margin-left:10px;"
			type="button">
			<xf:label><![CDATA[dataList1.setJSON]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" style="width:137px;height:23px;" id="trigger4" ev:onclick="scwin.trigger4_onclick">
			<xf:label><![CDATA[setCellData]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="data:dataList1" style="width: 500px;height: 150px;margin-left:10px;" id="gridView1" visibleRowNum="all" defaultCellHeight="20">
				<w2:header id="header2">
					<w2:row id="row3">
						<w2:column width="265" inputType="text" id="column5" value="name1" displayMode="label">
						</w2:column>
						<w2:column width="204" inputType="text" id="column3" value="name2" displayMode="label">
						</w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody2">
					<w2:row id="row4">
						<w2:column width="265" inputType="text" id="col1" displayMode="label">
						</w2:column>
						<w2:column displayType="all" width="204" inputType="textarea" id="col2" escape="false" displayMode="label">
						</w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
	</body>
</html>
