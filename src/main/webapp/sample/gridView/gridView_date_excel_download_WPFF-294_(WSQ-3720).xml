<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="date"/>
						<w2:column id="col2" name="name2" dataType="date"/>
						<w2:column id="col3" name="name3" dataType="date"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridView1.advancedExcelDownload({
		type: 1,
		fileName: "test.xlsx",
		useDataFormat: "true"
	})
};
scwin.onpageload = function() {
	var jsonData = [{"col1": "26102018", "col2": "26-10-2018", "col3": "20181026"}];
	dataList1.setJSON(jsonData);
}
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="position: absolute ;left:29px;top:100px;width: 509px;height: 190px;">
			<w2:caption id="caption1" value="this is a grid caption."/>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" removeBorderStyle="false" inputType="text" width="116" value="name1" displayMode="label"/>
					<w2:column id="column2" removeBorderStyle="false" width="116" inputType="text" value="name2" displayMode="label"/>
					<w2:column id="column3" removeBorderStyle="false" width="116" inputType="text" value="name3" displayMode="label"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" removeBorderStyle="false" inputType="text" width="116" displayMode="label" dataType="date" ioFormat="ddMMyyyy" displayFormat="dd-MM-yyyy"/>
					<w2:column id="col2" removeBorderStyle="false" width="116" inputType="text" displayMode="label" dataType="date" ioFormat='dd-MM-yyyy' displayFormat="dd-MM-yyyy"/>
					<w2:column id="col3" removeBorderStyle="false" width="116" inputType="text" displayMode="label" dataType="date"/>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: absolute ;left: 45px;top: 29px;width: 138px;height: 43px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[excelDown]]></xf:label>
		</xf:trigger>
	</body>
</html>
