<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="a" dataType="number"></w2:column>
						<w2:column id="col2" name="b" dataType="number"></w2:column>
						<w2:column id="col3" name="c" dataType="number"></w2:column>
						<w2:column id="col4" name="d" dataType="number"></w2:column>
						<w2:column id="col5" name="e" dataType="number"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<!-- captionAuto: 표시 컬럼 헤더명으로 caption 생성. 숨김1/숨김2(hidden) 아래의 숨김컬럼9/10 도 숨김 -->
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="width:800px;height:333px;"
			accessibility="true" senseReader="true" captionAuto="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column12" value="구분" displayMode="label" rowSpan="2"></w2:column>
					<w2:column width="280" inputType="text" id="column11" value="제목1" displayMode="label" colSpan="3"></w2:column>
					<w2:column width="210" inputType="text" id="column10" value="제목2" displayMode="label" colSpan="3"></w2:column>
					<w2:column width="70" inputType="text" id="column9" value="숨김1" displayMode="label" hidden="true"></w2:column>
					<w2:column width="70" inputType="text" id="column8" value="숨김2" displayMode="label" hidden="true"></w2:column>
				</w2:row>
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column13" value="제목3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column18" value="제목4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column24" value="제목5" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="제목6" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column30" value="제목7" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column27" value="제목8" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="숨김컬럼9" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value="숨김컬럼10" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="checkbox" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="column19" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="column25" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="column31" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="column28" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col4" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col5" inputType="text" width="70" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
