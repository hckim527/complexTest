<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
        
    scwin.onpageload = function() {
        var json = [
            { "col1" : "10", "col2" : "10", "col3" : "a"},
            { "col1" : "10", "col2" : "20", "col3" : "b"},
            { "col1" : "20", "col2" : "10", "col3" : "c"},
            { "col1" : "20", "col2" : "20", "col3" : "d"},
            { "col1" : "30", "col2" : "10", "col3" : "e"},
            { "col1" : "30", "col2" : "20", "col3" : "f"}
        ]
        dataList1.setJSON(json)
    };
    
        
    
    
    scwin.trigger3_onclick = function(e) {
        dataList1.setColumnFilter( 
               {type:'row', colIndex:'col1', key:"10", condition:'and'}
           );   
    };
	
	scwin.checkVal1 = function() {
		return (document.getElementById('gridView1_column5_filter') || document.getElementById('mf_gridView1_column5_filter')).getAttribute('title') == '필터 버튼';
	}		

	
    ]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width:508px;height:180px;" defaultCellHeight="20"
			dataList="data:dataList1" mergeCells="bycol" mergeCol="col1" sortable="true" showSortableUseFilter="true">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="120" inputType="text" style="height:20px" id="column5" value="name1"
						displayMode="label" useFilter="true">
					</w2:column>
					<w2:column width="170" inputType="text" style="height:20px" id="column4" value="name2"
						displayMode="label" useFilter="true">
					</w2:column>
					<w2:column width="150" inputType="text" style="height:20px" id="column3" value="name3"
						displayMode="label" useFilter="true">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="120" inputType="text" style="height:20px" id="col1"
						displayMode="label" useFilter="true">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2"
						displayMode="label" useFilter="true">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3"
						displayMode="label" useFilter="true">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" style="width:160px;height:33px;" id="trigger3" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[setColumnFilter]]></xf:label>
		</xf:trigger>
	</body>
</html>
