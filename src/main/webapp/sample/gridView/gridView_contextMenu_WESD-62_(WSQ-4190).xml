<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	var json = [
		{ col1: 'Name1', col2: 'Value1', col3: 'Option1' },
		{ col1: 'Name2', col2: 'Value2', col3: 'Option2' },
		{ col1: 'Name3', col2: 'Value3', col3: 'Option3' }
	];
	dataList1.setJSON(json);
};
scwin.gridView1_oncontextclick = function(row, col, userMenuId, isSystemMenu, systemMenu) {
	localStorage.setItem('log', col);
};
scwin.checkVal = function() {
	return localStorage.getItem('log') == 0;
};
localStorage.removeItem("log");
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList1" id="gridView1" style="width: 500px;height: 150px;"
			fixedColumnWithHidden="true" useShiftKey="true" contextMenu="true"
			ev:oncontextclick="scwin.gridView1_oncontextclick" columnMove="true"
			useHeaderContextMenu="true" rowStatusVisible="true" rowNumVisible="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column11" value="name1"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column9" value="name2"
						displayMode="label">
					</w2:column>
					<w2:column width="140" inputType="text" style="height:20px;" id="column7" value="name3"
						displayMode="label" colSpan="2">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name5"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="name6"
						displayMode="label">
					</w2:column>
				</w2:row>
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column17"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column16"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column15"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column14"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column13"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column12"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col5"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col6"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="height: 23px;padding-left: 10px;padding-right: 10px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[클릭하여 그리드 데이터를 불러온 후, &nbsp;셀을 오른쪽 클릭하여 메뉴를 표시해보세요.]]></xf:label>
		</xf:trigger>
	</body>
</html>
