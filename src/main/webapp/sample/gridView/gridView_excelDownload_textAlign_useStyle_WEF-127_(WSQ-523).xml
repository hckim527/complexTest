<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dlt_ExcelData" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="code" name="변대주" dataType="text"/>
						<w2:column id="status" name="상" dataType="text"/>
						<w2:column id="capital" name="용량" dataType="number"/>
						<w2:column id="lineCd" name="선로명" dataType="text"/>
						<w2:column id="lineValue" name="선로값" dataType="text"/>
						<w2:column id="lineNb" name="선로번호" dataType="text"/>
						<w2:column id="result" name="판정" dataType="text"/>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<code><![CDATA[전기사용제한<br/>제한전력감액]]></code>
							<status><![CDATA[C]]></status>
							<capital><![CDATA[5]]></capital>
							<lineCd><![CDATA[cd01]]></lineCd>
							<lineValue><![CDATA[cd01]]></lineValue>
							<lineNb><![CDATA[R6]]></lineNb>
							<result><![CDATA[p]]></result>
						</w2:row>
						<w2:row>
							<code><![CDATA[기존건물대피장소<br/>전년동월(전월)사용량<br/>초과부분사용량요금면제]]></code>
							<status><![CDATA[C]]></status>
							<capital><![CDATA[20]]></capital>
							<lineCd><![CDATA[cd01]]></lineCd>
							<lineValue><![CDATA[cd01]]></lineValue>
							<lineNb><![CDATA[R6]]></lineNb>
							<result><![CDATA[p]]></result>
						</w2:row>
						<w2:row>
							<code><![CDATA[멸실건물<br/>전기요금전액면제]]></code>
							<status><![CDATA[C]]></status>
							<capital><![CDATA[30]]></capital>
							<lineCd><![CDATA[cd02]]></lineCd>
							<lineValue><![CDATA[cd01]]></lineValue>
							<lineNb><![CDATA[R6]]></lineNb>
							<result><![CDATA[p]]></result>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.btn_ExcelDown_onclick = function(e) {
	var options = {
		"fileName": "ExcelDownLoadSampe.xlsx",
		"sheetName": "sample",
		"type": "0",
		"startRowIndex": "0",
		"startColumnIndex": "0",
		"headerFontName": "굴림",
		"headerFontSize": "12",
		"headerColor": "#EDEEF3",
		"subTotalColor": "#EFF4FE",
		"footerColor": "#DBE6FF",
		"showProcess": true,
		"useStyle": true,
		"bodyWordwrap": true,
		"useSubTotal": true,
		"useDataFormat": true,
		"rowNumVisible": true,
		"rowNumHeaderValue": "No",
		"rowNumHeaderColor": "#EDEEF3",
		"rowNumSubTotalColor": "#EFF4FE"
	};
	grd_ExcelSample.advancedExcelDownload(options);
};
		]]></script>
	</head>
	<body>
		<xf:group id="" style="height:658px;padding:30px;">
			<w2:gridView dataList="dlt_ExcelData" id="grd_ExcelSample" style="position: relative;float:left;width: 80%;height:500px;" fixedColumnWithHidden="true" useShiftKey="true" focusMode="row" rowNumVisible="true" rowNumHeaderValue="순번" class="cm_grid">
				<w2:header id="header1">
					<w2:row id="header_row1">
						<w2:column id="col11" style="height:20px;" inputType="text" width="313" value="재해구분"/>
						<w2:column id="col12" style="height:20px;" inputType="text" width="70" value="상"/>
						<w2:column id="col14" style="height:20px;" inputType="text" width="125" value="선로명"/>
						<w2:column id="col13" style="height:20px;" inputType="text" width="70" value="용량"/>
						<w2:column id="col15" style="height:20px;" inputType="text" width="70" value="선로값"/>
						<w2:column id="col16" style="height:20px;" inputType="text" width="70" value="선로번호"/>
						<w2:column id="col17" style="height:20px;" inputType="text" width="70" value="판정"/>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody4">
					<w2:row id="row5">
						<w2:column id="code" style="height:20px" inputType="textarea" width="313" colMerge="" dataType="text" textAlign="right"/>
						<w2:column id="status" style="height:20px" inputType="checkcombobox" width="70" allOption="" chooseOption="" dateValidCheck="" colMerge="" textAlign="center">
							<w2:choices>
								<w2:item>
									<w2:label><![CDATA[A]]></w2:label>
									<w2:value><![CDATA[A]]></w2:value>
								</w2:item>
								<w2:item>
									<w2:label><![CDATA[B]]></w2:label>
									<w2:value><![CDATA[B]]></w2:value>
								</w2:item>
								<w2:item>
									<w2:label><![CDATA[C]]></w2:label>
									<w2:value><![CDATA[C]]></w2:value>
								</w2:item>
							</w2:choices>
						</w2:column>
						<w2:column id="lineCd" style="height:20px" inputType="select" width="125" allOption="" chooseOption="true" displayFormatter="" viewType="icon" displayMode="value delim label" chooseOptionLabel="- 선택 -" textAlign="center">
							<w2:choices>
								<w2:item>
									<w2:label><![CDATA[중앙로]]></w2:label>
									<w2:value><![CDATA[cd01]]></w2:value>
								</w2:item>
								<w2:item>
									<w2:label><![CDATA[법동로]]></w2:label>
									<w2:value><![CDATA[cd02]]></w2:value>
								</w2:item>
							</w2:choices>
						</w2:column>
						<w2:column id="capital" style="height:20px" inputType="text" width="70" textAlign="center"/>
						<w2:column id="lineValue" style="height:20px" inputType="text" width="70"/>
						<w2:column id="lineNb" style="height:20px" inputType="text" width="70" displayFormat="#-#"/>
						<w2:column id="result" style="height:20px" inputType="select" width="70" allOption="" chooseOption="" displayFormatter="" displayFormat="" displayType="">
							<w2:choices>
								<w2:item>
									<w2:label><![CDATA[Poor]]></w2:label>
									<w2:value><![CDATA[p]]></w2:value>
								</w2:item>
								<w2:item>
									<w2:label><![CDATA[Fair]]></w2:label>
									<w2:value><![CDATA[f]]></w2:value>
								</w2:item>
							</w2:choices>
						</w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:group id="group1" style="position: relative;float:left;width: 80%;margin-top:10px;">
				<xf:trigger type="button" id="btn_ExcelDown" ev:onclick="scwin.btn_ExcelDown_onclick">
					<xf:label><![CDATA[엑셀다운로드]]></xf:label>
				</xf:trigger>
			</xf:group>
		</xf:group>
	</body>
</html>
