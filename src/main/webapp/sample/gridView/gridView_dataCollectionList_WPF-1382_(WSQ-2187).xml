					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger2_onclick = function(e) {
	isShowAlert = true;
};
scwin.onpageload = function() {
	window.data1 = [{ "col1": "a", "col2": "1000" }, { "col1": "b", "col2": "2000" }, { "col1": "c", "col2": "3000" }, { "col1": "d", "col2": "4000" }];
	window.data2 = [{ "col1": "a", "col2": "1000" }, { "col1": "c", "col2": "3000" }];
	dataList1.setJSON(data1);
