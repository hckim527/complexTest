<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    // 13행(Row 수에 따라 현상이 달라 원본 건수 유지)
    var json = [{ "col1": "11", "col2": "22", "col3": "33" }, { "col1": "44", "col2": "55", "col3": "66" }, { "col1": "77", "col2": "88", "col3": "99" }];
    for (var i = 3; i < 13; i++) {
        json.push({ "col1": "00", "col2": "11", "col3": "22" });
    }
    dataList1.setJSON(json);
};
scwin.trigger1_onclick = function(e) {
    grd_test.setRowVisible(0, false);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="grd_test" style="width:500px;height:348px;" defaultCellHeight="20" dataList="data:dataList1" rowNumVisible="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="컬럼1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="컬럼2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="컬럼3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" style="width:123px;height:23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[줄 숨기기]]></xf:label>
		</xf:trigger>
	</body>
</html>
