<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="/css/common.css" type="text/css"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="col1" dataType="text"></w2:column>
						<w2:column id="custom" name="custom" dataType="text"></w2:column>
						<w2:column id="col2" name="col2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setJSON([{ "col1": "1", "custom": "19941005", "col2": "1" }, { "col1": "1", "custom": "v3", "col2": "1" }, { "col1": "1", "custom": "v1", "col2": "1" }]);
};
// inputType="custom" Cell 을 setCellInputType 으로 calendar(viewType=icon) 변경
scwin.trigger3_onclick = function(e) {
	gridView1.setCellInputType(0, "custom", { inputType: "calendar", options: { imageSrc: "", viewType: "icon" } });
};
// 편집 중인 동적 calendar 편집기에 gridBodyDefault(배경색) class 가 붙지 않아야 함
scwin.__hasClass = function() {
	return document.getElementById("G_" + $p.id + "gridView1__dynamic_calendar_0_1").className.indexOf("gridBodyDefault") == -1;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1"
			style="position: absolute ;left:40px;top:35px;width:407px;height:251px;" setCellInputTypeCustom="true" applyAllColumnStyle="true">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column7" style="height:20px;" inputType="text" width="70" value="col1"
						displayMode="label">
					</w2:column>
					<w2:column id="column5" style="height:20px;" inputType="text" width="121"
						value="custom" displayMode="label">
					</w2:column>
					<w2:column id="column3" style="height:20px;" width="130" inputType="text" value="calendar"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" style="ime-mode:disabled;" inputType="text"
						width="70" displayMode="label">
					</w2:column>
					<w2:column id="custom" inputType="custom" width="121"
						displayMode="label">
					</w2:column>
					<w2:column id="col2" width="130" inputType="calendar"
						displayMode="label" allowChar="a-z0-9" viewType="icon">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" style="position: absolute ;left:475px;top:125px;width: 180px;height: 72px;" id="trigger3"
			ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[test_inputType="calendar"]]></xf:label>
		</xf:trigger>
	</body>
</html>
