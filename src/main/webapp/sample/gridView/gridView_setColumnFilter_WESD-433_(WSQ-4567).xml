<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="name1"></w2:column>
						<w2:column dataType="text" id="col2" name="name2"></w2:column>
						<w2:column dataType="text" id="col3" name="name3"></w2:column>
						<w2:column dataType="text" id="col4" name="name4"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [
		{ "col1": "41.4", "col2": "39.3", "col3": "9.3", "col4": "" },
		{ "col1": "40", "col2": "39", "col3": "1", "col4": "" },
		{ "col1": "31.4", "col2": "39.3", "col3": "9.3", "col4": "" },
		{ "col1": "21.4", "col2": "39.3", "col3": "9.3", "col4": "" },
		{ "col1": "41.4", "col2": "39.3", "col3": "9.3", "col4": "" },
		{ "col1": "41", "col2": "39", "col3": "10", "col4": "" }
	];
	dataList1.setJSON(jsonData);
	gridView1.setCellClass(0, 0, "gridCSS");
	var index = gridView1.getTotalRow();
	for (var i = 0; i <= index; i++) {
		dataList1.setCellData(i, "col4", Math.round((Number(dataList1.getCellData(i, "col1")) +
			Number(dataList1.getCellData(i, "col2")) +
			Number(dataList1.getCellData(i, "col3"))) * 1e12) / 1e12);
	}
};
]]></script>
		<style type="text/css"><![CDATA[
	.gridCSS {
		background-color : yellow !important;
	}
]]></style>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;" defaultCellHeight="20" sortable="true" dataList="data:dataList1" useFilterList="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px;" id="column7" value="1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px;" id="column5" value="2" displayMode="label" useFilter="true"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px;" id="column3" value="3" displayMode="label" useFilter="true"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px;" id="column1" value="4" displayMode="label" useFilter="true"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label" dataType="number"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label" dataType="number"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label" dataType="number"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4" displayMode="label" dataType="number"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
