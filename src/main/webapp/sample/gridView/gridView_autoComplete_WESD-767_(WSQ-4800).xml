		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><col2><![CDATA[11]]></col2><col3><![CDATA[22]]></col3></w2:row>
						<w2:row><col2><![CDATA[22]]></col2><col3><![CDATA[33]]></col3></w2:row>
						<w2:row><col2><![CDATA[33]]></col2><col3><![CDATA[44]]></col3></w2:row>
						<w2:row><col2><![CDATA[44]]></col2><col3><![CDATA[55]]></col3></w2:row>
						<w2:row><col2><![CDATA[55]]></col2><col3><![CDATA[66]]></col3></w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList4" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><col1><![CDATA[테스트1]]></col1><col2><![CDATA[확인1]]></col2></w2:row>
						<w2:row><col1><![CDATA[테스트2]]></col1><col2><![CDATA[확인2]]></col2></w2:row>
						<w2:row><col1><![CDATA[테스트3]]></col1><col2><![CDATA[확인3]]></col2></w2:row>
						<w2:row><col1><![CDATA[테스트4]]></col1><col2><![CDATA[확인4]]></col2></w2:row>
						<w2:row><col1><![CDATA[테스트5]]></col1><col2><![CDATA[확인5]]></col2></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.fireDbClick = function(node) {
	if (document.createEventObject) {
		node.fireEvent('ondblclick');
	} else if (document.createEvent) {
		var evt = document.createEvent('MouseEvents');
		evt.initEvent('dblclick', true, false);
		node.dispatchEvent(evt);
	} else if (typeof node.ondblclick == 'function') {
		node.ondblclick();
	}
};
scwin.Dbclick = function(id) {
	var el = scwin.__getDom(id);
	scwin.fireDbClick(el);
};
]]></script>
