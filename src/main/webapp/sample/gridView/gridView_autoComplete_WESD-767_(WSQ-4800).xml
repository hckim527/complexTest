	<body>
		<xf:group style="" id=""></xf:group>
		<!-- Jira 첨부 config.xml 조건(gridView moveKeyEditModeAll=true·autoComplete/selectBox Column skipKeyMoveEditMode=true)을 속성으로 지정 -->
