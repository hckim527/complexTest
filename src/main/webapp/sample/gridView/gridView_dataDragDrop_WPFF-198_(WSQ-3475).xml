<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="sDate" name="name1" dataType="text"></w2:column>
						<w2:column id="nDateType" name="name2" dataType="number"></w2:column>
						<w2:column id="sDesc" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="sDate" name="name1" dataType="text"></w2:column>
						<w2:column id="nDateType" name="name2" dataType="number"></w2:column>
						<w2:column id="sDesc" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger2_onclick = function(e) {
	gridView1.setDataDragDrop(true);
};
scwin.trigger3_onclick = function(e) {
	gridView1.setDataDragDrop(false);
};
scwin.onpageload = function() {
	var jsonData = [
		{ "sDate": "20010101", "nDateType": "", "sDesc": "신정" },
		{ "sDate": "20010121", "nDateType": "1", "sDesc": "설날" },
		{ "sDate": "20010122", "nDateType": "11111", "sDesc": "설날" },
		{ "sDate": "20010123", "nDateType": "1", "sDesc": "설날" },
		{ "sDate": "20010301", "nDateType": "12222", "sDesc": "삼일절" },
		{ "sDate": "20010405", "nDateType": "1", "sDesc": "식목일" },
		{ "sDate": "20010501", "nDateType": "1", "sDesc": "근로자의날" },
		{ "sDate": "20010505", "nDateType": "1", "sDesc": "어린이날" },
		{ "sDate": "20010526", "nDateType": "1", "sDesc": "석가탄신일" },
		{ "sDate": "20010606", "nDateType": "1", "sDesc": "현충일" }
	];
	dataList1.setJSON(jsonData, true);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataDragDrop="true" dataList="data:dataList1" id="gridView1"
			style="position: absolute ;left:23px;top:21px;width:365px;height:102px;">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" style="height:20px" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column3" style="height:20px" inputType="expression" width="70" expression="SUM('nDateType')" value="name2"></w2:column>
					<w2:column id="column1" style="height:20px" width="70" inputType="text" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="sDate" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="nDateType" style="height:20px" inputType="text" width="70" dataType="number" displayFormat="#,##0"></w2:column>
					<w2:column id="sDesc" style="height:20px" width="70" inputType="text" textAlign="right"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView dataDragDrop="true" dataList="data:dataList2" id="gridView2"
			style="position: absolute ;left:23px;top:182px;width:365px;height:102px;">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" inputType="text" style="height:20px" value="name1" width="70"></w2:column>
					<w2:column expression="SUM('nDateType')" id="column3" inputType="expression" style="height:20px" width="70" value="name2"></w2:column>
					<w2:column id="column1" inputType="text" style="height:20px" value="name3" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="sDate" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column dataType="number" displayFormat="#,##0" id="nDateType" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column id="sDesc" inputType="text" style="height:20px" textAlign="right" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger2" style="position: absolute ;left:422px;top:22px;width: 226px;height: 34px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[gridView1.setDataDragDrop(true)]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3" style="position: absolute ;left:422px;top:70px;width: 226px;height: 34px;" type="button">
			<xf:label><![CDATA[gridView1.setDataDragDrop(false)]]></xf:label>
		</xf:trigger>
	</body>
</html>
 