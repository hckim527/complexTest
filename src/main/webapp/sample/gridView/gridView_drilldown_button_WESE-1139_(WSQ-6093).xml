<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_sample" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="menuId" name="menuId" dataType="number"></w2:column>
						<w2:column id="menuLevel" name="menuLevel" dataType="number"></w2:column>
						<w2:column id="menuName" name="menuName" dataType="text"></w2:column>
						<w2:column id="menuPath" name="menuPath" dataType="text"></w2:column>
						<w2:column id="parentMenuId" name="parentMenuId" dataType="number"></w2:column>
						<w2:column id="sourcePath" name="sourcePath" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	dlt_sample.setJSON([
		{ menuId: 2, parentMenuId: 0, menuLevel: 1, menuName: "샘플화면", sourcePath: "" },
		{ menuId: 2000, parentMenuId: 2, menuLevel: 2, menuName: "UI공통샘플", sourcePath: "" },
		{ menuId: 2001, parentMenuId: 2000, menuLevel: 3, menuName: "통신테스트", menuPath: "UI공통샘플>통신테스트", sourcePath: "/ui/sample/submission.xml" },
		{ menuId: 2002, parentMenuId: 2000, menuLevel: 3, menuName: "메시지박스", menuPath: "UI공통샘플>메시지박스", sourcePath: "/ui/sample/message.xml" },
		{ menuId: 2003, parentMenuId: 2000, menuLevel: 3, menuName: "공통코드", menuPath: "UI공통샘플>공통코드", sourcePath: "/ui/sample/commonCode.xml" },
		{ menuId: 2004, parentMenuId: 2000, menuLevel: 3, menuName: "비즈샘플", menuPath: "UI공통샘플>비즈샘플", sourcePath: "/ui/sample/biz_sample.xml" }
	]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<!-- drilldownIconRenderType="button" : drilldown 아이콘을 span 대신 button 으로 렌더링(웹접근성) -->
		<w2:gridView id="grd_sample" class="wq_gvw" dataList="data:dlt_sample" drilldownIconRenderType="button" readOnly="true" style="height: 300px;" autoFit="allColumn">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="38" style="height:24px" id="column20" value="menuId" displayMode="label"></w2:column>
					<w2:column width="142" style="height:24px;" id="column9" value="menuName" displayMode="label"></w2:column>
					<w2:column width="130" style="height:24px" id="column23" value="menuPath" displayMode="label"></w2:column>
					<w2:column width="130" style="height:24px;" id="column7" value="sourcePath" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" style="height:24px" id="menuId" displayMode="label"></w2:column>
					<w2:column depthType="div" textAlign="left" width="180" inputType="drilldown" style="height:24px;" id="menuName" showDepth="3" depthColumn="menuLevel" displayMode="label"></w2:column>
					<w2:column width="70" style="height:24px;" id="menuPath" displayMode="label"></w2:column>
					<w2:column width="200" style="height:24px;" id="sourcePath" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
