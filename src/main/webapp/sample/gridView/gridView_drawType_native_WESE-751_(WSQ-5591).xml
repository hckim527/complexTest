<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" removeDummyRowStatus="true" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="number"></w2:column>
						<w2:column id="col5" name="name5" dataType="number"></w2:column>
						<w2:column id="col6" name="name6" dataType="number"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// 데이터 없는 상태에서 컬럼 이동 후 데이터 설정
scwin.trigger1_onclick = function (e) {
	var tmpJSON = [];
	for (var i = 0; i < 5; i++) {
		tmpJSON.push({ "col1": "1", "col2": "2", "col3": "3", "col4": "4", "col5": "5", "col6": "6" });
	}
	dataList1.setJSON(tmpJSON);
};

scwin.checkVal = function() {
	var temp = WebSquare.logger.getLog();
	return temp.indexOf('Cannot read properties of undefined') == -1;
};
]]></script>
	</head>
	<body>
		<w2:gridView id="gridView1" style="position:absolute;top:31px;left:40px;width:705px;height:419px;" dataList="data:dataList1" drawType="native" columnMove="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column6" value="1" displayMode="label" excelwidth="200" fixColumnWidth="true"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="2" displayMode="label" excelwidth="200"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="3" displayMode="label" excelwidth="600"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="4" displayMode="label" excelwidth="800"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column2" value="5" displayMode="label" excelwidth="200"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="6" displayMode="label" excelwidth="200"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label" editModeEvent="onclick" colMerge="false"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label" colMerge="false"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label" colMerge="false"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4" displayMode="label" colMerge="false"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col5" displayMode="label" colMerge="false"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col6" displayMode="label" colMerge="false"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position:absolute;top:134px;left:801px;width:199px;height:23px;"
			ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setJSON]]></xf:label>
		</xf:trigger>
	</body>
</html>
