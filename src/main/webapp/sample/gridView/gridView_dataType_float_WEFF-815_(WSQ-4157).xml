<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="text"/>
						<w2:column id="col3" name="name3" dataType="text"/>
						<w2:column id="col4" name="name4" dataType="text"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.insertRow();
	dataList1.insertRow();
	dataList1.insertRow();
}
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" fixedColumnWithHidden="true" id="gridView1" showSortableUseFilter="false" style="position: relative;width: 350px;height: 200px;" useFilterList="false" useShiftKey="true" checkReadOnlyOnPaste="true" checkReadOnlyOnCut="ture">
			<w2:caption id="caption1" value="this is a grid caption."/>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="column7" inputType="text" style="height:20px" value="readOnly" width="70"/>
					<w2:column displayMode="label" id="column5" inputType="text" style="height:20px" value="float" width="70"/>
					<w2:column displayMode="label" id="column3" inputType="text" style="height:20px" value="number" width="70"/>
					<w2:column displayMode="label" id="column1" inputType="text" style="height:20px" value="name4" width="70"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="col1" inputType="text" style="height:20px" width="70" readOnly="true"/>
					<w2:column displayMode="label" id="col2" inputType="text" style="height:20px" width="70" dataType="float" applyFormat="all" maxLength="6.4"/>
					<w2:column displayMode="label" id="col3" inputType="text" style="height:20px" width="70" dataType="number" maxLength="4"/>
					<w2:column displayMode="label" id="col4" inputType="text" style="height:20px" width="70"/>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
