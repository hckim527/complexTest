<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<w2:MSA/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="text"/>
						<w2:column id="col3" name="name3" dataType="text"/>
						<w2:column id="col4" name="name4" dataType="text"/>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[2]]></col2>
							<col3><![CDATA[3]]></col3>
							<col4><![CDATA[4]]></col4>
						</w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<w2:layoutInfo/>
		<w2:publicInfo method=""/>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.btn_downloadExcelBasic_onclick = function(e) {
	var infoArr = {};
	var options = {
		fileName:           "excel_sort_useStyle.xlsx",
		type:               "1",
		removeColumns:      "",
		startRowIndex:      5,
		startColumnIndex:   0,
		headerColor:        "#FF0000",
		footerColor:        "#92CDDC",
		useStyle:        true,
		footerFontBold:        true
	};
	options.bodyFontName = "굴림";
	options.bodyFontSize = "15";
	gridView1.advancedExcelDownload(options,infoArr);
};
		]]></script>
		<style type="text/css"><![CDATA[
.test {background-color:red; color:yellow; }
		]]></style>
	</head>
	<body>
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;" checkAllType="false" defaultCellHeight="20" dataList="data:dataList1" senseReader="true">
			<w2:caption id="caption2" value="this is a grid caption."/>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column6" value="name1" displayMode="label"/>
					<w2:column width="70" inputType="text" id="column5" value="name2" displayMode="label"/>
					<w2:column width="70" inputType="text" id="column4" value="name3" displayMode="label"/>
					<w2:column width="70" inputType="text" id="column3" value="name4" displayMode="label"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"/>
					<w2:column width="70" inputType="calendar" id="col2" displayMode="label"/>
					<w2:column width="70" inputType="text" id="col3" displayMode="label"/>
					<w2:column width="70" inputType="text" id="col4" displayMode="label" class="test"/>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row5">
					<w2:column width="70" inputType="text" id="column10" displayMode="label" class="test"/>
					<w2:column width="70" inputType="text" id="column9" displayMode="label"/>
					<w2:column width="70" inputType="text" id="column8" displayMode="label"/>
					<w2:column width="70" inputType="text" id="column7" displayMode="label"/>
				</w2:row>
			</w2:footer>
		</w2:gridView>
		<xf:trigger class="btn_cm download" ev:onclick="scwin.btn_downloadExcelBasic_onclick" id="btn_downloadExcelBasic" toolTip="그리드의 데이터를 엑셀로 다운로드 한다." type="button">
			<xf:label><![CDATA[엑셀다운로드]]></xf:label>
		</xf:trigger>
	</body>
</html>
