<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="selectList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="value" name="value" dataType="text"></w2:column>
						<w2:column id="label" name="label" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	selectList1.setJSON([
		{ "value": "a1", "label": "가" },
		{ "value": "a2", "label": "나" },
		{ "value": "b3", "label": "다" }
	]);
	dataList1.setJSON([{ "col1": "a1" }, { "col1": "a3" }, { "col1": "b2" }]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1"
			style="position: absolute ;left:35px;top:23px;width:590px;height:226px;" fixedColumnWithHidden="true"
			enterKeyMove="edit" autoFit="allColumn" fastScroll="true" focusMode="cell" preventCopy="false" rowNumVisible="true" rowStatusWidth="30" sortEvent="onclick" focusMove="true" arrowMove="true" preventPaste="false">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column blockSelect="false" id="column3" style="height:20px" inputType="text" width="170" value="dataList"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column blockSelect="false" id="col1" style="height:20px" inputType="autoComplete" width="170" chooseOption="true"
						chooseOptionLabel="$blank" editType="focus" viewType="icon" sortLabel="true" sortable="true" displayMode="value delim label">
						<w2:choices>
							<w2:itemset nodeset="data:selectList1">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
