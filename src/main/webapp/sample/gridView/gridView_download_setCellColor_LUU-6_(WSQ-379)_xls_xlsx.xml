<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="text"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.exceldown = function(fileName) {
	var options = {};
	options.fileName = fileName;
	options.type = "1";
	options.useStyle = "true";
	options.spanAll = "true";
	gridView1.advancedExcelDownload(options);
};
scwin.trigger1_onclick = function(e) {
	scwin.exceldown("excel.xls");
};
scwin.trigger2_onclick = function(e) {
	scwin.exceldown("excel.xlsx");
};
scwin.onpageload = function() {
	dataList1.setJSON([{"col1": '"Test1"', "col2": "A"}, {"col1": '"Test2"', "col2": "B"}, {"col1": '"Test3"', "col2": "C"}, {"col1": '"Test4"', "col2": "D"}, {"col1": '"Test5"', "col2": "E"}, {"col1": '"Test6"', "col2": "F"}]);
	gridView1.setCellColor(0, 1, "red");
};
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width:256px;height:200px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column7" style="height:20px" inputType="text" width="70" value="name1"/>
					<w2:column id="column3" style="height:20px" width="70" inputType="text" value="name2"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" inputType="text" width="70"/>
					<w2:column id="col2" style="height:20px" width="70" inputType="text"/>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;margin-top:21px;left:65px;top:-21px;margin-left:-65px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[Down (xls)]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigge2" style="position: relative;width: 80px;height: 23px;margin-top:23px;left:-62px;top:-22px;margin-left:-55px;" type="button">
			<xf:label><![CDATA[Down (xlsx)]]></xf:label>
		</xf:trigger>
	</body>
</html>
