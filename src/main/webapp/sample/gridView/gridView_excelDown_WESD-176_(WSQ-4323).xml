<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="종류" dataType="text"></w2:column>
						<w2:column id="col2" name="금액" dataType="number"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="number"></w2:column>
						<w2:column id="col5" name="hidden" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data xmlns="" use="false"></w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger3_onclick = function() {
	var options = {
		headerExist: "1",
		sheetName: "sheet2"
	};
	gridView1.advancedExcelUpload(options);
};
]]></script>
	</head>
	<body>
		<xf:group style="padding:20px;" id="">
			<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3" style="width: 180px;height: 100px;margin-bottom: 30px;margin-left:35px;" type="button">
				<xf:label><![CDATA[upload]]></xf:label>
			</xf:trigger>
		</xf:group>
		<w2:gridView id="gridView1" syncScroll="false" useShiftKey="true" style="width:611px;height:150px;" defaultCellHeight="20" applyAllColumnStyle="false" dataList="data:dataList1">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" removeBorderStyle="false" style="height:20px;" inputType="text" width="120" value="종류" displayMode="label"></w2:column>
					<w2:column id="column1" removeBorderStyle="false" style="height:20px;" width="144" inputType="text" value="금액" displayMode="label"></w2:column>
					<w2:column id="column6" removeBorderStyle="false" style="height:20px;" width="144" inputType="text" value="금액" displayMode="label"></w2:column>
					<w2:column id="column4" removeBorderStyle="false" style="height:20px;" inputType="text" width="120" value="expression" displayMode="label"></w2:column>
					<w2:column id="column2" removeBorderStyle="false" style="height:20px;" inputType="text" width="120" value="expression" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" removeBorderStyle="false" inputType="textImage" width="120" displayMode="label" imageSrc="/img01.jpg" imageWidth="30" imageHeight="30"></w2:column>
					<w2:column id="col2" removeBorderStyle="false" width="144" inputType="text" displayFormat="" displayMode="label"></w2:column>
					<w2:column id="col3" removeBorderStyle="false" width="144" inputType="text" displayFormat="#,##0[floor]" displayMode="label" dataType="number"></w2:column>
					<w2:column id="col4" removeBorderStyle="false" inputType="expression" width="120" displayMode="label" expression="sum('col2') + sum('col3')" displayFormat="#,##0" dataType="number"></w2:column>
					<w2:column id="col5" removeBorderStyle="false" inputType="text" width="120" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
