						<w2:column id="errCn" name="결함내용" dataType="text"></w2:column>
						<w2:column id="cmmnPr" name="공통처리여부" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	// row 1: testNm(textarea 앞 컬럼)="김00", errCn(textarea)="결함1"
	dlt_defectListResVO.setJSON([
		{ "_chk": "false", "defectSn": "SEQ", "bizGb": "업무구분", "scrnId": "화면ID", "scrnNm": "화면명", "testDt": "테스트일자", "testNm": "테스트담당자", "errCn": "결함내용", "cmmnPr": "공통처리여부" },
		{ "_chk": "", "defectSn": "", "bizGb": "1", "scrnId": "12121212", "scrnNm": "SFCS_CMSF998M", "testDt": "20220509", "testNm": "김00", "errCn": "결함1", "cmmnPr": "Y" },
		{ "_chk": "", "defectSn": "", "bizGb": "1", "scrnId": "12121212", "scrnNm": "SFCS_CMSF999M", "testDt": "20220509", "testNm": "김01", "errCn": "결함2", "cmmnPr": "Y" }
