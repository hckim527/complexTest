};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView autoFit="none" dataList="data:dlt_defectListResVO" defaultCellHeight="28" id="grd_Defect" editType="select" keyMoveEditMode="true" enterKeyMove="right" rowNumVisible="true" rowStatusVisible="true" style="width:1300px;height:300px;">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="column1" inputType="checkbox" value="선택" width="50" checkboxLabel="check" style="height:28px;"></w2:column>
					<w2:column width="0" inputType="text" style="height:28px" id="column26" value="SEQ" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:28px" id="column28" value="업무구분" displayMode="label"></w2:column>
					<w2:column displayMode="label" id="column11" inputType="text" value="화면ID" width="100" style="height:28px;"></w2:column>
					<w2:column displayMode="label" id="column9" inputType="text" value="화면명" width="200" style="height:28px;"></w2:column>
					<w2:column displayMode="label" id="column5" inputType="text" value="테스트일자" width="100" style="height:28px;"></w2:column>
