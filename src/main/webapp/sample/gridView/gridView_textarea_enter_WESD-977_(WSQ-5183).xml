					<w2:column width="100" inputType="text" id="column23" value="공통처리여부" displayMode="label" style="height:28px;"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="_chk" inputType="checkbox" width="50" value="값" checkboxLabel="check"></w2:column>
					<w2:column width="0" inputType="text" style="height:28px" id="defectSn" displayMode="label" readOnly="true"></w2:column>
					<w2:column width="100" inputType="text" id="bizGb" displayMode="label"></w2:column>
					<w2:column displayMode="label" id="scrnId" inputType="text" width="200" dataType="text" maxByteLength="15"></w2:column>
					<w2:column displayMode="label" id="scrnNm" inputType="text" width="200" dataType="text" maxByteLength="100" textAlign="left"></w2:column>
					<w2:column width="150" inputType="text" id="testDt" displayMode="label" dataType="text"></w2:column>
					<w2:column displayMode="label" id="testNm" inputType="text" width="100" dataType="text" maxByteLength="100"></w2:column>
					<w2:column width="350" inputType="textarea" id="errCn" displayMode="label" dataType="text" maxByteLength="2000" textAlign="left"></w2:column>
					<w2:column displayMode="label" id="cmmnPr" inputType="text" width="100" dataType="text" maxByteLength="100"></w2:column>
				</w2:row>
			</w2:gBody>
