<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dl_combo" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{
		"col1": "value1",
		"col2": "222"
	}, {
		"col1": "value3",
		"col2": "444"
	}];
	dataList1.setJSON(jsonData);
	var comboJSON = [{
		"label": "label1",
		"value": "value1"
	}, {
		"label": "label2",
		"value": "value2"
	}, {
		"label": "label3",
		"value": "value3"
	}, {
		"label": "label4",
		"value": "value4"
	}, {
		"label": "label5label5label5label5label5label5label5label5label5label5label5label5",
		"value": "value5value5value5value5value5"
	}];
	dl_combo.setJSON(comboJSON);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="width:799px;height:150px;" escape="false">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column7" inputType="text" width="141" value="selectbox" displayMode="label"></w2:column>
					<w2:column id="column5" inputType="text" width="141" value="autoComplete" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="select" width="141" displayMode="label" viewType="icon" selectedData="false" viewTypeIconImage="true" selectedDataOnPaste="both">
						<w2:choices>
							<w2:gridViewItemset visibleRowNum="10" width="400" nodeset="data:dl_combo" value="value" label="label">
								<w2:item ref="label" header="라벨"></w2:item>
								<w2:item ref="value" header="값"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col2" inputType="autoComplete" width="141" displayMode="label" caseSensitive="false" viewType="icon" selectedData="false" viewTypeIconImage="true" noResult="previous" selectedDataOnPaste="both">
						<w2:choices>
							<w2:gridViewItemset autoFit="lastColumn" nodeset="data:dl_combo" width="300" label="label" rowNumVisible="true" height="240" value="value" rowStatusVislble="true">
								<w2:item ref="label" header="라벨"></w2:item>
								<w2:item ref="value" header="값"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
