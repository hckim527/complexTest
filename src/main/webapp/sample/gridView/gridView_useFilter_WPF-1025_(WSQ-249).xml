		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.hasFilterClass = function() {
	var el = scwin.__getDom($p.id + 'grid_emp_list_column13_filter');
	return el.classList.contains('w2grid_customFilter_filter');
}
scwin.onpageload = function() {
	window.pageFunc = {};
	/* 행추가 버튼 클릭 */
	pageFunc.trigger1_onclick = function(e) {
		window.idx = dl_empInfo.insertRow(0);
		grid_emp_list.setReadOnly("cell", idx, "EMPNO", false);
		grid_emp_list.setDisabled("cell", idx, "SAL", false);
	};
	pageFunc.trigger222_onclick = function(e) {
		grid_emp_list.initGrid();
	};
};
]]></script>
