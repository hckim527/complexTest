	};
	grid2.setCellInputType(0, 0, info);
	var info = {
		inputType: "calendar"
	};
	grid2.setCellInputType(1, 0, info);
	var info = {
		inputType: "select",
		itemSet: {
			label: "",
			nodeset: "",
			value: ""
		},
		options: {
			selectedData: "false",
			viewType: "icon"
		}
	};
