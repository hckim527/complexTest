<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="id1" name="name1" dataType="text"></w2:column>
						<w2:column id="id2" name="name2" dataType="text"></w2:column>
						<w2:column id="id3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList2.setJSON([{ "col1": "aa", "col2": "a_name" }, { "col1": "bb", "col2": "b_name" }]);
	dataList1.setJSON([{ "id1": "a1", "id2": "aa", "id3": "aa" }, { "id1": "b1", "id2": "bb", "id3": "bb" }]);
	gridView1.setColumnNodeSet("id3", "data:dataList2", "col2", "col1");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" style="position: absolute ;left:10px;top:9px;width:592px;height:194px;" useShiftKey="true" useFilterList="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column7" style="height:20px;" inputType="text" width="100" value="name1" useFilter="true"></w2:column>
					<w2:column id="column3" style="height:20px;" width="100" inputType="text" value="nodeSet" useFilter="true"></w2:column>
					<w2:column id="column8" style="height:20px;" inputType="text" width="185" displayMode="label" value="setColumnNodeSet" useFilter="true"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="id1" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="id2" style="height:20px" inputType="select" width="100">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="col2"></w2:label>
								<w2:value ref="col1"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="id3" style="height:20px" inputType="select" width="185" displayMode="label">
						<w2:choices></w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
