						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[a]]></col2>
							<col5><![CDATA[*]]></col5>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[b]]></col2>
							<col5><![CDATA[*]]></col5>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[c]]></col2>
							<col5><![CDATA[*]]></col5>
						</w2:row>
						<w2:row>
							<col1><![CDATA[4]]></col1>
							<col2><![CDATA[d]]></col2>
							<col5><![CDATA[*]]></col5>
						</w2:row>
						<w2:row>
							<col1><![CDATA[5]]></col1>
							<col2><![CDATA[e]]></col2>
							<col5><![CDATA[*]]></col5>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
	gridView2.setColumnWidth(2, 0);
	gridView2.setColumnWidth(4, 0);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" id="gridView1" style="width: 500px;height: 150px;" dataList="data:dataList1">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column7" value="name1"></w2:column>
					<w2:column width="70" inputType="text" id="column6" value="name2"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="name3"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name4"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="col1"></w2:column>
					<w2:column width="70" inputType="text" id="col2"></w2:column>
