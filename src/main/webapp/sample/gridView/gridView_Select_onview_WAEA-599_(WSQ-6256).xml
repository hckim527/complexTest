<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<w2:layoutInfo/>
		<w2:publicInfo method=""/>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.gridView1_onviewchange = function(info) {
	console.log("grd1_onviewchange");
	dataList1.setCellData(info.rowIndex, 1, "");
	gridView1.setFocusedCell(info.rowIndex, 1, true);
};
]]></script>
	</head>
	<body>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width:500px;height:150px;" dataList="data:dataList1" focusFlow="linear" ev:onviewchange="scwin.gridView1_onviewchange" editModeEvent="onclick">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column6" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name4" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="select" id="col3" displayMode="label" allOption="true" chooseOption="true">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[q]]></w2:label>
								<w2:value><![CDATA[1]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[w]]></w2:label>
								<w2:value><![CDATA[2]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[e]]></w2:label>
								<w2:value><![CDATA[3]]></w2:value>
							</w2:item>
						</w2:choices></w2:column>
					<w2:column width="70" inputType="text" id="col4" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
