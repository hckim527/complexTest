<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="chk" name="checkbox" dataType="text"></w2:column>
						<w2:column id="col1" name="A" dataType="text"></w2:column>
						<w2:column id="col2" name="B" dataType="text"></w2:column>
						<w2:column id="col3" name="C" dataType="text"></w2:column>
						<w2:column id="col4" name="U1" dataType="text"></w2:column>
						<w2:column id="col5" name="U2" dataType="text"></w2:column>
						<w2:column id="col6" name="U3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var data = [];
	var cnt = 100;
	for (var i = 0; i < cnt; i++) {
		data.push((i % 2) + "");
		data.push("A" + (i % 10));
		data.push("B" + (3 - (i % 3)));
		data.push("C" + ((i + 3) % 7));
		if (i % 2) {
			data.push("T");
		} else {
			data.push("F");
		}
		if (i < (cnt / 3)) {
			data.push("###");
		} else if (i < (cnt * 2 / 3)) {
			data.push("$$$");
		} else {
			data.push("한글");
		}
		data.push(Math.floor(Math.sqrt(i)));
	}
	dataList1.setData(data);
};
scwin.gridView1_ongroupby = function(options) {
	options.groupbyHeader = [
		{inputType: "expression", expression: "toggle()+depthStr()"}
	];
	options.hideFooter = true;
	gridView1.groupby(options);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="">
			<w2:gridView ev:ongroupby="scwin.gridView1_ongroupby" groupbyZone="true"
				dataList="data:dataList1" style="width:800px;height:353px;" id="gridView1" autoFit="allColumn"
				closeGroup="true" defaultCellHeight="20" groupbyZoneSearch="true">
				<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column width="70" inputType="checkbox" style="height:20px" id="column7" value="checkbox" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column6" value="A" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column5" value="B" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column4" value="C" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column3" value="U1" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column2" value="U2" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="column1" value="U3" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column width="70" inputType="checkbox" style="height:20px" id="chk" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col4" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col5" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px" id="col6" displayMode="label"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
