<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true" useCellStatus="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="number"></w2:column>
						<w2:column id="col2" name="name2" dataType="number"></w2:column>
						<w2:column id="col3" name="name3" dataType="number"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
	var data = [];
	for (var i = 0; i < 5; i++) {
		for (var j = 0; j < 3; j++) {
			data.push((i * 100 + j) + "");
		}
	}
	dataList1.setData(data);
};

// WAEA-698: undoRow 시 cellStatus 도 초기화되어야 함
scwin.trigger2_onclick = function (e) {
	dataList1.undoRow(0);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width:700px;height:297px;" defaultCellHeight="20" dataList="data:dataList1"
			cellStatusVisible="true" cellStatusIconPosition="left" rowStatusVisible="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="120" inputType="text" style="height:20px" id="column22" value="name1" displayMode="label" dataType="number"></w2:column>
					<w2:column width="120" inputType="text" style="height:20px" id="column21" value="name2" displayMode="label" dataType="number"></w2:column>
					<w2:column width="120" inputType="text" style="height:20px;" id="column20" value="name3" displayMode="label" dataType="number"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label" dataType="number"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label" dataType="number"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label" dataType="number"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger2" style="width: 100px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[undoRow(0)]]></xf:label>
		</xf:trigger>
	</body>
</html>
