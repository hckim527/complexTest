<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="select" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="autoComplete" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="select gridviewItemset" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="autoComplete gridviewItemset" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setJSON([
		{"col1":"101","col2":"201","col3":"301"},
		{"col1":"102","col2":"202","col3":"302"},
		{"col1":"103","col2":"203","col3":"303"},
		{"col1":"104","col2":"204","col3":"304"},
		{"col1":"105","col2":"205","col3":"305"}
	]);
	dataList2.setJSON([
		{"col1":"101L","col2":"101V"},
		{"col1":"102L","col2":"102V"},
		{"col1":"103L","col2":"103V"},
		{"col1":"104L","col2":"104V"}
	]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width:929px;height:150px;" defaultCellHeight="20" dataList="data:dataList1" focusFlow="linear" tabKeyMove="down" keyMoveEditMode="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column2" value="select" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="name3" displayMode="label"></w2:column>
					<w2:column width="85" inputType="text" style="height:20px;" id="column4" value="autoComplete" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px;" id="column6" value="name5" displayMode="label"></w2:column>
					<w2:column width="189" inputType="text" style="height:20px;" id="column8" value="select gridviewItemset" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px;" id="column10" value="name7" displayMode="label"></w2:column>
					<w2:column width="204" inputType="text" style="height:20px;" id="column12" value="autoComplete gridviewItemset" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column14" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="select" style="height:20px" id="col2" displayMode="label" viewType="icon" viewTypeIconImage="true">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
					<w2:column width="85" inputType="autoComplete" id="col4" displayMode="label" viewType="icon" viewTypeIconImage="true">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="text" id="col5" displayMode="label"></w2:column>
					<w2:column width="189" inputType="select" id="col6" displayMode="label" viewType="icon" viewTypeIconImage="true">
						<w2:choices>
							<w2:gridViewItemset nodeset="data:dataList2" width="100" label="col1" value="col2" height="200">
								<w2:item ref="col1"></w2:item>
								<w2:item ref="col2"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="text" id="col7" displayMode="label"></w2:column>
					<w2:column width="204" inputType="autoComplete" id="col8" displayMode="label" viewType="icon" viewTypeIconImage="true">
						<w2:choices>
							<w2:gridViewItemset nodeset="data:dataList2" width="100" label="col1" value="col2" height="200">
								<w2:item ref="col1"></w2:item>
								<w2:item ref="col2"></w2:item>
							</w2:gridViewItemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="text" id="col9" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
