<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var tmpArr = [{"col1":"123","col2":"1","col3":"가"}
				,{"col1":"456","col2":"2","col3":"나"}
				,{"col1":"789","col2":"3","col3":"다"}
				];
	dataList2.setJSON(tmpArr);

	var value = grd1.getFooterData(0);
	input2.setValue(value);
};

scwin.checkVal = function() {
	return (document.getElementById('input2') || document.getElementById('mf_input2')).value == '1368';
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:tabControl useTabKeyOnly="true" id="tabControl1" style="width:500px;height:200px;">
			<w2:tabs style="width:70px;height:30px;" id="tabs1" label="tab1"></w2:tabs>
			<w2:tabs style="width:70px;height:30px;" id="tabs2" label="tab2"></w2:tabs>
			<w2:content alwaysDraw="true" style="height:170px;" id="content1">
				<xf:input adjustMaxLength="false" id="input2" style="width:144px;height:21px;"></xf:input>
			</w2:content>
			<w2:content alwaysDraw="true" style="height:170px;" id="content2">
				<w2:gridView id="grd1" style="width:500px;height:150px;" defaultCellHeight="20" dataList="data:dataList2">
					<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
					<w2:header id="header2">
						<w2:row id="row3">
							<w2:column width="70" inputType="text" style="height:20px;" id="column5" value="name1" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="height:20px;" id="column4" value="name2" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="height:20px;" id="column3" value="name3" displayMode="label"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody2">
						<w2:row id="row4">
							<w2:column width="70" inputType="text" style="height:20px;" id="col1" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="height:20px;" id="col2" displayMode="label"></w2:column>
							<w2:column width="70" inputType="text" style="height:20px;" id="col3" displayMode="label"></w2:column>
						</w2:row>
					</w2:gBody>
					<w2:footer id="footer1">
						<w2:row id="row5">
							<w2:column width="70" inputType="expression" style="height:20px;" id="column11" displayMode="label" expression="SUM('col1')"></w2:column>
							<w2:column width="70" inputType="expression" style="height:20px;" id="column10" displayMode="label" expression="SUM('col2')"></w2:column>
							<w2:column width="70" inputType="text" style="height:20px;" id="column9" displayMode="label"></w2:column>
						</w2:row>
					</w2:footer>
				</w2:gridView>
			</w2:content>
		</w2:tabControl>
	</body>
</html>
