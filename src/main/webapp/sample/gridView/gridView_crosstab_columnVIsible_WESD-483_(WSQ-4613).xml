<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
            col1: "111111",
            col2: "222222",
            col3: "333333",
            col4: "444444",
            col5: "444444",
            col6: "444444",
            col7: "444444"
        }, {
            col1: "111111",
            col2: "222222",
            col3: "333333",
            col4: "444444",
            col5: "444444",
            col6: "444444",
            col7: "444444"
        }, {
            col1: "111111",
            col2: "222222",
            col3: "333333",
            col4: "444444",
            col5: "444444",
            col6: "444444",
            col7: "444444"
        }
    ];
    dataList1.setJSON(jsonData);
};
scwin.trigger1_onclick = function(e) {
    dataList1.insertRow(dataList1.getTotalRow());
};
scwin.trigger2_onclick = function(e) {
    dataList1.insertJSON(dataList1.getTotalRow(), [{
        col1: "111111",
        col2: "222222",
        col3: "333333",
        col4: "444444",
        col5: "444444",
        col6: "444444",
        col7: "444444"
    }]);
};
scwin.trigger3_onclick = function(e) {
    dataList1.setRowJSON(dataList1.getTotalRow(), {
        col1: "111111",
        col2: "222222",
        col3: "333333",
        col4: "444444",
        col5: "444444",
        col6: "444444",
        col7: "444444"
    }, false);
};
scwin.trigger4_onclick = function(e) {
    gridView1.setColumnVisible(1, false);
    gridView1.setColumnVisible(3, false);
};
scwin.trigger5_onclick = function(e) {
    gridView1.setColumnOrder(["col1", "col3", "col5", "col6", "col7"]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width:1200px;height:150px;" defaultCellHeight="20" dataList="data:dataList1" adaptive="crosstab" adaptiveThreshold="1500">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" style="height:20px" id="column7" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column6" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name5" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column2" value="name6" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column1" value="name7" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col5" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col6" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col7" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" style="width: 120px;height: 23px;" id="trigger4" ev:onclick="scwin.trigger4_onclick">
			<xf:label><![CDATA[setColumnVisible]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" style="width: 120px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[insertRow]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" style="width: 120px;height: 23px;" id="trigger2" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[insertJSON]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" style="width: 120px;height: 23px;" id="trigger3" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[setRowJSON]]></xf:label>
		</xf:trigger><xf:trigger type="button" style="width: 120px;height: 23px;" id="trigger5" ev:onclick="scwin.trigger5_onclick">
			<xf:label><![CDATA[setColumnOrder]]></xf:label>
		</xf:trigger>
	</body>
</html>
