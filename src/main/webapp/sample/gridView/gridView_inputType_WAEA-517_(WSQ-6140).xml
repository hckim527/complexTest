<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="text" name="text"></w2:column>
						<w2:column dataType="text" id="link" name="link"></w2:column>
						<w2:column dataType="text" id="checkbox" name="checkbox"></w2:column>
						<w2:column dataType="text" id="select" name="select"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="select" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row><label><![CDATA[Single]]></label><value><![CDATA[Single]]></value></w2:row>
						<w2:row><label><![CDATA[Divorced]]></label><value><![CDATA[Divorced]]></value></w2:row>
						<w2:row><label><![CDATA[Married]]></label><value><![CDATA[Married]]></value></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setJSON([
		{ "text": "10001", "link": "12345", "select": "Single" },
		{ "text": "10001", "link": "Busan", "select": "Divorced" },
		{ "text": "10004", "link": "Daegu", "select": "Married" }
	]);
	gridView1.setCellReadOnly(1, "text", true);
	gridView1.setCellReadOnly(1, "link", true);
	gridView1.setCellReadOnly(1, "checkbox", true);
	gridView1.setCellReadOnly(1, "select", true);
};

scwin.gridView1_oncellclick = function(row, col, colId) {
	console.log("oncellclick : ", row, col, colId);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView autoFit="allColumn" dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="height:300px;" rowNumHeaderValue="순번" rowNumVisible="true"
			ev:oncellclick="scwin.gridView1_oncellclick" checkboxRadioOnCellClick="true" ignoreReadOnlyCellClick="true">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column28" value="text"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column27" value="link"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column26" value="checkbox"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column22" value="select"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" style="height:20px" id="text" editModeEvent="ondblclick" editType="focus"></w2:column>
					<w2:column width="70" inputType="link" style="height:20px" id="link"></w2:column>
					<w2:column width="70" inputType="checkbox" style="height:20px" id="checkbox"></w2:column>
					<w2:column width="70" inputType="select" style="height:20px" id="select" viewType="icon" chooseOption="true" editModeEvent="ondblclick">
						<w2:choices>
							<w2:itemset nodeset="data:select">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
