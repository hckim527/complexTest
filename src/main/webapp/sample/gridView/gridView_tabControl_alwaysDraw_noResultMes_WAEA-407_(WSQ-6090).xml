<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<w2:MSA/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="depth" name="depth" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name2" dataType="text"></w2:column>
						<w2:column id="col5" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection/>
		</xf:model>
		<w2:layoutInfo/>
		<w2:publicInfo method=""/>
	</head>
	<body>
		<w2:tabControl id="tabControl1" alwaysDraw="true" style="width:500px;height:200px;">
			<w2:tabs style="width:70px;height:30px;" id="tabs1" label="1"></w2:tabs>
			<w2:tabs style="width:70px;height:30px;" id="tabs2" label="2"></w2:tabs>
			<w2:content alwaysDraw="true" style="height:170px;" id="content1">
				<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1" style="width:600px;height:200px;">
					<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
					<w2:header id="header1">
						<w2:row id="row1">
							<w2:column id="h_col11" inputType="text" width="20" displayMode="label"></w2:column>
							<w2:column id="h_col2" inputType="text" width="100" value="drilldown" displayMode="label"></w2:column>
							<w2:column id="h_col3" inputType="text" width="70" value="3" displayMode="label"></w2:column>
							<w2:column id="h_col4" inputType="text" width="70" value="4" displayMode="label"></w2:column>
							<w2:column id="h_col5" inputType="text" width="70" value="5" displayMode="label"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody1">
						<w2:row id="row2">
							<w2:column colSpan="2" id="col2" inputType="drilldown" width="100" textAlign="left" displayMode="label" depthColumn="depth" showDepth="4"></w2:column>
							<w2:column id="col3" inputType="text" width="70" displayMode="label"></w2:column>
							<w2:column id="col4" inputType="text" width="70" displayMode="label"></w2:column>
							<w2:column id="col5" inputType="text" width="70" displayMode="label"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</w2:content>
			<w2:content alwaysDraw="true" style="height:170px;" id="content2">
				<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView2" style="width:600px;height:200px;">
					<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
					<w2:header id="header1">
						<w2:row id="row1">
							<w2:column id="h_col11" inputType="text" width="20" displayMode="label"></w2:column>
							<w2:column id="h_col2" inputType="text" width="100" value="drilldown" displayMode="label"></w2:column>
							<w2:column id="h_col3" inputType="text" width="70" value="3" displayMode="label"></w2:column>
							<w2:column id="h_col4" inputType="text" width="70" value="4" displayMode="label"></w2:column>
							<w2:column id="h_col5" inputType="text" width="70" value="5" displayMode="label"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody1">
						<w2:row id="row2">
							<w2:column colSpan="2" id="col2" inputType="drilldown" width="100" textAlign="left" displayMode="label" depthColumn="depth" showDepth="4"></w2:column>
							<w2:column id="col3" inputType="text" width="70" displayMode="label"></w2:column>
							<w2:column id="col4" inputType="text" width="70" displayMode="label"></w2:column>
							<w2:column id="col5" inputType="text" width="70" displayMode="label"></w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</w2:content>
		</w2:tabControl>
