<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true" customFormatter="scwin.doMap">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="number"/>
						<w2:column id="col2" name="name2" dataType="text"/>
						<w2:column id="col3" name="name3" dataType="date"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.doMap = function(obj, jsonData) {};
scwin.onpageload = function() {
	var json = [{
			"col1": "1234567",
			"col2": "col2",
			"col3": "20210520"
		},
		{
			"col1": "7654321",
			"col2": "col2",
			"col3": "20210520"
		},
		{
			"col1": "3425167",
			"col2": "col2",
			"col3": "20210520"
		}
	];
	dataList1.setJSON(json);
	grd.setCellDisabled(0, 0, true)
};
scwin.trigger1_onclick = function(e) {
	grd.advancedExcelDownload({
		fileName: "TEST.xlsx",
		useDataFormat: true
	});
};
scwin.trigger2_onclick = function(e) {
	grd.setFooterDisplayFormat("column8", "#,###");
};
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="grd" style="width: 500px;height: 150px;border: 1px solid black;" defaultCellHeight="20" dataList="data:dataList1" tooltipDisplay="true">
			<w2:caption id="caption2" value="this is a grid caption."/>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column removeBorderStyle="false" width="125" inputType="text" style="height:20px" id="column5" value="name1" displayMode="label"/>
					<w2:column removeBorderStyle="false" width="141" inputType="text" style="height:20px" id="column4" value="name2" displayMode="label"/>
					<w2:column removeBorderStyle="false" width="182" inputType="text" style="height:20px" id="column3" value="name3" displayMode="label"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column removeBorderStyle="false" width="125" inputType="text" style="height:20px" id="col1" displayMode="label" dataType="number"/>
					<w2:column removeBorderStyle="false" width="141" inputType="text" style="height:20px" id="col2" displayMode="label" dataType="text" disabled="true"/>
					<w2:column removeBorderStyle="false" width="182" inputType="text" style="height:20px" id="col3" displayMode="label" dataType="date" displayFormat="yyyy-MM-dd"/>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row5">
					<w2:column removeBorderStyle="false" width="125" inputType="expression" style="height:20px" id="column8" displayMode="label" expression='SUM("col1")'/>
					<w2:column removeBorderStyle="false" width="141" inputType="text" style="height:20px" id="column7" displayMode="label"/>
					<w2:column removeBorderStyle="false" width="182" inputType="text" style="height:20px" id="column6" displayMode="label"/>
				</w2:row>
			</w2:footer>
		</w2:gridView>
		<xf:trigger type="button" style="width:158px;height:38px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[엑셀 다운로드]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width:158px;height:38px;" type="button">
			<xf:label><![CDATA[setFooterDisplayFormat]]></xf:label>
		</xf:trigger>
	</body>
</html>
