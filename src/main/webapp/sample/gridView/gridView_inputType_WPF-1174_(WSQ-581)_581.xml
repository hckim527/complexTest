<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list"
					saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1"
							dataType="text">
						</w2:column>
						<w2:column id="col2" name="name2"
							dataType="text">
						</w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[]]></col1>
							<col2><![CDATA[1111]]></col2>
						</w2:row>
						<w2:row>
							<col2><![CDATA[2222]]></col2>
						</w2:row>
						<w2:row>
							<col2><![CDATA[3333]]></col2>
						</w2:row>
						<w2:row>
							<col2><![CDATA[4444]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.dbClick = function(id) {
	var el = scwin.__getDom($p.id + id);
	scwin.fireDbClick(el);
}
scwin.fireDbClick = function(node) {
	if (document.createEventObject) {
		node.fireEvent('ondblclick');
	} else if (document.createEvent) {
		var evt = document.createEvent('MouseEvents');
		evt.initEvent('dblclick', true, false);
		node.dispatchEvent(evt);
	} else if (typeof node.ondblclick == 'function') {
		node.ondblclick();
	}
}
scwin.onpageload = function() {
	gridView1.setFooterValue(0, "test1");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1"
			style="position: relative;width: 500px;height: 150px;"
			fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1"
						style="height:20px;" width="150" inputType="text"
						displayMode="label" value="name1">
					</w2:column>
					<w2:column id="column3"
						style="height:20px;" inputType="text" width="70"
						displayMode="label" value="name2">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1"
						style="height:20px;" width="150" inputType="select"
						displayMode="value delim label" delimiter="/"
						chooseOptionLabel="">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[111]]></w2:label>
								<w2:value><![CDATA[111]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[222]]></w2:label>
								<w2:value><![CDATA[222]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[333]]></w2:label>
								<w2:value><![CDATA[333]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
					<w2:column id="col2"
						style="height:20px" inputType="text" width="70"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column id="column2"
						style="height:20px" width="150" inputType="text"
						displayMode="label">
					</w2:column>
					<w2:column id="column5"
						style="height:20px" inputType="expression" width="70"
						displayMode="label" expression="sum('col2')">
					</w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
	</body>
</html>
 