<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
						<w2:column id="col10" name="name10" dataType="text"></w2:column>
						<w2:column id="col11" name="name11" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dl_select" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name3" dataType="text"></w2:column>
						<w2:column id="col5" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
    var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
    var r = d(id); if (r) return r;
    var s = dd(P + id); r = d(s); if (r) return r;
    var g = s.indexOf('G_');
    if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
    return d(s.replace(P, ''));
};
scwin.onpageload = function() {
    var jsonData1 = [{
        "col1": "a",
        "col2": "a",
        "col3": "true",
        "col4": "true",
        "col5": "false"
    }, {
        "col1": "b",
        "col2": "b",
        "col3": "true",
        "col4": "false",
        "col5": "true"
    }, {
        "col1": "c",
        "col2": "c",
        "col3": "false",
        "col4": "false",
        "col5": "true"
    }, {
        "col1": "d",
        "col2": "d",
        "col3": "true",
        "col4": "true",
        "col5": "false"
    }];
    dl_select.setJSON(jsonData1);
    gridView1.setColumnVisibleColumn("col10", "col3");
    gridView1.setColumnVisibleColumn("col1", "col4");
    gridView1.setColumnVisibleColumn("col2", "col5");
};
scwin.trigger2_onclick = function(e) {
    dataList1.insertRow();
};
scwin.dbClick = function(id) {
    var el = scwin.__getDom($p.id + id);
    scwin.fireDbClick(el);
}
scwin.fireDbClick = function(node) {
    if (document.createEventObject) {
        node.fireEvent('ondblclick');
    } else if (document.createEvent) {
        var evt = document.createEvent('MouseEvents');
        evt.initEvent('dblclick', true, false);
        node.dispatchEvent(evt);
    } else if (typeof node.ondblclick == 'function') {
        node.ondblclick();
    }
}
scwin.checkHidden = function() {
    var elem = document.getElementsByClassName('w2table_sb_row');
    var f1 = elem.length === 3;
    var f2 = elem.length === 4 && elem[2].getAttribute("data-wqhidden") === "true";
    return f1 || f2;
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style='position:relative;width : 500px;height: 150px;'>
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column21" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column19" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column17" inputType="text" width="70" value="name3" displayMode="label"></w2:column>
					<w2:column id="column15" inputType="text" width="70" value="name4" displayMode="label"></w2:column>
					<w2:column id="column13" inputType="text" width="70" value="name5" displayMode="label"></w2:column>
					<w2:column id="column11" inputType="text" width="70" value="name6" displayMode="label"></w2:column>
					<w2:column id="column9" inputType="text" width="70" value="name7" displayMode="label"></w2:column>
					<w2:column id="column7" inputType="text" width="70" value="name8" displayMode="label"></w2:column>
					<w2:column id="column5" inputType="text" width="70" value="name9" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name10" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name11" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col10" inputType="select" width="70" displayMode="label" allOption="" chooseOption="" ref="">
						<w2:choices>
							<w2:itemset nodeset="data:dl_select">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col1" inputType="autoComplete" width="70" displayMode="label">
						<w2:choices>
							<w2:itemset nodeset="data:dl_select">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col2" inputType="checkcombobox" width="70" displayMode="label">
						<w2:choices>
							<w2:itemset nodeset="data:dl_select">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col3" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col4" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col5" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col6" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col7" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col8" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col9" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col11" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger2" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[insertRow]]></xf:label>
		</xf:trigger>
	</body>
</html>
