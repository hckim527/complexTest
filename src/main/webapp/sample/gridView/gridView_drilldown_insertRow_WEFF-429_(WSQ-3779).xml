<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="nameDis" name="name1" dataType="text"></w2:column>
						<w2:column id="levelCnt" name="name2" dataType="text"></w2:column>
						<w2:column id="menuId" name="name3" dataType="text"></w2:column>
						<w2:column id="ro" name="name4" dataType="text"></w2:column>
						<w2:column id="proName" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [{
        "nameDis": "AAA",
        "levelCnt": "1",
        "menuId": "10001",
        "ro": "",
        "proName": "PRO1"
    }];
    dataList1.setJSON(jsonData);
};
// 화면 첫 Row 의 실제 index 에 빈 Row 삽입 — Grid 에도 같은 위치(첫 Row)에 표시되어야 함
scwin.trigger1_onclick = function(e) {
    var gri = gridView1.getRealRowIndex(0);
    dataList1.insertRow(gri);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" id="trigger1" style="position: relative;width:157px;height:63px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[dataList insertRow]]></xf:label>
		</xf:trigger>
		<w2:gridView fixedColumnWithHidden="true" id="gridView1" rowNumHeaderValue="순번" rowNumVisible="true" rowNumWidth="40" style="position: relative;width:100%;height:337px;" dataList="dataList1" fixedColumn="2" keyMoveEditMode="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column21" inputType="text" style="height:25px;" value="레벨" width="50">
					</w2:column>
					<w2:column id="column19" inputType="text" style="height:25px;" value="메뉴ID" width="100" fixColumnWidth="true">
					</w2:column>
					<w2:column id="column23" style="height:25px;" inputType="text" width="70" value="RO">
					</w2:column>
					<w2:column id="column17" inputType="text" style="height:25px;" value="메뉴명" width="200"></w2:column>
					<w2:column id="column15" inputType="text" style="height:25px;" value="프로그램명" width="200">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="levelCnt" inputType="text" style="height:25px;" width="50" fixColumnWidth="true">
					</w2:column>
					<w2:column id="menuId" inputType="text" style="height:25px;" width="100"></w2:column>
					<w2:column id="ro" style="height:25px" inputType="text" width="70">
					</w2:column>
					<w2:column id="nameDis" inputType="drilldown" style="height:25px;" width="200" depthColumn="levelCnt" showDepth="4" depthType="div" textAlign="left">
					</w2:column>
					<w2:column id="proName" inputType="text" style="height:25px;" width="200"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
