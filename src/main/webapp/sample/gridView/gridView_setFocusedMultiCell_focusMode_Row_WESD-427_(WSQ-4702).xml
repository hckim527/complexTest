<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name3" dataType="text"></w2:column>
						<w2:column id="col5" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	for (var i = 0; i < 5; i++) {
		dataList1.insertRow();
	}
};
scwin.trigger1_onclick = function() {
	gridView1.setFocusedMultiCell(1, 1, 3, 3, {
		ignoreFocusMode: true
	});
};
scwin.trigger2_onclick = function() {
	gridView1.setFocusedMultiCell(1, 1, 3, 3);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" focusMode="row" style="width: 500px;height: 150px;">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column9" width="70" inputType="text" value="name1"></w2:column>
					<w2:column id="column7" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column5" inputType="text" width="70" value="name3"></w2:column>
					<w2:column id="column3" width="70" inputType="text" value="name4"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="text" width="70"></w2:column>
					<w2:column id="col2" inputType="text" width="70"></w2:column>
					<w2:column id="col3" width="70" inputType="text"></w2:column>
					<w2:column id="col4" width="70" inputType="text"></w2:column>
					<w2:column id="col5" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative ;left:0px;top:9px;width: 280px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setFocusedMultiCell ignore focusMode]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position: relative ;left:0px;top:9px;width: 280px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[setFocusedMultiCell]]></xf:label>
		</xf:trigger>
	</body>
</html>
