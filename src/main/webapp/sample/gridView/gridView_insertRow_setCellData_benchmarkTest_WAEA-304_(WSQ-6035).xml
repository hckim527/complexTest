		<script type="text/javascript" lazy="false"><![CDATA[
// 컬럼 10개 × 100/1000/10000 행 insertRow + setCellData 소요 시간(초)을 tc_10_<행수> 에 표시
scwin.btn_st_onclick = function(e) {
	ds_cal10_1.setBroadcast(false);
	ds_cal10_2.setBroadcast(false);
	ds_cal10_3.setBroadcast(false);

	scwin.setData2(ds_cal10_1, tc_10_100, 10, 100);
	scwin.setData2(ds_cal10_2, tc_10_1000, 10, 1000);
	scwin.setData2(ds_cal10_3, tc_10_10000, 10, 10000);

	ds_cal10_1.setBroadcast(true, true);
	ds_cal10_2.setBroadcast(true, true);
	ds_cal10_3.setBroadcast(true, true);
};

scwin.setData2 = function(ds, tc, col_cnt, row_cnt) {
	var nStartTime = new Date().getTime();
	for (var i = 0; i < row_cnt; i++) {
		var nRow = ds.insertRow();
		for (var j = 0; j < col_cnt; j++) {
			ds.setCellData(nRow, "Col" + j, "data");
		}
	}
	tc.setValue((new Date().getTime() - nStartTime) / 1000);
};
]]></script>
