<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
		var jsonData = [{col1:"a",col2:"a1",col3:"1000", col4:"a"}
						,{col1:"b",col2:"a2",col3:"1000", col4:"a"}
						,{col1:"c",col2:"a3",col3:"1000", col4:"a"}
						,{col1:"d",col2:"a4",col3:"1000", col4:"a"}
						,{col1:"e",col2:"a5",col3:"1000", col4:"a"}
						,{col1:"f",col2:"b1",col3:"1000", col4:"b"}
						,{col1:"g",col2:"b3",col3:"1000", col4:"b"}
						,{col1:"h",col2:"c1",col3:"1000", col4:"c"}
						,{col1:"i",col2:"c2",col3:"1000", col4:"c"}
						,{col1:"j",col2:"c3",col3:"1000", col4:"c"}
						,{col1:"k",col2:"d1",col3:"1000", col4:"d"}
						,{col1:"l",col2:"d2",col3:"1000", col4:"d"}
						,{col1:"n",col2:"d3",col3:"1000", col4:"d"}];
		dataList1.setJSON(jsonData);
	};
	// groupbyZone 에 Header 를 끌어 놓으면 호출 → groupby 실행
	scwin.gridView1_ongroupby = function(options) {
		options.closeGroup = true;
		options.groupbyHeader = [{colSpan: "5", inputType: "expression", expression: " toggle() + depthStr() + ' [ ' + count() + ' 건 ] ' ", align: "left" }];
		gridView1.groupby(options);
	};
	scwin.fn_formatter = function(data){
		return data + "_format";
	};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 500px;height: 200px;" checkAllType="false" defaultCellHeight="20" useFilterList="true" useFilterListFormat="true" dataList="data:dataList1" groupbyZone="true" ev:ongroupby="scwin.gridView1_ongroupby">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column7" value="check" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column6" value="name2" displayMode="label" useFilter="true"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name5" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="checkbox" style="height:20px" id="col5" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayFormatter="scwin.fn_formatter" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
