<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList3">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.typeGetter = function(info) {
	var rowIndex = info.rowIndex;
	var colIndex = info.colIndex;
	var returnInfo;
	if (colIndex == "2") {
		returnInfo = {
			id: "dynamic_checkbox_" + rowIndex + "_" + colIndex,
			inputType: "checkbox",
			value: ""
		}
	}
	return returnInfo;
};
]]></script>
	</head>
	<body>
		<w2:gridView checkAllType="false" id="" style="width:640px;height:309px;" dataList="dataList3">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column3" value="컬럼1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column2" value="컬럼2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="컬럼3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="checkbox" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="custom" id="col3" displayMode="label" typeGetter="scwin.typeGetter"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
