<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="depth" name="depth" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{"depth":"0","col2":"a1","col3":"a1"}
		,{"col2":"a1","col3":"a1-1","depth":"1"}
		,{"col2":"a1","col3":"a1-2","depth":"1"}
		,{"depth":"0","col2":"a2","col3":"a2"}
		,{"col2":"a2","col3":"a2-1","depth":"1"}
		,{"col2":"a2","col3":"a2-2","depth":"1"}];
	dataList1.setJSON(jsonData);
};
scwin.gridView2_oncellclick = function(row, col, colId, addInfo) {
	console.log("row : " + row);
	console.log("col : " + col);
	console.log("colId : " + colId);
	console.log(addInfo);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView2" CellClickFixScrollX="true" dataDragSelect="true" useShiftKey="true" drilldownRealRowIndexAll="true" drilldownRealRowIndex="true"
			style="position:absolute;left:63px;top:70px;width:484px;height:588px;" ev:oncellclick="scwin.gridView2_oncellclick">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="h_col1" inputType="checkbox" width="70" value="1" displayMode="label"></w2:column>
					<w2:column id="h_col2" inputType="text" width="70" value="2" displayMode="label"></w2:column>
					<w2:column id="h_col3" inputType="text" width="70" value="3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="depth" inputType="checkbox" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="drilldown" width="70" textAlign="left" displayMode="label" depthColumn="depth" depthType="line" showDepth="0"></w2:column>
					<w2:column id="col3" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
