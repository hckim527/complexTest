<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="chk" name="체크" dataType="text"></w2:column>
						<w2:column id="menu" name="메뉴" dataType="text"></w2:column>
						<w2:column id="depthNo" name="depth" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setJSON([
		{ "chk": "2", "menu": "aaa", "depthNo": 1 },
		{ "chk": "1", "menu": "bbb", "depthNo": 2 },
		{ "chk": "1", "menu": "ccc", "depthNo": 3 },
		{ "chk": "2", "menu": "ddd", "depthNo": 3 },
		{ "chk": "2", "menu": "fff", "depthNo": 2 },
		{ "chk": "2", "menu": "ggg", "depthNo": 1 },
		{ "chk": "1", "menu": "hhh", "depthNo": 2 },
		{ "chk": "2", "menu": "iii", "depthNo": 2 },
		{ "chk": "1", "menu": "jjj", "depthNo": 3 }
	]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" useShiftKey="true" style="position: absolute ;left: 38px;top: 54px;width:323px;height:195px;" defaultCellHeight="20" dataList="data:dataList1" drilldownRealRowIndexAll="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="checkbox" id="column5" value="체크" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="메뉴" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="depth" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="checkbox" id="chk" displayMode="label"></w2:column>
					<w2:column width="70" inputType="drilldown" id="menu" displayMode="label" showDepth="1" depthColumn="depthNo"></w2:column>
					<w2:column width="70" inputType="text" id="depthNo" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
