		<script type="text/javascript" lazy="false"><![CDATA[
scwin.getType = function(info) {
	var rowIndex = info.rowIndex;
	var colIndex = info.colIndex;
	var colID = info.colID;
	var instanceIndex = rowIndex + 1;
	var inputType = WebSquare.ModelUtil.getInstanceValue("response/RES_SELECT_EMP_LIST/vector/data[" + instanceIndex + "]/TB_EMP0001_S002/INPUTTYPE/@value")
	var inputType = scwin.convertData(inputType);
	var returnInfo;
	switch (inputType) {
		case "select":
			returnInfo = {
				id: "dynamic_select_" + rowIndex + "_" + colIndex,
				inputType: "select",
				options: {
					selectedData: "false",
					viewType: "icon"
				},
				itemSet: {
					nodeset: "response/RES_DEPT_COMBO/vector/data/COMBO",
					label: "DNAME/@value",
					value: "DEPTNO/@value"
				}
			}
			break;
		case "autoComplete":
			returnInfo = {
				id: "dynamic_autoComplete_" + rowIndex + "_" + colIndex,
				inputType: "autoComplete",
				options: {
					selectedData: "false",
					viewType: "icon"
				},
				itemSet: {
					nodeset: "response/RES_DEPT_COMBO/vector/data/COMBO",
					label: "DNAME/@value",
					value: "DEPTNO/@value"
				}
			}
			break;
	}
	return returnInfo;
}
scwin.convertData = function(data) {
	data = parseInt(data);
	switch (data) {
		case 0:
			return "select";
		case 6:
			return "select";
		case 7:
			return "autoComplete";
	}
}
scwin.onpageload = function() {
	window.onoff = false;
};
scwin.trigger4_onclick = function() {
	if (onoff == false) {
		grid1.setCellDisableEdit(1, 0, true);
		onoff = true;
	} else {
		grid1.setCellDisableEdit(1, 0, false);
		onoff = false;
	}
};
]]></script>
