<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[a]]></col1>
							<col2><![CDATA[aa]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[b]]></col1>
							<col2><![CDATA[bb]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[c]]></col1>
							<col2><![CDATA[cc]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[d]]></col1>
							<col2><![CDATA[dd]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridView1.setColumnDisableEdit(1, true);
};
scwin.trigger3_onclick = function(e) {
	autoComplete1.disableEdit(true);
};
scwin.trigger4_onclick = function(e) {
	autoComplete1.disableEdit(false);
};
scwin.setVal = function() {
	var node = document.getElementById('mf_gridView1_cell_0_1') || document.getElementById('gridView1_cell_0_1');
	var evt = document.createEvent('MouseEvents');
	evt.initEvent('dblclick', true, false);
	node.dispatchEvent(evt);
};
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList2" defaultCellHeight="20" id="gridView1" style="position: absolute;width:207px;height:150px;" useShiftKey="true" rowNumVisible="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="select" width="70" displayMode="label">
						<w2:choices>
							<w2:itemset nodeset="data:dataList1">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col2" width="70" inputType="autoComplete" displayMode="label">
						<w2:choices>
							<w2:itemset nodeset="data:dataList1">
								<w2:label ref="col2"></w2:label>
								<w2:value ref="col1"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: absolute;width:192px;height:23px;left:211px;top:0px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[gridView1.disableEdit(true)]]></xf:label>
		</xf:trigger>
		<w2:autoComplete search="start" displayMode="label" submenuSize="auto" visibleRowNum="5" id="autoComplete1" style="position: absolute;width: 148px;height: 21px;left:4px;top:220px;" editType="select">
			<w2:choices>
				<w2:itemset nodeset="data:dataList1">
					<w2:label ref="col2"></w2:label>
					<w2:value ref="col1"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:autoComplete>
		<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3" style="position: absolute;width:192px;height:23px;left:211px;top:220px;" type="button">
			<xf:label><![CDATA[disableEdit(true)]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger4_onclick" id="trigger4" style="position: absolute;width:192px;height:23px;left:211px;top:250px;" type="button">
			<xf:label><![CDATA[disableEdit(false)]]></xf:label>
		</xf:trigger>
	</body>
</html>
