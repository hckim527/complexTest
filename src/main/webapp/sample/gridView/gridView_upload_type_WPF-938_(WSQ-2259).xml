<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="codeList" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="val" name="name1" dataType="text"></w2:column>
						<w2:column id="nm" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<val><![CDATA[1]]></val>
							<nm><![CDATA[test1]]></nm>
						</w2:row>
						<w2:row>
							<val><![CDATA[2]]></val>
							<nm><![CDATA[test2]]></nm>
						</w2:row>
						<w2:row>
							<val><![CDATA[3]]></val>
							<nm><![CDATA[test3]]></nm>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	var excelOpt1 = {};
	excelOpt1.type = 0;
	excelOpt1.startRowIndex = "1";
	gridView1.advancedExcelUpload(excelOpt1);
};
scwin.trigger4_onclick = function(e) {
	var excelOpt1 = {};
	excelOpt1.type = 1;
	excelOpt1.startRowIndex = "1";
	gridView1.advancedExcelUpload(excelOpt1);
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" id="trigger1" style="position: relative;width: 100px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[upload type 0 ]]></xf:label>
		</xf:trigger>
		<xf:trigger ev:onclick="scwin.trigger4_onclick" id="trigger4" style="position: relative;width: 100px;height: 23px;" type="button">
			<xf:label><![CDATA[upload type 1]]></xf:label>
		</xf:trigger>
		<w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width:100px;height:250px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="column3" style="height:20px" width="70" displayMode="label" value="name1"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" style="height:20px" width="70" inputType="select" displayMode="label" allOption="" chooseOption="">
						<w2:choices>
							<w2:itemset nodeset="data:codeList">
								<w2:label ref="nm"></w2:label>
								<w2:value ref="val"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
