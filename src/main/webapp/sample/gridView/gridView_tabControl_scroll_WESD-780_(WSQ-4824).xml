<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	tabc_side.getWindow(1);
	dataList2.setBroadcast(false);
	dataList2.insertRow(0);
	dataList2.setBroadcast(true, true);
};

scwin.checkVal = function() {
	return (document.getElementById('gridView1_headerRowNumber_bodyRow_5') || document.getElementById('mf_gridView1_headerRowNumber_bodyRow_5')).innerText == '10';
};
]]></script>
	</head>
	<body>
		<w2:tabControl useTabKeyOnly="true" id="tabc_side" style="width:700px;height:200px;">
			<w2:tabs style="width:70px;height:30px;" id="tabs1"></w2:tabs>
			<w2:tabs style="width:70px;height:30px;" id="tabs2"></w2:tabs>
			<w2:content alwaysDraw="false" style="height:700px;" id="content1">
				<xf:trigger type="button" style="width:80px;height:23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
					<xf:label><![CDATA[]]></xf:label>
				</xf:trigger>
			</w2:content>
			<w2:content alwaysDraw="false" style="height:700px;" id="content2">
				<xf:group id="side">
					<xf:group id="" tagname="ul">
						<xf:group id="" tagname="li">
							<w2:gridView rowNumVisible="true" id="gridView1" style="width:500px;height:150px;" defaultCellHeight="20" dataList="data:dataList2">
								<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" style="height:20px;" id="column1" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="height:20px;" id="column11" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="height:20px;" id="column12" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" style="height:20px;" id="col1" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="height:20px;" id="col2" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="height:20px;" id="col3" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</w2:content>
		</w2:tabControl>
	</body>
</html>
