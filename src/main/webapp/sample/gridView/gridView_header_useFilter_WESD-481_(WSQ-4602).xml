<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_vertical_guides="" meta_horizontal_guides="">
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dl_main" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="STUDENT_NO" name="name1" dataType="text"></w2:column>
						<w2:column id="NM" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<STUDENT_NO><![CDATA[111]]></STUDENT_NO>
							<NM><![CDATA[홍길동]]></NM>
						</w2:row>
						<w2:row>
							<STUDENT_NO><![CDATA[222]]></STUDENT_NO>
							<NM><![CDATA[정우성]]></NM>
						</w2:row>
						<w2:row>
							<STUDENT_NO><![CDATA[333]]></STUDENT_NO>
							<NM><![CDATA[원빈]]></NM>
						</w2:row>
						<w2:row>
							<STUDENT_NO><![CDATA[444]]></STUDENT_NO>
							<NM><![CDATA[강호동]]></NM>
						</w2:row>
						<w2:row>
							<STUDENT_NO><![CDATA[555]]></STUDENT_NO>
							<NM><![CDATA[심청이]]></NM>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
	</head>
	<body>
		<w2:gridView autoFit="none" dataList="data:dl_main" defaultCellHeight="20"
			evenRowBackgroundColor="#fcfcfc" id="grd_main" rowMouseOver="true" rowMouseOverColor="#faebee" rowNumHeaderValue="순번"
			rowNumVisible="true" rowNumWidth="40"
			style="height:150px;" readOnly="true" customFilterBox="true" useFilterList="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="coll1" inputType="text"
						style="height:20px;" value="학번" width="100" checkboxLabel="1" useFilter="true">
					</w2:column>
					<w2:column width="120" inputType="text" style="height:20px" id="coll2"
						value="성명" displayMode="label" useFilter="true">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="STUDENT_NO" inputType="text"
						style="height:20px" width="100" textAlign="left">
					</w2:column>
					<w2:column width="120" inputType="text" style="height:20px" id="NM"
						displayMode="label" textAlign="left">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:textbox id="" label="상세정보" style="margin-top:10px;"></w2:textbox>
		<xf:input id="inp_no" ref="data:dl_main.STUDENT_NO" style="width:100px;"></xf:input>
		<xf:input id="inp_nm" ref="data:dl_main.NM" style="width:100px;"></xf:input>
	</body>
</html>
