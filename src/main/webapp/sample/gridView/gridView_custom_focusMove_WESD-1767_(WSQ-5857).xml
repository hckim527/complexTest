<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="kofileCrtrYmd" name="kofileCrtrYmd" dataType="text"></w2:column>
						<w2:column id="csDvsTaskNm" name="csDvsTaskNm" dataType="text"></w2:column>
						<w2:column id="ofdocNm" name="ofdocNm" dataType="text"></w2:column>
						<w2:column id="prog1" name="prog1" dataType="text"></w2:column>
						<w2:column id="prog2" name="prog2" dataType="text"></w2:column>
						<w2:column id="prog3" name="prog3" dataType="text"></w2:column>
						<w2:column id="prog4" name="prog4" dataType="text"></w2:column>
						<w2:column id="prog5" name="prog5" dataType="text"></w2:column>
						<w2:column id="dltMenu" name="dltMenu" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var docs = ["빈소장", "문서제출명령", "답변서", "문서제출명령"];
	var ymd = ["2020.01.08", "2020.01.08", "2020.01.16", "2020.01.16"];
	var jsonData = [];
	for (var i = 0; i < docs.length; i++) {
		jsonData.push({ "kofileCrtrYmd": ymd[i], "csDvsTaskNm": "원고", "ofdocNm": docs[i], "prog1": "", "prog2": "", "prog3": "", "prog4": "", "prog5": "", "dltMenu": "" });
	}
	dataList1.setJSON(jsonData);
	gridView1.setCellDisabled(0, "dltMenu", "true"); //0번째 row 상세메뉴 disabled
	gridView1.setCellDisabled(1, "dltMenu", "true"); //1번째 row 상세메뉴 disabled

	var info = { inputType: "link", options: {} };
	for (var r = 0; r < 4; r++) gridView1.setCellInputType(r, "ofdocNm", info);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:input style="position: relative;width: 144px;height: 21px;"></xf:input>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="position:relative;width:962px;height:500px;"
			dataList="data:dataList1" readOnly="true" setCellInputTypeCustom="true" showSortableImage="false" showSortableUseFilter="false"
			focusImage="false" senseReader="true" accessibility="true" focusMove="false" sortHeaderDiv="true" keyMoveEditMode="true"
			scrollFocus="true" useStartEndDiv="false" keepDefaultColumnWidth="true" noSelect="true" editType="focus" sortable="true"
			autoResizeEmbeddedInput="false">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="74" inputType="text" id="column11" value="기준일자" displayMode="label" minWidth="25" style="height:36px"></w2:column>
					<w2:column width="55" inputType="text" id="column10" value="구분" displayMode="label" style="height:36px" sortable="false" fixColumnWidth="true"></w2:column>
					<w2:column width="98" inputType="text" id="column9" value="문건명" displayMode="label" style="height:36px"></w2:column>
					<w2:column width="181" inputType="text" id="column8" value="진행" displayMode="label" style="height:36px" sortable="false" colSpan="5"></w2:column>
					<w2:column width="188" inputType="text" id="column3" value="상세메뉴" displayMode="label" style="height:36px" sortable="false"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="74" style="height:36px" id="kofileCrtrYmd" displayMode="label" minWidth="25" readOnly="true" escape="false"></w2:column>
					<w2:column width="55" inputType="text" id="csDvsTaskNm" displayMode="label" minWidth="10" fixColumnWidth="true"></w2:column>
					<w2:column width="98" inputType="custom" id="ofdocNm" displayMode="label" readOnly="true"></w2:column>
					<w2:column width="181" inputType="custom" id="prog1" displayMode="label" readOnly="true"></w2:column>
					<w2:column width="11" inputType="custom" id="prog2" displayMode="label"></w2:column>
					<w2:column width="11" inputType="custom" id="prog3" displayMode="label"></w2:column>
					<w2:column width="11" inputType="custom" id="prog4" displayMode="label"></w2:column>
					<w2:column width="11" inputType="custom" id="prog5" displayMode="label"></w2:column>
					<w2:column width="188" inputType="button" id="dltMenu" displayMode="label" readOnly="false"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
