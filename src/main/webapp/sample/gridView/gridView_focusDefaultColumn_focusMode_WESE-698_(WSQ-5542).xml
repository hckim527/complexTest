					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
	var names = ["직책", "직위", "직원구분", "종교", "최종학력", "시간외근무", "시간외결재상태", "인력형태", "기술등급", "학위구분", "자격증", "개발기술",
