	var jsonData = [];
	for (var i = 0; i < names.length; i++) {
		jsonData.push({ "chk": "", "GRP_CD": "000" + (i < 9 ? "0" : "") + (i + 1), "GRP_NM": names[i], "SORT_ORDER": i + 1, "IS_USE": "Y", "NOTE": names[i] });
	}
	dlt_commonGrp.setJSON(jsonData);
};
]]></script>
