		<script type="text/javascript" lazy="false"><![CDATA[
/*
 * [WSQ-6051] WAEA-357 removeRow 반복 호출 성능 개선 확인 (원본: WAEA-357 Jira 첨부 WAEA_357.xml)
 * - btn_st(start) : 10컬럼 dataList 100 / 1,000 / 10,000 행을 removeRow(0) 반복으로 전부 삭제
 * - 요건(Jira 댓글) : 첨부 샘플 맨 위 버튼 기준 1만건 3.5초 → 1.3초로 단축
 * - 판정 : checkBeforeTime ~ checkAfterTime 경과(btn_st 클릭 전체) <= scwin._limitMs
 *          시간은 performance.now() 로 잰다(분·초 계산은 정시 경계에서 틀어짐).
 */
scwin._limitMs = 2000;
scwin._beforeTime = null;
scwin._afterTime = null;
scwin.checkBeforeTime = function() {
	scwin._beforeTime = performance.now();
	scwin._afterTime = null;
};
scwin.checkAfterTime = function() {
	scwin._afterTime = performance.now();
	tbx_elapsed.setValue("btn_st 경과 : " + scwin.getElapsedTime() + " ms (기준 " + scwin._limitMs + " ms 이하)");
};
scwin.getElapsedTime = function() {
	if (scwin._beforeTime === null || scwin._afterTime === null) {
		return -1;
	}
	return Math.round(scwin._afterTime - scwin._beforeTime);
};
scwin.compareTime = function() {
	var elapsed = scwin.getElapsedTime();
	var rowCnt = ds_cal10_1.getRowCount() + ds_cal10_2.getRowCount() + ds_cal10_3.getRowCount();
	// 경과시간 기준 + 실제로 1만1천1백 행이 모두 지워졌는지
	return elapsed >= 0 && elapsed <= scwin._limitMs && rowCnt === 0;
};

scwin.onpageload = function() {
	scwin.setData(ds_cal10_1, 100);
	scwin.setData(ds_cal10_2, 1000);
	scwin.setData(ds_cal10_3, 10000);
	// 상태값이 섞인 Row 삭제(핫픽스 수정 대상 경로)
	for (var i = 0; i < 100; i += 7) {
		ds_cal10_1._setRowStatus(i, "U");
	}
	for (var i = 0; i < 100; i += 13) {
		ds_cal10_1._setCellStatus(i, 0, "U");
	}
	ds_cal10_1._setCellStatus(93, 0, "U");
};

scwin.btn_st_onclick = function(e) {
	scwin.deleteRowTest(ds_cal10_1, "tc_10_100");
	scwin.deleteRowTest(ds_cal10_2, "tc_10_1000");
	scwin.deleteRowTest(ds_cal10_3, "tc_10_10000");
};

scwin.setData = function(ds, row_cnt) {
	var jsonData = [];
	for (var i = 0; i < row_cnt; i++) {
		var colData = {};
		for (var j = 0; j < 10; j++) {
			colData["Col" + j] = i + "_" + j;
		}
		jsonData.push(colData);
	}
	ds.setJSON(jsonData);
};

scwin.deleteRowTest = function(ds, tbxId) {
	ds.setBroadcast(false);
	var nStartTime = new Date().getTime();
	var row_cnt = ds.getRowCount();
	for (var i = 0; i < row_cnt; i++) {
		ds.removeRow(0);
	}
	$p.getComponentById(tbxId).setValue((new Date().getTime() - nStartTime) / 1000);
	ds.setBroadcast(true, true);
};
]]></script>
