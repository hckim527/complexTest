<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var team = ["인사팀", "인사팀", "인사팀", "인사팀", "인사팀", "개발팀", "개발팀", "개발팀", "지원팀", "지원팀"];
	var c2 = "abcdefghij", c3 = "qwertyuiop", data = [];
	for (var i = 0; i < team.length; i++) {
		data.push({ "col4": team[i], "col1": "0", "col2": c2[i], "col3": c3[i] });
	}
	dataList1.setJSON(data);
};

scwin.trigger1_onclick = function(e) {
	scwin.check = gridView1.getCheckedData(1);
};

scwin.checkBoxClick = function() {
	const checkboxes = document.querySelectorAll('input[type="checkbox"]');
	checkboxes[1].click();
};

scwin.checkVal = function() {
	return scwin.check.length !== 1;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width:500px;height:210px;" dataList="data:dataList1"
			mergeCells="byrestriccol">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" id="column9" value="name4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="checkbox" id="column5" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column4" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" id="col4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="checkbox" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="col3" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[체크박스 값]]></xf:label>
		</xf:trigger>
	</body>
</html>
