<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="ID" name="name1" dataType="text"></w2:column>
						<w2:column id="col1" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	var data = [];
	for (var i = 0; i < 100; i++) {
		data.push("F_" + (i + 1) + "_");
		data.push(String(i % 5));
	}
	dataList1.setData(data);
};

scwin.setFilter = function(colIndex, key, clearFilter) {
	var filterOption = {
		"type" : "row",
		"colIndex" : colIndex,
		"key" : key,
		"condition" : "and",
		"exactMatch" : false
	};
	if (clearFilter) {
		filterOption.clearFilter = clearFilter;
	}
	dataList1.setColumnFilter(filterOption);
};

scwin.trigger2_onclick = function(e) {
	scwin.setFilter("ID", "F_6");
};

scwin.trigger3_onclick = function(e) {
	scwin.setFilter("col1", "0");
};

scwin.trigger4_onclick = function(e) {
	scwin.setFilter("ID", "F_6", "keepSort");
};

scwin.trigger5_onclick = function(e) {
	scwin.setFilter("col1", "0", "keepSort");
};

scwin.trigger6_onclick = function(e) {
	scwin.setFilter("ID", "F_6", "all");
};

scwin.trigger7_onclick = function(e) {
	scwin.setFilter("col1", "0", "all");
};

scwin.trigger8_onclick = function(e) {
	dataList1.clearFilter(false, {"keepSort": true});
};

scwin.trigger9_onclick = function(e) {
	dataList1.clearFilter();
};
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList1" id="gridView1" style="position: relative;width:301px;height:301px;"
			autoFit="allColumn" rowNumVisible="true" sortable="true" drawTypeX="virtual">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column7" style="height:20px" inputType="text" width="70" displayMode="label" value="name1"></w2:column>
					<w2:column id="column5" style="height:20px" width="70" inputType="text" displayMode="label" value="name2"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="ID" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col1" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:group style="position:relative;width:700;height:40px;">
			<xf:trigger id="trigger1" style="position:relative;width:250px;height:32px;" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[조회]]></xf:label>
			</xf:trigger>
		</xf:group>
		<xf:group style="position:relative;width:700;height:40px;">
			<xf:trigger id="trigger2" style="position:relative;width:250px;height:32px;" ev:onclick="scwin.trigger2_onclick">
				<xf:label><![CDATA[setColumnFilter: "ID===F_6"]]></xf:label>
			</xf:trigger>
			<xf:trigger id="trigger3" style="position:relative;width:250px;height:32px;" ev:onclick="scwin.trigger3_onclick">
				<xf:label><![CDATA[setColumnFilter: "col1===0"]]></xf:label>
			</xf:trigger>
		</xf:group>
		<xf:group style="position:relative;width:700;height:40px;">
			<xf:trigger id="trigger4" style="position:relative;width:250px;height:32px;" ev:onclick="scwin.trigger4_onclick">
				<xf:label><![CDATA["ID===F_6" , clearFilter:"keepSort"]]></xf:label>
			</xf:trigger>
			<xf:trigger id="trigger5" style="position:relative;width:250px;height:32px;" ev:onclick="scwin.trigger5_onclick">
				<xf:label><![CDATA["col1===0" , clearFilter:"keepSort"]]></xf:label>
			</xf:trigger>
		</xf:group>
		<xf:group style="position:relative;width:700;height:40px;">
			<xf:trigger id="trigger6" style="position:relative;width:250px;height:32px;" ev:onclick="scwin.trigger6_onclick">
				<xf:label><![CDATA["ID===F_6" , clearFilter:"all"]]></xf:label>
			</xf:trigger>
			<xf:trigger id="trigger7" style="position:relative;width:250px;height:32px;" ev:onclick="scwin.trigger7_onclick">
				<xf:label><![CDATA["col1===0" , clearFilter:"all"]]></xf:label>
			</xf:trigger>
		</xf:group>
		<xf:group style="position:relative;width:700;height:40px;">
			<xf:trigger id="trigger8" style="position:relative;width:250px;height:32px;" ev:onclick="scwin.trigger8_onclick">
				<xf:label><![CDATA[clearFilter(false, {keepSort:true})]]></xf:label>
			</xf:trigger>
			<xf:trigger id="trigger9" style="position:relative;width:250px;height:32px;" ev:onclick="scwin.trigger9_onclick">
				<xf:label><![CDATA[clearFilter()]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
