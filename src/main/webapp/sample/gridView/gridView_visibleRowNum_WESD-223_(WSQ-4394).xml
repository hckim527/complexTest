<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function() {
    var row = 100;
    var col = 3;
    var data = [];
    for (var i = 0; i < row; i++) {
        for (var j = 0; j < col; j++) {
            data.push("2020.0" + (i % 5 + 1) + ".04");
        }
    }
    dataList1.setData(data);
}
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList1" style="position:relative;width:564px;" defaultCellHeight="20" id="gridView1" rowNumVisible="true" autoFit="allColumn" visibleRowNum="12" visibleRowNumFix="true">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column7" inputType="text" width="70" value="col1" displayMode="label" useFilter="true" autoFitFilterList="true"></w2:column>
					<w2:column id="column5" inputType="text" width="70" value="col2" displayMode="label"></w2:column>
					<w2:column id="column3" width="70" inputType="text" value="col3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="textarea" width="70" displayMode="label" disabled="true"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: relative;width: 100px;height: 30px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label>get data</xf:label>
		</xf:trigger>
	</body>
</html>
