// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사). 2026-11
scwin.__getJq = function(q) {
	var j = $(q); if (j.length) return j;
	var P = 'mf_', t = q.trim(), r = t.slice(1);
	if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
	return $(t.slice(0, 1) + r);
};
scwin.__isShowLastData = function() {
	var tds = ((j) => j.length ? j : $('#mf_gridView1_body_tbody .grid_body_row'))($('#gridView1_body_tbody .grid_body_row')).not('.w2grid_hidedRow').last().find('td');
	var count = 0;
	tds.each(function(index, el) {
		if (index > 1 && (scwin.__getJq(el).text() != "")) {
			count++;
		}
	});
	return count == tds.length - 2;
}
scwin.onpageload = function() {
	window.json1 = [];
	var keys = ["FILE_PATH", "EMPL_NUMB", "EMPL_NAME", "GNDR_CODE", "CPOS_CODE", "OPOS_CODE", "DUTY_CODE", "ENCO_DATE", "PRON_DATE", "DEPT_CODE", "DEPT_NAME", "EMPL_BIRT", "EMPL_AGEX", "RARS_DATE", "GRDN_CODE", "BRAD_NAME"];
	for (var i = 0; i < 50; i++) {
		var row = {};
		for (var k = 0; k < keys.length; k++) {
			row[keys[k]] = i + "_" + keys[k];
		}
		row.rowStatus = "C";
		json1.push(row);
	}
	dtlHR_MASTXM.setJSON(json1);
};
