<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:config>
			<WebSquare>
				<gridView>
					<header>
						<column inputType="text">
							<useFilter value="true"/>
						</column>
					</header>
				</gridView>
			</WebSquare>
		</w2:config>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript"><![CDATA[
// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사). 2026-11
scwin.__getJq = function(q) {
	var j = $(q); if (j.length) return j;
	var P = 'mf_', t = q.trim(), r = t.slice(1);
	if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
	return $(t.slice(0, 1) + r);
};
scwin.onpageload = function() {
	var jsonData = [
		{ "col1": "a", "col2": "1000", "rowStatus": "C" },
		{ "col1": "b", "col2": "2000", "rowStatus": "C" },
		{ "col1": "c", "col2": "9000", "rowStatus": "C" }
	];
	dataList1.setJSON(jsonData);
};
scwin.__hasClass = function() {
	var el0 = ((j) => j.length ? j : $('#mf_gridView1_column1_filter'))($('#gridView1_column1_filter'));
	return scwin.__getJq(el0).hasClass("w2grid_customFilter_open");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width: 500px;height: 150px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" style="height:20px" inputType="text" width="80" displayMode="label" value="name1" useFilter="true"></w2:column>
					<w2:column id="column1" style="height:20px" width="80" inputType="text" displayMode="label" value="name2"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" width="70" inputType="checkcombobox" displayMode="label" displayFormat="#,###">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[1]]></w2:label>
								<w2:value><![CDATA[1]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[2]]></w2:label>
								<w2:value><![CDATA[2]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[3]]></w2:label>
								<w2:value><![CDATA[3]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView dataList="dataList1" id="gridView2" style="position: relative;width: 500px;height: 150px;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="column3" inputType="text" style="height:20px" value="name1" width="80"></w2:column>
					<w2:column displayMode="label" id="column1" inputType="text" style="height:20px" value="name2" width="80"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="col1" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayFormat="#,###" displayMode="label" id="col2" inputType="checkcombobox" style="height:20px" width="70">
						<w2:choices>
							<w2:item>
								<w2:label><![CDATA[1]]></w2:label>
								<w2:value><![CDATA[1]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[2]]></w2:label>
								<w2:value><![CDATA[2]]></w2:value>
							</w2:item>
							<w2:item>
								<w2:label><![CDATA[3]]></w2:label>
								<w2:value><![CDATA[3]]></w2:value>
							</w2:item>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
