<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="orderList" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="chk" name="chk" dataType="text" ignoreStatus="true"></w2:column>
						<w2:column id="korItemNm" name="korItemNm" dataType="text"></w2:column>
						<w2:column id="qty" name="qty" dataType="number"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
    var jsonData = [];
    for (var i = 0; i < 12; i++) {
        jsonData.push({ "chk": "", "korItemNm": "item" + i, "qty": i + 1 });
    }
    orderList.setJSON(jsonData);
    scwin.dataRowStatus();
};
scwin.dataRowStatus = function() {
    var st = ["U", "U", "C", "D", "V", "E"];
    for (var i = 0; i < orderList.getRowCount(); i++) {
        orderList.modifyRowStatus(i, st[i % 6]);
    }
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="grd_orderList" dataList="data:orderList" style="width:600px;height:300px;" rowNumVisible="true" rowNumWidth="30"
			rowStatusVisible="true" focusMode="row" useShiftKey="true" useCtrlKey="true" dataDragDrop="true" dataDragDropStatus="true"
			noSelect="true" defaultCellHeight="16" drawType="native">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="30" inputType="checkbox" id="col_chkb" sortable="false" displayMode="label" checkAlways="true"></w2:column>
					<w2:column width="300" inputType="text" id="korItemNmhead" displayMode="label" value="korItemNm"></w2:column>
					<w2:column width="50" inputType="text" id="qtyhead" displayMode="label" value="qty"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="30" inputType="checkbox" id="chk" displayMode="label" ignoreStatus="true"></w2:column>
					<w2:column width="300" inputType="text" id="korItemNm" displayMode="label" editModeEvent="ondblclick"></w2:column>
					<w2:column width="50" inputType="text" id="qty" displayMode="label" dataType="number" textAlign="right"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
