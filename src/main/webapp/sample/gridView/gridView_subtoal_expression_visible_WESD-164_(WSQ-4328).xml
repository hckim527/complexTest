<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="big" name="name1" dataType="text"></w2:column>
						<w2:column id="middle" name="name2" dataType="text"></w2:column>
						<w2:column id="small" name="name3" dataType="text"></w2:column>
						<w2:column id="value" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [
		{"big": "한국", "middle": "소설", "small": "남", "value": "50"},
		{"big": "한국", "middle": "소설", "small": "여", "value": "50"},
		{"big": "한국", "middle": "시", "small": "남", "value": "3"},
		{"big": "한국", "middle": "시", "small": "여", "value": "7"},
		{"big": "미국", "middle": "소설", "small": "남", "value": "30"},
		{"big": "미국", "middle": "소설", "small": "여", "value": "40"},
		{"big": "미국", "middle": "시", "small": "남", "value": "5"},
		{"big": "미국", "middle": "시", "small": "여", "value": "6"}
	];
	dataList1.setJSON(jsonData);
};
scwin.btn_rowHide_onclick = function(e) {
	var rowCount = dataList1.getTotalRow();
	for (var i = 0; i < rowCount; i++) {
		grd_gridView1.setRowVisible(i, false);
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="width: 100%;height: 45px;margin:10px">
			<xf:trigger type="button" style="width:153px;height:42px;float:left" id="btn_rowHide" ev:onclick="scwin.btn_rowHide_onclick">
				<xf:label><![CDATA[전체 Row 숨기기]]></xf:label>
			</xf:trigger>
		</xf:group>
		<xf:group id="grp_group1" style="width:100%;height:200px;margin:0%;padding:0%;margin-top:10px;">
			<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="grd_gridView1" style="width:100%;height:388px;">
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column id="column7" inputType="text" style="height:20px;" value="big" width="70"></w2:column>
						<w2:column id="column5" inputType="text" style="height:20px;" value="middle" width="70"></w2:column>
						<w2:column id="column3" inputType="text" style="height:20px;" value="small" width="70"></w2:column>
						<w2:column id="column1" inputType="text" style="height:20px;" value="value" width="70"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column id="big" inputType="text" width="70"></w2:column>
						<w2:column id="middle" inputType="text" width="70"></w2:column>
						<w2:column id="small" inputType="text" width="70"></w2:column>
						<w2:column id="value" inputType="text" width="70"></w2:column>
					</w2:row>
				</w2:gBody>
				<w2:subTotal id="subTotal7" targetColumnID="big">
					<w2:row id="row9">
						<w2:column expression="targetColValue()" id="column36" inputType="expression" width="70"></w2:column>
						<w2:column id="column35" inputType="text" width="70"></w2:column>
						<w2:column id="column34" inputType="text" width="70"></w2:column>
						<w2:column expression="sum('value')" id="column33" inputType="expression" width="70"></w2:column>
					</w2:row>
				</w2:subTotal>
			</w2:gridView>
		</xf:group>
	</body>
</html>
