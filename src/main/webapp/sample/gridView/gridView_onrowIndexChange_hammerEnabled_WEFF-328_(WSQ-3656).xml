<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	// 이전 실행 값이 남지 않도록 초기화
	localStorage.removeItem("oldRow");
	scwin.rowLog = [];
	var jsonData = [];
	for (var i = 0; i < 550; i++) {
		jsonData.push({ col2: i, col3: i + 'click' });
	}
	dataList1.setJSON(jsonData);
};
scwin.gridView1_onrowindexchange = function(row, oldRow) {
	localStorage.setItem("oldRow", oldRow);
	scwin.rowLog.push(row + ":" + oldRow);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" defaultCellHeight="20" id="gridView1" focusMove="false" keyMoveEventMode="true" style="position: relative;width: 500px;height: 150px;" useShiftKey="true" hammerEnabled="true" ev:onrowindexchange="scwin.gridView1_onrowindexchange">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column7" style="height:20px;background: red;" inputType="text" width="70" value="이름" displayMode="label"></w2:column>
					<w2:column id="column5" style="height:20px;" inputType="text" width="70" value="나이" displayMode="label" class="header"></w2:column>
					<w2:column id="column3" style="height:20px;" inputType="text" width="70" value="숫자" displayMode="label" class="header"></w2:column>
					<w2:column id="column1" style="height:20px;" width="70" inputType="text" value="한글" displayMode="label" class="header"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="checkbox" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" inputType="link" width="70" displayMode="label"></w2:column>
					<w2:column id="col4" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column id="column11" style="height:20px;" width="70" inputType="text" value="풋터" displayMode="label"></w2:column>
					<w2:column id="column10" style="height:20px;" width="70" inputType="text" value="폰트" displayMode="label"></w2:column>
					<w2:column id="column9" style="height:20px;" width="70" inputType="text" value="확인" displayMode="label"></w2:column>
					<w2:column id="column8" style="height:20px;" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
	</body>
</html>
