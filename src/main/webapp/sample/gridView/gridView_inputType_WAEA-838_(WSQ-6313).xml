<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<w2:MSA/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_exam" repeatNode="data">
					<w2:columnInfo>
						<w2:column dataType="text" id="depth" name="DEPTH"></w2:column>
						<w2:column dataType="text" id="col_a" name="A"></w2:column>
						<w2:column dataType="text" id="col_b" name="B"></w2:column>
					</w2:columnInfo>
					<w2:data use="true" xmlns="">
						<w2:row><depth><![CDATA[1]]></depth><col_a><![CDATA[A1]]></col_a><col_b><![CDATA[B1]]></col_b></w2:row>
						<w2:row><depth><![CDATA[2]]></depth><col_a><![CDATA[A1-1]]></col_a><col_b><![CDATA[B2]]></col_b></w2:row>
						<w2:row><depth><![CDATA[2]]></depth><col_a><![CDATA[A1-2]]></col_a><col_b><![CDATA[B3]]></col_b></w2:row>
						<w2:row><depth><![CDATA[3]]></depth><col_a><![CDATA[A1-2-1]]></col_a><col_b><![CDATA[B4]]></col_b></w2:row>
						<w2:row><depth><![CDATA[1]]></depth><col_a><![CDATA[A2]]></col_a><col_b><![CDATA[B5]]></col_b></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.btn_spanAll_1_onclick = function (e) {
	grd_exam1.spanAll(1);
};

scwin.btn_spanAll_2_onclick = function (e) {
	grd_exam1.spanAll(2);
};

scwin.btn_spanAll_all_onclick = function (e) {
	grd_exam1.spanAll(true);
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" id="btn_spanAll_1" ev:onclick="scwin.btn_spanAll_1_onclick">
			<xf:label><![CDATA[spanAll(1)]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="btn_spanAll_2" ev:onclick="scwin.btn_spanAll_2_onclick">
			<xf:label><![CDATA[spanAll(2)]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="btn_spanAll_all" ev:onclick="scwin.btn_spanAll_all_onclick">
			<xf:label><![CDATA[spanAll(true)]]></xf:label>
		</xf:trigger>
		<w2:gridView autoFit="allColumn" autoFitMinWidth="210" class="gvw" dataList="dlt_exam" defaultCellHeight="38" id="grd_exam1" readOnly="true" style="height:120px;max-width:240px;" visibleRowNum="all">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column10" value="rowindex"></w2:column>
					<w2:column id="column7" inputType="text" value="A" width="100"></w2:column>
					<w2:column id="column9" inputType="text" value="B" width="100"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="expression" id="column11" expression="rowIndex()"></w2:column>
					<w2:column depthColumn="depth" id="col_a" inputType="drilldown" showDepth="2" textAlign="left" width="100"></w2:column>
					<w2:column id="col_b" inputType="text" width="100"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
