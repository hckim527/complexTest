		{ "col1": "fff", "col2": "asdf", "col3": "밸류3", "col4": "20190106", "col5": "밸류2", "col6": "밸류2", "col7": "20190101", "col8": "밸류1" }
	]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 750px;height: 150px;" defaultCellHeight="20"
			dataList="data:dataList1" directEdit="true" editModeEvent="ondblclick" editModeEventIcon="ondblclick"
			checkReadOnlyOnCut="true" >
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column9" inputType="text" width="70" value="text"
						displayMode="label">
					</w2:column>
					<w2:column id="column7" inputType="text" width="70"
						value="textarea" displayMode="label">
					</w2:column>
					<w2:column id="column5" inputType="text" width="70"
						value="select" displayMode="label">
					</w2:column>
					<w2:column id="column3" inputType="text" width="120"
						value="calendar" displayMode="label">
					</w2:column>
					<w2:column id="column1" width="92" inputType="text"
