					<w2:column id="col2" inputType="textarea" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col3" inputType="select" width="70"
						displayMode="label" viewType="icon">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col4" inputType="calendar" width="89"
						displayMode="label" viewType="icon" readOnly="false" editModeEventIcon="onclick">
