<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="number"></w2:column>
						<w2:column id="col_select" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.checklog = function() {
	try {
		log1 = gridView1.getInputType("col1");
		log2 = gridView1.getInputType("col_select");
		log3 = gridView1.getInputType("col3");
		log4 = gridView1.getInputType("col4");
		log5 = gridView1.getDataType("col1");
		log6 = gridView1.getDataType("col_select");
		log7 = gridView1.getDataType("col2");
		log8 = gridView1.getDataType("col3");
		if (log1 == "text" && log2 == "select" && log3 == "text" && log4 == "text" && log5 == "number" && log6 == "text" && typeof log7 == "undefined" && log8 == "number") {
			logShowed = true;
		} else {
			logShowed = false;
		}
	} catch (err) {
		logShowed = false;
	}
}
scwin.onpageload = function() {
	window.data = [];
	window.data2 = [];
	for (var i = 0; i < 20; i++) {
		for (var j = 0; j < 4; j++) {
			window.oneData = 4 * i + j;
			data.push(oneData);
			data2.push(oneData);
			data2.push(oneData);
		}
	}
	dataList2.setData(data2);
	dataList1.setData(data);
	window.logShowed = undefined;
	window.log1 = "";
	window.log2 = "";
	window.log3 = "";
	window.log4 = "";
	window.log5 = "";
	window.log6 = "";
	window.log7 = "";
	window.log8 = "";
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload"><xf:group id="" style="height:363px;"><xf:group id="" style="height:308px;width:50%;float:left;"><w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width:413px;height:308px;" useShiftKey="true" defaultCellHeight="20">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column7" style="height:20px;" colSpan="2" inputType="checkbox" width="140" value="g1" rowSpan="">
					</w2:column>
					<w2:column id="column3" style="height:20px;" inputType="text" width="70" value="g2"></w2:column>
					<w2:column id="column1" style="height:20px;" width="70" inputType="text" value="g3"></w2:column>
					<w2:column id="column13" style="height:20px;" inputType="text" width="70" value="g4"></w2:column>
				</w2:row>
				<w2:row id="row3">
					<w2:column id="column12" style="height:20px;" width="70" inputType="text" value="h1"></w2:column>
					<w2:column id="column11" style="height:20px;" colSpan="2" width="70" inputType="text" value="h2" rowSpan="">
					</w2:column>
					<w2:column id="column9" style="height:20px;" width="70" inputType="text" value="h3"></w2:column>
					<w2:column id="column14" style="height:20px;" inputType="text" width="70" value="h4"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70"></w2:column>
					<w2:column id="col_select" inputType="select" width="70">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col3" inputType="text" width="70" dataType="number"></w2:column>
					<w2:column id="col4" style="height:20px;" colSpan="2" width="70" inputType="text" rowSpan=""></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView></xf:group></xf:group></body>
</html>
 