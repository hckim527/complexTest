<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
					<w2:columnInfo>
						<w2:column id="cdNm" name="name1" dataType="text"></w2:column>
						<w2:column id="menuLv" name="name2" dataType="text"></w2:column>
						<w2:column id="drilldown" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<menuLv><![CDATA[0]]></menuLv>
							<drilldown><![CDATA[가계약번호]]></drilldown>
						</w2:row>
						<w2:row>
							<menuLv><![CDATA[1]]></menuLv>
							<drilldown><![CDATA[피보험자_1]]></drilldown>
						</w2:row>
						<w2:row>
							<menuLv><![CDATA[2]]></menuLv>
							<drilldown><![CDATA[법인등기부등본]]></drilldown>
						</w2:row>
						<w2:row>
							<menuLv><![CDATA[0]]></menuLv>
							<drilldown><![CDATA[가계약번호]]></drilldown>
						</w2:row>
						<w2:row>
							<menuLv><![CDATA[1]]></menuLv>
							<drilldown><![CDATA[피보험자_2]]></drilldown>
						</w2:row>
						<w2:row>
							<menuLv><![CDATA[1]]></menuLv>
							<drilldown><![CDATA[피보험자_3]]></drilldown>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<w2:layoutInfo/>
		<w2:publicInfo method=""/>
		<script lazy="false" type="text/javascript"><![CDATA[
//spanAll 에 boolean 값으로 제어
scwin.trigger1_onclick = function (e) {
    gridView1.spanAll(false);
};
	scwin.checkVal1 = function() {
		return (document.getElementById('gridView1_cell_0_2') || document.getElementById('mf_gridView1_cell_0_2')).querySelector('span').classList.contains('w2grid_plus');
	}		
	scwin.checkVal2 = function() {
		return (document.getElementById('gridView1_cell_1_2') || document.getElementById('mf_gridView1_cell_1_2')).querySelector('span').classList.contains('w2grid_plus');
	}		
	scwin.checkVal3 = function() {
		return !(document.getElementById('gridView1_cell_2_2') || document.getElementById('mf_gridView1_cell_2_2')).querySelector('span').classList.contains('w2grid_minus');
	}
]]></script>
	</head>
	<body>
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="gridView1" style="width:617px;height:153px;"
			dataList="data:dataList1">
			<w2:header id="header3">
				<w2:row id="row5">
					<w2:column width="70" inputType="text" id="column9" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column8" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column7" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody3">
				<w2:row id="row6">
					<w2:column width="70" inputType="text" id="cdNm" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="menuLv" displayMode="label"></w2:column>
					<w2:column width="70" inputType="drilldown" id="drilldown" displayMode="label" depthColumn="menuLv"
						depthStartIndex="0">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="width:197px;height:26px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[gridView1.spanAll(false);]]></xf:label>
		</xf:trigger>
	</body>
</html>
