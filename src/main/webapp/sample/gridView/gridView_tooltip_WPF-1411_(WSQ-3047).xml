<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거)
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};

scwin.tooltip_test = function(label) {
	return "label tooltip formatter";
};

scwin.mouseOverBehaviour = function(id) {
	var el = scwin.__getDom($p.id + id);
	var evt = document.createEvent('MouseEvents');
	evt.initEvent('mouseover', true, false);
	el.dispatchEvent(evt);
};

scwin.onpageload = function() {
	window.arr = [];
	for (var i = 0; i < 3 * 10; i++) {
		arr[i] = i;
	}
	dataList1.setData(arr);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" style="position: absolute;width:470px;height:223px;left:121px;top:269px;" useShiftKey="true"
			tooltipHeader="true" tooltipHeaderShowAlways="true" tooltipFormatterHeader="scwin.tooltip_test"
			tooltipDisplay="true" tooltipShowAlways="true" tooltipFormatter="scwin.tooltip_test" rowStatusVisible="true" rowNumVisible="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" style="height:20px" width="70" inputType="text" displayMode="label" value="name1"></w2:column>
					<w2:column id="column3" style="height:20px" width="70" inputType="text" displayMode="label" value="name2"></w2:column>
					<w2:column id="column2" style="height:20px" width="70" inputType="text" displayMode="label" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column id="column9" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column8" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="column7" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:footer>
		</w2:gridView>
		<w2:gridView dataList="dataList1" id="gridView2" style="position: absolute;width:470px;height:223px;left:648px;top:266px;" useShiftKey="true"
			tooltipDisplay="true" tooltipHeader="false" tooltipFormatter="scwin.tooltip_test" tooltipShowAlways="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column1" style="height:20px" width="70" inputType="text" displayMode="label" value="name1"></w2:column>
					<w2:column id="column3" style="height:20px" width="70" inputType="text" displayMode="label" value="name2"></w2:column>
					<w2:column id="column2" style="height:20px" width="70" inputType="text" displayMode="label" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="col2" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
					<w2:column id="col3" style="height:20px" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
