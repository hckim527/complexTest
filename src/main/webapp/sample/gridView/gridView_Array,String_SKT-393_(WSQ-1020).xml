<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	dataList1.setData(["a", "b", "c"]);
};
scwin.trigger2_onclick = function(e) {
	dataList1.setData("[\"AA\",\"BB\",\"CC\"]");
};
scwin.onpageload = function() {
	dataList1.setData([1, 2, 3, 4, 5, 6, 7, 8, 9]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id=""
			style="position: absolute;width:556px;height:398px;" fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" style="height:20px" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column3" style="height:20px" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column1" style="height:20px" width="70" inputType="text" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col2" style="height:20px" inputType="text" width="70"></w2:column>
					<w2:column id="col3" style="height:20px" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: absolute;width:92px;height:32px;left:556px;top:-2px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[Array]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger2" style="position: absolute;width:92px;height:32px;left:556px;top:30px;" type="button" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[String]]></xf:label>
		</xf:trigger>
	</body>
</html>
 