						<INFO><col1>a1</col1><col2>a2</col2><col3>a3</col3><col4>a4</col4></INFO>
						<INFO><col1>a1</col1><col2>a2</col2><col3>a3</col3><col4>a4</col4></INFO>
					</vector>
