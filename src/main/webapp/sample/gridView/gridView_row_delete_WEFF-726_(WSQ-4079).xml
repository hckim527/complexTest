						</vector>
					</temp>
				</data>
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.removed = null;
scwin.trigger2_onclick = function(e) {
	grid1.removeRow(1);
};
scwin.trigger3_onclick = function(e) {
	grid1.setXML(WebSquare.ModelUtil.findInstanceNode("temp/vector"));
};
scwin.trigger4_onclick = function(e) {
	scwin.removed = grid1.getRemovedJSON();
};
scwin.trigger5_onclick = function(e) {
	grid1.removeRow(2);
};
]]></script>
	</head>
	<body>
		<w2:grid baseNode="vector" id="grid1" repeatNode="INFO" useShiftKey="true" style="position: absolute ;left: 78px;top: 45px;width: 556px;height: 299px;" fixedColumnWithHidden="true" ref="vector" rowStatusVisible="true">
			<w2:header style="" id="header1">
				<w2:row style="" id="row1">
					<w2:column width="70" inputType="text" id="column1" value="col1"></w2:column>
					<w2:column width="70" inputType="text" id="column7" value="col2"></w2:column>
