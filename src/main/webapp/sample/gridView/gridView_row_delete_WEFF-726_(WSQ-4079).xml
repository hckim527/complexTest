			<xf:label><![CDATA[removeRow1]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" style="position: absolute ;left:673px;top:139px;width: 237px;height: 64px;" id="trigger3" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[재조회]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger5" style="position: absolute ;left:673px;top:209px;width: 237px;height: 64px;" type="button" ev:onclick="scwin.trigger5_onclick">
			<xf:label><![CDATA[removeRow2]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger4" style="position: absolute ;left:927px;top:65px;width: 237px;height: 64px;" type="button" ev:onclick="scwin.trigger4_onclick">
