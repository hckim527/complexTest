<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData1 = [{
		"col1": "a"
	}, {
		"col1": "b"
	}, {
		"col1": "c"
	}, {
		"col1": "d"
	}, {
		"col1": "e"
	}, {
		"col1": "f"
	}];
	dataList1.setJSON(jsonData1);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="padding:20px;" id="">
			<w2:gridView dataList="data:dataList1" dataDragSelect="true" style="width:600px;height:160px;" id="gridView1" defaultCellHeight="20" class="cm_grid" arrowMove="true" moveKeyEditMode="" moveKeyEditModeAll="" editModeEvent="onclick">
				<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
				<w2:header id="header1">
					<w2:row id="row1">
						<w2:column width="70" inputType="text" style="height:20px;" id="column9" value="name1" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px;" id="column7" value="name2" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px;" id="column5" value="name3" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px;" id="column3" value="select" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" style="height:20px;" id="column1" value="float" displayMode="label"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody1">
					<w2:row id="row2">
						<w2:column width="70" inputType="text" id="col1" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col2" displayMode="label"></w2:column>
						<w2:column width="70" inputType="text" id="col3" displayMode="label"></w2:column>
						<w2:column width="70" inputType="select" id="col4" displayMode="label" chooseOption="true" chooseOptionLabel="$blank"></w2:column>
						<w2:column width="70" inputType="text" id="col5" displayMode="label" dataType="float" displayFormat="#,###.000" maxLength="8.3"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
