<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dlTemplate" baseNode="list" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="chk" name="chk" dataType="text" ignoreStatus="true"></w2:column>
						<w2:column id="brdId" name="brdId" dataType="text"></w2:column>
						<w2:column id="prntId" name="prntId" dataType="text"></w2:column>
						<w2:column id="brdCtnt" name="brdCtnt" dataType="text"></w2:column>
						<w2:column id="cmtDesc" name="cmtDesc" dataType="text"></w2:column>
						<w2:column id="optCd" name="optCd" dataType="text"></w2:column>
						<w2:column id="tpCd" name="tpCd" dataType="text"></w2:column>
						<w2:column id="creUsrId" name="creUsrId" dataType="text"></w2:column>
						<w2:column id="usrEml" name="usrEml" dataType="text"></w2:column>
						<w2:column id="creDt" name="creDt" dataType="text"></w2:column>
						<w2:column id="updDt" name="updDt" dataType="text"></w2:column>
						<w2:column id="readKnt" name="readKnt" dataType="text"></w2:column>
						<w2:column id="usrPwd" name="usrPwd" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [
		{ "chk": "", "brdId": "aaa", "prntId": "", "brdCtnt": "", "cmtDesc": "", "optCd": "", "tpCd": "", "creUsrId": "", "usrEml": "", "creDt": "", "updDt": "", "readKnt": "", "usrPwd": "" },
		{ "chk": "", "brdId": "bbb", "prntId": "", "brdCtnt": "", "cmtDesc": "", "optCd": "", "tpCd": "", "creUsrId": "", "usrEml": "", "creDt": "", "updDt": "", "readKnt": "", "usrPwd": "" },
		{ "chk": "", "brdId": "ccc", "prntId": "", "brdCtnt": "", "cmtDesc": "", "optCd": "", "tpCd": "", "creUsrId": "", "usrEml": "", "creDt": "", "updDt": "", "readKnt": "", "usrPwd": "" }
	];
	dlTemplate.setJSON(jsonData);
};

scwin.gvTemplate_onviewchange = function(info) {
	console.log("onviewchange: ", info);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView class="cm_grid" id="gvTemplate" rowStatusVisible="true" style="height: 150px;" dataList="data:dlTemplate"
			focusDefaultColumn="true" ev:onviewchange="scwin.gvTemplate_onviewchange" useShiftKey="true" dataDragSelect="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="30" inputType="checkbox" id="column25" value="chk" fixColumnWidth="true"></w2:column>
					<w2:column width="70" inputType="text" id="column23" value="brdId" class="req"></w2:column>
					<w2:column width="70" inputType="text" id="column21" value="prntId"></w2:column>
					<w2:column width="70" inputType="text" id="column19" value="brdCtnt" class="req"></w2:column>
					<w2:column width="70" inputType="text" id="column17" value="cmtDesc"></w2:column>
					<w2:column width="70" inputType="text" id="column15" value="optCd"></w2:column>
					<w2:column width="70" inputType="text" id="column13" value="tpCd"></w2:column>
					<w2:column width="70" inputType="text" id="column11" value="creUsrId"></w2:column>
					<w2:column width="70" inputType="text" id="column9" value="usrEml"></w2:column>
					<w2:column width="70" inputType="text" id="column7" value="creDt"></w2:column>
					<w2:column width="70" inputType="text" id="column5" value="updDt"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="readKnt"></w2:column>
					<w2:column width="70" inputType="text" id="column1" value="usrPwd"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="30" inputType="checkbox" id="chk" fixColumnWidth="true"></w2:column>
					<w2:column width="70" inputType="text" id="brdId" class="req"></w2:column>
					<w2:column width="70" inputType="text" id="prntId"></w2:column>
					<w2:column width="70" inputType="text" id="brdCtnt" class="req"></w2:column>
					<w2:column width="70" inputType="text" id="cmtDesc"></w2:column>
					<w2:column width="70" inputType="select" id="optCd" displayMode="label">
						<w2:choices></w2:choices>
					</w2:column>
					<w2:column width="70" inputType="text" id="tpCd"></w2:column>
					<w2:column width="70" inputType="text" id="creUsrId"></w2:column>
					<w2:column width="70" inputType="text" id="usrEml"></w2:column>
					<w2:column width="70" inputType="text" id="creDt"></w2:column>
					<w2:column width="70" inputType="text" id="updDt"></w2:column>
					<w2:column width="70" inputType="text" id="readKnt"></w2:column>
					<w2:column width="70" inputType="text" id="usrPwd"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html> 
