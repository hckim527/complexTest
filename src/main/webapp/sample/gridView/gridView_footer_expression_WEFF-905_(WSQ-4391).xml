<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"/>
						<w2:column id="col2" name="name2" dataType="number" defaultValue="0"/>
						<w2:column id="col3" name="name3" dataType="text"/>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{
		"col1": "a",
		"col2": "10000.12"
	}, {
		"col1": "a",
		"col2": "20000.12"
	}, {
		"col1": "a",
		"col2": "30000.1"
	}, {
		"col1": "b",
		"col2": "40000"
	}, {
		"col1": "b",
		"col2": "50000"
	}];
	dataList1.setJSON(jsonData);
	gridView1.advancedExcelDownload({
		fileName: "gridView_excel_footer.xlsx",
		useDataFormat: true
	});
};
scwin.fn_test = function(value) {
	var retVal = value
	return retVal;
}
		]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" style="position: absolute ;left:33px;top:23px;width:516px;height:301px;">
			<w2:caption id="caption1" value="this is a grid caption."/>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" removeBorderStyle="false" inputType="text" width="70" value="name1" displayMode="label"/>
					<w2:column id="column3" removeBorderStyle="false" inputType="text" width="70" value="name2" displayMode="label"/>
					<w2:column id="column1" removeBorderStyle="false" width="70" inputType="text" value="name3" displayMode="label"/>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" removeBorderStyle="false" inputType="text" width="70" displayMode="label"/>
					<w2:column id="col2" removeBorderStyle="false" inputType="text" width="70" displayFormat="#,##0.00" displayMode="label" dataType="number"/>
					<w2:column id="col3" removeBorderStyle="false" width="70" inputType="text" displayMode="label"/>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal2" targetColumnID="col1">
				<w2:row id="row7">
					<w2:column id="column17" removeBorderStyle="false" width="70" inputType="text" displayMode="label"/>
					<w2:column id="column16" removeBorderStyle="false" width="70" inputType="expression" expression="SUM('col2')" dataType="number" displayFormat="#,##0.00" displayFormatter="scwin.fn_test" displayMode="label"/>
					<w2:column id="column15" removeBorderStyle="false" width="70" inputType="text" displayMode="label"/>
				</w2:row>
			</w2:subTotal>
			<w2:footer id="footer1">
				<w2:row id="row3">
					<w2:column id="column9" removeBorderStyle="false" width="70" inputType="text" displayMode="label"/>
					<w2:column id="column8" removeBorderStyle="false" width="70" inputType="expression" displayFormat="#,##0.00" displayMode="label" dataType="number" expression="SUM('col2')"/>
					<w2:column id="column7" removeBorderStyle="false" width="70" inputType="text" displayMode="label"/>
				</w2:row>
			</w2:footer>
		</w2:gridView>
	</body>
</html>
