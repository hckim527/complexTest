<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="number"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
						<w2:column id="col7" name="name7" dataType="text"></w2:column>
						<w2:column id="col8" name="name8" dataType="text"></w2:column>
						<w2:column id="col9" name="name9" dataType="text"></w2:column>
						<w2:column id="col10" name="name10" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<style>
			.w2subtotalplus {
				color : red;
			}
			.w2subtotalminus {
				color : blue;
			}
		</style>
		<script type="javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var data = [];
	var row = 50;
	var col = 10;
	for (var i = 0; i < row; i++) {
		for (var j = 0; j < col; j++) {
			var t = Math.floor(i / 5);
			data.push(t * 100 + j * (t+1));
		}
	}
	dataList1.setData(data);
};

scwin.gridView1_subtotalStyleFormatter = function(value, formattedValue) {
	if (value === 0 || !value) {
		return;
	}
	if (value > 0) {
		return "w2subtotalplus";
	} else {
		return "w2subtotalminus";
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1" rowNumVisible="true" style="width:843px;height:700px;" subtotalStyleFormatter="scwin.gridView1_subtotalStyleFormatter" drawType="native">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column21" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column19" width="70" value="name2" displayMode="label" rowSpan="2"></w2:column>
					<w2:column id="column17" width="70" value="name3" displayMode="label" rowSpan="2"></w2:column>
					<w2:column id="column15" width="70" value="name4" displayMode="label"></w2:column>
					<w2:column id="column13" width="141" value="name5" displayMode="label"></w2:column>
					<w2:column id="column11" width="70" value="name6" displayMode="label"></w2:column>

				</w2:row>
				<w2:row id="row4">
					<w2:column id="column9" width="70" value="name7" displayMode="label"></w2:column>
					<w2:column id="column7" width="70" value="name8" displayMode="label"></w2:column>
					<w2:column id="column5" width="70" value="name9" displayMode="label"></w2:column>
					<w2:column id="column3" width="70" value="name10" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row44">
					<w2:column id="col1" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" width="70" displayMode="label" rowspan='2'></w2:column>
					<w2:column id="col3" width="70" displayMode="label" rowspan='2'></w2:column>
					<w2:column id="col4" width="70" displayMode="label">
					</w2:column>
					<w2:column id="col5" width="141" displayMode="label">
					</w2:column>
					<w2:column id="col6" width="70" displayMode="label">
					</w2:column>

				</w2:row>
				<w2:row id="row54">
					<w2:column id="col7" width="70" displayMode="label">
					</w2:column>
					<w2:column id="col8" width="70" displayMode="label">
					</w2:column>
					<w2:column id="col9" width="70" displayMode="label">
					</w2:column>
					<w2:column id="col10" width="70" displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>

			<w2:subTotal id="subTotal1" targetColumnID="col1">
				<w2:row id="row552">
					<w2:column id="column32" width="70" displayMode="label"></w2:column>
					<w2:column id="column31" width="70" displayMode="label" rowSpan="2"></w2:column>
					<w2:column id="column55" width="70" displayMode="label" rowSpan="2"></w2:column>
					<w2:column id="column30" width="70" displayMode="label"></w2:column>
					<w2:column id="column29" width="70" displayMode="label"></w2:column>
					<w2:column id="column28" width="141" inputType="expression" displayMode="label" expression="sum('col6') + sum('col10')" displayFormat="0###,###,###,###">
					</w2:column>
				</w2:row>
				<w2:row id="row551">
					<w2:column id="column26" width="70" displayMode="label"></w2:column>
					<w2:column id="column25" width="70" displayMode="label"></w2:column>
					<w2:column id="column24" width="70" displayMode="label"></w2:column>
					<w2:column id="column23" width="70" inputType="expression" displayMode="label" expression="sum('col6') - sum('col10')">
					</w2:column>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
	</body>
</html>
