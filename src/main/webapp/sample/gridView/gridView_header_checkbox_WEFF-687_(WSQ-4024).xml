<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="checkbox" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setData(["1", "aaa", "111", "0", "bbb", "222"]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1"
			style="width: 500px;height: 150px;" sortable="true" columnMove="true">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column11" inputType="text" width="70"
						value="name11" displayMode="label" colSpan="2">
					</w2:column>
					<w2:column id="column9" inputType="text" width="70" value="name21" displayMode="label">
					</w2:column>
				</w2:row>
				<w2:row id="row3">
					<w2:column id="column7" inputType="checkbox" width="70"
						value="checkbox" displayMode="label">
					</w2:column>
					<w2:column id="column5" inputType="text" width="70" value="name2" displayMode="label">
					</w2:column>
					<w2:column id="column3" width="70" inputType="text" value="name3" displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" inputType="checkbox" width="70" displayMode="label">
					</w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label">
					</w2:column>
					<w2:column id="col3" width="70" inputType="text" displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
