<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map"
					ev:oncelldatachange="scwin.dataList1_oncelldatachange">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[1]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[2]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[3]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[4]]></col1>
							<col2><![CDATA[4]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.gridView1_onviewchange = function(info) {
	log.push("onviewchange");
};
scwin.dataList1_oncelldatachange = function(info) {
	log.push("oncelldatachange");
};
scwin.trigger1_onclick = function(e) {
	gridView1.setColumnReadOnly("col1", true);
};
scwin.trigger2_onclick = function(e) {
	gridView1.setColumnDisabled("col1", true);
};
scwin.fireDbClick = function(node) {
	if (document.createEventObject) {
		node.fireEvent('ondblclick');
	} else if (document.createEvent) {
		var evt = document.createEvent('MouseEvents');
		evt.initEvent('dblclick', true, false);
		node.dispatchEvent(evt);
	} else if (typeof node.ondblclick == 'function') {
		node.ondblclick();
	}
}
scwin.Dbclick = function(id) {
	var el = scwin.__getDom($p.id + id);
	scwin.fireDbClick(el);
}
scwin.onpageload = function() {
	window.log = [];
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" defaultCellHeight="27" id="gridView1"
			style="position: absolute;width: 500px;height: 150px;left:309px;top:244px;" useShiftKey="true"
			ev:onviewchange="scwin.gridView1_onviewchange">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" style="height:20px;" inputType="text" width="70" value="select"></w2:column>
					<w2:column id="column1" style="height:20px;" width="70" inputType="text" value="text"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="select" width="70" eventPriority="oneditend">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="col1"></w2:label>
								<w2:value ref="col2"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col2" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>

		<xf:trigger type="button" id="trigger1" style="position: absolute;width:139px;height:23px;left:830px;top:169px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setColumnReadonly]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger2" style="position: absolute;width:139px;height:23px;left:830px;top:194px;" type="button" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[setColumnDisabled]]></xf:label>
		</xf:trigger>
	</body>
</html>
 