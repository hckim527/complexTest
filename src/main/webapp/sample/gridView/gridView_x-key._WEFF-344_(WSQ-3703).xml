	dataList1.setJSON(jsonData);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;" defaultCellHeight="20" dataList="data:dataList1" directEdit="true">
			<w2:header id="header2">
