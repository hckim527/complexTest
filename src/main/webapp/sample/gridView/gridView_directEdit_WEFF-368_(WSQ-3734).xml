<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name3" dataType="text"></w2:column>
						<w2:column id="col5" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList2.setJSON([
		{ "label": "라벨1", "value": "밸류1" },
		{ "label": "라벨2", "value": "밸류2" },
		{ "label": "라벨3", "value": "밸류3" },
		{ "label": "라벨4", "value": "밸류4" }
	]);
	dataList1.insertRow();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;" defaultCellHeight="20" dataList="data:dataList1" directEdit="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column9" inputType="text" width="70" value="text" displayMode="label"></w2:column>
					<w2:column id="column7" inputType="text" width="70" value="textarea" displayMode="label"></w2:column>
					<w2:column id="column5" inputType="text" width="70" value="secret" displayMode="label"></w2:column>
					<w2:column id="column3" inputType="text" width="89" value="calendar" displayMode="label"></w2:column>
					<w2:column id="column1" width="92" inputType="text" value="autoComplete" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="textarea" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" inputType="secret" width="70" displayMode="label"></w2:column>
					<w2:column id="col4" inputType="calendar" width="89" displayMode="label"></w2:column>
					<w2:column id="col5" width="92" inputType="autoComplete" displayMode="label">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
