	com2.chkMultiCellVisible = function(grdObj, chkColumn, columnArrStr, modifiedIndex) {
		modifiedIndex = parseInt(modifiedIndex);
		var grdComp;
		if (typeof grdObj !== "undefined") {
			if (typeof grdObj === "string") {
				grdComp = $p.getComponentById(grdObj);
			} else {
				grdComp = grdObj;
			}
		}
		window.dcObjId = grdComp.getDataList();
		window.dcObj = $p.getComponentById(dcObjId);
		window.gridId = grdComp.getID();
		window.rowCnt = dcObj.getTotalRow();
		window.multiColumnArr = columnArrStr.split(",");
		window.multiColumnArrLength = multiColumnArr.length;
		for (var i = 0; i < rowCnt; i++) {
			for (var j = 0; j < multiColumnArrLength; j++) {
				window.cellName = multiColumnArr[j];
				window.txt = dcObj.getCellData(i, chkColumn);
				if (txt.trim() != "") {
					grdComp.setCellVisible(i, cellName, true);
				} else {
					grdComp.setCellVisible(i, cellName, false);
				}
			}
		}
		if (modifiedIndex > -1) {
			for (var j = 0; j < multiColumnArrLength; j++) {
				grdComp.setCellVisible(modifiedIndex, cellName, true);
			}
		}
	};
