<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList3" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="title" name="name1" dataType="text"></w2:column>
						<w2:column id="contens" name="name2" dataType="text"></w2:column>
						<w2:column id="date" name="name3" dataType="text"></w2:column>
						<w2:column id="remark" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// 헤더 클릭 시 column7(checkbox) 헤더 값을 로그로 남김
scwin.grd2_onheaderclick = function(headerId) {
	WebSquare.logger.printLog(grd2.getHeaderValue("column7"));
};
scwin._checkErr = function() {
	var log = WebSquare.logger.getLog();
	return log.indexOf("true") != -1;
};
scwin.onpageload = function() {
	dataList3.insertRow();
	dataList3.insertRow();
	dataList3.insertRow();
	dataList3.insertRow();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList3" id="grd2" style="position: absolute ;left:160px;top:141px;width:318px;height:159px;" useFilterList="false" useShiftKey="true" ev:onheaderclick="scwin.grd2_onheaderclick">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column displayMode="label" id="column7" inputType="checkbox" style="height:20px" value="name1" width="70"></w2:column>
					<w2:column displayMode="label" id="column5" inputType="text" style="height:20px" value="name2" width="70"></w2:column>
					<w2:column displayMode="label" id="column3" inputType="text" style="height:20px" value="name3" width="70"></w2:column>
					<w2:column displayMode="label" id="column1" inputType="text" style="height:20px" value="name4" width="70"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column displayMode="label" id="title" inputType="select" style="height:20px" width="70">
						<w2:choices></w2:choices>
					</w2:column>
					<w2:column displayMode="label" id="contens" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayMode="label" id="date" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayMode="label" id="remark" inputType="text" style="height:20px" width="70"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
