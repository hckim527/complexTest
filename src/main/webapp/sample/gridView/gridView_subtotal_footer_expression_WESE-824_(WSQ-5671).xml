/**------------------------------------------------------------------
 * 합계 표기(값이 없을때 0으로 표기)
 * 초기값 오류 처리를 위해 function 으로 처리한다.
 * (원본 com.util.isEmpty 공통 모듈 대신 같은 의미의 빈값 확인)
 */
scwin.isEmpty = function (v) {
	return v === undefined || v === null || v === "";
};
scwin.userExpZero = function (col1) {
	if (scwin.isEmpty(col1)) {
		return 0;
	} else {
		return col1;
	}
};
/**------------------------------------------------------------------
 * 점수 합계 표기
 */
scwin.userExpCol = function (col1, col2) {
	if (scwin.isEmpty(col1) || scwin.isEmpty(col2)) {
		return 0;
	} else {
		return col1/col2;
	}
};
scwin.checkVal1 = function() {
	return document.getElementsByTagName('nobr')[78].innerText == '5.0%';
};
]]></script>
