<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="inputTypeList" ev:oncelldatachange="scwin.inputTypeList_oncelldatachange">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2">
					<w2:columnInfo>
						<w2:column id="label" dataType="text"></w2:column>
						<w2:column id="value" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// 하단 inputTypeList 값으로 상단 gridView1 셀의 inputType 결정(가변 속성)
scwin.getType = function(info) {
	var rowIndex = info.rowIndex;
	var colIndex = info.colIndex;
	var type = inputTypeList.getCellData(rowIndex, colIndex);
	var id = "dynamic_" + (type || "text") + "_" + rowIndex + "_" + colIndex;   // inputType 별로 id 가 달라야 셀이 새 타입으로 다시 생성됨
	switch (type) {
		case "radio":
			return { id: id, inputType: "radio", options: { groupName: "radio_" + rowIndex } };
		case "checkbox":
			return { id: id, inputType: "checkbox", options: {} };
		case "button":
			return { id: id, inputType: "button", options: {} };
		case "calendar":
			return { id: id, inputType: "calendar", options: { viewType: "icon", dataValidCheck: true } };
		case "image":
			return { id: id, inputType: "image", options: { imageSrc: "/img/gif.gif" } };
		default:
			return { id: id, inputType: "text", options: {} };
	}
};
// typeGetter="getType" 전역 이름 해석 대비
window.getType = scwin.getType;

scwin.inputTypeList_oncelldatachange = function(info) {
	gridView1.refreshCell(info.rowIndex, info.colID);
};

scwin.onpageload = function() {
	dataList2.setData(["radio", "radio", "checkbox", "checkbox", "button", "button", "calendar", "calendar", "image", "image"]);
	var arr = [];
	for (var i = 0; i < 300; i++) {
		arr.push("");
	}
	dataList1.setData(arr.slice(0));
	inputTypeList.setData(arr.slice(0, 65));
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1" rowNumVisible="true" sortable="true" style="position:relative;width:700px;height:300px;left:63px;top:34px;border:1px solid black;float:left;clear:none;" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="header1" style="height:20px" inputType="text" width="*" value="col1"></w2:column>
					<w2:column id="header2" style="height:20px" inputType="text" width="*" value="col2"></w2:column>
					<w2:column id="header3" style="height:20px" inputType="text" width="*" value="col3"></w2:column>
					<w2:column id="header4" style="height:20px" inputType="text" width="*" value="col4"></w2:column>
					<w2:column id="header5" style="height:20px" inputType="text" width="*" value="col5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" inputType="custom" typeGetter="getType"></w2:column>
					<w2:column id="col2" inputType="custom" typeGetter="getType"></w2:column>
					<w2:column id="col3" inputType="custom" typeGetter="getType"></w2:column>
					<w2:column id="col4" inputType="custom" typeGetter="getType"></w2:column>
					<w2:column id="col5" inputType="custom" typeGetter="getType"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:gridView dataList="inputTypeList" id="gridView2" rowNumVisible="true" style="position:relative;width:700px;height:300px;left:61px;top:62px;border:1px solid black;float:left;clear:none;margin-top:25px;" useShiftKey="true" sortable="true">
			<w2:header id="header1">
				<w2:row id="row2">
					<w2:column id="header1" style="height:20px" inputType="text" width="*" value="col1"></w2:column>
					<w2:column id="header2" style="height:20px" inputType="text" width="*" value="col2"></w2:column>
					<w2:column id="header3" style="height:20px" inputType="text" width="*" value="col3"></w2:column>
					<w2:column id="header4" style="height:20px" inputType="text" width="*" value="col4"></w2:column>
					<w2:column id="header5" style="height:20px" inputType="text" width="*" value="col5"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody4">
				<w2:row id="row5">
					<w2:column id="col1" inputType="select">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col2" inputType="select">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col3" inputType="select">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col4" inputType="select">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column id="col5" inputType="select">
						<w2:choices>
							<w2:itemset nodeset="data:dataList2">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
