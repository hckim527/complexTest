<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_menu" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="depth" name="depth" dataType="text"></w2:column>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
						<w2:column id="path" name="path" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<depth><![CDATA[1]]></depth>
							<label><![CDATA[메뉴 1번]]></label>
							<value><![CDATA[menu1]]></value>
						</w2:row>
						<w2:row>
							<depth><![CDATA[2]]></depth>
							<label><![CDATA[하위메뉴 2번]]></label>
							<value><![CDATA[menu1-2]]></value>
						</w2:row>
						<w2:row>
							<depth><![CDATA[2]]></depth>
							<label><![CDATA[하위메뉴 3번]]></label>
							<value><![CDATA[menu1-3]]></value>
						</w2:row>
						<w2:row>
							<depth><![CDATA[3]]></depth>
							<label><![CDATA[최하위 4번]]></label>
							<value><![CDATA[menu1-5]]></value>
						</w2:row>
						<w2:row>
							<depth><![CDATA[3]]></depth>
							<label><![CDATA[최하위 5번]]></label>
							<value><![CDATA[menu1-6]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<!-- showDepth 생략 -->
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="grd_menu" style="width: 500px;height: 150px;"
			dataList="data:dlt_menu">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="drilldown" displayMode="label"></w2:column>
					<w2:column width="108" inputType="text" id="column2" value="label" displayMode="label"></w2:column>
					<w2:column width="125" inputType="text" id="column1" value="value" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="column8" displayMode="label"></w2:column>
					<w2:column width="70" inputType="drilldown" id="depth" displayMode="label" depthColumn="depth" depthType="div"></w2:column>
					<w2:column width="108" inputType="text" id="label" displayMode="label"></w2:column>
					<w2:column width="125" inputType="text" id="value" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<!-- showDepth="0" -->
		<w2:gridView checkAllType="false" defaultCellHeight="20" id="grd_menu2" style="width: 500px;height: 150px;"
			dataList="data:dlt_menu">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="70" inputType="text" id="column4" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="drilldown" displayMode="label"></w2:column>
					<w2:column width="108" inputType="text" id="column2" value="label" displayMode="label"></w2:column>
					<w2:column width="125" inputType="text" id="column1" value="value" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="70" inputType="text" id="column8" displayMode="label"></w2:column>
					<w2:column width="70" inputType="drilldown" id="depth" displayMode="label" depthColumn="depth" depthType="div" showDepth="0"></w2:column>
					<w2:column width="108" inputType="text" id="label" displayMode="label"></w2:column>
					<w2:column width="125" inputType="text" id="value" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
