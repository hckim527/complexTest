<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
    scwin.onpageload = function() {
        gridView1.setSubtotalVisible(false);
        var jsonData = [{"col1":"a", "col2":"a1"},{"col1":"a", "col2":"a2"},{"col1":"a", "col2":"a3"}
                        ,{"col1":"b", "col2":"b1"},{"col1":"b", "col2":"b2"}];
        dataList1.setJSON(jsonData);
        gridView1.setSubtotalVisible(true);
    };
    scwin.trigger1_onclick = function(e) {
        gridView1.setSubtotalVisible(true);
    };
    scwin.trigger2_onclick = function(e) {
        gridView1.setSubtotalVisible(false);
    };
	scwin.checkVal = function() {
		return (document.getElementById('column13') || document.getElementById('mf_column13')) != null;
	}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" style="width:181px;height:23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setSubtotalVisible true]]></xf:label>
		</xf:trigger>
	<xf:trigger ev:onclick="scwin.trigger2_onclick" id="trigger2" style="width:181px;height:23px;" type="button">
			<xf:label><![CDATA[setSubtotalVisible false]]></xf:label>
		</xf:trigger>
		<w2:gridView id="gridView1" style="width: 500px;height: 200px;" defaultCellHeight="20"
			dataList="data:dataList1" visibleRowNum="10">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column6" value="name1"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name2"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name3"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name4"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" style="height:20px" id="col1"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col2"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col3"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="col4"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
			<w2:subTotal targetColumnID="col1" id="subTotal1">
				<w2:row id="row5">
					<w2:column width="70" inputType="expression" style="height:20px" id="column14"
						displayMode="label" expression="targetColValue()">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column13"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column12"
						displayMode="label">
					</w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column11"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
	</body>
</html>