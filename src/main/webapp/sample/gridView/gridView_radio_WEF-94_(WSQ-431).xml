	dl_person.setData(["0", "강민아", "false", "0", "1", "N", "R4", "19900105", "O", "/img/icon_F.png", "41", "41190", "6", "164", "47", "대한민국의 피겨 스케이팅 선수이다. 밴쿠버 동계 올림픽 여자 싱글 부문 챔피언, 2009 · 2013년 세계 선수권 챔피언이며, 대한민국 최초의 올림픽 피겨 스케이팅 메달리스트, 세계 선수권 메달리스트이다.", "K 대학교", "A 스포츠", "0", "김민호", "false", "0", "1", "N", "R3", "19930516", "A", "/img/icon_F.png", "41", "41610", "1", "161.8", "44", "가수, 탤런드", "D여자고등학교", "R TREE", "0", "장민주", "false", "0", "1", "N", "R1", "19801107", "AB", "/img/icon_F.png", "11", "11710", "1,7", "171", "49", "모델·방송인이다. 1997년 서울 컬렉션 오디션에서 합격·데뷔하여 개성있는 얼굴로 주목을 받았다. ", "S대 영화과", "EST"]);
};
scwin.onpageload = function() {
