			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="checkbox" width="70"></w2:column>
					<w2:column id="col2" inputType="text" width="70"></w2:column>
					<w2:column id="col3" width="70" inputType="text" readOnly="true"></w2:column>
