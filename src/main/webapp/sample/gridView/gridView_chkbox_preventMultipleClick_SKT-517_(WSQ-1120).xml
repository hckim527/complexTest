				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setData(["1", 1, 2, "0", 3, 4, "1", 5, 6, "0", 7, 8, "1", 1, 2, "0", 3, 4, "1", 5, 6, "0", 7, 8, "1", 1, 2, "0", 3, 4, "1", 5, 6, "0", 7, 8]);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" defaultCellHeight="20" id="gridView1"
			style="position: relative;width:462px;height:202px;" fixedColumnWithHidden="true" useShiftKey="true" rowNumVisible="true">
			<w2:header id="header1">
				<w2:row id="row1">
