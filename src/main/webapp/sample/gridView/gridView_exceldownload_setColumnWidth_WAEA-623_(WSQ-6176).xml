<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dataList1" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="col1" name="name1"/>
						<w2:column dataType="text" id="col2" name="name2"/>
						<w2:column dataType="text" id="col3" name="name3"/>
						<w2:column dataType="text" id="col4" name="name4"/>
						<w2:column dataType="text" id="col5" name="name5"/>
						<w2:column dataType="text" id="col6" name="name6"/>
						<w2:column dataType="text" id="col7" name="name7"/>
						<w2:column dataType="text" id="col8" name="name8"/>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[2]]></col2>
							<col3><![CDATA[3]]></col3>
							<col4><![CDATA[4]]></col4>
							<col5><![CDATA[5]]></col5>
							<col6><![CDATA[6]]></col6>
							<col7><![CDATA[7]]></col7>
							<col8><![CDATA[8]]></col8>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridViewSample1.setColumnWidth(1, 500);
};
scwin.btnClick_onclick = function(e) {
	var options = {
		common: {
			openFile: true,
			fileName: "temp.xlsx",
			showProcess: true,
			multipleSheet: true
		},
		excelInfo: [
			{gridId: "gridViewSample1", sheetName: "sheet", type: "1", startRowIndex: 0, startColumnIndex: 0}
		]
	};
	WebSquare.util.multipleExcelDownload(options);
};
		]]></script>
	</head>
	<body>
		<xf:group id="grp_body" class="sub_contents">
			<xf:trigger type="button" id="trigger1" style="position:relative;width:321px;height:23px;" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[gridViewSample1.setColumnWidth(1, 500);]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="btnClick" style="width:200px; height:23px;" ev:onclick="scwin.btnClick_onclick">
				<xf:label><![CDATA[excel download]]></xf:label>
			</xf:trigger>
			<w2:gridView id="gridViewSample1" class="grid" dataList="data:dataList1" defaultCellHeight="20" editModeEvent="onclick" focusMode="cell" style="height:158px;">
				<w2:caption id="caption1" value="this is a grid caption."/>
				<w2:header>
					<w2:row>
						<w2:column colSpan="3" displayMode="label" id="HeaderProduct" inputType="text" value="1" width="340"/>
						<w2:column width="70" inputType="text" id="column14" value="4"/>
						<w2:column id="column7" inputType="text" value="5" width="70"/>
						<w2:column id="column10" inputType="text" value="6" width="70"/>
					</w2:row>
				</w2:header>
				<w2:gBody>
					<w2:row>
						<w2:column id="col1" inputType="text" width="70"/>
						<w2:column id="col2" inputType="text"/>
						<w2:column id="col3" inputType="text" width="200"/>
						<w2:column id="col4" inputType="text" width="70"/>
						<w2:column id="col5" inputType="text" width="70"/>
						<w2:column id="col6" inputType="text" width="70"/>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
		</xf:group>
	</body>
</html>
