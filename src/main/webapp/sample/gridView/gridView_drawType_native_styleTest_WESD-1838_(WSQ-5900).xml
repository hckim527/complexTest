			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column displayMode="label" id="col1" inputType="text" style="height:20px" width="70"></w2:column>
					<w2:column displayMode="label" id="col2" inputType="text" style="background-color:red;height:20px;" width="70"></w2:column>
					<w2:column displayMode="label" id="col3" inputType="text" style="height:50px;" width="70"></w2:column>
