						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[a]]></col1>
						</w2:row>
						<w2:row>
							<col1><![CDATA[b]]></col1>
							<col3><![CDATA[a1]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[c]]></col1>
							<col3><![CDATA[a2]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[d]]></col1>
							<col3><![CDATA[a3]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[e]]></col1>
							<col2><![CDATA[1]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[f]]></col1>
							<col2><![CDATA[2]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[g]]></col1>
							<col2><![CDATA[3]]></col2>
						</w2:row>
						<w2:row>
							<col2><![CDATA[4]]></col2>
						</w2:row>
						<w2:row>
							<col2><![CDATA[5]]></col2>
						</w2:row>
						<w2:row>
							<col2><![CDATA[6]]></col2>
						</w2:row>
						<w2:row>
							<col2><![CDATA[7]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.onpageload = function() {
	};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:textbox id="" label='drawType="virtual"' style="width: 150px;height: 23px;"></w2:textbox>
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;" checkAllType="false" defaultCellHeight="20"
			dataList="data:dataList1" drawType="virtual">
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="name1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="name2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="name3" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="background-color:red;height:20px;" id="col2" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:50px;" id="col3" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<w2:textbox id="" label='drawType="native"' style="width: 150px;height: 23px;"></w2:textbox>
		<w2:gridView checkAllType="false" dataList="data:dataList1" defaultCellHeight="20" id="gridView2"
