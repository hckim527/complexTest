<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:data>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="col4" name="name4" dataType="text"></w2:column>
						<w2:column id="col5" name="name5" dataType="text"></w2:column>
						<w2:column id="col6" name="name6" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var data = [];
	for (var i = 0; i < 100; i++) {
		for (var j = 0; j < 6; j++) {
			data.push(Math.floor(j / 2) * 100 + Math.floor(i / (j + 2)));
		}
	}
	dataList1.setData(data);
	dataList2.setData(["bycol", "bycol", "byrow", "byrow", "bycolrec", "bycolrec", "byrowrec", "byrowrec", "byrestriccol", "byrestriccol", "byrestricrow", "byrestricrow", "never", "never"]);
};
scwin.select1_onviewchange = function(info) {
	gridView1.mergeCells(info.newValue);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" scrollByColumn="false" defaultCellHeight="20" scrollByColumnAdaptive="false" id="gridView1" style="width:500px;height:300px;" rowNumVisible="true" mergeCells="bycol">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column id="column13" removeBorderStyle="false" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column11" removeBorderStyle="false" inputType="text" width="70" value="name2" displayMode="label"></w2:column>
					<w2:column id="column9" removeBorderStyle="false" inputType="text" width="70" value="name3" displayMode="label"></w2:column>
					<w2:column id="column7" removeBorderStyle="false" inputType="text" width="70" value="name4" displayMode="label"></w2:column>
					<w2:column id="column5" removeBorderStyle="false" inputType="text" width="70" value="name5" displayMode="label"></w2:column>
					<w2:column id="column3" removeBorderStyle="false" width="70" inputType="text" value="name6" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column id="col1" removeBorderStyle="false" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" removeBorderStyle="false" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col3" removeBorderStyle="false" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col4" removeBorderStyle="false" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col5" removeBorderStyle="false" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col6" removeBorderStyle="false" width="70" inputType="text" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal1" targetColumnID="col1">
				<w2:row id="row5">
					<w2:column id="column20" removeBorderStyle="false" width="70" inputType="expression" displayMode="label" expression="SUM('col1')"></w2:column>
					<w2:column id="column19" removeBorderStyle="false" width="70" inputType="expression" displayMode="label" expression="SUM('col2')"></w2:column>
					<w2:column id="column18" removeBorderStyle="false" width="70" inputType="expression" displayMode="label" expression="SUM('col3')"></w2:column>
					<w2:column id="column17" removeBorderStyle="false" width="70" inputType="expression" displayMode="label" expression="SUM('col4')"></w2:column>
					<w2:column id="column16" removeBorderStyle="false" width="70" inputType="expression" displayMode="label" expression="SUM('col5')"></w2:column>
					<w2:column id="column15" removeBorderStyle="false" width="70" inputType="expression" displayMode="label" expression="SUM('col6')"></w2:column>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
		<xf:select1 appearance="minimal" submenuSize="auto" direction="auto" id="select1" style="width:291px;height:45px;" ev:onviewchange="scwin.select1_onviewchange" visibleRowNum="10">
			<xf:choices>
				<xf:itemset nodeset="data:dataList2">
					<xf:label ref="col1"></xf:label>
					<xf:value ref="col2"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
	</body>
</html>
