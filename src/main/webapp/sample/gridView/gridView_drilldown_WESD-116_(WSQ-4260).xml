<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
						<w2:column id="depth" name="depth" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{
		"col2": "a1fewfekwlmfefewl",
		"col3": "a1",
		"depth": "0"
	}, {
		"col2": "a1-1",
		"col3": "a1-1",
		"depth": "1"
	}, {
		"col2": "a2",
		"col3": "a2",
		"depth": "0"
	}, {
		"col2": "a2-1",
		"col3": "a2-1",
		"depth": "1"
	}];
	dataList1.setJSON(jsonData);
};
scwin.checkVal = function() {
	return document.getElementById(gridView1.id + '_tooltip').style.display == 'block';
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="data:dataList1" defaultCellHeight="20" id="gridView1"
			drilldownRealRowIndexAll="true" drilldownRealRowIndex="true"
			tooltipDisplay="true"
			dataDragSelect="true" useShiftKey="true"
			style="position: absolute ;left: 63px;top: 70px;width: 484px;height: 188px;">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column7" inputType="checkbox" width="70" value="name1"
						displayMode="label">
					</w2:column>
					<w2:column id="column5" inputType="text" width="70" value="name2"
						displayMode="label">
					</w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name3"
						displayMode="label">
					</w2:column>
					<w2:column id="column1" width="70" inputType="text" value="depth"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="checkbox" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="col2" inputType="drilldown" width="70" depthType="line"
						displayMode="label" depthColumn="depth" showDepth="0">
					</w2:column>
					<w2:column id="col3" inputType="text" width="70"
						displayMode="label">
					</w2:column>
					<w2:column id="depth" width="70" inputType="text"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
