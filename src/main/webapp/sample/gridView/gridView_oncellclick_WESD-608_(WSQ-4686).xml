<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="gender" name="성별" dataType="text"></w2:column>
						<w2:column id="area" name="지역" dataType="text"></w2:column>
						<w2:column id="day" name="체류기간" dataType="text"></w2:column>
						<w2:column id="num" name="값" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<gender><![CDATA[남]]></gender>
							<area><![CDATA[천안]]></area>
							<day><![CDATA[1]]></day>
							<num><![CDATA[34]]></num>
						</w2:row>
						<w2:row>
							<gender><![CDATA[여]]></gender>
							<area><![CDATA[천안]]></area>
							<day><![CDATA[2]]></day>
							<num><![CDATA[242]]></num>
						</w2:row>
						<w2:row>
							<gender><![CDATA[남]]></gender>
							<area><![CDATA[부산]]></area>
							<day><![CDATA[3]]></day>
							<num><![CDATA[131]]></num>
						</w2:row>
						<w2:row>
							<gender><![CDATA[여]]></gender>
							<area><![CDATA[부산]]></area>
							<day><![CDATA[4]]></day>
							<num><![CDATA[33]]></num>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.clickLog = [];
scwin.gridView1_oncellclick = function(row, col, colId) {
    scwin.clickLog.push(row + ":" + col + ":" + colId);
};
]]></script>
	</head>
	<body>
		<w2:gridView id="gridView1" style="width: 500px;height: 150px;" defaultCellHeight="20"
			dataList="data:dataList1" ev:oncellclick="scwin.gridView1_oncellclick">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="70" inputType="text" style="height:20px" id="column6" value="성별" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column5" value="지역" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column4" value="체류기간" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="column3" value="값" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column width="70" inputType="radio" style="height:20px" id="gender" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="area" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="day" displayMode="label"></w2:column>
					<w2:column width="70" inputType="text" style="height:20px" id="num" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
