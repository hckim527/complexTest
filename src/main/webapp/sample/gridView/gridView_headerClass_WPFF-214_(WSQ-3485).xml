<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<style>
			.test_class {
				background : none !important;
				background-color : #00ccff !important;
			}
		</style>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	gridView1.setHeaderClass('column3', 'test_class');
};
scwin.trigger2_onclick = function(e) {
	gridView1.removeHeaderClass('column3', 'test_class');
};
]]></script>
	</head>
	<body>
		<w2:gridView dataList="data:dataList2" defaultCellHeight="20" id="gridView1" style="position: absolute;width:207px;height:150px;"
			useShiftKey="true" rowNumVisible="true">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3" inputType="text" width="70" value="name1" displayMode="label"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name2" displayMode="label"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70" displayMode="label"></w2:column>
					<w2:column id="col2" inputType="text" width="70" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
		<xf:trigger type="button" id="trigger1" style="position: absolute;width:292px;height:23px;left:211px;top:0px;"
			ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[1. setHeaderClass('column3', 'test_class')]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger2" style="position: absolute;width:292px;height:23px;left:211px;top:30px;" type="button"
			ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[2. removeHeaderClass('column3', 'test_class')]]></xf:label>
		</xf:trigger>
	</body>
</html>
