<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.gridView1_onsubtotalclick = function(info) {
	log = "[colID] = " + info.colID + ", [startRowIndex] = " + info.startRowIndex + ", [endRowIndex] = " + info.endRowIndex;
};
scwin.__isEl = function() {
	return el = ((j) => j.length ? j : $('#mf_gridView1_body_tbody tr'))($('#gridView1_body_tbody tr'));
}
scwin.checkVal1 = function() {
	return log == "[colID] = column7, [startRowIndex] = 6, [endRowIndex] = 8";
}
scwin.checkVal2 = function() {
	return log == "[colID] = column7, [startRowIndex] = 0, [endRowIndex] = 2";
}
scwin.onpageload = function() {
	window.data = [];
	for (var i = 0; i < 100; i++) {
		data.push(i);
		data.push(Math.floor(i / 3));
		data.push(i * i);
	}
	dataList1.setData(data);
}
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" defaultCellHeight="20" id="gridView1"
			style="position: relative;width:598px;height:429px;" useShiftKey="true" ev:onsubtotalclick="scwin.gridView1_onsubtotalclick" rowNumVisible="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column5" inputType="text" width="70" value="name1"></w2:column>
					<w2:column id="column3" inputType="text" width="70" value="name2"></w2:column>
					<w2:column id="column1" width="70" inputType="text" value="name3"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1" inputType="text" width="70"></w2:column>
					<w2:column id="col2" inputType="text" width="70" colMerge="true"></w2:column>
					<w2:column id="col3" width="70" inputType="text"></w2:column>
				</w2:row>
			</w2:gBody>
			<w2:subTotal id="subTotal1" targetColumnID="col2">
				<w2:row id="row3">
					<w2:column id="column9" width="70" inputType="expression" expression="sum('col1')"></w2:column>
					<w2:column id="column8" width="70" inputType="text"></w2:column>
					<w2:column id="column7" width="70" inputType="expression" expression="sum('col3')"></w2:column>
				</w2:row>
			</w2:subTotal>
		</w2:gridView>
	</body>
</html>
 