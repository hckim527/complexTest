<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list"
					saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1"
							dataType="text">
						</w2:column>
						<w2:column id="col2" name="name2"
							dataType="text">
						</w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dlt_select" baseNode="list"
					saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="code" name="name1"
							dataType="text">
						</w2:column>
						<w2:column id="value" name="name2"
							dataType="text">
						</w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
	var jsonData1 = [{
			"col1": "test",
			"col2": "1"
		},
		{
			"col1": "test",
			"col2": "1"
		},
		{
			"col1": "test",
			"col2": "1"
		},
		{
			"col1": "test",
			"col2": "1"
		},
		{
			"col1": "test",
			"col2": "1"
		},
		{
			"col1": "test",
			"col2": "1"
		},
		{
			"col1": "test",
			"col2": "2"
		},
		{
			"col1": "test",
			"col2": "2"
		},
		{
			"col1": "test",
			"col2": "2"
		},
		{
			"col1": "test",
			"col2": "2"
		},
		{
			"col1": "test",
			"col2": "2"
		}
	];
	var jsonData2 = [{
			"code": "code1",
			value: "1"
		},
		{
			"code": "code2",
			value: "2"
		}
	];
	dlt_select.setJSON(jsonData2);
	dataList1.setJSON(jsonData1);
};
scwin.onpageload = function() {
	scwin.init();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:gridView dataList="dataList1" id="gridView1"
			style="position: relative;width: 500px;height: 150px;"
			fixedColumnWithHidden="true" useShiftKey="true">
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column id="column3"
						style="height:20px" inputType="text" width="70"
						displayMode="label" value="name1">
					</w2:column>
					<w2:column id="column1"
						style="height:20px" width="70" inputType="text"
						displayMode="label" value="name2">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column id="col1"
						style="height:20px" inputType="text" width="70"
						displayMode="label" colMerge="true">
					</w2:column>
					<w2:column id="col2"
						style="height:20px" width="70" inputType="select"
						displayMode="label" colMerge="true" viewType="icon">
						<w2:choices>
							<w2:itemset nodeset="data:dlt_select">
								<w2:label ref="code"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
