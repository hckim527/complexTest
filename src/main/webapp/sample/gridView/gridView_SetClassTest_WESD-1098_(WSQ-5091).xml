		gridView1.setCellClass(2,2,"req");
	};
	scwin.trigger1_onclick = function(e) {
		dlt_emp.removeRow(dlt_emp.getRowPosition());
	};
	scwin.checkVal = function() {
		return !(document.getElementById('gridView1_cell_0_0') || document.getElementById('mf_gridView1_cell_0_0')).classList.contains('req');
