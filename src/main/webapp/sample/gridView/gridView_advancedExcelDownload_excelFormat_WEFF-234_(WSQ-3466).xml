<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="displayFormat='#,##0.##'" dataType="number"></w2:column>
						<w2:column id="col2" name="displayFormat=''" dataType="number"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[10000]]></col1>
							<col2><![CDATA[1000]]></col2>
						</w2:row>
						<w2:row>
							<col1><![CDATA[7.1]]></col1>
							<col2><![CDATA[8.1]]></col2>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	grid01.advancedExcelDownload({
		type: "1",
		fileName: "test.xlsx"
	});
};
]]></script>
	</head>
	<body>
	<xf:group style="height:173px;margin: 10px" id=""><xf:trigger style="width:154px;height:23px;" id="trigger1" type="button" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[엑셀다운로드]]></xf:label>
		</xf:trigger>
		<w2:gridView syncScroll="false" scrollByColumnAdaptive="false" summaryAuto="false" useShiftKey="true" scrollByColumn="false"
			summaryOnlyAuto="false" defaultCellHeight="20" applyAllColumnStyle="false" dataList="data:dataList1"
			style="width: 500px;height: 150px;margin-top: 10px;" ignoreCellClick="false" id="grid01" ignoreToggleOnDisabled="false">
			<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
			<w2:header id="header1">
				<w2:row id="row1">
					<w2:column width="192" inputType="text" id="column3" value="displayFormat='#,##0.##'" blockSelect="false"
						displayMode="label">
					</w2:column>
					<w2:column width="199" inputType="text" id="column1" value="displayFormat=''" blockSelect="false"
						displayMode="label">
					</w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody1">
				<w2:row id="row2">
					<w2:column width="192" inputType="text" id="col1" blockSelect="false" displayMode="label" displayFormat="#,##0.##" excelFormat="#,###.#"></w2:column>
					<w2:column width="199" inputType="text" id="col2" blockSelect="false" displayMode="label"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView></xf:group></body>
</html>
 