};
scwin.sbm_search_submitdone = function(e) {
	var _options = {
		closeGroup: false
	};
	scwin.setGridGroupby(_options);
};
// depth 별 소계(합계) groupbyHeader : 라벨(colSpan 3)·추세·M01~M12·TOTAL SUM
scwin.makeGroupbyHeader = function(depthIdx, className) {
	var header = [{
			align: 'left',
			colSpan: '3',
			inputType: 'expression',
			expression: 'toggle()+ depthStr().split("-")[' + depthIdx + '] + "합계"',
			className: className
		},
		{
			inputType: 'expression',
			className: 'spark',
			expression: ""
		}
	];
	var cols = ['M01', 'M02', 'M03', 'M04', 'M05', 'M06', 'M07', 'M08', 'M09', 'M10', 'M11', 'M12', 'TOTAL'];
	for (var i = 0; i < cols.length; i++) {
		header.push({
			align: 'right',
			inputType: 'expression',
			expression: "SUM('" + cols[i] + "')",
			displayFormat: '#,###'
		});
	}
	return header;
};
scwin.setGridGroupby = function(_options) {
	var options = {
		closeGroup: _options.closeGroup,
		hideFooter: true,
		sortIndex: [0, 1],
		sortOrder: [1, 1, 1],
		groupbyHeader: {
			depth_0: scwin.makeGroupbyHeader(0, 'grpDepth0'),
			depth_1: scwin.makeGroupbyHeader(1, '')
		}
	};
	gridView1.groupby(options);
};
]]></script>
