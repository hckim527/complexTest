<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.chg = {};
scwin.onpageload = function() {
	localStorage.removeItem("log1");
	localStorage.removeItem("log2");
	localStorage.removeItem("log3");
};
scwin.input1_onchange = function(info) {
	scwin.chg.input1 = info ? [info.oldValue, info.newValue] : "no info";
};
scwin.selectbox1_onchange = function(info) {
	scwin.chg.selectbox1 = info ? [info.oldValue, info.newValue] : "no info";
	if (info) {
		localStorage.setItem("log1", info.newValue);
	}
};
scwin.autoComplete1_onchange = function(info) {
	scwin.chg.autoComplete1 = info ? [info.oldValue, info.newValue] : "no info";
	if (info) {
		localStorage.setItem("log2", info.newValue);
	}
};
scwin.checkcombobox1_onchange = function(info) {
	scwin.chg.checkcombobox1 = info ? [info.oldValue, info.newValue] : "no info";
	if (info) {
		localStorage.setItem("log3", info.newValue);
	}
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="position:absolute;top:34px;left:45px;">
			<xf:input adjustMaxLength="false" id="input1" style="width: 144px;height: 21px;" ev:onchange="scwin.input1_onchange"></xf:input>
			<xf:select1 id="selectbox1" chooseOption="" style="width: 148px;height: 21px;" submenuSize="auto" allOption="" disabled="false" emptyItem="true" renderType="" direction="auto" appearance="minimal" disabledClass="w2selectbox_disabled" ev:onchange="scwin.selectbox1_onchange">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[new row]]></xf:label>
						<xf:value><![CDATA[1]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[new row]]></xf:label>
						<xf:value><![CDATA[2]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[new row]]></xf:label>
						<xf:value><![CDATA[3]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:select1>
			<w2:autoComplete editType="select" id="autoComplete1" useKeywordHighlight="false" style="width: 148px;height: 21px;" noResult="" submenuSize="auto" search="start" allOption="" chooseOption="" ev:onchange="scwin.autoComplete1_onchange">
				<w2:choices>
					<w2:item>
						<w2:label><![CDATA[new row]]></w2:label>
						<w2:value><![CDATA[1]]></w2:value>
					</w2:item>
					<w2:item>
						<w2:label><![CDATA[new row]]></w2:label>
						<w2:value><![CDATA[2]]></w2:value>
					</w2:item>
					<w2:item>
						<w2:label><![CDATA[new row]]></w2:label>
						<w2:value><![CDATA[3]]></w2:value>
					</w2:item>
				</w2:choices>
			</w2:autoComplete>
			<xf:checkcombobox submenuSize="auto" allOption="" disabled="false" id="checkcombobox1" direction="auto" displayAllOptionLabel="false" chooseOption="" displayMode="label" appearance="minimal" style="width: 148px;height: 21px;" ev:onchange="scwin.checkcombobox1_onchange">
				<xf:choices>
					<xf:item>
						<xf:label><![CDATA[new row]]></xf:label>
						<xf:value><![CDATA[1]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[new row]]></xf:label>
						<xf:value><![CDATA[2]]></xf:value>
					</xf:item>
					<xf:item>
						<xf:label><![CDATA[new row]]></xf:label>
						<xf:value><![CDATA[3]]></xf:value>
					</xf:item>
				</xf:choices>
			</xf:checkcombobox>
		</xf:group>
	</body>
</html>
