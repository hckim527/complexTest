<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map" />
			<w2:workflowCollection />
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.trigger1_onclick = function(e) {
	tabC1.setLabelText(0, "새로운 탭1");
};
]]></script>
	</head>
	<body>
		<w2:tabControl id="tabC1" alwaysDraw="false" style="width:706px;height:423px;" tabScroll="true" useTitleTooltip="true" noUseTitle="true">
			<w2:tabs style="height:40px;" id="tabs1" label="테스트 1화면"></w2:tabs>
			<w2:tabs style="height:40px" id="tabs2" label="Tabs2"></w2:tabs>
			<w2:content alwaysDraw="false" style="height:360px;" id="content1"></w2:content>
			<w2:content alwaysDraw="false" style="height:360px;" id="content2"></w2:content>
		</w2:tabControl>
		<xf:trigger type="button" id="trigger1" style="width:220px;height:23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[버튼(setLabelText)]]></xf:label>
		</xf:trigger>
	</body>
</html>
