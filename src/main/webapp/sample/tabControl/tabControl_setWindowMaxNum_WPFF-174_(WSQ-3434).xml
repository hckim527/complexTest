<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head>
    	<w2:type>DEFAULT</w2:type>
        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            </w2:dataCollection>
            <w2:workflowCollection>
            </w2:workflowCollection>
        </xf:model>
        <script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger3_onclick = function(e) {
    var tabOpt = {
        label: "New Add Tab",
        closable: true
    };
    var contOpt = {
        alwaysDraw: true,
        wframe: true,
        src: "tabControl/WebSquare.xml"
    };
    var tabID = "addtab" + tabIndex;
    tabOpt.addTabIndex = tabControlSample_selectbox.getValue();
    tabOpt.label += " " + tabIndex;
    tabControl1.addTab(tabID, tabOpt, contOpt);
    tabIndex++;
};
scwin.trigger4_onclick = function(e) {
    var tabOpt = {
        label: "Add Tab",
        closable: true
    };
    var contOpt = {
        alwaysDraw: true,
        wframe: true,
        src: "tabControl/WebSquare.xml"
    };
    var tabID = "addtab" + tabIndex;
    tabOpt.label += " " + tabIndex;
    tabControl1.addTab(tabID, tabOpt, contOpt);
    tabIndex++;
};
scwin.trigger5_onclick = function(e) {
    tabControl1.setWindowMaxNum(5);
};
scwin.onpageload = function() {
    window.tabIndex = 1;
}
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group id="" style="position: relative;" class="" adaptive="">
    		<w2:textbox label="*기존 Add Tab 함수" id="" style="position: relative;width: 150px;display: inline-block;"></w2:textbox>
    		<xf:trigger type="button" id="trigger4" style="position: relative;width: 80px;height: 23px;"
    			ev:onclick="scwin.trigger4_onclick">
    			<xf:label><![CDATA[Add Tab]]></xf:label>
    		</xf:trigger>
    		<xf:trigger id="trigger5" style="position: absolute;width:198px;height:23px;left:358px;top:2px;"
    			ev:onclick="scwin.trigger5_onclick" type="button">
    			<xf:label><![CDATA[setWindowMaxNum(5);]]></xf:label>
    		</xf:trigger>
    	</xf:group>
    	<xf:group adaptive="" class="" id="" style="position: relative;margin-top: 5px;">
    		<w2:textbox id="" label="*신규 Add Tab 함수" style="position: relative;width: 150px;display: inline-block;"></w2:textbox>
    		<xf:trigger ev:onclick="scwin.trigger3_onclick" id="trigger3" style="position: relative;width: 80px;height: 23px;"
    			type="button">
    			<xf:label><![CDATA[Add Tab]]></xf:label>
    		</xf:trigger>
    		<xf:select1 allOption="" appearance="minimal" chooseOption="" direction="auto" disabled="false"
    			disabledClass="w2selectbox_disabled" displayMode="label" id="tabControlSample_selectbox" optionOrder="false"
    			style="position: relative;width: 148px;height: 21px;" submenuSize="auto">
    			<xf:choices>
    				<xf:item>
    					<xf:label><![CDATA[Add Tab1]]></xf:label>
    					<xf:value><![CDATA[0]]></xf:value>
    				</xf:item>
    				<xf:item>
    					<xf:label><![CDATA[Add Tab2]]></xf:label>
    					<xf:value><![CDATA[1]]></xf:value>
    				</xf:item>
    				<xf:item>
    					<xf:label><![CDATA[Add Tab3]]></xf:label>
    					<xf:value><![CDATA[2]]></xf:value>
    				</xf:item>
    				<xf:item>
    					<xf:label><![CDATA[Add Tab4]]></xf:label>
    					<xf:value><![CDATA[3]]></xf:value>
    				</xf:item>
    				<xf:item>
    					<xf:label><![CDATA[Add Tab5]]></xf:label>
    					<xf:value><![CDATA[4]]></xf:value>
    				</xf:item>
    			</xf:choices>
    		</xf:select1>
    	</xf:group>
    	<w2:tabControl useTabKeyOnly="false" useMoveNextTabFocus="false" useBackbridge="true" useConfirmMessage="false"
    		confirmTrueAction="exist" confirmFalseAction="new" style="width: 1500px;height: 400px;padding-left:10px;" id="tabControl1"
    		tabScroll="true">
    		<w2:tabs label="Test1" closable="true" disabled="false" style="width:70px;height:30px;" id="tabs1"></w2:tabs>
    		<w2:tabs disabled="false" style="width:70px;height:30px" label="Test2" id="tabs2"></w2:tabs>
    		<w2:tabs id="tabs3" style="width:70px;height:30px" label="Test3" disabled="false"></w2:tabs>
    		<w2:content alwaysDraw="false" style="height:370px;" id="content1"></w2:content>
    		<w2:content alwaysDraw="false" style="height:270px;" id="content2"></w2:content>
    		<w2:content id="content3" style="height:370px" alwaysDraw="false"></w2:content>
    	</w2:tabControl>
    </body>
</html>
