<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	var tabIndex = 1;

	scwin.trigger4_onclick = function(e) {
		var tabOpt = {
			label : "org add Tab",
			closable : true,
			style : "background-color:red; width: 20px;"
		};
		//tab 추가 시 contents 의 옵션 추가
		var contOpt = {
			alwaysDraw : false,
			wframe: true,
			style : "background-color:blue; width: 20px; !important"
		};

		var tabID = "addtab" + tabIndex;
		tabOpt.label += " " + tabIndex;
		tabControl1.addTab(tabID, tabOpt, contOpt);
		tabIndex++;
	};

	scwin.checkVal = function() {
		let cssVal = (document.getElementById('tabControl1_contents_addtab1') || document.getElementById('mf_tabControl1_contents_addtab1')).style.cssText;
		cssVal = cssVal.indexOf("blue");
		return cssVal !== -1;
	};
	]]></script>
	</head>
	<body>
		<xf:group id="" style="position: relative;">
			<w2:textbox label="*기존 add Tab 함수" id="" style="position: relative;width: 150px;display: inline-block;"></w2:textbox>
			<xf:trigger type="button" id="trigger4" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger4_onclick">
				<xf:label><![CDATA[add Tab]]></xf:label>
			</xf:trigger>
		</xf:group>
		<w2:tabControl useTabKeyOnly="false" useMoveNextTabFocus="false" useBackbridge="true" useConfirmMessage="false"
			confirmTrueAction="exist" confirmFalseAction="new" style="width: 1500px;height: 400px;padding-left:10px;" id="tabControl1"
			tabScroll="true">
			<w2:tabs label="test1adafaadfafadfaf" closable="true" disabled="false" style="width:70px;height:30px;" id="tabs1"></w2:tabs>
			<w2:tabs disabled="false" style="width:70px;height:30px" label="test2" id="tabs2"></w2:tabs>
			<w2:tabs id="tabs3" style="width:70px;height:30px" label="test3" disabled="false"></w2:tabs>
			<w2:content alwaysDraw="false" style="height:370px;" id="content1"></w2:content>
			<w2:content alwaysDraw="false" style="height:270px;" id="content2"></w2:content>
			<w2:content id="content3" style="height:370px" alwaysDraw="false"></w2:content>
		</w2:tabControl>
	</body>
</html>
