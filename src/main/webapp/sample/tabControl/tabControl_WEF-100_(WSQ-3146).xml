	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.checkVal1 = function() {
	const element = (document.getElementById('tabControl1_btn_scrollRight') || document.getElementById('mf_tabControl1_btn_scrollRight'));
	let reVal = false;
	if (element && element.tagName.toLowerCase() === "button" && element.type === "button") {
		reVal = true;
	}
	return reVal;
};
scwin.checkVal2 = function() {
	const container = (document.getElementById('tabControl1_itemTable') || document.getElementById('mf_tabControl1_itemTable'));
	let reVal = false;
	if (!container) {
		return reVal;
	} else {
		var ulElement = container.querySelector("ul");
		if (!ulElement || ulElement.tagName.toLowerCase() !== "ul") {
			return reVal;
		} else {
			// ul 내부에 li 요소들을 모두 선택함
			var liElements = ulElement.querySelectorAll("li");
			if (liElements.length > 0) {
				reVal = true;
			} else {
				reVal = false;
			}
		}
	}
	return reVal;
};
]]></script>
	</head>
	<body>
