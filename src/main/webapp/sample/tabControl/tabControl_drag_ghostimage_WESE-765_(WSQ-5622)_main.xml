<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
	scwin.tabControl1_ontabsplit = function(dragIndex, e) {
		var options = {
			left: e.screenX + 'px',
			top: e.screenY + 'px',
		};
		var tabInfo = tabControl1.getTabInfo();
		var src = "";
		for (var i = 0; i < tabInfo.length; i++) {
			if (tabInfo[i].currentTabIndex == dragIndex) {
				src = tabInfo[i].src;
				break;
			}
		}
		$p.openPopup(src, options);
		return true; // true 리턴시 해당 탭 닫힘.
	};

	scwin.checkVal = function() {
		var temp = WebSquare.logger.getLog();
		return temp.indexOf('screenX') == -1;
	};
	]]></script>
	</head>
	<body>
		<xf:textarea id="textarea1" style="width:600px;height:200px"></xf:textarea>
		<w2:tabControl id="tabControl1" useTabKeyOnly="true" useMoveNextTabFocus="false" useConfirmMessage="false" confirmTrueAction="exist"
			confirmFalseAction="new" alwaysDraw="false" style="height: 400px;" hiddenTab="false" tabMove="true" tabSplit="true"
			ev:ontabsplit="scwin.tabControl1_ontabsplit">
			<w2:tabs disabled="false" style="width:70px;height:30px" label="tabs1" id="tabs1"></w2:tabs>
			<w2:tabs disabled="false" style="width:70px;height:30px" label="tabs2" id="tabs2"></w2:tabs>
			<w2:tabs disabled="false" style="width:70px;height:30px" label="tabs3" id="tabs3"></w2:tabs>
			<w2:tabs disabled="false" style="width:70px;height:30px" label="tabs4" id="tabs4"></w2:tabs>
			<w2:content frameMode="wframe" alwaysDraw="false" style="height:400px" id="content1" src="/sample/common_link/tabControl_drag_ghostimage_WESE-765_(WSQ-5622)_sub.xml" scope="true" closable="true"></w2:content>
			<w2:content frameMode="wframe" alwaysDraw="false" style="height:400px" id="content2" src="/sample/common_link/tabControl_drag_ghostimage_WESE-765_(WSQ-5622)_sub.xml" scope="true" closable="true"></w2:content>
			<w2:content frameMode="wframe" alwaysDraw="false" style="height:400px" id="content3" src="/sample/common_link/tabControl_drag_ghostimage_WESE-765_(WSQ-5622)_sub.xml" scope="true" closable="true"></w2:content>
			<w2:content frameMode="wframe" alwaysDraw="false" style="height:400px" id="content4" src="/sample/common_link/tabControl_drag_ghostimage_WESE-765_(WSQ-5622)_sub.xml" scope="true" closable="true"></w2:content>
		</w2:tabControl>
	</body>
</html>
