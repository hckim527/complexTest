<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger2_onclick = function(e) {
	tabControl1.addTab("iframe_01",
		{
			"label": "iframe01",
			"title": "iframe01",
			"openAction": "exist",
			"closable": "true"
		},
		{
			"src": "https://example.websquare.kr/websquare/websquare.html?w2xPath=/mainContainer.xml",
			"frameMode" : "iframe"
		}
	);
};

scwin.tabControl1_ontabload = function(tabID, idx, userID) {
	scwin.loadLog.push(tabID);
};
scwin.loadLog = [];
]]></script>
	</head>
	<body>
		<!-- trigger1(원래 wframe addTab 수동 버튼)은 없으면 TSCP 확인 시점(클릭 500ms 후)에 ontabload 가 아직 안 와서 FAIL → 버튼만 유지 -->
		<xf:trigger type="button" id="trigger1" style="position:relative;width:180px;height:23px;">
			<xf:label><![CDATA[wfrmae addTab]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position:relative;width:180px;height:23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[iframe addTab]]></xf:label>
		</xf:trigger>
		<w2:tabControl useTabKeyOnly="true" id="tabControl1" style="width:500px;height:200px;" ev:ontabload="scwin.tabControl1_ontabload"></w2:tabControl>
	</body>
</html>
