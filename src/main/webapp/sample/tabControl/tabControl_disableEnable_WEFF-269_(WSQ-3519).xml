<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	tabControl1.disableTab(selectbox1.getValue());
};
scwin.trigger2_onclick = function(e) {
	tabControl1.enableTab(selectbox1.getValue());
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[disableTab]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[enableTab]]></xf:label>
		</xf:trigger>
		<xf:select1 appearance="minimal" id="selectbox1" style="position: relative;width: 148px;height: 21px;">
			<xf:choices>
				<xf:item>
					<xf:label><![CDATA[tab1]]></xf:label>
					<xf:value><![CDATA[0]]></xf:value>
				</xf:item>
				<xf:item>
					<xf:label><![CDATA[tab2]]></xf:label>
					<xf:value><![CDATA[1]]></xf:value>
				</xf:item>
				<xf:item>
					<xf:label><![CDATA[tab3]]></xf:label>
					<xf:value><![CDATA[2]]></xf:value>
				</xf:item>
				<xf:item>
					<xf:label><![CDATA[tab4]]></xf:label>
					<xf:value><![CDATA[3]]></xf:value>
				</xf:item>
			</xf:choices>
		</xf:select1>
		<w2:tabControl useMoveNextTabFocus="false" id="tabControl1" style="position: relative ;width: 500px;height: 200px;" forceChildCompEnabled="true"
			confirmTrueAction="exist" useTabKeyOnly="true" useConfirmMessage="false" confirmFalseAction="new" alwaysDraw="false">
			<w2:tabs label="tab1" id="tabs1" style="width:70px;height:30px;"></w2:tabs>
			<w2:tabs id="tabs2" style="width:70px;height:30px" label="tab2"></w2:tabs>
			<w2:content id="content1" style="height:170px" alwaysDraw="false">
				<w2:autoComplete search="start" displayMode="label" id="" style="position: relative;width: 148px;height: 21px;" editType="select"
					disabled="true">
					<w2:choices>
						<w2:item>
							<w2:label><![CDATA[new row]]></w2:label>
							<w2:value><![CDATA[]]></w2:value>
						</w2:item>
						<w2:item>
							<w2:label><![CDATA[new row]]></w2:label>
							<w2:value><![CDATA[]]></w2:value>
						</w2:item>
						<w2:item>
							<w2:label><![CDATA[new row]]></w2:label>
							<w2:value><![CDATA[]]></w2:value>
						</w2:item>
					</w2:choices>
				</w2:autoComplete>
				<xf:select1 appearance="minimal" id="" style="position: relative;width: 148px;height: 21px;">
					<xf:choices>
						<xf:item>
							<xf:label><![CDATA[new row]]></xf:label>
							<xf:value><![CDATA[]]></xf:value>
						</xf:item>
						<xf:item>
							<xf:label><![CDATA[new row]]></xf:label>
							<xf:value><![CDATA[]]></xf:value>
						</xf:item>
						<xf:item>
							<xf:label><![CDATA[new row]]></xf:label>
							<xf:value><![CDATA[]]></xf:value>
						</xf:item>
						<xf:item>
							<xf:label><![CDATA[new row]]></xf:label>
							<xf:value><![CDATA[]]></xf:value>
						</xf:item>
					</xf:choices>
				</xf:select1>
			</w2:content>
			<w2:content id="content2" style="height:170px" alwaysDraw="false"></w2:content>
		</w2:tabControl>
	</body>
</html>
