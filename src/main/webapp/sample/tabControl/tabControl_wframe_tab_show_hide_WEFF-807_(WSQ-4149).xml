<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	tabControl1.showTab(0);
	tabControl1.showTab(1);
	tabControl1.hideTab(2);
	tabControl1.hideTab(3);
	tabControl1.hideTab(4);
};
scwin.trigger2_onclick = function(e) {
	tabControl1.hideTab(0);
	tabControl1.hideTab(1);
	tabControl1.showTab(2);
	tabControl1.showTab(3);
	tabControl1.showTab(4);
};
scwin.trigger3_onclick = function(e) {
	tabControl1.showTab(0);
	tabControl1.showTab(1);
	tabControl1.showTab(2);
	tabControl1.showTab(3);
	tabControl1.showTab(4);
};
scwin.getErrorLog = function() {
	var temp = WebSquare.logger.getErrorLog();
	return temp;
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" style="width: 80px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[1]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger2" style="width: 80px;height: 23px;" type="button" ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[2]]></xf:label>
		</xf:trigger>
		<xf:trigger id="trigger3" style="width: 80px;height: 23px;" type="button" ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[3]]></xf:label>
		</xf:trigger>
		<xf:group>
			<w2:tabControl confirmTrueAction="exist" useTabKeyOnly="true" confirmFalseAction="new" useMoveNextTabFocus="false" useConfirmMessage="false"
				alwaysDraw="false" style="width: 500px;height: 200px;" id="tabControl1">
				<w2:tabs style="width:70px;height:30px;" id="tabs1" label="111"></w2:tabs>
				<w2:tabs style="width:70px;height:30px" id="tabs2" label="222"></w2:tabs>
				<w2:tabs style="width:70px;height:30px" id="tabs3" label="333"></w2:tabs>
				<w2:tabs style="width:70px;height:30px" id="tabs4" label="444"></w2:tabs>
				<w2:tabs style="width:70px;height:30px" id="tabs5" label="555"></w2:tabs>
				<w2:content alwaysDraw="false" style="height:170px" id="content1"></w2:content>
				<w2:content alwaysDraw="false" style="height:170px" id="content2"></w2:content>
				<w2:content alwaysDraw="false" style="height:170px" id="content3"></w2:content>
				<w2:content alwaysDraw="false" style="height:170px" id="content4"></w2:content>
				<w2:content alwaysDraw="false" style="height:170px" id="content5"></w2:content>
			</w2:tabControl>
		</xf:group>
	</body>
</html>
