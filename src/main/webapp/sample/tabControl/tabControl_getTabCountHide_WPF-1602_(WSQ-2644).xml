<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	log = tabControl1.getTabCount();
};
scwin.trigger2_onclick = function(e) {
	tabControl1.hideTab(0);
	tabControl1.hideTab(1);
	tabControl1.hideTab(2);
};
scwin.trigger3_onclick = function(e) {
	log1 = tabControl1.getTabCount({
		hiddenTab: false
	});
};
scwin.onpageload2 = function() {
	window.log = ""; window.log1 = "";
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload2">
		<w2:tabControl useMoveNextTabFocus="false" id="tabControl1" style="position: absolute ;width: 500px;height: 200px;left:101px;top:82px;"
			confirmTrueAction="exist" useTabKeyOnly="true" useConfirmMessage="false" confirmFalseAction="new" alwaysDraw="false">
			<w2:tabs label="tab1" id="tabs1" style="width:70px;height:30px;"></w2:tabs>
			<w2:tabs id="tabs2" style="width:70px;height:30px" label="tab2"></w2:tabs>
			<w2:tabs id="tabs3" style="width:70px;height:30px" label="tab3"></w2:tabs>
			<w2:tabs id="tabs4" style="width:70px;height:30px" label="tab4"></w2:tabs>
			<w2:tabs id="tabs5" style="width:70px;height:30px" label="tab5"></w2:tabs>
			<w2:content id="content1" style="height:170px" alwaysDraw="false"></w2:content>
			<w2:content id="content2" style="height:170px" alwaysDraw="false"></w2:content>
			<w2:content id="content3" style="height:170px" alwaysDraw="false"></w2:content>
			<w2:content id="content4" style="height:170px" alwaysDraw="false"></w2:content>
			<w2:content id="content5" style="height:170px" alwaysDraw="false"></w2:content>
		</w2:tabControl>
		<xf:trigger type="button" id="trigger1" style="position: absolute;width:168px;height:41px;left:266px;top:328px;"
			ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[tabControl1.getTabCount()]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger2" style="position: absolute;width:97px;height:42px;left:163px;top:328px;"
			ev:onclick="scwin.trigger2_onclick">
			<xf:label><![CDATA[hideTab]]></xf:label>
		</xf:trigger>
		<xf:trigger type="button" id="trigger3" style="position: absolute;width:324px;height:41px;left:440px;top:328px;"
			ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[tabControl1.getTabCount({hiddenTab:false})]]></xf:label>
		</xf:trigger>
	</body>
</html>
