<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger01_onclick = function (e) {
	var idx = 1;
	var tabOpt = {
		label : "test"+idx++
		,openAction : "new"
		,closable : true
	};
	var contOpt = {
		frameMode: "wframe"
	};

	tabControl1.addTab( "test1"+idx++ , tabOpt , contOpt );
};

scwin.tabControl1_onsubmenufooterclick = function (e) {
	tabControl1.deleteAllTabs();
};

scwin.checkVal1 = function() {
	const check1 = (document.getElementById('tabControl1_itemTable_header') || document.getElementById('mf_tabControl1_itemTable_header')).innerText == '열린화면 목록'
	const check2 = (document.getElementById('tabControl1_itemTable_footer') || document.getElementById('mf_tabControl1_itemTable_footer')).innerText == '목록 전체닫기'

	return check1 && check2;
};

scwin.checkVal2 = function() {
	return (document.getElementById('tabControl1_tab_test12') || document.getElementById('mf_tabControl1_tab_test12')) === null;
};

scwin.checkVal3 = function() {
	return (document.getElementById('tabControl1_container') || document.getElementById('mf_tabControl1_container')).children.length == 0;
};
]]></script>
	</head>
	<body>
		<xf:group tagname="fieldset" style="font-size:18px;height30px;border:1px solid red;">
			<legend>accessibility true - closable 전체설정 : 없음, 개별설정 : 없음</legend>
			<w2:tabControl subMenuHeaderTitle="열린화면 목록" subMenuFooterTitle="목록 전체닫기" useTabKeyOnly="true" id="tabControl1" useMoveNextTabFocus="false" useConfirmMessage="false" ev:onsubmenufooterclick="scwin.tabControl1_onsubmenufooterclick"
				confirmTrueAction="exist" confirmFalseAction="new" alwaysDraw="false"
				useAccessibilityMenu="false" tabScroll="true" adaptive="layout" adaptiveThreshold="400"
				useATagBtn="true" useCloseButton="true" accessibility="true">
				<w2:tabs disabled="false" style="width:70px;height:30px;" id="tabs1" label="탭1"></w2:tabs>
				<w2:tabs disabled="false" style="width:70px;height:30px;" id="tabs2" label="탭2"></w2:tabs>
				<w2:tabs disabled="false" style="width:70px;height:30px;" id="tabs3" label="탭3"></w2:tabs>
				<w2:tabs disabled="false" style="width:70px;height:30px;" id="tabs4" label="탭4"></w2:tabs>
				<w2:tabs disabled="false" style="width:70px;height:30px;" id="tabs5" label="탭5"></w2:tabs>
				<w2:content alwaysDraw="false" style="height:170px" id="content1"></w2:content>
				<w2:content alwaysDraw="false" style="height:170px" id="content2"></w2:content>
				<w2:content alwaysDraw="false" style="height:170px" id="content3"></w2:content>
				<w2:content alwaysDraw="false" style="height:170px" id="content4"></w2:content>
				<w2:content alwaysDraw="false" style="height:170px" id="content5"></w2:content>
			</w2:tabControl>
			<xf:trigger type="button" id="trigger01" style="width:277px;height:43px;" ev:onclick="scwin.trigger01_onclick">
				<xf:label><![CDATA[tabControl1 addTab closable true]]></xf:label>
			</xf:trigger>
		</xf:group>
		<xf:group tagname="fieldset" style="font-size:18px;height30px;border:1px solid red;">
			<legend>accessibility true - closable 전체설정 : true, 개별설정 : false</legend>
			<w2:tabControl subMenuHeaderTitle="열린화면 목록" subMenuFooterTitle="목록 전체닫기" adaptive="layout" adaptiveThreshold="400" alwaysDraw="false" closable="true" confirmFalseAction="new"
				confirmTrueAction="exist" id="tabControl2" tabScroll="true" useATagBtn="true" useAccessibilityMenu="false" useCloseButton="true" accessibility="true"
				useConfirmMessage="false" useMoveNextTabFocus="false" useTabKeyOnly="true">
				<w2:tabs closable="false" disabled="false" id="tabs1" label="탭1" style="width:70px;height:30px;"></w2:tabs>
				<w2:tabs disabled="false" id="tabs2" label="탭2" style="width:70px;height:30px;"></w2:tabs>
				<w2:tabs closable="false" disabled="false" id="tabs3" label="탭3" style="width:70px;height:30px;"></w2:tabs>
				<w2:tabs disabled="false" id="tabs4" label="탭4" style="width:70px;height:30px;"></w2:tabs>
				<w2:tabs disabled="false" id="tabs5" label="탭5" style="width:70px;height:30px;"></w2:tabs>
				<w2:content alwaysDraw="false" id="content1" style="height:170px"></w2:content>
				<w2:content alwaysDraw="false" id="content2" style="height:170px"></w2:content>
				<w2:content alwaysDraw="false" id="content3" style="height:170px"></w2:content>
				<w2:content alwaysDraw="false" id="content4" style="height:170px"></w2:content>
				<w2:content alwaysDraw="false" id="content5" style="height:170px"></w2:content>
			</w2:tabControl>
		</xf:group>
	</body>
</html>
