<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	tabControl1.deleteAllTabs();
};
scwin.isDeleteAll = function() {
	return (document.getElementById('tabControl1_tabhost') || document.getElementById('mf_tabControl1_tabhost')).getElementsByTagName("li").length == 0;
};
]]></script>
	</head>
	<body>
		<w2:tabControl useMoveNextTabFocus="false" id="tabControl1" style="position: relative ;width: 500px;height: 200px;"
			confirmTrueAction="exist" useTabKeyOnly="true" useConfirmMessage="false" confirmFalseAction="new" alwaysDraw="false"
			closable="true">
			<w2:tabs label="tab1" id="tabs1" style="width:70px;height:30px;" closable="true"></w2:tabs>
			<w2:tabs id="tabs3" style="width:70px;height:30px" label="tab2"></w2:tabs>
			<w2:tabs id="tabs4" style="width:70px;height:30px" label="tab3"></w2:tabs>
			<w2:tabs id="tabs5" style="width:70px;height:30px" label="tab4"></w2:tabs>
			<w2:content id="content1" style="height:170px" alwaysDraw="false"></w2:content>
			<w2:content id="content3" style="height:170px" alwaysDraw="false"></w2:content>
			<w2:content id="content4" style="height:170px" alwaysDraw="false"></w2:content>
			<w2:content id="content5" style="height:170px" alwaysDraw="false"></w2:content>
		</w2:tabControl>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:131px;height:23px;left:-491px;top:20px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[deleteAllTabs]]></xf:label>
		</xf:trigger>
	</body>
</html>
