<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map" />
			<w2:workflowCollection />
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.trigger4_onclick = function(e) {
	tac_tabcontrol2.enableTab(0);
	tac_tabcontrol2.setSelectedTabIndex(0);
};
]]></script>
	</head>
	<body>
		<xf:trigger id="trigger4" style="width: 100px;height: 23px;margin-left:5px;" type="button" ev:onclick="scwin.trigger4_onclick">
			<xf:label><![CDATA[enableTab(0)]]></xf:label>
		</xf:trigger>
		<w2:tabControl alwaysDraw="true" class="tbc tbc_status" id="tac_tabcontrol2" style="width:700px;height:200px;border: #00ff00 solid 1px;">
			<w2:tabs disabled="true" id="tabs4" label="Tabs1" style="height:40px;"></w2:tabs>
			<w2:tabs disabled="true" id="tabs5" label="Tabs2" style="height:40px;"></w2:tabs>
			<w2:content id="content4">
				<xf:input disabled="true" id="input1" style="width: 144px;"></xf:input>
			</w2:content>
			<w2:content id="content5"></w2:content>
		</w2:tabControl>
	</body>
</html>
