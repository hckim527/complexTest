<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
			<w2:workflowCollection/>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사). 2026-11
scwin.__getJq = function(q) {
	var j = $(q); if (j.length) return j;
	var P = 'mf_', t = q.trim(), r = t.slice(1);
	if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
	return $(t.slice(0, 1) + r);
};

scwin.trigger1_onclick = function(e) {
	if (tabControl1.tabArr[0].disabled === false) {
		tabControl1.disableTab(0);
	} else {
		tabControl1.enableTab(0);
	}
};

scwin.trigger3_onclick = function(e) {
	if (tabControl2.tabArr[1].disabled === false) {
		tabControl2.disableTab(1);
	} else {
		tabControl2.enableTab(1);
	}
};

scwin.hasClass = function(id) {
	return scwin.__getJq(id).hasClass('w2tabcontrol_disabled');
};
]]></script>
	</head>
	<body>
		<xf:group>
			<xf:trigger type="button" style="position:relative;width:177px;height:23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[mainTab disable toggle]]></xf:label>
			</xf:trigger>
		</xf:group>
		<xf:group style="position: relative;width: 200px;height: 200px;">
			<w2:tabControl useTabKeyOnly="true" id="tabControl1" keepDisabledTab="true" style="position: relative ;width: 500px;height: 200px;">
				<w2:tabs style="width:70px;height:30px;" id="tabs1"></w2:tabs>
				<w2:content style="height:170px" id="content1">
					<w2:tabControl useTabKeyOnly="true" id="tabControl2" keepDisabledTab="true" style="position: relative ;width: 100%;height: 100%;">
						<w2:tabs style="width:110px;height:30px;" id="tabs2" label="tab1_subtab1"></w2:tabs>
						<w2:tabs style="width:110px;height:30px" id="tabs3" label="tab1_subtab2"></w2:tabs>
						<w2:content style="height:100%;" id="content2">
							<xf:trigger type="button" style="position:relative;width:177px;height:23px;" id="trigger3" ev:onclick="scwin.trigger3_onclick">
								<xf:label><![CDATA[subTab2 disable toggle]]></xf:label>
							</xf:trigger>
						</w2:content>
						<w2:content style="height:100%;" id="content3"></w2:content>
					</w2:tabControl>
				</w2:content>
			</w2:tabControl>
		</xf:group>
	</body>
</html>
