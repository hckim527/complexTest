<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_chartData_1" repeatNode="data" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="quarter" name="quarter"></w2:column>
						<w2:column dataType="text" id="type1" name="type1"></w2:column>
						<w2:column dataType="text" id="type2" name="type2"></w2:column>
						<w2:column dataType="text" id="type3" name="type3"></w2:column>
						<w2:column dataType="text" id="type4" name="type3"></w2:column>
					</w2:columnInfo>
					<w2:data use="true" xmlns="">
						<w2:row>
							<quarter><![CDATA[Q1]]></quarter>
							<type1><![CDATA[11500]]></type1>
							<type2><![CDATA[28110]]></type2>
							<type3><![CDATA[23990]]></type3>
							<type4><![CDATA[14400]]></type4>
						</w2:row>
						<w2:row>
							<quarter><![CDATA[Q2]]></quarter>
							<type1><![CDATA[1500]]></type1>
							<type2><![CDATA[10600]]></type2>
							<type3><![CDATA[10000]]></type3>
							<type4><![CDATA[5200]]></type4>
						</w2:row>
						<w2:row>
							<quarter><![CDATA[Q3]]></quarter>
							<type1><![CDATA[27400]]></type1>
							<type2><![CDATA[31800]]></type2>
							<type3><![CDATA[42800]]></type3>
							<type4><![CDATA[15300]]></type4>
						</w2:row>
						<w2:row>
							<quarter><![CDATA[Q4]]></quarter>
							<type1><![CDATA[27400]]></type1>
							<type2><![CDATA[22900]]></type2>
							<type3><![CDATA[20800]]></type3>
							<type4><![CDATA[15200]]></type4>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<style type="text/css"><![CDATA[
body {
	font-size: 13px;
}

body>div {
	padding: 8px;
}

.w2trigger {
	height: auto !important;
	white-space: normal !important;
	word-wrap: break-word;
	text-align: left;
	line-height: 1.4em;
	padding: 3px 8px;
}

.w2group {
	margin-bottom: 8px;
}

.w2group:last-child {
	margin-bottom: 0px;
}

.w2textbox {
	margin-bottom: 8px;
}

.example_div_tb_style_wrap { max-width: 600px; }

.example_div_th_style { font-size: 1.2em; font-weight: 700; margin-top: 1em;}
]]></style>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.btn_exam1_onclick = function(e) {
	cht_exam1.setPlotColor(["#ff0000", "#00ff00", "#0000ff", "#00ffff", "ff00ff", "ffff00"]);
	cht_exam2.setPlotColor(["#ff0000", "#00ff00", "#0000ff", "#00ffff", "ff00ff", "ffff00"]);
	cht_exam1.draw();
	cht_exam2.draw();
};
scwin.checkVal1 = function() {
	return document.getElementsByClassName('raphael-group-397-plot-group')[0].children[0].getAttribute('fill') == '#00ff00';
};
scwin.checkVal2 = function() {
	return document.getElementsByClassName('raphael-group-386-plot-group')[0].children[0].getAttribute('fill') == '#ff0000';
};
scwin.checkVal3 = function() {
	return document.getElementsByClassName('raphael-group-434-plot-group')[0].children[2].getAttribute('fill') == '#00ffff';
};
scwin.checkVal4 = function() {
	return document.getElementsByClassName('raphael-group-423-plot-group')[0].children[2].getAttribute('fill') == '#0000ff';
};
]]></script>
	</head>
	<body>
		<xf:group class="sub_contents">
			<xf:group class="ws_example_grp_desc">
				<w2:textbox escape="false"
					label="버튼 'setPlotColor'을 클릭하여 차트에 반영된 plot color를 확인합니다.">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mb_def">
				<xf:group class="example_div_tr_style">
					<xf:group class="example_div_td_style">
						<xf:group class="mb_def_box nobottom">
							<xf:trigger type="button" id="btn_exam1" style="height: 26px;"
								ev:onclick="scwin.btn_exam1_onclick">
								<xf:label><![CDATA[setPlotColor]]></xf:label>
							</xf:trigger>
						</xf:group>
						<xf:group class="mb_def_box nobottom">
							<w2:fusionchart chartType="MSStackedColumn2D" drawType="javascript" id="cht_exam1" labelNode="quarter"
								ref="data:dlt_chartData_1" seriesColumns="[['type1','type3'],['type2','type4']]" style="height: 300px;min-width:200px;"
								version="3.19">
							</w2:fusionchart>
						</xf:group>
						<xf:group class="mb_def_box nobottom">
							<w2:fusionchart chartType="Column2D" drawType="javascript" id="cht_exam2" labelNode="quarter"
								ref="data:dlt_chartData_1" seriesColumns="[['type1']]" style="height: 300px;min-width:200px;" version="3.19">
							</w2:fusionchart>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
