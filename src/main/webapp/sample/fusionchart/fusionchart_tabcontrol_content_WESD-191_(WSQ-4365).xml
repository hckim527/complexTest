		"dmaId": "dmaQaChtStd06",
		"chartId": chartId,
		"chartRefList": "data:dltQaResultChartList06",
		"avgRefList": "dltQaResultList06",
		"numberSuffix": "M"
	};
	scwin.m_showColumnLineChart(chtObj);
};
scwin.m_showColumnLineChart = function(obj) {
	var websqurelineChartId = scwin.__getObj(obj.chartId);
	var chartQaResultOption = {
		"caption": "탈지대두 품질 경향도 차트",
		"showLegend": "0",
		"showValues": "1",
		"showYAxisValues": "1",
		"decimals": "2",
		"yAxisValueDecimals": "2",
		"useRoundEdges": "1",
		"showHoverEffect": "1"
	};
	websqurelineChartId.options.seriesType = "";
	websqurelineChartId.changeType("MSLine");
	websqurelineChartId.setChartAttribute(chartQaResultOption);
	websqurelineChartId.setChartColumnRef(obj.chartRefList, 'yearMonth', "[['qaAvg']]");
};
scwin.checkValue = function() {
	return document.getElementsByTagName('path')[4].getAttribute('d').split(",").length == 7;
};
