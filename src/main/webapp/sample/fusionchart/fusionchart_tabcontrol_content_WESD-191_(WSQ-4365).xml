		<script type="text/javascript" lazy="false"><![CDATA[
// 컴포넌트·전역 이름 조회(엔진 캐시 → 이름 그대로 실행 → mf_ 접두사 붙여 다시, 없으면 받은 id 문자열 반환). 2026-11
scwin.__getObj = function(id) {
	if (typeof id !== 'string') return id;
	var W = WebSquare, C = W.idCache, U = W.idToUUID, F = function(k) { return new Function('return ' + k)(); };
	if (!W.strictMode) id = id.replace(/mf_/g, '');
	if (C[U[id]]) return C[U[id]];
	var r; try { r = F(id); } catch (e) {}
	if (r == undefined && W.strictMode) {
		var P = W.strictModeFrame.id + '_';
		var s = id.slice(0, 2) === 'G_' ? 'G_' + P + id.slice(2) : (id.slice(0, P.length) !== P ? P + id : id);
		s = s.replace(new RegExp('(' + P + '){2,}', 'g'), P);
		if (C[U[s]]) r = C[U[s]]; else { try { r = F(s); } catch (e) { r = id; } }
	}
	return r == undefined ? id : r;
};
// 검색 버튼 클릭 시 1,3,4,5,6번 차트 그리기
scwin.btn_search_onclick = function() {
	var themeStr = radio1.getValue();
	if (themeStr == "") {
		radio1.setValue("candy");
		themeStr = "candy";
	}
	if (themeStr == "candy") {
		imports("externalJS/FusionCharts3.13/js/themes/fusioncharts.theme.candy.js");
	} else if (themeStr == "carbon") {
		imports("externalJS/FusionCharts3.13/js/themes/fusioncharts.theme.carbon.js");
	} else if (themeStr == "fint") {
		imports("externalJS/FusionCharts3.13/js/themes/fusioncharts.theme.fint.js");
	} else if (themeStr == "fusion") {
		imports("externalJS/FusionCharts3.13/js/themes/fusioncharts.theme.fusion.js");
	} else if (themeStr == "gammel") {
		imports("externalJS/FusionCharts3.13/js/themes/fusioncharts.theme.gammel.js");
	} else if (themeStr == "ocean") {
		imports("externalJS/FusionCharts3.13/js/themes/fusioncharts.theme.ocean.js");
	} else if (themeStr == "zune") {
		imports("externalJS/FusionCharts3.13/js/themes/fusioncharts.theme.zune.js");
	}
	scwin.sbm_selectQaChtStd01_submitdone();
	scwin.sbm_selectQaChtStd03_submitdone();
	scwin.sbm_selectQaChtStd04_submitdone();
	scwin.sbm_selectQaChtStd05_submitdone();
	scwin.sbm_selectQaChtStd06_submitdone();
};
scwin.sbm_selectQaChtStd01_submitdone = function(e) {
	var chartId = dmaQaChtStd01.get("chartId");
	var chtObj = {
		"dmaId": "dmaQaChtStd01",
		"chartId": chartId,
		"chartRefList": "data:dltQaResultChartList01",
		"avgRefList": "dltQaResultList01"
	};
	scwin.m_showColumnLineChart(chtObj);
};
scwin.sbm_selectQaChtStd03_submitdone = function(e) {
	var chartId = dmaQaChtStd03.get("chartId");
	var chtObj = {
		"dmaId": "dmaQaChtStd03",
		"chartId": chartId,
		"chartRefList": "data:dltQaResultChartList03",
		"avgRefList": "dltQaResultList03"
	};
	scwin.m_showColumnLineChart(chtObj);
};
scwin.sbm_selectQaChtStd04_submitdone = function(e) {
	var chartId = dmaQaChtStd04.get("chartId");
