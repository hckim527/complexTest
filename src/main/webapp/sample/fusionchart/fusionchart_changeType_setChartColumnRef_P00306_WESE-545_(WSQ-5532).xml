<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="dlt_chartData_1" repeatNode="data" valueAttribute="">
					<w2:columnInfo>
						<w2:column dataType="text" id="quarter" name="quarter"></w2:column>
						<w2:column dataType="text" id="type1" name="type1"></w2:column>
						<w2:column dataType="text" id="type2" name="type2"></w2:column>
						<w2:column dataType="text" id="type3" name="type3"></w2:column>
						<w2:column dataType="text" id="type4" name="type3"></w2:column>
					</w2:columnInfo>
					<w2:data use="true" xmlns="">
						<w2:row>
							<quarter><![CDATA[Q1]]></quarter>
							<type1><![CDATA[11500]]></type1>
							<type2><![CDATA[28110]]></type2>
							<type3><![CDATA[23990]]></type3>
							<type4><![CDATA[14400]]></type4>
						</w2:row>
						<w2:row>
							<quarter><![CDATA[Q2]]></quarter>
							<type1><![CDATA[1500]]></type1>
							<type2><![CDATA[10600]]></type2>
							<type3><![CDATA[10000]]></type3>
							<type4><![CDATA[5200]]></type4>
						</w2:row>
						<w2:row>
							<quarter><![CDATA[Q3]]></quarter>
							<type1><![CDATA[27400]]></type1>
							<type2><![CDATA[31800]]></type2>
							<type3><![CDATA[42800]]></type3>
							<type4><![CDATA[15300]]></type4>
						</w2:row>
						<w2:row>
							<quarter><![CDATA[Q4]]></quarter>
							<type1><![CDATA[27400]]></type1>
							<type2><![CDATA[22900]]></type2>
							<type3><![CDATA[20800]]></type3>
							<type4><![CDATA[15200]]></type4>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_chartType" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="chart_name" name="chart_name" dataType="text"></w2:column>
						<w2:column id="chart_value" name="chart_value" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<chart_name><![CDATA[Stacked Column 2D]]></chart_name>
							<chart_value><![CDATA[stackedcolumn2d]]></chart_value>
						</w2:row>
						<w2:row>
							<chart_name><![CDATA[Stacked Bar 2D]]></chart_name>
							<chart_value><![CDATA[stackedbar2d]]></chart_value>
						</w2:row>
						<w2:row>
							<chart_name><![CDATA[Multi-series Stacked Column 2D]]></chart_name>
							<chart_value><![CDATA[msstackedcolumn2d]]></chart_value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<style type="text/css"><![CDATA[
body {
	font-size: 13px;
}

body>div {
	padding: 8px;
}

.w2trigger {
	height: auto !important;
	white-space: normal !important;
	word-wrap: break-word;
	text-align: left;
	line-height: 1.4em;
	padding: 3px 8px;
}

.w2group {
	margin-bottom: 8px;
}

.w2group:last-child {
	margin-bottom: 0px;
}

.w2textbox {
	margin-bottom: 8px;
}

.example_div_tb_style_wrap { max-width: 600px; }

.example_div_th_style { font-size: 1.2em; font-weight: 700; margin-top: 1em;}
]]></style>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function () {
	cht_exam1.setChartAttribute({
		"caption": rad_chartType1.getText(),
		"canvasTopPadding": 6,
		"canvasRightMargin": 10,
		"canvasLeftPadding": 6,
		"canvasRightPadding": 6,
		"chartBottomMargin": 16
	});
	let arrPlotColor = ["#2ec6c8", "#FFD700", "#5ab0ee", "#f4984e", "#d77a80", "#90bddc", "#fe5d55", "#b5dc59", "#9ea7b3", "#00ba84", "#878bb6", "#757a85"];
	cht_exam1.setPlotColor(arrPlotColor);
	cht_exam1.draw();
};
scwin.rad_chartType1_onviewchange = function (info) {
	let chartAlias = info.value;
	cht_exam1.setChartAttribute({
		"caption": this.getText()
	});
	switch (chartAlias) {
		case "stackedcolumn2d":
		case "stackedcolumn3d":
		case "stackedbar2d":
		case "stackedbar3d":
		case "stackedarea2d":
			cht_exam1.changeType(chartAlias, {ref: "data:dlt_chartData_1", labelNode: "quarter", seriesColumns: "[['type1','type2','type3']]"});
			break;
		case "msstackedbar2d":
		case "msstackedcolumn2d":
			cht_exam1.changeType(chartAlias, {ref: "data:dlt_chartData_1", labelNode: "quarter", seriesColumns: "[['type1','type3'],['type2','type4']]"});
			break;
		default:
			break;
	}
};
scwin.checkVal = function() {
	return (document.getElementById('cht_exam1') || document.getElementById('mf_cht_exam1')).innerText != 'No data to display.';
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="sub_contents">
			<xf:group class="ws_example_grp_desc">
				<w2:textbox escape="false"
					label="Radio에서 'Multi-series Stacked Column 2D'를 선택합니다. 콘솔에 출력된 Chart의 jsonData의 dataset을 확인합니다.&lt;br/&gt;함수 'setChartColumnRef'로 지정한 'seriesColumns'의 0번째 배열만 반영됩니다.&lt;br/&gt;&lt;br/&gt;속성 'seriesColumns'를 하드코딩한 경우는 정상적으로 출력됩니다.">
				</w2:textbox>
			</xf:group>
			<xf:group class="example_div_tb_style_wrap mb_def">
				<xf:group class="example_div_tr_style">
					<w2:textbox class="example_div_th_style" escape="false" label="Stacked Charts"></w2:textbox>
					<xf:group class="example_div_td_style">
						<xf:group class="mb_def_box nobottom">
							<xf:select1 id="rad_chartType1" selectedIndex="0" appearance="full" style="min-height: 26px;" rows="" ref=""
								ev:onviewchange="scwin.rad_chartType1_onviewchange" renderType="radiogroup" class="w_per_100" cols="">
								<xf:choices>
									<xf:itemset nodeset="data:dlt_chartType">
										<xf:label ref="chart_name"></xf:label>
										<xf:value ref="chart_value"></xf:value>
									</xf:itemset>
								</xf:choices>
							</xf:select1>
						</xf:group>
						<xf:group class="mb_def_box nobottom">
							<w2:fusionchart chartType="StackedColumn2D" drawType="javascript" id="cht_exam1" labelNode="quarter"
								ref="data:dlt_chartData_1" seriesColumns="[['type1','type2','type3']]" style="height: 300px;min-width:200px;" version="3.19">
							</w2:fusionchart>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
