<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:config>
			<WebSquare>
				<clearMemory value="true" />
			</WebSquare>
		</w2:config>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	window.showAlert = false;
};
scwin.trigger1_onclick = function(e) {
	showAlert = true;
};
scwin.__buttonNotDisappeared = function() {
	var button = ((j) => j.length ? j : $('#mf_trigger1'))($('#trigger1'));
	if (!button.length) {
		return false;
	}
	return button.get(0).nodeName == "A";
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="anchor" id="trigger1" style="position: relative;width: 80px;height: 23px;left:120px;top:83px;" href="#" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[테스트]]></xf:label>
		</xf:trigger>
	</body>
</html>
