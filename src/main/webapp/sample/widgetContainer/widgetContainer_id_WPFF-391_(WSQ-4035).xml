<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	count++;
	widgetContainer1.addWidgets({
		id: "widget_" + count,
		title: "위젯" + count,
		src: "/sample/common_link/widgetContainer_common_widget.xml",
		scope: true,
		x: 0,
		y: 0,
		unitWidth: 1,
		unitHeight: 1
	});
};

scwin.trigger4_onclick = function(e) {
	var x = widgetContainer1.exportWidgets();
	localStorage.setItem("log", x[0].id);
};

scwin.onpageload = function() {
	window.count = 0;
	localStorage.removeItem("log");
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="position: absolute;width:637px;height:449px;float:left;">
			<xf:group style="position: relative;height:40px;">
				<xf:trigger type="button" id="trigger1" style="position: relative;height:25px;width:150px;float: left;" ev:onclick="scwin.trigger1_onclick">
					<xf:label><![CDATA[addWidget]]></xf:label>
				</xf:trigger>
				<xf:trigger type="button" id="trigger4" style="width:202px;height:25px;position: relative;float:left;" ev:onclick="scwin.trigger4_onclick">
					<xf:label><![CDATA[widgetContainer1.exportWidgets()]]></xf:label>
				</xf:trigger>
			</xf:group>
			<w2:widgetContainer id="widgetContainer1" cols="3" style="position: relative ;width:100%;height:100%;border:1px solid black;"
				unitHeightPixel="200" mode="pushpull" widgetMove="true">
			</w2:widgetContainer>
		</xf:group>
	</body>
</html>
