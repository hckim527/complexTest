<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:config>
			<WebSquare>
				<engine>
					<module src="externalJS/big/big.min.js"/>
				</engine>
			</WebSquare>
		</w2:config>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dma_OfficeInfo">
					<w2:keyInfo>
						<w2:key id="officeCd" name="사업소코드" dataType="text"></w2:key>
						<w2:key id="officeNm" name="사업소명" dataType="text"></w2:key>
						<w2:key id="cntrKndCd" name="계약코드" dataType="text"></w2:key>
						<w2:key id="cntrKndNm" name="계약명" dataType="text"></w2:key>
						<w2:key id="cntrAmt" name="계약금액" dataType="number"></w2:key>
						<w2:key id="cntrPwr" name="계약전력" dataType="bigDecimal" keepEmptyString="true"></w2:key>
						<w2:key id="addr" name="주소" dataType="text"></w2:key>
						<w2:key id="tel" name="전화번호" dataType="text"></w2:key>
						<w2:key id="closeYmd" name="납기일" dataType="text"></w2:key>
					</w2:keyInfo>
					<w2:data use="true">
						<officeCd><![CDATA[4721]]></officeCd>
						<officeNm><![CDATA[서대전지사]]></officeNm>
						<cntrKndCd><![CDATA[100]]></cntrKndCd>
						<cntrKndNm><![CDATA[주택용전력]]></cntrKndNm>
						<cntrAmt><![CDATA[1230000]]></cntrAmt>
						<cntrPwr><![CDATA[30000.00]]></cntrPwr>
						<addr><![CDATA[[52312] 대구 광역시 동구 서래동 23 서래로 12]]></addr>
						<tel><![CDATA[0242347343]]></tel>
						<closeYmd><![CDATA[25]]></closeYmd>
					</w2:data>
				</w2:dataMap>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};
scwin.btn_trigger1_onclick = function(e) {
	dma_OfficeInfo.set("cntrAmt", "");
	dma_OfficeInfo.set("cntrPwr", "");
};
scwin.__setValue = function(id, value) {
	var input = scwin.__getDom($p.id + id);
	input.value = value;
};
scwin.__getVal = function(id) {
	var input = scwin.__getDom($p.id + id);
	return input.value;
};
]]></script>
	</head>
	<body>
		<xf:group id="">
			<xf:group id="">
			</xf:group>
			<xf:group id="">
				<w2:textbox id="" label="DataMap Sample"></w2:textbox>
			</xf:group>
			<xf:group adaptive="" adaptiveThreshold="" id="grp_group" style="width:716.00px;" tagname="table">
