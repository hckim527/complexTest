<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row></w2:row>
						<w2:row></w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dsCombo">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[0]]></label>
							<value><![CDATA[0]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[1]]></label>
							<value><![CDATA[1]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[2]]></label>
							<value><![CDATA[2]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[3]]></label>
							<value><![CDATA[3]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[4]]></label>
							<value><![CDATA[4]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[5]]></label>
							<value><![CDATA[5]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
	</head>
	<body>
		<w2:autoComplete id="auto01" style="width:200px; height:20px; margin:20px;" submenuSize="auto" search="start" editModeEvent="onfocus" listModeOnFocus="hide" disableEdit="true" hideListOnLabelClickWhenDisableEdit="true">
			<w2:choices>
				<w2:itemset nodeset="data:dsCombo">
					<w2:label ref="label"></w2:label>
					<w2:value ref="value"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:autoComplete>
		<w2:gridView checkAllType="false" style="width:500px; height:150px; margin:20px;" dataList="data:dataList1">
			<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
			<w2:header id="header2">
				<w2:row id="row3">
					<w2:column width="165" inputType="text" id="column4" value="name1"></w2:column>
					<w2:column width="70" inputType="text" id="column3" value="name2"></w2:column>
				</w2:row>
			</w2:header>
			<w2:gBody id="gBody2">
				<w2:row id="row4">
					<w2:column listModeOnFocus="hide" disableEdit="true" width="165" inputType="autoComplete" id="col1" hideListOnLabelClickWhenDisableEdit="true">
						<w2:choices>
							<w2:itemset nodeset="data:dsCombo">
								<w2:label ref="label"></w2:label>
								<w2:value ref="value"></w2:value>
							</w2:itemset>
						</w2:choices>
					</w2:column>
					<w2:column width="70" inputType="text" id="col2"></w2:column>
				</w2:row>
			</w2:gBody>
		</w2:gridView>
	</body>
</html>
