<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataMap baseNode="map" id="dataMap1">
					<w2:keyInfo>
						<w2:key id="key1" name="name1" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	autoComplete1.setValue("t2");
	dataMap1.set("key1", "t3");
	document.getElementById("mf_autoComplete1_arrow").click();
	document.getElementById("mf_autoComplete2_arrow").click();
};
scwin.checkVal1 = function() {
	return (document.getElementById('autoComplete1_itemTable_option2') || document.getElementById('mf_autoComplete1_itemTable_option2')).getAttribute('aria-selected') == 'true';
};
scwin.checkVal2 = function() {
	return (document.getElementById('autoComplete2_itemTable_option3') || document.getElementById('mf_autoComplete2_itemTable_option3')).getAttribute('aria-selected') == 'true';
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:autoComplete editType="select" id="autoComplete1" style="position: relative;width: 148px;height: 21px;" submenuSize="auto"
			accessibility="true" removeLabelFor="true">
			<w2:choices>
				<w2:item>
					<w2:label><![CDATA[test1]]></w2:label>
					<w2:value><![CDATA[t1]]></w2:value>
				</w2:item>
				<w2:item>
					<w2:label><![CDATA[test2]]></w2:label>
					<w2:value><![CDATA[t2]]></w2:value>
				</w2:item>
				<w2:item>
					<w2:label><![CDATA[test3]]></w2:label>
					<w2:value><![CDATA[t3]]></w2:value>
				</w2:item>
			</w2:choices>
		</w2:autoComplete>
		<w2:autoComplete accessibility="true" editType="select" id="autoComplete2" ref="data:dataMap1.key1" removeLabelFor="true"
			style="position: relative;width: 148px;height: 21px;" submenuSize="auto">
			<w2:choices>
				<w2:item>
					<w2:label><![CDATA[test1]]></w2:label>
					<w2:value><![CDATA[t1]]></w2:value>
				</w2:item>
				<w2:item>
					<w2:label><![CDATA[test2]]></w2:label>
					<w2:value><![CDATA[t2]]></w2:value>
				</w2:item>
				<w2:item>
					<w2:label><![CDATA[test3]]></w2:label>
					<w2:value><![CDATA[t3]]></w2:value>
				</w2:item>
			</w2:choices>
		</w2:autoComplete>
	</body>
</html>
