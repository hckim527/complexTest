		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dsCombo">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[0]]></label>
							<value><![CDATA[0]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[1]]></label>
							<value><![CDATA[1]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[2]]></label>
							<value><![CDATA[2]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[3]]></label>
							<value><![CDATA[3]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[4]]></label>
							<value><![CDATA[4]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[5]]></label>
							<value><![CDATA[5]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
	</head>
	<body>
		<w2:autoComplete id="auto01" style="width: 148px;height: 21px;" submenuSize="auto" search="start" listModeOnFocus="showAll" editModeEvent="onfocus">
			<w2:choices>
				<w2:itemset nodeset="data:dsCombo">
					<w2:label ref="label"></w2:label>
					<w2:value ref="value"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:autoComplete>
	</body>
</html>
