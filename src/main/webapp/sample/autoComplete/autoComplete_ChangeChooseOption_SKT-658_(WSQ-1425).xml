<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList2" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList3" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="dataList4" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	autoComplete1.changeChooseOption("0", "선택_test1");
};
scwin.trigger2_onclick = function(e) {
	autoComplete2.changeChooseOption("0", "선택_test2");
};
scwin.trigger3_onclick = function(e) {
	selectbox1.changeChooseOption("0", "선택_test3");
};
scwin.trigger4_onclick = function(e) {
	selectbox2.changeChooseOption("0", "선택_test4");
};
scwin.onpageload = function() {
	window.data = [];
	for (var i = 0; i < 10; i++) {
		data.push(String(i + 1));
		data.push(String(i + 1));
	}
	dataList1.setData(data);
	dataList2.setData(data);
	dataList3.setData(data);
	dataList4.setData(data);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" style="height:23px;width:700px;">
			<w2:autoComplete visibleRowNum="5" chooseOption="true" displayMode="label" id="autoComplete1" useKeywordHighlight="false"
				style="position: relative;width: 148px;height: 21px;" search="start" submenuSize="auto" renderType="native" editType="select">
				<w2:choices>
					<w2:itemset nodeset="data:dataList1">
						<w2:label ref="col1"></w2:label>
						<w2:value ref="col2"></w2:value>
					</w2:itemset>
				</w2:choices>
			</w2:autoComplete>
			<w2:autoComplete id="autoComplete2" useKeywordHighlight="false" style="position: relative;width: 148px;height: 21px;" search="start"
				visibleRowNum="5" displayMode="label" editType="select" renderType="native" submenuSize="auto">
				<w2:choices>
					<w2:itemset nodeset="data:dataList2">
						<w2:label ref="col1"></w2:label>
						<w2:value ref="col2"></w2:value>
					</w2:itemset>
				</w2:choices>
			</w2:autoComplete>
			<xf:select1 id="selectbox1" disabledClass="w2selectbox_disabled" appearance="minimal" style="position: relative;width: 148px;height: 21px;"
				direction="auto" chooseOption="true" selectedData="false" displayMode="label" optionOrder="false" renderType="native" submenuSize="auto">
				<xf:choices>
					<xf:itemset nodeset="data:dataList3">
						<xf:label ref="col1"></xf:label>
						<xf:value ref="col2"></xf:value>
					</xf:itemset>
				</xf:choices>
			</xf:select1>
			<xf:select1 id="selectbox2" disabledClass="w2selectbox_disabled" appearance="minimal" style="position: relative;width: 148px;height: 21px;"
				direction="auto" selectedData="false" displayMode="label" optionOrder="false" renderType="native" submenuSize="auto">
				<xf:choices>
					<xf:itemset nodeset="data:dataList4">
						<xf:label ref="col1"></xf:label>
						<xf:value ref="col2"></xf:value>
					</xf:itemset>
				</xf:choices>
			</xf:select1>
		</xf:group>
		<xf:group id="" style="position: relative;width: 420px;height: 400px;">
			<xf:trigger type="button" id="trigger1" style="position: relative;width:400px;height:47px;" ev:onclick="scwin.trigger1_onclick">
				<xf:label><![CDATA[autoComplete1.changeChooseOption("0", "선택_test1");]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger2" style="position: relative;width:400px;height:47px;" ev:onclick="scwin.trigger2_onclick">
				<xf:label><![CDATA[autoComplete2.changeChooseOption("0", "선택_test2");]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger3" style="position: relative;width:400px;height:47px;" ev:onclick="scwin.trigger3_onclick">
				<xf:label><![CDATA[selectbox1.changeChooseOption("0", "선택_test3");]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger4" style="position: relative;width:400px;height:47px;" ev:onclick="scwin.trigger4_onclick">
				<xf:label><![CDATA[selectbox2.changeChooseOption("0", "선택_test4");]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
