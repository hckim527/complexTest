<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="comboA" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="code" name="code" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList id="comboB" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="code" name="code" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
						<w2:column id="filter" name="filter" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:linkedDataList id="linkedDataList2" bind="comboB">
					<w2:condition type="filter"><![CDATA[filter == val("sel3")]]></w2:condition>
					<w2:condition type="sort"><![CDATA[]]></w2:condition>
				</w2:linkedDataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.init = function() {
	var select1 = [{
		"code": "1",
		"value": "korea"
	}, {
		"code": "2",
		"value": "japan"
	}];
	var select2 = [{
		"code": "3",
		"value": "seoul",
		"filter": "1"
	}, {
		"code": "4",
		"value": "pusan",
		"filter": "1"
	}, {
		"code": "5",
		"value": "tokyo",
		"filter": "2"
	}, {
		"code": "6",
		"value": "kyoto",
		"filter": "2"
	}];
	comboA.setJSON(select1);
	comboB.setJSON(select2);
};
scwin.trigger1_onclick = function(e) {
	sel3.setValue("2");
	sel4.setValue("6");
};
scwin.onpageload2 = function() {
	scwin.init();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload2">
		<xf:group id="" style="height:23px;">
			<xf:trigger id="trigger1" style="position: relative;width: 80px;height: 25px;" ev:onclick="scwin.trigger1_onclick" type="button">
				<xf:label><![CDATA[search]]></xf:label>
			</xf:trigger>
		</xf:group>
		<w2:autoComplete visibleRowNum="5" chooseOption="true" id="sel3" submenuSize="auto" style="position: relative;width: 148px;height: 21px;" search="start"
			editType="select" chooseOptionLabel="- 선택 - ">
			<w2:choices>
				<w2:itemset nodeset="data:comboA">
					<w2:label ref="value"></w2:label>
					<w2:value ref="code"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:autoComplete>
		<w2:autoComplete visibleRowNum="5" chooseOption="true" id="sel4" submenuSize="auto" style="position: relative;width: 148px;height: 21px;" search="start"
			editType="select" chooseOptionLabel="- 선택 - ">
			<w2:choices>
				<w2:itemset nodeset="data:linkedDataList2">
					<w2:label ref="value"></w2:label>
					<w2:value ref="code"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:autoComplete>
	</body>
</html>
