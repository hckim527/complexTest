<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{
		"col1": "a1",
		"col2": "a1"
	}, {
		"col1": "a2",
		"col2": "a2"
	}, {
		"col1": "a3",
		"col2": "a3"
	}, {
		"col1": "a4",
		"col2": "a4"
	}, {
		"col1": "a5",
		"col2": "a5"
	}, {
		"col1": "a6",
		"col2": "a6"
	}];
	dataList1.setJSON(jsonData);
};
scwin.autoComplete1_onviewchange = function(info) {
	WebSquare.logger.printLog("autoComplete gridViewItemset onviewchange");
};
scwin.sel1_onviewchange = function(info) {
	WebSquare.logger.printLog("select gridViewItemset onviewchange");
};
scwin.checkLog = function(text) {
	var log = WebSquare.logger.getLog();
	return log.indexOf(text) > -1;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:autoComplete chooseOption="false" editType="select" id="autoComplete1" submenuSize="auto" search="start"
			style="position: absolute ;left: 76px;top: 131px;width: 162px;height: 38px;" visibleRowNum="5" ev:onviewchange="scwin.autoComplete1_onviewchange">
			<w2:choices>
				<w2:gridViewItemset autoFit="true" label="col1" nodeset="data:dataList1" wheelStop="true" value="col2">
					<w2:item header="2" ref="col1"></w2:item>
				</w2:gridViewItemset>
			</w2:choices>
		</w2:autoComplete>
		<xf:select1 disabledClass="w2selectbox_disabled" appearance="minimal" chooseOption="false" optionOrder="false" allOption="false"
			direction="auto" id="sel1" style="position: absolute ;left:320px;top:132px;width: 162px;height: 38px;" renderType="component"
			ev:onviewchange="scwin.sel1_onviewchange">
			<xf:choices>
				<w2:gridViewItemset wheelStop="true" nodeset="data:dataList1" value="col2" label="col1">
					<w2:item ref="col1" style="width:100%" header="2"></w2:item>
					<w2:item ref="col2" style="width:100%;" header="3"></w2:item>
				</w2:gridViewItemset>
			</xf:choices>
		</xf:select1>
	</body>
</html>
