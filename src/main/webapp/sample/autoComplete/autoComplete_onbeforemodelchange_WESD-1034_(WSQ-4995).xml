<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns=""></data>
			</xf:instance>
			<w2:dataCollection>
				<w2:dataMap baseNode="map" id="dataMap1" ev:onmodelchange="scwin.dataMap1_onmodelchange"
					ev:onbeforemodelchange="scwin.dataMap1_onbeforemodelchange">
					<w2:keyInfo>
						<w2:key id="CODE_AC" name="name1" dataType="text"></w2:key>
						<w2:key id="CNT" name="name2" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
		</xf:model>
		<script type="javascript"><![CDATA[
scwin.fireEvent = false;
scwin.dataMap1_onmodelchange = function(info) {
	var key = info.key;
	if (scwin.fireEvent) return;
	scwin.fireEvent = true;
	var cnt = dataMap1.get("CNT");
	if (key == "CODE_AC") {
		if (cnt == 1) {
			dataMap1.set("CODE_AC", "2");
		}
	}
	scwin.fireEvent = false;
};
scwin.dataMap1_onbeforemodelchange = function(info) {
	if (info.newValue == "1") {
		return false;
	} else {
		return true;
	}
};
scwin.checkVal = function() {
	return (document.getElementById('asb_label') || document.getElementById('mf_asb_label')).innerText == '전체';
};
]]></script>
	</head>
	<body>
		<w2:autoComplete caseSensitive="" chooseOption="true" chooseOptionLabel="전체" displayMode="" editType="select" id="asb"
			noResult="clear" ref="data:dataMap1.CODE_AC" search="contain" searchTarget="" style="width: 300px;height: 50px;" submenuSize="auto"
			useKeywordHighlight="true">
			<w2:choices>
				<w2:item>
					<w2:label><![CDATA[가]]></w2:label>
					<w2:value><![CDATA[1]]></w2:value>
				</w2:item>
				<w2:item>
					<w2:label><![CDATA[나]]></w2:label>
					<w2:value><![CDATA[2]]></w2:value>
				</w2:item>
				<w2:item>
					<w2:label><![CDATA[다]]></w2:label>
					<w2:value><![CDATA[3]]></w2:value>
				</w2:item>
			</w2:choices>
		</w2:autoComplete>
	</body>
</html>
