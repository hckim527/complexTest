<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" id="autoItemSet" repeatNode="map" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column dataType="text" id="code" name="name1"></w2:column>
						<w2:column dataType="text" id="name" name="name2"></w2:column>
						<w2:column dataType="text" id="etc" name="etc"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	var arr = ["test1","t1","","test2","t2","","test3-f가나다라마바사가나다라마바사","t3","false","aaa1","a1","","aaa2","a2","","bbb1","b1","","bbb2","b2",""];
	autoItemSet.setData(arr);
};
scwin.isWithinPercent = function(a, b, c) {
	const percentage = c; // 백분율 설정
	const lowerBound = b - (b * (percentage / 100)); // 하한 계산
	const upperBound = b + (b * (percentage / 100)); // 상한 계산
	return a >= lowerBound && a <= upperBound;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="" class="sub_contents">
			<xf:group id="" tagname="section">
				<w2:textbox id="" label="입력 서식 레이블" tagname="label" for="mf_acb_samp_input"></w2:textbox>
				<w2:autoComplete editType="select" id="acb_samp" renderType="component" style="width: 158px;height: 32px;" submenuSize="auto"
					accessibility="true" direction="auto" caseSensitive="false" interactionMode="true" noResult="noEnd">
					<w2:choices>
						<w2:itemset nodeset="data:autoItemSet">
							<w2:label ref="code"></w2:label>
							<w2:value ref="name"></w2:value>
						</w2:itemset>
					</w2:choices>
				</w2:autoComplete>
			</xf:group>
		</xf:group>
	</body>
</html>
