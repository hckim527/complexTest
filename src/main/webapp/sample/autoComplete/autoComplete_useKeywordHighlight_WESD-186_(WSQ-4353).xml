<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="gdlt_jisaMenuList" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="DEPTH" name="name1" dataType="text"></w2:column>
						<w2:column id="MENU_NAVI" name="name2" dataType="text"></w2:column>
						<w2:column id="SYSTEM_ID" name="name2" dataType="text"></w2:column>
						<w2:column id="MENU_ID" name="name2" dataType="text"></w2:column>
						<w2:column id="MENU_SNO" name="name2" dataType="text"></w2:column>
						<w2:column id="MENU_NM" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var jsonData = [{
		"DEPTH": 1,
		"MENU_NAVI": "HOME > 공통",
		"SYSTEM_ID": "1",
		"MENU_ID": "CO",
		"MENU_NM": "공통"
	}, {
		"DEPTH": 2,
		"MENU_NAVI": "HOME > 공통 > 민원",
		"SYSTEM_ID": "1",
		"MENU_ID": "COMC",
		"MENU_NM": "민원"
	}];
	gdlt_jisaMenuList.setJSON(jsonData);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:autoComplete editType="select" escape="true" id="" submenuSize="auto" useKeywordHighlight="true" style="width : 200px;height:25px" search="contain" chooseOption="true"
			chooseOptionLabel="$blank" caseSensitive="false">
			<w2:choices>
				<w2:itemset nodeset="data:gdlt_jisaMenuList">
					<w2:label ref="MENU_NM"></w2:label>
					<w2:value ref="MENU_ID"></w2:value>
				</w2:itemset>
			</w2:choices>
		</w2:autoComplete>
	</body>
</html>
