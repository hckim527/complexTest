<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance></xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	dataList1.setData([1, 'a', 2, 'b', 3, 'c', 4, 'd', 5, 'e']);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group tagname="table" style="width:100%;" id="" class="w2tb">
			<w2:attributes>
				<w2:summary></w2:summary>
			</w2:attributes>
			<xf:group tagname="caption"></xf:group>
			<xf:group tagname="colgroup">
				<xf:group tagname="col" style="width:13.00%;"></xf:group>
				<xf:group tagname="col" style="width:29.00%;"></xf:group>
				<xf:group tagname="col" style="width:29.00%;"></xf:group>
				<xf:group tagname="col" style="width:29.00%;"></xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group tagname="th" class="w2tb_th">
					<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes>
				</xf:group>
				<xf:group tagname="td" style="text-align: center" class="w2tb_td">localRef=&quot;test&quot;</xf:group>
				<xf:group tagname="td" style="text-align: center" class="w2tb_td">localRef=&quot;test&quot;comp&amp;nbsp;useLocale&amp;nbsp;false</xf:group>
				<xf:group tagname="td" class="w2tb_td">
				</xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group tagname="th" class="w2tb_th">trigger<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes></xf:group>
				<xf:group tagname="td" class="w2tb_td">
					<xf:trigger type="button" localeRef="test" style="width:110px;height: 23px;" id="trigger3">
						<xf:label><![CDATA[trigger label]]></xf:label>
					</xf:trigger>
				</xf:group>
				<xf:group tagname="td" class="w2tb_td">
					<xf:trigger type="button" useLocale="false" localeRef="test" style="width:110px;height: 23px;" id="trigger4">
						<xf:label><![CDATA[trigger label]]></xf:label>
					</xf:trigger>
				</xf:group>
				<xf:group tagname="td" class="w2tb_td">useLocale,<br></br>localeRef</xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group tagname="th" class="w2tb_th">fliptoggle<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes></xf:group>
				<xf:group tagname="td" class="w2tb_td">
					<w2:fliptoggle id="fliptoggle3" style="position:absolute;width:180px;height:15px;">
						<w2:on value="On" label="On" localeRef="test"></w2:on>
						<w2:off value="Off" label="Off" localeRef="test"></w2:off>
					</w2:fliptoggle>
				</xf:group>
				<xf:group tagname="td" class="w2tb_td">
					<w2:fliptoggle id="fliptoggle4" style="position:absolute;width:180px;height:15px;" useLocale="false">
						<w2:on value="On" label="On" localeRef="test11"></w2:on>
						<w2:off value="Off" label="Off" localeRef="test11"></w2:off>
					</w2:fliptoggle>
				</xf:group>
				<xf:group tagname="td" class="w2tb_td">useLocale,<br></br>localeRef</xf:group>
			</xf:group>
			<xf:group tagname="tr">
				<xf:group tagname="th" class="w2tb_th">gridView
					<w2:attributes>
						<w2:scope>row</w2:scope>
					</w2:attributes>
				</xf:group>
				<xf:group tagname="td" class="w2tb_td">
					<w2:gridView id="gridview3" style="width: 220px;height: 200px;"
						defaultCellHeight="" contextMenu="true" dataList="data:dataList1"
						rowStatusVisible="true" rowStatusHeaderValue="상태" rowStatusLocaleRef="test" useLocale=""
						rowNumVisible="true" rowNumHeaderValue="번호" rowNumLocaleRef="test"
						dataDragDropSelf="true">
						<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
						<w2:header id="header2">
							<w2:row id="row3">
								<w2:column width="70" inputType="text" style="height:20px" id="column15" value="name1"
									blockSelect="false" displayMode="label" localeRef="test">
								</w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="column14" value="name2"
									blockSelect="false" displayMode="label">
								</w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="gBody2">
							<w2:row id="row4">
								<w2:column width="70" inputType="text" style="height:20px" id="col1" value=""
									blockSelect="false" displayMode="label" embeddedInput="">
								</w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="col2" value=""
									blockSelect="false" displayMode="label">
								</w2:column>
							</w2:row>
						</w2:gBody>
						<w2:subTotal id="subTotal1" targetColumnID="col2">
							<w2:row id="row3">
								<w2:column blockSelect="false" id="column112" style="height:20px" width="70" inputType="text" displayMode="label" value="합계" localeRef="test"></w2:column>
								<w2:column blockSelect="false" id="column110" style="height:20px" width="70" inputType="expression"
									displayMode="label" expression="sum('col1')">
								</w2:column>
							</w2:row>
						</w2:subTotal>
						<w2:footer id="footer1">
							<w2:row id="row5">
								<w2:column blockSelect="false" id="column40" width="70" inputType="text" displayMode="label" value="총합계" localeRef="test"></w2:column>
								<w2:column blockSelect="false" id="column38" width="70" inputType="text" displayMode="label" value="footer1"></w2:column>
							</w2:row>
						</w2:footer>
					</w2:gridView>
				</xf:group>
				<xf:group tagname="td" class="w2tb_td">
					<w2:gridView id="gridview4" style="width: 220px;height: 200px;"
						defaultCellHeight="" contextMenu="true" dataList="data:dataList1"
						rowStatusVisible="true" rowStatusHeaderValue="상태" rowStatusLocaleRef="" useLocale="false"
						rowNumVisible="true" rowNumHeaderValue="번호" rowNumLocaleRef=""
						dataDragDropSelf="true">
						<w2:caption id="caption2" value="this is a grid caption."></w2:caption>
						<w2:header id="header2">
							<w2:row id="row3">
								<w2:column width="70" inputType="text" style="height:20px" id="column15" value="name1"
									blockSelect="false" displayMode="label" localeRef="test">
								</w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="column14" value="name2"
									blockSelect="false" displayMode="label">
								</w2:column>
							</w2:row>
						</w2:header>
						<w2:gBody id="gBody2">
							<w2:row id="row4">
								<w2:column width="70" inputType="text" style="height:20px" id="col1" value=""
									blockSelect="false" displayMode="label" embeddedInput="">
								</w2:column>
								<w2:column width="70" inputType="text" style="height:20px" id="col2" value=""
									blockSelect="false" displayMode="label">
								</w2:column>
							</w2:row>
						</w2:gBody>
						<w2:subTotal id="subTotal1" targetColumnID="col2">
							<w2:row id="row3">
								<w2:column blockSelect="false" id="column112" style="height:20px" width="70" inputType="text" displayMode="label" value="합계" localeRef="test"></w2:column>
								<w2:column blockSelect="false" id="column110" style="height:20px" width="70" inputType="expression"
									displayMode="label" expression="sum('col1')">
								</w2:column>
							</w2:row>
						</w2:subTotal>
						<w2:footer id="footer1">
							<w2:row id="row5">
								<w2:column blockSelect="false" id="column40" width="70" inputType="text" displayMode="label" value="총합계" localeRef="test"></w2:column>
								<w2:column blockSelect="false" id="column38" width="70" inputType="text" displayMode="label" value="footer1"></w2:column>
							</w2:row>
						</w2:footer>
					</w2:gridView>
				</xf:group>
				<xf:group tagname="td" class="w2tb_td">useLocale,<br></br>rowNumLocaleRef,<br></br>rowStatusLocaleRef,<br></br>localeRef&amp;nbsp;(header,&amp;nbsp;subtotal,&amp;nbsp;footer)</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
