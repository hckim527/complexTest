<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance></xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// DOM 조회 순서(받은 id → mf_ 접두사 → G_ 뒤 접두사 → 접두사 제거). 2026-11
scwin.__getDom = function(id) {
	var P = 'mf_', d = function(k) { return document.getElementById(k); }, dd = function(k) { return k.replace(/(mf_){2,}/g, P); };
	var r = d(id); if (r) return r;
	var s = dd(P + id); r = d(s); if (r) return r;
	var g = s.indexOf('G_');
	if (g >= 0) { s = dd(s.slice(0, g + 2) + P + s.slice(g + 2)); r = d(s); if (r) return r; s = dd(P + s); r = d(s); if (r) return r; }
	return d(s.replace(P, ''));
};

scwin.onpageload = function() {
	dataList1.setData([1, 1, 2, 2, 3, 3, 4, 4]);
	input1.setValue("55555");
};

scwin.trigger1_onclick = function(e) {
	group1.setDisabled(true);
};

scwin.isDisable = function() {
	var el = scwin.__getDom($p.id + "gridView1_dataLayer");
	return el.classList.contains('w2grid_disabled');
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group id="group1" style="position: relative;width:630px;height:398px;">
			<w2:gridView dataList="dataList1" id="gridView1" style="position: relative;width:439px;height:234px;" useShiftKey="true">
				<w2:header id="header1">
					<w2:row id="row2">
						<w2:column blockSelect="false" id="column7" style="height:20px" inputType="text" width="70" value="name1"></w2:column>
						<w2:column blockSelect="false" id="column3" style="height:20px" width="70" inputType="text" value="name2"></w2:column>
					</w2:row>
				</w2:header>
				<w2:gBody id="gBody4">
					<w2:row id="row5">
						<w2:column blockSelect="false" id="col1" style="height:20px" inputType="text" width="70"></w2:column>
						<w2:column blockSelect="false" id="col2" style="height:20px" width="70" inputType="text"></w2:column>
					</w2:row>
				</w2:gBody>
			</w2:gridView>
			<xf:input id="input1" style="position: relative;width:273px;height:78px;left:4px;top:-5px;" adjustMaxLength="false"></xf:input>
		</xf:group>
		<xf:trigger type="button" id="trigger1" style="position: relative;width:159px;height:62px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setDisabled]]></xf:label>
		</xf:trigger>
	</body>
</html>
