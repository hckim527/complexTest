		<script type="text/javascript" lazy="false"><![CDATA[
scwin.checkVal = function() {
	return document.getElementsByClassName('w2editablePivot_cell')[0].innerText == '';
}
scwin.onpageload = function() {
	dl_resultList.setXML(WebSquare.ModelUtil.findInstanceNode("list"));
	pivotTable1.setFieldOption([{
		"id": "ratYear",
		"sortOrder": "2016년(총괄),2016년02월(A) (누계),2017년02월(B) (누계),증감(B-A)"
	}]);
	pivotTable1.setOption({
		"rows": "tacFicdCode",
		"cols": "ratYear",
		"vals": "reduRate,totReduAmt,totRatAmt",
		"valuesAxis": "col"
	});
}
]]></script>
