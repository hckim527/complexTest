<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
		</xf:model>
		<style type="text/css"><![CDATA[
.w2accordion {
	overflow: auto;
	border: 0px !important;
}
.w2panels {
	position: relative;
	border: 1px solid #ffffff;
}
.w2panels_content_closed {
	display: none;
}
.w2panels_content_open {
	position: relative;
	display: block;
	overflow: auto;
}
.w2panels_title {
	position: relative;
	height: 25px;
	cursor: pointer;
	background: #ff6d00;
}
]]></style>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger1_onclick = function(e) {
	accordion1.closePanel("panel1");
};
]]></script>
	</head>
	<body>
		<xf:trigger type="button" id="trigger1" style="position: relative;width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[closePanel]]></xf:label>
		</xf:trigger>
		<w2:accordion id="accordion1" style="height:400px;width:500px;margin:30px" class="w2accordion" collapsible="false">
			<w2:panels id="panel1">
				<w2:panelTitle id="t1" label="가입서비스선택" />
				<w2:panelContent id="content1">
					<w2:textbox label="이동전화" id="" style="height: 23px;"></w2:textbox>
				</w2:panelContent>
			</w2:panels>
		</w2:accordion>
	</body>
</html>
