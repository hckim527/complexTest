<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.mapchart1_calloutLabelExceptionHandler = function() {
	var exceptionList = ["11", "충청남도", "의왕시"];
	return exceptionList;
};
scwin.mapchart1_hideLabelExceptionHandler = function() {
	var exceptionList = ["11", "충청남도", "성남시 분당구", "의왕시", "군포시", "안산시 상록구"];
	return exceptionList;
};
]]></script>
		<style type="text/css"><![CDATA[
			.wrap{ padding: 10px;height:100%;}
			.d_flex{ display: flex;}
			.callout_line_test {
				stroke: gray;
				stroke-width: 0.5px;
				stroke-dasharray: 7 3;
			}
			.callout_circle_test {
				fill: red;
				stroke: black;
				stroke-width: 1px;
				opacity: 0.8;
			}
		]]></style>
	</head>
	<body>
		<xf:group class="wrap" id="">
			<xf:group class="d_flex" id="" style="flex-wrap: wrap;">
				<xf:group id="" style="padding-left:10px;">
					<xf:group class="d_flex" id="" style="flex-wrap: wrap;">
						<xf:group id="" style="width:650px;height:590px;border: 1px solid #BDBDBD;">
							<w2:mapchart id="mapchart1" style="width:100%;height:100%;" event_zoom="none" calloutOverlappedLabel="true"
								calloutLabelExceptionHandler="scwin.mapchart1_calloutLabelExceptionHandler" calloutLineClass="callout_line_test"
								calloutCircleClass="callout_circle_test">
							</w2:mapchart>
						</xf:group>
						<xf:group id="" style="width:650px;height:590px;border: 1px solid #BDBDBD;">
							<w2:mapchart id="mapchart2" style="width:100%;height:100%;" event_zoom="none" hideOverlappedLabel="true"
								hideLabelExceptionHandler="scwin.mapchart1_hideLabelExceptionHandler">
							</w2:mapchart>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>
