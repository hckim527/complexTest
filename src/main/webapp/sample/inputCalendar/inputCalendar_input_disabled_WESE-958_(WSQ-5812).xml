<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
	xmlns:ev="http://www.w3.org/2001/xml-events"
	xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.trigger1_onclick = function(e) {
	var val = inputcal1.getDisabled();
	if ( val ==false){
		inputcal1.setDisabled(true);
	}else
	{
		inputcal1.setDisabled(false);
	}
};
scwin.checkVal = function() {
	var test = (document.getElementById('inputcal1_calendar') || document.getElementById('mf_inputcal1_calendar'));
	return test === null;
};
]]></script>
	</head>
	<body>
		<w2:textbox id="" label="setDisabled API (true/false) 를 사용한 토글" style="width:425px;height:47px;font-size:20px;margin-top:40px;"></w2:textbox>
		<w2:inputCalendar id="inputcal1" style="width:205px;height:31px;display: block;" calendarValueType="yearMonthDate"></w2:inputCalendar>
		<xf:trigger type="button" id="trigger1" style="width: 80px;height: 23px;" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[btn]]></xf:label>
		</xf:trigger>
	</body>
</html>
