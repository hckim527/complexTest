		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="date" name="date" dataType="text"></w2:column>
						<w2:column id="holiday" name="holiday" dataType="text"></w2:column>
						<w2:column id="disabled" name="disabled" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<holiday><![CDATA[]]></holiday>
							<disabled><![CDATA[Y]]></disabled>
							<date><![CDATA[20180801]]></date>
						</w2:row>
						<w2:row>
							<date><![CDATA[20180802]]></date>
							<holiday><![CDATA[Y]]></holiday>
							<disabled><![CDATA[Y]]></disabled>
						</w2:row>
						<w2:row>
							<date><![CDATA[20180805]]></date>
							<disabled><![CDATA[Y]]></disabled>
							<holiday><![CDATA[Y]]></holiday>
						</w2:row>
