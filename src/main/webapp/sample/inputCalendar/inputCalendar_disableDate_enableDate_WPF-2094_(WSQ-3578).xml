			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
// jQuery 조회 순서(받은 선택자 → 없으면 mf_ 접두사). 2026-11
scwin.__getJq = function(q) {
	var j = $(q); if (j.length) return j;
	var P = 'mf_', t = q.trim(), r = t.slice(1);
	if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
	return $(t.slice(0, 1) + r);
};
scwin.trigger1_onclick = function(e) {
	c.disableDate('*');
};
scwin.trigger2_onclick = function(e) {
	c.enableDate('20180812');
};
scwin.trigger4_onclick = function(e) {
	c.disableDate('20180812 20180811');
};
scwin.trigger5_onclick = function(e) {
	ic.disableDate('*');
};
scwin.trigger6_onclick = function(e) {
	ic.enableDate('20180812');
};
scwin.trigger8_onclick = function(e) {
	ic.disableDate('20180812 20180811');
};
scwin.rgb2hex = function(rgb) {
	rgb = rgb.match(/^rgba?[\s+]?\([\s+]?(\d+)[\s+]?,[\s+]?(\d+)[\s+]?,[\s+]?(\d+)[\s+]?/i);
	return (rgb && rgb.length === 4) ? "#" +
		("0" + parseInt(rgb[1], 10).toString(16)).slice(-2) +
		("0" + parseInt(rgb[2], 10).toString(16)).slice(-2) +
		("0" + parseInt(rgb[3], 10).toString(16)).slice(-2) : '';
};
scwin._checkRgb = function(id, hexa) {
	var rgb = scwin.__getJq("#" + id).css("color");
	var color;
	if (rgb.indexOf("rgb") != -1) {
		color = scwin.rgb2hex(rgb);
		return color == hexa;
	}
	return rgb == hexa;
};
]]></script>
	</head>
	<body>
		<w2:calendar id="c" style="width: 100px;height: 100px;" footerDiv="false" disableAftereDate="20180804" ref="data:dataList1" dataList="data:dataList1">
