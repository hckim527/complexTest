<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	inputCalendar1.setValue("20240615");
	inputCalendar2.setValue("20240615");
};
scwin.trigger5_onclick = function(e) {
	$w.showModal();
};
scwin.__checkErr = function() {
	return WebSquare.logger.getErrorLog();
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="height:50px;">
			<w2:textbox style="width:222px;height:23px;" label="renderType = &quot;component&quot;"></w2:textbox>
			<w2:inputCalendar id="inputCalendar1" renderType="component" footerDiv="false" renderDiv="true" calendarValueType="yearMonthDate"
				style="width:200px;height:23px;" rightAlign="false" weekStartsOn="0" focusOnDateSelect="false">
			</w2:inputCalendar>
		</xf:group>
		<xf:group style="height:50px;">
			<w2:textbox style="width:222px;height:23px;" label="renderType = &quot;native&quot;"></w2:textbox>
			<w2:inputCalendar id="inputCalendar2" renderType="native" footerDiv="false" renderDiv="true" calendarValueType="yearMonthDate"
				style="width:200px;height:23px;" rightAlign="false" weekStartsOn="0" focusOnDateSelect="false">
			</w2:inputCalendar>
		</xf:group>
		<xf:trigger id="trigger5" style="width:150px;height:23px;" ev:onclick="scwin.trigger5_onclick" type="button">
			<xf:label><![CDATA[$w.showModal()]]></xf:label>
		</xf:trigger>
	</body>
</html>
