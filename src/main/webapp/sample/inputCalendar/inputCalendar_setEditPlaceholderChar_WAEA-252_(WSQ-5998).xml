			<w2:button type="" style="width:250px;height:50px;display:block;" id="trigger4" ev:onclick="scwin.trigger4_onclick" label='inputCalendar1.setEditPlaceholderChar ("")'></w2:button>
			<w2:button type="" style="width:250px;height:50px;display:block;" id="trigger5" ev:onclick="scwin.trigger5_onclick" label='inputCalendar1.getEditPlaceholderChar()'></w2:button>
