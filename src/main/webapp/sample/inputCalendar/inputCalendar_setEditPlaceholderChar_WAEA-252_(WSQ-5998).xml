					<w2:data use="true">
						<key1><![CDATA[20250101]]></key1>
					</w2:data>
				</w2:dataMap>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript"><![CDATA[
scwin.trigger4_onclick = function() {
	inputCalendar1.setEditPlaceholderChar("");
};
scwin.trigger5_onclick = function() {
	var result = inputCalendar1.getEditPlaceholderChar();
	window.checkResult = result
};
scwin.checkVal1 = function() {
	return window.checkResult == '_';
};
scwin.checkVal2 = function() {
	return window.checkResult == '';
};
]]></script>
		<style type="text/css"><![CDATA[
.w2inputCalendar_divInput{
	width: 150px;
	height: 40px;
	font-size:16px;
	border:1px solid #cbd1d4;
	font-family: 'Consolas', 'Courier New', monospace;
	padding: 0 10px;
	letter-spacing: 0.05em;
	text-align: center;
	display:block;
}
]]></style>
	</head>
	<body>
		<xf:group class="sub_cont" id="" style="padding:10px">
			<w2:inputCalendar id="inputCalendar1" style="width: 170px; height: 50px;margin-bottom: 10px;" ref="data:dataMap1.key1" displayFormat="yyyy.MM.dd"
				delimiter="/" useEditFormat="true" editPlaceholderChar="_">
