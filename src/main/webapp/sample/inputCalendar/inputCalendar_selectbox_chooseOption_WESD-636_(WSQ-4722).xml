<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:config>
			<WebSquare>
				<selectbox>
					<chooseOption value="true" />
				</selectbox>
			</WebSquare>
		</w2:config>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="label" dataType="text"></w2:column>
						<w2:column id="value" name="value" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[라벨]]></label>
							<value><![CDATA[값]]></value>
						</w2:row>
						<w2:row>
							<label><![CDATA[테스트]]></label>
							<value><![CDATA[테스트]]></value>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
	</head>
	<body>
		<w2:inputCalendar id="calendar2" style="width: 150px;height: 23px;" name="calendar1"></w2:inputCalendar>
		<xf:select1 id="" chooseOption="" style="width: 148px;height: 21px;" appearance="minimal" chooseOptionLabel="선택">
			<xf:choices>
				<xf:itemset nodeset="data:dataList1">
					<xf:label ref="label"></xf:label>
					<xf:value ref="value"></xf:value>
				</xf:itemset>
			</xf:choices>
		</xf:select1>
	</body>
</html>
