<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map"/>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	cal.disableDate("20230829, 20230830");
	cal2.disableDate("20230829, 20230830");
};
scwin.checkVal = function() {
	return document.getElementById('mf_cal2_calendar_selectbox_year_label').innerText != '2023년';
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group style="width:694px;height:428px;">
			<w2:textbox label='disableDate("20230829, 20230830")' style="width:469px;height:35px;"></w2:textbox>
			<w2:inputCalendar id="cal" style="width: 150px;height: 23px;" calendarValueType="yearMonthDate"></w2:inputCalendar>
			<w2:textbox label='disableDate("20230829, 20230830"), disableDateValidSet 설정(disableBeforeDate, disableAfterDate 와 더불어 disableDate 까지 동작하게 수정)' style="width:469px;height:35px;"></w2:textbox>
			<w2:inputCalendar id="cal2" style="width: 150px;height: 23px;" calendarValueType="yearMonthDate" disableDateValidSet="true"></w2:inputCalendar>
		</xf:group>
	</body>
</html>
