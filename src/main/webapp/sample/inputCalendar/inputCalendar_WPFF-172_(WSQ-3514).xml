		<xf:group style="height:40px;">
			<w2:textbox label="calendarDisplayFormat=MM-dd-yyyy" style="width:420px;height:23px;"></w2:textbox>
			<w2:inputCalendar id="cal3" rightAlign="false" calendarValueType="yearMonthDateTime" renderType="component" renderDiv="true"
