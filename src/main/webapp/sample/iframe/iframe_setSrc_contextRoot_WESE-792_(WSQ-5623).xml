			<xf:instance></xf:instance>
			<w2:dataCollection baseNode="map"></w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script lazy="false" type="text/javascript"><![CDATA[
scwin.trigger1_onclick = function() {
	iframe1.setSrc("http://127.0.0.1:8080");
};
]]></script>
	</head>
	<body>
		<xf:group style="position:relative;width: 600px;height: 70px;">
			<xf:trigger type="button" style="position:relative;width: 180px;height: 30px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
				<xf:label>
					<![CDATA[setSrc1]]>
				</xf:label>
			</xf:trigger>
		</xf:group>
		<w2:iframe id="iframe1" src="" style="position:relative;width: 600px;height: 600px;" />
