<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
						<w2:column id="depth" name="name3" dataType="text"></w2:column>
						<w2:column id="folder" name="name4" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<label><![CDATA[label1]]></label>
							<value><![CDATA[value1]]></value>
							<depth><![CDATA[1]]></depth>
							<folder><![CDATA[true]]></folder>
						</w2:row>
						<w2:row>
							<label><![CDATA[label2]]></label>
							<value><![CDATA[value2]]></value>
							<depth><![CDATA[2]]></depth>
							<folder><![CDATA[true]]></folder>
						</w2:row>
						<w2:row>
							<label><![CDATA[label3]]></label>
							<value><![CDATA[value3]]></value>
							<depth><![CDATA[3]]></depth>
							<folder><![CDATA[true]]></folder>
						</w2:row>
						<w2:row>
							<label><![CDATA[label4]]></label>
							<value><![CDATA[value4]]></value>
							<depth><![CDATA[1]]></depth>
							<folder><![CDATA[true]]></folder>
						</w2:row>
						<w2:row>
							<label><![CDATA[label5]]></label>
							<value><![CDATA[value5]]></value>
							<depth><![CDATA[2]]></depth>
							<folder><![CDATA[true]]></folder>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.__getJq = function(q) {
	var j = $(q); if (j.length) return j;
	var P = 'mf_', t = q.trim(), r = t.slice(1);
	if (r.slice(0, 2) === 'G_') r = 'G_' + P + r.slice(2); else if (r.slice(0, P.length) !== P) r = P + r;
	return $(t.slice(0, 1) + r);
};
scwin.trigger1_onclick = function(e) {
	var saveDataJson = [
		{"label": "new1", "value": "new1", "depth": "1", "folder": "false"},
		{"label": "new2", "value": "new2", "depth": "2", "folder": "false"},
		{"label": "new3", "value": "new3", "depth": "3", "folder": "false"},
		{"label": "new4", "value": "new4", "depth": "2", "folder": "false"},
		{"label": "new5", "value": "new5", "depth": "3", "folder": "false"}
	];
	dataList1.insertJSON(2, saveDataJson);
};
scwin.checkEl = function(id) {
	if (scwin.__getJq(id).attr("opened")) {
		return false;
	}
	return true;
};
]]></script>
	</head>
	<body>
		<xf:group id="" style="height:213px;width:200px;float:left;">
			<w2:textbox id="" label="insertJSON" style="position: relative;width:260px;height:50px;font-weight:bold;text-align: middle;"></w2:textbox>
			<w2:treeview dataType="listed" id="treeview" lineShow="" style="position: relative;width:257px;height:315px;background: #EEEEEE;border: solid 1px #000000;" tooltipGroupClass="false"
				dynamicAppend="true" forceFolder="false">
				<w2:itemset nodeset="data:dataList1">
					<w2:label ref="label"></w2:label>
					<w2:value ref="value"></w2:value>
					<w2:depth ref="depth"></w2:depth>
					<w2:folder ref="folder"></w2:folder>
				</w2:itemset>
			</w2:treeview>
			<xf:trigger ev:onclick="scwin.trigger1_onclick" id="trigger1" style="position: relative;width: 80px;height: 23px;" type="button">
				<xf:label><![CDATA[메뉴 추가]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
