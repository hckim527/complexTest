<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="depth" name="name2" dataType="text"></w2:column>
						<w2:column id="value" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection>
			</w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger3_onclick = function(e) {
	dataList1.removeAll();
};
scwin.getErrorLog = function() {
	return WebSquare.logger.getErrorLog();
};
scwin.onpageload = function() {
	window.jsonData = [{
		"label": "test1",
		"depth": "1",
		"value": "test1"
	}, {
		"label": "test2",
		"depth": "2",
		"value": "test2"
	}];
	dataList1.setJSON(jsonData);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:treeview id="treeview2" style="position: relative;width: 200px;height: 200px;left:67px;top:18px;" lineShow=""
			tooltipGroupClass="false" dataType="listed">
			<w2:itemset nodeset="data:dataList1">
				<w2:label ref="label"></w2:label>
				<w2:value ref="value"></w2:value>
				<w2:depth ref="depth"></w2:depth>
			</w2:itemset>
		</w2:treeview>
		<xf:trigger type="button" id="trigger3" style="position: relative;width:222px;height:23px;left:128px;top:40px;"
			ev:onclick="scwin.trigger3_onclick">
			<xf:label><![CDATA[dataList1.removeAll();]]></xf:label>
		</xf:trigger>
	</body>
</html>
