<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="label" name="name1" dataType="text"></w2:column>
						<w2:column id="value" name="name2" dataType="text"></w2:column>
						<w2:column id="depth" name="name3" dataType="text"></w2:column>
						<w2:column id="checkbox" name="name4" dataType="text"></w2:column>
						<w2:column id="folder" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="newLab" name="name1" dataType="text"></w2:column>
						<w2:column id="newVal" name="name2" dataType="text"></w2:column>
						<w2:column id="newDep" name="name3" dataType="text"></w2:column>
						<w2:column id="newChk" name="name4" dataType="text"></w2:column>
						<w2:column id="newFol" name="name5" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function () {
	dataList1.setJSON([
		{ "label": "label1", "value": "value1", "depth": "1", "folder": "false" },
		{ "label": "newLab", "value": "newVal", "depth": "2", "folder": "false" },
		{ "label": "label3", "value": "value3", "depth": "3", "folder": "false" },
		{ "label": "label4", "value": "value4", "depth": "2", "folder": "false" }
	]);
	dataList2.setJSON([
		{ "newLab": "라벨1", "newVal": "밸류1", "newDep": "1", "newFol": "false" },
		{ "newLab": "라벨2", "newVal": "밸류2", "newDep": "2", "newFol": "false" },
		{ "newLab": "라벨3", "newVal": "밸류3", "newDep": "1", "newFol": "false" },
		{ "newLab": "라벨4", "newVal": "밸류4", "newDep": "2", "newFol": "false" },
		{ "newLab": "라벨5", "newVal": "밸류5", "newDep": "3", "newFol": "false" }
	]);
};

scwin.trigger1_onclick = function (e) {
	var columnInfo = {
		label: "newLab",
		value: "newVal",
		depth: "newDep",
		checkbox: "newChk",
		folder: "newFol"
	};
	treeview1.setNodeSet("data:dataList2", columnInfo);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:trigger type="button" style="width: 80px;height: 23px;" id="trigger1" ev:onclick="scwin.trigger1_onclick">
			<xf:label><![CDATA[setNodeset]]></xf:label>
		</xf:trigger>
		<w2:treeview lineShow="" id="treeview1" dataType="listed" tooltipGroupClass="false" style="height: 100%;" useDrag="" alwaysDraw="false" showTreeDepth="4">
			<w2:itemset nodeset="data:dataList1">
				<w2:label ref="label"></w2:label>
				<w2:value ref="value"></w2:value>
				<w2:depth ref="depth"></w2:depth>
				<w2:folder ref="folder"></w2:folder>
				<w2:checkbox ref=""></w2:checkbox>
				<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
				<w2:image ref=""></w2:image>
				<w2:iconImage ref=""></w2:iconImage>
				<w2:selectedImage ref=""></w2:selectedImage>
				<w2:expandedImage ref=""></w2:expandedImage>
				<w2:leafImage ref=""></w2:leafImage>
			</w2:itemset>
		</w2:treeview>
	</body>
</html>
