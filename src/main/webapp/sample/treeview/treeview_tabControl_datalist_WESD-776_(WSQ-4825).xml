<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dataList2" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[useaa]]></col2>
							<col3><![CDATA[a]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[usea]]></col2>
							<col3><![CDATA[a1]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[3]]></col1>
							<col2><![CDATA[uses]]></col2>
							<col3><![CDATA[a2]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[1]]></col1>
							<col2><![CDATA[usea]]></col2>
							<col3><![CDATA[b]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[2]]></col1>
							<col2><![CDATA[usezzz]]></col2>
							<col3><![CDATA[b1]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection></w2:workflowCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.onpageload = function() {
	var json = [{
			"col1": "1",
			"col2": "aa",
			"col3": "a"
		},
		{
			"col1": "2",
			"col2": "a",
			"col3": "a1"
		}, {
			"col1": "3",
			"col2": "s",
			"col3": "a2"
		}, {
			"col1": "1",
			"col2": "a",
			"col3": "b"
		}, {
			"col1": "2",
			"col2": "zzz",
			"col3": "b1"
		}
	];
	dataList2.setJSON(json);
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:tabControl useTabKeyOnly="true" id="tabc_side" alwaysDraw="false" style="width:700px;height:200px;">
			<w2:tabs style="width:70px;height:30px;" id="tabs1" label="메뉴"></w2:tabs>
			<w2:tabs style="width:95px;height:30px;" id="tabs2" label="즐겨찾기"></w2:tabs>
			<w2:content alwaysDraw="false" style="height:300px;" id="content1"></w2:content>
			<w2:content alwaysDraw="false" style="height:300px;" id="content2">
				<xf:group id="side">
					<xf:group id="" tagname="ul">
						<xf:group id="" tagname="li">
							<w2:treeview dataType="listed" style="width:200px;height:150px;" id="trv_menu">
								<w2:itemset nodeset="data:dataList2">
									<w2:label ref="col2"></w2:label>
									<w2:value ref="col3"></w2:value>
									<w2:depth ref="col1"></w2:depth>
								</w2:itemset>
							</w2:treeview>
							<w2:gridView id="gridView1" style="width:400px;height:150px;" defaultCellHeight="20" dataList="data:dataList2">
								<w2:caption id="caption1" value="this is a grid caption."></w2:caption>
								<w2:header id="header1">
									<w2:row id="row1">
										<w2:column width="70" inputType="text" style="height:20px" id="column1" value="col1" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="height:20px" id="column11" value="col2" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="height:20px" id="column12" value="col3" displayMode="label"></w2:column>
									</w2:row>
								</w2:header>
								<w2:gBody id="gBody1">
									<w2:row id="row2">
										<w2:column width="70" inputType="text" style="height:20px" id="col1" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="height:20px" id="col2" displayMode="label"></w2:column>
										<w2:column width="70" inputType="text" style="height:20px" id="col3" displayMode="label"></w2:column>
									</w2:row>
								</w2:gBody>
							</w2:gridView>
						</xf:group>
					</xf:group>
				</xf:group>
			</w2:content>
		</w2:tabControl>
	</body>
</html>
