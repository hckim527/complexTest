<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns=""/>
			</xf:instance>
			<w2:dataCollection>
				<w2:dataList id="dataList1" baseNode="vector" repeatNode="data/table01" valueAttribute="value">
					<w2:columnInfo>
						<w2:column id="pro_code" name="pro_code" dataType="text"></w2:column>
						<w2:column id="gong_code" name="gong_code" dataType="text"></w2:column>
						<w2:column id="gong_depth" name="gong_depth" dataType="text"></w2:column>
						<w2:column id="gong_nm" name="gong_nm" dataType="text"></w2:column>
						<w2:column id="gover_type" name="gover_type" dataType="text"></w2:column>
						<w2:column id="image" name="image" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<pro_code><![CDATA[82356500]]></pro_code>
							<gong_code><![CDATA[01]]></gong_code>
							<gong_depth><![CDATA[1]]></gong_depth>
							<gong_nm><![CDATA[AA]]></gong_nm>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<style type="text/css">
			.aaa {
				color : red;
			}
			.bbb {
				background-color : red;
				color : white;
			}
		</style>
		<script type="javascript" lazy="false"><![CDATA[
scwin.dummyCnt = 0;
scwin.onpageload = function() {
	treeview1.spanAll(true);
};
scwin.btn_insertJSON = function() {
	treeview1.toggleChild(null, 1);
	scwin.dummyCnt++;
	var row = dataList1.getRowCount();
	var depth = 2;
	var jsonData = [{
		"gong_code": "insertJSONTestA_" + scwin.dummyCnt,
		"gong_depth": depth,
		"gong_nm": "testA_" + scwin.dummyCnt
	}];
	dataList1.insertJSON(row, jsonData);
	var row = dataList1.getRowCount();
	var jsonData2 = [{
		"gong_code": "insertJSONTestB_" + scwin.dummyCnt,
		"gong_depth": depth + 1,
		"gong_nm": "testB_" + scwin.dummyCnt
	}];
	setTimeout(function() {
		dataList1.insertJSON(row, jsonData2);
	}, 20);
};
scwin.checkVal1 = function() {
	return (document.getElementById('treeview1_main_div') || document.getElementById('mf_treeview1_main_div')).children.length == 3;
};
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<w2:treeview id="treeview1" dataType="listed" renderType="virtual" style="position: relative;width:300px;height:120px;" lineShow="" useDrag="true" tooltipGroupClass="false"
			refreshCheckboxModel="true" labelonClickClass="bbb" labelclass="aaa" showCheckbox="true" dynamicAppend="true" falseValue="F" trueValue="T" checkAllChildNodes="true">
			<w2:itemset nodeset="data:dataList1">
				<w2:label ref="gong_nm"></w2:label>
				<w2:value ref="gong_code"></w2:value>
				<w2:depth ref="gong_depth"></w2:depth>
				<w2:checkbox ref="gover_type"></w2:checkbox>
				<w2:iconImage ref="image"></w2:iconImage>
			</w2:itemset>
		</w2:treeview>
		<xf:trigger id="btn_insertJSON" style="position: relative;height:30px;font-size:12px;width:100px;" ev:onclick="scwin.btn_insertJSON" type="button">
			<xf:label><![CDATA[insertJSON1]]></xf:label>
		</xf:trigger>
	</body>
</html>
