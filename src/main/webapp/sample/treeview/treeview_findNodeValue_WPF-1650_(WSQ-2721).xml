<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<xf:instance>
				<data xmlns="">
					<node>
						<row>
							<label>aaa</label>
							<value>1</value>
							<depth>1</depth>
							<chk></chk>
						</row>
						<row>
							<label>bbb</label>
							<value>2</value>
							<depth>2</depth>
							<chk></chk>
						</row>
						<row>
							<label>ccc</label>
							<value>3</value>
							<depth>1</depth>
							<chk></chk>
						</row>
						<row>
							<label>ddd</label>
							<value>4</value>
							<depth>2</depth>
							<chk></chk>
						</row>
						<row>
							<label>eee</label>
							<value>5</value>
							<depth>3</depth>
							<chk></chk>
						</row>
					</node>
				</data>
			</xf:instance>
			<w2:dataCollection baseNode="map">
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.btnValue_onclick = function(e) {
	trv1.findNodeByValue("1", true);
};
scwin.btnIndex_onclick = function(e) {
	// Node instance data에 없는 index로 찾음
	trv1.findNodeByIndex(99, true);
};
scwin.btnLog_onclick = function(e) {
	WebSquare.logger.showLog();
};
scwin.__checkErr = function() {
	return temp = WebSquare.logger.getErrorLog();
};
]]></script>
	</head>
	<body>
		<w2:treeview lineShow="" id="trv1" dataType="listed" tooltipGroupClass="false" style="position: absolute;width:239px;height:358px;left:38px;top:40px;" showCheckbox="true">
			<w2:itemset nodeset="node/row">
				<w2:label ref="label"></w2:label>
				<w2:value ref="value"></w2:value>
				<w2:depth ref="depth"></w2:depth>
				<w2:checkbox ref="chk"></w2:checkbox>
			</w2:itemset>
		</w2:treeview>
		<xf:trigger type="button" style="position: absolute;width: 120px;height: 23px;left:339px;top:57px;" id="btnValue" ev:onclick="scwin.btnValue_onclick">
			<xf:label><![CDATA[findNodeValue]]></xf:label>
		</xf:trigger>
		<xf:trigger id="btnIndex" style="position: absolute;width: 120px;height: 23px;left:339px;top:87px;" type="button" ev:onclick="scwin.btnIndex_onclick">
			<xf:label><![CDATA[findNodeIndex]]></xf:label>
		</xf:trigger>
		<xf:trigger id="btnLog" style="position: absolute;width: 120px;height: 23px;left:339px;top:117px;" type="button" ev:onclick="scwin.btnLog_onclick">
			<xf:label><![CDATA[showLog]]></xf:label>
		</xf:trigger>
	</body>
</html>
