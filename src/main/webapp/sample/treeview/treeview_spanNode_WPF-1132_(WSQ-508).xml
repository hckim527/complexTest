<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate/>
		<xf:model>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="col1" name="name1" dataType="text"></w2:column>
						<w2:column id="col2" name="name2" dataType="text"></w2:column>
						<w2:column id="col3" name="name3" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<col1><![CDATA[menu1]]></col1>
							<col2><![CDATA[menu1_level1]]></col2>
							<col3><![CDATA[1]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[menu1-1]]></col1>
							<col2><![CDATA[menu1_level2]]></col2>
							<col3><![CDATA[2]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[menu1-2]]></col1>
							<col2><![CDATA[menu1_level2]]></col2>
							<col3><![CDATA[2]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[menu1-2-1]]></col1>
							<col2><![CDATA[menu1_level3]]></col2>
							<col3><![CDATA[3]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[menu1-2-1-1]]></col1>
							<col2><![CDATA[menu1_level4]]></col2>
							<col3><![CDATA[4]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[menu2]]></col1>
							<col2><![CDATA[menu2_level1]]></col2>
							<col3><![CDATA[1]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[menu2-1]]></col1>
							<col2><![CDATA[menu2_level2]]></col2>
							<col3><![CDATA[2]]></col3>
						</w2:row>
						<w2:row>
							<col1><![CDATA[menu3]]></col1>
							<col2><![CDATA[menu3_level1]]></col2>
							<col3><![CDATA[1]]></col3>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger6_onclick = function (e) {
	trView.spanAll(false);
};
scwin.trigger7_onclick = function (e) {
	trView.spanNode(1);
};
scwin.trigger8_onclick = function (e) {
	trView.spanNode(1, false);
};
scwin.trigger9_onclick = function (e) {
	trView.spanNode(1, true);
};
scwin.trigger10_onclick = function (e) {
	trView.spanNode(1, false, true);
};
scwin.trigger11_onclick = function (e) {
	trView.spanNode(1, true, true);
};
]]></script>
	</head>
	<body>
		<xf:group id="">
			<xf:trigger id="trigger6" type="button" ev:onclick="scwin.trigger6_onclick">
				<xf:label><![CDATA[spanAll(false)]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger7" ev:onclick="scwin.trigger7_onclick">
				<xf:label><![CDATA[menu1 toggle]]></xf:label>
			</xf:trigger>
			<xf:trigger ev:onclick="scwin.trigger8_onclick" id="trigger8" type="button">
				<xf:label><![CDATA[menu1접기]]></xf:label>
			</xf:trigger>
			<xf:trigger ev:onclick="scwin.trigger9_onclick" id="trigger9" type="button">
				<xf:label><![CDATA[menu1확장]]></xf:label>
			</xf:trigger>
			<xf:trigger ev:onclick="scwin.trigger10_onclick" id="trigger10" type="button">
				<xf:label><![CDATA[menu1자식포함접기]]></xf:label>
			</xf:trigger>
			<xf:trigger ev:onclick="scwin.trigger11_onclick" id="trigger11" type="button">
				<xf:label><![CDATA[menu1자식포함확장]]></xf:label>
			</xf:trigger>
		</xf:group>
		<w2:treeview useDrag="" id="trView" style="position: relative;width: 200px;height: 200px;margin: 10px;border: 1px solid;" lineShow="" tooltipGroupClass="false" dataType="listed">
			<w2:itemset nodeset="data:dataList1">
				<w2:label ref="col1"></w2:label>
				<w2:value ref="col2"></w2:value>
				<w2:depth ref="col3"></w2:depth>
				<w2:folder ref=""></w2:folder>
				<w2:checkbox ref=""></w2:checkbox>
				<w2:checkboxDisabled ref=""></w2:checkboxDisabled>
				<w2:image ref=""></w2:image>
				<w2:iconImage ref=""></w2:iconImage>
				<w2:selectedImage ref=""></w2:selectedImage>
				<w2:expandedImage ref=""></w2:expandedImage>
				<w2:leafImage ref=""></w2:leafImage>
			</w2:itemset>
		</w2:treeview>
	</body>
</html>
