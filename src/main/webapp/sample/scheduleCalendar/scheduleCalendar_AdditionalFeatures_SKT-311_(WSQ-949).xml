<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head>
		<w2:type>DEFAULT</w2:type>
		<w2:buildDate />
		<xf:model>
			<xf:instance>
				<data xmlns="" />
			</xf:instance>
			<w2:dataCollection baseNode="map">
				<w2:dataList id="dataList1" baseNode="list" saveRemovedData="true" repeatNode="map">
					<w2:columnInfo>
						<w2:column id="title" name="title" dataType="text"></w2:column>
						<w2:column id="start" name="start" dataType="text"></w2:column>
						<w2:column id="end" name="end" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<title><![CDATA[All Day Event]]></title>
							<start><![CDATA[20160101120000]]></start>
							<end><![CDATA[20160103000000]]></end>
						</w2:row>
						<w2:row>
							<title><![CDATA[Long Event]]></title>
							<start><![CDATA[20160107080000]]></start>
							<end><![CDATA[20160110090000]]></end>
						</w2:row>
						<w2:row>
							<title><![CDATA[Repeating Event]]></title>
							<start><![CDATA[20160109]]></start>
							<end><![CDATA[20160109]]></end>
						</w2:row>
						<w2:row>
							<title><![CDATA[Meeting]]></title>
							<start><![CDATA[20160112]]></start>
							<end><![CDATA[20160112]]></end>
						</w2:row>
						<w2:row>
							<title><![CDATA[Birthday Party]]></title>
							<start><![CDATA[20160113]]></start>
							<end><![CDATA[20160113]]></end>
						</w2:row>
					</w2:data>
				</w2:dataList>
			</w2:dataCollection>
		</xf:model>
		<script type="text/javascript" lazy="false"><![CDATA[
scwin.trigger3_onclick = function(e) {
	var options = {
		"sun": {
			"header": {
				"color": "#ff0000"
			},
			"body": {
				"background": {
					"background-color": "#ff0000",
					"opacity": "0.2"
				},
				"num": {
					"color": "#ff0000"
				}
			}
		},
		"sat": {
			"header": {
				"color": "#0000ff"
			},
			"body": {
				"background": {
					"background-color": "#0000ff",
					"opacity": "0.2"
				},
				"num": {
					"color": "#0000ff"
				}
			}
		}
	};
	schdule1.setDayNameStyle(options);
};
scwin.trigger4_onclick = function(e) {
	schdule1.setHeaderBtn({
		"headerRightBtn": false
	});
};
]]></script>
	</head>
	<body>
		<w2:scheduleCalendar id="schdule1" style="width:100%;height:400px;" editable="false" eventLimit="false" selectable="false" dataList="dataList1"
			titleColumn="title" startColumn="start" endColumn="end" headerRightBtn="false" headerLeftBtn="true" headerTitle="true" version="3.6">
		</w2:scheduleCalendar>
		<xf:group style="height:23px;">
			<xf:trigger type="button" id="trigger3" style="position: relative;width: 120px;height: 23px;" ev:onclick="scwin.trigger3_onclick">
				<xf:label><![CDATA[setDayNameStyle]]></xf:label>
			</xf:trigger>
			<xf:trigger type="button" id="trigger4" style="width:121px;height:23px;margin:5px;" ev:onclick="scwin.trigger4_onclick">
				<xf:label><![CDATA[setHeaderBtn]]></xf:label>
			</xf:trigger>
		</xf:group>
	</body>
</html>
